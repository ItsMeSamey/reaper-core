# Handwritten JNI in containers_cookies_browsertest.cc uses these exact names.
# Keep only the four existing browser-case helper methods and their descriptors.
# This file is added only to the isolated container browser test APK.
-keepclassmembers,includedescriptorclasses class org.chromium.chrome.browser.tabmodel.TabCollectionTabModelImpl {
    org.chromium.chrome.browser.tabmodel.TabCreator getTabCreator();
}
-keepclassmembers,includedescriptorclasses class org.chromium.chrome.browser.app.ChromeActivity {
    org.chromium.chrome.browser.tabmodel.TabCreator getTabCreator(boolean);
}
-keepclassmembers,includedescriptorclasses class org.chromium.chrome.browser.tabmodel.ChromeTabCreator {
    org.chromium.chrome.browser.tab.Tab createNewTabInContainer(org.chromium.content_public.browser.LoadUrlParams, int, java.lang.String);
    org.chromium.chrome.browser.tab.Tab createFrozenTab(org.chromium.chrome.browser.tab.TabState, int, int);
    org.chromium.chrome.browser.tab.Tab createNewTab(org.chromium.content_public.browser.LoadUrlParams, int, org.chromium.chrome.browser.tab.Tab);
}
-keep,includedescriptorclasses class org.chromium.chrome.browser.tab.TabStateExtractor {
    static org.chromium.chrome.browser.tab.TabState from(org.chromium.chrome.browser.tab.Tab);
}
-keep,includedescriptorclasses class org.chromium.chrome.browser.tab.TabIdManager {
    static org.chromium.chrome.browser.tab.TabIdManager getInstance();
    int generateValidId(int);
}
-keep class org.chromium.content_public.browser.LoadUrlParams {
    <init>(java.lang.String);
}
-keepclassmembers class org.chromium.ui.base.WindowAndroid {
    java.lang.ref.WeakReference getActivity();
}
