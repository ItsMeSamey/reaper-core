+    /** Per-tab input state. Retirement must never mutate observed input during Tab teardown. */
+    @VisibleForTesting
+    static final class InputSession implements UserData {
+        private final AutocompleteInput mInput =
+                new AutocompleteInput(OmniboxFocusReason.OMNIBOX_TAP);
+        private boolean mActive;
+        private boolean mDestroyed;
+
+        AutocompleteInput getAutocompleteInput() {
+            return mInput;
+        }
+
+        boolean isSessionActive() {
+            return mActive && !mDestroyed;
+        }
+
+        void applyAutocompleteInput(AutocompleteInput input) {
+            if (!mDestroyed) mInput.copyFrom(input);
+        }
+
+        void activate(Context context) {
+            if (mDestroyed || mActive) return;
+            mActive = true;
+            mInput.setUrlFocusTime(System.currentTimeMillis());
+            if (OmniboxCapabilities.hasDesktopExperience(context)
+                    && UrlBarData.shouldShowUrl(mInput.getPageUrl(), false)) {
+                GURL pageUrl = mInput.getPageUrl();
+                String initialText = UrlUtilities.stripScheme(pageUrl.getSpec());
+                if (pageUrl.isValid()
+                        && !pageUrl.getScheme().equals(UrlConstants.FILE_SCHEME)
+                        && !pageUrl.getScheme().equals(UrlConstants.FILESYSTEM_SCHEME)
+                        && pageUrl.getQuery().isEmpty()
+                        && pageUrl.getRef().isEmpty()
+                        && pageUrl.getPath().equals("/")) {
+                    initialText = UrlUtilities.stripTrailingSlash(initialText);
+                }
+                mInput.setPreviewMatchUrl(pageUrl);
+                mInput.setInitialUserText(initialText);
+            } else {
+                mInput.setPreviewMatchUrl(null);
+                mInput.setInitialUserText("");
+            }
+            if (mInput.getUserText().isEmpty()
+                    && mInput.getPageClassification() != PageClassification.ANDROID_SEARCH_WIDGET
+                    && mInput.getPageClassification() != PageClassification.ANDROID_SHORTCUTS_WIDGET
+                    && !PageClassificationUtils.isHubOrTabSearch(mInput.getPageClassification())) {
+                mInput.setUserText(mInput.getInitialUserText())
+                        .setSelection(
+                                OmniboxCapabilities.hasDesktopExperience(context)
+                                        ? TextSelection.SELECT_ALL
+                                        : TextSelection.SELECT_END);
+            }
+        }
+
+        void deactivate() {
+            if (mDestroyed || !mActive) return;
+            mActive = false;
+            mInput.reset();
+            mInput.setAutocompleteState(AutocompleteState.DISABLED);
+        }
+
+        @Override
+        public void destroy() {
+            mDestroyed = true;
+            mActive = false;
+        }
+    }
+
+    private @Nullable InputSession getInputSession() {
+        if (mDestroyed) return null;
+        UserDataHost host = mLocationBarDataProvider.getInputUserDataHost();
+        if (host == null) return null;
+        InputSession session = host.getUserData(InputSession.class);
+        if (session == null) session = host.setUserData(InputSession.class, new InputSession());
+        if (session.mDestroyed) return null;
+        session.mInput.setPageClassification(mLocationBarDataProvider.getPageClassification(false));
+        session.mInput.setPageUrl(mLocationBarDataProvider.getCurrentGurl());
+        session.mInput.setPageTitle(mLocationBarDataProvider.getTitle());
+        return session;
+    }
+
+    private void cancelPendingInputProfileCallback() {
+        ++mInputGeneration;
+        Callback<Profile> callback = mPendingInputProfileCallback;
+        mPendingInputProfileCallback = null;
+        if (callback != null) mProfileSupplier.removeObserver(callback);
+    }
+
+    private boolean isCurrentInputSession(
+            InputSession session, UserDataHost host, long generation) {
+        // A retired holder must be rejected before querying its already-destroyed UserDataHost.
+        return !mDestroyed
+                && !session.mDestroyed
+                && session.mActive
+                && generation == mInputGeneration
+                && mCurrentInputSession == session
+                && mCurrentInput == session.mInput
+                && mCurrentInputHost == host
+                && mLocationBarDataProvider.getInputUserDataHost() == host
+                && host.getUserData(InputSession.class) == session;
+    }
