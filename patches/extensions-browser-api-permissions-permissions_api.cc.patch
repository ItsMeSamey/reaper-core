+#if BUILDFLAG(IS_ANDROID)
+  // Consent belongs to the enabled extension instance that requested it. A
+  // reload or reinstall must not grant through a retired instance into ID-keyed
+  // preferences or the replacement renderer's permissions.
+  if (!browser_context() || ExtensionRegistry::Get(browser_context())
+                                    ->enabled_extensions()
+                                    .GetByID(extension_id()) != extension()) {
+    Respond(ArgumentList(api::permissions::Request::Results::Create(false)));
+    return;
+  }
+  // Management policy may change while the consent dialog is open. Check the
+  // current policy before committing either optional or withheld permissions.
+  std::unique_ptr<const PermissionSet> requested_permissions =
+      PermissionSet::CreateUnion(*requested_withheld_, *requested_optional_);
+  if (!ExtensionsBrowserClient::Get()
+           ->GetExtensionManagementClient(browser_context())
+           ->IsPermissionSetAllowed(extension(), *requested_permissions)) {
+    Respond(Error(kBlockedByEnterprisePolicy));
+    return;
+  }
+#endif  // BUILDFLAG(IS_ANDROID)
   PermissionsUpdater permissions_updater(browser_context());
