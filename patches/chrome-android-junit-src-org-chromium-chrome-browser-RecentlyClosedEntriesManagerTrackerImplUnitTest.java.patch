+    @Test
+    public void testNativeWindowCallbacksAreProfileScoped() {
+        when(mProfile.getNativeBrowserContextPointer()).thenReturn(13L);
+        Profile otherProfile = mock();
+        when(otherProfile.getNativeBrowserContextPointer()).thenReturn(14L);
+        TabModel otherModel = mock();
+        when(otherModel.getProfile()).thenReturn(otherProfile);
+        TabModelSelector otherSelector = mock();
+        when(otherSelector.getModel(false)).thenReturn(otherModel);
+        RecentlyClosedEntriesManager first =
+                mTracker.obtainManager(mMultiInstanceManager, mTabModelSelector);
+        RecentlyClosedEntriesManager second =
+                mTracker.obtainManager(mMultiInstanceManager, otherSelector);
+        JniRepeatingCallback<Long> firstCallback = mock();
+        JniRepeatingCallback<Long> secondCallback = mock();
+        RecentlyClosedEntriesManager.setNativeUpdatedCallback(mProfile, firstCallback);
+        RecentlyClosedEntriesManager.setNativeUpdatedCallback(otherProfile, secondCallback);
+        try {
+            mTracker.onInstanceRestored(/* instanceId= */ 2);
+            verify(firstCallback).onResult(13L);
+            verify(secondCallback).onResult(14L);
+            RecentlyClosedEntriesManager.clearNativeUpdatedCallback(mProfile);
+            verify(firstCallback).destroy();
+            mTracker.destroy(first);
+            mTracker.onInstanceRestored(/* instanceId= */ 3);
+            verify(secondCallback, times(2)).onResult(14L);
+            verifyNoMoreInteractions(firstCallback, secondCallback);
+        } finally {
+            RecentlyClosedEntriesManager.clearNativeUpdatedCallback(mProfile);
+            RecentlyClosedEntriesManager.clearNativeUpdatedCallback(otherProfile);
+            mTracker.destroy(first);
+            mTracker.destroy(second);
+        }
+    }
