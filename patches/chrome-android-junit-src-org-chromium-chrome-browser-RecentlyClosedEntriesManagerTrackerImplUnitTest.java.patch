+    @Test
+    public void testNativeWindowUpdatesSurviveCallbackOwnerDestruction() {
+        when(mProfile.getNativeBrowserContextPointer()).thenReturn(11L);
+        JniRepeatingCallback<Long> callback = mock();
+        RecentlyClosedEntriesManager first =
+                mTracker.obtainManager(mMultiInstanceManager, mTabModelSelector);
+        RecentlyClosedEntriesManager.setNativeUpdatedCallback(mProfile, callback);
+        RecentlyClosedEntriesManager second =
+                mTracker.obtainManager(mMultiInstanceManager, mTabModelSelector);
+        try {
+            mTracker.onInstanceRestored(/* instanceId= */ 2);
+            verify(callback).onResult(11L);
+            mTracker.destroy(first);
+            verify(callback, never()).destroy();
+            mTracker.onInstanceRestored(/* instanceId= */ 3);
+            verify(callback, times(2)).onResult(11L);
+            mTracker.destroy(second);
+            verify(callback, never()).destroy();
+            RecentlyClosedEntriesManager replacement =
+                    mTracker.obtainManager(mMultiInstanceManager, mTabModelSelector);
+            try {
+                mTracker.onInstanceRestored(/* instanceId= */ 4);
+                verify(callback, times(3)).onResult(11L);
+                RecentlyClosedEntriesManager.clearNativeUpdatedCallback(mProfile);
+                verify(callback).destroy();
+                mTracker.onInstanceRestored(/* instanceId= */ 5);
+                verifyNoMoreInteractions(callback);
+            } finally {
+                mTracker.destroy(replacement);
+            }
+        } finally {
+            RecentlyClosedEntriesManager.clearNativeUpdatedCallback(mProfile);
+            mTracker.destroy(first);
+            mTracker.destroy(second);
+        }
+    }
