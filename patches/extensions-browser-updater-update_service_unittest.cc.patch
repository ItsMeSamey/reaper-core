+#if BUILDFLAG(IS_ANDROID)
+TEST_F(UpdateServiceTest, ShutdownCancelsPendingStateCallbacks) {
+  const auto extension =
+      ExtensionBuilder("Pending update")
+          .SetVersion("1.0")
+          .SetID(crx_file::id_util::GenerateId("pending-update"))
+          .Build();
+  ASSERT_TRUE(
+      ExtensionRegistry::Get(browser_context())->AddEnabled(extension));
+
+  ExtensionUpdateCheckParams params;
+  params.update_info[extension->id()] = ExtensionUpdateData();
+  bool found_update = false;
+  bool completed = false;
+  StartUpdateCheck(true, params, found_update, completed);
+  ASSERT_EQ(1, update_client()->num_update_requests());
+  const auto& state_callback =
+      update_client()->update_request(0).state_change_callback;
+  ASSERT_FALSE(state_callback.is_null());
+  ASSERT_FALSE(state_callback.IsCancelled());
+
+  update_service()->Shutdown();
+
+  // Inspect cancellation without invoking any retired callback.
+  EXPECT_TRUE(state_callback.IsCancelled());
+  EXPECT_FALSE(found_update);
+  EXPECT_FALSE(completed);
+  update_service()->Shutdown();
+  EXPECT_TRUE(state_callback.IsCancelled());
+}
+#endif
