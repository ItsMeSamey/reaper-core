+    @Test
+    @SmallTest
+    public void aggregateTransitionsNotifyActualManagerAfterInitializationAndDetachNormally() {
+        var dom = org.chromium.base.supplier.ObservableSuppliers.createNonNull(false);
+        var ui = org.chromium.base.supplier.ObservableSuppliers.createNonNull(true);
+        when(mFullscreenManager.getPersistentFullscreenModeSupplier()).thenReturn(dom);
+        when(mFullscreenManager.getFullscreenUiModeSupplier()).thenReturn(ui);
+        var nativeManager = org.mockito.Mockito.mock(ExclusiveAccessManager.Natives.class);
+        ExclusiveAccessManagerJni.setInstanceForTesting(nativeManager);
+        var manager = new ExclusiveAccessManager(mFullscreenManager, null);
+        var modelSelector =
+                org.mockito.Mockito.mock(
+                        org.chromium.chrome.browser.tabmodel.TabModelSelector.class);
+        when(modelSelector.getModels()).thenReturn(java.util.List.of());
+        when(nativeManager.init(
+                        org.mockito.ArgumentMatchers.any(),
+                        org.mockito.ArgumentMatchers.any(),
+                        org.mockito.ArgumentMatchers.any(),
+                        org.mockito.ArgumentMatchers.any()))
+                .thenReturn(321L);
+        manager.initialize(modelSelector, mWindowAndroid, new ActivityTabProvider());
+        verify(nativeManager).onWindowFullscreenStateChanged(321L);
+        org.junit.Assert.assertFalse(manager.getExclusiveAccessStateSupplier().get());
+        ui.set(false);
+        verify(nativeManager, org.mockito.Mockito.times(2)).onWindowFullscreenStateChanged(321L);
+        manager.destroy();
+        ui.set(true);
+        verify(nativeManager, org.mockito.Mockito.times(2)).onWindowFullscreenStateChanged(321L);
+        verify(nativeManager).destroy(321L);
+    }
