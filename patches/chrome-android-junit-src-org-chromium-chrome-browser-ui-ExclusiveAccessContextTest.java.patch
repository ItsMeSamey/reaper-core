+    @Test
+    @SmallTest
+    public void trustedOriginIsForwardedBeforeInitialAggregateNoticeAndClearedOnExit() {
+        String extensionUrl = "chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/";
+        String displayName = "Approved Extension";
+        var origin =
+                org.chromium.base.supplier.ObservableSuppliers.createNonNull(
+                        new FullscreenManager.BrowserFullscreenExtensionInfo(
+                                extensionUrl, displayName));
+        var dom = org.chromium.base.supplier.ObservableSuppliers.createNonNull(false);
+        var ui = org.chromium.base.supplier.ObservableSuppliers.createNonNull(true);
+        when(mFullscreenManager.getBrowserFullscreenExtensionInfoSupplier()).thenReturn(origin);
+        when(mFullscreenManager.getPersistentFullscreenModeSupplier()).thenReturn(dom);
+        when(mFullscreenManager.getFullscreenUiModeSupplier()).thenReturn(ui);
+        var nativeManager = org.mockito.Mockito.mock(ExclusiveAccessManager.Natives.class);
+        ExclusiveAccessManagerJni.setInstanceForTesting(nativeManager);
+        var selector =
+                org.mockito.Mockito.mock(
+                        org.chromium.chrome.browser.tabmodel.TabModelSelector.class);
+        when(selector.getModels()).thenReturn(java.util.List.of());
+        when(nativeManager.init(
+                        org.mockito.ArgumentMatchers.any(),
+                        org.mockito.ArgumentMatchers.any(),
+                        org.mockito.ArgumentMatchers.any(),
+                        org.mockito.ArgumentMatchers.any()))
+                .thenReturn(321L);
+        var manager = new ExclusiveAccessManager(mFullscreenManager, null);
+        try {
+            manager.initialize(selector, mWindowAndroid, new ActivityTabProvider());
+            var order = org.mockito.Mockito.inOrder(nativeManager);
+            order.verify(nativeManager)
+                    .init(
+                            org.mockito.ArgumentMatchers.any(),
+                            org.mockito.ArgumentMatchers.any(),
+                            org.mockito.ArgumentMatchers.any(),
+                            org.mockito.ArgumentMatchers.any());
+            order.verify(nativeManager).setFullscreenExtensionUrl(321L, extensionUrl, displayName);
+            order.verify(nativeManager).onWindowFullscreenStateChanged(321L);
+            ui.set(false);
+            origin.set(new FullscreenManager.BrowserFullscreenExtensionInfo("", ""));
+            order.verify(nativeManager).onWindowFullscreenStateChanged(321L);
+            order.verify(nativeManager).setFullscreenExtensionUrl(321L, "", "");
+            org.junit.Assert.assertFalse(manager.getExclusiveAccessStateSupplier().get());
+        } finally {
+            manager.destroy();
+        }
+        origin.set(new FullscreenManager.BrowserFullscreenExtensionInfo(extensionUrl, displayName));
+        verify(nativeManager, org.mockito.Mockito.times(1))
+                .setFullscreenExtensionUrl(321L, extensionUrl, displayName);
+    }
