+    private static class DeniedBindingContext extends TestContext {
+        private NativeMessagingConnection mConnection;
+        private Intent mIntent;
+        private int mFlags;
+        private int mBindAttempts;
+        private int mUnbindAttempts;
+
+        DeniedBindingContext(Context base) {
+            super(base);
+        }
+
+        @Override
+        public boolean bindService(Intent service, ServiceConnection conn, int flags) {
+            mConnection = (NativeMessagingConnection) conn;
+            mIntent = service;
+            mFlags = flags;
+            mBindAttempts++;
+            throw new SecurityException("Service bind denied by Android");
