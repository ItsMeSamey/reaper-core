     @Test
+    public void testDeniedBindReturnsUniformErrorAndAllowsRecoveryInBothRoutes() {
+        Mockito.when(mMockPackageManager.hasSigningCertificate(
+                TARGET_PACKAGE, SIGNED_CERT_BYTES, PackageManager.CERT_INPUT_SHA256)).thenReturn(true);
+
+        for (boolean requireAuthorizedCompanion : new boolean[] {false, true}) {
+            NativeMessagingManager manager =
+                    NativeMessagingManager.getForProfile(mProfile, requireAuthorizedCompanion);
+            DeniedBindingContext deniedContext = new DeniedBindingContext(mTestContext);
+            ContextUtils.initApplicationContextForTests(deniedContext);
+            byte[][] certificates = requireAuthorizedCompanion
+                    ? new byte[][] {SIGNED_CERT_BYTES} : NO_CERTIFICATES;
+            NativeMessageAndroidPort port = Mockito.mock(NativeMessageAndroidPort.class);
+            try {
+                Assert.assertEquals("Unable to connect to " + TARGET_PACKAGE + ".",
+                        manager.addPort(TARGET_PACKAGE, EXTENSION_ID, true,
+                                requireAuthorizedCompanion, certificates, port));
+                Assert.assertEquals(1, deniedContext.mBindAttempts);
+                Assert.assertEquals(TARGET_PACKAGE, deniedContext.mIntent.getPackage());
+                Assert.assertEquals(NativeMessagingConnection.ACTION_NATIVE_MESSAGING,
+                        deniedContext.mIntent.getAction());
+                Assert.assertEquals(Context.BIND_AUTO_CREATE, deniedContext.mFlags);
+                Assert.assertNull(manager.getConnectionForTesting(TARGET_PACKAGE));
+
+                NativeMessagingConnection connection = deniedContext.mConnection;
+                Assert.assertNotNull(connection);
+                Assert.assertFalse(connection.isBound());
+                Assert.assertNull(connection.getServiceForTesting());
+                Assert.assertNull(connection.getSessionForTesting(EXTENSION_ID));
+                Assert.assertEquals("Unable to connect to " + TARGET_PACKAGE + ".",
+                        connection.addPort(EXTENSION_ID, true, requireAuthorizedCompanion, port));
+
+                // A late callback on this rejected binding must not consult or authenticate a service.
+                IBinder lateBinder = Mockito.mock(IBinder.class);
+                connection.onServiceConnected(
+                        new ComponentName(TARGET_PACKAGE, "NativeMessageService"), lateBinder);
+                connection.unbind();
+                connection.unbind();
+                Assert.assertFalse(connection.isBound());
+                Assert.assertNull(connection.getServiceForTesting());
+                Assert.assertNull(connection.getSessionForTesting(EXTENSION_ID));
+                Assert.assertEquals(0, deniedContext.mUnbindAttempts);
+                Mockito.verifyNoInteractions(port, lateBinder);
+
+                // The failed constructor must not poison the manager's later normal bind.
+                ContextUtils.initApplicationContextForTests(mTestContext);
+                Assert.assertNull(manager.addPort(TARGET_PACKAGE, EXTENSION_ID, true,
+                        requireAuthorizedCompanion, certificates, new NativeMessageAndroidPort()));
+                NativeMessagingConnection recovered = manager.getConnectionForTesting(TARGET_PACKAGE);
+                Assert.assertNotNull(recovered);
+                Assert.assertNotSame(connection, recovered);
+                Assert.assertTrue(recovered.isBound());
+                Assert.assertNotNull(recovered.getSessionForTesting(EXTENSION_ID));
+            } finally {
+                ContextUtils.initApplicationContextForTests(mTestContext);
+                manager.destroy();
+            }
+        }
+        Mockito.verify(mMockPackageManager, Mockito.times(2)).hasSigningCertificate(
+                TARGET_PACKAGE, SIGNED_CERT_BYTES, PackageManager.CERT_INPUT_SHA256);
+    }
