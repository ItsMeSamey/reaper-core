+TEST_F(WebstoreInstallerAndroidLifecycleTest,
+       ProfileShutdownRetiresPendingDownload) {
+  auto installer = CreateInstaller("abcdefghijklmnopabcdefghijklmnop");
+  on_failure_ = base::BindLambdaForTesting([&] { installer->Start(); });
+  installer->Start();
+  EXPECT_EQ(0, failure_count_);
+  EXPECT_FALSE(installer->HasOneRef());
+
+  // The real file task is pending; retire the repaired operation via genuine
+  // profile/registry shutdown before allowing its UI reply to complete.
+  web_contents_.reset();
+  DeleteProfile();
+  EXPECT_EQ(1, failure_count_);
+  EXPECT_EQ(WebstoreInstaller::FAILURE_REASON_CANCELLED, last_reason_);
+  EXPECT_TRUE(IsRetired(*installer));
+  task_environment()->RunUntilIdle();
+  EXPECT_TRUE(installer->HasOneRef());
+  EXPECT_EQ(1, failure_count_);
+  EXPECT_EQ(0, success_count_);
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  EXPECT_TRUE(base::FileEnumerator(download_directory_, false,
+                                   base::FileEnumerator::FILES)
+                  .Next()
+                  .empty());
+}
