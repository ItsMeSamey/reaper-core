+TEST_F(WebstoreInstallerAndroidLifecycleTest,
+       DownloadDestroyedBeforeCrxHandoffRetiresAndAllowsFreshRetry) {
+  const std::string id = "abcdefghijklmnopabcdefghijklmnop";
+  auto item =
+      std::make_unique<testing::StrictMock<download::MockDownloadItem>>();
+  EXPECT_CALL(*item, GetState())
+      .WillRepeatedly(testing::Return(download::DownloadItem::IN_PROGRESS));
+  EXPECT_CALL(*item, Cancel(testing::_)).Times(0);
+  auto installer = StartDownloadItem(item.get());
+  task_environment()->RunUntilIdle();
+  ASSERT_TRUE(tracker()->GetActiveInstall(id));
+  ASSERT_FALSE(IsRetired(*installer));
+
+  // MockDownloadItem's real destructor notifies the installed observer. No
+  // synthetic terminal update or registry shutdown completes this operation.
+  item.reset();
+  EXPECT_EQ(1, failure_count_);
+  EXPECT_EQ(0, success_count_);
+  EXPECT_EQ(WebstoreInstaller::FAILURE_REASON_CANCELLED, last_reason_);
+  EXPECT_TRUE(IsRetired(*installer));
+  EXPECT_TRUE(installer->HasOneRef());
+  EXPECT_FALSE(tracker()->GetActiveInstall(id));
+  installer->Start();
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(1, failure_count_);
+
+  auto retry_item =
+      std::make_unique<testing::StrictMock<download::MockDownloadItem>>();
+  EXPECT_CALL(*retry_item, GetState())
+      .WillRepeatedly(testing::Return(download::DownloadItem::IN_PROGRESS));
+  EXPECT_CALL(*retry_item, Cancel(testing::_)).Times(0);
+  auto retry = StartDownloadItem(retry_item.get());
+  task_environment()->RunUntilIdle();
+  EXPECT_TRUE(tracker()->GetActiveInstall(id));
+  EXPECT_FALSE(IsRetired(*retry));
+  retry_item.reset();
+  EXPECT_EQ(2, failure_count_);
+  EXPECT_TRUE(IsRetired(*retry));
+  EXPECT_FALSE(tracker()->GetActiveInstall(id));
+}
