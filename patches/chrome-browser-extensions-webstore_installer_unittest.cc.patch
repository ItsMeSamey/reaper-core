+class DestructionObservedWebstoreInstaller : public WebstoreInstaller {
+ public:
+  using WebstoreInstaller::WebstoreInstaller;
+
+  void ObserveDestruction(base::OnceClosure callback) {
+    on_destroyed_ = std::move(callback);
+  }
+
+ protected:
+  ~DestructionObservedWebstoreInstaller() override {
+    if (on_destroyed_) {
+      std::move(on_destroyed_).Run();
+    }
+  }
+
+ private:
+  base::OnceClosure on_destroyed_;
+};
+
+class RegistryShutdownOnRemoval : public download::DownloadItem::Observer {
+ public:
+  explicit RegistryShutdownOnRemoval(base::OnceClosure callback)
+      : on_removed_(std::move(callback)) {}
+
+  void OnDownloadRemoved(download::DownloadItem*) override {
+    std::move(on_removed_).Run();
+  }
+
+ private:
+  base::OnceClosure on_removed_;
+};
