+class WebstoreInstallerAndroidLifecycleTest : public ExtensionServiceTestBase {
+ protected:
+  void SetUp() override {
+    ExtensionServiceTestBase::SetUp();
+    CreateProfileAndContents();
+    download_directory_ = temp_dir().GetPath().AppendASCII("pending_store");
+    WebstoreInstaller::SetDownloadDirectoryForTests(&download_directory_);
+  }
+
+  void TearDown() override {
+    on_failure_.Reset();
+    web_contents_.reset();
+    ExtensionServiceTestBase::TearDown();
+    task_environment()->RunUntilIdle();
+    WebstoreInstaller::SetDownloadDirectoryForTests(nullptr);
+  }
+
+  void CreateProfileAndContents() {
+    InitializeEmptyExtensionService();
+    web_contents_ = content::WebContentsTester::CreateTestWebContents(
+        profile(), nullptr);
+  }
+
+  scoped_refptr<WebstoreInstaller> CreateInstaller(
+      const std::string& id, base::OnceClosure on_destroyed = base::OnceClosure()) {
+    std::unique_ptr<InstallApproval> approval;
+    if (crx_file::id_util::IdIsValid(id)) {
+      base::DictValue manifest;
+      manifest.Set("name", "Lifecycle extension");
+      manifest.Set("manifest_version", 3);
+      manifest.Set("version", "1");
+      approval = InstallApproval::CreateWithNoInstallPrompt(
+          profile(), id, std::move(manifest), /*strict_manifest_check=*/true);
+    }
+    auto installer = base::MakeRefCounted<DestructionObservedWebstoreInstaller>(
+        profile(),
+        base::BindLambdaForTesting([this](const std::string&) {
+          ++success_count_;
+        }),
+        base::BindLambdaForTesting(
+            [this](const std::string&, const std::string& error,
+                   WebstoreInstaller::FailureReason reason) {
+              ++failure_count_;
+              last_error_ = error;
+              last_reason_ = reason;
+              if (on_failure_) {
+                on_failure_.Run();
+              }
+            }),
+        web_contents_.get(), id, std::move(approval),
+        WebstoreInstaller::INSTALL_SOURCE_OTHER);
+    installer->ObserveDestruction(std::move(on_destroyed));
+    return installer;
+  }
+
+  bool IsRetired(const WebstoreInstaller& installer) {
+    return installer.completed_ && !installer.browser_context_ &&
+           !installer.extension_registry_observation_.IsObserving() &&
+           !installer.download_item_ && !installer.start_ref_held_ &&
+           !installer.download_progress_timer_.IsRunning();
+  }
+
+  scoped_refptr<WebstoreInstaller> StartDownloadItem(
+      download::MockDownloadItem* item,
+      base::OnceClosure on_destroyed = base::OnceClosure()) {
+    auto manager =
+        std::make_unique<testing::NiceMock<content::MockDownloadManager>>();
+    EXPECT_CALL(*manager, DownloadUrlMock(testing::_))
+        .WillOnce([item](download::DownloadUrlParameters* params) {
+          ASSERT_TRUE(params->callback());
+          std::move(params->callback())
+              .Run(item, download::DOWNLOAD_INTERRUPT_REASON_NONE);
+        });
+    profile()->SetDownloadManagerForTesting(std::move(manager));
+    auto installer = CreateInstaller("abcdefghijklmnopabcdefghijklmnop",
+                                     std::move(on_destroyed));
+    installer->Start();
+    return installer;
+  }
+
+  void SetCrxHandoffForTesting(WebstoreInstaller* installer) {
+    installer->crx_installer_ = CrxInstaller::CreateSilent(profile());
+  }
+
+  InstallTracker* tracker() {
+    return ExtensionsBrowserClient::Get()->GetInstallTracker(profile());
+  }
+
+  void ExpectAlreadyInterruptedDownloadRetires(
+      download::DownloadInterruptReason reason) {
+    testing::StrictMock<download::MockDownloadItem> item;
+    EXPECT_CALL(item, GetState())
+        .WillRepeatedly(testing::Return(download::DownloadItem::INTERRUPTED));
+    EXPECT_CALL(item, GetLastReason()).WillRepeatedly(testing::Return(reason));
+    EXPECT_CALL(item, Cancel(testing::_)).Times(0);
+    auto installer = StartDownloadItem(&item);
+    ASSERT_TRUE(tracker()->GetActiveInstall("abcdefghijklmnopabcdefghijklmnop"));
+    // The failure predates observer attachment. No later item notification is
+    // sent until after the completion and ownership assertions.
+    task_environment()->RunUntilIdle();
+    EXPECT_EQ(1, failure_count_);
+    EXPECT_EQ(0, success_count_);
+    EXPECT_EQ(WebstoreInstaller::FAILURE_REASON_OTHER, last_reason_);
+    EXPECT_EQ(l10n_util::GetStringUTF8(IDS_WEBSTORE_DOWNLOAD_ACCESS_DENIED),
+              last_error_);
+    EXPECT_TRUE(IsRetired(*installer));
+    EXPECT_TRUE(installer->HasOneRef());
+    EXPECT_FALSE(tracker()->GetActiveInstall("abcdefghijklmnopabcdefghijklmnop"));
+    item.NotifyObserversDownloadUpdated();
+    installer->Start();
+    task_environment()->RunUntilIdle();
+    EXPECT_EQ(1, failure_count_);
+  }
+
+  ScopedInstallVerifierBypassForTest verifier_bypass_;
+  std::unique_ptr<content::WebContents> web_contents_;
+  base::FilePath download_directory_;
+  base::RepeatingClosure on_failure_;
+  int success_count_ = 0;
+  int failure_count_ = 0;
+  std::string last_error_;
+  WebstoreInstaller::FailureReason last_reason_ =
+      WebstoreInstaller::FAILURE_REASON_OTHER;
+};
