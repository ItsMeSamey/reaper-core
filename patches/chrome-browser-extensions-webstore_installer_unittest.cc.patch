+  on_failure_.Reset();
+  CreateProfileAndContents();
+  auto retry = CreateInstaller("invalid");
+  retry->Start();
+  EXPECT_EQ(2, failure_count_);
+  EXPECT_EQ(0, success_count_);
+  EXPECT_TRUE(IsRetired(*retry));
+  EXPECT_TRUE(retry->HasOneRef());
+}
