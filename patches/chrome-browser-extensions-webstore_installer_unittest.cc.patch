+TEST_F(WebstoreInstallerAndroidLifecycleTest,
+       FailureCallbackCanShutdownProfileAndFreshOperationCanRetry) {
+  auto installer = CreateInstaller("invalid");
+  on_failure_ = base::BindLambdaForTesting([this] {
+    web_contents_.reset();
+    DeleteProfile();
+  });
+  installer->Start();
+  EXPECT_EQ(1, failure_count_);
+  EXPECT_EQ("Invalid id", last_error_);
+  EXPECT_TRUE(IsRetired(*installer));
+  EXPECT_TRUE(installer->HasOneRef());
+  installer->Start();
+  EXPECT_EQ(1, failure_count_);
