+TEST_F(WebstoreInstallerAndroidLifecycleTest,
+       DownloadRemovalRetiresOperationWithoutLosingCallbackOwner) {
+  const std::string id = "abcdefghijklmnopabcdefghijklmnop";
+  testing::StrictMock<download::MockDownloadItem> item;
+  EXPECT_CALL(item, GetState())
+      .WillRepeatedly(testing::Return(download::DownloadItem::IN_PROGRESS));
+  auto manager =
+      std::make_unique<testing::NiceMock<content::MockDownloadManager>>();
+  EXPECT_CALL(*manager, DownloadUrlMock(testing::_))
+      .WillOnce([&](download::DownloadUrlParameters* params) {
+        ASSERT_TRUE(params->callback());
+        std::move(params->callback())
+            .Run(&item, download::DOWNLOAD_INTERRUPT_REASON_NONE);
+      });
+  profile()->SetDownloadManagerForTesting(std::move(manager));
+
+  auto destroyed = std::make_shared<bool>(false);
+  auto installer = CreateInstaller(
+      id, base::BindLambdaForTesting([destroyed] { *destroyed = true; }));
+  WebstoreInstaller* raw_installer = installer.get();
+  on_failure_ = base::BindLambdaForTesting(
+      [&] { EXPECT_TRUE(IsRetired(*raw_installer)); });
+  installer->Start();
+  // Consume genuine path preparation and the ordinary DownloadUrl started
+  // callback. No file reply or caller reference remains during removal.
+  task_environment()->RunUntilIdle();
+  ASSERT_EQ(0, failure_count_);
+  ASSERT_FALSE(IsRetired(*installer));
+  installer.reset();
+  ASSERT_FALSE(*destroyed);
+
+  RegistryShutdownOnRemoval removal_observer(
+      base::BindLambdaForTesting([this] { registry()->Shutdown(); }));
+  item.AddObserver(&removal_observer);
+  EXPECT_CALL(item, Remove()).WillOnce([&] {
+    item.NotifyObserversDownloadRemoved();
+    // The repaired callback owns itself until Remove() has returned.
+    EXPECT_FALSE(*destroyed);
+  });
+  EXPECT_CALL(item, Cancel(testing::_)).Times(0);
+  auto extension = ExtensionBuilder("Lifecycle extension")
+                       .SetManifestVersion(3)
+                       .SetID(id)
+                       .Build();
+  ASSERT_TRUE(extension);
+  registry()->AddEnabled(extension);
+  registry()->TriggerOnInstalled(extension.get(), /*is_update=*/false);
+  EXPECT_TRUE(*destroyed);
+  EXPECT_EQ(1, failure_count_);
+  EXPECT_EQ(WebstoreInstaller::FAILURE_REASON_CANCELLED, last_reason_);
+  EXPECT_EQ(0, success_count_);
+  item.RemoveObserver(&removal_observer);
+}
