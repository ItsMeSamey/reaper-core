@@ -64,6 +69,41 @@
   content::WebContents* web_contents =
       content::DownloadItemUtils::GetWebContents(
           const_cast<DownloadItem*>(&download_item));
+#if BUILDFLAG(IS_ANDROID)
+  const auto can_use_prompt_host = [profile](content::WebContents* contents) {
+    return contents && !contents->IsBeingDestroyed() &&
+           contents->GetBrowserContext() == profile &&
+           contents->GetTopLevelNativeWindow();
+  };
+  if (!can_use_prompt_host(web_contents)) {
+    web_contents = nullptr;
+    // Keep the existing activation preference, skipping windows without a
+    // live prompt host in this exact profile.
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* browser) {
+          if (browser->GetProfile() != profile || browser->IsDeleteScheduled()) {
+            return true;
+          }
+          TabListInterface* tab_list = TabListInterface::From(browser);
+          if (!tab_list) {
+            return true;
+          }
+          auto* active_tab = tab_list->GetActiveTab();
+          if (!active_tab) {
+            return true;
+          }
+          content::WebContents* contents = active_tab->GetContents();
+          if (!can_use_prompt_host(contents)) {
+            return true;
+          }
+          web_contents = contents;
+          return false;
+        });
+  }
+  if (!web_contents) {
+    return nullptr;
+  }
+#else
   if (!web_contents) {
     BrowserWindowInterface* browser =
         extensions::browser_window_util::GetLastActiveBrowserWithProfile(
@@ -83,6 +123,7 @@
