+TEST_F(TtsControllerTest, ExtensionVoiceDispatchAndCompletion) {
+  VoiceData voice;
+  voice.native = false;
+  voice.engine_id = "extension-engine";
+  voice.name = "Extension test voice";
+  voice.events.insert(TTS_EVENT_END);
+  engine_delegate()->set_voices({voice});
+  auto utterance = TtsUtterance::Create(browser_context(), true);
+  utterance->SetEngineId(voice.engine_id);
+  utterance->SetText("Android extension speech");
+  const int id = utterance->GetId();
+  controller()->SpeakOrEnqueue(std::move(utterance));
+  EXPECT_EQ(id, engine_delegate()->utterance_id());
+  ASSERT_TRUE(TtsControllerCurrentUtterance());
+  EXPECT_TRUE(controller()->IsSpeaking());
+  controller()->OnTtsEvent(id, TTS_EVENT_END, 24, 0, {});
+  EXPECT_FALSE(TtsControllerCurrentUtterance());
+  EXPECT_FALSE(controller()->IsSpeaking());
+}
