+#if BUILDFLAG(IS_ANDROID)
+std::vector<bool> AndroidDiscardedChangesForTab(
+    const TestEventRouterObserver& observer,
+    Profile* profile,
+    const Extension* extension,
+    int tab_id) {
+  std::vector<bool> changes;
+  for (const auto& event : observer.all_events()) {
+    if (event->event_name != api::tabs::OnUpdated::kEventName) {
+      continue;
+    }
+    std::optional<base::ListValue> args;
+    mojom::EventFilteringInfoPtr filtering;
+    if (!event->will_dispatch_callback.Run(
+            profile, mojom::ContextType::kUnprivilegedExtension, extension,
+            nullptr, args, filtering, nullptr)) {
+      continue;
+    }
+    if (!args || args->size() != 3u) {
+      ADD_FAILURE() << "Unexpected tabs.onUpdated arguments";
+      continue;
+    }
+    if ((*args)[0].GetInt() != tab_id) {
+      continue;
+    }
+    const auto discarded = (*args)[1].GetDict().FindBool("discarded");
+    if (discarded.has_value()) {
+      changes.push_back(*discarded);
+    }
+  }
+  return changes;
+}
