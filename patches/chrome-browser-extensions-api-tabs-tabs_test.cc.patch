+IN_PROC_BROWSER_TEST_F(ExtensionTabsTest,
+                       AndroidRefusedDiscardDoesNotReportStateChange) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  content::WebContents* contents =
+      GetTabListInterface()
+          ->OpenTab(embedded_test_server()->GetURL("a.test", "/title1.html"),
+                    -1,
+                    /*foreground=*/false)
+          ->GetContents();
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  const int tab_id = ExtensionTabUtil::GetTabId(contents);
+  auto extension =
+      ExtensionBuilder("Refused discard").SetManifestVersion(3).Build();
+  TabsWindowsAPI::Get(profile())->InitTabsEventRouter();
+  TestEventRouterObserver observer(EventRouter::Get(profile()));
+  const GURL new_url = embedded_test_server()->GetURL("b.test", "/title2.html");
+  bool attempted = false;
+  content::CommitMessageDelayer commit_delayer(
+      contents, new_url,
+      base::BindLambdaForTesting([&](content::RenderFrameHost*) {
+        // This callback runs before the speculative frame's commit IPC is
+        // processed. FrameTree refuses the discard while that commit is
+        // pending.
+        attempted = true;
+        observer.ClearEvents();
+        auto discard = base::MakeRefCounted<TabsDiscardFunction>();
+        discard->set_extension(extension.get());
+        EXPECT_EQ(
+            base::StringPrintf("Cannot discard tab with id: %d.", tab_id),
+            utils::RunFunctionAndReturnError(
+                discard.get(), base::StringPrintf("[%d]", tab_id), profile()));
+        EXPECT_FALSE(contents->WasDiscarded());
+        EXPECT_TRUE(AndroidDiscardedChangesForTab(observer, profile(),
+                                                  extension.get(), tab_id)
+                        .empty());
+      }));
+  contents->GetController().LoadURLWithParams(
+      content::NavigationController::LoadURLParams(new_url));
+  commit_delayer.Wait();
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  EXPECT_TRUE(attempted);
+  EXPECT_EQ(new_url, contents->GetLastCommittedURL());
+  EXPECT_FALSE(contents->WasDiscarded());
+  EXPECT_TRUE(AndroidDiscardedChangesForTab(observer, profile(),
+                                            extension.get(), tab_id)
+                  .empty());
+}
+#endif  // BUILDFLAG(IS_ANDROID)
 
