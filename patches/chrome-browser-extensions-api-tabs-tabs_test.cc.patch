+IN_PROC_BROWSER_TEST_F(ExtensionTabsTest,
+                       AndroidCanceledRestoreReportsDiscardedOnce) {
+  net::test_server::ControllableHttpResponse response(embedded_test_server(),
+                                                      "/pending-restore");
+  ASSERT_TRUE(embedded_test_server()->Start());
+  content::WebContents* contents = GetTabListInterface()
+                                       ->OpenTab(GURL(url::kAboutBlankURL), -1,
+                                                 /*foreground=*/false)
+                                       ->GetContents();
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  const GURL committed_url = contents->GetLastCommittedURL();
+  const int tab_id = ExtensionTabUtil::GetTabId(contents);
+  auto extension =
+      ExtensionBuilder("Canceled restore").SetManifestVersion(3).Build();
+  TabsWindowsAPI::Get(profile())->InitTabsEventRouter();
+  auto discard = base::MakeRefCounted<TabsDiscardFunction>();
+  discard->set_extension(extension.get());
+  ASSERT_TRUE(utils::RunFunctionAndReturnSingleResult(
+      discard.get(), base::StringPrintf("[%d]", tab_id), profile()));
+  ASSERT_TRUE(contents->WasDiscarded());
+
+  TestEventRouterObserver observer(EventRouter::Get(profile()));
+  content::NavigationController::LoadURLParams params(
+      embedded_test_server()->GetURL("/pending-restore"));
+  contents->GetController().LoadURLWithParams(params);
+  response.WaitForRequest();
+  ASSERT_FALSE(contents->WasDiscarded());
+  ASSERT_EQ(committed_url, contents->GetLastCommittedURL());
+  EXPECT_EQ(std::vector<bool>({false}),
+            AndroidDiscardedChangesForTab(observer, profile(), extension.get(),
+                                          tab_id));
+
+  contents->Stop();
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  EXPECT_EQ(committed_url, contents->GetLastCommittedURL());
+  EXPECT_FALSE(contents->WasDiscarded());
+  EXPECT_TRUE(
+      RunQueryFunction(extension.get(), R"([{"discarded":true}])").empty());
+  EXPECT_EQ(std::vector<bool>({false}),
+            AndroidDiscardedChangesForTab(observer, profile(), extension.get(),
+                                          tab_id));
+}
