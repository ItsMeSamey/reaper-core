+#if BUILDFLAG(IS_ANDROID)
+TEST_F(ValuableSyncBridgeTest,
+       AndroidFullSyncMixedDocumentsRetainsLoyaltyCards) {
+  const LoyaltyCard card = TestLoyaltyCard("1");
+  sync_pb::AutofillValuableSpecifics document;
+  document.set_id("document");
+  document.mutable_vehicle_registration();
+  auto unsupported = CreateEntityDataFromSpecifics(document);
+  EXPECT_FALSE(bridge().IsEntityDataValid(*unsupported));
+  syncer::EntityChangeList changes;
+  changes.push_back(
+      syncer::EntityChange::CreateAdd(document.id(), std::move(*unsupported)));
+  changes.push_back(syncer::EntityChange::CreateAdd(card.id().value(),
+                                                    CardToEntityData(card)));
+  EXPECT_FALSE(bridge()
+                   .MergeFullSyncData(bridge().CreateMetadataChangeList(),
+                                      std::move(changes))
+                   .has_value());
+  EXPECT_THAT(GetAllLoyaltyCardsFromTable(), ElementsAre(card));
+  EXPECT_THAT(
+      ExtractLoyaltyCardsFromDataBatch(bridge().GetAllDataForDebugging()),
+      ElementsAre(card));
+}
+TEST_F(ValuableSyncBridgeTest,
+       AndroidRealIncrementalBridgeIgnoresDocumentsWithoutDroppingLoyalty) {
+  ASSERT_TRUE(bridge().SupportsIncrementalUpdates());
+  const LoyaltyCard card = TestLoyaltyCard("1");
+  sync_pb::AutofillValuableSpecifics document;
+  document.set_id("document");
+  document.mutable_flight_reservation();
+  syncer::EntityChangeList changes;
+  changes.push_back(syncer::EntityChange::CreateAdd(
+      document.id(), std::move(*CreateEntityDataFromSpecifics(document))));
+  changes.push_back(syncer::EntityChange::CreateAdd(card.id().value(),
+                                                    CardToEntityData(card)));
+  EXPECT_FALSE(bridge()
+                   .ApplyIncrementalSyncChanges(
+                       bridge().CreateMetadataChangeList(), std::move(changes))
+                   .has_value());
+  EXPECT_THAT(GetAllLoyaltyCardsFromTable(), ElementsAre(card));
+  syncer::EntityChangeList deletes;
+  deletes.push_back(syncer::EntityChange::CreateDelete(card.id().value(),
+                                                       CardToEntityData(card)));
+  EXPECT_FALSE(bridge()
+                   .ApplyIncrementalSyncChanges(
+                       bridge().CreateMetadataChangeList(), std::move(deletes))
+                   .has_value());
+  EXPECT_TRUE(GetAllLoyaltyCardsFromTable().empty());
+}
+#endif  // BUILDFLAG(IS_ANDROID)
 
