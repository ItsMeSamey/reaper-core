+    @Test
+    public void escapeExitsBrowserAndActualTabFullscreen() {
+        var manager = org.mockito.Mockito.mock(FullscreenManager.class);
+        when(manager.getBrowserFullscreenMode()).thenReturn(true);
+        when(manager.getPersistentFullscreenMode()).thenReturn(true);
+        var event = new KeyEvent(KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_ESCAPE);
+        assertTrue(KeyboardShortcuts.dispatchKeyEvent(event, true, manager, mController, null));
+        verify(manager).setBrowserFullscreenMode(false);
+        verify(manager).exitPersistentFullscreenMode();
+        verify(mController, org.mockito.Mockito.never())
+                .onMenuOrKeyboardAction(
+                        org.mockito.ArgumentMatchers.anyInt(),
+                        org.mockito.ArgumentMatchers.anyBoolean());
+    }
