+    @Test
+    public void modifiedEscapePreservesOrdinaryShortcutRouting() {
+        var manager = org.mockito.Mockito.mock(FullscreenManager.class);
+        when(manager.getBrowserFullscreenMode()).thenReturn(true);
+        var event =
+                new KeyEvent(
+                        SystemClock.uptimeMillis(),
+                        SystemClock.uptimeMillis(),
+                        KeyEvent.ACTION_DOWN,
+                        KeyEvent.KEYCODE_ESCAPE,
+                        0,
+                        KeyEvent.META_CTRL_ON);
+        KeyboardShortcuts.dispatchKeyEvent(event, true, manager, mController, null);
+        verify(manager, org.mockito.Mockito.never()).setBrowserFullscreenMode(false);
+    }
