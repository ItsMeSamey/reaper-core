+TEST_F(BnplManagerTest,
+       AndroidAiFlagCannotSendIssuerRequestWithoutOrdinaryAmount) {
+  base::test::ScopedFeatureList scoped_features;
+  scoped_features.InitWithFeatures(
+      {features::kAutofillEnableAiBasedAmountExtraction},
+      {features::kAutofillEnablePayNowPayLaterTabs});
+  auto& data = payments_autofill_client().GetPaymentsDataManager();
+  ASSERT_FALSE(data.IsAutofillAmountExtractionAiTermsSeenPrefEnabled());
+  EXPECT_CALL(GetBnplUiDelegate(),
+              ShowProgressUi(
+                  AutofillProgressUiType::kBnplAmountExtractionProgressUi, _));
+  EXPECT_CALL(GetBnplUiDelegate(), ShowSelectBnplIssuerUi(_, _, _, _)).Times(0);
+  EXPECT_CALL(*payments_network_interface_,
+              GetDetailsForCreateBnplPaymentInstrument(_, _))
+      .Times(0);
+  EXPECT_CALL(*payments_network_interface_,
+              GetDetailsForUpdateBnplPaymentInstrument(_, _))
+      .Times(0);
+  EXPECT_CALL(*payments_network_interface_,
+              GetBnplPaymentInstrumentForFetchingUrl(_, _))
+      .Times(0);
+  bnpl_manager_->OnUserDecisionToUseBnpl(std::nullopt, base::DoNothing());
+  bnpl_manager_->OnIssuerAccepted(test::GetTestUnlinkedBnplIssuer());
+  EXPECT_FALSE(data.IsAutofillAmountExtractionAiTermsSeenPrefEnabled());
+  EXPECT_FALSE(
+      test_api(*bnpl_manager_).GetOngoingFlowState()->final_checkout_amount);
+  EXPECT_CALL(*mock_amount_extraction_manager_, Reset()).Times(1);
+  test_api(*bnpl_manager_).Reset();
+}
+
+TEST_F(BnplManagerTest,
+       AndroidOrdinaryAmountCompletesIssuerSelectionWithAiFlagOn) {
+  base::test::ScopedFeatureList scoped_features;
+  scoped_features.InitWithFeatures(
+      {features::kAutofillEnableAiBasedAmountExtraction},
+      {features::kAutofillEnablePayNowPayLaterTabs});
+  SetUpLinkedBnplIssuer(0, 1'000'000'000, IssuerId::kBnplAffirm, 1234);
+  bnpl_manager_->OnUserDecisionToUseBnpl(std::nullopt, base::DoNothing());
+  EXPECT_CALL(payments_autofill_client(),
+              OnPurchaseAmountExtracted(_, Optional(kAmount), true, _, _, _));
+  bnpl_manager_->OnAmountExtractionReturned(kAmount, false);
+  EXPECT_EQ(
+      test_api(*bnpl_manager_).GetOngoingFlowState()->final_checkout_amount,
+      kAmount);
+  EXPECT_FALSE(payments_autofill_client()
+                   .GetPaymentsDataManager()
+                   .IsAutofillAmountExtractionAiTermsSeenPrefEnabled());
+}
