+#if BUILDFLAG(IS_ANDROID)
+class ExtensionFunctionDispatcher::ResponseTarget
+    : public content::WebContentsObserver {
+ public:
+  ResponseTarget(ExtensionFunction* function,
+                 base::WeakPtr<ExtensionFunctionDispatcher> dispatcher)
+      : function_(function), dispatcher_(std::move(dispatcher)) {
+    if (auto* frame = function_->render_frame_host()) {
+      sender_frame_id_ = frame->GetGlobalId();
+      sender_document_ = frame->GetWeakDocumentPtr();
+      Observe(content::WebContents::FromRenderFrameHost(frame));
+    } else {
+      CHECK(function_->is_from_service_worker());
+    }
+  }
+
+  ~ResponseTarget() override {
+    // Releasing the function can notify other browser services.
+    Observe(nullptr);
+  }
+
+  ExtensionFunction* function() const { return function_.get(); }
+
+ private:
+  void RenderFrameDeleted(content::RenderFrameHost* frame) override {
+    if (frame->GetGlobalId() == sender_frame_id_) {
+      Cancel();
+    }
+  }
+
+  void DidFinishNavigation(content::NavigationHandle*) override {
+    // Preserve same-document navigation and a still-valid BFCache document.
+    if (!sender_document_.AsRenderFrameHostIfValid()) {
+      Cancel();
+    }
+  }
+
+  void WebContentsDestroyed() override { Cancel(); }
+
+  void Cancel() {
+    if (dispatcher_) {
+      dispatcher_->RemoveResponseTarget(function_.get());
+    }
+    // Removal can destroy this observer. Do not access members afterward.
+  }
+
+  scoped_refptr<ExtensionFunction> function_;
+  base::WeakPtr<ExtensionFunctionDispatcher> dispatcher_;
+  content::GlobalRenderFrameHostId sender_frame_id_;
+  content::WeakDocumentPtr sender_document_;
+};
+
+#endif
