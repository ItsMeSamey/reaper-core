 void ExtensionFunctionDispatcher::AddResponseTarget(ExtensionFunction* func) {
+#if BUILDFLAG(IS_ANDROID)
+  auto it = response_targets_.find(func->request_uuid());
+  if (it != response_targets_.end()) {
+    CHECK_EQ(it->second->function(), func);
+    return;
+  }
+  response_targets_.emplace(
+      func->request_uuid(),
+      std::make_unique<ResponseTarget>(func, weak_ptr_factory_.GetWeakPtr()));
+#else
   response_targets_.insert(func);
+#endif
 }
 
+#if BUILDFLAG(IS_ANDROID)
+void ExtensionFunctionDispatcher::RemoveResponseTarget(
+    ExtensionFunction* func) {
+  auto it = response_targets_.find(func->request_uuid());
+  if (it == response_targets_.end() || it->second->function() != func) {
+    return;
+  }
+  // Remove the map entry before observer/function destruction can reenter.
+  auto target = response_targets_.extract(it);
+  target.mapped().reset();
+}
+#endif
