+        beginReveal(activity);
+        mRevealCallback.getValue().onResult(true);
+        mRevealCallback.getValue().onResult(false);
+        mRevealLauncher.onDownloadItemActivityClosed(activity);
+        assertEquals(List.of(true), mRevealResults);
+        // Successful Downloads UI recreation must no longer be treated as an orphaned request.
+        assertFalse(DownloadActivityLauncher.isDownloadItemIntent(activity.getIntent()));
+        assertFalse(mRevealLauncher.prepareDownloadItemActivity(activity));
