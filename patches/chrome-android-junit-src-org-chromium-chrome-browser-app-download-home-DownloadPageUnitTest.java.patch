+    private Activity makeRevealHost() {
+        mRevealHost = mock(Activity.class);
+        when(mRevealHost.getPackageName()).thenReturn("org.chromium.chrome");
+        ApplicationStatus.onStateChangeForTesting(mRevealHost, ActivityState.CREATED);
+        ApplicationStatus.onStateChangeForTesting(mRevealHost, ActivityState.RESUMED);
+        when(mProfile.getOriginalProfile()).thenReturn(mProfile);
+        return mRevealHost;
+    }
+
+    private DownloadActivity launchReveal(Profile itemProfile) {
+        Activity host = makeRevealHost();
+        mRevealToken =
+                mRevealLauncher.showDownloadItem(
+                        host,
+                        itemProfile,
+                        new ContentId("LEGACY_DOWNLOAD", "reveal-guid"),
+                        mRevealResults::add);
+        assertTrue(mRevealToken != 0);
+        ArgumentCaptor<Intent> intent = ArgumentCaptor.forClass(Intent.class);
+        verify(host).startActivity(intent.capture());
+        DownloadActivity activity = mock(DownloadActivity.class);
+        when(activity.getIntent()).thenReturn(intent.getValue());
+        assertTrue(mRevealLauncher.prepareDownloadItemActivity(activity));
+        return activity;
+    }
+
+    private DownloadManagerCoordinator beginReveal(DownloadActivity activity) {
+        DownloadManagerCoordinator coordinator = mock(DownloadManagerCoordinator.class);
+        mRevealLauncher.revealDownloadItem(activity, coordinator);
+        verify(coordinator).revealItem(eq(new ContentId("LEGACY_DOWNLOAD", "reveal-guid")),
+                mRevealCallback.capture());
+        return coordinator;
+    }
+
+    @After
