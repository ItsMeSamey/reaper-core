     @Test
+    @DisableFeatures({TabGroupsFeatureMap.UPDATE_TAB_GROUP_COLORS})
     public void bindClosableTab_actionButtonTint() {
         mModel.set(TabProperties.IS_SELECTED, true);
         TabGridViewBinder.bindTab(mModel, mViewGroup, TabProperties.TAB_ACTION_BUTTON_DATA);

         verify(mViewGroup).setTabActionButtonTint(any());
         verify(mViewGroup).updateActionButtonBackground(eq(true), eq(false));
+
+        View cardView = new View(mContext);
+        cardView.setBackgroundColor(0);
+        TextView titleView = new TextView(mContext);
+        TextView badgeView = new TextView(mContext);
+        when(mViewGroup.fastFindViewById(R.id.card_view)).thenReturn(cardView);
+        when(mViewGroup.fastFindViewById(R.id.tab_title)).thenReturn(titleView);
+        when(mViewGroup.fastFindViewById(R.id.reaper_tab_container_badge)).thenReturn(badgeView);
+        when(mViewGroup.fastFindViewById(R.id.background_view))
+                .thenReturn(new ImageView(mContext));
+
+        for (boolean isIncognito : new boolean[] {false, true}) {
+            badgeView.setTextColor(0xffff00ff);
+            PropertyModel colorModel =
+                    new PropertyModel.Builder(TabProperties.ALL_KEYS_TAB_GRID)
+                            .with(TabProperties.TAB_ACTION_STATE, TabActionState.CLOSABLE)
+                            .with(TabProperties.IS_INCOGNITO, isIncognito)
+                            .with(TabProperties.IS_SELECTED, true)
+                            .with(TabProperties.TAB_GROUP_CARD_COLOR, null)
+                            .build();
+            // Initial binding must color the badge regardless of property order.
+            var processor =
+                    PropertyModelChangeProcessor.create(
+                            colorModel, mViewGroup, TabGridViewBinder::bindTab);
+            assertThat(
+                    badgeView.getCurrentTextColor(),
+                    equalTo(TabCardThemeUtil.getTitleTextColor(mContext, isIncognito, true, null)));
+            assertThat(badgeView.getCurrentTextColor(), equalTo(titleView.getCurrentTextColor()));
+
+            // A reused card must follow incremental selection and group-color changes.
+            colorModel.set(TabProperties.IS_SELECTED, false);
+            assertThat(
+                    badgeView.getCurrentTextColor(),
+                    equalTo(TabCardThemeUtil.getTitleTextColor(mContext, isIncognito, false, null)));
+            colorModel.set(TabProperties.TAB_GROUP_CARD_COLOR, TabGroupColorId.BLUE);
+            assertThat(
+                    badgeView.getCurrentTextColor(),
+                    equalTo(
+                            TabCardThemeUtil.getTitleTextColor(
+                                    mContext, isIncognito, false, TabGroupColorId.BLUE)));
+            colorModel.set(TabProperties.IS_SELECTED, true);
+            assertThat(
+                    badgeView.getCurrentTextColor(),
+                    equalTo(
+                            TabCardThemeUtil.getTitleTextColor(
+                                    mContext, isIncognito, true, TabGroupColorId.BLUE)));
+            assertThat(badgeView.getCurrentTextColor(), equalTo(titleView.getCurrentTextColor()));
+            processor.destroy();
+        }
     }

