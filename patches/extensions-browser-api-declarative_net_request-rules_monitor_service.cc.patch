+#if BUILDFLAG(IS_ANDROID)
+  // Prefs-only cleanup cancels SAF cache writers without changing other loads.
+  void CancelSafCacheLoads(const ExtensionId& extension_id) {
+    auto it = load_ruleset_tasks_.find(extension_id);
+    if (it == load_ruleset_tasks_.end()) {
+      return;
+    }
+    for (auto request = it->second.begin(); request != it->second.end();) {
+      if (request->second) {
+        request->second->data.Set();
+        request = it->second.erase(request);
+      } else {
+        ++request;
+      }
+    }
+    if (it->second.empty()) {
+      load_ruleset_tasks_.erase(it);
+    }
+  }
+#endif
+
   // Called when the extension is unloaded. This invalidates all loads that
   // started before the extension unload since those load request IDs will no
   // longer be in the set.
