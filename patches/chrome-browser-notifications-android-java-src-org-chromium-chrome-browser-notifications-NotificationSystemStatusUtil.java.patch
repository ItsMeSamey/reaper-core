+    /** Reads platform policy only. This never requests permission or creates channels. */
+    @CalledByNative
+    static void getExtensionNotificationStatus(
+            @JniType("std::string") String origin,
+            @JniType("base::OnceCallback<void(int)>&&") Callback<Integer> callback) {
+        try {
+            new AsyncTask<Integer>() {
+                @Override
+                protected Integer doInBackground() {
+                    return getExtensionNotificationStatusSync(origin);
+                }
+
+                @Override
+                protected void onPostExecute(Integer status) {
+                    callback.onResult(status);
+                }
+            }.executeOnExecutor(AsyncTask.SERIAL_EXECUTOR);
+        } catch (RuntimeException error) {
+            callback.onResult(APP_NOTIFICATIONS_STATUS_UNDETERMINABLE);
+        }
+    }
+
+    @VisibleForTesting
+    static int getExtensionNotificationStatusSync(String origin) {
+        try {
+            NotificationManagerCompat manager =
+                    NotificationManagerCompat.from(ContextUtils.getApplicationContext());
+            // Bypass the optional app-status cache after changes in Android settings.
+            if (!manager.areNotificationsEnabled()) return APP_NOTIFICATIONS_STATUS_DISABLED;
+            WebsiteAddress address = WebsiteAddress.create(origin);
+            if (address == null) return APP_NOTIFICATIONS_STATUS_UNDETERMINABLE;
+            String normalizedOrigin = address.getOrigin();
+            NotificationChannel effectiveChannel = null;
+            NotificationChannel fallbackChannel = null;
+            for (NotificationChannel channel : manager.getNotificationChannels()) {
+                String id = channel.getId();
+                if (id.equals(ChromeChannelDefinitions.ChannelId.SITES)) fallbackChannel = channel;
+                // Match the same first origin channel used by SiteChannelsManager, without
+                // calling its getter that may migrate channels and reset custom OS settings.
+                if (effectiveChannel == null
+                        && SiteChannelsManager.isValidSiteChannelId(id)
+                        && SiteChannelsManager.toSiteOrigin(id).equals(normalizedOrigin)) {
+                    effectiveChannel = channel;
+                }
+            }
+            if (effectiveChannel == null) effectiveChannel = fallbackChannel;
+            if (effectiveChannel != null
+                    && effectiveChannel.getImportance() == NotificationManager.IMPORTANCE_NONE) {
+                return APP_NOTIFICATIONS_STATUS_DISABLED;
+            }
+            // A not-yet-created fallback channel will be in GENERAL when displayed. Reading
+            // permission must not create it, and must still respect an existing group block.
+            String groupId =
+                    effectiveChannel == null
+                            ? ChromeChannelDefinitions.ChannelGroupId.GENERAL
+                            : effectiveChannel.getGroup();
+            if (groupId != null) {
+                NotificationChannelGroup group = manager.getNotificationChannelGroup(groupId);
+                if (group != null && group.isBlocked()) return APP_NOTIFICATIONS_STATUS_DISABLED;
+            }
+            return manager.areNotificationsEnabled()
+                    ? APP_NOTIFICATIONS_STATUS_ENABLED
+                    : APP_NOTIFICATIONS_STATUS_DISABLED;
+        } catch (RuntimeException error) {
+            return APP_NOTIFICATIONS_STATUS_UNDETERMINABLE;
+        }
+    }
