+// Activity instance IDs and native SessionIDs have independent integer spaces.
+// Keep local Android windows distinguishable without changing foreign IDs.
+bool AndroidNativeHistoryContainsId(const sessions::tab_restore::Entry& entry,
+                                    SessionID id) {
+  if (entry.id == id || entry.original_id == id) {
+    return true;
+  }
+  const auto any_child = [id](const auto& children) {
+    return std::ranges::any_of(children, [id](const auto& child) {
+      return AndroidNativeHistoryContainsId(*child, id);
+    });
+  };
+  const auto any_mapped = [id](const auto& children) {
+    return std::ranges::any_of(children, [id](const auto& child) {
+      return AndroidNativeHistoryContainsId(*child.second, id);
+    });
+  };
+  switch (entry.type) {
+    case sessions::tab_restore::Type::TAB:
+      return false;
+    case sessions::tab_restore::Type::WINDOW: {
+      const auto& window =
+          static_cast<const sessions::tab_restore::Window&>(entry);
+      return any_child(window.tabs) || any_mapped(window.tab_groups) ||
+             any_mapped(window.split_tabs);
+    }
+    case sessions::tab_restore::Type::GROUP: {
+      const auto& group =
+          static_cast<const sessions::tab_restore::Group&>(entry);
+      return any_child(group.tabs) || any_mapped(group.split_tabs);
+    }
+    case sessions::tab_restore::Type::SPLIT:
+      return any_child(
+          static_cast<const sessions::tab_restore::Split&>(entry).tabs);
+  }
+  return false;
+}
+
+struct AndroidNativeRestoreResult {
+  bool found = false;
+  base::WeakPtr<content::WebContents> contents;
+};
+
+AndroidNativeRestoreResult RestoreAndroidNativeSession(
+    sessions::TabRestoreService* service,
+    TabModel* model,
+    SessionID entry_id) {
+  AndroidNativeRestoreResult result;
+  // A known native ID must never fall back into the Android instance namespace
+  // merely because reconstruction fails or a synchronous observer closes it.
+  result.found =
+      std::ranges::any_of(service->entries(), [entry_id](const auto& entry) {
+        return AndroidNativeHistoryContainsId(*entry, entry_id);
+      });
+  if (!result.found) {
+    return result;
+  }
+  AndroidLiveTabContextRestoreWrapper restore_context(model);
+  // UNKNOWN replaces the wrapper with the base Android context and loses its
+  // group metadata. Use the same entry point as Recent Tabs, then activate the
+  // first restored tab to preserve sessions.restore's foreground behavior.
+  auto restored = service->RestoreEntryById(
+      &restore_context, entry_id, WindowOpenDisposition::NEW_BACKGROUND_TAB);
+  if (restored.empty() || !restored.front()) {
+    return result;
+  }
+  auto first = static_cast<sessions::ContentLiveTab*>(restored.front())
+                   ->GetWebContents()
+                   .GetWeakPtr();
+  if (!restore_context.RestoreTabGroups(model)) {
+    return result;
+  }
+  restore_context.RestoreSplits();
+  if (!first || TabModelList::GetTabModelForWebContents(first.get()) != model) {
+    return result;
+  }
+  TabAndroid* tab = TabAndroid::FromWebContents(first.get());
+  if (!tab) {
+    return result;
+  }
+  model->ActivateTab(tab->GetHandle());
+  if (first && TabModelList::GetTabModelForWebContents(first.get()) == model) {
+    result.contents = first;
+  }
+  return result;
+}
