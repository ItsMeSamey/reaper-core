+ExtensionFunction::ResponseAction SessionsRestoreFunction::RestoreAndroidTab(
+    int instance_id,
+    int64_t timestamp,
+    int tab_id,
+    BrowserWindowInterface* browser) {
+  auto* target = static_cast<TabModel*>(TabListInterface::From(browser));
+  Profile* profile = Profile::FromBrowserContext(browser_context());
+  if (!target || target->GetProfile() != profile || profile->IsOffTheRecord()) {
+    return RespondNow(Error(kNoLiveTabContextError));
+  }
+  android_target_model_.Reset(target->GetJavaObject());
+  // Typed IDs may outlive the process. Load the real persisted source model
+  // before resolving its child tab, while retaining the exact original target.
+  return QueryRecentlyClosedEntitiesManager(
+      instance_id, /*restore_most_recent=*/false, timestamp, tab_id);
+}
