+void SessionsGetRecentlyClosedFunction::LoadNextAndroidWindow() {
+  if (android_shutting_down_ || did_respond() || !browser_context()) {
+    return;
+  }
+  while (android_window_position_ + 1 < android_window_snapshot_.size()) {
+    const int64_t instance =
+        android_window_snapshot_[android_window_position_++];
+    const int64_t timestamp =
+        android_window_snapshot_[android_window_position_++];
+    if (instance < 0 || instance > std::numeric_limits<int>::max() ||
+        timestamp <= 0) {
+      continue;
+    }
+    if (result_.size() >= max_results_ && !window_last_modified_for_test_) {
+      auto times = android_result_timestamps_;
+      std::sort(times.begin(), times.end(), std::greater<int64_t>());
+      if (timestamp < times[max_results_ - 1]) {
+        FinishAndroidResults();
+        return;
+      }
+    }
+    base::OnceCallback<void(const base::android::JavaRef<jobject>&)> callback =
+        base::BindOnce(
+            &SessionsGetRecentlyClosedFunction::OnGetRecentlyClosedWindow, this,
+            static_cast<int>(instance), timestamp);
+    const size_t request_position = android_window_position_;
+    auto operation = Java_RecentlyClosedEntriesManager_getRecentlyClosedWindow(
+        base::android::AttachCurrentThread(),
+        Profile::FromBrowserContext(browser_context()),
+        static_cast<int>(instance), timestamp, std::move(callback));
+    // A synchronous failure may already have advanced to the next window or
+    // completed the response. Never replace that next request's cancel handle.
+    if (android_shutting_down_ || did_respond() ||
+        android_window_position_ != request_position) {
+      if (operation) {
+        Java_RecentlyClosedEntriesManager_cancelRestoreOperation(
+            base::android::AttachCurrentThread(), operation);
+      }
+    } else {
+      android_metadata_operation_.Reset(operation);
+    }
+    return;
+  }
+  FinishAndroidResults();
+}
+
+void SessionsGetRecentlyClosedFunction::FinishAndroidResults() {
+  std::vector<size_t> order;
+  for (size_t i = 0; i < result_.size(); ++i) {
+    order.push_back(i);
+  }
+  std::stable_sort(order.begin(), order.end(), [this](size_t a, size_t b) {
+    return android_result_timestamps_[a] > android_result_timestamps_[b];
+  });
+  std::vector<api::sessions::Session> sorted;
+  for (size_t i = 0; i < std::min(max_results_, order.size()); ++i) {
+    sorted.push_back(std::move(result_[order[i]]));
+  }
+  result_ = std::move(sorted);
+  Respond(ArgumentList(GetRecentlyClosed::Results::Create(result_)));
+}
+
+void SessionsGetRecentlyClosedFunction::OnBrowserContextShutdown() {
+  android_shutting_down_ = true;
+  android_window_snapshot_.clear();
+  auto operation = std::move(android_metadata_operation_);
+  if (operation) {
+    Java_RecentlyClosedEntriesManager_cancelRestoreOperation(
+        base::android::AttachCurrentThread(), operation);
+  }
+  if (!did_respond()) {
+    Respond(Error(kNoRecentlyClosedSessionsError));
+  }
+}
