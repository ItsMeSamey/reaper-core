+  base::OnceCallback<void(const base::android::JavaRef<jobject>&)> callback =
+      base::BindOnce(&SessionsRestoreFunction::OnAndroidTabRestored, this);
+  auto operation = Java_RecentlyClosedEntriesManager_restoreTab(
+      base::android::AttachCurrentThread(), profile, instance_id, timestamp,
+      tab_id, target, std::move(callback));
+  if (android_shutting_down_ || did_respond()) {
+    if (operation) {
+      Java_RecentlyClosedEntriesManager_cancelRestoreOperation(
+          base::android::AttachCurrentThread(), operation);
