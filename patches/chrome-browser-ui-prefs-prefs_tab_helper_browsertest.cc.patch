+#if BUILDFLAG(IS_ANDROID) && BUILDFLAG(ENABLE_DESKTOP_ANDROID_EXTENSIONS)
+IN_PROC_BROWSER_TEST_F(PrefsTabHelperBrowserTest,
+                       AndroidClearedScriptFontResetsExistingMapping) {
+  PrefService* prefs = chrome_test_utils::GetProfile(this)->GetPrefs();
+  // Gothic has a registered empty default: clearing its override must restore
+  // fallback to the common script, not retain the old explicit renderer value.
+  const std::string script_pref =
+      std::string(prefs::kWebKitSerifFontFamilyMap) + ".Goth";
+  ASSERT_TRUE(prefs->FindPreference(script_pref));
+  ASSERT_TRUE(prefs->GetString(script_pref).empty());
+  content::WebContents* web_contents =
+      chrome_test_utils::GetActiveWebContents(this);
+  web_contents->GetOrCreateWebPreferences();
+
+  prefs->SetString(prefs::kWebKitSerifFontFamily, "serif");
+  prefs->SetString(script_pref, "monospace");
+  base::RunLoop().RunUntilIdle();
+  const auto& updated = web_contents->GetOrCreateWebPreferences();
+  ASSERT_TRUE(updated.serif_font_family_map.contains("Goth"));
+  EXPECT_EQ(u"monospace", updated.serif_font_family_map.at("Goth"));
+
+  prefs->ClearPref(script_pref);
+  base::RunLoop().RunUntilIdle();
+  const auto& cleared = web_contents->GetOrCreateWebPreferences();
+  // An explicit empty entry is needed to overwrite the old renderer mapping.
+  ASSERT_TRUE(cleared.serif_font_family_map.contains("Goth"));
+  EXPECT_TRUE(cleared.serif_font_family_map.at("Goth").empty());
+  EXPECT_EQ(u"serif",
+            cleared.serif_font_family_map.at(blink::web_pref::kCommonScript));
+}
+#endif  // IS_ANDROID && ENABLE_DESKTOP_ANDROID_EXTENSIONS
