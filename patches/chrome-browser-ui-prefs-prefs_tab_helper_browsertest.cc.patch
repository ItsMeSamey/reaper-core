+#if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
+IN_PROC_BROWSER_TEST_F(PrefsTabHelperBrowserTest,
+                       AnimationPolicyUpdatesExistingWebPreferences) {
+  PrefService* prefs = chrome_test_utils::GetProfile(this)->GetPrefs();
+  ASSERT_TRUE(prefs->FindPreference(prefs::kAnimationPolicy));
+  content::WebContents* web_contents =
+      chrome_test_utils::GetActiveWebContents(this);
+  using Policy = blink::mojom::ImageAnimationPolicy;
+  EXPECT_EQ(Policy::kImageAnimationPolicyAllowed,
+            web_contents->GetOrCreateWebPreferences().animation_policy);
+
+  prefs->SetString(prefs::kAnimationPolicy, "none");
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(Policy::kImageAnimationPolicyNoAnimation,
+            web_contents->GetOrCreateWebPreferences().animation_policy);
+
+  prefs->SetString(prefs::kAnimationPolicy, "once");
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(Policy::kImageAnimationPolicyAnimateOnce,
+            web_contents->GetOrCreateWebPreferences().animation_policy);
+
+  prefs->ClearPref(prefs::kAnimationPolicy);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(Policy::kImageAnimationPolicyAllowed,
+            web_contents->GetOrCreateWebPreferences().animation_policy);
+}
+#endif  // BUILDFLAG(ENABLE_EXTENSIONS_CORE)
