 import type {CrToggleElement} from 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
 import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
@@ -54,6 +58,29 @@
   accessor checked: boolean = false;
   accessor disabled: boolean = false;
 
+  // <if expr="is_android">
+  override connectedCallback() {
+    super.connectedCallback();
+    void this.associateSwitchLabel_();
+  }
+
+  private async associateSwitchLabel_() {
+    // Reconnecting remounts Leo's inner button, so bind the current control
+    // after both Lit render cycles rather than retaining a first-render node.
+    await this.updateComplete;
+    const toggle = this.$.crToggle;
+    await toggle.updateComplete;
+    if (!this.isConnected) {
+      return;
+    }
+    const button = toggle.$.toggle.shadowRoot?.querySelector('button');
+    assert(button instanceof HTMLButtonElement);
+    // The label lives in an ancestor shadow scope. An element reference crosses
+    // that boundary and follows slotted text updates without copying a name.
+    button.ariaLabelledByElements = [this.$.label];
+  }
+  // </if>
