+
+void StaticTabSceneLayer::UpdateSplitTabLayers(
+    JNIEnv *env, int32_t first_id, int32_t second_id, bool first_live,
+    bool second_live, int32_t background_color, int32_t first_x,
+    int32_t first_y, int32_t first_width, int32_t first_height,
+    int32_t second_x, int32_t second_y, int32_t second_width,
+    int32_t second_height) {
+  DCHECK(tab_content_manager_);
+  if (first_id < 0 || second_id < 0 || first_id == second_id ||
+      first_width <= 0 || first_height <= 0 || second_width <= 0 ||
+      second_height <= 0) {
+    HideSplitTabLayers(env);
+    return;
+  }
+  background_color_ = background_color;
+  if (!content_layer_) {
+    content_layer_ = ContentLayer::Create(tab_content_manager_);
+    layer_->AddChild(content_layer_->layer());
+  }
+  if (!second_content_layer_) {
+    second_content_layer_ = ContentLayer::Create(tab_content_manager_);
+    layer_->AddChild(second_content_layer_->layer());
+  }
+  tab_content_manager_->UpdateVisibleIds({first_id, second_id}, first_id);
+  auto update_pane = [&](ContentLayer *pane, int id, bool live, int x, int y,
+                         int width, int height) {
+    pane->SetProperties(id, live, live ? 0.f : 1.f, false, 1.f, 1.f, true,
+                        gfx::Rect(width, height));
+    pane->layer()->SetHideLayerAndSubtree(false);
+    pane->layer()->SetPosition(gfx::PointF(x, y));
+    pane->layer()->SetBounds(gfx::Size(width, height));
+    pane->layer()->SetMasksToBounds(true);
+    pane->layer()->SetIsDrawable(true);
+    // Pane coordinates already include browser controls and pane header.
+    pane->layer()->SetOffsetTag(viz::OffsetTag());
+    if (TabAndroid *tab = tab_content_manager_->GetTab(id);
+        tab && tab->web_contents() && tab->web_contents()->GetNativeView()) {
+      // The Android ContentView itself is placed at the pane's X coordinate.
+      tab->web_contents()->GetNativeView()->set_content_offset_x(0);
+    }
+  };
+  update_pane(content_layer_.get(), first_id, first_live, first_x, first_y,
+              first_width, first_height);
+  update_pane(second_content_layer_.get(), second_id, second_live, second_x,
+              second_y, second_width, second_height);
+}
