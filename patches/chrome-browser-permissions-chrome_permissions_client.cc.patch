+}
+
+base::ScopedClosureRunner ChromePermissionsClient::ObserveAndroidTabModel(
+    tabs::TabInterface* tab,
+    base::RepeatingCallback<void(bool)> callback) {
+  auto* model =
+      TabModelList::GetTabModelForTabAndroid(TabAndroid::FromTabInterface(tab));
+  if (!model) {
+    return {};
+  }
+  auto observer = std::make_unique<AndroidPermissionModelObserver>(
+      model, std::move(callback));
+  return base::ScopedClosureRunner(
+      base::BindOnce([](std::unique_ptr<AndroidPermissionModelObserver>) {},
+                     std::move(observer)));
+}
