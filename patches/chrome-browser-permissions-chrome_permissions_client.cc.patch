 #if BUILDFLAG(IS_ANDROID)
+class AndroidPermissionModelObserver : public TabModelObserver {
+ public:
+  AndroidPermissionModelObserver(TabModel* model,
+                                 base::RepeatingCallback<void(bool)> callback)
+      : model_(model), callback_(std::move(callback)) {
+    model_->AddObserver(this);
+  }
+  ~AndroidPermissionModelObserver() override {
+    if (model_) {
+      model_->RemoveObserver(this);
+    }
+  }
+
+  void OnWillActiveStateChange(TabModel& model, bool active) override {
+    if (!active) {
+      auto callback = callback_;
+      callback.Run(false);
+    }
+  }
+  void OnDidActiveStateChange(TabModel& model, bool active) override {
+    if (active) {
+      auto callback = callback_;
+      callback.Run(true);
+    }
+  }
+  void OnTabModelDestroyed(TabModel& model) override {
+    // Removing the last observer here can destroy the JNI bridge currently
+    // dispatching model shutdown. Normal RAII teardown still unregisters.
+    model_ = nullptr;
+    auto callback = callback_;
+    callback.Run(false);
+  }
+
+ private:
+  raw_ptr<TabModel> model_;
+  base::RepeatingCallback<void(bool)> callback_;
+};
