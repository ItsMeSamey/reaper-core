+#if BUILDFLAG(IS_ANDROID)
+// Return an invalid region through the existing asynchronous load seam without
+// exhausting host resources or changing production serialization.
+class ControlledUserScriptLoader : public UserScriptLoader {
+ public:
+  explicit ControlledUserScriptLoader(content::BrowserContext* browser_context)
+      : UserScriptLoader(
+            browser_context,
+            mojom::HostID(mojom::HostID::HostType::kExtensions,
+                          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")) {
+    SetReady(true);
+  }
+
+  bool has_pending_load() const { return !pending_callback_.is_null(); }
+
+  void CompleteLoad(bool valid) {
+    ASSERT_TRUE(has_pending_load());
+    auto callback = std::move(pending_callback_);
+    auto scripts = std::move(pending_scripts_);
+    auto region = valid ? Serialize(scripts) : base::ReadOnlySharedMemoryRegion();
+    ASSERT_EQ(valid, region.IsValid());
+    std::move(callback).Run(std::move(scripts), std::move(region));
+    // The callback may have deleted this loader.
+  }
+
+ private:
+  void LoadScripts(UserScriptList scripts,
+                   const std::set<std::string>& added_script_ids,
+                   LoadScriptsCallback callback) override {
+    ASSERT_FALSE(has_pending_load());
+    pending_scripts_ = std::move(scripts);
+    pending_callback_ = std::move(callback);
+  }
+
+  UserScriptList pending_scripts_;
+  LoadScriptsCallback pending_callback_;
+};
+
+class ScriptLoadObserver : public UserScriptLoader::Observer {
+ public:
+  void OnScriptsLoaded(UserScriptLoader*,
+                       content::BrowserContext*) override {
+    ++successful_loads;
+  }
+  void OnUserScriptLoaderDestroyed(UserScriptLoader*) override {
+    ++destroyed_loaders;
+  }
+  int successful_loads = 0;
+  int destroyed_loaders = 0;
+};
+
+UserScriptList MakeScripts(const std::string& id) {
+  auto script = std::make_unique<UserScript>();
+  script->set_id(id);
+  auto js = UserScript::Content::CreateInlineCode(GURL("https://example.test/a.js"));
+  js->set_content("/* " + id + " javascript */");
+  script->js_scripts().push_back(std::move(js));
+  auto css =
+      UserScript::Content::CreateInlineCode(GURL("https://example.test/a.css"));
+  css->set_content("/* " + id + " stylesheet */");
+  script->css_scripts().push_back(std::move(css));
+  UserScriptList scripts;
+  scripts.push_back(std::move(script));
+  return scripts;
+}
+#endif  // BUILDFLAG(IS_ANDROID)

