+#if BUILDFLAG(IS_ANDROID)
+TEST_F(UserScriptLoaderUnitTest, AndroidInitialLoadFailureCompletesWithError) {
+  ScriptLoadObserver observer;
+  ControlledUserScriptLoader loader(browser_context());
+  loader.AddObserver(&observer);
+  auto process = CreateAndInitializeProcess(/*is_for_guests_only=*/false);
+  int completions = 0;
+  loader.AddScripts(
+      MakeScripts("initial"),
+      base::BindLambdaForTesting(
+          [&](UserScriptLoader* completed_loader,
+              const std::optional<std::string>& error) {
+            EXPECT_EQ(&loader, completed_loader);
+            ASSERT_TRUE(error);
+            EXPECT_EQ(loader.host_id().id, completed_loader->host_id().id);
+            ++completions;
+          }));
+  ASSERT_TRUE(loader.has_pending_load());
+  loader.CompleteLoad(false);
+  helper()->FlushAllForTesting();
+  base::RunLoop().RunUntilIdle();
+
+  EXPECT_EQ(1, completions);
+  EXPECT_FALSE(loader.initial_load_complete());
+  EXPECT_FALSE(loader.HasLoadedScripts());
+  ASSERT_TRUE(loader.GetLoadedScriptsForTesting());
+  EXPECT_TRUE(loader.GetLoadedScriptsForTesting()->empty());
+  EXPECT_EQ(0, observer.successful_loads);
+  EXPECT_EQ(0, helper()->user_script_update_count());
+  loader.RemoveObserver(&observer);
+}
+
+TEST_F(UserScriptLoaderUnitTest, AndroidFailedLoadRollsBackPublishedScripts) {
+  ScriptLoadObserver observer;
+  ControlledUserScriptLoader loader(browser_context());
+  loader.AddObserver(&observer);
+  auto process = CreateAndInitializeProcess(/*is_for_guests_only=*/false);
+  loader.AddScripts(MakeScripts("published"), base::DoNothing());
+  loader.CompleteLoad(true);
+  helper()->FlushAllForTesting();
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(helper()->last_shared_memory().IsValid());
+  const auto published_region = helper()->last_shared_memory().GetGUID();
+  ASSERT_EQ(1, observer.successful_loads);
+  const int published_updates = helper()->user_script_update_count();
+  ASSERT_GT(published_updates, 0);
+
+  int failures = 0;
+  auto failed = [&failures](UserScriptLoader*,
+                            const std::optional<std::string>& error) {
+    EXPECT_TRUE(error);
+    ++failures;
+  };
+  loader.RemoveScripts({"published"}, base::BindLambdaForTesting(failed));
+  loader.AddScripts(MakeScripts("failed"), base::BindLambdaForTesting(failed));
+  loader.CompleteLoad(false);
+  EXPECT_EQ(0, failures);  // A queued load is still entitled to succeed.
+  ASSERT_TRUE(loader.has_pending_load());
+  loader.CompleteLoad(false);
+  helper()->FlushAllForTesting();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(2, failures);
+  EXPECT_EQ(1, observer.successful_loads);
+  EXPECT_EQ(published_updates, helper()->user_script_update_count());
+  EXPECT_EQ(published_region, helper()->last_shared_memory().GetGUID());
+  EXPECT_TRUE(loader.initial_load_complete());
+  ASSERT_TRUE(loader.GetLoadedScriptsForTesting());
+  ASSERT_EQ(1u, loader.GetLoadedScriptsForTesting()->size());
+  const auto& restored = loader.GetLoadedScriptsForTesting()->front();
+  EXPECT_EQ("published", restored->id());
+  ASSERT_EQ(1u, restored->js_scripts().size());
+  ASSERT_EQ(1u, restored->css_scripts().size());
+  EXPECT_EQ("/* published javascript */", restored->js_scripts()[0]->GetContent());
+  EXPECT_EQ("/* published stylesheet */", restored->css_scripts()[0]->GetContent());
+
+  int successes = 0;
+  loader.AddScripts(
+      MakeScripts("later"),
+      base::BindLambdaForTesting(
+          [&](UserScriptLoader*, const std::optional<std::string>& error) {
+            EXPECT_FALSE(error);
+            ++successes;
+          }));
+  loader.CompleteLoad(true);
+  ASSERT_EQ(1, successes);
+  ASSERT_TRUE(loader.GetLoadedScriptsForTesting());
+  ASSERT_EQ(2u, loader.GetLoadedScriptsForTesting()->size());
+  EXPECT_EQ("published", loader.GetLoadedScriptsForTesting()->at(0)->id());
+  EXPECT_EQ("later", loader.GetLoadedScriptsForTesting()->at(1)->id());
+  EXPECT_EQ(2, failures);
+  loader.RemoveObserver(&observer);
+}
+
+TEST_F(UserScriptLoaderUnitTest, AndroidFailureCallbacksSurviveLoaderDestruction) {
+  ScriptLoadObserver observer;
+  auto loader = std::make_unique<ControlledUserScriptLoader>(browser_context());
+  loader->AddObserver(&observer);
+  int failures = 0;
+  loader->AddScripts(
+      MakeScripts("first"),
+      base::BindLambdaForTesting(
+          [&](UserScriptLoader*, const std::optional<std::string>& error) {
+            EXPECT_TRUE(error);
+            ++failures;
+            loader.reset();
+          }));
+  loader->AddScripts(
+      MakeScripts("second"),
+      base::BindLambdaForTesting(
+          [&](UserScriptLoader*, const std::optional<std::string>& error) {
+            EXPECT_TRUE(error);
+            ++failures;
+          }));
+  loader->CompleteLoad(true);
+  ASSERT_TRUE(loader->has_pending_load());
+  loader->CompleteLoad(false);
+  EXPECT_FALSE(loader);
+  EXPECT_EQ(2, failures);
+  EXPECT_EQ(0, observer.successful_loads);
+  EXPECT_EQ(1, observer.destroyed_loaders);
+}
