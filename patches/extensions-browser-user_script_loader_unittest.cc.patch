+TEST_F(UserScriptLoaderUnitTest, AndroidFailureCallbacksDoNotConsumeReentrantLoad) {
+  ControlledUserScriptLoader loader(browser_context());
+  int failures = 0;
+  int successes = 0;
+  loader.AddScripts(
+      MakeScripts("failed-first"),
+      base::BindLambdaForTesting(
+          [&](UserScriptLoader*, const std::optional<std::string>& error) {
+            EXPECT_TRUE(error);
+            ++failures;
+            loader.AddScripts(
+                MakeScripts("reentrant"),
+                base::BindLambdaForTesting(
+                    [&](UserScriptLoader*,
+                        const std::optional<std::string>& later_error) {
+                      EXPECT_FALSE(later_error);
+                      ++successes;
+                    }));
+            loader.CompleteLoad(true);
+          }));
+  loader.AddScripts(
+      MakeScripts("failed-second"),
+      base::BindLambdaForTesting(
+          [&](UserScriptLoader*, const std::optional<std::string>& error) {
+            EXPECT_TRUE(error);
+            ++failures;
+          }));
+  loader.CompleteLoad(true);
+  ASSERT_TRUE(loader.has_pending_load());
+  loader.CompleteLoad(false);
+  EXPECT_EQ(2, failures);
+  EXPECT_EQ(1, successes);
+  EXPECT_FALSE(loader.has_pending_load());
+  ASSERT_TRUE(loader.GetLoadedScriptsForTesting());
+  ASSERT_EQ(1u, loader.GetLoadedScriptsForTesting()->size());
+  EXPECT_EQ("reentrant", loader.GetLoadedScriptsForTesting()->front()->id());
+}
+
+TEST_F(UserScriptLoaderUnitTest, AndroidQueuedLoadCanRecoverBeforeFailureCompletion) {
+  ControlledUserScriptLoader loader(browser_context());
+  int successes = 0;
+  auto complete = [&successes](UserScriptLoader*,
+                               const std::optional<std::string>& error) {
+    EXPECT_FALSE(error);
+    ++successes;
+  };
+  loader.AddScripts(MakeScripts("first"), base::BindLambdaForTesting(complete));
+  loader.AddScripts(MakeScripts("second"), base::BindLambdaForTesting(complete));
+  loader.CompleteLoad(false);
+  EXPECT_EQ(0, successes);
+  ASSERT_TRUE(loader.has_pending_load());
+  loader.CompleteLoad(true);
+  EXPECT_EQ(2, successes);
+  ASSERT_TRUE(loader.GetLoadedScriptsForTesting());
+  EXPECT_EQ(2u, loader.GetLoadedScriptsForTesting()->size());
+}
