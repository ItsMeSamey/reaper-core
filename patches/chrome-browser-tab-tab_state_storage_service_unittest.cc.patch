+TEST_F(TabStateStorageServiceTest, ContainerInventoryEmptyIsCompleteAfterDbInitialization) {
+  FlushOperations();
+  base::RunLoop loop;
+  service()->GetPersistedContainerIds(base::BindOnce(
+      [](base::OnceClosure done, std::optional<std::vector<std::string>> ids) {
+        EXPECT_TRUE(ids);
+        if (ids) EXPECT_TRUE(ids->empty());
+        std::move(done).Run();
+      }, loop.QuitClosure()));
+  loop.Run();
+}
+
+TEST_F(TabStateStorageServiceTest, ContainerInventoryWaitsWithoutDestroyingActiveScopedBatch) {
+  FlushOperations();
+  bool queried = false;
+  bool batch_callback = false;
+  TabStripCollection collection;
+  auto batch = service()->CreateScopedBatch();
+  service()->GetPersistedContainerIds(base::BindOnce(
+      [](bool* queried, std::optional<std::vector<std::string>> ids) {
+        EXPECT_TRUE(ids);
+        if (ids) EXPECT_TRUE(ids->empty());
+        *queried = true;
+      }, &queried));
+  EXPECT_FALSE(queried);
+  service()->Save(&collection); // Builder remains alive and usable after query.
+  batch.AddCallback(base::BindOnce([](bool* called) { *called = true; }, &batch_callback));
+  batch = TabStateStorageService::ScopedBatch();
+  FlushOperations();
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(batch_callback);
+  EXPECT_TRUE(queried);
+}
+
+TEST_F(TabStateStorageServiceTest,
+       ContainerInventoryDeferredReplyCompletesOnceOnOriginSequence) {
+  FlushOperations();
+  int replies = 0;
+  auto origin = base::SequencedTaskRunner::GetCurrentDefault();
+  {
+    auto batch = service()->CreateScopedBatch();
+    service()->GetPersistedContainerIds(base::BindOnce(
+        [](scoped_refptr<base::SequencedTaskRunner> origin, int* replies,
+           std::optional<std::vector<std::string>> ids) {
+          EXPECT_TRUE(origin->RunsTasksInCurrentSequence());
+          ASSERT_TRUE(ids);
+          EXPECT_TRUE(ids->empty());
+          ++*replies;
+        },
+        origin, &replies));
+    EXPECT_EQ(replies, 0);
+  }
+  FlushOperations();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(replies, 1);
+}
+
+TEST_F(TabStateStorageServiceTest,
+       ContainerInventoryCancelledDeferredReplyIsUnavailableOnOriginSequence) {
+  FlushOperations();
+  int replies = 0;
+  auto origin = base::SequencedTaskRunner::GetCurrentDefault();
+  {
+    auto batch = service()->CreateScopedBatch();
+    service()->GetPersistedContainerIds(base::BindOnce(
+        [](scoped_refptr<base::SequencedTaskRunner> origin, int* replies,
+           std::optional<std::vector<std::string>> ids) {
+          EXPECT_TRUE(origin->RunsTasksInCurrentSequence());
+          EXPECT_FALSE(ids);
+          ++*replies;
+        },
+        origin, &replies));
+    EXPECT_EQ(replies, 0);
+  }
+  // Retire the service before the deferred reply can run on this sequence.
+  // The batch has already closed, so no ScopedBatch holds a retired builder.
+  service_.reset();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(replies, 1);
+}
