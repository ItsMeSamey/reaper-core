+#if BUILDFLAG(IS_ANDROID)
+TEST_F(MimeHandlerStreamManagerTest, AndroidFallbackRedirectAndCancellation) {
+  auto* embedder = NavigateAndCommit(main_rfh(), GURL(kOriginalUrl1));
+  SetUpSimpleStream(embedder, 1, false);
+  auto* manager = mime_handler_stream_manager();
+  manager->GetClaimedStreamInfoForTesting(embedder)
+      ->SetDidExtensionFinishNavigation();
+  const auto frame_id = embedder->GetFrameTreeNodeId();
+  manager->AbortAndFallbackToNativeHandler(embedder);
+  EXPECT_TRUE(manager->ShouldBypassForNativeFallback(frame_id));
+  EXPECT_FALSE(
+      manager->ShouldBypassForNativeFallback(content::FrameTreeNodeId()));
+
+  NiceMock<content::MockNavigationHandle> same_document(GURL(kOriginalUrl1),
+                                                        embedder);
+  same_document.set_is_same_document(true);
+  manager->DidStartNavigation(&same_document);
+  manager->DidFinishNavigation(&same_document);
+  EXPECT_TRUE(manager->ShouldBypassForNativeFallback(frame_id));
+
+  // A stale completion in the same frame must not consume this reload's mark.
+  NiceMock<content::MockNavigationHandle> stale(GURL(kOriginalUrl1), embedder);
+  manager->DidFinishNavigation(&stale);
+  EXPECT_TRUE(manager->ShouldBypassForNativeFallback(frame_id));
+
+  auto navigation = content::NavigationSimulator::CreateFromPending(
+      web_contents()->GetController());
+  navigation->Redirect(GURL(kOriginalUrl2));
+  EXPECT_TRUE(manager->ShouldBypassForNativeFallback(frame_id));
+  // Redirected responses are re-fetched, never served from a different URL's
+  // cache.
+  EXPECT_FALSE(manager->TakeCachedFallbackBody(frame_id, GURL(kOriginalUrl2)));
+  navigation->Fail(net::ERR_ABORTED);
+  task_environment()->RunUntilIdle();
+  EXPECT_FALSE(mime_handler_stream_manager());
+}
+
+TEST_F(MimeHandlerStreamManagerTest,
+       AndroidFallbackDoesNotClaimLaterNavigation) {
+  auto* embedder = NavigateAndCommit(main_rfh(), GURL(kOriginalUrl1));
+  SetUpSimpleStream(embedder, 1, false);
+  auto* manager = mime_handler_stream_manager();
+  manager->GetClaimedStreamInfoForTesting(embedder)
+      ->SetDidExtensionFinishNavigation();
+  const auto frame_id = embedder->GetFrameTreeNodeId();
+  manager->AbortAndFallbackToNativeHandler(embedder);
+  ASSERT_TRUE(manager->ShouldBypassForNativeFallback(frame_id));
+  NiceMock<content::MockNavigationHandle> later(GURL(kOriginalUrl2), embedder);
+  manager->DidStartNavigation(&later);
+  EXPECT_FALSE(manager->ShouldBypassForNativeFallback(frame_id));
+  EXPECT_TRUE(manager->GetStreamContainer(embedder));
+}
+#endif  // BUILDFLAG(IS_ANDROID)
