+#if BUILDFLAG(IS_ANDROID)
+class DesktopCaptureAndroidUnloadTest : public DesktopCaptureApiTest {
+ protected:
+  void CheckPendingWorkerChooser(bool reload) {
+    embedded_test_server()->ServeFilesFromDirectory(
+        GetTestResourcesParentDir());
+    ASSERT_TRUE(StartEmbeddedTestServer());
+    content::WebContents* target = GetActiveWebContents();
+    ASSERT_TRUE(
+        NavigateToURL(target, GetURLForPath("localhost", "/test_file.html")));
+
+    TestExtensionDir test_dir;
+    test_dir.WriteManifest(R"({
+      "name": "Pending desktop capture",
+      "manifest_version": 3,
+      "version": "1.0",
+      "background": { "service_worker": "worker.js" },
+      "permissions": ["desktopCapture", "tabs"]
+    })");
+    test_dir.WriteFile(FILE_PATH_LITERAL("worker.js"), R"(
+      chrome.tabs.query({}, tabs => {
+        chrome.test.assertEq(1, tabs.length);
+        const request = chrome.desktopCapture.chooseDesktopMedia(
+            ["tab"], tabs[0], () => {});
+        chrome.test.sendMessage(String(request));
+      });
+    )");
+
+    picker_factory_.SetTestFlags(test_flags_);
+    ExtensionTestMessageListener requested;
+    const Extension* extension = LoadExtension(test_dir.UnpackedPath());
+    ASSERT_TRUE(extension);
+    const ExtensionId extension_id = extension->id();
+    requested.set_extension_id(extension_id);
+    ASSERT_TRUE(requested.WaitUntilSatisfied());
+    int request_id = 0;
+    ASSERT_TRUE(base::StringToInt(requested.message(), &request_id));
+    const auto workers = ProcessManager::Get(GetProfile())
+                             ->GetServiceWorkersForExtension(extension_id);
+    ASSERT_EQ(1u, workers.size());
+    // Also clean up the intentionally held picker on a failing pre-fix run.
+    // Use the actual request and worker process, not a fabricated dispatch.
+    base::ScopedClosureRunner cleanup(base::BindOnce(
+        [](int process_id, int request_id) {
+          DesktopCaptureRequestsRegistry::GetInstance()->CancelRequest(
+              process_id, request_id);
+        },
+        workers[0].render_process_id.GetUnsafeValue(), request_id));
+    ASSERT_TRUE(
+        base::test::RunUntil([&] { return test_flags_[0].picker_shown; }));
+    ASSERT_FALSE(test_flags_[0].picker_deleted);
+
+    if (reload) {
+      // The replacement worker must not issue a second chooser request.
+      test_dir.WriteFile(FILE_PATH_LITERAL("worker.js"),
+                         "// Reloaded without requesting capture.\n");
+      ReloadExtension(extension_id);
+      EXPECT_TRUE(
+          extension_registry()->enabled_extensions().Contains(extension_id));
+    } else {
+      DisableExtension(extension_id);
+      EXPECT_TRUE(
+          extension_registry()->disabled_extensions().Contains(extension_id));
+    }
+    EXPECT_TRUE(test_flags_[0].picker_deleted);
+    EXPECT_FALSE(picker_factory_.picker());
+    // Unload must cancel because the caller went away, not because its target
+    // tab was destroyed or navigated.
+    ASSERT_EQ(target, GetActiveWebContents());
+    EXPECT_EQ(GetURLForPath("localhost", "/test_file.html"),
+              target->GetLastCommittedURL());
+  }
+
+ private:
+  std::array<FakeDesktopMediaPickerFactory::TestFlags, 1> test_flags_ = {{
+      {.expect_tabs = true, .cancelled = true},
+  }};
+};
+
+IN_PROC_BROWSER_TEST_F(DesktopCaptureAndroidUnloadTest,
+                       DisableClosesPendingWorkerChooser) {
+  CheckPendingWorkerChooser(/*reload=*/false);
+}
+
+IN_PROC_BROWSER_TEST_F(DesktopCaptureAndroidUnloadTest,
+                       ReloadClosesPendingWorkerChooser) {
+  CheckPendingWorkerChooser(/*reload=*/true);
+}
+#endif  // BUILDFLAG(IS_ANDROID)
