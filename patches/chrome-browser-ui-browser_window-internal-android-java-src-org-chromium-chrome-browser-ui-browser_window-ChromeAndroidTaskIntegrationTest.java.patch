+        var pendingRef = new AtomicReference<ChromeAndroidTaskImpl>();
+        var unrelatedRef = new AtomicReference<ChromeAndroidTaskImpl>();
+        var otrRef = new AtomicReference<Profile>();
+        var callback = new CountingNativeCompletion();
+        var reentrantCallback = new CountingNativeCompletion();
+        boolean[] observed = new boolean[5];
+        try {
+            ThreadUtils.runOnUiThreadBlocking(
+                    () -> {
+                        var tracker =
+                                (ChromeAndroidTaskTrackerImpl)
+                                        ChromeAndroidTaskTrackerFactory.getInstance();
+                        var regular = assumeNonNull(activity.getActivityTab()).getProfile();
+                        assertNull(regular.getPrimaryOtrProfile(false));
+                        var otr = regular.getOrCreatePrimaryOtrProfile();
+                        otrRef.set(otr);
+                        tracker.pausePendingTaskActivityCreationForTesting();
+                        var unrelated =
+                                tracker.createPendingTask(pendingPopupParams(regular, null), null);
+                        assertNotNull(unrelated);
+                        unrelatedRef.set(unrelated);
+                        int unrelatedId =
+                                assumeNonNull(unrelated.getPendingTaskInfo()).mPendingTaskId;
+                        var pending =
+                                tracker.createPendingTask(pendingPopupParams(otr, null), callback);
+                        assertNotNull(pending);
+                        pendingRef.set(pending);
+                        int pendingId = assumeNonNull(pending.getPendingTaskInfo()).mPendingTaskId;
+                        assertNotEquals(0L, pending.getOrCreateNativeBrowserWindowPtr(otr));
+                        var window = pending.getBrowserWindowsForTesting(otr).get(0);
+                        assertNotEquals(0L, window.getNativePtr());
+                        callback.mInspection =
+                                () -> {
+                                    observed[0] =
+                                            tracker.getPendingTaskForTesting(pendingId) == null;
+                                    observed[1] =
+                                            window.getNativePtr() == 0 && pending.isDestroyed();
+                                    observed[2] = otr.shutdownStarted();
+                                    observed[3] =
+                                            tracker.getPendingTaskForTesting(unrelatedId)
+                                                    == unrelated;
+                                    observed[4] =
+                                            tracker.createPendingTask(
+                                                            pendingPopupParams(otr, null),
+                                                            reentrantCallback)
+                                                    == null;
+                                };
+                        // This invokes the production deferred ProfileDestroyer path,
+                        // including Java notification before native ProfileObservers.
+                        ProfileManager.destroyWhenAppropriate(otr);
+                        assertEquals(1, callback.mCalls);
+                        assertEquals(0L, callback.mValue);
+                        assertEquals(0, callback.mDestroyCalls);
+                        assertEquals(1, reentrantCallback.mCalls);
+                        assertEquals(0L, reentrantCallback.mValue);
+                        for (boolean value : observed) assertTrue(value);
+                        assertTrue(tracker.isPendingTaskAvailable(unrelatedId));
+                        assertFalse(tracker.isPendingTaskAvailable(pendingId));
+                        assertEquals(1, tracker.getHeldPendingTaskIdsForTesting().length);
+                        tracker.resumePendingTaskActivityCreationForTesting(pendingId);
+                        assertEquals(1, callback.mCalls);
+                        pending.destroy();
+                        assertEquals(1, callback.mCalls);
+                        assertFalse(activity.isFinishing());
+                    });
+            CriteriaHelper.pollUiThread(() -> !assumeNonNull(otrRef.get()).isNativeInitialized());
+        } finally {
+            ThreadUtils.runOnUiThreadBlocking(
+                    () -> {
+                        var pending = pendingRef.get();
+                        if (pending != null) pending.destroy();
+                        var unrelated = unrelatedRef.get();
+                        if (unrelated != null) unrelated.destroy();
+                        var tracker =
+                                (ChromeAndroidTaskTrackerImpl)
+                                        ChromeAndroidTaskTrackerFactory.getInstance();
+                        tracker.clearActivityCreationPauseForTesting();
+                        var otr = otrRef.get();
+                        if (otr != null && otr.isNativeInitialized() && !otr.shutdownStarted()) {
+                            ProfileManager.destroyWhenAppropriate(otr);
+                        }
+                    });
+        }
+    }
