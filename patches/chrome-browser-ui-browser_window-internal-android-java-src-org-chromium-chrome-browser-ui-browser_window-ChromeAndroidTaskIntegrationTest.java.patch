+    @Test
+    @MediumTest
+    public void
+            issuedTransferredPopup_realOtrDestructionRejectsLateActivityAndDestroysOwnedContents() {
+        mFreshCtaTransitTestRule.startOnBlankPage();
+        var activity = mFreshCtaTransitTestRule.getActivity();
+        var pendingRef = new AtomicReference<ChromeAndroidTaskImpl>();
+        var otrRef = new AtomicReference<Profile>();
+        var launchedActivity = new AtomicReference<Activity>();
+        var pendingIdRef = new AtomicReference<Integer>();
+        var callback = new CountingNativeCompletion();
+        boolean[] disposedBeforeCompletion = new boolean[3];
+        ApplicationStatus.ActivityStateListener listener =
+                (candidate, state) -> {
+                    Integer id =
+                            ChromeAndroidTaskTracker.getPendingTaskIdFromIntent(
+                                    candidate.getIntent());
+                    if (id != null && id.equals(pendingIdRef.get()))
+                        launchedActivity.set(candidate);
+                };
+        try {
+            ThreadUtils.runOnUiThreadBlocking(
+                    () -> {
+                        ApplicationStatus.registerStateListenerForAllActivities(listener);
+                        var tracker =
+                                (ChromeAndroidTaskTrackerImpl)
+                                        ChromeAndroidTaskTrackerFactory.getInstance();
+                        var regular = assumeNonNull(activity.getActivityTab()).getProfile();
+                        assertNull(regular.getPrimaryOtrProfile(false));
+                        var otr = regular.getOrCreatePrimaryOtrProfile();
+                        otrRef.set(otr);
+                        var contents = WebContentsFactory.createWebContents(otr, false, false);
+                        // The actual creator issues Android startActivity and transfers
+                        // this real WebContents through TabReparentingParams. No creator
+                        // interception or synthesized Profile notification is used.
+                        var pending =
+                                tracker.createPendingTask(
+                                        pendingPopupParams(otr, contents), callback);
+                        assertNotNull(pending);
+                        pendingRef.set(pending);
+                        int pendingId = assumeNonNull(pending.getPendingTaskInfo()).mPendingTaskId;
+                        pendingIdRef.set(pendingId);
+                        var paramsManager = AsyncTabParamsManagerSingleton.getInstance();
+                        int transferredId = -1;
+                        for (int i = 0; i < paramsManager.getAsyncTabParams().size(); i++) {
+                            var params = paramsManager.getAsyncTabParams().valueAt(i);
+                            if (params instanceof TabReparentingParams transferred
+                                    && transferred.getTabToReparent().getWebContents()
+                                            == contents) {
+                                transferredId = paramsManager.getAsyncTabParams().keyAt(i);
+                            }
+                        }
+                        assertTrue(transferredId != -1);
+                        int tabId = transferredId;
+                        assertNull(contents.getTopLevelNativeWindow());
+                        assertNotEquals(0L, pending.getOrCreateNativeBrowserWindowPtr(otr));
+                        var window = pending.getBrowserWindowsForTesting(otr).get(0);
+                        callback.mInspection =
+                                () -> {
+                                    disposedBeforeCompletion[0] =
+                                            tracker.getPendingTaskForTesting(pendingId) == null;
+                                    disposedBeforeCompletion[1] = window.getNativePtr() == 0;
+                                    disposedBeforeCompletion[2] =
+                                            contents.isDestroyed()
+                                                    && paramsManager.getAsyncTabParams().get(tabId)
+                                                            == null;
+                                };
+                        // Remain in this UI task: the issued Activity cannot complete
+                        // startup before genuine Profile destruction cancels its request.
+                        ProfileManager.destroyWhenAppropriate(otr);
+                        assertEquals(1, callback.mCalls);
+                        assertEquals(0L, callback.mValue);
+                        assertEquals(0, callback.mDestroyCalls);
+                        for (boolean value : disposedBeforeCompletion) assertTrue(value);
+                        assertFalse(activity.isFinishing());
+                    });
+            CriteriaHelper.pollUiThread(
+                    () -> {
+                        var launched = launchedActivity.get();
+                        return launched != null && launched.isDestroyed();
+                    },
+                    "Issued cancelled popup Activity did not terminate.");
+            CriteriaHelper.pollUiThread(() -> !assumeNonNull(otrRef.get()).isNativeInitialized());
+            ThreadUtils.runOnUiThreadBlocking(
+                    () -> {
+                        var regular = assumeNonNull(activity.getActivityTab()).getProfile();
+                        assertNull(regular.getPrimaryOtrProfile(false));
+                        assertFalse(activity.isFinishing());
+                        assertEquals(1, callback.mCalls);
+                        assertTrue(assumeNonNull(pendingRef.get()).isDestroyed());
+                    });
+        } finally {
+            ThreadUtils.runOnUiThreadBlocking(
+                    () -> {
+                        ApplicationStatus.unregisterActivityStateListener(listener);
+                        var launched = launchedActivity.get();
+                        if (launched != null && !launched.isDestroyed()) launched.finish();
+                        var pending = pendingRef.get();
+                        if (pending != null) pending.destroy();
+                        var otr = otrRef.get();
+                        if (otr != null && otr.isNativeInitialized() && !otr.shutdownStarted()) {
+                            ProfileManager.destroyWhenAppropriate(otr);
+                        }
+                    });
+        }
+    }
