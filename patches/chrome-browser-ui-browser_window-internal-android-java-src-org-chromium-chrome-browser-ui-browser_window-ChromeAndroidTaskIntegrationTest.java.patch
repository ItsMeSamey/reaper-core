+    private static AndroidBrowserWindowCreateParams pendingPopupParams(
+            Profile profile, @Nullable WebContents contents) {
+        return AndroidBrowserWindowCreateParamsImpl.create(
+                BrowserWindowType.POPUP,
+                profile,
+                0,
