+    // This observes Java once dispatch. The native WebAuthFlow browser regression
+    // separately exercises a real allocated native callback and deferred deletion.
+    private static final class CountingNativeCompletion implements JniOnceCallback<Long> {
+        int mCalls;
+        int mDestroyCalls;
+        long mValue = -1;
+        @Nullable Runnable mInspection;
+
+        @Override
+        public void onResult(Long value) {
+            mCalls++;
+            mValue = value;
+            if (mInspection != null) mInspection.run();
+        }
+
+        @Override
+        public void destroy() {
+            mDestroyCalls++;
+        }
+    }
