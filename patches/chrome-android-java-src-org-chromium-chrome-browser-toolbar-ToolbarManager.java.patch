+    private void updateExtensionsToolbarCoordinator(
+            @Nullable ContextMenuPopulatorFactory contextMenuPopulatorFactory,
+            @Nullable SelectionDropdownMenuDelegate selectionDropdownMenuDelegate) {
+        if (mIsDestroyed || mTabModelSelector == null) return;
+        ChromeAndroidTask task = mChromeAndroidTaskSupplier.get();
+        if (task == null || task.isDestroyed()) return;
+
+        TabModel tabModel = mTabModelSelector.getCurrentModel();
+        Profile profile = tabModel.getProfile();
+        Tab activeTab = mActivityTabProvider.get();
+        ActivityWindowAndroid activityWindow = (ActivityWindowAndroid) mWindowAndroid;
+        boolean hasBrowserWindow =
+                profile != null
+                        && !profile.shutdownStarted()
+                        // Tab and model suppliers notify separately during a profile switch.
+                        // Wait until both agree before binding native UI to the active tab.
+                        && (activeTab == null || activeTab.getProfile() == profile)
+                        && task.getValidProfilesForActivity(activityWindow).contains(profile);
+        ChromeAndroidTaskFeatureKey key =
+                hasBrowserWindow
+                        ? new ChromeAndroidTaskFeatureKey(
+                                ExtensionsToolbarCoordinator.class,
+                                profile,
+                                activityWindow,
+                                tabModel.isIncognito() ? tabModel : null)
+                        : null;
+        if (key != null && key.equals(mExtensionsToolbarFeatureKey)) return;
+        if (mExtensionsToolbarFeatureKey != null) {
+            task.removeFeature(mExtensionsToolbarFeatureKey);
+        }
+        if (key == null || profile == null) return;
+
+        ViewStub stub = mControlContainer.findViewById(R.id.extensions_toolbar_container_stub);
+        if (stub == null || !(stub.getParent() instanceof ViewGroup parent)) return;
+        int index = parent.indexOfChild(stub);
+        ViewGroup.LayoutParams layoutParams = stub.getLayoutParams();
+        mExtensionsToolbarFeatureKey = key;
+        Runnable cleanup =
+                () -> {
+                    if (!key.equals(mExtensionsToolbarFeatureKey)) return;
+                    mExtensionsToolbarFeatureKey = null;
+                    mExtensionsToolbarCoordinator = null;
+                    mToolbar.setExtensionsToolbarCoordinator(null);
+                    // ViewStub.inflate() consumes the stub. Restore one for the next profile.
+                    View container = parent.findViewById(R.id.extensions_toolbar_container);
+                    if (container != null) {
+                        parent.removeView(container);
+                        ViewStub replacement = new ViewStub(stub.getContext());
+                        replacement.setId(R.id.extensions_toolbar_container_stub);
+                        replacement.setInflatedId(R.id.extensions_toolbar_container);
+                        parent.addView(
+                                replacement, Math.min(index, parent.getChildCount()), layoutParams);
+                    }
+                    // The task invokes cleanup before destroying the native coordinator. Defer
+                    // recreation until its BrowserWindow/Profile teardown has completed.
+                    if (!mIsDestroyed) {
+                        mHandler.post(
+                                () -> {
+                                    if (mUpdateExtensionsToolbar != null) {
+                                        mUpdateExtensionsToolbar.run();
+                                    }
+                                });
+                    }
+                };
+        mExtensionsToolbarCoordinator =
+                (ExtensionsToolbarCoordinator)
+                        task.addFeature(
+                                key,
+                                () ->
+                                        ExtensionsToolbarCoordinator.maybeCreate(
+                                                mActivity,
+                                                stub,
+                                                mWindowAndroid,
+                                                task,
+                                                profile,
+                                                mActivityTabProvider.asObservable(),
+                                                mTabCreatorManager.getTabCreator(false),
+                                                getBrowsingModeThemeColorProvider(),
+                                                mToolbarLayout,
+                                                contextMenuPopulatorFactory,
+                                                selectionDropdownMenuDelegate,
+                                                mTabModelSelector,
+                                                mModalDialogManagerSupplier.get(),
+                                                cleanup,
+                                                /* isWebApp= */ false));
+        if (mExtensionsToolbarCoordinator == null) {
