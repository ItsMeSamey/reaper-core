+  const ValuableMetadata metadata = card.metadata();
+  ASSERT_TRUE(valuables_table().AddOrUpdateValuableMetadata(metadata));
+  sync_pb::AutofillValuableMetadataSpecifics document;
+  document.set_valuable_id(card.id().value());
+  document.set_pass_type(
+      sync_pb::AutofillValuableMetadataSpecifics::VEHICLE_REGISTRATION);
+  document.set_use_count(999);
+  syncer::EntityChangeList changes;
+  changes.push_back(syncer::EntityChange::CreateAdd(
+      document.valuable_id(), SpecificsToEntity(document)));
+  EXPECT_CALL(mock_processor(), Put(card.id().value(), _, _)).Times(1);
+  EXPECT_FALSE(bridge()
+                   .MergeFullSyncData(bridge().CreateMetadataChangeList(),
+                                      std::move(changes))
+                   .has_value());
+  EXPECT_THAT(GetValuableMetadataEntries(), ElementsAre(metadata));
+}
+TEST_F(ValuableMetadataSyncBridgeTest,
+       AndroidLegacyMetadataRequiresRealLoyaltyOwnership) {
+  base::test::ScopedFeatureList feature_list{syncer::kSyncLoyaltyCardMetadata};
+  const LoyaltyCard card = TestLoyaltyCard("1");
+  ASSERT_TRUE(valuables_table().AddOrUpdateLoyaltyCard(card));
+  ASSERT_THAT(GetValuableMetadataEntries(), ElementsAre(card.metadata()));
+  const ValuableMetadata legacy_metadata =
+      TestValuableMetadata(card.id().value());
+  sync_pb::AutofillValuableMetadataSpecifics legacy =
+      CreateSpecificsFromValuableMetadata(
+          legacy_metadata,
+          sync_pb::AutofillValuableMetadataSpecifics::PASS_TYPE_UNSPECIFIED,
+          /*base_specifics=*/{});
+  EXPECT_TRUE(bridge().IsEntityDataValid(SpecificsToEntity(legacy)));
+  sync_pb::AutofillValuableMetadataSpecifics unowned = legacy;
+  unowned.set_valuable_id("not-a-loyalty-card");
+  EXPECT_FALSE(bridge().IsEntityDataValid(SpecificsToEntity(unowned)));
+  syncer::EntityChangeList changes;
+  changes.push_back(syncer::EntityChange::CreateAdd(
+      unowned.valuable_id(), SpecificsToEntity(unowned)));
+  changes.push_back(syncer::EntityChange::CreateAdd(legacy.valuable_id(),
+                                                    SpecificsToEntity(legacy)));
+  EXPECT_FALSE(bridge()
+                   .ApplyIncrementalSyncChanges(
+                       bridge().CreateMetadataChangeList(), std::move(changes))
+                   .has_value());
+  EXPECT_THAT(GetValuableMetadataEntries(), ElementsAre(legacy_metadata));
+}
+TEST_F(ValuableMetadataSyncBridgeTest,
+       AndroidLegacyAndTypedLoyaltyMetadataRespectExistingFeatureGate) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndDisableFeature(syncer::kSyncLoyaltyCardMetadata);
+  const LoyaltyCard card = TestLoyaltyCard("1");
+  ASSERT_TRUE(valuables_table().AddOrUpdateLoyaltyCard(card));
+  ASSERT_TRUE(valuables_table().RemoveValuableMetadata(card.id()));
+  ASSERT_THAT(GetValuableMetadataEntries(), IsEmpty());
+  syncer::EntityChangeList changes;
+  for (auto pass_type :
+       {sync_pb::AutofillValuableMetadataSpecifics::LOYALTY_CARD,
+        sync_pb::AutofillValuableMetadataSpecifics::PASS_TYPE_UNSPECIFIED}) {
+    changes.push_back(syncer::EntityChange::CreateAdd(
+        card.id().value(),
+        SpecificsToEntity(CreateSpecificsFromValuableMetadata(
+            card.metadata(), pass_type, /*base_specifics=*/{}))));
+  }
+  EXPECT_FALSE(bridge()
+                   .ApplyIncrementalSyncChanges(
+                       bridge().CreateMetadataChangeList(), std::move(changes))
+                   .has_value());
+  EXPECT_THAT(GetValuableMetadataEntries(), IsEmpty());
+  EXPECT_FALSE(bridge().GetAllDataForDebugging()->HasNext());
+}
