+IN_PROC_BROWSER_TEST_F(ServiceWorkerMessagingTest,
+                       PortAccountingDropsStoppedWorkerBeforeLateClose) {
+  TestExtensionDir test_dir;
+  test_dir.WriteManifest(R"({
+    "name": "Port incarnation accounting",
+    "manifest_version": 3,
+    "version": "1.0",
+    "background": {"service_worker": "background.js"}
+  })");
+  test_dir.WriteFile(FILE_PATH_LITERAL("background.js"), R"(
+    self.ports = [];
+    chrome.runtime.onConnect.addListener(port => {
+      self.ports.push(port);
+      port.postMessage('worker connected');
+    });
+    chrome.test.sendMessage('port worker ready');
+  )");
+  test_dir.WriteFile(FILE_PATH_LITERAL("receiver.html"),
+                    "<script src='receiver.js'></script>");
+  test_dir.WriteFile(FILE_PATH_LITERAL("receiver.js"), R"(
+    window.ports = [];
+    chrome.runtime.onConnect.addListener(port => {
+      window.ports.push(port);
+      port.postMessage('frame connected');
+    });
+    window.ready = true;
+  )");
+  test_dir.WriteFile(FILE_PATH_LITERAL("sender.html"), "<p>Sender</p>");
+  ExtensionTestMessageListener ready("port worker ready");
+  const Extension* extension = LoadExtension(
+      test_dir.UnpackedPath(), {.wait_for_registration_stored = true});
+  ASSERT_TRUE(extension);
+  ASSERT_TRUE(ready.WaitUntilSatisfied());
+  ASSERT_TRUE(
+      NavigateToURLInNewTab(extension->GetResourceURL("receiver.html")));
+  content::WebContents* receiver = GetActiveWebContents();
+  EXPECT_EQ(true, content::EvalJs(receiver, "window.ready"));
+  ASSERT_TRUE(NavigateToURLInNewTab(extension->GetResourceURL("sender.html")));
+  content::WebContents* sender = GetActiveWebContents();
+  EXPECT_EQ(true, content::EvalJs(sender, R"(
+    (async () => {
+      window.disconnected = false;
+      return await new Promise(resolve => {
+        const connected = new Set();
+        window.port = chrome.runtime.connect({name: 'accounting'});
+        window.port.onDisconnect.addListener(() => {
+          window.disconnected = true;
+        });
+        window.port.onMessage.addListener(value => {
+          connected.add(value);
+          if (connected.has('worker connected') &&
+              connected.has('frame connected')) {
+            resolve(true);
+          }
+        });
+      });
+    })();
+  )"));
+  base::RunLoop().RunUntilIdle();
+  ProcessManager* pm = ProcessManager::Get(profile());
+  const auto old_workers = pm->GetServiceWorkersForExtension(extension->id());
+  ASSERT_EQ(1u, old_workers.size());
+  const auto initial_records =
+      pm->GetServiceWorkerKeepaliveDataForRecords(extension->id());
+  ASSERT_FALSE(initial_records.empty());
+  for (const auto& record : initial_records) {
+    EXPECT_EQ(Activity::MESSAGE_PORT, record.activity_type);
+    EXPECT_TRUE(record.worker_id.start_token == old_workers[0].start_token);
+  }
+
+  StopServiceWorker(*extension);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(
+      pm->GetServiceWorkerKeepaliveDataForRecords(extension->id()).empty());
+  // The genuine receiver frame keeps this channel alive after the worker stops.
+  EXPECT_EQ(false, content::EvalJs(sender, "window.disconnected"));
+  EXPECT_EQ("restarted", BackgroundScriptExecutor::ExecuteScript(
+                             profile(), extension->id(),
+                             "chrome.test.sendScriptResult('restarted');",
+                             BackgroundScriptExecutor::ResultCapture::
+                                 kSendScriptResult));
+  base::RunLoop().RunUntilIdle();
+  const auto new_workers = pm->GetServiceWorkersForExtension(extension->id());
+  ASSERT_EQ(1u, new_workers.size());
+  EXPECT_TRUE(new_workers[0].start_token != old_workers[0].start_token);
+  ServiceWorkerKeepalive new_owner(
+      profile(), new_workers[0],
+      content::ServiceWorkerExternalRequestTimeoutType::kDefault,
+      Activity::EVENT, "new port incarnation");
+  ASSERT_TRUE(content::ExecJs(sender, "window.port.disconnect();"));
+  base::RunLoop().RunUntilIdle();
+  const auto remaining =
+      pm->GetServiceWorkerKeepaliveDataForRecords(extension->id());
+  ASSERT_EQ(1u, remaining.size());
+  EXPECT_EQ("new port incarnation", remaining[0].extra_data);
+  EXPECT_TRUE(remaining[0].worker_id.start_token == new_workers[0].start_token);
+}
+IN_PROC_BROWSER_TEST_F(ServiceWorkerMessagingTest,
+                       LivePortDisconnectBalancesCurrentWorkerRecords) {
+  TestExtensionDir test_dir;
+  test_dir.WriteManifest(R"({
+    "name": "Live port accounting",
+    "manifest_version": 3,
+    "version": "1.0",
+    "background": {"service_worker": "background.js"}
+  })");
+  test_dir.WriteFile(FILE_PATH_LITERAL("background.js"), R"(
+    chrome.runtime.onConnect.addListener(port => {
+      self.port = port;
+      port.onMessage.addListener(message => {
+        if (message === 'disconnect') {
+          port.disconnect();
+        }
+      });
+      port.postMessage('connected');
+    });
+    chrome.test.sendMessage('live port worker ready');
+  )");
+  test_dir.WriteFile(FILE_PATH_LITERAL("sender.html"), "<p>Sender</p>");
+  ExtensionTestMessageListener ready("live port worker ready");
+  const Extension* extension = LoadExtension(
+      test_dir.UnpackedPath(), {.wait_for_registration_stored = true});
+  ASSERT_TRUE(extension);
+  ASSERT_TRUE(ready.WaitUntilSatisfied());
+  base::RunLoop().RunUntilIdle();
+  ProcessManager* pm = ProcessManager::Get(profile());
+  EXPECT_TRUE(
+      pm->GetServiceWorkerKeepaliveDataForRecords(extension->id()).empty());
+
+  ASSERT_TRUE(NavigateToURLInNewTab(extension->GetResourceURL("sender.html")));
+  content::WebContents* sender = GetActiveWebContents();
+  EXPECT_EQ(true, content::EvalJs(sender, R"(
+    (async () => {
+      return await new Promise(resolve => {
+        window.port = chrome.runtime.connect({name: 'live accounting'});
+        window.disconnected = new Promise(disconnected => {
+          window.port.onDisconnect.addListener(() => disconnected(true));
+        });
+        window.port.onMessage.addListener(message => {
+          if (message === 'connected') {
+            resolve(true);
+          }
+        });
+      });
+    })();
+  )"));
+  base::RunLoop().RunUntilIdle();
+  const auto workers = pm->GetServiceWorkersForExtension(extension->id());
+  ASSERT_EQ(1u, workers.size());
+  const auto connected_records =
+      pm->GetServiceWorkerKeepaliveDataForRecords(extension->id());
+  ASSERT_FALSE(connected_records.empty());
+  for (const auto& record : connected_records) {
+    EXPECT_EQ(Activity::MESSAGE_PORT, record.activity_type);
+    EXPECT_TRUE(record.worker_id.start_token == workers[0].start_token);
+  }
+  {
+    ServiceWorkerKeepalive unrelated_owner(
+        profile(), workers[0],
+        content::ServiceWorkerExternalRequestTimeoutType::kDefault,
+        Activity::EVENT, "unrelated live port owner");
+    EXPECT_EQ(true, content::EvalJs(sender, R"(
+      window.port.postMessage('disconnect');
+      window.disconnected;
+    )"));
+    base::RunLoop().RunUntilIdle();
+    const auto remaining =
+        pm->GetServiceWorkerKeepaliveDataForRecords(extension->id());
+    ASSERT_EQ(1u, remaining.size());
+    EXPECT_EQ(Activity::EVENT, remaining[0].activity_type);
+    EXPECT_EQ("unrelated live port owner", remaining[0].extra_data);
+    EXPECT_TRUE(remaining[0].worker_id.start_token == workers[0].start_token);
+    const auto current_workers =
+        pm->GetServiceWorkersForExtension(extension->id());
+    ASSERT_EQ(1u, current_workers.size());
+    EXPECT_TRUE(current_workers[0].start_token == workers[0].start_token);
+  }
+  EXPECT_TRUE(
+      pm->GetServiceWorkerKeepaliveDataForRecords(extension->id()).empty());
+}
