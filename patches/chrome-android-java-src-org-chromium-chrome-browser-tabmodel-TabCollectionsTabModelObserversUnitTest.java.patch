+    @Test
+    public void testOnTabGroupRemoving_reparentLastMemberBeforeNativeDetach() {
+        MockTab first = createMockTab(101, mProfile);
+        MockTab last = createMockTab(102, mProfile);
+        MockTab ungrouped = createMockTab(103, mProfile);
+        mTabModel.addTab(first, 0, TabLaunchType.FROM_CHROME_UI, TabCreationState.LIVE_IN_FOREGROUND);
+        mTabModel.addTab(last, 1, TabLaunchType.FROM_CHROME_UI, TabCreationState.LIVE_IN_FOREGROUND);
+        mTabModel.addTab(ungrouped, 2, TabLaunchType.FROM_CHROME_UI, TabCreationState.LIVE_IN_FOREGROUND);
+        Token groupId = new Token(1L, 2L);
+        first.setTabGroupId(groupId);
+        last.setTabGroupId(groupId);
+
+        reset(mTabModelObserver);
+        mTabModel.removeTab(first);
+        verify(mTabModelObserver, never()).onTabGroupRemoving(any());
+        assertTrue(mTabModel.tabGroupExists(groupId));
+
+        doAnswer(
+                        invocation -> {
+                            assertTrue(mTabModel.tabGroupExists(groupId));
+                            assertEquals(List.of(last), mTabModel.getTabsInGroup(groupId));
+                            return null;
+                        })
+                .when(mTabModelObserver)
+                .onTabGroupRemoving(eq(groupId));
+        mTabModel.removeTab(last);
+
+        verify(mTabModelObserver).onTabGroupRemoving(eq(groupId));
+        assertFalse(mTabModel.tabGroupExists(groupId));
+        assertEquals(List.of(ungrouped), mTabs);
+    }
+
