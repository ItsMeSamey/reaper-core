+#if BUILDFLAG(IS_ANDROID)
+TEST_F(AutofillMessageControllerImplTest,
+       GenericRetiredMetadataPreservesOwnershipWithoutOptionalMetrics) {
+  base::HistogramTester histogram_tester;
+  AutofillMessageControllerImpl actual_controller(web_contents());
+  auto model = std::make_unique<AutofillMessageModel>(
+      std::make_unique<messages::MessageWrapper>(
+          messages::MessageIdentifier::SAVE_CARD_FAILURE),
+      AutofillMessageModel::Type::kEntitySaveUpdateFlow);
+  AutofillMessageModel* model_ptr = model.get();
+  const std::string metric_type(model->GetTypeAsString());
+  ExpectEnqueueMessageCall();
+  actual_controller.Show(std::move(model));
+  EXPECT_THAT(test_api(actual_controller).GetMessageModels(),
+              testing::Contains(model_ptr));
+  test_api(actual_controller).OnActionClicked(model_ptr);
+  test_api(actual_controller)
+      .OnDismissed(model_ptr, messages::DismissReason::PRIMARY_ACTION);
+  EXPECT_THAT(test_api(actual_controller).GetMessageModels(),
+              testing::IsEmpty());
+
+  histogram_tester.ExpectTotalCount(
+      base::StrCat({"Autofill.Message.", metric_type, ".Shown"}), 0);
+  histogram_tester.ExpectTotalCount(
+      base::StrCat({"Autofill.Message.", metric_type, ".ActionClicked"}), 0);
+  histogram_tester.ExpectTotalCount(
+      base::StrCat({"Autofill.Message.", metric_type, ".Dismissed"}), 0);
+}
+#endif  // BUILDFLAG(IS_ANDROID)
