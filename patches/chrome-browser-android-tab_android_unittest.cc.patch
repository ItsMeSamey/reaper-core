 DEFINE_JNI(TabAndroidTestHelper)
+
+
+// Destruction may happen after a lazy tab has detached from its model, before
+// it ever initializes WebContents. Observers must not outlive the tab.
+TEST_F(TabAndroidTest, LazyTabDestructionAllowsObserverToStopObserving) {
+  class Observer final : public TabAndroid::Observer {
+   public:
+    void OnInitWebContents(TabAndroid*) override { ADD_FAILURE(); }
+    void OnTabAndroidDestroyed(TabAndroid* tab) override {
+      EXPECT_EQ(nullptr, tab->GetContents());
+      ++destroyed;
+      observation.Reset();
+    }
+    int destroyed = 0;
+    base::ScopedObservation<TabAndroid, TabAndroid::Observer> observation{this};
+  } observer;
+  auto lazy = TabAndroid::CreateForTesting(profile_.get(), kTabId + 1, nullptr);
+  observer.observation.Observe(lazy.get());
+  lazy.reset();
+  EXPECT_EQ(1, observer.destroyed);
+  EXPECT_FALSE(observer.observation.IsObserving());
+}
+
+// Native IDs exist before contents, and the first immutable helper consumes that
+// exact identity. These use the real Chrome factory and native tab lookup.
+TEST_F(TabAndroidTest, ReservesGenuineIdentityBeforeSessionHelper) {
+  auto contents = content::WebContents::Create(
+      content::WebContents::CreateParams(profile_.get()));
+  auto tab = TabAndroid::CreateForTesting(profile_.get(), kTabId + 1,
+                                         std::move(contents));
+  auto& factory = tabs::SessionMappedTabHandleFactory::GetInstance();
+  const auto id = factory.GetSessionIdForHandle(tab->GetHandle().raw_value());
+  ASSERT_TRUE(id);
+  EXPECT_TRUE(SessionID::IsValidValue(*id));
+  CreateSessionServiceTabHelper(tab->GetContents());
+  EXPECT_EQ(*id, sessions::SessionTabHelper::IdForTab(tab->GetContents()).id());
+  CreateSessionServiceTabHelper(tab->GetContents());
+  EXPECT_EQ(id, factory.GetSessionIdForHandle(tab->GetHandle().raw_value()));
+}
+
+TEST_F(TabAndroidTest, ExistingEagerHelperIdentityWinsAndSurvivesReparent) {
+  auto contents = content::WebContents::Create(
+      content::WebContents::CreateParams(profile_.get()));
+  const SessionID actual = SessionID::NewUnique();
+  sessions::SessionTabHelper::CreateForWebContents(
+      contents.get(), sessions::SessionTabHelper::DelegateLookup(), actual);
+  auto tab = TabAndroid::CreateForTesting(profile_.get(), kTabId + 1,
+                                         std::move(contents));
+  auto& factory = tabs::SessionMappedTabHandleFactory::GetInstance();
+  EXPECT_EQ(actual.id(),
+            factory.GetSessionIdForHandle(tab->GetHandle().raw_value()));
+  CreateSessionServiceTabHelper(tab->GetContents());
+  EXPECT_EQ(actual, sessions::SessionTabHelper::IdForTab(tab->GetContents()));
+  auto released = tab->ReleaseWebContentsForTesting();
+  EXPECT_FALSE(factory.GetSessionIdForHandle(tab->GetHandle().raw_value()));
+  EXPECT_EQ(actual, sessions::SessionTabHelper::IdForTab(released.get()));
+  auto adopted = TabAndroid::CreateForTesting(profile_.get(), kTabId + 2,
+                                             std::move(released));
+  EXPECT_EQ(actual.id(),
+            factory.GetSessionIdForHandle(adopted->GetHandle().raw_value()));
+  const auto handle = adopted->GetHandle();
+  adopted.reset();
+  EXPECT_FALSE(factory.GetSessionIdForHandle(handle.raw_value()));
+  EXPECT_EQ(0, factory.GetHandleForSessionId(actual.id()));
+}
+
+TEST_F(TabAndroidTest, DestroyContentsRetainsReservedIdentity) {
+  auto contents = content::WebContents::Create(
+      content::WebContents::CreateParams(profile_.get()));
+  auto tab = TabAndroid::CreateForTesting(profile_.get(), kTabId + 1,
+                                         std::move(contents));
+  CreateSessionServiceTabHelper(tab->GetContents());
+  auto& factory = tabs::SessionMappedTabHandleFactory::GetInstance();
+  const auto id = factory.GetSessionIdForHandle(tab->GetHandle().raw_value());
+  tab->DestroyWebContents();
+  EXPECT_EQ(nullptr, tab->GetContents());
+  EXPECT_EQ(id, factory.GetSessionIdForHandle(tab->GetHandle().raw_value()));
+}
