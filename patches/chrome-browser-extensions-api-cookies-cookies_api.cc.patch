+
+void CookiesEventRouter::RefreshContainerListeners() {
+  if (profile_->IsOffTheRecord()) {
+    return;
+  }
+  auto* service = ContainersServiceFactory::GetForProfile(profile_);
+  if (!service) {
+    return;
+  }
+  std::set<std::string> ids;
+  for (const auto& id : service->GetRuntimeContainerIds()) {
+    ids.insert(id);
+  }
+  profile_->ForEachLoadedStoragePartition([&](content::StoragePartition* part) {
+    const auto& config = part->GetConfig();
+    if (config.partition_domain() ==
+            containers::kContainersStoragePartitionDomain &&
+        !config.in_memory()) {
+      ids.insert(config.partition_name());
+    }
+  });
+  std::erase_if(ids, [&](const std::string& id) {
+    return id.empty() || !containers::android::IsContainerIdWellFormed(id) ||
+           !containers::android::ResolveContainerStoragePartition(profile_, id);
+  });
+  std::erase_if(container_subscriptions_,
+                [&](const auto& entry) { return !ids.contains(entry.first); });
+  for (const auto& id : ids) {
+    if (!container_subscriptions_.contains(id)) {
+      container_subscriptions_.emplace(
+          id, std::make_unique<ContainerSubscription>(this, id));
+    }
+    BindContainerListener(id);
+  }
+}
+
+void CookiesEventRouter::BindContainerListener(const std::string& id) {
+  if (id.empty() || !containers::android::IsContainerIdWellFormed(id)) {
+    return;
+  }
+  auto found = container_subscriptions_.find(id);
+  auto config =
+      containers::android::ResolveContainerStoragePartition(profile_, id);
+  if (found == container_subscriptions_.end() || !config ||
+      found->second->receiver.is_bound()) {
+    return;
+  }
+  auto* manager = profile_->GetStoragePartition(*config)
+                      ->GetCookieManagerForBrowserProcess();
+  if (!manager) {
+    return;
+  }
+  auto& receiver = found->second->receiver;
+  manager->AddGlobalChangeListener(receiver.BindNewPipeAndPassRemote());
+  receiver.set_disconnect_handler(
+      base::BindOnce(&CookiesEventRouter::OnContainerConnectionError,
+                     base::Unretained(this), id));
+}
+
+void CookiesEventRouter::OnContainerConnectionError(const std::string& id) {
+  auto found = container_subscriptions_.find(id);
+  if (found == container_subscriptions_.end()) {
+    return;
+  }
+  found->second->receiver.reset();
+  BindContainerListener(id);
+}
+
+void CookiesEventRouter::OnContainerCookieChange(
+    const std::string& id,
+    const net::CookieChangeInfo& change) {
+  if (!id.empty() && containers::android::IsContainerIdWellFormed(id) &&
+      container_subscriptions_.contains(id) &&
+      containers::android::ResolveContainerStoragePartition(profile_, id)) {
+    OnCookieChangeInStore(profile_, cookies_helpers::GetContainerStoreId(id),
+                          change);
+  }
+}
+#endif  // BUILDFLAG(IS_ANDROID)

