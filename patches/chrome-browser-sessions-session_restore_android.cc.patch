+
+// Sync owns SessionWindow/SessionTab records and may replace them while Android
+// creates the window. Retain only the restore data, never pointers into Sync.
+struct ForeignTabSnapshot {
+  std::vector<sessions::SerializedNavigationEntry> navigations;
+  int current_navigation_index;
+  bool pinned;
+  size_t original_index;
+};
+
+struct ForeignWindowSnapshot {
+  BrowserWindowInterface::Type type = BrowserWindowInterface::TYPE_NORMAL;
+  gfx::Rect bounds;
+  std::string app_name;
+  ui::mojom::WindowShowState show_state = ui::mojom::WindowShowState::kDefault;
+  std::vector<ForeignTabSnapshot> tabs;
+  size_t selected_tab_index = 0;
+};
+
+std::unique_ptr<content::WebContents> CreateForeignTabContents(
+    Profile* profile,
+    const ForeignTabSnapshot& tab) {
+  // Reuse the serialized navigation/renderer-free restoration used by
+  // AndroidLiveTabContext::AddRestoredTab. The selected tab loads on
+  // activation.
+  auto params = content::WebContents::CreateParams(profile);
+  auto container_id = containers::android::ConfigureContainerRestore(
+      profile, tab.navigations, tab.current_navigation_index, &params);
+  if (!container_id) return nullptr;
+  params.initially_hidden = true;
+  params.desired_renderer_state =
+      content::WebContents::CreateParams::kNoRendererProcess;
+  auto contents = content::WebContents::Create(params);
+  auto entries =
+      sessions::ContentSerializedNavigationBuilder::ToNavigationEntries(
+          tab.navigations, profile);
+  contents->GetController().Restore(tab.current_navigation_index,
+                                    content::RestoreType::kRestored, &entries);
+  return contents;
+}
+
+BrowserWindowInterface* PopulateForeignWindow(
+    base::WeakPtr<Profile> profile,
+    ForeignWindowSnapshot snapshot,
+    base::WeakPtr<content::WebContents> first_contents,
+    BrowserWindowInterface* browser) {
+  const auto windows = GetAllBrowserWindowInterfaces();
+  if (!browser || std::ranges::find(windows, browser) == windows.end()) {
+    return nullptr;
+  }
+  auto weak_browser = browser->GetWeakPtr();
+  auto get_model = [&]() -> TabModel* {
+    if (!profile || profile->ShutdownStarted() || profile->IsOffTheRecord() ||
+        !weak_browser || weak_browser->GetProfile() != profile.get() ||
+        !first_contents ||
+        first_contents->GetBrowserContext() != profile.get()) {
+      return nullptr;
+    }
+    auto* model =
+        static_cast<TabModel*>(TabListInterface::From(weak_browser.get()));
+    auto* first_tab = TabAndroid::FromWebContents(first_contents.get());
+    return model && model->GetProfile() == profile.get() && first_tab &&
+                   model->HasTab(first_tab)
+               ? model
+               : nullptr;
+  };
+
+  TabModel* model = get_model();
+  if (!model) {
+    return nullptr;
+  }
+  // The first real restored contents was transferred into the new window.
+  // Never manufacture or close a bootstrap tab inside the creation callback.
+  auto* first_tab = TabAndroid::FromWebContents(first_contents.get());
+  if (snapshot.tabs.front().pinned) {
+    model->PinTab(first_tab->GetHandle());
+  }
+  std::vector<base::WeakPtr<content::WebContents>> restored_contents;
+  restored_contents.push_back(first_contents);
+  for (size_t i = 1; i < snapshot.tabs.size(); ++i) {
+    model = get_model();
+    if (!model) {
+      return nullptr;
+    }
+    auto contents = CreateForeignTabContents(profile.get(), snapshot.tabs[i]);
+    if (!contents) return nullptr;
+    model = get_model();
+    if (!model) {
+      return nullptr;
+    }
+    restored_contents.push_back(contents->GetWeakPtr());
+    model->CreateTab(nullptr, std::move(contents), static_cast<int>(i),
+                     TabModel::TabLaunchType::FROM_RECENT_TABS,
+                     snapshot.tabs[i].pinned);
+    // Creation/pinning notifies model observers. Resolve ownership again before
+    // dereferencing anything exposed across that potentially reentrant call.
+    model = get_model();
+    auto contents_weak = restored_contents.back();
+    auto* tab = contents_weak ? TabAndroid::FromWebContents(contents_weak.get())
+                              : nullptr;
+    if (!model || !tab || !model->HasTab(tab)) {
+      return nullptr;
+    }
+  }
+
+  auto restored_tabs_match = [&](TabModel* current_model) {
+    if (!current_model) {
+      return false;
+    }
+    int previous_index = -1;
+    for (size_t i = 0; i < restored_contents.size(); ++i) {
+      const auto& contents = restored_contents[i];
+      auto* tab =
+          contents ? TabAndroid::FromWebContents(contents.get()) : nullptr;
+      if (!tab || tab->GetProfile() != profile.get() ||
+          !current_model->HasTab(tab) ||
+          tab->IsPinned() != snapshot.tabs[i].pinned) {
+        return false;
+      }
+      int index = current_model->GetIndexOfTab(tab->GetHandle());
+      if (index <= previous_index) {
+        return false;
+      }
+      previous_index = index;
+    }
+    return true;
+  };
+  model = get_model();
+  if (!restored_tabs_match(model)) {
+    return nullptr;
+  }
+  auto selected_contents = restored_contents[snapshot.selected_tab_index];
+  auto* selected = TabAndroid::FromWebContents(selected_contents.get());
+  model->SetActiveIndex(model->GetIndexOfTab(selected->GetHandle()));
+  model = get_model();
+  selected = selected_contents
+                 ? TabAndroid::FromWebContents(selected_contents.get())
+                 : nullptr;
+  if (!restored_tabs_match(model) || !selected || !model->HasTab(selected) ||
+      model->GetActiveWebContents() != selected_contents.get()) {
+    return nullptr;
+  }
+  // Failure never closes an already-created window or any partially restored
+  // user state. The API reports failure instead of claiming a complete restore.
+  return weak_browser.get();
+}
