+// Signed local MV3 updates use the real CrxInstaller, management function,
+// Chrome delegate and visible Android modal. Only the actual dialog controller
+// is driven by the test; the permission-completion callback is never replaced.
+class ExtensionManagementReenableConsentTest
+    : public ExtensionManagementApiBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    ExtensionManagementApiBrowserTest::SetUpOnMainThread();
+    extension_dir_.WriteFile(
+        FILE_PATH_LITERAL("worker.js"),
+        "chrome.runtime.onInstalled.addListener(() => {});");
+    const base::FilePath a = PackVersion("1", "");
+    const base::FilePath b = PackVersion("2", R"("bookmarks")");
+    c_path_ = PackVersion("3", R"("bookmarks", "history")");
+    const Extension* installed = InstallExtension(a, 1);
+    ASSERT_TRUE(installed);
+    id_ = installed->id();
+    ASSERT_FALSE(UpdateExtension(id_, b, -1));
+    b_ = extension_registry()->disabled_extensions().GetByID(id_);
+    ASSERT_TRUE(b_);
+    ASSERT_EQ("2", b_->version().GetString());
+    ASSERT_TRUE(
+        ExtensionPrefs::Get(profile())->DidExtensionEscalatePermissions(id_));
+    original_grants_ =
+        ExtensionPrefs::Get(profile())->GetGrantedPermissions(id_);
+    ASSERT_TRUE(original_grants_);
+    ASSERT_FALSE(original_grants_->HasAPIPermission("bookmarks"));
+    ASSERT_FALSE(original_grants_->HasAPIPermission("history"));
+    ASSERT_TRUE(content::NavigateToURL(GetActiveWebContents(),
+                                       GURL("chrome://extensions")));
+    // Keep the production modal and restore the previous auto-confirm value
+    // when this scope is released. No WindowAndroid manager is replaced.
+    auto_confirm_ = std::make_unique<ScopedTestDialogAutoConfirm>(
+        ScopedTestDialogAutoConfirm::NONE);
+  }
+
+  base::FilePath PackVersion(const char* version, const char* permissions) {
+    extension_dir_.WriteManifest(base::StringPrintf(
+        R"({"name":"Re-enable consent","manifest_version":3,"version":"%s",
+            "background":{"service_worker":"worker.js"},"permissions":[%s]})",
+        version, permissions));
+    return extension_dir_.Pack(base::StringPrintf("%s.crx", version));
+  }
+
+  void BeginEnable() {
+    ResetCompletedRequest();
+    ASSERT_TRUE(GetActiveWebContents());
+    sender_ = GetActiveWebContents()->GetWeakPtr();
+    function_ = base::MakeRefCounted<ManagementSetEnabledFunction>();
+    function_->set_source_context_type(mojom::ContextType::kWebUi);
+    function_->set_user_gesture(true);
+    function_->SetRenderFrameHost(sender_->GetPrimaryMainFrame());
+    base::ListValue args;
+    args.Append(id_);
+    args.Append(true);
+    function_->SetArgs(std::move(args));
+    dispatcher_ = std::make_unique<ExtensionFunctionDispatcher>(profile());
+    function_->SetDispatcher(dispatcher_->AsWeakPtr());
+    response_ =
+        std::make_unique<api_test_utils::SendResponseHelper>(function_.get());
+    function_->RunWithValidation().Execute();
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      CaptureDialog();
+      return !dialog_.is_null() || response_->has_response();
+    }));
+    ASSERT_FALSE(response_->has_response());
+    ASSERT_FALSE(dialog_.is_null());
+    ASSERT_FALSE(PromptPermissions().empty());
+  }
+
+  void CaptureDialog() {
+    if (!dialog_.is_null() || !sender_) {
+      return;
+    }
+    dialog_.Reset(android_test::CaptureInstallDialogForTesting(
+        base::android::AttachCurrentThread(), sender_.get()));
+  }
+
+  std::vector<std::u16string> PromptPermissions() {
+    return android_test::GetInstallDialogPermissionsForTesting(
+        base::android::AttachCurrentThread(), dialog_);
+  }
+
+  void CompletePrompt(bool accept) {
+    ASSERT_TRUE(response_);
+    ASSERT_FALSE(response_->has_response());
+    ASSERT_TRUE(android_test::ClickInstallDialogForTesting(
+        base::android::AttachCurrentThread(), dialog_, accept));
+    ASSERT_TRUE(
+        base::test::RunUntil([&] { return response_->has_response(); }));
+    EXPECT_TRUE(function_->did_respond());
+    base::RunLoop().RunUntilIdle();
+  }
+
+  void ExpectOriginalGrants() {
+    auto grants = ExtensionPrefs::Get(profile())->GetGrantedPermissions(id_);
+    ASSERT_TRUE(grants);
+    EXPECT_EQ(*original_grants_, *grants);
+    EXPECT_FALSE(grants->HasAPIPermission("history"));
+  }
+
+  void ResetCompletedRequest() {
+    if (function_) {
+      CHECK(response_ && response_->has_response());
+    }
+    function_.reset();
+    response_.reset();
+    dispatcher_.reset();
+    dialog_.Reset();
+    sender_.reset();
+  }
+
+  void TearDownOnMainThread() override {
+    if (function_ && !response_->has_response()) {
+      // A failed assertion may precede asynchronous icon/modal creation. Keep
+      // the real function and observer alive until its dialog can be dismissed
+      // or it has independently completed; never leak it into the next test.
+      CHECK(base::test::RunUntil([&] {
+        CaptureDialog();
+        return !dialog_.is_null() || response_->has_response();
+      }));
+      if (!response_->has_response()) {
+        android_test::DismissInstallDialogForTesting(
+            base::android::AttachCurrentThread(), dialog_);
+        CHECK(base::test::RunUntil([&] { return response_->has_response(); }));
+      }
+    }
+    ResetCompletedRequest();
+    auto_confirm_.reset();
+    b_.reset();
+    original_grants_.reset();
+    ExtensionManagementApiBrowserTest::TearDownOnMainThread();
+  }
+
+  TestExtensionDir extension_dir_;
+  ExtensionId id_;
+  base::FilePath c_path_;
+  scoped_refptr<const Extension> b_;
+  std::unique_ptr<PermissionSet> original_grants_;
+  std::unique_ptr<ScopedTestDialogAutoConfirm> auto_confirm_;
+  base::WeakPtr<content::WebContents> sender_;
+  std::unique_ptr<ExtensionFunctionDispatcher> dispatcher_;
+  scoped_refptr<ManagementSetEnabledFunction> function_;
+  std::unique_ptr<api_test_utils::SendResponseHelper> response_;
+  base::android::ScopedJavaGlobalRef<jobject> dialog_;
+};
+
+IN_PROC_BROWSER_TEST_F(ExtensionManagementReenableConsentTest,
+                       SignedReplacementRequiresFreshConsent) {
+  ASSERT_NO_FATAL_FAILURE(BeginEnable());
+  const auto b_messages = PromptPermissions();
+  for (const auto& warning : b_->permissions_data()->GetPermissionMessages()) {
+    EXPECT_NE(b_messages.end(),
+              std::ranges::find(b_messages, warning.message()));
+  }
+
+  ASSERT_FALSE(UpdateExtension(id_, c_path_, 0));
+  scoped_refptr<const Extension> c =
+      extension_registry()->disabled_extensions().GetByID(id_);
+  ASSERT_TRUE(c);
+  ASSERT_NE(b_.get(), c.get());
+  ASSERT_EQ(id_, c->id());
+  ASSERT_EQ("3", c->version().GetString());
+  ASSERT_TRUE(
+      ExtensionPrefs::Get(profile())->DidExtensionEscalatePermissions(id_));
+  ASSERT_NO_FATAL_FAILURE(ExpectOriginalGrants());
+  EXPECT_EQ(b_messages, PromptPermissions());
+  std::vector<std::u16string> c_only_messages;
+  for (const auto& warning : c->permissions_data()->GetPermissionMessages()) {
+    if (std::ranges::find(b_messages, warning.message()) == b_messages.end()) {
+      c_only_messages.push_back(warning.message());
+    }
+  }
+  ASSERT_FALSE(c_only_messages.empty());
+  // The pending prompt actually displays B's warnings, not the added C grant.
+  for (const auto& warning : c_only_messages) {
+    EXPECT_EQ(b_messages.end(), std::ranges::find(b_messages, warning));
+  }
+
+  ASSERT_NO_FATAL_FAILURE(CompletePrompt(true));
+  EXPECT_FALSE(response_->GetResponse());
+  EXPECT_EQ(keys::kUserDidNotReEnableError, function_->GetError());
+  EXPECT_EQ(c.get(), extension_registry()->disabled_extensions().GetByID(id_));
+  EXPECT_FALSE(extension_registry()->enabled_extensions().Contains(id_));
+  ASSERT_NO_FATAL_FAILURE(ExpectOriginalGrants());
+
+  ASSERT_NO_FATAL_FAILURE(BeginEnable());
+  const auto c_messages = PromptPermissions();
+  for (const auto& warning : c_only_messages) {
+    EXPECT_NE(c_messages.end(), std::ranges::find(c_messages, warning));
+  }
+  ASSERT_NO_FATAL_FAILURE(CompletePrompt(true));
+  EXPECT_TRUE(response_->GetResponse());
+  EXPECT_EQ(c.get(), extension_registry()->enabled_extensions().GetByID(id_));
+  auto grants = ExtensionPrefs::Get(profile())->GetGrantedPermissions(id_);
+  ASSERT_TRUE(grants);
+  EXPECT_TRUE(grants->HasAPIPermission("bookmarks"));
+  EXPECT_TRUE(grants->HasAPIPermission("history"));
+}
+
+IN_PROC_BROWSER_TEST_F(ExtensionManagementReenableConsentTest,
+                       UnchangedSignedUpdateAcceptanceEnables) {
+  ASSERT_NO_FATAL_FAILURE(BeginEnable());
+  ASSERT_NO_FATAL_FAILURE(CompletePrompt(true));
+  EXPECT_TRUE(response_->GetResponse());
+  EXPECT_EQ(b_.get(), extension_registry()->enabled_extensions().GetByID(id_));
+  auto grants = ExtensionPrefs::Get(profile())->GetGrantedPermissions(id_);
+  ASSERT_TRUE(grants);
+  EXPECT_TRUE(grants->HasAPIPermission("bookmarks"));
+  EXPECT_FALSE(grants->HasAPIPermission("history"));
+}
+
+IN_PROC_BROWSER_TEST_F(ExtensionManagementReenableConsentTest,
+                       UnchangedSignedUpdateCancellationPreservesGrants) {
+  ASSERT_NO_FATAL_FAILURE(BeginEnable());
+  ASSERT_NO_FATAL_FAILURE(CompletePrompt(false));
+  EXPECT_FALSE(response_->GetResponse());
+  EXPECT_EQ(keys::kUserDidNotReEnableError, function_->GetError());
+  EXPECT_EQ(b_.get(), extension_registry()->disabled_extensions().GetByID(id_));
+  EXPECT_FALSE(extension_registry()->enabled_extensions().Contains(id_));
+  ASSERT_NO_FATAL_FAILURE(ExpectOriginalGrants());
+}
