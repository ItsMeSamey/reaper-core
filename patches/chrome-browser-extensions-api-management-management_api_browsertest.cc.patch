+// Exercise the separate CrxInstaller re-enable path used by a signed CRX
+// dropped into chrome://extensions. ManagementSetEnabledFunction is not the
+// owner of this prompt, so its consent-instance guard cannot protect it.
+class ExtensionSettingsUpdateReenableConsentTest
+    : public ExtensionManagementReenableConsentTest {
+ protected:
+  void BeginSettingsUpdate() {
+    ResetCompletedRequest();
+    ASSERT_TRUE(GetActiveWebContents());
+    sender_ = GetActiveWebContents()->GetWeakPtr();
+    const base::FilePath b_path = PackVersion("2", R"("bookmarks")");
+    ASSERT_FALSE(b_path.empty());
+    auto prompt = std::make_unique<ExtensionInstallPrompt>(
+        sender_.get(), std::make_unique<InstallPromptData>(
+                           InstallPromptData::UNSET_PROMPT_TYPE));
+    installer_ = CrxInstaller::Create(profile(), std::move(prompt));
+    installer_->set_error_on_unsupported_requirements(true);
+    installer_->set_off_store_install_allow_reason(
+        CrxInstaller::OffStoreInstallAllowedFromSettingsPage);
+    installer_->set_install_immediately(true);
+    installer_->AddInstallerCallback(base::BindOnce(
+        [](ExtensionSettingsUpdateReenableConsentTest* self,
+           const std::optional<CrxInstallError>& error) {
+          self->install_finished_ = true;
+          self->install_failed_ = error.has_value();
+        },
+        base::Unretained(this)));
+    settings_prompt_pending_ = true;
+    installer_->InstallCrx(b_path);
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      CaptureDialog();
+      return install_finished_ && (install_failed_ || !dialog_.is_null());
+    }));
+    ASSERT_FALSE(install_failed_);
+    ASSERT_FALSE(dialog_.is_null());
+    b_ = extension_registry()->disabled_extensions().GetByID(id_);
+    ASSERT_TRUE(b_);
+    ASSERT_EQ(installer_->extension(), b_.get());
+    ASSERT_EQ("2", b_->version().GetString());
+    ASSERT_FALSE(PromptPermissions().empty());
+    ASSERT_NO_FATAL_FAILURE(ExpectOriginalGrants());
+  }
+
+  void CompleteSettingsPrompt(bool accept) {
+    ASSERT_TRUE(android_test::ClickInstallDialogForTesting(
+        base::android::AttachCurrentThread(), dialog_, accept));
+    settings_prompt_pending_ = false;
+    base::RunLoop().RunUntilIdle();
+  }
+
+  void TearDownOnMainThread() override {
+    if (settings_prompt_pending_) {
+      CHECK(base::test::RunUntil([&] {
+        CaptureDialog();
+        return install_finished_ && (install_failed_ || !dialog_.is_null());
+      }));
+      if (!dialog_.is_null()) {
+        android_test::DismissInstallDialogForTesting(
+            base::android::AttachCurrentThread(), dialog_);
+      }
+    }
+    installer_.reset();
+    ExtensionManagementReenableConsentTest::TearDownOnMainThread();
+  }
+
+  scoped_refptr<CrxInstaller> installer_;
+  bool install_finished_ = false;
+  bool install_failed_ = false;
+  bool settings_prompt_pending_ = false;
+};
+
+IN_PROC_BROWSER_TEST_F(ExtensionSettingsUpdateReenableConsentTest,
+                       SignedReplacementRequiresFreshConsent) {
+  ASSERT_NO_FATAL_FAILURE(BeginSettingsUpdate());
+  const auto b_messages = PromptPermissions();
+  for (const auto& warning : b_->permissions_data()->GetPermissionMessages()) {
+    EXPECT_NE(b_messages.end(),
+              std::ranges::find(b_messages, warning.message()));
+  }
+  ASSERT_FALSE(UpdateExtension(id_, c_path_, 0));
+  scoped_refptr<const Extension> c =
+      extension_registry()->disabled_extensions().GetByID(id_);
+  ASSERT_TRUE(c);
+  ASSERT_NE(b_.get(), c.get());
+  ASSERT_EQ("3", c->version().GetString());
+  ASSERT_TRUE(
+      ExtensionPrefs::Get(profile())->DidExtensionEscalatePermissions(id_));
+  ASSERT_NO_FATAL_FAILURE(ExpectOriginalGrants());
+  EXPECT_EQ(b_messages, PromptPermissions());
+  std::vector<std::u16string> c_only_messages;
+  for (const auto& warning : c->permissions_data()->GetPermissionMessages()) {
+    if (std::ranges::find(b_messages, warning.message()) == b_messages.end()) {
+      c_only_messages.push_back(warning.message());
+    }
+  }
+  ASSERT_FALSE(c_only_messages.empty());
+  ASSERT_NO_FATAL_FAILURE(CompleteSettingsPrompt(true));
+  EXPECT_EQ(c.get(), extension_registry()->disabled_extensions().GetByID(id_));
+  EXPECT_FALSE(extension_registry()->enabled_extensions().Contains(id_));
+  ASSERT_NO_FATAL_FAILURE(ExpectOriginalGrants());
+
+  // A fresh prompt for C still works through the ordinary management UI.
+  ASSERT_NO_FATAL_FAILURE(BeginEnable());
+  const auto c_messages = PromptPermissions();
+  for (const auto& warning : c_only_messages) {
+    EXPECT_NE(c_messages.end(), std::ranges::find(c_messages, warning));
+  }
+  ASSERT_NO_FATAL_FAILURE(CompletePrompt(true));
+  EXPECT_TRUE(response_->GetResponse());
+  EXPECT_EQ(c.get(), extension_registry()->enabled_extensions().GetByID(id_));
+  auto grants = ExtensionPrefs::Get(profile())->GetGrantedPermissions(id_);
+  ASSERT_TRUE(grants);
+  EXPECT_TRUE(grants->HasAPIPermission("bookmarks"));
+  EXPECT_TRUE(grants->HasAPIPermission("history"));
+}
