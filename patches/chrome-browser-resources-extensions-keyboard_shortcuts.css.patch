diff --git a/chrome/browser/resources/extensions/keyboard_shortcuts.css b/chrome/browser/resources/extensions/keyboard_shortcuts.css
--- a/chrome/browser/resources/extensions/keyboard_shortcuts.css
+++ b/chrome/browser/resources/extensions/keyboard_shortcuts.css
@@ -19,6 +19,9 @@
   border-radius: var(--cr-card-border-radius);
   box-shadow: var(--cr-card-shadow);
   color: var(--cr-primary-text-color);
+<if expr="is_android">
+  container-type: inline-size;
+</if>
   margin: 0 auto 16px auto;
   padding-bottom: 8px;
   width: var(--cr-toolbar-field-width);
@@ -103,3 +106,51 @@
   margin-inline-end: 20px;
   margin-inline-start: 60px;
 }
+
+<if expr="is_android">
+.card-title span,
+.command-name,
+.shortcut-input-label,
+.shortcut-scope-label {
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+
+@container (width > 600px) {
+  .shortcut-input-container,
+  .shortcut-scope-container {
+    /* Long labels must not consume the command's share of the row. */
+    flex-basis: min-content;
+  }
+}
+
+@container (max-width: 600px) {
+  .card-controls {
+    margin-inline: 16px;
+  }
+
+  .icon {
+    flex-shrink: 0;
+  }
+
+  .command-entry {
+    align-items: stretch;
+    flex-direction: column;
+    gap: 12px;
+  }
+
+  .command-name,
+  .shortcut-input-container {
+    margin-inline-end: 0;
+  }
+
+  .shortcut-input-container,
+  .shortcut-scope-container {
+    min-width: 0;
+  }
+
+  .shortcut-scope-container {
+    --md-select-width: 100%;
+  }
+}
+</if>
