+
+TEST_F(DownloadOfflineContentProviderTest,
+       DisabledDuringProgressStillCompletes) {
+  auto* service = DownloadCoreServiceFactory::GetForBrowserContext(&profile_);
+  const std::string guid = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  auto item = CreateMockDownloadItem(guid);
+  ScopedMockObserver observer{&provider_};
+  EXPECT_CALL(observer, OnItemRemoved(_)).Times(0);
+  EXPECT_CALL(observer,
+              OnItemUpdated(
+                  Field(&OfflineItem::state, OfflineItemState::IN_PROGRESS), _))
+      .Times(1);
+  InitializeDownloads(true);
+  provider_.OnDownloadStarted(item.get());
+  RunUntilMainThreadIdle();
+
+  service->SetDownloadUiEnabledForTest(false);
+  ON_CALL(*item, GetState()).WillByDefault(Return(DownloadItem::COMPLETE));
+  EXPECT_CALL(
+      observer,
+      OnItemUpdated(Field(&OfflineItem::state, OfflineItemState::COMPLETE),
+                    Optional(Field(&UpdateDelta::state_changed, true))))
+      .Times(1);
+  item->NotifyObserversDownloadUpdated();
+  RunUntilMainThreadIdle();
+
+  // Terminal cleanup must detach the provider from the real observer list.
+  item->NotifyObserversDownloadUpdated();
+  RunUntilMainThreadIdle();
+}
+
+TEST_F(DownloadOfflineContentProviderTest, DisabledDuringProgressStillCancels) {
+  auto* service = DownloadCoreServiceFactory::GetForBrowserContext(&profile_);
+  const std::string guid = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  auto item = CreateMockDownloadItem(guid);
+  ScopedMockObserver observer{&provider_};
+  EXPECT_CALL(observer, OnItemRemoved(_)).Times(0);
+  EXPECT_CALL(observer,
+              OnItemUpdated(
+                  Field(&OfflineItem::state, OfflineItemState::IN_PROGRESS), _))
+      .Times(1);
+  InitializeDownloads(true);
+  provider_.OnDownloadStarted(item.get());
+  RunUntilMainThreadIdle();
+
+  service->SetDownloadUiEnabledForTest(false);
+  ON_CALL(*item, GetState()).WillByDefault(Return(DownloadItem::CANCELLED));
+  EXPECT_CALL(
+      observer,
+      OnItemUpdated(Field(&OfflineItem::state, OfflineItemState::CANCELLED),
+                    Optional(Field(&UpdateDelta::state_changed, true))))
+      .Times(1);
+  item->NotifyObserversDownloadUpdated();
+  RunUntilMainThreadIdle();
+
+  // Terminal cleanup must detach the provider from the real observer list.
+  item->NotifyObserversDownloadUpdated();
   RunUntilMainThreadIdle();
 }
 
