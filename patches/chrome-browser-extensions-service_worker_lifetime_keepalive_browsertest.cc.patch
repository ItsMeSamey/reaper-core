+IN_PROC_BROWSER_TEST_F(ServiceWorkerLifetimeKeepaliveBrowsertest,
+                       DebuggerMetadataRetiresBeforeLateDetach) {
+  TestExtensionDir test_dir;
+  test_dir.WriteManifest(R"({
+    "name": "Debugger accounting",
+    "manifest_version": 3,
+    "version": "1.0",
+    "permissions": ["debugger", "tabs"],
+    "background": {"service_worker": "background.js"}
+  })");
+  test_dir.WriteFile(FILE_PATH_LITERAL("background.js"), R"(
+    async function attach() {
+      const [tab] =
+          await chrome.tabs.query({active: true, currentWindow: true});
+      await chrome.debugger.attach({tabId: tab.id}, '1.3');
+      chrome.test.sendScriptResult('attached');
+    }
+    async function detach() {
+      const [tab] =
+          await chrome.tabs.query({active: true, currentWindow: true});
+      await chrome.debugger.detach({tabId: tab.id});
+      chrome.test.sendScriptResult('detached');
+    }
+  )");
+  const Extension* extension = LoadExtension(test_dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+  ASSERT_TRUE(NavigateToURL(GetActiveWebContents(), GURL("about:blank")));
+  EXPECT_EQ("attached", BackgroundScriptExecutor::ExecuteScript(
+                            profile(), extension->id(), "attach();",
+                            BackgroundScriptExecutor::ResultCapture::
+                                kSendScriptResult));
+  base::RunLoop().RunUntilIdle();
+  ProcessManager* pm = ProcessManager::Get(profile());
+  const auto original_workers =
+      pm->GetServiceWorkersForExtension(extension->id());
+  ASSERT_EQ(1u, original_workers.size());
+  auto records = pm->GetServiceWorkerKeepaliveDataForRecords(extension->id());
+  ASSERT_EQ(1u, records.size());
+  EXPECT_EQ(Activity::DEBUGGER, records[0].activity_type);
+  EXPECT_TRUE(records[0].worker_id.start_token ==
+              original_workers[0].start_token);
+
+  browsertest_util::StopServiceWorkerForExtensionGlobalScope(profile(),
+                                                            extension->id());
+  EXPECT_TRUE(
+      pm->GetServiceWorkerKeepaliveDataForRecords(extension->id()).empty());
+  EXPECT_EQ("restarted", BackgroundScriptExecutor::ExecuteScript(
+                             profile(), extension->id(),
+                             "chrome.test.sendScriptResult('restarted');",
+                             BackgroundScriptExecutor::ResultCapture::
+                                 kSendScriptResult));
+  base::RunLoop().RunUntilIdle();
+  const auto new_workers = pm->GetServiceWorkersForExtension(extension->id());
+  ASSERT_EQ(1u, new_workers.size());
+  EXPECT_TRUE(new_workers[0].start_token != original_workers[0].start_token);
+  ServiceWorkerKeepalive new_owner(
+      profile(), new_workers[0],
+      content::ServiceWorkerExternalRequestTimeoutType::kDefault,
+      Activity::EVENT, "new debugger incarnation");
+  EXPECT_EQ("detached", BackgroundScriptExecutor::ExecuteScript(
+                            profile(), extension->id(), "detach();",
+                            BackgroundScriptExecutor::ResultCapture::
+                                kSendScriptResult));
+  base::RunLoop().RunUntilIdle();
+  records = pm->GetServiceWorkerKeepaliveDataForRecords(extension->id());
+  ASSERT_EQ(1u, records.size());
+  EXPECT_EQ("new debugger incarnation", records[0].extra_data);
+  EXPECT_TRUE(records[0].worker_id.start_token == new_workers[0].start_token);
+}
