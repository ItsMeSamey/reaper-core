+#if BUILDFLAG(IS_ANDROID)
+  void CheckOAuthRequestKeepalive(bool interactive) {
+    TestExtensionDir test_dir;
+    test_dir.WriteManifest(R"({
+      "name": "Pending OAuth worker request",
+      "manifest_version": 3,
+      "version": "1.0",
+      "permissions": ["identity"],
+      "oauth2": {"client_id": "test.apps.googleusercontent.com",
+                 "scopes": ["email"]},
+      "background": {"service_worker": "background.js"}
+    })");
+    test_dir.WriteFile(FILE_PATH_LITERAL("background.js"), "// blank");
+    TestServiceWorkerContextObserver registration_observer(profile());
+    const Extension* extension = LoadExtension(test_dir.UnpackedPath());
+    ASSERT_TRUE(extension);
+    const int64_t version_id = registration_observer.WaitForWorkerActivated();
+
+    auto& registry = ExtensionFunctionRegistry::GetInstance();
+    const auto original =
+        registry.GetFactoriesForTesting().at("identity.getAuthToken");
+    ASSERT_TRUE(registry.OverrideFunctionForTesting(
+        "identity.getAuthToken",
+        &NewExtensionFunction<PendingGetAuthTokenFunction>));
+    base::ScopedClosureRunner restore_factory(base::BindOnce(
+        [](ExtensionFunctionRegistry::FactoryEntry entry) {
+          ExtensionFunctionRegistry::GetInstance().Register(entry);
+        },
+        original));
+    base::test::TestFuture<scoped_refptr<PendingGetAuthTokenFunction>> pending;
+    auto callback = pending.GetCallback();
+    base::AutoReset<PendingOAuthCallback*> reset_callback(
+        &g_pending_oauth_callback, &callback);
+    const std::string script =
+        base::StringPrintf(R"(
+      chrome.test.runWithUserGesture(() => {
+        chrome.identity.getAuthToken({interactive: %s}).then(
+          () => chrome.test.sendMessage('unexpected success'),
+          error => {
+            chrome.test.assertEq('Test consent completed', error.message);
+            chrome.test.sendMessage('consent completed');
+          });
+        chrome.test.sendScriptResult('started');
+      });)",
+                           interactive ? "true" : "false");
+    EXPECT_EQ("started",
+              BackgroundScriptExecutor::ExecuteScript(
+                  profile(), extension->id(), script,
+                  BackgroundScriptExecutor::ResultCapture::kSendScriptResult));
+    ASSERT_TRUE(pending.Wait());
+    auto function = pending.Take();
+    base::ScopedClosureRunner resolve_on_failure(base::BindOnce(
+        [](scoped_refptr<PendingGetAuthTokenFunction> request) {
+          if (!request->did_respond()) {
+            request->CompleteForTest();
+          }
+        },
+        function));
+    base::RunLoop().RunUntilIdle();
+    content::ServiceWorkerContext* context = GetServiceWorkerContext();
+    TestServiceWorkerContextObserver stopped(context, extension->id());
+    stopped.SetRunningId(version_id);
+    content::AdvanceClockAfterRequestTimeout(context, version_id,
+                                             &tick_clock_opener_);
+    if (interactive) {
+      ASSERT_TRUE(
+          content::TriggerTimeoutAndCheckRunningState(context, version_id));
+      ExtensionTestMessageListener completed("consent completed");
+      function->CompleteForTest();
+      ASSERT_TRUE(completed.WaitUntilSatisfied());
+      resolve_on_failure.RunAndReset();
+      function.reset();
+      base::RunLoop().RunUntilIdle();
+      // Finishing the actual API response releases the request keepalive.
+      content::AdvanceClockAfterRequestTimeout(context, version_id,
+                                               &tick_clock_opener_);
+      ASSERT_FALSE(
+          content::TriggerTimeoutAndCheckRunningState(context, version_id));
+      stopped.WaitForWorkerStopped();
+    } else {
+      ASSERT_FALSE(
+          content::TriggerTimeoutAndCheckRunningState(context, version_id));
+      stopped.WaitForWorkerStopped();
+      // An ordinary timed-out request must still tolerate its late response.
+      function->CompleteForTest();
+      resolve_on_failure.RunAndReset();
+      function.reset();
+      base::RunLoop().RunUntilIdle();
+    }
+  }
+#endif
+
   base::SimpleTestTickClock tick_clock_opener_;
