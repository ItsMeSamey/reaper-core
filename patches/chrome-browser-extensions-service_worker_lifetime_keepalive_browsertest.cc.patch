+  const Extension* other = LoadExtension(other_dir.UnpackedPath());
+  ASSERT_TRUE(other);
+  EXPECT_EQ("running", BackgroundScriptExecutor::ExecuteScript(
+                           profile(), other->id(),
+                           "chrome.test.sendScriptResult('running');",
+                           BackgroundScriptExecutor::ResultCapture::
+                               kSendScriptResult));
+  base::RunLoop().RunUntilIdle();
+  auto other_workers = pm->GetServiceWorkersForExtension(other->id());
+  ASSERT_EQ(1u, other_workers.size());
+  ServiceWorkerKeepalive other_owner(
+      profile(), other_workers[0],
+      content::ServiceWorkerExternalRequestTimeoutType::kDefault,
+      Activity::EVENT, "other extension");
+
+  browsertest_util::StopServiceWorkerForExtensionGlobalScope(profile(),
+                                                            extension->id());
+  EXPECT_TRUE(
+      pm->GetServiceWorkerKeepaliveDataForRecords(extension->id()).empty());
+  EXPECT_EQ(1u,
+            pm->GetServiceWorkerKeepaliveDataForRecords(other->id()).size());
+  EXPECT_FALSE(pm->GetServiceWorkerRunningInstance(original_worker));
+
+  EXPECT_EQ("restarted", BackgroundScriptExecutor::ExecuteScript(
+                             profile(), extension->id(),
+                             "chrome.test.sendScriptResult('restarted');",
+                             BackgroundScriptExecutor::ResultCapture::
+                                 kSendScriptResult));
+  base::RunLoop().RunUntilIdle();
+  workers = pm->GetServiceWorkersForExtension(extension->id());
