+IN_PROC_BROWSER_TEST_F(ServiceWorkerLifetimeKeepaliveBrowsertest,
+                       MovedKeepaliveUsesOwningProfileShutdown) {
+  TestExtensionDir test_dir;
+  test_dir.WriteManifest(R"({
+    "name": "Moved profile accounting",
+    "manifest_version": 3,
+    "version": "1.0",
+    "incognito": "split",
+    "background": {"service_worker": "background.js"}
+  })");
+  test_dir.WriteFile(FILE_PATH_LITERAL("background.js"), "// blank");
+  const Extension* extension =
+      LoadExtension(test_dir.UnpackedPath(), {.allow_in_incognito = true});
+  ASSERT_TRUE(extension);
+  Profile* otr = profile()->GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  content::WebContents* otr_contents =
+      PlatformOpenURLOffTheRecord(profile(), GURL("about:blank"));
+  ASSERT_TRUE(otr_contents);
+  EXPECT_EQ("regular", BackgroundScriptExecutor::ExecuteScript(
+                           profile(), extension->id(),
+                           "chrome.test.sendScriptResult('regular');",
+                           BackgroundScriptExecutor::ResultCapture::
+                               kSendScriptResult));
+  EXPECT_EQ("otr", BackgroundScriptExecutor::ExecuteScript(
+                       otr, extension->id(),
+                       "chrome.test.sendScriptResult('otr');",
+                       BackgroundScriptExecutor::ResultCapture::
+                           kSendScriptResult));
+  base::RunLoop().RunUntilIdle();
+  ProcessManager* regular_pm = ProcessManager::Get(profile());
+  const auto regular_workers =
+      regular_pm->GetServiceWorkersForExtension(extension->id());
+  const auto otr_workers =
+      ProcessManager::Get(otr)->GetServiceWorkersForExtension(extension->id());
+  ASSERT_EQ(1u, regular_workers.size());
+  ASSERT_EQ(1u, otr_workers.size());
+  ServiceWorkerKeepalive regular_owner(
+      profile(), regular_workers[0],
+      content::ServiceWorkerExternalRequestTimeoutType::kDefault,
+      Activity::EVENT, "regular profile");
+  std::optional<ServiceWorkerKeepalive> moved_owner;
+  {
+    ServiceWorkerKeepalive original(
+        otr, otr_workers[0],
+        content::ServiceWorkerExternalRequestTimeoutType::kDefault,
+        Activity::EVENT, "off the record profile");
+    moved_owner.emplace(std::move(original));
+  }
+  EXPECT_EQ(1u, ProcessManager::Get(otr)
+                    ->GetServiceWorkerKeepaliveDataForRecords(extension->id())
+                    .size());
+  ProfileDestructionWaiter waiter(otr);
+  CloseTabForWebContents(otr_contents);
+  waiter.Wait();
+  base::RunLoop().RunUntilIdle();
+  // The moved destination's shutdown subscription must have nulled its context.
+  moved_owner.reset();
+  const auto records =
+      regular_pm->GetServiceWorkerKeepaliveDataForRecords(extension->id());
+  ASSERT_EQ(1u, records.size());
+  EXPECT_EQ("regular profile", records[0].extra_data);
+  EXPECT_TRUE(records[0].worker_id.start_token ==
+              regular_workers[0].start_token);
+}
