+// Substitutes a pending API body without contacting an OAuth provider.
+// Dispatch, API arguments, worker identity and the inherited production
+// keepalive policy remain real.
+class PendingGetAuthTokenFunction : public IdentityGetAuthTokenFunction {
+ public:
+  void CompleteForTest() { Respond(Error("Test consent completed")); }
+
+ private:
+  ~PendingGetAuthTokenFunction() override = default;
+
+  ResponseAction Run() override {
+    CHECK(is_from_service_worker());
+    CHECK(g_pending_oauth_callback);
+    CHECK(*g_pending_oauth_callback);
+    std::move(*g_pending_oauth_callback).Run(base::WrapRefCounted(this));
+    return RespondLater();
+  }
+};
