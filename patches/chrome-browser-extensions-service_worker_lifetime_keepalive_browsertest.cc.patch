+  const Extension* extension = LoadExtension(test_dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+  EXPECT_EQ("running", BackgroundScriptExecutor::ExecuteScript(
+                           profile(), extension->id(),
+                           "chrome.test.sendScriptResult('running');",
+                           BackgroundScriptExecutor::ResultCapture::
+                               kSendScriptResult));
+  base::RunLoop().RunUntilIdle();
+  ProcessManager* pm = ProcessManager::Get(profile());
+  auto workers = pm->GetServiceWorkersForExtension(extension->id());
+  ASSERT_EQ(1u, workers.size());
+  const WorkerId original_worker = workers[0];
+  ASSERT_TRUE(original_worker.start_token);
+  WorkerId tokenless_worker = original_worker;
+  tokenless_worker.start_token.reset();
+  std::optional<ServiceWorkerKeepalive> old_owner;
+  {
+    ServiceWorkerKeepalive original(
+        profile(), tokenless_worker,
+        content::ServiceWorkerExternalRequestTimeoutType::kDefault,
+        Activity::API_FUNCTION, "ordinary accounting");
+    EXPECT_TRUE(original.worker_id().start_token ==
+                original_worker.start_token);
+    old_owner.emplace(std::move(original));
+  }
+  EXPECT_EQ(1u, pm->GetServiceWorkerKeepaliveDataForRecords(extension->id())
+                    .size());
+
+  TestExtensionDir other_dir;
+  other_dir.WriteManifest(R"({
