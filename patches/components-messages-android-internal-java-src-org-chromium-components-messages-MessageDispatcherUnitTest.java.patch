+    @Test
+    public void testProviderObserverRunsAfterRealAssociation() {
+        WindowAndroid window = mock(WindowAndroid.class);
+        UnownedUserDataHost host = new UnownedUserDataHost();
+        doReturn(host).when(window).getUnownedUserDataHost();
+        MessageDispatcherProvider.Unowned dispatcher =
+                mock(MessageDispatcherProvider.Unowned.class);
+        AtomicInteger count = new AtomicInteger();
+        Runnable observer =
+                () -> {
+                    Assert.assertSame(dispatcher, MessageDispatcherProvider.from(window));
+                    count.incrementAndGet();
+                };
+        MessageDispatcherProvider.addObserver(observer);
+        try {
+            Assert.assertNull(MessageDispatcherProvider.from(window));
+            MessageDispatcherProvider.attach(window, dispatcher);
+            Assert.assertEquals(1, count.get());
+        } finally {
+            MessageDispatcherProvider.removeObserver(observer);
+            MessageDispatcherProvider.detach(dispatcher);
+            Shadows.shadowOf(Looper.getMainLooper()).idle();
+        }
+    }
+
+    @Test
+    public void testProviderDetachNotifiesOnlyRemainingObserver() {
+        WindowAndroid window = mock(WindowAndroid.class);
+        UnownedUserDataHost host = new UnownedUserDataHost();
+        doReturn(host).when(window).getUnownedUserDataHost();
+        MessageDispatcherProvider.Unowned dispatcher =
+                mock(MessageDispatcherProvider.Unowned.class);
+        AtomicInteger firstCount = new AtomicInteger();
+        AtomicInteger secondCount = new AtomicInteger();
+        Runnable first = firstCount::incrementAndGet;
+        Runnable second = secondCount::incrementAndGet;
+        MessageDispatcherProvider.addObserver(first);
+        MessageDispatcherProvider.addObserver(second);
+        try {
+            MessageDispatcherProvider.attach(window, dispatcher);
+            MessageDispatcherProvider.removeObserver(first);
+            MessageDispatcherProvider.detach(dispatcher);
+            Assert.assertNull(MessageDispatcherProvider.from(window));
+            Shadows.shadowOf(Looper.getMainLooper()).idle();
+            Assert.assertEquals(1, firstCount.get());
+            Assert.assertEquals(2, secondCount.get());
+        } finally {
+            MessageDispatcherProvider.removeObserver(first);
+            MessageDispatcherProvider.removeObserver(second);
+            MessageDispatcherProvider.detach(dispatcher);
+            Shadows.shadowOf(Looper.getMainLooper()).idle();
+        }
+    }
