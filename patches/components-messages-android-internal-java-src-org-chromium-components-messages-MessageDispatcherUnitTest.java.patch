+    @Test
+    public void testProviderReplacementReportsCurrentAssociation() {
+        WindowAndroid window = mock(WindowAndroid.class);
+        UnownedUserDataHost host = new UnownedUserDataHost();
+        doReturn(host).when(window).getUnownedUserDataHost();
+        MessageDispatcherProvider.Unowned first = mock(MessageDispatcherProvider.Unowned.class);
+        MessageDispatcherProvider.Unowned second = mock(MessageDispatcherProvider.Unowned.class);
+        MessageDispatcherProvider.attach(window, first);
+        Assert.assertSame(first, MessageDispatcherProvider.from(window));
+        try {
+            MessageDispatcherProvider.attach(window, second);
+            Assert.assertSame(second, MessageDispatcherProvider.from(window));
