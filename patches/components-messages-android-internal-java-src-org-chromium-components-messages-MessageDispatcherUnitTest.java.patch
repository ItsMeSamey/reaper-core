+            Assert.assertSame(second, MessageDispatcherProvider.from(window));
+        } finally {
+            MessageDispatcherProvider.detach(first);
+            MessageDispatcherProvider.detach(second);
+            Shadows.shadowOf(Looper.getMainLooper()).idle();
+        }
+    }
