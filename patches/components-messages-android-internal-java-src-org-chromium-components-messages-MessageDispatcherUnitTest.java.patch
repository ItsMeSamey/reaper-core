+    @Test
+    public void testWindowQueueReportsActualDispatcherAcceptance() {
+        WindowAndroid window = mock(WindowAndroid.class);
+        UnownedUserDataHost host = new UnownedUserDataHost();
+        doReturn(host).when(window).getUnownedUserDataHost();
+        MessageWrapper message = MessageWrapper.create(0, MessageIdentifier.TEST_MESSAGE);
+        PropertyModel model = message.getMessageProperties();
+        MessageDispatcherProvider.Unowned dispatcher =
+                mock(MessageDispatcherProvider.Unowned.class);
+        Assert.assertFalse(
+                MessageDispatcherBridge.enqueueWindowScopedMessage(message, window, true));
+        MessageDispatcherProvider.attach(window, dispatcher);
+        try {
+            Assert.assertTrue(
+                    MessageDispatcherBridge.enqueueWindowScopedMessage(message, window, true));
+            verify(dispatcher).enqueueWindowScopedMessage(model, true);
+        } finally {
+            MessageDispatcherProvider.detach(dispatcher);
+            Shadows.shadowOf(Looper.getMainLooper()).idle();
+        }
+        Assert.assertFalse(
+                MessageDispatcherBridge.enqueueWindowScopedMessage(message, window, true));
+    }
