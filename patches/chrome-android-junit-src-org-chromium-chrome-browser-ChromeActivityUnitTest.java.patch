+    @Test
+    public void testRestoredPickerReportsLostCallbackAndAllowsFreshRetry() {
+        ToastManager.resetForTesting();
+        ShadowToast.reset();
+        TestChromeActivity chromeActivity = new TestChromeActivity();
+        IntentRequestTracker.Delegate delegate = mock(IntentRequestTracker.Delegate.class);
+        when(delegate.startActivityForResult(any(), anyInt())).thenReturn(true);
+        when(delegate.onCallbackNotFoundError(any()))
+                .thenAnswer(
+                        invocation ->
+                                chromeActivity.onIntentCallbackNotFoundError(
+                                        invocation.getArgument(0)));
+        IntentRequestTracker original = IntentRequestTracker.createFromDelegate(delegate);
+        WindowAndroid.IntentCallback lostCallback = mock(WindowAndroid.IntentCallback.class);
+        int requestCode =
+                original.showCancelableIntent(
+                        new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE),
+                        lostCallback,
+                        org.chromium.ui.R.string.low_memory_error);
+        assertTrue(requestCode >= 0);
+        Bundle savedState = new Bundle();
+        original.saveInstanceState(savedState);
+
+        // Recreate only the real tracker from saved state. It intentionally
+        // restores error text, never the dead caller's callback or native work.
+        IntentRequestTracker restored = IntentRequestTracker.createFromDelegate(delegate);
+        restored.restoreInstanceState(savedState);
+        Intent abandonedResult =
+                new Intent().setData(Uri.parse("content://picker.test/tree/abandoned"));
+        assertFalse(restored.onActivityResult(requestCode, Activity.RESULT_OK, abandonedResult));
+        verify(lostCallback, never()).onIntentCompleted(anyInt(), any());
+        android.widget.Toast errorToast = ShadowToast.getLatestToast();
+        assertNotNull(errorToast);
+        assertNotNull(errorToast.getView());
+        TextView errorText = errorToast.getView().findViewById(org.chromium.ui.R.id.toast_text);
+        assertNotNull(errorText);
+        assertEquals(
+                mActivity.getString(org.chromium.ui.R.string.low_memory_error),
+                errorText.getText().toString());
+
+        // Only a new explicit request gets a fresh callback. Cancellation is
+        // delivered to that callback; no abandoned URI or install is replayed.
+        ToastManager.resetForTesting();
+        ShadowToast.reset();
+        WindowAndroid.IntentCallback retryCallback = mock(WindowAndroid.IntentCallback.class);
+        int retryRequestCode =
+                restored.showCancelableIntent(
+                        new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE),
+                        retryCallback,
+                        org.chromium.ui.R.string.low_memory_error);
+        assertTrue(retryRequestCode >= 0);
+        assertTrue(restored.onActivityResult(retryRequestCode, Activity.RESULT_CANCELED, null));
+        verify(retryCallback).onIntentCompleted(Activity.RESULT_CANCELED, null);
+        verify(lostCallback, never()).onIntentCompleted(anyInt(), any());
+        assertNull(ShadowToast.getLatestToast());
+    }
