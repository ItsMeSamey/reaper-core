+#if BUILDFLAG(IS_ANDROID)
+using GcmAndroidDriverTest = ExtensionApiTest;
+
+IN_PROC_BROWSER_TEST_F(GcmAndroidDriverTest,
+                       UnsupportedSendCompletesAndReleasesId) {
+  auto* driver =
+      gcm::GCMProfileServiceFactory::GetForProfile(profile())->driver();
+  ASSERT_TRUE(driver);
+  gcm::OutgoingMessage message;
+  message.id = "unsupported-android-send";
+  message.data["payload"] = "test";
+  // A second request with the same ID must receive the backend error again,
+  // rather than INVALID_PARAMETER from a leaked in-flight callback.
+  for (int attempt = 0; attempt < 2; ++attempt) {
+    base::test::TestFuture<std::string, gcm::GCMClient::Result> result;
+    driver->Send(
+        "test-extension", "destination-id", message,
+        result.GetCallback<const std::string&, gcm::GCMClient::Result>());
+    base::RunLoop().RunUntilIdle();
+    ASSERT_TRUE(result.IsReady());
+    EXPECT_EQ(message.id, result.Get<0>());
+    EXPECT_EQ(gcm::GCMClient::UNKNOWN_ERROR, result.Get<1>());
+  }
+}
+#endif  // BUILDFLAG(IS_ANDROID)
