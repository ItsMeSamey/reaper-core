+    @Test
+    @MediumTest
+    @Features.DisableFeatures(ChromeFeatureList.ANDROID_OPEN_INCOGNITO_AS_WINDOW)
+    public void regularStartCreatesDistinctModelScopedIncognitoController() {
+        mFreshCtaTransitTestRule.startOnBlankPage();
+        var activity = mFreshCtaTransitTestRule.getActivity();
+        var regularProfile = mFreshCtaTransitTestRule.getActivityTab().getProfile();
+        var regular = getExtensionWindowControllerBridge(activity.getTaskId(), regularProfile);
+        assertNotNull(regular);
+        // The actual user action creates the incognito model and its native window.
+        Tab incognitoTab = ThreadUtils.runOnUiThreadBlocking(() ->
+                activity.getTabCreator(true).createNewTab(new LoadUrlParams("about:blank"),
+                        TabLaunchType.FROM_CHROME_UI, null));
+        assertNotNull(incognitoTab);
+        var incognito = getExtensionWindowControllerBridge(
+                activity.getTaskId(), incognitoTab.getProfile());
+        assertNotNull(incognito);
+        ThreadUtils.runOnUiThreadBlocking(() -> {
+            var task = getChromeAndroidTask(activity.getTaskId());
+            assertNotNull(task);
+            var regularSession = task.getSessionIdForTesting(regularProfile);
+            assertNotNull(regularSession);
+            assertEquals(regularSession.intValue(), regular.getExtensionWindowIdForTesting());
+            var incognitoSession = task.getSessionIdForTesting(incognitoTab.getProfile());
+            assertNotNull(incognitoSession);
+            assertEquals(incognitoSession.intValue(), incognito.getExtensionWindowIdForTesting());
+            assertNotEquals(regular.getExtensionWindowIdForTesting(),
+                    incognito.getExtensionWindowIdForTesting());
+        });
+    }
