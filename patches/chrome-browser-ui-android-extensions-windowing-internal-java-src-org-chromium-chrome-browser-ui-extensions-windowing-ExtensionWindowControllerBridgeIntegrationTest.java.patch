+    @Test
+    @MediumTest
+    @Features.DisableFeatures(ChromeFeatureList.ANDROID_OPEN_INCOGNITO_AS_WINDOW)
+    public void lastIncognitoTabRemovalDestroysOnlyItsControllerAndRecreationGetsFreshId() {
+        mFreshCtaTransitTestRule.startOnBlankPage();
+        var activity = mFreshCtaTransitTestRule.getActivity();
+        var regularProfile = mFreshCtaTransitTestRule.getActivityTab().getProfile();
+        var regular = getExtensionWindowControllerBridge(activity.getTaskId(), regularProfile);
+        assertNotNull(regular);
+        Tab first = ThreadUtils.runOnUiThreadBlocking(() ->
+                activity.getTabCreator(true).createNewTab(new LoadUrlParams("about:blank"),
+                        TabLaunchType.FROM_CHROME_UI, null));
+        assertNotNull(first);
+        var incognito = getExtensionWindowControllerBridge(activity.getTaskId(), first.getProfile());
+        assertNotNull(incognito);
+        int firstId = ThreadUtils.runOnUiThreadBlocking(incognito::getExtensionWindowIdForTesting);
+        ThreadUtils.runOnUiThreadBlocking(IncognitoTabHostUtils::closeAllIncognitoTabs);
+        CriteriaHelper.pollUiThread(() -> incognito.getNativePtrForTesting() == 0);
+        assertEquals(regular, getExtensionWindowControllerBridge(activity.getTaskId(), regularProfile));
+        Tab next = ThreadUtils.runOnUiThreadBlocking(() ->
+                activity.getTabCreator(true).createNewTab(new LoadUrlParams("about:blank"),
+                        TabLaunchType.FROM_CHROME_UI, null));
+        assertNotNull(next);
+        var nextController = getExtensionWindowControllerBridge(activity.getTaskId(), next.getProfile());
+        assertNotNull(nextController);
+        ThreadUtils.runOnUiThreadBlocking(() -> {
+            assertNotEquals(firstId, nextController.getExtensionWindowIdForTesting());
+            assertTrue(regular.getNativePtrForTesting() != 0);
+        });
+        mFreshCtaTransitTestRule.finishActivity();
+        ThreadUtils.runOnUiThreadBlocking(() -> {
+            assertEquals(0, regular.getNativePtrForTesting());
+            assertEquals(0, nextController.getNativePtrForTesting());
+            // Late focus/bounds callbacks must remain harmless after native disposal.
+            nextController.onTaskFocusChanged(true);
+            nextController.onTaskBoundsChanged(0, new android.graphics.Rect(), new android.graphics.Rect());
+            assertEquals(0, nextController.getNativePtrForTesting());
+        });
+    }
