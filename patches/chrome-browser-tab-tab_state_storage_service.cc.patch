+#if BUILDFLAG(IS_ANDROID)
+void TabStateStorageService::GetPersistedContainerIds(
+    TabStateStorageBackend::OnContainerIds callback) {
+  if (open_batches_) {
+    // Do not destroy an active ScopedBatch or read a partial pending update.
+    // Batch callbacks run only after a successful commit. If this request is
+    // abandoned, release the caller's scan barrier without publishing inventory.
+    auto [on_committed, on_abandoned] =
+        base::SplitOnceCallback(std::move(callback));
+    base::ScopedClosureRunner unavailable(base::BindPostTaskToCurrentDefault(
+        base::BindOnce(
+            [](TabStateStorageBackend::OnContainerIds reply) {
+              std::move(reply).Run(std::nullopt);
+            },
+            std::move(on_abandoned))));
+    open_batches_->builder.AddCallback(base::BindPostTaskToCurrentDefault(
+        base::BindOnce(
+            [](base::WeakPtr<TabStateStorageService> service,
+               TabStateStorageBackend::OnContainerIds reply,
+               base::ScopedClosureRunner unavailable) {
+              if (!service) {
+                return;
+              }
+              unavailable.ReplaceClosure(base::OnceClosure());
+              service->GetPersistedContainerIds(std::move(reply));
+            },
+            weak_ptr_factory_.GetWeakPtr(), std::move(on_committed),
+            std::move(unavailable))));
+    return;
+  }
+  tab_backend_.GetPersistedContainerIds(std::move(callback));
+}
+#endif
