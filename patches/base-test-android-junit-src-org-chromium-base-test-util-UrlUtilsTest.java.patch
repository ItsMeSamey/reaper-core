+package org.chromium.base.test.util;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertThrows;
+
+import org.junit.After;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.annotation.Config;
+
+import org.chromium.base.PathUtils;
+import org.chromium.base.test.BaseRobolectricTestRunner;
+
+/** Tests the test launcher's shared-default and explicit-owned root contract. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(sdk = BaseRobolectricTestRunner.MIN_SDK)
+public class UrlUtilsTest {
+    @After
+    public void tearDown() {
+        UrlUtils.setIsolatedTestRootName(null);
+    }
+
+    @Test
+    public void defaultAndOwnedRootReachFileUrls() {
+        String external = PathUtils.getExternalStorageDirectory();
+        UrlUtils.setIsolatedTestRootName(null);
+        assertEquals(external + "/chromium_tests_root", UrlUtils.getIsolatedTestRoot());
+        UrlUtils.setIsolatedTestRootName("chromium_tests_root_owned_09");
+        assertEquals(external + "/chromium_tests_root_owned_09", UrlUtils.getIsolatedTestRoot());
+        assertEquals(
+                "file://" + external + "/chromium_tests_root_owned_09/chrome/test/data/title1.html",
+                UrlUtils.getTestFileUrl("title1.html"));
+        UrlUtils.setIsolatedTestRootName(null);
+        assertEquals(external + "/chromium_tests_root", UrlUtils.getIsolatedTestRoot());
+    }
+
+    @Test
+    public void invalidRootDoesNotChangeCurrentRoot() {
+        UrlUtils.setIsolatedTestRootName("chromium_tests_root_owned_09");
+        for (String name : new String[] {
+            "", "chromium_tests_root", "chromium_tests_root_",
+            "/sdcard/chromium_tests_root_x", "../chromium_tests_root_x",
+            "chromium_tests_root_x/child", "chromium_tests_root_x/..",
+            "chromium_tests_root_x\n", "chromium_tests_root_é",
+            "chromium_tests_root_" + "x".repeat(65)
+        }) {
+            assertThrows(IllegalArgumentException.class, () -> UrlUtils.setIsolatedTestRootName(name));
+            assertEquals(
+                    PathUtils.getExternalStorageDirectory() + "/chromium_tests_root_owned_09",
+                    UrlUtils.getIsolatedTestRoot());
+        }
+    }
+}
