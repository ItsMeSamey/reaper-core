+  void ExpectTransferEvents(const TestEventRouterObserver& observer, int id,
+                            int old_window, int old_index, int new_window,
+                            int new_index, Profile& explicit_profile) {
+    ASSERT_EQ(1u, CountEvents(observer, api::tabs::OnDetached::kEventName));
+    ASSERT_EQ(1u, CountEvents(observer, api::tabs::OnAttached::kEventName));
+    EXPECT_EQ(0u, CountEvents(observer, api::tabs::OnCreated::kEventName));
+    EXPECT_EQ(0u, CountEvents(observer, api::tabs::OnRemoved::kEventName));
+    const auto& detached =
+        *observer.events().at(api::tabs::OnDetached::kEventName);
+    const auto& attached =
+        *observer.events().at(api::tabs::OnAttached::kEventName);
+    EXPECT_EQ(&explicit_profile, detached.restrict_to_browser_context);
+    EXPECT_EQ(&explicit_profile, attached.restrict_to_browser_context);
+    ASSERT_EQ(2u, detached.args().size());
+    ASSERT_EQ(2u, attached.args().size());
+    EXPECT_EQ(id, detached.args()[0].GetInt());
+    EXPECT_EQ(old_window,
+              detached.args()[1].GetDict().FindInt("oldWindowId"));
+    EXPECT_EQ(old_index,
+              detached.args()[1].GetDict().FindInt("oldPosition"));
+    EXPECT_EQ(id, attached.args()[0].GetInt());
+    EXPECT_EQ(new_window,
+              attached.args()[1].GetDict().FindInt("newWindowId"));
+    EXPECT_EQ(new_index,
+              attached.args()[1].GetDict().FindInt("newPosition"));
+    auto detach_it = std::ranges::find_if(observer.all_events(), [](const auto& e) {
+      return e->event_name == api::tabs::OnDetached::kEventName;
+    });
+    auto attach_it = std::ranges::find_if(observer.all_events(), [](const auto& e) {
+      return e->event_name == api::tabs::OnAttached::kEventName;
+    });
+    EXPECT_LT(detach_it, attach_it);
+  }
+
+  void ExpectRemovedInProfile(const TestEventRouterObserver& observer, int id,
+                              Profile& explicit_profile, int window_id) {
+    size_t matching = 0;
+    for (const auto& event : observer.all_events()) {
+      if (event->event_name != api::tabs::OnRemoved::kEventName ||
+          event->args()[0].GetInt() != id) {
+        continue;
+      }
+      ++matching;
+      EXPECT_EQ(&explicit_profile, event->restrict_to_browser_context);
+      EXPECT_EQ(window_id, event->args()[1].GetDict().FindInt("windowId"));
+    }
+    EXPECT_EQ(1u, matching);
+  }
+
+  bool IsPending(TabsEventRouter& router, TabAndroid& tab) {
+    return router.GetPendingTab(tab);
