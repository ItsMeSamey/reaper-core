+IN_PROC_BROWSER_TEST_F(AndroidTabsLazyRestoreTest,
+                       RealEagerCloseRemovesTrackingBeforeNativeDestruction) {
+  auto* list = GetTabListInterface();
+  auto* eager = TabAndroid::FromTabInterface(list->OpenTab(
+      GURL("about:blank"), list->GetTabCount(), false));
+  ASSERT_TRUE(eager && eager->GetContents());
+  const auto handle = eager->GetHandle();
+  const int id = ExtensionTabUtil::GetTabId(*eager);
+  const int window_id = ExtensionTabUtil::GetWindowIdOfTab(*eager);
+  auto& router = StartRouter();
+  ASSERT_TRUE(HasTrackedID(router, id));
+  ASSERT_FALSE(IsPending(router, *eager));
+  TestEventRouterObserver events(EventRouter::Get(profile()));
+  AndroidRealTabCloseObserver close(*list, *eager);
+  list->CloseTab(handle);
+  ASSERT_TRUE(close.Wait());
+  EXPECT_EQ(1u, close.removed_count());
+  // This records genuine native teardown. Ordinary closure already removed
+  // the router's TabEntry, so it does not exercise live-tab pending creation.
+  EXPECT_EQ(1u, close.keep_session_id_detaches());
+  EXPECT_EQ(nullptr, handle.Get());
+  EXPECT_FALSE(HasPendingHandle(router, handle));
+  EXPECT_FALSE(HasTrackedID(router, id));
+  EXPECT_FALSE(ExtensionTabUtil::GetTabById(id, profile(), false,
+                                           nullptr, nullptr, nullptr));
+  EXPECT_EQ(1u, CountEvents(events, api::tabs::OnRemoved::kEventName));
+  ExpectRemovedInProfile(events, id, *profile(), window_id);
+  EXPECT_EQ(0u, CountEvents(events, api::tabs::OnCreated::kEventName));
+  EXPECT_EQ(0u, CountEvents(events, api::tabs::OnDetached::kEventName));
+  EXPECT_EQ(0u, CountEvents(events, api::tabs::OnAttached::kEventName));
+}
