+IN_PROC_BROWSER_TEST_F(AndroidTabsLazyRestoreTest,
+                       RealFrozenWindowTransferMaterializesWithStableIdentity) {
+  if (!SupportsRealMultiInstanceWindows()) {
+    GTEST_SKIP() << "Requires actual Android multi-instance SDK/manifest support; "
+                    "must also execute on a supported multi-instance device.";
+  }
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL committed = embedded_test_server()->GetURL("/title1.html");
+  const GURL pending = embedded_test_server()->GetURL("localhost", "/title2.html");
+  auto* source_model = static_cast<TabModel*>(GetTabListInterface());
+  ASSERT_TRUE(content::NavigateToURL(
+      source_model->GetActiveTab()->GetContents(), committed));
+  auto* source_window = source_model->GetActiveTab()->GetBrowserWindowInterface();
+  ASSERT_TRUE(source_window);
+  Profile* source_profile = source_window->GetProfile();
+  auto* destination_window = CreateRealWindow(*source_profile);
+  ASSERT_TRUE(destination_window);
+  auto* destination_list = TabListInterface::From(destination_window);
+  ASSERT_TRUE(destination_list);
+  ASSERT_NE(source_model, destination_list);
+  ASSERT_NE(source_window->GetSessionID(), destination_window->GetSessionID());
+  ASSERT_EQ(source_profile, destination_window->GetProfile());
+  // This real ungrouped intent rewrites the launch type to FROM_REPARENTING.
+  // Its tab selection materializes the frozen tab, even with bringToFront=false.
+  if (!destination_list->GetActiveTab()) {
+    ASSERT_TRUE(destination_list->OpenTab(GURL("about:blank"), 0, true));
+  }
+  auto* frozen = RestoreBackgroundTabInModel(*source_model,
+                                             source_model->GetTabCount());
+  ASSERT_EQ(nullptr, frozen->GetContents());
+  ASSERT_FALSE(frozen->GetGroup());
+  AppendSerializedPendingNavigation(*frozen, pending, "Transferred pending title");
+  ASSERT_EQ(committed, frozen->GetCommittedURL());
+  ASSERT_EQ(pending, frozen->GetPendingURL());
+  const auto handle = frozen->GetHandle();
+  const int android_id = frozen->GetAndroidId();
+  const int id = ExtensionTabUtil::GetTabId(*frozen);
+  const int old_window = ExtensionTabUtil::GetWindowIdOfTab(*frozen);
+  const int old_index = source_model->GetIndexOfTab(handle);
+  const int source_count = source_model->GetTabCount();
+  const int destination_count = destination_list->GetTabCount();
+  auto& router = StartRouter();
+  ASSERT_TRUE(IsPending(router, *frozen));
+  TestEventRouterObserver events(EventRouter::Get(source_profile));
+  AndroidRealTabTransferObserver transfer(*source_model, *destination_list, handle);
+  source_model->MoveTabToWindow(handle, destination_window->GetSessionID(),
+                                 destination_count);
+  ASSERT_TRUE(transfer.Wait());
+  ASSERT_EQ(frozen, handle.Get());
+  EXPECT_EQ(1u, transfer.removed_count());
+  EXPECT_EQ(1u, transfer.added_count());
+  EXPECT_FALSE(transfer.added_with_contents());
+  EXPECT_EQ(source_count - 1, source_model->GetTabCount());
+  EXPECT_EQ(destination_count + 1, destination_list->GetTabCount());
+  EXPECT_FALSE(NativeListContains(*source_model, frozen));
+  EXPECT_TRUE(NativeListContains(*destination_list, frozen));
+  EXPECT_EQ(destination_count, transfer.added_index());
+  EXPECT_EQ(destination_count, destination_list->GetIndexOfTab(handle));
+  EXPECT_EQ(destination_window, frozen->GetBrowserWindowInterface());
+  EXPECT_EQ(source_profile, frozen->GetProfile());
+  EXPECT_EQ(frozen, destination_list->GetActiveTab());
+  ASSERT_TRUE(frozen->GetContents());
+  ASSERT_TRUE(content::WaitForLoadStop(frozen->GetContents()));
+  EXPECT_EQ(android_id, frozen->GetAndroidId());
+  EXPECT_EQ(id, ExtensionTabUtil::GetTabId(*frozen));
+  EXPECT_EQ(pending, frozen->GetCommittedURL());
+  EXPECT_TRUE(frozen->GetPendingURL().is_empty());
+  EXPECT_FALSE(IsPending(router, *frozen));
+  EXPECT_EQ(destination_count, TrackedIndex(router, *frozen));
+  ExpectTransferEvents(events, id, old_window, old_index,
+                       destination_window->GetSessionID().id(), destination_count,
+                       *source_profile);
+  // The destination's ordinary selection performed LoadIfNeeded; the test
+  // never bypasses Java ownership or invents a native resurrection transition.
+  EXPECT_EQ(source_profile, frozen->GetContents()->GetBrowserContext());
+  EXPECT_EQ(pending, frozen->GetContents()->GetLastCommittedURL());
+  EXPECT_EQ(destination_window, frozen->GetBrowserWindowInterface());
+  EXPECT_EQ(id, ExtensionTabUtil::GetTabId(frozen->GetContents()));
+  EXPECT_EQ(android_id, frozen->GetAndroidId());
+  EXPECT_FALSE(IsPending(router, *frozen));
+  EXPECT_EQ(destination_count, TrackedIndex(router, *frozen));
+  ExpectTransferEvents(events, id, old_window, old_index,
+                       destination_window->GetSessionID().id(), destination_count,
+                       *source_profile);
+}
