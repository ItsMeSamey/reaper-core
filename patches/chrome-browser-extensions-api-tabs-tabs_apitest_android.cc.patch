+IN_PROC_BROWSER_TEST_F(AndroidTabsLazyRestoreTest,
+                       SerializedSyncPendingMetadataPreservesCommittedIdentity) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL committed = embedded_test_server()->GetURL("/title1.html");
+  const GURL pending = embedded_test_server()->GetURL("localhost", "/title2.html");
+  const GURL replacement =
+      embedded_test_server()->GetURL("localhost", "/title3.html");
+  ASSERT_TRUE(content::NavigateToURL(GetActiveWebContents(), committed));
+  const std::u16string committed_title = GetActiveWebContents()->GetTitle();
+  auto* list = GetTabListInterface();
+  auto* lazy = RestoreBackgroundTab(list->GetTabCount());
+  ASSERT_EQ(nullptr, lazy->GetContents());
+  const int id = ExtensionTabUtil::GetTabId(*lazy);
+  auto& router = StartRouter();
+  TestEventRouterObserver observer(EventRouter::Get(profile()));
+  AppendSerializedPendingNavigation(*lazy, pending, "Pending Sync title");
+  EXPECT_TRUE(IsPending(router, *lazy));
+  auto full = ExtensionBuilder("serialized tabs metadata")
+                  .AddAPIPermission("tabs").Build();
+  auto pending_only = ExtensionBuilder("pending host metadata")
+                          .AddHostPermission(pending.GetWithEmptyPath().spec() + "*")
+                          .Build();
+  auto committed_only = ExtensionBuilder("committed host metadata")
+                            .AddHostPermission(committed.GetWithEmptyPath().spec() + "*")
+                            .Build();
+  auto restricted = ExtensionBuilder("no serialized metadata").Build();
+  auto get = [&](const Extension* extension) {
+    auto function = base::MakeRefCounted<TabsGetFunction>();
+    function->set_extension(extension);
+    return api_test_utils::RunFunctionAndReturnSingleResult(
+        function, base::StringPrintf("[%d]", id), profile());
+  };
+  auto value = get(full.get());
+  ASSERT_TRUE(value && value->is_dict());
+  EXPECT_EQ(committed.spec(), *value->GetDict().FindString("url"));
+  EXPECT_EQ(pending.spec(), *value->GetDict().FindString("pendingUrl"));
+  EXPECT_EQ(base::UTF16ToUTF8(committed_title),
+            *value->GetDict().FindString("title"));
+  auto pending_value = get(pending_only.get());
+  ASSERT_TRUE(pending_value && pending_value->is_dict());
+  EXPECT_FALSE(pending_value->GetDict().contains("url"));
+  EXPECT_FALSE(pending_value->GetDict().contains("title"));
+  EXPECT_EQ(pending.spec(), *pending_value->GetDict().FindString("pendingUrl"));
+  auto committed_value = get(committed_only.get());
+  ASSERT_TRUE(committed_value && committed_value->is_dict());
+  EXPECT_EQ(committed.spec(), *committed_value->GetDict().FindString("url"));
+  EXPECT_EQ(base::UTF16ToUTF8(committed_title),
+            *committed_value->GetDict().FindString("title"));
+  EXPECT_FALSE(committed_value->GetDict().contains("pendingUrl"));
+  auto hidden = get(restricted.get());
+  ASSERT_TRUE(hidden && hidden->is_dict());
+  EXPECT_FALSE(hidden->GetDict().contains("url"));
+  EXPECT_FALSE(hidden->GetDict().contains("title"));
+  EXPECT_FALSE(hidden->GetDict().contains("pendingUrl"));
+  auto query_contains = [&](const Extension* extension, const GURL& url) {
+    auto function = base::MakeRefCounted<TabsQueryFunction>();
+    function->set_extension(extension);
+    auto result = api_test_utils::RunFunctionAndReturnSingleResult(
+        function, base::StringPrintf("[{\"url\":\"%s\"}]", url.spec().c_str()),
+        profile());
+    CHECK(result && result->is_list());
+    return std::ranges::any_of(result->GetList(), [id](const auto& tab) {
+      return tab.GetDict().FindInt("id") == id;
+    });
+  };
+  EXPECT_TRUE(query_contains(full.get(), committed));
+  EXPECT_TRUE(query_contains(full.get(), pending));
+  EXPECT_TRUE(query_contains(pending_only.get(), pending));
+  EXPECT_FALSE(query_contains(pending_only.get(), committed));
+  EXPECT_FALSE(query_contains(restricted.get(), pending));
+  list->PinTab(lazy->GetHandle());
+  ASSERT_EQ(1u, CountEvents(observer, api::tabs::OnUpdated::kEventName));
+  const auto& event = *observer.events().at(api::tabs::OnUpdated::kEventName);
+  auto event_tab = [&](const Extension* extension) {
+    std::optional<base::ListValue> args;
+    mojom::EventFilteringInfoPtr filtering;
+    CHECK(event.will_dispatch_callback.Run(
+        profile(), mojom::ContextType::kUnprivilegedExtension, extension,
+        nullptr, args, filtering, nullptr));
+    CHECK(args && args->size() == 3);
+    EXPECT_EQ(id, (*args)[0].GetInt());
+    EXPECT_TRUE((*args)[1].GetDict().contains("pinned"));
+    return (*args)[2].GetDict().Clone();
+  };
+  auto pending_event = event_tab(pending_only.get());
+  EXPECT_FALSE(pending_event.contains("url"));
+  EXPECT_FALSE(pending_event.contains("title"));
+  EXPECT_EQ(pending.spec(), *pending_event.FindString("pendingUrl"));
+  auto committed_event = event_tab(committed_only.get());
+  EXPECT_EQ(committed.spec(), *committed_event.FindString("url"));
+  EXPECT_EQ(base::UTF16ToUTF8(committed_title),
+            *committed_event.FindString("title"));
+  EXPECT_FALSE(committed_event.contains("pendingUrl"));
+  auto* browser = lazy->GetBrowserWindowInterface();
+  ASSERT_TRUE(browser);
+  auto all = BrowserExtensionWindowController::From(browser)->CreateTabList(
+      full.get(), mojom::ContextType::kUnprivilegedExtension);
+  auto it = std::ranges::find_if(all, [id](const auto& tab) {
+    return tab.GetDict().FindInt("id") == id;
+  });
+  ASSERT_NE(it, all.end());
+  EXPECT_EQ(committed.spec(), *it->GetDict().FindString("url"));
+  EXPECT_EQ(pending.spec(), *it->GetDict().FindString("pendingUrl"));
+  // The same regular native ID is not available through an OTR-only lookup.
+  EXPECT_FALSE(ExtensionTabUtil::GetTabById(
+      id, profile()->GetPrimaryOTRProfile(/*create_if_needed=*/true), false,
+      nullptr, nullptr, nullptr));
+  EXPECT_EQ(nullptr, lazy->GetContents());
+  EXPECT_EQ(id, ExtensionTabUtil::GetTabId(*lazy));
+  // A second Sync update clobbers the pending entry, retaining its predecessor.
+  AppendSerializedPendingNavigation(*lazy, replacement, "Replacement Sync title");
+  auto replaced = get(full.get());
+  ASSERT_TRUE(replaced && replaced->is_dict());
+  EXPECT_EQ(committed.spec(), *replaced->GetDict().FindString("url"));
+  EXPECT_EQ(base::UTF16ToUTF8(committed_title),
+            *replaced->GetDict().FindString("title"));
+  EXPECT_EQ(replacement.spec(), *replaced->GetDict().FindString("pendingUrl"));
+  EXPECT_EQ(nullptr, lazy->GetContents());
+  lazy->LoadIfNeeded();
+  ASSERT_TRUE(lazy->GetContents());
+  ASSERT_TRUE(content::WaitForLoadStop(lazy->GetContents()));
+  EXPECT_EQ(id, ExtensionTabUtil::GetTabId(lazy->GetContents()));
+  EXPECT_EQ(replacement, lazy->GetContents()->GetLastCommittedURL());
+  EXPECT_FALSE(IsPending(router, *lazy));
+  EXPECT_EQ(0u, CountEvents(observer, api::tabs::OnCreated::kEventName));
+  auto loaded = get(full.get());
+  ASSERT_TRUE(loaded && loaded->is_dict());
+  EXPECT_EQ(replacement.spec(), *loaded->GetDict().FindString("url"));
+  EXPECT_FALSE(loaded->GetDict().contains("pendingUrl"));
+  auto loaded_pending_host = get(pending_only.get());
+  ASSERT_TRUE(loaded_pending_host && loaded_pending_host->is_dict());
+  EXPECT_EQ(replacement.spec(),
+            *loaded_pending_host->GetDict().FindString("url"));
+  EXPECT_TRUE(loaded_pending_host->GetDict().contains("title"));
+  EXPECT_FALSE(loaded_pending_host->GetDict().contains("pendingUrl"));
+  auto loaded_old_host = get(committed_only.get());
+  ASSERT_TRUE(loaded_old_host && loaded_old_host->is_dict());
+  EXPECT_FALSE(loaded_old_host->GetDict().contains("url"));
+  EXPECT_FALSE(loaded_old_host->GetDict().contains("title"));
+  EXPECT_FALSE(loaded_old_host->GetDict().contains("pendingUrl"));
+}
