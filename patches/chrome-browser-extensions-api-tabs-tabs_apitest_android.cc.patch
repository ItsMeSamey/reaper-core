+IN_PROC_BROWSER_TEST_F(AndroidTabsLazyRestoreTest,
+                       BootstrapKeepsLazyIndicesAndObservesMaterialization) {
+  auto* list = GetTabListInterface();
+  TabAndroid* lazy = RestoreBackgroundTab(list->GetTabCount());
+  ASSERT_TRUE(lazy);
+  ASSERT_EQ(nullptr, lazy->GetContents());
