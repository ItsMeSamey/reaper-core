+// These observers wait for real list and Java-owned tab lifecycle callbacks.
+class AndroidRealTabTransferObserver : public TabListInterfaceObserver {
+ public:
+  AndroidRealTabTransferObserver(TabListInterface& source,
+                                 TabListInterface& destination,
+                                 tabs::TabHandle handle)
+      : handle_(handle) {
+    source_.Observe(&source);
+    destination_.Observe(&destination);
+  }
+
+  void OnTabRemoved(TabListInterface& list, tabs::TabInterface* tab,
+                    TabRemovedReason reason) override {
+    if (&list != source_.GetSource() || tab->GetHandle() != handle_) {
+      return;
+    }
+    EXPECT_EQ(TabRemovedReason::kInsertedIntoOtherTabStrip, reason);
+    if (++removed_count_ == 1) {
+      removed_.SetValue();
+    }
+  }
+
+  void OnTabAdded(TabListInterface& list, tabs::TabInterface* tab,
+                  int index) override {
+    if (&list != destination_.GetSource() || tab->GetHandle() != handle_) {
+      return;
+    }
+    added_index_ = index;
+    added_with_contents_ = tab->GetContents() != nullptr;
+    if (++added_count_ == 1) {
+      added_.SetValue();
+    }
+  }
+
+  bool Wait() { return removed_.Wait() && added_.Wait(); }
+  size_t removed_count() const { return removed_count_; }
+  size_t added_count() const { return added_count_; }
+  int added_index() const { return added_index_; }
+  bool added_with_contents() const { return added_with_contents_; }
+
+ private:
+  const tabs::TabHandle handle_;
+  base::ScopedObservation<TabListInterface, TabListInterfaceObserver> source_{
+      this};
+  base::ScopedObservation<TabListInterface, TabListInterfaceObserver>
+      destination_{this};
+  base::test::TestFuture<void> removed_;
+  base::test::TestFuture<void> added_;
+  size_t removed_count_ = 0;
+  size_t added_count_ = 0;
+  int added_index_ = -1;
+  bool added_with_contents_ = false;
+};
+
+class AndroidRealTabCloseObserver : public TabListInterfaceObserver,
+                                     public TabAndroid::Observer {
+ public:
+  AndroidRealTabCloseObserver(TabListInterface& list, TabAndroid& tab)
+      : handle_(tab.GetHandle()) {
+    list_.Observe(&list);
+    tab_.Observe(&tab);
+  }
+
+  void OnTabRemoved(TabListInterface& list, tabs::TabInterface* tab,
+                    TabRemovedReason reason) override {
+    if (tab->GetHandle() != handle_) {
+      return;
+    }
+    EXPECT_TRUE(TabRemoveReasonUtils::WillDeleteTab(reason));
+    if (++removed_count_ == 1) {
+      removed_.SetValue();
+    }
+  }
+
+  void OnInitWebContents(TabAndroid* tab) override {}
+
+  void OnWillDetachWebContents(TabAndroid* tab, bool keep_session_id) override {
+    // The real Java remover emits list removal before native destruction.
+    EXPECT_EQ(1u, removed_count_);
+    if (keep_session_id) {
+      ++keep_session_id_detaches_;
+    }
+  }
+
+  void OnTabAndroidDestroyed(TabAndroid* tab) override {
+    tab_.Reset();
+    destroyed_.SetValue();
+  }
+
+  bool Wait() { return removed_.Wait() && destroyed_.Wait(); }
+  size_t removed_count() const { return removed_count_; }
+  size_t keep_session_id_detaches() const { return keep_session_id_detaches_; }
+
+ private:
+  const tabs::TabHandle handle_;
+  base::ScopedObservation<TabListInterface, TabListInterfaceObserver> list_{this};
+  base::ScopedObservation<TabAndroid, TabAndroid::Observer> tab_{this};
+  base::test::TestFuture<void> removed_;
+  base::test::TestFuture<void> destroyed_;
+  size_t removed_count_ = 0;
+  size_t keep_session_id_detaches_ = 0;
+};
