+// Uses the real Java ChromeTabCreator restore path and the standard model.
+// JNI reflection keeps this stock native browser test independent of a new
+// generated test-only Java target.
+class AndroidTabsLazyRestoreTest : public ExtensionApiTest {
+ public:
+  AndroidTabsLazyRestoreTest() {
+    features_.InitWithFeatures(
+        {feed::kAndroidOpenIncognitoAsWindow},
+        {chrome::android::kLoadAllTabsAtStartup});
+  }
+
+ protected:
+  void SetUpDefaultCommandLine(base::CommandLine* command_line) override {
+    ExtensionApiTest::SetUpDefaultCommandLine(command_line);
+    command_line->AppendSwitch("disable-fre");
+  }
+
+  TabAndroid* RestoreBackgroundTab(int index) {
+    return RestoreBackgroundTabInModel(
+        *static_cast<TabModel*>(GetTabListInterface()), index);
+  }
+
+  TabAndroid* RestoreBackgroundTabInModel(TabModel& explicit_model, int index) {
+    CHECK(!base::FeatureList::IsEnabled(
+        chrome::android::kLoadAllTabsAtStartup));
+    auto* model = &explicit_model;
+    CHECK_EQ(model->GetTabModelType(), TabModel::TabModelType::kStandard);
+    auto* source = model->GetTabAt(model->GetActiveIndex());
+    CHECK(source);
+    CHECK(source->GetContents());
+    JNIEnv* env = base::android::AttachCurrentThread();
+    auto extractor = base::android::GetClass(
+        env, "org/chromium/chrome/browser/tab/TabStateExtractor");
+    jmethodID extract = env->GetStaticMethodID(
+        extractor.obj(), "from",
+        "(Lorg/chromium/chrome/browser/tab/Tab;)"
+        "Lorg/chromium/chrome/browser/tab/TabState;");
+    CHECK(extract);
+    auto state = jni_zero::AdoptRef(
+        env, env->CallStaticObjectMethod(extractor.obj(), extract,
+                                        source->GetJavaObject().obj()));
+    base::android::CheckException(env);
+    CHECK(!state.is_null());
+
+    auto java_model = model->GetJavaObject();
+    auto model_class = jni_zero::AdoptRef(
+        env, env->GetObjectClass(java_model.obj()));
+    jmethodID get_creator = env->GetMethodID(
+        model_class.obj(), "getTabCreator",
+        "()Lorg/chromium/chrome/browser/tabmodel/TabCreator;");
+    CHECK(get_creator);
+    auto creator = jni_zero::AdoptRef(
+        env, env->CallObjectMethod(java_model.obj(), get_creator));
+    base::android::CheckException(env);
+    CHECK(!creator.is_null());
+    auto creator_class = jni_zero::AdoptRef(
+        env, env->GetObjectClass(creator.obj()));
+    jmethodID restore = env->GetMethodID(
+        creator_class.obj(), "createFrozenTab",
+        "(Lorg/chromium/chrome/browser/tab/TabState;II)"
+        "Lorg/chromium/chrome/browser/tab/Tab;");
+    CHECK(restore);
+    // Allocate through the same process-wide owner used by ordinary Java tabs.
+    // Model-local maxima can collide with tabs in another real window/profile.
+    auto id_manager_class = base::android::GetClass(
+        env, "org/chromium/chrome/browser/tab/TabIdManager");
+    jmethodID get_manager = env->GetStaticMethodID(
+        id_manager_class.obj(), "getInstance",
+        "()Lorg/chromium/chrome/browser/tab/TabIdManager;");
+    CHECK(get_manager);
+    auto id_manager = jni_zero::AdoptRef(
+        env, env->CallStaticObjectMethod(id_manager_class.obj(), get_manager));
+    base::android::CheckException(env);
+    CHECK(!id_manager.is_null());
+    jmethodID generate_id = env->GetMethodID(
+        id_manager_class.obj(), "generateValidId", "(I)I");
+    CHECK(generate_id);
+    const int android_id = env->CallIntMethod(
+        id_manager.obj(), generate_id, TabAndroid::kInvalidTabId);
+    base::android::CheckException(env);
+    CHECK_NE(TabAndroid::kInvalidTabId, android_id);
+    auto restored = jni_zero::AdoptRef(
+        env, env->CallObjectMethod(creator.obj(), restore, state.obj(),
+                                  android_id, index));
+    base::android::CheckException(env);
+    CHECK(!restored.is_null());
+    return TabAndroid::GetNativeTab(env, restored);
+  }
+
+  TabAndroid* CreatePendingBackgroundTab(const std::string& url) {
+    auto* model = static_cast<TabModel*>(GetTabListInterface());
+    JNIEnv* env = base::android::AttachCurrentThread();
+    auto java_model = model->GetJavaObject();
+    auto model_class = jni_zero::AdoptRef(env, env->GetObjectClass(java_model.obj()));
+    jmethodID get_creator = env->GetMethodID(model_class.obj(), "getTabCreator",
+        "()Lorg/chromium/chrome/browser/tabmodel/TabCreator;");
+    CHECK(get_creator);
+    auto creator = jni_zero::AdoptRef(
+        env, env->CallObjectMethod(java_model.obj(), get_creator));
+    base::android::CheckException(env);
+    auto params_class = base::android::GetClass(
+        env, "org/chromium/content_public/browser/LoadUrlParams");
+    jmethodID ctor = env->GetMethodID(params_class.obj(), "<init>", "(Ljava/lang/String;)V");
+    CHECK(ctor);
+    auto java_url = base::android::ConvertUTF8ToJavaString(env, url);
+    auto params = jni_zero::AdoptRef(
+        env, env->NewObject(params_class.obj(), ctor, java_url.obj()));
+    base::android::CheckException(env);
+    auto creator_class = jni_zero::AdoptRef(env, env->GetObjectClass(creator.obj()));
+    jmethodID create = env->GetMethodID(creator_class.obj(), "createNewTab",
+        "(Lorg/chromium/content_public/browser/LoadUrlParams;I"
+        "Lorg/chromium/chrome/browser/tab/Tab;)Lorg/chromium/chrome/browser/tab/Tab;");
+    CHECK(create);
+    // This genuine sync-background branch uses TabBuilder.createForLazyLoad
+    // regardless of device memory class, in the ordinary standard model.
+    auto tab = jni_zero::AdoptRef(env, env->CallObjectMethod(
+        creator.obj(), create, params.obj(),
+        static_cast<int>(TabModel::TabLaunchType::FROM_SYNC_BACKGROUND),
+        static_cast<jobject>(nullptr)));
+    base::android::CheckException(env);
+    CHECK(!tab.is_null());
+    return TabAndroid::GetNativeTab(env, tab);
+  }
+
+  void CloseCurrentUponExit(TabAndroid& survivor) {
+    auto* model = static_cast<TabModel*>(GetTabListInterface());
+    auto* current = model->GetTabAt(model->GetActiveIndex());
+    CHECK(current && current != &survivor);
+    JNIEnv* env = base::android::AttachCurrentThread();
+    auto java_model = model->GetJavaObject();
+    auto model_class = jni_zero::AdoptRef(env, env->GetObjectClass(java_model.obj()));
+    jmethodID get_remover = env->GetMethodID(
+        model_class.obj(), "getTabRemover",
+        "()Lorg/chromium/chrome/browser/tabmodel/TabRemover;");
+    CHECK(get_remover);
+    auto remover = jni_zero::AdoptRef(
+        env, env->CallObjectMethod(java_model.obj(), get_remover));
+    base::android::CheckException(env);
+    auto params_class = base::android::GetClass(
+        env, "org/chromium/chrome/browser/tabmodel/TabClosureParams");
+    jmethodID close_tab = env->GetStaticMethodID(
+        params_class.obj(), "closeTab", "(Lorg/chromium/chrome/browser/tab/Tab;)"
+        "Lorg/chromium/chrome/browser/tabmodel/TabClosureParams$CloseTabBuilder;");
+    CHECK(close_tab);
+    auto builder = jni_zero::AdoptRef(env, env->CallStaticObjectMethod(
+        params_class.obj(), close_tab, current->GetJavaObject().obj()));
+    base::android::CheckException(env);
+    auto builder_class = jni_zero::AdoptRef(env, env->GetObjectClass(builder.obj()));
+    jmethodID recommend = env->GetMethodID(
+        builder_class.obj(), "recommendedNextTab",
+        "(Lorg/chromium/chrome/browser/tab/Tab;)"
+        "Lorg/chromium/chrome/browser/tabmodel/TabClosureParams$CloseTabBuilder;");
+    jmethodID upon_exit = env->GetMethodID(builder_class.obj(), "uponExit",
+        "(Z)Lorg/chromium/chrome/browser/tabmodel/TabClosureParams$CloseTabBuilder;");
+    jmethodID allow_undo = env->GetMethodID(builder_class.obj(), "allowUndo",
+        "(Z)Lorg/chromium/chrome/browser/tabmodel/TabClosureParams$CloseTabBuilder;");
+    CHECK(recommend && upon_exit && allow_undo);
+    auto recommended = jni_zero::AdoptRef(env, env->CallObjectMethod(
+        builder.obj(), recommend, survivor.GetJavaObject().obj()));
+    auto exiting = jni_zero::AdoptRef(
+        env, env->CallObjectMethod(builder.obj(), upon_exit, true));
+    auto no_undo = jni_zero::AdoptRef(
+        env, env->CallObjectMethod(builder.obj(), allow_undo, false));
+    base::android::CheckException(env);
+    jmethodID build = env->GetMethodID(builder_class.obj(), "build",
+        "()Lorg/chromium/chrome/browser/tabmodel/TabClosureParams;");
+    CHECK(build);
+    auto params = jni_zero::AdoptRef(env, env->CallObjectMethod(builder.obj(), build));
+    base::android::CheckException(env);
+    auto remover_class = jni_zero::AdoptRef(env, env->GetObjectClass(remover.obj()));
+    jmethodID close = env->GetMethodID(remover_class.obj(), "closeTabs",
+        "(Lorg/chromium/chrome/browser/tabmodel/TabClosureParams;Z"
+        "Lorg/chromium/chrome/browser/tabmodel/TabModelActionListener;)V");
+    CHECK(close);
+    env->CallVoidMethod(remover.obj(), close, params.obj(), false, nullptr);
+    base::android::CheckException(env);
+  }
+
+  void AppendSerializedPendingNavigation(TabAndroid& tab,
+                                         const GURL& url,
+                                         const std::string& title) {
+    CHECK(!tab.GetContents());
+    JNIEnv* env = base::android::AttachCurrentThread();
+    auto java_tab = tab.GetJavaObject();
+    auto tab_class = jni_zero::AdoptRef(env, env->GetObjectClass(java_tab.obj()));
+    auto params_class = base::android::GetClass(
+        env, "org/chromium/content_public/browser/LoadUrlParams");
+    jmethodID ctor = env->GetMethodID(
+        params_class.obj(), "<init>", "(Ljava/lang/String;)V");
+    CHECK(ctor);
+    auto java_url = base::android::ConvertUTF8ToJavaString(env, url.spec());
+    auto params = jni_zero::AdoptRef(
+        env, env->NewObject(params_class.obj(), ctor, java_url.obj()));
+    auto java_title = base::android::ConvertUTF8ToJavaString(env, title);
+    jmethodID append = env->GetMethodID(
+        tab_class.obj(), "discardAndAppendPendingNavigation",
+        "(Lorg/chromium/content_public/browser/LoadUrlParams;Ljava/lang/String;)V");
+    CHECK(append);
+    env->CallVoidMethod(java_tab.obj(), append, params.obj(), java_title.obj());
+    base::android::CheckException(env);
+
+    // Prove successful serialized append. The fallback into pending load params
+    // would reproduce the older test instead of reaching this regression.
+    jmethodID get_params = env->GetMethodID(
+        tab_class.obj(), "getPendingLoadParams",
+        "()Lorg/chromium/content_public/browser/LoadUrlParams;");
+    jmethodID get_state = env->GetMethodID(
+        tab_class.obj(), "getWebContentsState",
+        "()Lorg/chromium/chrome/browser/tab/WebContentsState;");
+    CHECK(get_params && get_state);
+    auto pending_params = jni_zero::AdoptRef(
+        env, env->CallObjectMethod(java_tab.obj(), get_params));
+    auto state = jni_zero::AdoptRef(
+        env, env->CallObjectMethod(java_tab.obj(), get_state));
+    base::android::CheckException(env);
+    CHECK(pending_params.is_null());
+    CHECK(!state.is_null());
+    auto state_class = jni_zero::AdoptRef(env, env->GetObjectClass(state.obj()));
+    jmethodID has_pending = env->GetMethodID(
+        state_class.obj(), "hasPendingNavigation", "()Z");
+    CHECK(has_pending);
+    CHECK(env->CallBooleanMethod(state.obj(), has_pending));
+    base::android::CheckException(env);
+    CHECK(!tab.GetContents());
+  }
