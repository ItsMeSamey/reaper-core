+IN_PROC_BROWSER_TEST_F(AndroidTabsLazyRestoreTest,
+                       RealRegularAndOTRLazyLifecycleKeepsProfileIsolation) {
+  if (!SupportsRealMultiInstanceWindows()) {
+    GTEST_SKIP() << "Requires actual Android multi-instance SDK/manifest support; "
+                    "must also execute on a supported multi-instance device.";
+  }
+  auto* regular_model = static_cast<TabModel*>(GetTabListInterface());
+  Profile* regular_profile = regular_model->GetProfile();
+  Profile* otr_profile = regular_profile->GetPrimaryOTRProfile(true);
+  auto* otr_window = CreateRealWindow(*otr_profile);
+  ASSERT_TRUE(otr_window);
+  ASSERT_EQ(otr_profile, otr_window->GetProfile());
+  auto* otr_model = static_cast<TabModel*>(TabListInterface::From(otr_window));
+  ASSERT_TRUE(otr_model);
+  ASSERT_NE(regular_model, otr_model);
+  ASSERT_EQ(otr_profile, otr_model->GetProfile());
+  ASSERT_EQ(TabModel::TabModelType::kStandard, otr_model->GetTabModelType());
+  if (!otr_model->GetActiveTab()) {
+    ASSERT_TRUE(otr_model->OpenTab(GURL("about:blank"), 0, true));
+  }
+  ASSERT_TRUE(otr_model->GetActiveTab()->GetContents());
+  auto* regular = RestoreBackgroundTabInModel(*regular_model,
+                                              regular_model->GetTabCount());
+  auto* otr = RestoreBackgroundTabInModel(*otr_model, otr_model->GetTabCount());
+  ASSERT_EQ(nullptr, regular->GetContents());
+  ASSERT_EQ(nullptr, otr->GetContents());
+  const auto regular_handle = regular->GetHandle();
+  const auto otr_handle = otr->GetHandle();
+  const int regular_id = ExtensionTabUtil::GetTabId(*regular);
+  const int otr_id = ExtensionTabUtil::GetTabId(*otr);
+  const int regular_window = ExtensionTabUtil::GetWindowIdOfTab(*regular);
+  const int otr_window_id = ExtensionTabUtil::GetWindowIdOfTab(*otr);
+  ASSERT_NE(regular_id, otr_id);
+  auto& router = StartRouter();
+  EXPECT_TRUE(IsPending(router, *regular));
+  EXPECT_TRUE(IsPending(router, *otr));
+  EXPECT_EQ(regular_profile, regular->GetProfile());
+  EXPECT_EQ(otr_profile, otr->GetProfile());
+  auto lookup = [](int id, Profile* context, bool include_incognito) {
+    return ExtensionTabUtil::GetTabById(id, context, include_incognito,
+                                       nullptr, nullptr, nullptr);
+  };
+  EXPECT_TRUE(lookup(regular_id, regular_profile, false));
+  EXPECT_TRUE(lookup(otr_id, otr_profile, false));
+  EXPECT_FALSE(lookup(otr_id, regular_profile, false));
+  EXPECT_FALSE(lookup(regular_id, otr_profile, false));
+  EXPECT_TRUE(lookup(otr_id, regular_profile, true));
+  // EventRouter is intentionally redirected to the parent context for OTR.
+  // Assert actual event context rather than inventing a second event service.
+  TestEventRouterObserver events(EventRouter::Get(regular_profile));
+  regular->LoadIfNeeded();
+  ASSERT_TRUE(regular->GetContents());
+  ASSERT_TRUE(content::WaitForLoadStop(regular->GetContents()));
+  EXPECT_EQ(regular_profile, regular->GetContents()->GetBrowserContext());
+  EXPECT_FALSE(IsPending(router, *regular));
+  EXPECT_TRUE(IsPending(router, *otr));
+  EXPECT_EQ(nullptr, otr->GetContents());
+  otr->LoadIfNeeded();
+  ASSERT_TRUE(otr->GetContents());
+  ASSERT_TRUE(content::WaitForLoadStop(otr->GetContents()));
+  EXPECT_EQ(otr_profile, otr->GetContents()->GetBrowserContext());
+  EXPECT_FALSE(IsPending(router, *otr));
+  EXPECT_EQ(regular_id, ExtensionTabUtil::GetTabId(regular->GetContents()));
+  EXPECT_EQ(otr_id, ExtensionTabUtil::GetTabId(otr->GetContents()));
+  EXPECT_EQ(regular, regular_handle.Get());
+  EXPECT_EQ(otr, otr_handle.Get());
+  EXPECT_EQ(0u, CountEvents(events, api::tabs::OnCreated::kEventName));
+  EXPECT_FALSE(lookup(otr_id, regular_profile, false));
+  EXPECT_FALSE(lookup(regular_id, otr_profile, false));
+  events.ClearEvents();
+  AndroidRealTabCloseObserver regular_close(*regular_model, *regular);
+  AndroidRealTabCloseObserver otr_close(*otr_model, *otr);
+  regular_model->CloseTab(regular_handle);
+  ASSERT_TRUE(regular_close.Wait());
+  EXPECT_EQ(nullptr, regular_handle.Get());
+  EXPECT_FALSE(HasPendingHandle(router, regular_handle));
+  EXPECT_FALSE(HasTrackedID(router, regular_id));
+  EXPECT_TRUE(HasTrackedID(router, otr_id));
+  EXPECT_EQ(otr, otr_handle.Get());
+  EXPECT_TRUE(lookup(otr_id, otr_profile, false));
+  EXPECT_FALSE(lookup(regular_id, regular_profile, false));
+  otr_model->CloseTab(otr_handle);
+  ASSERT_TRUE(otr_close.Wait());
+  EXPECT_EQ(nullptr, otr_handle.Get());
+  EXPECT_FALSE(HasPendingHandle(router, otr_handle));
+  EXPECT_FALSE(HasTrackedID(router, otr_id));
+  EXPECT_FALSE(lookup(otr_id, otr_profile, false));
+  EXPECT_EQ(2u, CountEvents(events, api::tabs::OnRemoved::kEventName));
+  ExpectRemovedInProfile(events, regular_id, *regular_profile, regular_window);
+  ExpectRemovedInProfile(events, otr_id, *otr_profile, otr_window_id);
+  EXPECT_EQ(0u, CountEvents(events, api::tabs::OnCreated::kEventName));
+  EXPECT_EQ(0u, CountEvents(events, api::tabs::OnDetached::kEventName));
+  EXPECT_EQ(0u, CountEvents(events, api::tabs::OnAttached::kEventName));
+}
