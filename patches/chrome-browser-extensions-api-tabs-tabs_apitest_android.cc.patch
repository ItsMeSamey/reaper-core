+IN_PROC_BROWSER_TEST_F(AndroidTabsLazyRestoreTest,
+                       SerializedCommittedMetadataRejectsMissingAndTruncatedState) {
+  JNIEnv* env = base::android::AttachCurrentThread();
+  auto state = WebContentsState::CreateSingleNavigationStateAsByteBuffer(
+      env, profile(), std::u16string(u"Pending title"),
+      "https://example.test/pending", std::nullopt, 0, std::nullopt);
+  ASSERT_FALSE(state.is_null());
+  auto bytes = base::android::JavaByteBufferToSpan(env, state);
+  ASSERT_FALSE(bytes.empty());
+  bool is_off_the_record = false;
+  std::u16string title;
+  std::string url;
+  // Existing callers still select the current entry by default.
+  EXPECT_TRUE(WebContentsState::ExtractMetadata(
+      bytes, 2, &is_off_the_record, &title, &url));
+  EXPECT_EQ("https://example.test/pending", url);
+  EXPECT_EQ(u"Pending title", title);
+  EXPECT_FALSE(WebContentsState::ExtractMetadata(
+      bytes, 2, &is_off_the_record, &title, &url, true));
+  auto appended = WebContentsState::AppendPendingNavigation(
+      env, profile(), bytes, 2, false, std::u16string(u"New pending title"),
+      "https://example.test/replacement", std::nullopt, 0, std::nullopt);
+  ASSERT_FALSE(appended.is_null());
+  auto with_previous = base::android::JavaByteBufferToSpan(env, appended);
+  EXPECT_TRUE(WebContentsState::ExtractMetadata(
+      with_previous, 2, &is_off_the_record, &title, &url, true));
+  EXPECT_EQ("https://example.test/pending", url);
+  EXPECT_EQ(u"Pending title", title);
+  EXPECT_FALSE(WebContentsState::ExtractMetadata(
+      with_previous.first(bytes.size() / 2), 2,
+      &is_off_the_record, &title, &url, true));
+  EXPECT_FALSE(WebContentsState::ExtractMetadata(
+      with_previous.first(0u), 2, &is_off_the_record, &title, &url, true));
+  EXPECT_FALSE(WebContentsState::ExtractMetadata(
+      with_previous, 1, &is_off_the_record, &title, &url, true));
+}
