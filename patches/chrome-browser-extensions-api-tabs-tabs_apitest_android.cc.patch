+  int TrackedIndex(TabsEventRouter& router, TabAndroid& tab) {
+    if (auto* pending = router.GetPendingTab(tab)) {
+      return pending->index;
+    }
+    auto* entry = router.GetTabEntry(*tab.GetContents());
+    CHECK(entry);
+    return entry->last_known_index();
+  }
+
+  bool NativeListContains(TabListInterface& list, tabs::TabInterface* tab) {
+    const auto tabs = list.GetAllTabs();
+    return std::ranges::find(tabs, tab) != tabs.end();
+  }
+
+  bool HasPendingHandle(TabsEventRouter& router, tabs::TabHandle handle) {
+    return router.pending_tabs_.contains(handle);
+  }
+
+  size_t CountEvents(const TestEventRouterObserver& observer,
+                     const char* name) {
+    return std::ranges::count_if(observer.all_events(), [name](const auto& e) {
+      return e->event_name == name;
+    });
+  }
+
+  base::ListValue Arguments(const Event& event) {
+    if (!event.will_dispatch_callback) {
+      return event.args().Clone();
+    }
+    auto extension = ExtensionBuilder("lazy lifecycle")
+                         .SetManifestVersion(3)
+                         .AddAPIPermission("tabs")
+                         .Build();
+    std::optional<base::ListValue> args;
+    mojom::EventFilteringInfoPtr filtering;
+    CHECK(event.will_dispatch_callback.Run(
+        profile(), mojom::ContextType::kUnprivilegedExtension, extension.get(),
+        nullptr, args, filtering, nullptr));
+    CHECK(args.has_value());
+    return std::move(*args);
+  }
+
+ private:
+  base::test::ScopedFeatureList features_;
+};
