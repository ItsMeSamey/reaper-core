+void AndroidLiveTabContextRestoreWrapper::ReconstructSplit(
+    sessions::LiveTab* leading_tab,
+    sessions::LiveTab* trailing_tab,
+    split_tabs::SplitTabId split_id,
+    const split_tabs::SplitTabVisualData& visual_data) {
+  if (!leading_tab || !trailing_tab)
+    return;
+  auto* leading = TabAndroid::FromWebContents(
+      &static_cast<sessions::ContentLiveTab*>(leading_tab)->GetWebContents());
+  auto* trailing = TabAndroid::FromWebContents(
+      &static_cast<sessions::ContentLiveTab*>(trailing_tab)->GetWebContents());
+  if (leading && trailing) {
+    pending_splits_.push_back(
+        {{leading->GetAndroidId(), trailing->GetAndroidId()},
+         split_id,
+         visual_data});
+  }
+}
+
+void AndroidLiveTabContextRestoreWrapper::RestoreSplits() {
+  auto pending = std::move(pending_splits_);
+  pending_splits_.clear();
+  for (const auto& split : pending) {
+    RestoreSplitByTabIds(split.tab_ids, split.id, split.visual_data);
+  }
+}
