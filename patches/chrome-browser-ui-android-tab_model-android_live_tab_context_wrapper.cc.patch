+// Match PopulateTab's navigation filtering before advertising a complete pair.
+bool CanSaveSplitMember(sessions::LiveTab* tab) {
+  if (tab->IsInitialBlankNavigation())
+    return false;
+  for (int i = 0; i < tab->GetEntryCount(); ++i) {
+    const auto entry = tab->GetEntryAtIndex(i);
+    if (!entry.virtual_url().is_empty() &&
+        !entry.virtual_url().SchemeIs(dom_distiller::kDomDistillerScheme))
+      return true;
+  }
+  return false;
+}
