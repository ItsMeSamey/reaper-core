+    @Test
+    @Feature({"Browser", "Notifications"})
+    public void testExtensionProgressAndContextPreserveAttributionAndPrivacy() {
+        StandardNotificationBuilder builder =
+                (StandardNotificationBuilder) createAllOptionsBuilder(new PendingIntentProvider[2]);
+        builder.setImage(null);
+        builder.setExtensionContent(37, "Private transfer details", new String[0], new String[0]);
+        Notification notification = buildNotification(builder);
+
+        Assert.assertEquals(100, notification.extras.getInt(Notification.EXTRA_PROGRESS_MAX));
+        Assert.assertEquals(37, notification.extras.getInt(Notification.EXTRA_PROGRESS));
+        Assert.assertFalse(
+                notification.extras.getBoolean(Notification.EXTRA_PROGRESS_INDETERMINATE));
+        Assert.assertEquals(
+                "body\nPrivate transfer details",
+                notification.extras.getCharSequence(Notification.EXTRA_BIG_TEXT).toString());
+        Assert.assertEquals("origin", NotificationTestUtil.getExtraSubText(notification));
+        Assert.assertNotNull(notification.publicVersion);
+        Assert.assertEquals(
+                RuntimeEnvironment.getApplication().getString(R.string.notification_hidden_text),
+                NotificationTestUtil.getExtraText(notification.publicVersion));
+        Assert.assertEquals(
+                0, notification.publicVersion.extras.getInt(Notification.EXTRA_PROGRESS_MAX));
+        Assert.assertEquals(
+                0, notification.publicVersion.extras.getInt(Notification.EXTRA_PROGRESS));
+        Assert.assertFalse(
+                notification.publicVersion.extras.containsKey(Notification.EXTRA_BIG_TEXT));
+    }
+
+    @Test
+    @Feature({"Browser", "Notifications"})
+    public void testExtensionListPreservesItemsSummaryAndOrigin() {
+        StandardNotificationBuilder builder =
+                (StandardNotificationBuilder) createAllOptionsBuilder(new PendingIntentProvider[2]);
+        builder.setImage(null);
+        builder.setExtensionContent(
+                -1,
+                "Two updates",
+                new String[] {"First", "Second"},
+                new String[] {"Ready", "Waiting"});
+        Notification notification = buildNotification(builder);
+
+        Assert.assertEquals(
+                "android.app.Notification$InboxStyle",
+                notification.extras.getString(Notification.EXTRA_TEMPLATE));
+        CharSequence[] lines =
+                notification.extras.getCharSequenceArray(Notification.EXTRA_TEXT_LINES);
+        Assert.assertNotNull(lines);
+        Assert.assertEquals(2, lines.length);
+        Assert.assertEquals("First: Ready", lines[0].toString());
+        Assert.assertEquals("Second: Waiting", lines[1].toString());
+        Assert.assertEquals(
+                "body\nTwo updates",
+                notification.extras.getCharSequence(Notification.EXTRA_SUMMARY_TEXT).toString());
+        Assert.assertEquals("origin", NotificationTestUtil.getExtraSubText(notification));
+        Assert.assertFalse(
+                notification.publicVersion.extras.containsKey(Notification.EXTRA_TEXT_LINES));
+        Assert.assertFalse(
+                notification.publicVersion.extras.containsKey(Notification.EXTRA_SUMMARY_TEXT));
+    }
+
+    @Test
+    @Feature({"Browser", "Notifications"})
+    public void testExtensionProgressBoundaryValuesAreRetained() {
+        for (int progress : new int[] {0, 100}) {
+            StandardNotificationBuilder builder =
+                    (StandardNotificationBuilder)
+                            createAllOptionsBuilder(new PendingIntentProvider[2]);
+            builder.setImage(null);
+            builder.setExtensionContent(progress, "", new String[0], new String[0]);
+            Notification notification = buildNotification(builder);
+            Assert.assertEquals(progress, notification.extras.getInt(Notification.EXTRA_PROGRESS));
+            Assert.assertEquals(100, notification.extras.getInt(Notification.EXTRA_PROGRESS_MAX));
+        }
+    }
+
+    @Test
+    @Feature({"Browser", "Notifications"})
+    public void testReplacingExtensionPayloadClearsListProgressAndContext() {
+        StandardNotificationBuilder builder =
+                (StandardNotificationBuilder) createAllOptionsBuilder(new PendingIntentProvider[2]);
+        builder.setImage(null);
+        builder.setExtensionContent(37, "Old context", new String[] {"Old"}, new String[] {"Item"});
+        builder.setExtensionContent(-1, "", new String[0], new String[0]);
+        Notification notification = buildNotification(builder);
+        Assert.assertEquals(
+                "android.app.Notification$BigTextStyle",
+                notification.extras.getString(Notification.EXTRA_TEMPLATE));
+        Assert.assertEquals(
+                "body",
+                notification.extras.getCharSequence(Notification.EXTRA_BIG_TEXT).toString());
+        Assert.assertFalse(notification.extras.containsKey(Notification.EXTRA_TEXT_LINES));
+        Assert.assertEquals(0, notification.extras.getInt(Notification.EXTRA_PROGRESS_MAX));
+    }
