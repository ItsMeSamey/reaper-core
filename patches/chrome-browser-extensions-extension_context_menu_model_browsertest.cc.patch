+#if BUILDFLAG(IS_ANDROID)
+// Exercise the same native Options command used by the Android extension row
+// menu, including the actual extension navigation and its destination profile.
+class ExtensionOptionsIncognitoAndroidTest : public ExtensionBrowserTest {
+ public:
+  void SetUpOnMainThread() override {
+    ExtensionBrowserTest::SetUpOnMainThread();
+    original_profile_ = profile()->GetWeakPtr();
+    regular_browser_ = browser_window_interface()->GetWeakPtr();
+    for (auto* browser : GetAllBrowserWindowInterfaces()) {
+      initial_window_ids_.insert(browser->GetSessionID().id());
+    }
+    ASSERT_TRUE(HeldPendingTaskIds().empty());
+  }
+
+  void TearDownOnMainThread() override {
+    Java_BrowserWindowCreatorBridge_clearActivityCreationPauseForTesting(
+        base::android::AttachCurrentThread());
+    if (resumed_creation_outstanding_) {
+      // A resumed Activity is no longer in the held-task map. Do not allow it
+      // to complete after this test. If its callback cannot be observed through
+      // the options navigation, stop this harness process instead of leaking
+      // an unretired creation into a later test.
+      CHECK(base::test::RunUntil([this] {
+        return FindCompletedOptionsWindow();
+      })) << "Test-owned Options window creation did not retire";
+      resumed_creation_outstanding_ = false;
+    }
+    base::RunLoop().RunUntilIdle();
+    std::vector<base::WeakPtr<BrowserWindowInterface>> created_windows;
+    for (auto* browser : GetAllBrowserWindowInterfaces()) {
+      if (!initial_window_ids_.contains(browser->GetSessionID().id())) {
+        created_windows.push_back(browser->GetWeakPtr());
+      }
+    }
+    for (const auto& browser : created_windows) {
+      if (browser) {
+        browser->GetWindow()->Close();
+        CHECK(base::test::RunUntil([&browser] { return !browser; }))
+            << "Test-owned Options window did not close";
+      }
+    }
+    ExtensionBrowserTest::TearDownOnMainThread();
+  }
+
+  void PrepareOptions(bool split) {
+    auto manifest = base::DictValue()
+                        .Set("manifest_version", 3)
+                        .Set("name", "Incognito options destination")
+                        .Set("version", "1")
+                        .Set("action", base::DictValue())
+                        .Set("options_ui", base::DictValue()
+                                               .Set("page", "options.html")
+                                               .Set("open_in_tab", true));
+    if (split) {
+      manifest.Set("incognito", "split");
+    }
+    extension_dir_.WriteManifest(std::move(manifest));
+    extension_dir_.WriteFile(FILE_PATH_LITERAL("options.html"),
+                             "<html><body><div id='options-marker'>Options "
+                             "loaded</div></body></html>");
+    extension_ = LoadExtension(extension_dir_.UnpackedPath(),
+                               {.allow_in_incognito = true});
+    ASSERT_TRUE(extension_);
+    auto* incognito = CreateIncognitoBrowserWindow();
+    ASSERT_TRUE(incognito);
+    incognito_browser_ = incognito->GetWeakPtr();
+    ASSERT_TRUE(incognito->GetProfile()->IsOffTheRecord());
+    auto* tabs = TabListInterface::From(incognito);
+    ASSERT_TRUE(tabs);
+    ASSERT_TRUE(tabs->GetActiveTab());
+    ASSERT_TRUE(content::NavigateToURL(tabs->GetActiveTab()->GetContents(),
+                                       GURL("about:blank")));
+  }
+
+  void ExecuteOptions() {
+    ASSERT_TRUE(incognito_browser_);
+    ExtensionContextMenuModel menu(extension_.get(), incognito_browser_.get(),
+                                   /*is_pinned=*/false, nullptr,
+                                   /*can_show_icon_in_toolbar=*/true,
+                                   ContextMenuSource::kMenuItem);
+    ASSERT_TRUE(menu.GetIndexOfCommandId(ExtensionContextMenuModel::OPTIONS)
+                    .has_value());
+    ASSERT_TRUE(menu.IsCommandIdEnabled(ExtensionContextMenuModel::OPTIONS));
+    menu.ExecuteCommand(ExtensionContextMenuModel::OPTIONS, 0);
+  }
+
+  void ExpectLoadedOptions(BrowserWindowInterface* browser, Profile* expected) {
+    ASSERT_TRUE(browser);
+    auto* tabs = TabListInterface::From(browser);
+    ASSERT_TRUE(tabs);
+    ASSERT_TRUE(tabs->GetActiveTab());
+    auto* contents = tabs->GetActiveTab()->GetContents();
+    ASSERT_TRUE(contents);
+    EXPECT_EQ(expected, contents->GetBrowserContext());
+    ASSERT_TRUE(content::WaitForLoadStop(contents));
+    EXPECT_EQ(extension_->GetResourceURL("options.html"),
+              contents->GetLastCommittedURL());
+    EXPECT_EQ(
+        "Options loaded",
+        content::EvalJs(
+            contents, "document.getElementById('options-marker').textContent"));
+  }
+
+  void CheckExistingWindowDestination(bool split) {
+    ASSERT_NO_FATAL_FAILURE(PrepareOptions(split));
+    auto* regular_tabs = TabListInterface::From(regular_browser_.get());
+    auto* incognito_tabs = TabListInterface::From(incognito_browser_.get());
+    const int regular_count = regular_tabs->GetTabCount();
+    const int incognito_count = incognito_tabs->GetTabCount();
+    ASSERT_NO_FATAL_FAILURE(ExecuteOptions());
+    // Watch both destinations. The old spanning-mode implementation adds an
+    // Incognito tab, so fail a destination assertion instead of just timing
+    // out.
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return !regular_browser_ || !incognito_browser_ ||
+             regular_tabs->GetTabCount() != regular_count ||
+             incognito_tabs->GetTabCount() != incognito_count;
+    }));
+    ASSERT_TRUE(regular_browser_);
+    ASSERT_TRUE(incognito_browser_);
+    ASSERT_EQ(regular_count + (split ? 0 : 1), regular_tabs->GetTabCount());
+    ASSERT_EQ(incognito_count + (split ? 1 : 0), incognito_tabs->GetTabCount());
+    ASSERT_NO_FATAL_FAILURE(ExpectLoadedOptions(
+        split ? incognito_browser_.get() : regular_browser_.get(),
+        split ? incognito_browser_->GetProfile() : original_profile_.get()));
+  }
+
+  std::vector<int> HeldPendingTaskIds() {
+    JNIEnv* env = base::android::AttachCurrentThread();
+    std::vector<int> ids;
+    base::android::JavaIntArrayToIntVector(
+        env,
+        Java_BrowserWindowCreatorBridge_getHeldPendingTaskIdsForTesting(env),
+        &ids);
+    return ids;
+  }
+
+  void StartOptionsWithoutRegularWindow() {
+    ASSERT_NO_FATAL_FAILURE(PrepareOptions(/*split=*/false));
+    regular_browser_->GetWindow()->Close();
+    CHECK(base::test::RunUntil([this] { return !regular_browser_; }))
+        << "Initial regular browser did not close";
+    ASSERT_TRUE(original_profile_);
+    ASSERT_FALSE(
+        ProfileBrowserCollection::GetForProfile(original_profile_.get())
+            ->FindTabbedBrowser());
+    Java_BrowserWindowCreatorBridge_pauseActivityCreationForTesting(
+        base::android::AttachCurrentThread());
+    ASSERT_NO_FATAL_FAILURE(ExecuteOptions());
+    // CreateBrowserWindow synchronously registers this held task before it
+    // returns; only the subsequent Activity creation is delayed by the seam.
+    ASSERT_EQ(1u, HeldPendingTaskIds().size());
+  }
+
+  void ResumeOptionsWindow() {
+    auto ids = HeldPendingTaskIds();
+    ASSERT_EQ(1u, ids.size());
+    resumed_creation_outstanding_ = true;
+    Java_BrowserWindowCreatorBridge_resumePendingTaskActivityCreationForTesting(
+        base::android::AttachCurrentThread(), ids.front());
+    ASSERT_TRUE(
+        base::test::RunUntil([this] { return FindCompletedOptionsWindow(); }));
+    resumed_creation_outstanding_ = false;
+    base::RunLoop().RunUntilIdle();
+    ASSERT_TRUE(HeldPendingTaskIds().empty());
+  }
+
+ protected:
+  base::WeakPtr<Profile> original_profile_;
+  base::WeakPtr<BrowserWindowInterface> regular_browser_;
+  base::WeakPtr<BrowserWindowInterface> incognito_browser_;
+  scoped_refptr<const Extension> extension_;
+
+ private:
+  bool FindCompletedOptionsWindow() {
+    if (!original_profile_ || original_profile_->ShutdownStarted()) {
+      return false;
+    }
+    auto* collection =
+        ProfileBrowserCollection::GetForProfile(original_profile_.get());
+    auto* browser = collection ? collection->FindTabbedBrowser() : nullptr;
+    if (!browser) {
+      return false;
+    }
+    auto* tabs = TabListInterface::From(browser);
+    if (!tabs || !tabs->GetActiveTab()) {
+      return false;
+    }
+    auto* contents = tabs->GetActiveTab()->GetContents();
+    if (!contents || contents->GetLastCommittedURL() !=
+                         extension_->GetResourceURL("options.html")) {
+      return false;
+    }
+    regular_browser_ = browser->GetWeakPtr();
+    return true;
+  }
+
+  TestExtensionDir extension_dir_;
+  std::set<int> initial_window_ids_;
+  bool resumed_creation_outstanding_ = false;
+};
+
+IN_PROC_BROWSER_TEST_F(ExtensionOptionsIncognitoAndroidTest,
+                       SpanningOptionsUseOriginalProfile) {
+  CheckExistingWindowDestination(/*split=*/false);
+}
+
+IN_PROC_BROWSER_TEST_F(ExtensionOptionsIncognitoAndroidTest,
+                       SplitOptionsStayIncognito) {
+  CheckExistingWindowDestination(/*split=*/true);
+}
+
+IN_PROC_BROWSER_TEST_F(ExtensionOptionsIncognitoAndroidTest,
+                       SpanningOptionsCreateRegularWindow) {
+  ASSERT_NO_FATAL_FAILURE(StartOptionsWithoutRegularWindow());
+  const int incognito_count =
+      TabListInterface::From(incognito_browser_.get())->GetTabCount();
+  ASSERT_NO_FATAL_FAILURE(ResumeOptionsWindow());
+  ASSERT_NO_FATAL_FAILURE(
+      ExpectLoadedOptions(regular_browser_.get(), original_profile_.get()));
+  EXPECT_EQ(incognito_count,
+            TabListInterface::From(incognito_browser_.get())->GetTabCount());
+}
+
+#endif  // BUILDFLAG(IS_ANDROID)
+
 }  // namespace extensions
