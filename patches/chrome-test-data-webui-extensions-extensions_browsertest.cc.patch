+#if BUILDFLAG(ENABLE_GUEST_VIEW)
+class CrExtensionsRealOptionsGuestTest
+    : public CrExtensionsOptionsDialogTest,
+      public content::WebContentsObserver {
+ protected:
+  void OnWebContentsAvailable(content::WebContents* contents) override {
+    WebUIMochaBrowserTest::OnWebContentsAvailable(contents);
+    Observe(contents);
+    guest_manager_ = guest_manager_factory_.GetOrCreateTestGuestViewManager(
+        contents->GetBrowserContext(),
+        extensions::ExtensionsAPIClient::Get()->CreateGuestViewManagerDelegate());
+    ASSERT_EQ(0u, guest_manager_->num_guests_created());
+    guest_manager_->SetWillAttachCallback(base::BindOnce(
+        &CrExtensionsRealOptionsGuestTest::OnWillAttachGuest,
+        weak_factory_.GetWeakPtr()));
+  }
+
+  GURL expected_options_url_;
+  bool native_guest_verified_ = false;
+  raw_ptr<guest_view::TestGuestViewManager> guest_manager_ = nullptr;
+
+ private:
+  void OnWillAttachGuest(guest_view::GuestViewBase* guest) {
+    // The callback runs before AttachGuest. Waiting here would deadlock it.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&CrExtensionsRealOptionsGuestTest::VerifyAttachedGuest,
+                       weak_factory_.GetWeakPtr(), guest->guest_instance_id()));
+  }
+
+  void VerifyAttachedGuest(int instance_id) {
+    // Re-read the live guest each time: no raw guest pointer crosses a wait,
+    // and the same main-frame load condition works for MPArch and legacy.
+    const bool loaded = base::test::RunUntil([&] {
+      if (!web_contents()) {
+        return true;
+      }
+      auto* guest = guest_manager_->GetLastGuestViewCreated();
+      return guest && guest->guest_instance_id() == instance_id &&
+             guest->attached() && guest->GetGuestMainFrame() &&
+             guest->GetGuestMainFrame()->GetLastCommittedURL() ==
+                 expected_options_url_ &&
+             guest->GetGuestMainFrame()
+                 ->IsDocumentOnLoadCompletedInMainFrame();
+    });
+    auto* guest = guest_manager_->GetLastGuestViewCreated();
+    native_guest_verified_ =
+        loaded && web_contents() && guest && guest->attached() &&
+        guest->guest_instance_id() == instance_id &&
+        guest->GetViewType() == "extensionoptions" &&
+        guest->owner_web_contents() == web_contents() &&
+        guest->GetGuestMainFrame() &&
+        guest->GetGuestMainFrame()->GetLastCommittedURL() == expected_options_url_ &&
+        guest_manager_->GetCurrentGuestCount() == 1;
+    EXPECT_TRUE(native_guest_verified_);
+    if (web_contents()) {
+      // Coordinate assertions only. No guest event or callback is fabricated.
+      EXPECT_TRUE(content::ExecJs(
+          web_contents(),
+          content::JsReplace("window.reaperResolveOptionsGuestReady($1);",
+                             native_guest_verified_)));
+    }
+  }
+
+  // Register the testing factory before any browser context can create guests.
+  guest_view::TestGuestViewManagerFactory guest_manager_factory_;
+  base::WeakPtrFactory<CrExtensionsRealOptionsGuestTest> weak_factory_{this};
+};
+
+IN_PROC_BROWSER_TEST_F(CrExtensionsRealOptionsGuestTest,
+                       AndroidDirectOptionsGuestRendersAndCloses) {
+  const extensions::Extension* extension = InstallExtensionWithInPageOptions();
+  ASSERT_TRUE(extension);
+  expected_options_url_ = extension->GetResourceURL("options.html");
+  RunTestWithoutTestLoader(
+      "extensions/options_dialog_test.js",
+      "window.reaperOptionsGuestReady = new Promise(resolve => {"
+      "  window.reaperResolveOptionsGuestReady = resolve;"
+      "});"
+      "runMochaTest('ExtensionRealOptionsGuestTests', "
+      "'AndroidDirectOptionsGuestRendersAndCloses');");
+  EXPECT_TRUE(native_guest_verified_);
+  ASSERT_TRUE(guest_manager_);
+  EXPECT_EQ(1u, guest_manager_->num_guests_created());
+  guest_manager_->WaitForAllGuestsDeleted();
+  EXPECT_EQ(0u, guest_manager_->GetCurrentGuestCount());
+}
+#endif  // BUILDFLAG(ENABLE_GUEST_VIEW)
+#endif  // BUILDFLAG(IS_ANDROID)
