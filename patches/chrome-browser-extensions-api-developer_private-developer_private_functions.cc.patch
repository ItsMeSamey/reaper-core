+
+std::string DeveloperPrivateInstallFromFileFunction::EligibilityError() {
+  auto* contents = GetSenderWebContents();
+  if (!browser_context() || !contents || contents->IsBeingDestroyed() ||
+      contents->GetBrowserContext() != browser_context() ||
+      !render_frame_host() ||
+      render_frame_host() != contents->GetPrimaryMainFrame() ||
+      !render_frame_host()->IsActive()) {
+    return kCouldNotFindWebContentsError;
+  }
+  auto* profile = Profile::FromBrowserContext(browser_context());
+  if (profile->IsOffTheRecord() ||
+      supervised_user::AreExtensionsPermissionsEnabled(profile)) {
+    return "This profile cannot install local extension packages.";
+  }
+  if (!profile->GetPrefs()->GetBoolean(prefs::kExtensionsUIDeveloperMode)) {
+    return "Must be in developer mode to install a local extension package.";
+  }
+  // Signed packages can be specifically allowlisted even when installation
+  // is blocked by default. CrxInstaller checks the verified package policy.
+  return {};
+}
+
+ExtensionFunction::ResponseAction
+DeveloperPrivateInstallFromFileFunction::Run() {
+#if !BUILDFLAG(IS_ANDROID)
+  return RespondNow(
+      Error("Local package picker is only available on Android."));
+#else
+  if (!user_gesture()) {
+    return RespondNow(Error(kRequiresUserGestureError));
+  }
+  std::string error = EligibilityError();
+  if (!error.empty()) {
+    return RespondNow(Error(error));
+  }
+  auto* contents = GetSenderWebContents();
+  if (!accept_dialog_for_testing_.has_value() &&
+      !contents->GetTopLevelNativeWindow()) {
+    return RespondNow(Error(kCouldNotShowSelectFileDialogError));
+  }
+  Observe(contents);
+  pending_ = true;
+  AddRef();  // Balanced in Finish(), including synchronous picker callbacks.
+  if (accept_dialog_for_testing_.has_value()) {
+    CHECK_IS_TEST();
+    if (*accept_dialog_for_testing_) {
+      CHECK(selected_file_for_testing_.has_value());
+      FileSelected(*selected_file_for_testing_, 0);
+    } else {
+      FileSelectionCanceled();
+    }
+  } else {
+    select_file_dialog_ = ui::SelectFileDialog::Create(
+        this, std::make_unique<ChromeSelectFilePolicy>(contents));
+    select_file_dialog_->SetAcceptTypes({u".crx"});
+    // Use the ordinary read-only GET_CONTENT file picker. No writable or
+    // persistent document access is needed to copy and verify a CRX package.
+    select_file_dialog_->SelectFile(
+        ui::SelectFileDialog::SELECT_OPEN_FILE,
+        l10n_util::GetStringUTF16(IDS_EXTENSIONS_INSTALL_CRX), base::FilePath(),
+        nullptr, 0, base::FilePath::StringType(),
+        contents->GetTopLevelNativeWindow());
+  }
+  return did_respond() ? AlreadyResponded() : RespondLater();
+#endif
+}
+
+void DeveloperPrivateInstallFromFileFunction::FileSelected(
+    const ui::SelectedFileInfo& file,
+    int index) {
+  if (!pending_) {
+    return;
+  }
+  if (select_file_dialog_) {
+    select_file_dialog_->ListenerDestroyed();
+    select_file_dialog_.reset();
+  }
+  std::string error = EligibilityError();
+  if (!error.empty()) {
+    Finish(Error(error));
+    return;
+  }
+  const base::FilePath name = file.display_name.empty()
+                                  ? file.path()
+                                  : base::FilePath(file.display_name);
+  if (!name.MatchesExtension(FILE_PATH_LITERAL(".crx"))) {
+#if BUILDFLAG(IS_ANDROID)
+    Finish(
+        Error(l10n_util::GetStringUTF8(IDS_EXTENSIONS_INSTALL_CRX_FILE_ERROR)));
+#else
+    Finish(Error(kInvalidPathError));
+#endif
+    return;
+  }
+  auto installer =
+      CreateSettingsCrxInstaller(GetSenderWebContents(), browser_context());
+  installer->AddInstallerCallback(
+      base::BindOnce(&DeveloperPrivateInstallFromFileFunction::OnInstalled,
+                     weak_factory_.GetWeakPtr()));
+  // SandboxedUnpacker copies and verifies these exact selected bytes. Never
+  // mark this as a web download or reinterpret an automatic download as local.
+  installer->InstallCrx(file.path());
+}
+
+void DeveloperPrivateInstallFromFileFunction::OnInstalled(
+    const std::optional<CrxInstallError>& error) {
+  if (error) {
+    if (error->type() == CrxInstallErrorType::OTHER &&
+        error->detail() == CrxInstallErrorDetail::USER_CANCELED) {
+      Finish(WithArguments(false));
+    } else {
+#if BUILDFLAG(IS_ANDROID)
+      Finish(
+          Error(error->message().empty()
+                    ? l10n_util::GetStringUTF8(IDS_EXTENSIONS_INSTALL_CRX_ERROR)
+                    : base::UTF16ToUTF8(error->message())));
+#else
+      Finish(Error(base::UTF16ToUTF8(error->message())));
+#endif
+    }
+    return;
+  }
+  // Installation completion is not a claim of enablement: an update may still
+  // need the existing permission-escalation re-enable prompt.
+  Finish(WithArguments(true));
+}
+
+void DeveloperPrivateInstallFromFileFunction::FileSelectionCanceled() {
+  Finish(WithArguments(false));
+}
+
+void DeveloperPrivateInstallFromFileFunction::WebContentsDestroyed() {
+  Finish(WithArguments(false));
+}
+
+#if BUILDFLAG(IS_ANDROID)
+void DeveloperPrivateInstallFromFileFunction::PrimaryMainFrameRenderProcessGone(
+    base::TerminationStatus status) {
+  if (pending_ && web_contents()) {
+    web_contents()->SetUserData(&kInterruptedLocalImportKey,
+                               std::make_unique<InterruptedLocalImport>());
+  }
+  Finish(WithArguments(false));
+}
+#endif
+
+void DeveloperPrivateInstallFromFileFunction::DidStartNavigation(
+    content::NavigationHandle* navigation) {
+  if (navigation->IsInPrimaryMainFrame() &&
+      !navigation->IsSameDocument()) {
+    Finish(WithArguments(false));
+  }
+}
+
+void DeveloperPrivateInstallFromFileFunction::OnBrowserContextShutdown() {
+  Finish(WithArguments(false));
+}
+
+void DeveloperPrivateInstallFromFileFunction::Finish(ResponseValue result) {
+  if (!pending_) {
+    return;
+  }
+  pending_ = false;
+  weak_factory_.InvalidateWeakPtrs();
+  Observe(nullptr);
+  if (select_file_dialog_) {
+    select_file_dialog_->ListenerDestroyed();
+    select_file_dialog_.reset();
+  }
+  Respond(std::move(result));
+  Release();
 }
 
