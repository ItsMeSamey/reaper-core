+// Both explicit local-file selection and a real settings-page drop use the
+// existing local install policy, verifier and confirmation/update lifecycle.
+scoped_refptr<CrxInstaller> CreateSettingsCrxInstaller(
+    content::WebContents* web_contents,
+    content::BrowserContext* browser_context) {
+  auto prompt = std::make_unique<ExtensionInstallPrompt>(
+      web_contents, std::make_unique<extensions::InstallPromptData>(
+                        extensions::InstallPromptData::UNSET_PROMPT_TYPE));
+#if BUILDFLAG(IS_ANDROID)
+  // A delayed manual-import prompt belongs to the initiating document, even
+  // when unpacking or icon loading finishes after that document navigates.
+  prompt->CancelOnNavigation(web_contents);
+#endif
+  auto installer = CrxInstaller::Create(browser_context, std::move(prompt));
+  installer->set_error_on_unsupported_requirements(true);
+  installer->set_off_store_install_allow_reason(
+      CrxInstaller::OffStoreInstallAllowedFromSettingsPage);
+  installer->set_install_immediately(true);
+  return installer;
+}
