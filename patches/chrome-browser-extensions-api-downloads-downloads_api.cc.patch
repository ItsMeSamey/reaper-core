+#if BUILDFLAG(IS_ANDROID)
+// Re-read permission and incognito access when an asynchronous reveal finishes.
+// GetDownload() still supplies the API's normal ID/visibility authorization.
+bool CanRevealAndroidDownload(ExtensionFunction* function,
+                              Profile* item_profile) {
+  content::BrowserContext* context = function->browser_context();
+  if (!context || context->ShutdownStarted() || !item_profile ||
+      item_profile->ShutdownStarted()) {
+    return false;
+  }
+  Profile* caller_profile = Profile::FromBrowserContext(context);
+  if (item_profile->GetOriginalProfile() !=
+          caller_profile->GetOriginalProfile() ||
+      (item_profile->IsOffTheRecord() &&
+       !item_profile->IsPrimaryOTRProfile())) {
+    return false;
+  }
+  const Extension* current_extension =
+      ExtensionRegistry::Get(context)->enabled_extensions().GetByID(
+          function->extension_id());
+  if (!current_extension || current_extension != function->extension() ||
+      !current_extension->permissions_data()->HasAPIPermission(
+          APIPermissionID::kDownloads)) {
+    return false;
+  }
+  return !item_profile->IsOffTheRecord() ||
+         ((caller_profile->IsOffTheRecord() ||
+           function->include_incognito_information()) &&
+          util::IsIncognitoEnabled(current_extension, context) &&
+          item_profile->GetOriginalProfile()->GetPrimaryOTRProfile(false) ==
+              item_profile);
+}
+
+TabAndroid* GetAndroidDownloadRevealHost(ExtensionFunction* function,
+                                         Profile* item_profile) {
+  const auto usable_tab = [item_profile](content::WebContents* contents) {
+    TabAndroid* tab =
+        contents ? TabAndroid::FromWebContents(contents) : nullptr;
+    return tab && DownloadManagerService::CanShowDownloadItemForExtension(
+                      tab->GetJavaObject(), item_profile)
+               ? tab
+               : nullptr;
+  };
+  const auto usable_window = [function,
+                              item_profile](WindowController* window) {
+    if (!window || !window->GetBrowserWindowInterface() ||
+        window->GetBrowserWindowInterface()->IsDeleteScheduled() ||
+        window->profile()->GetOriginalProfile() !=
+            item_profile->GetOriginalProfile()) {
+      return false;
+    }
+    return windows_util::CanOperateOnWindow(function, window,
+                                            WindowController::kNoWindowFilter);
+  };
+
+  // Prefer the caller's tab, subject to the same window/profile access checks.
+  content::WebContents* sender = function->GetSenderWebContents();
+  for (WindowController* window : *WindowControllerList::GetInstance()) {
+    if (usable_window(window) && window->GetActiveTab() == sender) {
+      if (TabAndroid* tab = usable_tab(sender)) {
+        return tab;
+      }
+    }
+  }
+  WindowController* associated =
+      function->dispatcher()
+          ? function->dispatcher()->GetExtensionWindowController()
+          : nullptr;
+  if (usable_window(associated)) {
+    if (TabAndroid* tab = usable_tab(associated->GetActiveTab())) {
+      return tab;
+    }
+  }
+  // MV3 workers have no sender tab. Only a currently active, accessible browser
+  // window in the item's original profile may anchor the new Downloads surface.
+  for (WindowController* window : *WindowControllerList::GetInstance()) {
+    if (usable_window(window) && window->window()->IsActive()) {
+      if (TabAndroid* tab = usable_tab(window->GetActiveTab())) {
+        return tab;
+      }
+    }
+  }
+  return nullptr;
+}
+#endif
