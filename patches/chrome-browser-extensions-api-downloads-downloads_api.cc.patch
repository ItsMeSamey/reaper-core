+#if BUILDFLAG(IS_ANDROID)
+void DownloadsShowFunction::OnAndroidDownloadShown(bool shown) {
+  if (!waiting_for_android_show_) {
+    return;
+  }
+  if (!shown || !CanRevealAndroidDownload(this, android_item_profile_.get())) {
+    FinishAndroidShow(Error(download_extension_errors::kInvisibleContext));
+    return;
+  }
+  DownloadItem* item = GetDownload(
+      browser_context(), include_incognito_information(), android_download_id_);
+  if (!item || item->GetGuid() != android_download_guid_ ||
+      content::DownloadItemUtils::GetBrowserContext(item) !=
+          android_item_profile_.get()) {
+    FinishAndroidShow(Error(download_extension_errors::kInvalidId));
+    return;
+  }
+  FinishAndroidShow(NoArguments());
+}
+
+void DownloadsShowFunction::FinishAndroidShow(ResponseValue response) {
+  if (!waiting_for_android_show_) {
+    return;
+  }
+  waiting_for_android_show_ = false;
+  android_show_timeout_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  const int64_t token = std::exchange(android_show_token_, 0);
+  android_item_profile_.reset();
+  if (token) {
+    DownloadManagerService::CancelDownloadItemForExtension(token);
+  }
+  Respond(std::move(response));
+  Release();
+}
+
+void DownloadsShowFunction::OnBrowserContextShutdown() {
+  if (waiting_for_android_show_) {
+    FinishAndroidShow(Error(download_extension_errors::kInvisibleContext));
+  }
+}
+#endif

