 void IdentityLaunchWebAuthFlowFunction::CompleteAsyncRun(
     ResponseValue response) {
+#if BUILDFLAG(IS_ANDROID)
+  if (completion_started_) {
+    return;
+  }
+  completion_started_ = true;
+  registry_observation_.Reset();
+  if (auth_flow_) {
+    auth_flow_.release()->DetachDelegateAndDelete();
+  }
+  // Retire the old flow before replying. A test may retain this function, or a
+  // reply may start a new flow for the same extension ID.
+  auth_flow_tracker_.RunAndReset();
+  Respond(std::move(response));
+#else
   Respond(std::move(response));
   if (auth_flow_) {
     auth_flow_.release()->DetachDelegateAndDelete();
   }
+#endif
   Release();  // Balanced in Run.
 }
 
+#if BUILDFLAG(IS_ANDROID)
+void IdentityLaunchWebAuthFlowFunction::OnExtensionUnloaded(
+    content::BrowserContext* browser_context,
+    const Extension* extension,
+    UnloadedExtensionReason reason) {
+  if (browser_context != this->browser_context() ||
+      extension != this->extension() || completion_started_) {
+    return;
+  }
+  OnAuthFlowFailure(WebAuthFlow::WINDOW_CLOSED);
+}
+
+void IdentityLaunchWebAuthFlowFunction::OnShutdown(
+    ExtensionRegistry* registry) {
+  registry_observation_.Reset();
+  OnBrowserContextShutdown();
+}
+#endif
