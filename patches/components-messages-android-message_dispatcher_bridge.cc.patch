-MessageDispatcherBridge::MessageDispatcherBridge() = default;
-MessageDispatcherBridge::~MessageDispatcherBridge() = default;
+MessageDispatcherBridge::MessageDispatcherBridge() {
+  dispatcher_callbacks_.set_removal_callback(base::BindRepeating(
+      &MessageDispatcherBridge::OnDispatcherCallbacksRemoved,
+      base::Unretained(this)));
+}
+MessageDispatcherBridge::~MessageDispatcherBridge() {
+  DCHECK(dispatcher_callbacks_.empty());
+}
+
+base::CallbackListSubscription
+MessageDispatcherBridge::AddDispatcherChangedCallback(
+    base::RepeatingClosure callback) {
+  const bool was_empty = dispatcher_callbacks_.empty();
+  auto subscription = dispatcher_callbacks_.Add(std::move(callback));
+  if (was_empty) {
+    SetDispatcherNotificationsEnabled(true);
+  }
+  return subscription;
+}
+
+void MessageDispatcherBridge::OnDispatcherCallbacksRemoved() {
+  if (dispatcher_callbacks_.empty()) {
+    SetDispatcherNotificationsEnabled(false);
+  }
+}
+
+void MessageDispatcherBridge::SetDispatcherNotificationsEnabled(bool enabled) {
+  Java_MessageDispatcherBridge_setDispatcherNotificationsEnabled(
+      base::android::AttachCurrentThread(), enabled);
+}
+
+base::android::ScopedJavaLocalRef<jobject>
+MessageDispatcherBridge::GetMessageDispatcher(
+    const base::android::JavaRef<jobject>& java_window_android) {
+  if (java_window_android.is_null()) {
+    return {};
+  }
+  return Java_MessageDispatcherBridge_getMessageDispatcher(
+      base::android::AttachCurrentThread(), java_window_android);
+}
+
+void MessageDispatcherBridge::NotifyDispatcherChanged() {
+  dispatcher_callbacks_.Notify();
+}
+
+static void JNI_MessageDispatcherBridge_OnMessageDispatcherChanged(JNIEnv*) {
+  MessageDispatcherBridge::Get()->NotifyDispatcherChanged();
+}
 
