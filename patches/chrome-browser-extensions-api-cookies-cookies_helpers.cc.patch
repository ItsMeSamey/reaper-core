+content::StoragePartition* ChooseStoragePartitionFromStoreId(
+    const std::string& store_id,
+    content::BrowserContext* browser_context,
+    bool include_incognito) {
+#if BUILDFLAG(IS_ANDROID)
+  constexpr std::string_view kContainerStorePrefix = "container:";
+  if (store_id.starts_with(kContainerStorePrefix)) {
+    // A split-incognito worker cannot reach regular-profile containers.
+    if (browser_context->IsOffTheRecord()) {
+      return nullptr;
+    }
+    const std::string id = store_id.substr(kContainerStorePrefix.size());
+    auto* profile = Profile::FromBrowserContext(browser_context);
+    auto config =
+        containers::android::ResolveContainerStoragePartition(profile, id);
+    if (id.empty() || !config) {
+      return nullptr;
+    }
+    return profile->GetStoragePartition(*config);
+  }
+#endif
+  auto* context = ChooseBrowserContextFromStoreId(store_id, browser_context,
+                                                  include_incognito);
+  return context ? context->GetDefaultStoragePartition() : nullptr;
+}
+
+#if BUILDFLAG(IS_ANDROID)
+std::string GetContainerStoreId(const std::string& container_id) {
+  return "container:" + container_id;
+}
+#endif
