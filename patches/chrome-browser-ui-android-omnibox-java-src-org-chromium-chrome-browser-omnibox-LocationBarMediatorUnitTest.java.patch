+    @Test
+    public void delayedProfile_tabSwitchAttachesOnlyCurrentInput() {
+        SettableMonotonicObservableSupplier<Profile> supplier =
+                ObservableSuppliers.createMonotonic();
+        LocationBarMediator mediator = mediatorWithDelayedProfile(supplier);
+        doReturn(2).when(mUrlCoordinator).getSelectionStart();
+        doReturn(5).when(mUrlCoordinator).getSelectionEnd();
+        mediator.beginInput(new AutocompleteInput().setUserText("first draft"));
+        AutocompleteInput first = mSessionState.getAutocompleteInput();
+        LocationBarMediator.InputSession secondSession = new LocationBarMediator.InputSession();
+        doReturn(hostFor(secondSession)).when(mLocationBarDataProvider).getInputUserDataHost();
+        mediator.onTabChanged(null);
+        mediator.beginInput(new AutocompleteInput().setUserText("second draft"));
+        doReturn("second draft").when(mUrlCoordinator).getTextWithoutAutocomplete();
+        supplier.set(mProfile);
+        verify(mAutocompleteCoordinator)
+                .beginInput(
+                        same(secondSession.getAutocompleteInput()),
+                        eq(mAutocompleteController),
+                        eq(mProfile));
+        verify(mAutocompleteCoordinator, never()).beginInput(same(first), any(), any());
+        assertEquals("first draft", first.getUserText());
+        assertEquals(new TextSelection(2, 5), first.getSelection());
+        assertTrue(mSessionState.isSessionActive());
+        assertEquals(AutocompleteState.STANDBY, first.getAutocompleteState());
+        mediator.destroy();
+    }
