+    @Test
+    public void delayedProfile_retiredTabUserDataIsPassiveAndCannotAttach() {
+        SettableMonotonicObservableSupplier<Profile> supplier =
+                ObservableSuppliers.createMonotonic();
+        LocationBarMediator mediator = mediatorWithDelayedProfile(supplier);
+        mediator.beginInput(
+                new AutocompleteInput()
+                        .setUserText("retired draft")
+                        .setAutocompleteState(AutocompleteState.DISABLED));
+        AutocompleteInput input = mSessionState.getAutocompleteInput();
+        int[] mutations = {0};
+        input.getRequestTypeSupplier().addSyncObserver(value -> mutations[0]++);
+        input.getDisplayStateSupplier().addSyncObserver(value -> mutations[0]++);
+        input.getAutocompleteStateSupplier().addSyncObserver(value -> mutations[0]++);
+        mTabUserDataHost.destroy();
+        doReturn(null).when(mLocationBarDataProvider).getInputUserDataHost();
+        supplier.set(mProfile);
+        verify(mAutocompleteCoordinator, never()).beginInput(any(), any(), any());
+        assertFalse(mSessionState.isSessionActive());
+        assertEquals("retired draft", input.getUserText());
+        assertEquals(AutocompleteState.DISABLED, input.getAutocompleteState());
+        assertEquals(0, mutations[0]);
+        mediator.destroy();
+        assertEquals("retired draft", input.getUserText());
+        assertEquals(0, mutations[0]);
+    }
