+    @Test
+    public void splitMetadataSurvivesRealParcelWithRatioAndOrder() {
+        SplitInfo split = new SplitInfo(new Token(8, 9), 2, 1, SplitInfo.STACKED, 0.37);
+        TabGroupMetadata original = new TabGroupMetadata(SELECTED_TAB_ID, SOURCE_WINDOW_INDEX,
+                TAB_GROUP_ID, TAB_IDS_TO_URLS, TAB_GROUP_COLOR, TAB_GROUP_TITLE, MHTML_TAB_TITLE,
+                TAB_GROUP_COLLAPSED, IS_GROUP_SHARED, IS_INCOGNITO, List.of(split));
+        Parcel parcel = Parcel.obtain();
+        try {
+            parcel.writeBundle(original.toBundle());
+            parcel.setDataPosition(0);
+            TabGroupMetadata restored = TabGroupMetadata.maybeCreateFromBundle(
+                    parcel.readBundle(getClass().getClassLoader()));
+            assertThat(restored).isNotNull();
+            assertThat(restored.splits).containsExactly(split);
+            assertThat(restored).isEqualTo(original);
+        } finally {
+            parcel.recycle();
+        }
+    }
+
+    @Test
+    public void malformedSplitMetadataDoesNotDropTransferredTabs() {
+        Bundle bundle = mTabGroupMetadata.toBundle();
+        Bundle split = new Bundle();
+        split.putBundle("token", new Token(8, 9).toBundle());
+        split.putInt("first", 1);
+        split.putInt("second", 2);
+        split.putInt("layout", SplitInfo.SIDE_BY_SIDE);
+        split.putDouble("ratio", Double.NaN);
+        bundle.putParcelableArrayList("splitCollections", new ArrayList<>(List.of(split)));
+        TabGroupMetadata restored = TabGroupMetadata.maybeCreateFromBundle(bundle);
+        assertThat(restored).isNotNull();
+        assertThat(restored.splits).isEmpty();
+        assertThat(restored.tabIdsToUrls).containsExactlyElementsIn(TAB_IDS_TO_URLS).inOrder();
+    }
+
+    @Test
+    public void splitCannotReferToTabOutsideTransferredGroup() {
+        Bundle bundle = mTabGroupMetadata.toBundle();
+        Bundle split = new Bundle();
+        split.putBundle("token", new Token(8, 9).toBundle());
+        split.putInt("first", 1);
+        split.putInt("second", 999);
+        split.putInt("layout", SplitInfo.SIDE_BY_SIDE);
+        split.putDouble("ratio", 0.5);
+        bundle.putParcelableArrayList("splitCollections", new ArrayList<>(List.of(split)));
+        TabGroupMetadata restored = TabGroupMetadata.maybeCreateFromBundle(bundle);
+        assertThat(restored).isNotNull();
+        assertThat(restored.splits).isEmpty();
+        assertThat(restored.tabIdsToUrls).hasSize(TAB_IDS_TO_URLS.size());
+    }
