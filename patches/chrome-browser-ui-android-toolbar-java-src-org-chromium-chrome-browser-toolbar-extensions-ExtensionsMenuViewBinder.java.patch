+    private static void updateHostAccessRequestViews(
+            View view, PropertyModel model, List<ExtensionsMenuTypes.HostAccessRequest> requests) {
+        LinearLayout list = view.findViewById(R.id.extensions_request_access_list);
+        Map<String, ExtensionsMenuTypes.HostAccessRequest> requestsById = new HashMap<>();
+        if (requests != null) {
+            for (ExtensionsMenuTypes.HostAccessRequest request : requests) {
+                requestsById.put(request.extensionId, request);
+            }
+        }
+        Map<String, View> rowsById = new HashMap<>();
+        for (int i = list.getChildCount() - 1; i >= 0; --i) {
+            View row = list.getChildAt(i);
+            Object tag = row.getTag(R.id.extensions_request_access_list);
+            if (tag instanceof String id && requestsById.containsKey(id)) {
+                rowsById.put(id, row);
+            } else {
+                // Do not repurpose a removed control for another extension, including a click
+                // already queued on the old View. Let normal focus removal take its course.
+                row.findViewById(R.id.allow_button).setOnClickListener(null);
+                row.findViewById(R.id.dismiss_button).setOnClickListener(null);
+                list.removeViewAt(i);
+            }
+        }
+        if (requests == null) return;
+
+        LayoutInflater inflater = LayoutInflater.from(list.getContext());
+        for (int i = 0; i < requests.size(); ++i) {
+            ExtensionsMenuTypes.HostAccessRequest request = requests.get(i);
+            View row = rowsById.get(request.extensionId);
+            if (row == null) {
+                row = inflater.inflate(R.layout.extensions_request_access_item, list, false);
+                row.setTag(R.id.extensions_request_access_list, request.extensionId);
+            }
+            // Native updates retain the relative order of surviving IDs; additions are inserted
+            // in action order. Remove missing IDs first, then insert new rows without detaching
+            // surviving keyboard/accessibility-focused controls. Only a real reorder moves a row.
+            int oldIndex = list.indexOfChild(row);
+            if (oldIndex != i) {
+                if (oldIndex != -1) list.removeViewAt(oldIndex);
+                list.addView(row, i);
+            }
+            populateRequestView(row, model, request);
+        }
+    }
