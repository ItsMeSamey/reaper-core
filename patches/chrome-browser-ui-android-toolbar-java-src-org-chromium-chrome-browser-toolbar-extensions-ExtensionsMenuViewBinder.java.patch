+    private static void updateSiteSettingsToggleClickListener(PropertyModel model, View view) {
+        View toggleContainer = getSiteSettingsToggleContainer(view);
+        boolean visible = model.get(ExtensionsMenuProperties.SITE_SETTINGS_TOGGLE_VISIBLE);
+        MaterialSwitch toggle = view.findViewById(R.id.extensions_menu_site_settings_toggle);
+        OnCheckedChangeListener listener =
+                model.get(ExtensionsMenuProperties.SITE_SETTINGS_TOGGLE_CLICK_LISTENER);
+        toggleContainer.setOnClickListener(
+                visible
+                        ? v -> {
+                            toggle.toggle();
+                            if (listener != null) {
+                                listener.onCheckedChanged(toggle, toggle.isChecked());
+                            }
+                        }
+                        : null);
+        // Keep the information label readable without exposing a hidden toggle as an action.
+        toggleContainer.setClickable(visible);
+        toggleContainer.setFocusable(visible);
+    }
+
