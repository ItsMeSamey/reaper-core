 namespace autofill {
 
+#if BUILDFLAG(IS_ANDROID)
+namespace {
+
+// Keep persisted numeric type slots while rejecting removed UI requests.
+bool IsSupportedAndroidSnackbarType(AutofillSnackbarType type) {
+  return type != AutofillSnackbarType::kAutofillAiSaveToWalletFailure &&
+         type != AutofillSnackbarType::kAutofillAiFetchEntityFailure;
+}
+
+}  // namespace
+#endif  // BUILDFLAG(IS_ANDROID)
+
 AutofillSnackbarControllerImpl::AutofillSnackbarControllerImpl(
     content::WebContents* web_contents)
     : web_contents_(web_contents) {}
@@ -42,6 +54,11 @@ void AutofillSnackbarControllerImpl::ShowWithDurationAndCallback(
     base::OnceClosure on_action_clicked_callback,
     std::optional<base::OnceClosure> on_dismiss_callback) {
   CHECK_NE(autofill_snackbar_type, AutofillSnackbarType::kUnspecified);
+#if BUILDFLAG(IS_ANDROID)
+  if (!IsSupportedAndroidSnackbarType(autofill_snackbar_type)) {
+    return;
+  }
+#endif  // BUILDFLAG(IS_ANDROID)
   if (autofill_snackbar_view_) {
     // A snackbar is already showing. Ignore the new request.
     return;
@@ -64,6 +81,11 @@ void AutofillSnackbarControllerImpl::ShowPaymentsSnackbar(
     AutofillSnackbarType autofill_snackbar_type,
