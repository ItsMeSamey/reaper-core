+#if BUILDFLAG(IS_ANDROID) && BUILDFLAG(SAFE_BROWSING_AVAILABLE)
+IN_PROC_BROWSER_TEST_F(ExtensionTabUtilBrowserTest,
+                       AndroidExtensionHostHasPasswordReuseObserver) {
+  TestExtensionDir test_dir;
+  test_dir.WriteManifest(R"({
+    "name": "Password observer integration",
+    "version": "1",
+    "manifest_version": 3,
+    "action": {"default_popup": "popup.html"}
+  })");
+  test_dir.WriteFile(FILE_PATH_LITERAL("popup.html"),
+                     "<!doctype html><input type=password>");
+  const Extension* extension = LoadExtension(test_dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+
+  ExtensionHost host(extension, profile(), extension->GetResourceURL("popup.html"),
+                     mojom::ViewType::kExtensionPopup);
+  auto* observer = ChromePasswordReuseDetectionManagerClient::FromWebContents(
+      host.host_contents());
+  ASSERT_TRUE(observer);
+  auto* delegate = ExtensionsBrowserClient::Get()->GetSafeBrowsingDelegate();
+  delegate->CreatePasswordReuseDetectionManager(host.host_contents());
+  EXPECT_EQ(observer, ChromePasswordReuseDetectionManagerClient::FromWebContents(
+                          host.host_contents()));
+  EXPECT_FALSE(delegate->IsExtensionTelemetryServiceEnabled(profile()));
+}
+#endif  // BUILDFLAG(IS_ANDROID) && BUILDFLAG(SAFE_BROWSING_AVAILABLE)
+
 }  // namespace extensions
