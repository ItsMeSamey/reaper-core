diff --git a/scripts/build/ninja/devtools_entrypoint.gni b/scripts/build/ninja/devtools_entrypoint.gni
index 67b2aeb69f36619c0afb1d6ee979572658e9f1b7..827967bf10752d60a878b2e9d7dd671decf3e96c 100644
--- a/scripts/build/ninja/devtools_entrypoint.gni
+++ b/scripts/build/ninja/devtools_entrypoint.gni
@@ -56,6 +56,14 @@
 
     group(_sources_target) {
       forward_variables_from(invoker, [ "testonly" ])
+      if (defined(target_os) && target_os == "android" &&
+          defined(invoker.android_preprocess) && invoker.android_preprocess) {
+        metadata = {
+          android_processed_ts_files =
+              rebase_path(get_target_outputs(":${_ts_target}_android_preprocess"),
+                          root_gen_dir)
+        }
+      }
     }
 
     _bundle_deps = [ ":$_sources_target" ]
@@ -73,8 +81,19 @@
     # 2. Bundle from the source TS file to out/<config>/gen.
     bundle(_bundle_target) {
       entrypoint = invoker.entrypoint
+      if (defined(target_os) && target_os == "android" &&
+          defined(invoker.android_preprocess) && invoker.android_preprocess) {
+        _processed_entrypoint =
+            get_target_outputs(":${_ts_target}_android_preprocess")
+        entrypoint = _processed_entrypoint[0]
+        prefer_generated_ts = true
+      }
       output_file_location = "$target_gen_dir/$_file_name.js"
       deps = _bundle_deps
+      if (defined(target_os) && target_os == "android" &&
+          defined(invoker.android_preprocess) && invoker.android_preprocess) {
