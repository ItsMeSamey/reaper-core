diff --git a/scripts/build/typescript/ts_type_check.gni b/scripts/build/typescript/ts_type_check.gni
--- a/scripts/build/typescript/ts_type_check.gni
+++ b/scripts/build/typescript/ts_type_check.gni
@@ -10,6 +10,19 @@
 template("ts_type_check") {
   assert(defined(invoker.sources),
          "You must specify 'sources' for $target_name")
+
+  # The native compiler supports this scheduling option; legacy JS tsc does not.
+  _native_tsc_paths = [
+    "//third_party/typescript/linux-amd64/src/lib/tsc",
+    "//third_party/typescript/windows-amd64/src/lib/tsc.exe",
+    "//third_party/typescript/mac-arm64/src/lib/tsc",
+    "//third_party/typescript/mac-amd64/src/lib/tsc",
+  ]
+  _tsc_thread_args = []
+  if (defined(target_os) && target_os == "android" &&
+      filter_include([ tsc_binary ], _native_tsc_paths) != []) {
+    _tsc_thread_args = [ "--singleThreaded" ]
+  }
 
   _rootdir = "."
   if (defined(invoker.rootdir)) {
@@ -157,13 +170,15 @@
 
     outputs = [ _stamp_file ]
     response_file_contents = [
-      "--stamp",
-      rebase_path(_stamp_file, root_build_dir),
-      "--",
-      rebase_path(tsc_binary, root_build_dir),
-      "-p",
-      rebase_path(_tsconfig_file, root_build_dir),
-    ]
+                               "--stamp",
+                               rebase_path(_stamp_file, root_build_dir),
+                               "--",
+                               rebase_path(tsc_binary, root_build_dir),
+                             ] + _tsc_thread_args +
+                             [
+                               "-p",
+                               rebase_path(_tsconfig_file, root_build_dir),
+                             ]
 
     args = [ "@{{response_file_name}}" ]
 
