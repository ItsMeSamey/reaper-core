@@ -38,4 +38,49 @@
     "codemirror.next.js",
     "codemirror.next.js.map",
   ]
+
+  if (defined(target_os) && target_os == "android") {
+    # Keep one declaration identity for raw and generated TypeScript consumers.
+    # Runtime JavaScript and source maps still use the ordinary copy target.
+    sources -= [ "codemirror.next.d.ts" ]
+    public_deps = [
+      ":canonical_types",
+      ":bundle_tsconfig_ref",
+    ]
+  }
 }
+
+if (defined(target_os) && target_os == "android") {
+  _canonical_declaration_import =
+      rebase_path("codemirror.next.js", target_gen_dir)
+  group("canonical_types") {
+    public_inputs = [
+      "codemirror.next.d.ts",
+      "$target_gen_dir/codemirror.next.d.ts",
+    ]
+    public_deps = [ ":canonical_types_file" ]
+  }
+
+  generated_file("canonical_types_file") {
+    outputs = [ "$target_gen_dir/codemirror.next.d.ts" ]
+    output_conversion = "list lines"
+    contents = [ "export * from \"$_canonical_declaration_import\";" ]
+  }
+
+  # Match the standard prebuilt reference contract without duplicating types.
+  generated_file("bundle_tsconfig_ref") {
+    outputs = [ "$target_gen_dir/bundle-tsconfig.ref.json" ]
