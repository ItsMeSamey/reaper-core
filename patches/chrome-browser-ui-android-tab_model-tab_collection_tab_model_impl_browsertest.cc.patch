+// Uses the session adapter to test real collection semantics without requiring
+// compositor installation in this model fixture. Extension API tests separately
+// exercise the actual UI-capability-gated CreateSplit path.
+IN_PROC_BROWSER_TEST_F(TabCollectionTabModelImplTest, SplitRoundTripAndEvents) {
+  auto* list = GetTabListInterface();
+  auto* first = list->GetTab(0);
+  auto* second = list->OpenTab(GURL("about:blank"), -1);
+  ASSERT_TRUE(first && second);
+  auto id = split_tabs::SplitTabId::GenerateNew();
+  SplitChangeRecorder changes(list);
+  ASSERT_TRUE(RestoreSplitForTest(list, id, first, second));
+  EXPECT_EQ(first->GetSplit(), id);
+  EXPECT_EQ(second->GetSplit(), id);
+  EXPECT_EQ(list->ListSplits(), std::set<split_tabs::SplitTabId>{id});
+  EXPECT_EQ(changes.changes.size(), 2u);
+  list->Unsplit(id);
+  EXPECT_FALSE(first->GetSplit());
+  EXPECT_FALSE(second->GetSplit());
+  EXPECT_TRUE(list->ListSplits().empty());
+  EXPECT_EQ(changes.changes.size(), 4u);
+}
+
+IN_PROC_BROWSER_TEST_F(TabCollectionTabModelImplTest,
+                       ClosingOneSplitTabNormalizesSurvivor) {
+  auto* list = GetTabListInterface();
+  auto* first = list->GetTab(0);
+  auto* second = list->OpenTab(GURL("about:blank"), -1);
+  ASSERT_TRUE(first && second);
+  ASSERT_TRUE(RestoreSplitForTest(list, split_tabs::SplitTabId::GenerateNew(),
+                                  first, second));
+  list->CloseTab(first->GetHandle());
+  EXPECT_FALSE(second->GetSplit());
+  EXPECT_TRUE(list->ListSplits().empty());
+}
+
+IN_PROC_BROWSER_TEST_F(TabCollectionTabModelImplTest,
+                       PinningOneMemberDissolvesSplit) {
+  auto* list = GetTabListInterface();
+  auto* first = list->GetTab(0);
+  auto* second = list->OpenTab(GURL("about:blank"), -1);
+  ASSERT_TRUE(first && second);
+  ASSERT_TRUE(RestoreSplitForTest(list, split_tabs::SplitTabId::GenerateNew(),
+                                  first, second));
+  list->PinTab(first->GetHandle());
+  EXPECT_TRUE(first->IsPinned());
+  EXPECT_FALSE(second->IsPinned());
+  EXPECT_FALSE(first->GetSplit());
+  EXPECT_FALSE(second->GetSplit());
+  EXPECT_TRUE(list->ListSplits().empty());
+}
+
+IN_PROC_BROWSER_TEST_F(TabCollectionTabModelImplTest,
+                       InsertingBetweenSplitMembersDissolvesSplit) {
+  auto* list = GetTabListInterface();
+  auto* first = list->GetTab(0);
+  auto* second = list->OpenTab(GURL("about:blank"), -1);
+  ASSERT_TRUE(first && second);
+  ASSERT_TRUE(RestoreSplitForTest(list, split_tabs::SplitTabId::GenerateNew(),
+                                  first, second));
+  auto* inserted = list->OpenTab(GURL("about:blank"), 1);
+  ASSERT_TRUE(inserted);
+  EXPECT_EQ(list->GetIndexOfTab(inserted->GetHandle()), 1);
+  EXPECT_FALSE(first->GetSplit());
+  EXPECT_FALSE(second->GetSplit());
+  EXPECT_TRUE(list->ListSplits().empty());
+}
+
+IN_PROC_BROWSER_TEST_F(TabCollectionTabModelImplTest,
+                       GroupingAndUngroupingCompleteSplitPreservesToken) {
+  auto* list = GetTabListInterface();
+  auto* first = list->GetTab(0);
+  auto* second = list->OpenTab(GURL("about:blank"), -1);
+  ASSERT_TRUE(first && second);
+  auto id = split_tabs::SplitTabId::GenerateNew();
+  ASSERT_TRUE(RestoreSplitForTest(list, id, first, second));
+  auto group = list->CreateTabGroup({first->GetHandle(), second->GetHandle()});
+  ASSERT_TRUE(group);
+  EXPECT_EQ(first->GetGroup(), group);
+  EXPECT_EQ(second->GetGroup(), group);
+  EXPECT_EQ(first->GetSplit(), id);
+  EXPECT_EQ(second->GetSplit(), id);
+  list->Ungroup({first->GetHandle(), second->GetHandle()});
+  EXPECT_FALSE(first->GetGroup());
+  EXPECT_FALSE(second->GetGroup());
+  EXPECT_EQ(first->GetSplit(), id);
+  EXPECT_EQ(second->GetSplit(), id);
+}
+
+IN_PROC_BROWSER_TEST_F(TabCollectionTabModelImplTest,
+                       SplitRestoreRejectsMissingAdjacencyAndDuplicateId) {
+  auto* list = GetTabListInterface();
+  auto* first = list->GetTab(0);
+  auto* middle = list->OpenTab(GURL("about:blank"), -1);
+  auto* last = list->OpenTab(GURL("about:blank"), -1);
+  ASSERT_TRUE(first && middle && last);
+  auto id = split_tabs::SplitTabId::GenerateNew();
+  EXPECT_FALSE(RestoreSplitForTest(list, id, first, last));
+  EXPECT_TRUE(list->ListSplits().empty());
+  ASSERT_TRUE(RestoreSplitForTest(list, id, first, middle));
+  EXPECT_FALSE(RestoreSplitForTest(list, id, middle, last));
+  EXPECT_EQ(first->GetSplit(), id);
+  EXPECT_FALSE(last->GetSplit());
+}
+
+IN_PROC_BROWSER_TEST_F(TabCollectionTabModelImplTest,
+                       ReorderingSplitMembersPreservesTokenUntilMovedApart) {
+  auto* list = GetTabListInterface();
+  auto* first = list->GetTab(0);
+  auto* second = list->OpenTab(GURL("about:blank"), -1);
+  auto* other = list->OpenTab(GURL("about:blank"), -1);
+  ASSERT_TRUE(first && second && other);
+  auto id = split_tabs::SplitTabId::GenerateNew();
+  ASSERT_TRUE(RestoreSplitForTest(list, id, first, second));
+  SplitChangeRecorder changes(list);
+  list->MoveTab(second->GetHandle(), 0);
+  EXPECT_EQ(list->GetTab(0), second);
+  EXPECT_EQ(list->GetTab(1), first);
+  EXPECT_EQ(first->GetSplit(), id);
+  EXPECT_EQ(second->GetSplit(), id);
+  EXPECT_TRUE(changes.changes.empty());
+  list->MoveTab(first->GetHandle(), 2);
+  EXPECT_EQ(list->GetTab(0), second);
+  EXPECT_EQ(list->GetTab(1), other);
+  EXPECT_EQ(list->GetTab(2), first);
+  EXPECT_FALSE(first->GetSplit());
+  EXPECT_FALSE(second->GetSplit());
+  EXPECT_TRUE(list->ListSplits().empty());
+  EXPECT_EQ(changes.changes.size(), 2u);
+}
