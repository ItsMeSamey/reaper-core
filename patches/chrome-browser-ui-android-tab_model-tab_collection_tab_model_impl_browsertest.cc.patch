 namespace {
 
+bool RestoreSplitForTest(TabListInterface* list,
+                         split_tabs::SplitTabId id,
+                         tabs::TabInterface* first,
+                         tabs::TabInterface* second) {
+  auto* bridge = static_cast<TabModelJniBridge*>(list);
+  return TabModelJniBridge::RestoreSplit(
+      base::android::AttachCurrentThread(), bridge->GetJavaObject(), id.token(),
+      std::vector<int>{TabAndroid::FromTabInterface(first)->GetAndroidId(),
+                       TabAndroid::FromTabInterface(second)->GetAndroidId()},
+      0, 0.5);
+}
+
+class SplitChangeRecorder : public TabListInterfaceObserver {
+ public:
+  explicit SplitChangeRecorder(TabListInterface* list) : list_(list) {
+    list_->AddTabListInterfaceObserver(this);
+  }
+  ~SplitChangeRecorder() override {
+    list_->RemoveTabListInterfaceObserver(this);
+  }
+  void OnSplitChanged(TabListInterface&, tabs::TabInterface* tab) override {
+    changes.push_back(TabAndroid::FromTabInterface(tab)->GetAndroidId());
+  }
+  std::vector<int> changes;
+
+ private:
+  raw_ptr<TabListInterface> list_;
+};
