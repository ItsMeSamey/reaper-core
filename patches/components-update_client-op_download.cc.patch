+#if BUILDFLAG(IS_ANDROID)
+void DeliverAndroidDownloadResult(
+    scoped_refptr<Cancellation> cancellation,
+    base::OnceCallback<void(base::expected<base::FilePath, CategorizedError>)>
+        callback,
+    const CrxDownloader::Result& result) {
+  // Check on the delivery sequence: cancellation can also arrive after hash
+  // verification completed but before this queued result reaches the pipeline.
+  if (cancellation->IsCancelled()) {
+    auto complete = base::BindOnce(
+        std::move(callback),
+        base::unexpected<CategorizedError>(
+            {.category = ErrorCategory::kService,
+             .code = std::to_underlying(ServiceError::CANCELLED)}));
+    if (result.response.empty()) {
+      std::move(complete).Run();
+      return;
+    }
+    base::ThreadPool::PostTaskAndReply(
+        FROM_HERE, kTaskTraits,
+        base::BindOnce(
+            [](const base::FilePath& path) {
+              DeleteFileAndEmptyParentDirectory(path);
+            },
+            result.response),
+        std::move(complete));
+    return;
+  }
+  if (result.error) {
+    CHECK(result.response.empty());
+    std::move(callback).Run(base::unexpected<CategorizedError>(
+        {.category = ErrorCategory::kDownload,
+         .code = result.error,
+         .extra = result.extra_code1}));
+    return;
+  }
+  std::move(callback).Run(result.response);
+}
+#endif  // BUILDFLAG(IS_ANDROID)

