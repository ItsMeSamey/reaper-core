diff --git a/chrome/browser/notifications/notification_platform_bridge_android.cc b/chrome/browser/notifications/notification_platform_bridge_android.cc
--- a/chrome/browser/notifications/notification_platform_bridge_android.cc
+++ b/chrome/browser/notifications/notification_platform_bridge_android.cc
@@ -393,6 +393,27 @@
 
   int32_t j_notification_type = NotificationTypeToJava(notification_type);
 
+  const bool is_extension =
+      notification_type == NotificationHandler::Type::EXTENSION;
+  const bool is_extension_progress =
+      is_extension &&
+      notification.type() == message_center::NOTIFICATION_TYPE_PROGRESS;
+  // Optional fields survive update() type changes. Render the current type
+  // only.
+  if (is_extension &&
+      notification.type() != message_center::NOTIFICATION_TYPE_IMAGE) {
+    image_bitmap.reset();
+  }
+  std::vector<std::u16string> item_titles;
+  std::vector<std::u16string> item_messages;
+  if (is_extension &&
+      notification.type() == message_center::NOTIFICATION_TYPE_MULTIPLE) {
+    for (const auto& item : notification.items()) {
+      item_titles.push_back(item.title());
+      item_messages.push_back(item.message());
+    }
+  }
+
   Java_NotificationPlatformBridge_displayNotification(
       env, java_object_, notification.id(), j_notification_type,
       origin_url.spec(), scope_url.spec(), GetProfileId(profile),
@@ -406,7 +427,9 @@
           : (persistent_notification_metadata
                  ? persistent_notification_metadata->is_suspicious
                  : false),
-      skip_ua_buttons);
+      skip_ua_buttons, is_extension_progress ? notification.progress() : -1,
+      is_extension ? notification.context_message() : std::u16string(),
+      item_titles, item_messages);
 
   regenerated_notification_infos_[notification.id()] =
       RegeneratedNotificationInfo(scope_url, std::nullopt);
