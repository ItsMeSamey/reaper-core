+    @Test
+    public void destroy_detachesSiteSearchObserverAndIgnoresLaterChanges() {
+        Shadows.shadowOf(Looper.getMainLooper()).idle();
+        doReturn(mTemplateUrl).when(mTemplateUrlService).getTemplateUrlForKeyword("wiki");
+        mMediator.beginInput(mAutocompleteInput);
+        mAutocompleteInput.setSiteSearchData(new SiteSearchData("wiki", "Wikipedia"));
+        verify(mSearchEngineService)
+                .retrieveFavicon(eq(mTemplateUrl), mFaviconCallbackCaptor.capture());
+        var callback = mFaviconCallbackCaptor.getValue();
+        callback.onResult(new StatusIconResource("wiki_icon", null, 0));
+        assertEquals("wiki_icon", getIconIdentifierForTesting());
+        assertTrue(mAutocompleteInput.getSiteSearchDataSupplier().hasObservers());
+
+        mMediator.destroy();
+        assertFalse(mAutocompleteInput.getSiteSearchDataSupplier().hasObservers());
+        clearInvocations(mSearchEngineService);
+        mAutocompleteInput.setSiteSearchData(new SiteSearchData("wiki", "Updated Wikipedia"));
+        callback.onResult(new StatusIconResource("retired_icon", null, 0));
+        Shadows.shadowOf(Looper.getMainLooper()).idle();
+        verify(mSearchEngineService, never()).retrieveFavicon(any(), any());
+        assertEquals("wiki_icon", getIconIdentifierForTesting());
+    }
+
+    @Test
+    public void beginInput_replacementRejectsRetiredFaviconForEqualSiteSearchData() {
+        Shadows.shadowOf(Looper.getMainLooper()).idle();
+        doReturn(mTemplateUrl).when(mTemplateUrlService).getTemplateUrlForKeyword("wiki");
+        SiteSearchData data = new SiteSearchData("wiki", "Wikipedia");
+        mMediator.beginInput(mAutocompleteInput);
+        mAutocompleteInput.setSiteSearchData(data);
+        verify(mSearchEngineService)
+                .retrieveFavicon(eq(mTemplateUrl), mFaviconCallbackCaptor.capture());
+        var retiredCallback = mFaviconCallbackCaptor.getValue();
+        clearInvocations(mSearchEngineService);
+
+        AutocompleteInput replacement = new AutocompleteInput();
+        replacement.setSiteSearchData(data);
+        mMediator.beginInput(replacement);
+        assertFalse(mAutocompleteInput.getSiteSearchDataSupplier().hasObservers());
+        assertFalse(mAutocompleteInput.getPreviewMatchUrlSupplier().hasObservers());
+        assertFalse(mAutocompleteInput.getDisplayStateSupplier().hasObservers());
+        assertFalse(mAutocompleteInput.getAutocompleteStateSupplier().hasObservers());
+        assertTrue(replacement.getSiteSearchDataSupplier().hasObservers());
+        assertTrue(replacement.getPreviewMatchUrlSupplier().hasObservers());
+        assertTrue(replacement.getDisplayStateSupplier().hasObservers());
+        assertTrue(replacement.getAutocompleteStateSupplier().hasObservers());
+        verify(mSearchEngineService)
+                .retrieveFavicon(eq(mTemplateUrl), mFaviconCallbackCaptor.capture());
+        mFaviconCallbackCaptor.getValue().onResult(new StatusIconResource("current_icon", null, 0));
+        assertEquals("current_icon", getIconIdentifierForTesting());
+
+        retiredCallback.onResult(new StatusIconResource("retired_icon", null, 0));
+        assertEquals("current_icon", getIconIdentifierForTesting());
+        clearInvocations(mSearchEngineService);
+        mAutocompleteInput.setSiteSearchData(new SiteSearchData("stale", "Retired input"));
+        verify(mSearchEngineService, never()).retrieveFavicon(any(), any());
+        assertEquals("current_icon", getIconIdentifierForTesting());
+    }
