+    @Test
+    @Config(sdk = {33, 34})
+    public void testClosingAnimation_SameAnchorReplacementDoesNotReceiveOldCompletion() {
+        TestSideUiContainer oldContainer = startClosingSidePanel();
+        mCoordinator.unregisterSideUiContainer(oldContainer);
+        assertNull(mSideUiContainerView.getParent());
+        assertEquals(0, mRightAnchorContainer.getChildCount());
+        assertEquals(View.GONE, mRightAnchorContainer.getVisibility());
+        View replacementView = new View(mTestActivity);
+        TestSideUiContainer replacement =
+                new TestSideUiContainer(
+                        mCoordinator, replacementView, SideUiId.SIDE_PANEL, AnchorSide.RIGHT);
+        replacement.mHeightType = HeightType.WEB_CONTENTS;
+        doReturn(120).when(mTopControlsStacker).getVisibleTopControlsTotalHeight();
+        mCoordinator.registerSideUiContainer(replacement);
+
+        // A normal UI request first completes the older recorded transition, then opens this owner.
+        mCoordinator.updateUi(
+                new UiUpdateRequest(SideUiId.SIDE_PANEL, /* suppressAnimations= */ true));
+        mCoordinator.endAnimations();
+
+        assertEquals(1, oldContainer.mNumOnUiUpdateCompletedReceived);
+        assertEquals(1, replacement.mNumOnUiUpdateCompletedReceived);
+        assertEquals(
+                Integer.valueOf(replacement.mMaxWidthDp), replacement.mLastNewWidthOnUpdateCompleted);
+        assertEquals(HeightType.WEB_CONTENTS, replacement.mLastNewHeightTypeOnUpdateCompleted);
+        assertEquals(mRightAnchorContainer, replacementView.getParent());
+        assertEquals(replacement.mMaxWidthDp, replacementView.getWidth());
+        assertEquals(
+                HeightType.WEB_CONTENTS,
+                mCoordinator.getCurrentSideUiSpecs().getHeightType(AnchorSide.RIGHT));
+        verify(mSideUiObserver).onTransitionEnded(new SideUiSpecs(0, 0));
+        assertEquals(1, mRightAnchorContainer.getChildCount());
+
+        // The successor must also close normally without an abandoned predecessor child.
+        clearInvocations(mSideUiObserver);
+        replacement.mHasContentForTabMap.put(mTab, false);
+        mCoordinator.updateUi(
+                new UiUpdateRequest(SideUiId.SIDE_PANEL, /* suppressAnimations= */ false));
+        verify(mSideUiObserver).onTransitionBegun(any());
+        mCoordinator.endAnimations();
+        assertEquals(2, replacement.mNumOnUiUpdateCompletedReceived);
+        assertNull(replacementView.getParent());
+        assertEquals(0, mRightAnchorContainer.getChildCount());
+        assertEquals(View.GONE, mRightAnchorContainer.getVisibility());
+        assertEquals(0, replacementView.getLayoutParams().width);
+        verify(mSideUiObserver).onTransitionEnded(new SideUiSpecs(0, 0));
+    }
