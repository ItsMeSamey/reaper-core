+    @Test
+    @Config(sdk = {33, 34})
+    public void testClosingAnimation_UnregisteredOwnerDoesNotReceiveCompletion() {
+        TestSideUiContainer container = startClosingSidePanel();
+        int width = mSideUiContainerView.getLayoutParams().width;
+        mCoordinator.unregisterSideUiContainer(container);
+
+        mCoordinator.endAnimations();
+
+        assertNull(mCoordinator.getSideUiContainerById(SideUiId.SIDE_PANEL));
+        assertEquals(1, container.mNumOnUiUpdateCompletedReceived);
+        assertEquals(width, mSideUiContainerView.getLayoutParams().width);
+        assertNull(mSideUiContainerView.getParent());
+        assertEquals(0, mRightAnchorContainer.getChildCount());
+        assertEquals(View.GONE, mRightAnchorContainer.getVisibility());
+        verify(mSideUiObserver).onTransitionEnded(new SideUiSpecs(0, 0));
+    }
+
+    @Test
+    @Config(sdk = {33, 34})
+    public void testClosingAnimation_DestroyedCoordinatorDoesNotNotify() {
+        TestSideUiContainer container = startClosingSidePanel();
+        int width = mSideUiContainerView.getLayoutParams().width;
+        mCoordinator.destroy();
+
+        mCoordinator.endAnimations();
+
+        assertNull(mCoordinator.getSideUiContainerById(SideUiId.SIDE_PANEL));
+        assertEquals(1, container.mNumOnUiUpdateCompletedReceived);
+        assertEquals(width, mSideUiContainerView.getLayoutParams().width);
+        verify(mSideUiObserver, never()).onTransitionEnded(any());
+        assertEquals(1, mBrowserControlsVisibilityDelegate.mReleaseCount);
+    }
