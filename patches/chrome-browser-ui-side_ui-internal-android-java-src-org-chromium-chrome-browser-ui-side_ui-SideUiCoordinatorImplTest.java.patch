+    @Test
+    @Config(sdk = {33, 34})
+    public void testClosingAnimation_RetiredOwnerPreservesHealthyCompletion() {
+        View leftView = new View(mTestActivity);
+        TestSideUiContainer left =
+                new TestSideUiContainer(
+                        mCoordinator, leftView, SideUiId.VERTICAL_TABS, AnchorSide.LEFT);
+        TestSideUiContainer right =
+                new TestSideUiContainer(
+                        mCoordinator, mSideUiContainerView, SideUiId.SIDE_PANEL, AnchorSide.RIGHT);
+        mCoordinator.registerSideUiContainer(left);
+        mCoordinator.registerSideUiContainer(right);
+        mCoordinator.updateUi(
+                new UiUpdateRequest(/* sideUiId= */ null, /* suppressAnimations= */ true));
+        assertEquals(1, left.mNumOnUiUpdateCompletedReceived);
+        assertEquals(1, right.mNumOnUiUpdateCompletedReceived);
+        left.mHasContentForTabMap.put(mTab, false);
+        right.mHasContentForTabMap.put(mTab, false);
+        mCoordinator.addObserver(mSideUiObserver);
+        clearInvocations(mSideUiObserver);
+        mCoordinator.updateUi(
+                new UiUpdateRequest(/* sideUiId= */ null, /* suppressAnimations= */ false));
+        verify(mSideUiObserver).onTransitionBegun(any());
+        mCoordinator.unregisterSideUiContainer(right);
+
+        mCoordinator.endAnimations();
+
+        assertEquals(2, left.mNumOnUiUpdateCompletedReceived);
+        assertEquals(Integer.valueOf(0), left.mLastNewWidthOnUpdateCompleted);
+        assertEquals(0, leftView.getLayoutParams().width);
+        assertNull(leftView.getParent());
+        assertEquals(1, right.mNumOnUiUpdateCompletedReceived);
+        assertEquals(View.GONE, mLeftAnchorContainer.getVisibility());
+        verify(mSideUiObserver).onTransitionEnded(new SideUiSpecs(0, 0));
+    }
+
+    private TestSideUiContainer startClosingSidePanel() {
+        TestSideUiContainer container =
+                new TestSideUiContainer(
+                        mCoordinator, mSideUiContainerView, SideUiId.SIDE_PANEL, AnchorSide.RIGHT);
+        mCoordinator.registerSideUiContainer(container);
+        mCoordinator.updateUi(
+                new UiUpdateRequest(SideUiId.SIDE_PANEL, /* suppressAnimations= */ true));
+        assertEquals(1, container.mNumOnUiUpdateCompletedReceived);
+        assertTrue(mSideUiContainerView.getWidth() > 0);
+        container.mHasContentForTabMap.put(mTab, false);
+        mCoordinator.addObserver(mSideUiObserver);
+        clearInvocations(mSideUiObserver);
+        mCoordinator.updateUi(
+                new UiUpdateRequest(SideUiId.SIDE_PANEL, /* suppressAnimations= */ false));
+        verify(mSideUiObserver).onTransitionBegun(any());
+        return container;
+    }
