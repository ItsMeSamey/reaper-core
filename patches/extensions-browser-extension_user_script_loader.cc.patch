+#if BUILDFLAG(IS_ANDROID)
+ExtensionUserScriptLoader::DynamicScriptOperation
+ExtensionUserScriptLoader::BeginDynamicScriptOperation(
+    const std::set<std::string>& script_ids, bool for_update) {
+  DynamicScriptOperation operation = base::UnguessableToken::Create();
+  auto& epochs = dynamic_script_operations_[operation];
+  for (const auto& id : script_ids) {
+    auto& state = dynamic_script_states_[id];
+    if (for_update && !IsDynamicScriptRegistrationCurrent(id)) {
+      continue;
+    }
+    if (state.epoch.is_empty() ||
+        (state.operations.empty() && !state.legacy_pending &&
+         state.committed.is_empty())) {
+      state.epoch = base::UnguessableToken::Create();
+    }
+    epochs.emplace(id, state.epoch);
+    state.operations.insert(operation);
+    pending_dynamic_script_ids_.insert(id);
+  }
+  return operation;
+}
+
+bool ExtensionUserScriptLoader::IsDynamicScriptRegistrationCurrent(
+    const std::string& id) const {
+  auto state = dynamic_script_states_.find(id);
+  return state != dynamic_script_states_.end() &&
+         !state->second.epoch.is_empty() &&
+         !state->second.committed.is_empty() &&
+         state->second.committed != state->second.retired_committed;
+}
+
+bool ExtensionUserScriptLoader::IsCurrentDynamicScriptOperation(
+    const DynamicScriptOperation& operation,
+    const std::string& id) const {
+  auto pending = dynamic_script_operations_.find(operation);
+  if (pending == dynamic_script_operations_.end()) {
+    return false;
+  }
+  auto epoch = pending->second.find(id);
+  auto state = dynamic_script_states_.find(id);
+  return epoch != pending->second.end() &&
+         state != dynamic_script_states_.end() &&
+         state->second.epoch == epoch->second &&
+         state->second.operations.contains(operation);
+}
+
+void ExtensionUserScriptLoader::FinishDynamicScriptOperation(
+    const DynamicScriptOperation& operation) {
+  auto pending = dynamic_script_operations_.extract(operation);
+  if (pending.empty()) {
+    return;
+  }
+  for (const auto& [id, epoch] : pending.mapped()) {
+    auto state = dynamic_script_states_.find(id);
+    if (state == dynamic_script_states_.end() || state->second.epoch != epoch) {
+      continue;
+    }
+    state->second.operations.erase(operation);
+    if (state->second.submitted == operation) {
+      state->second.submitted = DynamicScriptOperation();
+      state->second.submitted_script.reset();
+    }
+    if (state->second.operations.empty() && !state->second.legacy_pending) {
+      pending_dynamic_script_ids_.erase(id);
+    }
+  }
+  PruneDynamicScriptStates();
+}
+
+void ExtensionUserScriptLoader::PruneDynamicScriptStates() {
+  // Cancellation tombstones must survive until the raw StateStore input has
+  // been filtered, even when disabled sources need no native shared-memory load.
+  if (initial_dynamic_scripts_read_pending_) {
+    return;
+  }
+  std::erase_if(dynamic_script_states_, [this](const auto& entry) {
+    const auto& [id, state] = entry;
+    // An unused epoch is not ownership. Old replies still carry their unique
+    // epoch and cannot claim a newly created state after this entry is erased.
+    return state.operations.empty() && !state.submitted_script &&
+           state.committed.is_empty() && !state.legacy_pending &&
+           !pending_dynamic_script_ids_.contains(id);
+  });
+}
+
+ExtensionUserScriptLoader::DynamicScriptOwners
+ExtensionUserScriptLoader::CaptureDynamicScriptOwners(
+    const std::set<std::string>& ids) {
+  DynamicScriptOwners owners;
+  for (const auto& id : ids) {
+    auto& state = dynamic_script_states_[id];
+    if (state.committed.is_empty() &&
+        std::ranges::any_of(loaded_dynamic_scripts_, [&id](const auto& script) {
+          return script->id() == id;
+        })) {
+      state.committed = base::UnguessableToken::Create();
+    }
+    owners.emplace(id, state.committed);
+  }
+  return owners;
+}
+
+void ExtensionUserScriptLoader::AddOwnedDynamicScripts(
+    DynamicScriptOperation operation,
+    UserScriptList scripts,
+    std::set<std::string> persistent_script_ids,
+    DynamicScriptsModifiedCallback callback) {
+  std::erase_if(scripts, [this, &operation](const auto& script) {
+    return !IsCurrentDynamicScriptOperation(operation, script->id());
+  });
+  if (scripts.empty()) {
+    FinishDynamicScriptOperation(operation);
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+
+  UserScriptList scripts_to_add;
+  std::set<std::string> admitted_ids;
+  for (const auto& script : scripts) {
+    admitted_ids.insert(script->id());
+    dynamic_script_states_.at(script->id()).submitted = operation;
+    dynamic_script_states_.at(script->id()).submitted_script =
+        CopyDynamicScriptInfo(*script);
+    if (!disabled_sources_.contains(script->GetSource())) {
+      scripts_to_add.push_back(CopyDynamicScriptInfo(*script));
+    }
+  }
+  std::erase_if(persistent_script_ids, [&admitted_ids](const auto& id) {
+    return !admitted_ids.contains(id);
+  });
+
+  if (scripts_to_add.empty()) {
+    OnOwnedDynamicScriptsAdded(operation, std::move(scripts),
+                              std::move(persistent_script_ids),
+                              std::move(callback), std::nullopt);
+    return;
+  }
+  AddScripts(
+      std::move(scripts_to_add),
+      base::BindOnce(
+          [](base::WeakPtr<ExtensionUserScriptLoader> owner,
+             DynamicScriptOperation operation, UserScriptList scripts,
+             std::set<std::string> persistent_ids,
+             DynamicScriptsModifiedCallback callback, UserScriptLoader*,
+             const std::optional<std::string>& error) {
+            // Keep the terminal client outside the weak receiver. Base-loader
+            // destruction must still balance the API's response and reference.
+            if (!owner) {
+              std::move(callback).Run(error);
+              return;
+            }
+            owner->OnOwnedDynamicScriptsAdded(
+                operation, std::move(scripts), std::move(persistent_ids),
+                std::move(callback), error);
+          },
+          weak_factory_.GetWeakPtr(), operation, std::move(scripts),
+          std::move(persistent_script_ids), std::move(callback)));
+}
+
+void ExtensionUserScriptLoader::UpdateOwnedDynamicScripts(
+    DynamicScriptOperation operation,
+    UserScriptList scripts,
+    std::set<std::string> persistent_script_ids,
+    DynamicScriptsModifiedCallback callback) {
+  std::set<std::string> ids;
+  for (const auto& script : scripts) {
+    if (IsCurrentDynamicScriptOperation(operation, script->id())) {
+      ids.insert(script->id());
+    }
+  }
+  if (!ids.empty()) {
+    // Remove old base bytes without unregistering this registration epoch.
+    RemoveScripts(
+        ids, base::BindOnce(
+                 &ExtensionUserScriptLoader::OnOwnedDynamicScriptsRemoved,
+                 weak_factory_.GetWeakPtr(), CaptureDynamicScriptOwners(ids),
+                 DynamicScriptOperation(), base::DoNothing()));
+  }
+  AddOwnedDynamicScripts(operation, std::move(scripts),
+                         std::move(persistent_script_ids), std::move(callback));
+}
+
+void ExtensionUserScriptLoader::OnOwnedDynamicScriptsAdded(
+    DynamicScriptOperation operation,
+    UserScriptList scripts,
+    std::set<std::string> persistent_ids,
+    DynamicScriptsModifiedCallback callback,
+    const std::optional<std::string>& error,
+    bool restoring_persisted_scripts) {
+  // Previously persisted registrations remain registered even if native
+  // publication fails on startup. A failed new API registration must not.
+  if (!error || restoring_persisted_scripts) {
+    for (auto& script : scripts) {
+      const std::string id = script->id();
+      if (!IsCurrentDynamicScriptOperation(operation, id) ||
+          dynamic_script_states_.at(id).submitted != operation) {
+        continue;
+      }
+      // Coalesced base loads contain the latest submitted bytes. Older
+      // completions must not commit different derived metadata or persistence.
+      std::erase_if(loaded_dynamic_scripts_, [&id](const auto& loaded) {
+        return loaded->id() == id;
+      });
+      dynamic_script_states_.at(id).committed = operation;
+      dynamic_script_states_.at(id).retirement = DynamicScriptOperation();
+      dynamic_script_states_.at(id).retired_committed =
+          base::UnguessableToken();
+      if (persistent_ids.contains(id)) {
+        persistent_dynamic_script_ids_.insert(id);
+      } else {
+        persistent_dynamic_script_ids_.erase(id);
+      }
+      loaded_dynamic_scripts_.push_back(std::move(script));
+    }
+    if (!error) {
+      helper_.SetDynamicScripts(loaded_dynamic_scripts_,
+                                persistent_dynamic_script_ids_);
+    }
+  }
+  FinishDynamicScriptOperation(operation);
+  std::move(callback).Run(error);
+}
+
+void ExtensionUserScriptLoader::OnOwnedDynamicScriptsRemoved(
+    DynamicScriptOwners owners,
+    DynamicScriptOperation retirement,
+    DynamicScriptsModifiedCallback callback,
+    UserScriptLoader*,
+    const std::optional<std::string>& error) {
+  if (!error) {
+    for (const auto& [id, owner] : owners) {
+      auto state = dynamic_script_states_.find(id);
+      if (state == dynamic_script_states_.end() ||
+          state->second.committed != owner ||
+          (!retirement.is_empty() &&
+           state->second.retirement != retirement) ||
+          (owner.is_empty() && !state->second.epoch.is_empty())) {
+        continue;
+      }
+      std::erase_if(loaded_dynamic_scripts_, [&id](const auto& script) {
+        return script->id() == id;
+      });
+      state->second.committed = base::UnguessableToken();
+      state->second.retired_committed = base::UnguessableToken();
+      state->second.retirement = DynamicScriptOperation();
+      persistent_dynamic_script_ids_.erase(id);
+    }
+    helper_.SetDynamicScripts(loaded_dynamic_scripts_,
+                              persistent_dynamic_script_ids_);
+  } else if (!retirement.is_empty()) {
+    for (const auto& [id, owner] : owners) {
+      auto state = dynamic_script_states_.find(id);
+      if (owner.is_empty() || state == dynamic_script_states_.end() ||
+          state->second.committed != owner ||
+          state->second.retired_committed != owner ||
+          state->second.retirement != retirement) {
+        continue;
+      }
+      // Restore only this failed retirement of the still-published owner.
+      // Newer removals and pending-only cancellations keep their tombstones.
+      state->second.retired_committed = base::UnguessableToken();
+      state->second.retirement = DynamicScriptOperation();
+      if (state->second.epoch.is_empty()) {
+        // Never revive an epoch carried by a reply canceled by unregister.
+        state->second.epoch = base::UnguessableToken::Create();
+      }
+    }
+  }
+  PruneDynamicScriptStates();
+  std::move(callback).Run(error);
+}
+#endif

