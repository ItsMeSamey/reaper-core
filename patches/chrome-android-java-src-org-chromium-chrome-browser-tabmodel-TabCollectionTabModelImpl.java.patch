+    @Override
+    public @Nullable SplitInfo getSplitInfoForTab(int tabId) {
+        Tab tab = getTabById(tabId);
+        if (tab == null || mNativeTabCollectionTabModelImplPtr == 0) return null;
+        Token token = tab.getSplitTabId();
+        if (token == null) return null;
+        Tab first = null;
+        Tab second = null;
+        for (Tab candidate : getAllTabs()) {
+            if (!token.equals(candidate.getSplitTabId())) continue;
+            if (first == null) first = candidate;
+            else if (second == null) second = candidate;
+            else return null;
+        }
+        if (first == null || second == null || indexOf(second) != indexOf(first) + 1) return null;
+        try {
+            return new SplitInfo(token, first.getId(), second.getId(), first.getSplitLayout(),
+                    first.getSplitRatio());
+        } catch (IllegalArgumentException invalid) {
+            return null;
+        }
+    }
+
+    private Map<Token, SplitInfo> getSplitSnapshots() {
+        Map<Token, SplitInfo> splits = new ArrayMap<>();
+        List<Tab> tabs = getAllTabs();
+        int i = 0;
+        while (i + 1 < tabs.size()) {
+            Tab first = tabs.get(i);
+            Tab second = tabs.get(i + 1);
+            Token token = first.getSplitTabId();
+            if (token == null
+                    || !token.equals(second.getSplitTabId())
+                    || first.getSplitPosition() != 0
+                    || second.getSplitPosition() != 1) {
+                i++;
+                continue;
+            }
+            splits.put(token, new SplitInfo(token, first.getId(), second.getId(),
+                    first.getSplitLayout(), first.getSplitRatio()));
+            i += 2;
+        }
+        return splits;
+    }
+
+    @Override
+    protected @Nullable Token createSplit(List<Tab> tabs) {
+        assertOnUiThread();
+        if (!mSplitViewAvailable || tabs.size() != 2 || tabs.get(0) == tabs.get(1)
+                || (TabStateStorageFlagHelper.isTabStorageEnabled()
+                        && TabStateStorageFlagHelper.isStorageAuthoritative())) return null;
+        Tab first = tabs.get(0);
+        Tab second = tabs.get(1);
+        if (indexOf(first) > indexOf(second)) {
+            first = tabs.get(1);
+            second = tabs.get(0);
+        }
+        if (!canRestoreSplit(first, second)) return null;
+        Token token = Token.createRandom();
+        try (ScopedStorageBatch ignored = mBatchFactory.get();
+                SplitMutation mutation = beginSplitMutation()) {
+            if (!restoreSplitInternal(new SplitInfo(token, first.getId(), second.getId(),
+                    SplitInfo.SIDE_BY_SIDE, 0.5))) return null;
+        }
+        return token;
+    }
+
+    @Override
+    protected void unsplit(Token token) {
+        assertOnUiThread();
+        if (mNativeTabCollectionTabModelImplPtr == 0) return;
+        try (ScopedStorageBatch ignored = mBatchFactory.get();
+                SplitMutation mutation = beginSplitMutation()) {
+            mExplicitlyUnsplit.add(token);
+            TabCollectionTabModelImplJni.get().unsplit(mNativeTabCollectionTabModelImplPtr, token);
+        }
+    }
+
+    private boolean canRestoreSplit(@Nullable Tab first, @Nullable Tab second) {
+        return mNormalSplitWindow && mNativeTabCollectionTabModelImplPtr != 0
+                && first != null && second != null && first != second
+                && getTabById(first.getId()) == first && getTabById(second.getId()) == second
+                && indexOf(first) >= 0 && indexOf(second) == indexOf(first) + 1
+                && !first.isClosing() && !second.isClosing()
+                && first.getProfile() == getProfile() && second.getProfile() == getProfile()
+                && first.getSplitTabId() == null && second.getSplitTabId() == null
+                && first.getIsPinned() == second.getIsPinned()
+                && Objects.equals(first.getTabGroupId(), second.getTabGroupId());
+    }
+
+    private boolean restoreSplitInternal(SplitInfo split) {
+        Tab first = getTabById(split.getFirstTabId());
+        Tab second = getTabById(split.getSecondTabId());
+        if (!canRestoreSplit(first, second)) return false;
+        return TabCollectionTabModelImplJni.get().createSplit(
+                mNativeTabCollectionTabModelImplPtr, split.getToken(),
+                List.of(assumeNonNull(first), assumeNonNull(second)),
+                split.getLayout(), split.getRatio());
+    }
+
+    @Override
+    public boolean restoreSplit(SplitInfo split) {
+        assertOnUiThread();
+        try (ScopedStorageBatch ignored = mBatchFactory.get();
+                SplitMutation mutation = beginSplitMutation()) {
+            return restoreSplitInternal(split);
+        }
+    }
+
+    private SplitMutation beginSplitMutation() {
+        return new SplitMutation();
+    }
+
+    private void batchSplitAttributes(Tab tab) {
+        if (mSplitMutationDepth == 0 || tab.isDestroyed() || tab.getUserDataHost() == null) return;
+        TabStateAttributesRegistry registry = tab.getUserDataHost()
+                .getUserData(TabStateAttributesRegistry.class);
+        if (registry == null) return;
+        for (TabStateAttributes attributes : registry.getAllAttributes()) {
+            if (mSplitAttributeBatches.add(attributes)) attributes.beginBatchEdit();
+        }
+    }
+
+    private void finishSplitAttributeBatches() {
+        List<TabStateAttributes> attributes = new ArrayList<>(mSplitAttributeBatches);
+        mSplitAttributeBatches.clear();
+        for (TabStateAttributes entry : attributes) entry.endBatchEdit();
+    }
+
+    /** Keeps collection normalization and notifications atomic across nested model operations. */
+    private final class SplitMutation implements AutoCloseable {
+        SplitMutation() {
+            if (mSplitMutationDepth++ == 0) {
+                mSplitsBeforeMutation = getSplitSnapshots();
+                mSelectionBeforeSplitMutation = new LinkedHashSet<>(mMultiSelectedTabs);
+                mExplicitlyUnsplit.clear();
+                for (Tab tab : getAllTabs()) batchSplitAttributes(tab);
+            }
+        }
+
+        @Override
+        public void close() {
+            if (--mSplitMutationDepth != 0) return;
+            if (mNativeTabCollectionTabModelImplPtr == 0) {
+                finishSplitAttributeBatches();
+                return;
+            }
+            // Keep the depth nonzero while reconstructing/adjusting selection: existing selection
+            // observers may reenter model methods. Publish only complete collection states.
+            mSplitMutationDepth = 1;
+            Map<Token, SplitInfo> before = mSplitsBeforeMutation;
+            for (SplitInfo split : before.values()) {
+                if (mExplicitlyUnsplit.contains(split.getToken())) continue;
+                Tab first = getTabById(split.getFirstTabId());
+                Tab second = getTabById(split.getSecondTabId());
+                if (first != null && second != null && indexOf(first) > indexOf(second)) {
+                    restoreSplitInternal(new SplitInfo(split.getToken(), second.getId(),
+                            first.getId(), split.getLayout(), split.getRatio()));
+                } else {
+                    restoreSplitInternal(split);
+                }
+            }
+            for (SplitInfo split : new ArrayList<>(mClosedSplitSnapshots.values())) {
+                if (mExplicitlyUnsplit.contains(split.getToken())) {
+                    mClosedSplitSnapshots.remove(split.getToken());
+                    continue;
+                }
+                if (restoreSplitInternal(split)) {
+                    mClosedSplitSnapshots.remove(split.getToken());
+                    Tab first = getTabById(split.getFirstTabId());
+                    Tab second = getTabById(split.getSecondTabId());
+                    if (first != null) first.clearSplitDataForClosure();
+                    if (second != null) second.clearSplitDataForClosure();
+                } else if (!isClosurePending(split.getFirstTabId())
+                        && !isClosurePending(split.getSecondTabId())) {
+                    mClosedSplitSnapshots.remove(split.getToken());
+                }
+            }
+            Map<Token, SplitInfo> after = getSplitSnapshots();
+            Set<Integer> changed = new LinkedHashSet<>();
+            Set<Integer> membersChanged = new LinkedHashSet<>();
+            for (SplitInfo old : before.values()) {
+                SplitInfo current = after.get(old.getToken());
+                if (old.equals(current)) continue;
+                changed.add(old.getFirstTabId());
+                changed.add(old.getSecondTabId());
+                if (current == null) {
+                    membersChanged.add(old.getFirstTabId());
+                    membersChanged.add(old.getSecondTabId());
+                    Tab active = mCurrentTabSupplier.get();
+                    for (int id : new int[] {old.getFirstTabId(), old.getSecondTabId()}) {
+                        if (active == null || active.getId() != id) mMultiSelectedTabs.remove(id);
+                    }
+                }
+            }
+            for (SplitInfo current : after.values()) {
+                if (current.equals(before.get(current.getToken()))) continue;
+                changed.add(current.getFirstTabId());
+                changed.add(current.getSecondTabId());
+                if (!before.containsKey(current.getToken())) {
+                    membersChanged.add(current.getFirstTabId());
+                    membersChanged.add(current.getSecondTabId());
+                    Tab active = mCurrentTabSupplier.get();
+                    if ((active != null && current.contains(active.getId()))
+                            || mMultiSelectedTabs.contains(current.getFirstTabId())
+                            || mMultiSelectedTabs.contains(current.getSecondTabId())) {
+                        mMultiSelectedTabs.add(current.getFirstTabId());
+                        mMultiSelectedTabs.add(current.getSecondTabId());
+                    }
+                }
+            }
+            Tab selected = mCurrentTabSupplier.get();
+            if (selected != null) {
+                SplitInfo activeSplit = getSplitInfoForTab(selected.getId());
+                if (activeSplit != null) {
+                    mMultiSelectedTabs.add(activeSplit.getFirstTabId());
+                    mMultiSelectedTabs.add(activeSplit.getSecondTabId());
+                }
+            }
+            mSplitMutationDepth = 0;
+            mSplitsBeforeMutation = new ArrayMap<>();
+            mExplicitlyUnsplit.clear();
+            boolean selectionChanged = !mSelectionBeforeSplitMutation.equals(mMultiSelectedTabs);
+            if (changed.isEmpty() && !selectionChanged) {
+                finishSplitAttributeBatches();
+                return;
+            }
+            int[] changedIds = new int[changed.size()];
+            int changedIndex = 0;
+            for (int tabId : changed) {
+                changedIds[changedIndex++] = tabId;
+            }
+            boolean membershipChanged = !membersChanged.isEmpty();
+            // Persistence observers capture synchronously. Release their existing batch only
+            // after all native membership, pin/group and Java selection values are final.
+            finishSplitAttributeBatches();
+            // Do not access the native model after notification: observers can destroy it.
+            if (selectionChanged) {
+                for (TabModelObserver observer : mTabModelObservers) {
+                    observer.onTabsSelectionChanged();
+                }
+            }
+            if (changedIds.length != 0) {
+                for (TabModelObserver observer : mTabModelObservers) {
+                    observer.didChangeSplit(changedIds.clone(), membershipChanged);
+                }
+            }
+        }
+    }
