+#if BUILDFLAG(IS_ANDROID)
+TEST_F(OpDownloadTest, AndroidCancelledVerifiedDownloadCleansOwnedPath) {
+  for (bool keep_sibling : {false, true}) {
+    SCOPED_TRACE(keep_sibling);
+    base::ScopedTempDir download_dir;
+    ASSERT_TRUE(download_dir.CreateUniqueTempDir());
+    const base::FilePath directory = download_dir.GetPath();
+    const base::FilePath file = directory.Append(FILE_PATH_LITERAL("update.crx"));
+    const base::FilePath sibling = directory.Append(FILE_PATH_LITERAL("keep.txt"));
+    if (keep_sibling) {
+      ASSERT_TRUE(base::WriteFile(sibling, "keep"));
+    }
+    const std::string data = "ordinary update data";
+    auto config = base::MakeRefCounted<TestConfigurator>(pref_.get());
+    config->SetCrxDownloaderFactory(
+        base::MakeRefCounted<FakeFactory>(file, data));
+    int completion_count = 0;
+    base::expected<base::FilePath, CategorizedError> outcome;
+    auto cancel = DownloadOperation(
+        config, "appid", /*is_foreground=*/false,
+        {GURL("http://localhost:111")}, data.size(),
+        base::HexEncode(crypto::SHA256HashString(data)), MakePingCallback(),
+        base::DoNothing(), MakeProgressCallback(), {},
+        base::BindLambdaForTesting(
+            [&](base::expected<base::FilePath, CategorizedError> result) {
+              ++completion_count;
+              outcome = std::move(result);
+            }));
+
+    // The fake transport has written its successful result; the real hash
+    // verification reply cannot run on this sequence until tasks are pumped.
+    ASSERT_TRUE(base::PathExists(file));
+    EXPECT_EQ(completion_count, 0);
+    std::move(cancel).Run();
+    task_environment_.RunUntilIdle();
+
+    EXPECT_EQ(completion_count, 1);
+    ASSERT_FALSE(outcome.has_value());
+    EXPECT_EQ(outcome.error().category, ErrorCategory::kService);
+    EXPECT_EQ(outcome.error().code,
+              std::to_underlying(ServiceError::CANCELLED));
+    EXPECT_FALSE(base::PathExists(file));
+    EXPECT_EQ(base::DirectoryExists(directory), keep_sibling);
+    if (keep_sibling) {
+      std::string sibling_data;
+      ASSERT_TRUE(base::ReadFileToString(sibling, &sibling_data));
+      EXPECT_EQ(sibling_data, "keep");
+    }
+    EXPECT_TRUE(pings_.empty());
+  }
+}
+#endif  // BUILDFLAG(IS_ANDROID)
+
