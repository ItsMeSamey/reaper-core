diff --git a/pdf/pdf_view_web_plugin.cc b/pdf/pdf_view_web_plugin.cc
--- a/pdf/pdf_view_web_plugin.cc
+++ b/pdf/pdf_view_web_plugin.cc
@@ -44,6 +44,7 @@
 #include "base/threading/thread_checker.h"
 #include "base/time/time.h"
 #include "base/values.h"
+#include "build/build_config.h"
 #include "cc/paint/paint_canvas.h"
 #include "cc/paint/paint_flags.h"
 #include "cc/paint/paint_image.h"
@@ -2800,8 +2801,15 @@
     if (new_image_size != old_image_size) {
       // Ignore the result. If the allocation fails, the image data buffer
       // will be empty and the code below will handle that.
+#if BUILDFLAG(IS_ANDROID)
+      // The engine buffer uses PDFium's BGRA order, independent of Skia N32.
+      (void)image_data_.tryAllocPixels(SkImageInfo::Make(
+          new_image_size.width(), new_image_size.height(),
+          kBGRA_8888_SkColorType, alpha_type));
+#else
       (void)image_data_.tryAllocPixels(SkImageInfo::MakeN32(
           new_image_size.width(), new_image_size.height(), alpha_type));
+#endif
       first_paint_ = true;
     }
   }
