+    private static final class RecyclerRowAdapter
+            extends RecyclerView.Adapter<RecyclerView.ViewHolder> {
+        private final int mItemWidth;
+        private int mRowCount = 1;
+
+        RecyclerRowAdapter(int itemWidth) {
+            mItemWidth = itemWidth;
+        }
+
+        void addRow() {
+            ++mRowCount;
+            // A full adapter refresh avoids introducing a second automatic item-animation owner.
+            notifyDataSetChanged();
+        }
+
+        @Override
+        public RecyclerView.ViewHolder onCreateViewHolder(ViewGroup parent, int viewType) {
+            View item = new View(parent.getContext());
+            item.setLayoutParams(new RecyclerView.LayoutParams(mItemWidth, 64));
+            return new RecyclerView.ViewHolder(item) {};
+        }
+
+        @Override
+        public void onBindViewHolder(RecyclerView.ViewHolder holder, int position) {}
+
+        @Override
+        public int getItemCount() {
+            return mRowCount;
+        }
+    }
