+    /** A real Recycler/ItemAnimator/platform-transition owner, separate from the mock delegate. */
+    private static final class RecyclerTransitionFixture implements AutoCloseable {
+        private final boolean mWasChoreographerPaused = ShadowChoreographer.isPaused();
+        final ActivityController<Activity> mController =
+                Robolectric.buildActivity(Activity.class).setup();
+        final FrameLayout mRoot = new FrameLayout(mController.get());
+        final ExtensionActionListRecyclerView mRecycler =
+                new ExtensionActionListRecyclerView(mController.get());
+        final RecyclerRowAdapter mAdapter;
+        final DefaultItemAnimator mAnimator;
+        final int mItemWidth;
+
+        RecyclerTransitionFixture() {
+            // Idle posted layout work without automatically advancing every animation frame.
+            ShadowChoreographer.setPaused(true);
+            try {
+                mItemWidth = mRecycler.getResources()
+                        .getDimensionPixelSize(R.dimen.toolbar_button_width);
+                mAdapter = new RecyclerRowAdapter(mItemWidth);
+                mRecycler.setAdapter(mAdapter);
+                mRecycler.setTransitionRoot(mRoot);
+                mRoot.addView(mRecycler, new FrameLayout.LayoutParams(mItemWidth, 64));
+                mController.get().setContentView(mRoot);
+                mController.visible();
+                layout();
+                mRoot.getViewTreeObserver().dispatchOnPreDraw();
+                runFrame();
+                assertTrue(mRoot.isAttachedToWindow());
+                assertTrue(mRoot.isLaidOut());
+                assertNotNull(mRoot.getWindowId());
+                assertEquals(mItemWidth, mRecycler.getWidth());
+                assertTrue(mRecycler.getItemAnimator() instanceof DefaultItemAnimator);
+                mAnimator = (DefaultItemAnimator) mRecycler.getItemAnimator();
+                mAnimator.setAddDuration(1000);
+                mAnimator.setMoveDuration(1000);
+            } catch (RuntimeException | Error e) {
+                ShadowChoreographer.setPaused(mWasChoreographerPaused);
+                throw e;
+            }
+        }
+
+        void runFrame() {
+            // Let the normal traversal release ViewRoot's sync barrier while Choreographer
+            // stays paused. One frame does not complete the 1000ms width transition.
+            shadowOf(Looper.getMainLooper()).idleFor(ShadowChoreographer.getFrameDelay());
+        }
+
+        void layout() {
+            mRoot.measure(View.MeasureSpec.makeMeasureSpec(640, View.MeasureSpec.EXACTLY),
+                    View.MeasureSpec.makeMeasureSpec(80, View.MeasureSpec.EXACTLY));
+            mRoot.layout(0, 0, 640, 80);
+        }
+
+        void beginWidthTransition() {
+            RecyclerView.ViewHolder holder = mRecycler.findViewHolderForAdapterPosition(0);
+            assertNotNull(holder);
+            int startWidth = mItemWidth * mAdapter.getItemCount();
+            mAdapter.addRow();
+            // The real ItemAnimator completion listener owns this ordinary holder reference.
+            holder.setIsRecyclable(false);
+            assertTrue(mAnimator.animateAdd(holder));
+            mAnimator.runPendingAnimations();
+            layout();
+            mRoot.getViewTreeObserver().dispatchOnPreDraw();
+            assertEquals(mItemWidth * mAdapter.getItemCount(),
+                    mRecycler.getLayoutParams().width);
+            // ChangeBounds rewinds the actual laid-out view to its nonzero start bounds.
+            // This must be a running transition, rather than a no-op endTransitions witness.
+            assertEquals(startWidth, mRecycler.getWidth());
+            assertTrue(mRecycler.getLayoutParams().width > mRecycler.getWidth());
+        }
+
+        void layoutWithoutItemAnimation() {
+            mAnimator.endAnimations();
+            assertFalse(mAnimator.isRunning());
+            ViewGroup.LayoutParams params = mRecycler.getLayoutParams();
+            ++params.height;
+            mRecycler.setLayoutParams(params);
+            layout();
+            runFrame();
+        }
+
+        @Override
+        public void close() {
+            try {
+                mRecycler.clearOnAnimationsFinishedRunnables();
+                TransitionManager.endTransitions(mRoot);
+                mAnimator.endAnimations();
+                mController.pause().stop().destroy();
+            } finally {
+                ShadowChoreographer.setPaused(mWasChoreographerPaused);
+            }
+        }
+    }
