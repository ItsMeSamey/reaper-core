diff --git a/chrome/app/theme/BUILD.gn b/chrome/app/theme/BUILD.gn
--- a/chrome/app/theme/BUILD.gn
+++ b/chrome/app/theme/BUILD.gn
@@ -45,6 +45,22 @@
   ]
 
   output_dir = "$root_gen_dir/chrome"
