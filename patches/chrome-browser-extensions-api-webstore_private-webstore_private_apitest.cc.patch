+IN_PROC_BROWSER_TEST_F(ExtensionWebstorePrivateDocumentApiTest,
+                       LiveSenderAdmitsPrompt) {
+  ASSERT_NO_FATAL_FAILURE(BeginWithHeldIcon());
+  ReleaseIcon();
+  ASSERT_NO_FATAL_FAILURE(ExpectPromptThenCancel());
+}
