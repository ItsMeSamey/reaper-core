+class ExtensionWebstorePrivateDocumentApiTest
+    : public ExtensionWebstorePrivateApiTest {
+ public:
+  ExtensionWebstorePrivateDocumentApiTest() {
+    features_.InitWithFeaturesAndParameters(
+        content::GetDefaultEnabledBackForwardCacheFeaturesForTesting(),
+        content::GetDefaultDisabledBackForwardCacheFeaturesForTesting());
+  }
+
+  void SetUpOnMainThread() override {
+    // The base fixture starts this server, so install the held route first.
+    icon_response_ =
+        std::make_unique<net::test_server::ControllableHttpResponse>(
+            embedded_test_server(), "/cws-held-icon.png");
+    ExtensionWebstorePrivateApiTest::SetUpOnMainThread();
+    ASSERT_FALSE(HasFatalFailure());
+    host_resolver()->AddRule("other.example.com", "127.0.0.1");
+
+    {
+      base::ScopedAllowBlockingForTesting allow_blocking;
+      ASSERT_TRUE(base::ReadFileToString(
+          test_data_dir_.AppendASCII(
+              "api_test/webstore_private/extension/icon.png"),
+          &icon_bytes_));
+    }
+    ASSERT_FALSE(icon_bytes_.empty());
+    ASSERT_FALSE(tracker()->GetActiveInstall(kExtensionId));
+
+    // Override the base ACCEPT scope: these tests require actual prompt entry
+    // and cancellation through the real owning tab.
+    no_auto_confirm_ = std::make_unique<ScopedTestDialogAutoConfirm>(
+        ScopedTestDialogAutoConfirm::NONE);
+    prompt_reset_ =
+        std::make_unique<base::AutoReset<InstallPromptData::PromptType>>(
+            &ExtensionInstallPrompt::g_last_prompt_type_for_tests,
+            InstallPromptData::UNSET_PROMPT_TYPE);
+    function_slot_reset_ =
+        std::make_unique<base::AutoReset<scoped_refptr<BeginInstallFunction>*>>(
+            &g_observed_begin_install, &function_);
+
+    auto& registry = ExtensionFunctionRegistry::GetInstance();
+    const auto original = registry.GetFactoriesForTesting().at(
+        BeginInstallFunction::static_function_name());
+    ASSERT_TRUE(registry.OverrideFunctionForTesting(
+        BeginInstallFunction::static_function_name(),
+        &ObserveBeginInstallFunction));
+    restore_factory_.ReplaceClosure(base::BindOnce(
+        [](ExtensionFunctionRegistry::FactoryEntry entry) {
+          ExtensionFunctionRegistry::GetInstance().Register(entry);
+        },
+        original));
+  }
+
+  void TearDownOnMainThread() override {
+    // A fatal assertion must not strand a held fetch or a native dialog that
+    // owns the production function across fixtures. A timeout here is a fatal
+    // harness quiescence failure, not permission to continue with live work.
+    if (request_sender_ && !request_sender_->IsDestroyed()) {
+      CHECK(request_contents_);
+      // ExecJs can fail after sending the API request. Retire its exact
+      // associated LocalFrameHost receiver before restoring the factory, even
+      // if no function was captured. Disabling BFCache also flushes cached A.
+      content::DisableBackForwardCacheForTesting(
+          request_contents_.get(),
+          content::BackForwardCache::DisableForTestingReason::
+              TEST_REQUIRES_NO_CACHING);
+      if (!request_sender_->IsDestroyed() &&
+          request_sender_->get() == request_contents_->GetPrimaryMainFrame()) {
+        CHECK(chrome_test_utils::NavigateToURL(
+            request_contents_.get(), OtherURL("/title2.html?sender-cleanup")));
+      }
+      CHECK(
+          base::test::RunUntil([&] { return request_sender_->IsDestroyed(); }));
+    }
+    if (function_) {
+      if (!icon_released_ && !function_->did_respond()) {
+        CHECK(base::test::RunUntil([&] {
+          return icon_response_->has_received_request() ||
+                 function_->did_respond();
+        }));
+      }
+      if (!icon_released_ && icon_response_->has_received_request()) {
+        ReleaseIcon();
+      }
+      if (!function_->did_respond()) {
+        CHECK(base::test::RunUntil(
+            [&] { return function_->did_respond() || PromptAdmitted(); }));
+        if (!function_->did_respond()) {
+          CHECK(request_contents_);
+          CHECK(chrome_test_utils::NavigateToURL(
+              request_contents_.get(), OtherURL("/title2.html?cleanup")));
+        }
+        CHECK(base::test::RunUntil([&] { return function_->did_respond(); }));
+      }
+      function_.reset();
+    }
+
+    // Pop only this test's approval if an earlier assertion found unexpected
+    // success. Never clear approvals belonging to other requests.
+    if (WebstorePrivateApi::PopApprovalForTesting(profile(), kExtensionId)) {
+      ADD_FAILURE() << "Unexpected approval from the delayed-prompt test";
+      tracker()->RemoveActiveInstall(kExtensionId);
+    }
+    if (request_sender_) {
+      EXPECT_FALSE(tracker()->GetActiveInstall(kExtensionId));
+      // Isolate subsequent tests even after an unexpected successful response
+      // transferred the active-install responsibility to completeInstall.
+      tracker()->RemoveActiveInstall(kExtensionId);
+    }
+    request_sender_.reset();
+    request_contents_.reset();
+    restore_factory_.RunAndReset();
+    function_slot_reset_.reset();
+    prompt_reset_.reset();
+    no_auto_confirm_.reset();
+    icon_response_.reset();
+    WebstoreInstaller::SetDownloadDirectoryForTests(nullptr);
+    ExtensionWebstorePrivateApiTest::TearDownOnMainThread();
+  }
+
+ protected:
+  content::WebContents* contents() {
+    return chrome_test_utils::GetActiveWebContents(this);
+  }
+
+  InstallTracker* tracker() {
+    return ExtensionsBrowserClient::Get()->GetInstallTracker(profile());
+  }
+
+  GURL SenderURL() {
+    return embedded_test_server()->GetURL("www.example.com", "/title1.html");
+  }
+
+  GURL OtherURL(const std::string& path) {
+    return embedded_test_server()->GetURL("other.example.com", path);
+  }
+
+  void BeginWithHeldIcon() {
+    ASSERT_TRUE(chrome_test_utils::NavigateToURL(contents(), SenderURL()));
+    request_contents_ = contents()->GetWeakPtr();
+    request_sender_ = std::make_unique<content::RenderFrameHostWrapper>(
+        request_contents_->GetPrimaryMainFrame());
+    ASSERT_TRUE(content::ExecJs(
+        request_contents_.get(),
+        content::JsReplace(R"(
+          chrome.webstorePrivate.beginInstallWithManifest3({
+            id: $1,
+            manifest: JSON.stringify({
+              name: 'Delayed prompt document',
+              version: '1.0',
+              manifest_version: 3
+            }),
+            iconUrl: $2
+          }, () => { void chrome.runtime.lastError; });
+        )",
+                           kExtensionId,
+                           embedded_test_server()->GetURL(
+                               "www.example.com", "/cws-held-icon.png"))));
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return icon_response_->has_received_request() ||
+             (function_ && function_->did_respond());
+    }));
+    ASSERT_TRUE(function_);
+    ASSERT_TRUE(icon_response_->has_received_request())
+        << function_->GetError();
+    ASSERT_FALSE(function_->did_respond());
+    ASSERT_TRUE(tracker()->GetActiveInstall(kExtensionId));
+    EXPECT_FALSE(PromptAdmitted());
+  }
+
+  void ReleaseIcon() {
+    CHECK(!icon_released_);
+    CHECK(icon_response_->has_received_request());
+    // has_received_request() alone does not transition the response to READY.
+    icon_response_->WaitForRequest();
+    icon_response_->Send(net::HTTP_OK, "image/png", icon_bytes_);
+    icon_response_->Done();
+    icon_released_ = true;
+  }
+
+  bool PromptAdmitted() const {
+    return ExtensionInstallPrompt::g_last_prompt_type_for_tests !=
+           InstallPromptData::UNSET_PROMPT_TYPE;
+  }
+
+  void WaitForResponseOrPrompt() {
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return function_->did_respond() || PromptAdmitted(); }));
+    // Complete the native/Java dialog-creation turn, including an immediate
+    // failed-window abort. This is native admission evidence, not pixel proof.
+    base::RunLoop().RunUntilIdle();
+  }
+
+  void ExpectCancellationAndRelease() {
+    ASSERT_TRUE(function_);
+    ASSERT_TRUE(function_->did_respond());
+    EXPECT_EQ("User cancelled install", function_->GetError());
+    const base::ListValue* results = function_->GetResultListForTest();
+    ASSERT_TRUE(results);
+    ASSERT_EQ(1u, results->size());
+    ASSERT_TRUE((*results)[0].is_string());
+    EXPECT_EQ("user_cancelled", (*results)[0].GetString());
+    EXPECT_FALSE(
+        WebstorePrivateApi::PopApprovalForTesting(profile(), kExtensionId));
+
+    // The real function owns ScopedActiveInstall until its destructor; do not
+    // mistake this test's retained reference for a production install leak.
+    function_.reset();
+    EXPECT_TRUE(base::test::RunUntil(
+        [&] { return !tracker()->GetActiveInstall(kExtensionId); }));
+  }
+
+  void ExpectPromptThenCancel() {
+    ASSERT_NO_FATAL_FAILURE(WaitForResponseOrPrompt());
+    ASSERT_EQ(InstallPromptData::INSTALL_PROMPT,
+              ExtensionInstallPrompt::g_last_prompt_type_for_tests);
+    ASSERT_FALSE(function_->did_respond())
+        << "Native prompt admission immediately aborted";
+    ASSERT_TRUE(request_contents_);
+    ASSERT_TRUE(chrome_test_utils::NavigateToURL(request_contents_.get(),
+                                                 OtherURL("/title2.html")));
+    ASSERT_TRUE(base::test::RunUntil([&] { return function_->did_respond(); }));
+    ASSERT_NO_FATAL_FAILURE(ExpectCancellationAndRelease());
+  }
+
+  scoped_refptr<BeginInstallFunction> function_;
+
+ private:
+  base::test::ScopedFeatureList features_;
+  std::unique_ptr<net::test_server::ControllableHttpResponse> icon_response_;
+  std::string icon_bytes_;
+  base::WeakPtr<content::WebContents> request_contents_;
+  std::unique_ptr<content::RenderFrameHostWrapper> request_sender_;
+  bool icon_released_ = false;
+  std::unique_ptr<ScopedTestDialogAutoConfirm> no_auto_confirm_;
+  std::unique_ptr<base::AutoReset<InstallPromptData::PromptType>> prompt_reset_;
+  std::unique_ptr<base::AutoReset<scoped_refptr<BeginInstallFunction>*>>
+      function_slot_reset_;
+  base::ScopedClosureRunner restore_factory_;
+};
+
+IN_PROC_BROWSER_TEST_F(ExtensionWebstorePrivateDocumentApiTest,
+                       CachedSenderCancelsBeforePrompt) {
+  ASSERT_NO_FATAL_FAILURE(BeginWithHeldIcon());
+  content::RenderFrameHostWrapper sender(contents()->GetPrimaryMainFrame());
+  ASSERT_TRUE(
+      chrome_test_utils::NavigateToURL(contents(), OtherURL("/title2.html")));
+  ASSERT_TRUE(sender);
+  ASSERT_NE(sender.get(), contents()->GetPrimaryMainFrame());
+  ASSERT_EQ(content::RenderFrameHost::LifecycleState::kInBackForwardCache,
+            sender->GetLifecycleState());
+
+  ReleaseIcon();
+  // On the old code, native prompt admission also ends this wait, producing an
+  // immediate failure rather than hanging for a dialog no one has accepted.
+  ASSERT_NO_FATAL_FAILURE(WaitForResponseOrPrompt());
+  EXPECT_FALSE(PromptAdmitted());
+  ASSERT_NO_FATAL_FAILURE(ExpectCancellationAndRelease());
+}
