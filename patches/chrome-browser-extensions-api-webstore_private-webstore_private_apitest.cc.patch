+// Exercises the actual renderer callback and native active-install lifetime;
+// this deliberately does not emulate the remote Store page's DOM or spinner.
+class ExtensionWebstorePrivateDownloadFailureApiTest
+    : public ExtensionWebstorePrivateApiTest {
+ protected:
+  void RunDeniedDownload(net::HttpStatusCode status) {
+    auto* contents = chrome_test_utils::GetActiveWebContents(this);
+    ASSERT_TRUE(contents);
+    auto* tracker = ExtensionsBrowserClient::Get()->GetInstallTracker(profile());
+    ASSERT_FALSE(tracker->GetActiveInstall(kExtensionId));
+    const int initial_approvals =
+        WebstorePrivateApi::GetPendingApprovalsCountForTesting();
+    base::ScopedClosureRunner cleanup(base::BindLambdaForTesting([&] {
+      WebstorePrivateApi::PopApprovalForTesting(profile(), kExtensionId);
+      tracker->RemoveActiveInstall(kExtensionId);
+    }));
+
+    // A loopback response is sufficient: no CRX or signature/publisher
+    // exception is needed. Only the existing scoped test endpoint is changed.
+    std::atomic<bool> served_denial{false};
+    net::EmbeddedTestServer denied_server;
+    denied_server.RegisterRequestHandler(base::BindRepeating(
+        [](net::HttpStatusCode status, std::atomic<bool>* served_denial,
+           const net::test_server::HttpRequest& request)
+            -> std::unique_ptr<net::test_server::HttpResponse> {
+          if (request.relative_url != "/denied.crx") {
+            return nullptr;
+          }
+          served_denial->store(true, std::memory_order_relaxed);
+          auto response =
+              std::make_unique<net::test_server::BasicHttpResponse>();
+          response->set_code(status);
+          response->set_content_type("text/plain");
+          response->set_content("Synthetic download denial");
+          return response;
+        },
+        status, base::Unretained(&served_denial)));
+    ASSERT_TRUE(denied_server.Start());
+    const GURL denied_url = denied_server.GetURL("/denied.crx");
+    base::test::ScopedCommandLine scoped_command_line;
+    base::ScopedClosureRunner restore_store_urls(base::BindOnce(
+        [](base::CommandLine original_command_line) {
+          ExtensionsClient::Get()->InitializeWebStoreUrls(&original_command_line);
+        },
+        *scoped_command_line.GetProcessCommandLine()));
+    scoped_command_line.GetProcessCommandLine()->AppendSwitchASCII(
+        ::switches::kComponentUpdater, "url-source=" + denied_url.spec());
+    extension_test_util::SetGalleryUpdateURL(denied_url);
+    ASSERT_EQ(denied_url, extension_urls::GetWebstoreUpdateUrl());
+    // Use the existing scoped test hook to pin the actual download to this
+    // loopback server. No production/private URL builder access is required.
+    scoped_command_line.GetProcessCommandLine()->AppendSwitchASCII(
+        switches::kAppsGalleryDownloadURL, denied_url.spec());
+    ASSERT_TRUE(chrome_test_utils::NavigateToURL(
+        contents, embedded_test_server()->GetURL("www.example.com", "/title1.html")));
+
+    const std::string manifest = R"({
+      "name": "Loopback denial retry", "version": "1.0", "manifest_version": 3
+    })";
+    const std::string begin_script = content::JsReplace(R"(
+      new Promise(resolve => {
+        chrome.webstorePrivate.beginInstallWithManifest3({
+          id: $1, manifest: $2
+        }, result => resolve([result, chrome.runtime.lastError?.message || '']));
+      });
+    )", kExtensionId, manifest);
+    base::ListValue begin_expected;
+    begin_expected.Append("");
+    begin_expected.Append("");
+    ASSERT_EQ(begin_expected,
+              content::EvalJs(contents, begin_script));
+    ASSERT_TRUE(tracker->GetActiveInstall(kExtensionId));
+    ASSERT_EQ(initial_approvals + 1,
+              WebstorePrivateApi::GetPendingApprovalsCountForTesting());
+
+    // Use the real binding and dispatcher, including runtime.lastError. The
+    // following same-ID begin also proves that failure released pending state.
+    const auto callback_result = content::EvalJs(contents, content::JsReplace(R"(
+      window.denialCallbackCount = 0;
+      new Promise(resolve => {
+        chrome.webstorePrivate.completeInstall($1, () => {
+          ++window.denialCallbackCount;
+          resolve(chrome.runtime.lastError?.message || '');
+        });
+      });
+    )", kExtensionId));
+    ASSERT_TRUE(callback_result.is_string()) << callback_result;
+    const auto reason = status == net::HTTP_UNAUTHORIZED
+                            ? download::DOWNLOAD_INTERRUPT_REASON_SERVER_UNAUTHORIZED
+                            : download::DOWNLOAD_INTERRUPT_REASON_SERVER_FORBIDDEN;
+    const std::string& error = callback_result.ExtractString();
+    // The start callback reports the raw reason; an already observed item uses
+    // the localized denial message. Both must originate from our denial route.
+    EXPECT_TRUE(error == download::DownloadInterruptReasonToString(reason) ||
+                error == l10n_util::GetStringUTF8(
+                             IDS_WEBSTORE_DOWNLOAD_ACCESS_DENIED)) << error;
+    EXPECT_TRUE(served_denial.load(std::memory_order_relaxed));
+    EXPECT_FALSE(tracker->GetActiveInstall(kExtensionId));
+    EXPECT_EQ(initial_approvals,
+              WebstorePrivateApi::GetPendingApprovalsCountForTesting());
+    EXPECT_FALSE(ExtensionRegistry::Get(profile())->GetInstalledExtension(
+        kExtensionId));
+    EXPECT_EQ(1, content::EvalJs(contents, "window.denialCallbackCount"));
+
+    // Complete the same-ID retry through the real download/install pipeline.
+    // Reuse this fixture's signing key, not the neighboring legacy MV2 CRX.
+    TestExtensionDir extension_dir;
+    extension_dir.WriteManifest(manifest);
+    TestExtensionDir delivery_dir;
+    const base::FilePath delivery_path = delivery_dir.UnpackedPath();
+    const base::FilePath packed_crx = PackExtensionWithOptions(
+        extension_dir.UnpackedPath(),
+        delivery_path.AppendASCII("denial-retry.crx"),
+        test_data_dir_.AppendASCII("api_test/webstore_private/extension.pem"),
+        base::FilePath());
+    ASSERT_FALSE(packed_crx.empty());
+    net::EmbeddedTestServer retry_server;
+    retry_server.ServeFilesFromDirectory(delivery_path);
+    ASSERT_TRUE(retry_server.Start());
+    const GURL retry_url = retry_server.GetURL("/denial-retry.crx");
+    scoped_command_line.GetProcessCommandLine()->AppendSwitchASCII(
+        ::switches::kComponentUpdater, "url-source=" + retry_url.spec());
+    extension_test_util::SetGalleryUpdateURL(retry_url);
+    ASSERT_EQ(retry_url, extension_urls::GetWebstoreUpdateUrl());
+    scoped_command_line.GetProcessCommandLine()->AppendSwitchASCII(
+        switches::kAppsGalleryDownloadURL, retry_url.spec());
+
+    // The local packer signs the CRX with the fixture key, but cannot supply a
+    // Store publisher proof. Reuse the existing scoped test helper only for the
+    // success leg; normal signature, extension-ID and manifest checks still run.
+    auto publisher_verification = DisablePublisherKeyVerificationForTests();
+    ASSERT_EQ(begin_expected,
+              content::EvalJs(contents, begin_script));
+    EXPECT_TRUE(tracker->GetActiveInstall(kExtensionId));
+    EXPECT_EQ(initial_approvals + 1,
+              WebstorePrivateApi::GetPendingApprovalsCountForTesting());
+    ASSERT_EQ("", content::EvalJs(contents, content::JsReplace(R"(
+      window.retryCallbackCount = 0;
+      new Promise(resolve => {
+        chrome.webstorePrivate.completeInstall($1, () => {
+          ++window.retryCallbackCount;
+          resolve(chrome.runtime.lastError?.message || '');
+        });
+      });
+    )", kExtensionId)));
+    const Extension* installed =
+        ExtensionRegistry::Get(profile())->enabled_extensions().GetByID(
+            kExtensionId);
+    ASSERT_TRUE(installed);
+    EXPECT_EQ(3, installed->manifest_version());
+    EXPECT_EQ("Loopback denial retry", installed->name());
+    EXPECT_EQ("1.0", installed->version().GetString());
+    EXPECT_TRUE(installed->from_webstore());
+    EXPECT_FALSE(tracker->GetActiveInstall(kExtensionId));
+    EXPECT_EQ(initial_approvals,
+              WebstorePrivateApi::GetPendingApprovalsCountForTesting());
+    EXPECT_EQ(1, content::EvalJs(contents, "window.denialCallbackCount"));
+    EXPECT_EQ(1, content::EvalJs(contents, "window.retryCallbackCount"));
+  }
+
+  void TearDownOnMainThread() override {
+    WebstoreInstaller::SetDownloadDirectoryForTests(nullptr);
+    ExtensionWebstorePrivateApiTest::TearDownOnMainThread();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(ExtensionWebstorePrivateDownloadFailureApiTest,
+                       Http401RespondsAndAllowsSameIdRetry) {
+  RunDeniedDownload(net::HTTP_UNAUTHORIZED);
+}
+
+IN_PROC_BROWSER_TEST_F(ExtensionWebstorePrivateDownloadFailureApiTest,
+                       Http403RespondsAndAllowsSameIdRetry) {
+  RunDeniedDownload(net::HTTP_FORBIDDEN);
+}
