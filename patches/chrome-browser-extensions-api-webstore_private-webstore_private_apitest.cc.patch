+using BeginInstallFunction = WebstorePrivateBeginInstallWithManifest3Function;
+scoped_refptr<BeginInstallFunction>* g_observed_begin_install = nullptr;
+
+// Retain the real dispatched function without substituting Run, policy, prompt,
+// or the Mojo response callback. Preserve only a copy of its outgoing results.
+scoped_refptr<ExtensionFunction> ObserveBeginInstallFunction() {
+  CHECK(g_observed_begin_install);
+  CHECK(!*g_observed_begin_install);
+  auto function = base::MakeRefCounted<BeginInstallFunction>();
+  function->preserve_results_for_testing();
+  *g_observed_begin_install = function;
+  return function;
+}
