+IN_PROC_BROWSER_TEST_F(ExtensionWebstorePrivateApiTest,
+                       IncognitoBeginDoesNotBlockRegularInstall) {
+  Profile* const regular_profile = profile();
+  content::WebContents* regular_contents =
+      chrome_test_utils::GetActiveWebContents(this);
+  ASSERT_TRUE(regular_contents);
+  ASSERT_EQ(regular_profile, regular_contents->GetBrowserContext());
+  auto* tracker =
+      ExtensionsBrowserClient::Get()->GetInstallTracker(regular_profile);
+  ASSERT_FALSE(tracker->GetActiveInstall(kExtensionId));
+  const int initial_approvals =
+      WebstorePrivateApi::GetPendingApprovalsCountForTesting();
+
+  // Keep failures on the old code from stranding this test's approval/marker,
+  // and retire the base fixture's raw test download-directory pointer.
+  base::ScopedClosureRunner cleanup(base::BindLambdaForTesting([&] {
+    if (Profile* private_profile = regular_profile->GetPrimaryOTRProfile(
+            /*create_if_needed=*/false)) {
+      WebstorePrivateApi::PopApprovalForTesting(private_profile, kExtensionId);
+    }
+    WebstorePrivateApi::PopApprovalForTesting(regular_profile, kExtensionId);
+    tracker->RemoveActiveInstall(kExtensionId);
+    WebstoreInstaller::SetDownloadDirectoryForTests(nullptr);
+  }));
+
+  // The older extension.crx binary is MV2 even though its neighboring
+  // unpacked manifest is MV3. Pack an actual MV3 control with the same key/ID.
+  const std::string manifest = R"({
+    "name": "Incognito install retry",
+    "version": "1.0",
+    "manifest_version": 3,
+    "permissions": ["tabs"]
+  })";
+  TestExtensionDir extension_dir;
+  extension_dir.WriteManifest(manifest);
+  // TestExtensionDir permits blocking cleanup in its destructor; the browser
+  // test body disallows blocking, including ordinary ScopedTempDir teardown.
+  TestExtensionDir delivery_dir;
+  const base::FilePath delivery_path = delivery_dir.UnpackedPath();
+  const base::FilePath packed_crx = PackExtensionWithOptions(
+      extension_dir.UnpackedPath(),
+      delivery_path.AppendASCII("incognito-retry.crx"),
+      test_data_dir_.AppendASCII("api_test/webstore_private/extension.pem"),
+      base::FilePath());
+  ASSERT_FALSE(packed_crx.empty());
+
+  // The base server is already started. Keep this server and its served
+  // directory alive through the real completeInstall callback instead.
+  net::EmbeddedTestServer crx_server;
+  crx_server.ServeFilesFromDirectory(delivery_path);
+  ASSERT_TRUE(crx_server.Start());
+  // The generic test packer produces a signed CRX without a Store publisher
+  // proof. Bypass only that test requirement; signature, ID and manifest
+  // verification still execute, and production publisher checks are unchanged.
+  auto publisher_verification = DisablePublisherKeyVerificationForTests();
+  const GURL page_url =
+      embedded_test_server()->GetURL("www.example.com", "/title1.html");
+  content::WebContents* private_contents =
+      PlatformOpenURLOffTheRecord(regular_profile, page_url);
+  ASSERT_TRUE(private_contents);
+  ASSERT_TRUE(private_contents->GetBrowserContext()->IsOffTheRecord());
+  ASSERT_EQ(tracker, ExtensionsBrowserClient::Get()->GetInstallTracker(
+                         private_contents->GetBrowserContext()));
+
+  base::AutoReset<InstallPromptData::PromptType> reset_prompt(
+      &ExtensionInstallPrompt::g_last_prompt_type_for_tests,
+      InstallPromptData::UNSET_PROMPT_TYPE);
+  const std::string begin_script = content::JsReplace(R"(
+    new Promise(resolve => {
+      chrome.webstorePrivate.beginInstallWithManifest3({
+        id: $1, manifest: $2
+      }, result => {
+        resolve([result, chrome.runtime.lastError?.message || '']);
+      });
+    });
+  )", kExtensionId, manifest);
+  const std::string complete_script = content::JsReplace(R"(
+    new Promise(resolve => {
+      chrome.webstorePrivate.completeInstall($1, () => {
+        resolve(chrome.runtime.lastError?.message || '');
+      });
+    });
+  )", kExtensionId);
+
+  // Dispatch through the real renderer binding and function dispatcher. The
+  // regular install below uses the same ID, tracker and signed MV3 CRX.
+  const auto private_begin = content::EvalJs(private_contents, begin_script);
+  base::ListValue private_expected;
+  private_expected.Append("unknown_error");
+  private_expected.Append("Apps cannot be installed in guest/incognito mode");
+  EXPECT_EQ(private_expected, private_begin.ExtractList());
+  EXPECT_EQ(InstallPromptData::UNSET_PROMPT_TYPE,
+            ExtensionInstallPrompt::g_last_prompt_type_for_tests);
+  EXPECT_EQ(initial_approvals,
+            WebstorePrivateApi::GetPendingApprovalsCountForTesting());
+  EXPECT_FALSE(tracker->GetActiveInstall(kExtensionId));
+  EXPECT_EQ("Apps cannot be installed in guest/incognito mode",
+            content::EvalJs(private_contents, complete_script));
+  EXPECT_EQ(initial_approvals,
+            WebstorePrivateApi::GetPendingApprovalsCountForTesting());
+  EXPECT_FALSE(tracker->GetActiveInstall(kExtensionId));
+
+  ASSERT_TRUE(chrome_test_utils::NavigateToURL(regular_contents, page_url));
+  const GURL crx_url = crx_server.GetURL("/incognito-retry.crx");
+  // Brave owns a separate update URL, populated from --component-updater.
+  // Set both clients' overrides and assert that the real installer uses this
+  // server, rather than an updater endpoint left over from browser startup.
+  base::test::ScopedCommandLine scoped_command_line;
+  base::ScopedClosureRunner restore_store_urls(base::BindOnce(
+      [](base::CommandLine original_command_line) {
+        ExtensionsClient::Get()->InitializeWebStoreUrls(&original_command_line);
+      },
+      *scoped_command_line.GetProcessCommandLine()));
+  scoped_command_line.GetProcessCommandLine()->AppendSwitchASCII(
+      ::switches::kComponentUpdater, "url-source=" + crx_url.spec());
+  extension_test_util::SetGalleryUpdateURL(crx_url);
+  ASSERT_EQ(crx_url, extension_urls::GetWebstoreUpdateUrl());
+  const auto regular_begin = content::EvalJs(regular_contents, begin_script);
+  base::ListValue regular_expected;
+  regular_expected.Append("");
+  regular_expected.Append("");
+  ASSERT_EQ(regular_expected, regular_begin.ExtractList());
+  ASSERT_EQ("", content::EvalJs(regular_contents, complete_script));
+  const Extension* installed =
+      ExtensionRegistry::Get(regular_profile)->enabled_extensions().GetByID(
+          kExtensionId);
+  ASSERT_TRUE(installed);
+  EXPECT_EQ(3, installed->manifest_version());
+  EXPECT_TRUE(installed->from_webstore());
+  EXPECT_EQ(initial_approvals,
+            WebstorePrivateApi::GetPendingApprovalsCountForTesting());
+  EXPECT_FALSE(tracker->GetActiveInstall(kExtensionId));
+}
+#endif  // BUILDFLAG(IS_ANDROID)
 
