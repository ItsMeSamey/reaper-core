+suite('ExtensionRealOptionsGuestTests', function() {
+  async function beforeDeadline<T>(signal: Promise<T>): Promise<T> {
+    let deadline = 0;
+    try {
+      return await Promise.race([
+        signal,
+        new Promise<T>((_resolve, reject) => {
+          deadline = window.setTimeout(
+              () => reject(new Error('Timed out waiting for real options guest')),
+              10000);
+        }),
+      ]);
+    } finally {
+      window.clearTimeout(deadline);
+    }
+  }
+
+  test('AndroidDirectOptionsGuestRendersAndCloses', async () => {
+    const previousPage = navigation.getCurrentPage();
+    const testWindow: Window&{
+      reaperOptionsGuestReady?: Promise<boolean>,
+    } = window;
+    const manager: ExtensionsManagerElement =
+        document.createElement('extensions-manager');
+    const cleanup: {sizeObserver?: MutationObserver} = {};
+    try {
+      document.body.innerHTML = window.trustedTypes!.emptyHTML;
+      navigation.replaceWith({page: Page.LIST});
+      document.body.appendChild(manager);
+      await beforeDeadline(manager.whenPageInitializedForTest());
+      await manager.updateComplete;
+      const info = await beforeDeadline(Service.getInstance().getExtensionsInfo());
+      assertEquals(1, info.length);
+      const data = info[0]!;
+      assertTrue(!!data.optionsPage);
+      assertFalse(data.optionsPage.openInTab);
+      const opened = eventToPromise('cr-dialog-open', manager);
+      navigation.navigateTo({
+        page: Page.DETAILS,
+        extensionId: data.id,
+        subpage: Dialog.OPTIONS,
+      });
+      assertTrue(await beforeDeadline(testWindow.reaperOptionsGuestReady!));
+      await beforeDeadline(opened);
+      const optionsDialog = manager.shadowRoot.querySelector(
+          'extensions-options-dialog');
+      assertTrue(!!optionsDialog);
+      const guest = optionsDialog.$.body.querySelector<
+          HTMLElement&{extension: string}>('extensionoptions');
+      assertTrue(!!guest);
+      assertEquals('extensionoptions', guest.localName);
+      assertEquals(data.id, guest.extension);
+      assertTrue(guest.isConnected);
+      const dialog = optionsDialog.$.dialog;
+      const nativeDialog = dialog.getNative();
+      let onRendered: () => void = () => {};
+      const rendered = new Promise<void>(resolve => {
+        onRendered = resolve;
+      });
+      const check = () => {
+        const rect = nativeDialog.getBoundingClientRect();
+        if (nativeDialog.open && rect.width > 0 && rect.height > 0 &&
+            dialog.style.getPropertyValue('--dialog-opacity') === '1') {
+          cleanup.sizeObserver?.disconnect();
+          onRendered();
+        }
+      };
+      cleanup.sizeObserver = new MutationObserver(check);
+      cleanup.sizeObserver.observe(dialog, {
+        attributes: true,
+        attributeFilter: ['style'],
+      });
+      check();
+      await beforeDeadline(rendered);
+      const rect = nativeDialog.getBoundingClientRect();
+      assertGE(rect.width, Math.min(OptionsDialogMinWidth, window.innerWidth - 32));
+      assertLE(rect.width, window.innerWidth - 32);
+      assertLE(rect.height, OptionsDialogMaxHeight);
+      assertGE(rect.left, 0);
+      assertLE(rect.right, window.innerWidth);
+      assertGE(rect.top, 0);
+      assertLE(rect.bottom, window.innerHeight);
+      const guestRect = guest.getBoundingClientRect();
+      assertTrue(guestRect.width > 0);
+      assertTrue(guestRect.height > 0);
+      assertGE(guestRect.left, rect.left);
+      assertLE(guestRect.right, rect.right);
+      assertGE(guestRect.top, rect.top);
+      assertLE(guestRect.bottom, rect.bottom);
+      assertGE(guestRect.left, 0);
+      assertLE(guestRect.right, window.innerWidth);
+      assertGE(guestRect.top, 0);
+      assertLE(guestRect.bottom, window.innerHeight);
+      const closed = eventToPromise('close', optionsDialog);
+      const closeButton = dialog.shadowRoot.querySelector<HTMLElement>('#close');
+      assertTrue(!!closeButton);
+      closeButton.click();
+      await beforeDeadline(closed);
+      await manager.updateComplete;
+      assertFalse(nativeDialog.open);
+      assertFalse(guest.isConnected);
+      assertEquals(null, manager.shadowRoot.querySelector('extensions-options-dialog'));
+      const route = navigation.getCurrentPage();
+      assertEquals(Page.DETAILS, route.page);
+      assertEquals(data.id, route.extensionId);
+      assertEquals(undefined, route.subpage);
+    } finally {
+      cleanup.sizeObserver?.disconnect();
+      manager.remove();
+      navigation.replaceWith(previousPage);
+      Reflect.deleteProperty(window, 'reaperOptionsGuestReady');
+      Reflect.deleteProperty(window, 'reaperResolveOptionsGuestReady');
+    }
+  });
+});
