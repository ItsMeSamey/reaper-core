+
+  // Use the real dialog and lifecycle. Hold only document readiness and the
+  // native guest element boundary so callback ordering is deterministic.
+  function controlOptionsGuest(initialReadyState: DocumentReadyState) {
+    const originalCreate = document.createElement.bind(document);
+    const descriptors = new Map([
+      ['createElement', Object.getOwnPropertyDescriptor(document, 'createElement')],
+      ['readyState', Object.getOwnPropertyDescriptor(document, 'readyState')],
+    ]);
+    const guest: ControlledOptionsGuest = Object.assign(originalCreate('div'), {
+      extension: '',
+      onclose: () => {},
+      onpreferredsizechanged: null,
+    });
+    let readyState = initialReadyState;
+    let creations = 0;
+    const timer = new MockTimer();
+    timer.install();
+    Object.defineProperty(document, 'readyState', {
+      configurable: true,
+      get: () => readyState,
+    });
+    Object.defineProperty(document, 'createElement', {
+      configurable: true,
+      value: (name: string, options?: ElementCreationOptions) => {
+        if (name.toLowerCase() === 'extensionoptions') {
+          ++creations;
+          return guest;
+        }
+        return originalCreate(name, options);
+      },
+    });
+    return {
+      guest,
+      timer,
+      creations: () => creations,
+      finishDocument: () => {
+        readyState = 'complete';
+        document.dispatchEvent(new Event('readystatechange'));
+      },
+      restore: () => {
+        optionsDialog.remove();
+        timer.uninstall();
+        for (const [key, descriptor] of descriptors) {
+          if (descriptor) {
+            Object.defineProperty(document, key, descriptor);
+          } else {
+            Reflect.deleteProperty(document, key);
+          }
+        }
+      },
+    };
+  }
