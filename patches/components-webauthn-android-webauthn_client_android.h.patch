+// Per-request embedder policy and lifetime. Origin/RP validation remains the
+// responsibility of the existing WebAuthn security layer.
+class WebAuthnRequestGuard {
+ public:
+  virtual ~WebAuthnRequestGuard();
+  // The original document and owning tab/model still exist, without a latched
+  // cancellation. Conditional requests may remain valid while waiting inactive.
+  virtual bool IsValid() const = 0;
+  // Admit actual interactive UI only in the selected visible tab. Once begun,
+  // a real tab/model switch permanently invalidates this request.
+  virtual bool BeginInteraction() = 0;
+  // Recheck success delivery without requiring visibility: an OS authenticator
+  // activity may legitimately cover the browser until its result is delivered.
+  virtual bool CanCompleteRequest() const = 0;
+};
+
 class WebAuthnClientAndroid {
  public:
   virtual ~WebAuthnClientAndroid();
+
+  // Default-empty preserves other embedders. Chrome supplies a guard even when
+  // admission fails; its cancellation callback is posted, never synchronous.
+  virtual std::unique_ptr<WebAuthnRequestGuard> CreateRequestGuard(
+      content::RenderFrameHost* frame,
+      bool conditional,
+      base::OnceClosure on_cancel);
 
   // Called by the embedder to set the static instance of this client.
   static void SetClient(std::unique_ptr<WebAuthnClientAndroid> client);
