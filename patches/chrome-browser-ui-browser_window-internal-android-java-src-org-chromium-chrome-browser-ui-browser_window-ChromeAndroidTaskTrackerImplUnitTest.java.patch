+    @Test
+    public void getMostRecentlyActivatedTaskOtherThan_skipsMissingClosingAndDestroyedActivities() {
+        var healthy =
+                ChromeAndroidTaskUnitTestSupport.createChromeAndroidTaskWithMockDeps(
+                        /* taskId= */ 1, /* isPendingTask= */ false, /* isDesktopMode= */ true);
+        var missing =
+                ChromeAndroidTaskUnitTestSupport.createChromeAndroidTaskWithMockDeps(
+                        /* taskId= */ 2, /* isPendingTask= */ false, /* isDesktopMode= */ true);
+        var closing =
+                ChromeAndroidTaskUnitTestSupport.createChromeAndroidTaskWithMockDeps(
+                        /* taskId= */ 3, /* isPendingTask= */ false, /* isDesktopMode= */ true);
+        var destroyed =
+                ChromeAndroidTaskUnitTestSupport.createChromeAndroidTaskWithMockDeps(
+                        /* taskId= */ 4, /* isPendingTask= */ false, /* isDesktopMode= */ true);
+        var current =
+                ChromeAndroidTaskUnitTestSupport.createChromeAndroidTaskWithMockDeps(
+                        /* taskId= */ 5, /* isPendingTask= */ false, /* isDesktopMode= */ true);
+        for (var deps : List.of(healthy, missing, closing, destroyed, current)) {
+            mFakeTime.advanceMillis(1L);
+            deps.mChromeAndroidTask.onTopResumedActivityChangedWithNative(true);
+        }
+        var missingWindow = missing.mActivityWindowAndroidMocks.mMockActivityWindowAndroid;
+        var retainedActivityReference = missingWindow.getActivity();
+        when(missingWindow.getActivity()).thenReturn(new WeakReference<>(null));
+        when(closing.mActivityWindowAndroidMocks.mMockActivity.isFinishing()).thenReturn(true);
+        when(destroyed.mActivityWindowAndroidMocks.mMockActivity.isDestroyed()).thenReturn(true);
+        try {
+            assertEquals(
+                    healthy.mChromeAndroidTask,
+                    mChromeAndroidTaskTracker.getMostRecentlyActivatedTaskOtherThan(
+                            current.mChromeAndroidTask));
+        } finally {
+            // Existing task cleanup still needs the fixture Activity reference.
+            when(missingWindow.getActivity()).thenReturn(retainedActivityReference);
+        }
+    }
