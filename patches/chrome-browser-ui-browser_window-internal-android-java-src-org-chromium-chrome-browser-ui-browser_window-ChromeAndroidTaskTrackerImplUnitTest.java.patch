+
+    private void assertInactiveCreationRequest(@PendingAction int action, boolean queueBeforeCreate) {
+        var previousDeps =
+                ChromeAndroidTaskUnitTestSupport.createChromeAndroidTaskWithMockDeps(
+                        /* taskId= */ 1, /* isPendingTask= */ false, /* isDesktopMode= */ true);
+        var previousTask = previousDeps.mChromeAndroidTask;
+        var previousWindow = previousDeps.mActivityWindowAndroidMocks.mMockActivityWindowAndroid;
+        var previousActivity = previousDeps.mActivityWindowAndroidMocks.mMockActivity;
+        var previousActivityManager =
+                (ActivityManager) previousActivity.getSystemService(Context.ACTIVITY_SERVICE);
+        when(previousWindow.isTopResumedActivity()).thenReturn(false);
+
+        var profile = mock(Profile.class);
+        var currentMocks = ChromeAndroidTaskUnitTestSupport.createActivityWindowAndroidMocks(2);
+        ChromeAndroidTaskUnitTestSupport.mockDesktopWindowingMode(currentMocks);
+        AppHeaderUtils.setAppInDesktopWindowForTesting(false);
+        when(currentMocks.mMockActivity.isInMultiWindowMode()).thenReturn(false);
+        when(currentMocks.mMockActivityWindowAndroid.isTopResumedActivity()).thenReturn(true);
+        when(currentMocks.mMockActivityLifecycleDispatcher.getCurrentActivityState())
+                .thenReturn(ActivityLifecycleDispatcher.ActivityState.RESUMED_WITH_NATIVE);
+        var currentScopedObjects =
+                ChromeAndroidTaskUnitTestSupport.createMockActivityScopedObjects(
+                        currentMocks.mMockActivityWindowAndroid, profile);
+        assertFalse(
+                AppHeaderUtils.isAppInDesktopWindow(
+                        currentScopedObjects.mDesktopWindowStateManager));
+        JniOnceCallback<Long> callback = mock();
+        var pendingTask =
+                assumeNonNull(
+                        mChromeAndroidTaskTracker.createPendingTask(
+                                ChromeAndroidTaskUnitTestSupport
+                                        .createMockAndroidBrowserWindowCreateParams(
+                                                BrowserWindowType.NORMAL,
+                                                new Rect(),
+                                                WindowShowState.DEFAULT,
+                                                profile),
+                                callback));
+        int pendingId = assumeNonNull(pendingTask.getPendingTaskInfo()).mPendingTaskId;
+        if (queueBeforeCreate) {
+            if (action == PendingAction.SHOW_INACTIVE) {
+                pendingTask.showInactive();
+            } else {
+                pendingTask.deactivate();
+            }
+            assertFalse(pendingTask.isActive());
+        }
+        doAnswer(
+                        invocation -> {
+                            // Completion can precede insertion when the Activity is already resumed.
+                            assertEquals(Integer.valueOf(2), pendingTask.getId());
+                            assertNull(mChromeAndroidTaskTracker.get(2));
+                            assertEquals(1, mChromeAndroidTaskTracker.countOfTasks());
+                            if (!queueBeforeCreate) {
+                                assertEquals(ChromeAndroidTaskImpl.State.IDLE, pendingTask.getState());
+                                pendingTask.showInactive();
+                            }
+                            assertEquals(
+                                    ChromeAndroidTaskImpl.State.PENDING_UPDATE,
+                                    pendingTask.getState());
+                            assertEquals(
+                                    false,
+                                    pendingTask
+                                            .getPendingActionManagerForTesting()
+                                            .isActiveFuture(pendingTask.getState()));
+                            assertFalse(pendingTask.isActive());
+                            assertTrue(
+                                    currentMocks.mMockActivityWindowAndroid.isTopResumedActivity());
+                            assertEquals(
+                                    action,
+                                    pendingTask
+                                            .getPendingActionManagerForTesting()
+                                            .getPendingActionsForTesting()[1]);
+                            verify(previousActivityManager, times(1)).moveTaskToFront(eq(1), eq(0));
+                            return null;
+                        })
+                .when(callback)
+                .onResult(ChromeAndroidTaskUnitTestSupport.FAKE_NATIVE_ANDROID_BROWSER_WINDOW_PTR);
+
+        assertEquals(
+                pendingTask,
+                mChromeAndroidTaskTracker.obtainTask(
+                        BrowserWindowType.NORMAL, currentScopedObjects, pendingId));
+        assertEquals(pendingTask, mChromeAndroidTaskTracker.get(2));
+        assertEquals(2, mChromeAndroidTaskTracker.countOfTasks());
+        pendingTask.onTopResumedActivityChangedWithNative(true);
+        assertFalse(pendingTask.isActive());
+        verify(callback, times(1))
+                .onResult(ChromeAndroidTaskUnitTestSupport.FAKE_NATIVE_ANDROID_BROWSER_WINDOW_PTR);
+
+        when(previousWindow.isTopResumedActivity()).thenReturn(true);
+        previousTask.onTopResumedActivityChangedWithNative(true);
+        when(currentMocks.mMockActivityWindowAndroid.isTopResumedActivity()).thenReturn(false);
+        pendingTask.onTopResumedActivityChangedWithNative(false);
+        assertEquals(ChromeAndroidTaskImpl.State.IDLE, pendingTask.getState());
+        assertFalse(pendingTask.isActive());
+        assertTrue(previousTask.isActive());
+        assertNull(
+                pendingTask
+                        .getPendingActionManagerForTesting()
+                        .isActiveFuture(pendingTask.getState()));
+        verify(callback, times(1))
+                .onResult(ChromeAndroidTaskUnitTestSupport.FAKE_NATIVE_ANDROID_BROWSER_WINDOW_PTR);
     }
 
