+#if BUILDFLAG(IS_ANDROID)
+void NotificationsGetPermissionLevelFunction::OnAndroidNotificationStatus(
+    int status) {
+  // NotificationSystemStatusUtil uses 2 for enabled and 3 for disabled. Other
+  // values mean the query failed/timed out, not that the user denied
+  // permission.
+  if (status != 2 && status != 3) {
+    FinishAndroidQuery(Error("Unable to read Android notification settings."));
+    return;
+  }
+  // The original Extension object can outlive disable/unload or permission
+  // revocation while Android policy is read. Consult the current registry
+  // entry.
+  const Extension* current_extension = ExtensionRegistry::Get(browser_context())
+                                           ->enabled_extensions()
+                                           .GetByID(extension_id());
+  const bool allowed = current_extension &&
+                       current_extension->permissions_data()->HasAPIPermission(
+                           mojom::APIPermissionID::kNotifications) &&
+                       AreExtensionNotificationsAllowed();
+  FinishAndroidQuery(
+      WithArguments(status == 2 && allowed ? "granted" : "denied"));
+}
+
+void NotificationsGetPermissionLevelFunction::FinishAndroidQuery(
+    ResponseValue response) {
+  if (!waiting_for_android_status_)
+    return;
+  waiting_for_android_status_ = false;
+  android_status_timeout_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  Respond(std::move(response));
+  Release();
+}
+
+void NotificationsGetPermissionLevelFunction::OnBrowserContextShutdown() {
+  if (waiting_for_android_status_) {
+    FinishAndroidQuery(
+        Error("The browser context shut down before notification settings were "
+              "read."));
+  }
+}
+#endif

