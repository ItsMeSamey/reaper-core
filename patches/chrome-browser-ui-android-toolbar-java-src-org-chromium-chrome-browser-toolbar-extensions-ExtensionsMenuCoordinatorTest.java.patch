+    @Test
+    public void testPinMenuIconButton_OneKeyboardStopPreservesLabelStateAndRowClick() {
+        ViewGroup menu = createZeroStateMenuForLayout();
+        layoutMenu(menu, View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED));
+        ViewGroup footer = menu.findViewById(R.id.extensions_menu_footer);
+        View pinRow = menu.findViewById(R.id.extensions_menu_pin_menu_icon_button);
+        CompoundButton toggle = menu.findViewById(R.id.extensions_menu_button_pinning_toggle);
+        View manage = menu.findViewById(R.id.extensions_menu_manage_extensions_button);
+        FocusFinder focusFinder = FocusFinder.getInstance();
+
+        // Traverse the inflated footer, rather than just checking the XML focusable attribute.
+        assertEquals(toggle, focusFinder.findNextFocus(footer, null, View.FOCUS_FORWARD));
+        assertEquals(manage, focusFinder.findNextFocus(footer, toggle, View.FOCUS_FORWARD));
+        assertEquals(toggle, focusFinder.findNextFocus(footer, manage, View.FOCUS_BACKWARD));
+
+        AccessibilityNodeInfo node = AccessibilityNodeInfo.obtain();
+        mExtensionsMenuCoordinator.setMenuButtonPinned(true);
+        toggle.onInitializeAccessibilityNodeInfo(node);
+        assertEquals(
+                mContext.getString(R.string.extensions_pin_to_toolbar_setting),
+                node.getContentDescription());
+        assertTrue(node.isCheckable());
+        assertTrue(node.isChecked());
+        mExtensionsMenuCoordinator.setMenuButtonPinned(false);
+        toggle.onInitializeAccessibilityNodeInfo(node);
+        assertFalse(node.isChecked());
+        node.recycle();
+
+        // Removing the redundant keyboard stop must retain both existing click targets.
+        assertTrue(pinRow.performClick());
+        assertTrue(toggle.performClick());
+        verify(mMenuButtonPinningDelegate, times(2)).setMenuButtonPinned(true);
+    }
