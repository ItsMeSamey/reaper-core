+    private void assertHostRequestFocusSurvivesSiblingChanges(int buttonId) {
+        ViewGroup menu = createHostRequestMenu();
+        PropertyModel model = mExtensionsMenuCoordinator.getMainPageModel();
+        ExtensionsMenuTypes.HostAccessRequest a =
+                new ExtensionsMenuTypes.HostAccessRequest("a", "Alpha", null);
+        ExtensionsMenuTypes.HostAccessRequest b =
+                new ExtensionsMenuTypes.HostAccessRequest("b", "Beta", null);
+        model.set(ExtensionsMenuProperties.HOST_ACCESS_REQUESTS, List.of(a, b));
+        layoutMenu(menu, View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED));
+        ViewGroup list = menu.findViewById(R.id.extensions_request_access_list);
+        View rowB = list.getChildAt(1);
+        View buttonB = rowB.findViewById(buttonId);
+        assertTrue(buttonB.requestFocus());
+        assertTrue(rowB.isAttachedToWindow());
+        View.OnAttachStateChangeListener attachment = mock(View.OnAttachStateChangeListener.class);
+        rowB.addOnAttachStateChangeListener(attachment);
+        List<String> allow = new ArrayList<>();
+        List<String> dismiss = new ArrayList<>();
+        model.set(ExtensionsMenuProperties.ALLOW_EXTENSION_CLICK_LISTENER, allow::add);
+        model.set(ExtensionsMenuProperties.DISMISS_EXTENSION_CLICK_LISTENER, dismiss::add);
+
+        // Updating, removing and re-adding A must not recreate or detach B's focused control.
+        model.set(
+                ExtensionsMenuProperties.HOST_ACCESS_REQUESTS,
+                List.of(new ExtensionsMenuTypes.HostAccessRequest("a", "Alpha updated", null), b));
+        assertSame(rowB, list.getChildAt(1));
+        assertSame(buttonB, list.getChildAt(1).findViewById(buttonId));
+        assertSame(buttonB, menu.findFocus());
+        model.set(ExtensionsMenuProperties.HOST_ACCESS_REQUESTS, List.of(b));
+        assertSame(rowB, list.getChildAt(0));
+        assertSame(buttonB, menu.findFocus());
+        model.set(ExtensionsMenuProperties.HOST_ACCESS_REQUESTS, List.of(a, b));
+        assertSame(rowB, list.getChildAt(1));
+        assertSame(buttonB, menu.findFocus());
+        verify(attachment, never()).onViewDetachedFromWindow(any());
+        assertTrue(allow.isEmpty());
+        assertTrue(dismiss.isEmpty());
+    }
