+    private static void revealInBody(ViewGroup menu, View descendant) {
+        descendant.requestRectangleOnScreen(
+                new Rect(0, 0, descendant.getWidth(), descendant.getHeight()), true);
+        Rect viewport = boundsInMenu(menu, menu.findViewById(R.id.extensions_menu_body_scroll));
+        Rect menuBounds = new Rect(0, 0, menu.getWidth(), menu.getHeight());
+        assertTrue(menuBounds.contains(viewport));
+        Rect header = boundsInMenu(menu, menu.findViewById(R.id.extensions_menu_header));
+        assertTrue(menuBounds.contains(header));
+        assertTrue(header.bottom <= viewport.top);
+        assertTrue(header.contains(boundsInMenu(menu,
+                menu.findViewById(R.id.extensions_menu_close_button))));
+        assertTrue(viewport.contains(boundsInMenu(menu, descendant)));
+    }
