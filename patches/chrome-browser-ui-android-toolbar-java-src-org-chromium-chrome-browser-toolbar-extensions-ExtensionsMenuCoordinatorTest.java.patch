+        assertEquals(0, body.getScrollY());
+        // A further requested layout must not restore the formerly focused footer position.
+        menu.requestLayout();
+        ShadowLooper.idleMainLooper();
+        assertEquals(0, body.getScrollY());
+        Rect headerAfterReopen = boundsInMenu(menu, header);
