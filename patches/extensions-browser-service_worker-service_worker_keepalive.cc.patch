+#if BUILDFLAG(IS_ANDROID)
+ServiceWorkerKeepalive::ServiceWorkerKeepalive(ServiceWorkerKeepalive&& other)
+    : browser_context_(std::exchange(other.browser_context_, nullptr)),
+      worker_id_(std::move(other.worker_id_)),
+      activity_type_(other.activity_type_),
+      activity_extra_data_(std::move(other.activity_extra_data_)),
+      request_uuid_(std::move(other.request_uuid_)) {
+  // A moved subscription still calls the original object's address. Cancel it
+  // and bind the destination; the moved-from owner cannot release this UUID.
+  other.shutdown_subscription_ = base::CallbackListSubscription();
+  if (browser_context_ && browser_context_->ShutdownStarted()) {
+    browser_context_ = nullptr;
+  }
+  if (browser_context_) {
+    shutdown_subscription_ =
+        ServiceWorkerKeepaliveShutdownNotifierFactory::GetInstance()
+            ->Get(browser_context_)
+            ->Subscribe(base::BindRepeating(&ServiceWorkerKeepalive::Shutdown,
+                                            base::Unretained(this)));
+  }
