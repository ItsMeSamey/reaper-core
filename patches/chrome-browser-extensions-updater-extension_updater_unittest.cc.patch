+void TestAndroidUpdaterProvidesNoOptionalActivityData() {
+  ExtensionDownloaderTestHelper helper;
+  TestDownloaderFactory factory(helper.url_loader_factory());
+  ExtensionList extensions;
+  CreateTestExtensions(1, 1, &extensions, nullptr, ManifestLocation::kInternal);
+  SetExtensions(extensions, ExtensionList());
+  const ExtensionId id = extensions[0]->id();
+  const base::Time original_day = base::Time::Now() - base::Days(4);
+  extension_prefs()->SetLastPingDay(id, original_day);
+  extension_prefs()->SetLastActivePingDay(id, original_day);
+  extension_prefs()->SetActiveBit(id, true);
+  ExtensionUpdater updater(profile());
+  updater.InitAndEnable(extension_prefs(), pref_service(), kUpdateFrequency,
+                        nullptr, factory.GetDownloaderFactory());
+  updater.Start();
+  DownloadPingData output(17, 23, false, {});
+  EXPECT_FALSE(updater.GetPingDataForExtension(id, &output));
+  EXPECT_EQ(17, output.rollcall_days);
+  EXPECT_EQ(23, output.active_days);
+  EXPECT_FALSE(output.is_enabled);
+  ExtensionDownloaderDelegate::PingResult ping;
+  ping.did_ping = true;
+  ping.day_start = base::Time::Now();
+  updater.OnExtensionDownloadFailed(
+      id, ExtensionDownloaderDelegate::Error::NO_UPDATE_AVAILABLE, ping, {},
+      ExtensionDownloaderDelegate::FailureData());
+  EXPECT_EQ(original_day, extension_prefs()->LastPingDay(id));
+  EXPECT_EQ(original_day, extension_prefs()->LastActivePingDay(id));
+  EXPECT_TRUE(extension_prefs()->GetActiveBit(id));
+}
