+TEST_F(ExtensionUpdaterTest, AndroidDownloaderDoesNotCollectOptionalPingData) {
+  ExtensionDownloaderTestHelper helper;
+  helper.downloader().set_ping_enabled_domain("google.com");
+  helper.downloader().set_brand_code("TEST");
+  EXPECT_CALL(helper.delegate(), GetPingDataForExtension(_, _)).Times(0);
+  const ExtensionId id =
+      crx_file::id_util::GenerateId("android-update-privacy");
+  auto task = CreateDownloaderTask(
+      id, GURL("https://clients2.google.com/service/update2/crx"));
+  task.version = base::Version("3.4");
+  ASSERT_TRUE(helper.downloader().AddPendingExtension(std::move(task)));
+  helper.downloader().StartAllPending(nullptr);
+  RunUntilIdle();
+  const auto* fetch = helper.downloader().GetActiveManifestFetchForTesting();
+  ASSERT_TRUE(fetch);
+  std::map<std::string, std::string> params;
+  VerifyQueryAndExtractParameters(fetch->full_url().GetQuery(), &params);
+  EXPECT_EQ(id, params["id"]);
+  EXPECT_EQ("3.4", params["v"]);
+  EXPECT_TRUE(params.contains("uc"));
+  EXPECT_FALSE(params.contains("ping"));
+  EXPECT_FALSE(params.contains("brand"));
+}
+
+TEST_F(ExtensionUpdaterTest, AndroidUpdaterProvidesNoOptionalActivityData) {
+  TestAndroidUpdaterProvidesNoOptionalActivityData();
+}
