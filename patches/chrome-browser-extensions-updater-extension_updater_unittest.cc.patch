+#if BUILDFLAG(IS_ANDROID)
+TEST_F(ExtensionUpdaterTest, AndroidManifestUpdatesExcludeOptionalPingData) {
+  const GURL url("https://clients2.google.com/service/update2/crx");
+  const ExtensionId first_id(32, 'a');
+  const ExtensionId second_id(32, 'b');
+  const std::string query = UpdateQueryParams::Get(UpdateQueryParams::CRX);
+  const DownloadPingData ping(ManifestFetchData::kNeverPinged, 7, false,
+                              {disable_reason::DISABLE_USER_ACTION});
+  const auto modes = std::to_array<ManifestFetchData::PingMode>(
+      {ManifestFetchData::NO_PING, ManifestFetchData::PING,
+       ManifestFetchData::PING_WITH_ENABLED_STATE});
+  for (auto mode : modes) {
+    ManifestFetchData fetch(url, 11, "TEST", query, mode,
+                            DownloadFetchPriority::kBackground);
+    ASSERT_TRUE(fetch.AddExtension(first_id, "1.2.3", &ping, "bar", "ondemand",
+                                   ManifestLocation::kInternal,
+                                   DownloadFetchPriority::kBackground));
+    std::map<std::string, std::string> params;
+    VerifyQueryAndExtractParameters(fetch.full_url().GetQuery(), &params);
+    EXPECT_EQ(first_id, params["id"]);
+    EXPECT_EQ("1.2.3", params["v"]);
+    EXPECT_EQ("bar", params["ap"]);
+    EXPECT_EQ("ondemand", params["installsource"]);
+    EXPECT_EQ("internal", params["installedby"]);
+    EXPECT_TRUE(params.contains("uc"));
+    EXPECT_FALSE(params.contains("ping"));
+    EXPECT_FALSE(params.contains("brand"));
+    EXPECT_FALSE(fetch.DidPing(first_id, ManifestFetchData::ROLLCALL));
+    EXPECT_FALSE(fetch.DidPing(first_id, ManifestFetchData::ACTIVE));
+    ASSERT_TRUE(fetch.AddExtension(second_id, "2.0", &ping, "bar", "ondemand",
+                                   ManifestLocation::kInternal,
+                                   DownloadFetchPriority::kBackground));
+    fetch.RemoveExtensions({first_id}, query);
+    params.clear();
+    VerifyQueryAndExtractParameters(fetch.full_url().GetQuery(), &params);
+    EXPECT_EQ(second_id, params["id"]);
+    EXPECT_EQ("2.0", params["v"]);
+    EXPECT_EQ("bar", params["ap"]);
+    EXPECT_FALSE(params.contains("ping"));
+    EXPECT_FALSE(params.contains("brand"));
+    EXPECT_FALSE(fetch.Includes(first_id));
+    EXPECT_TRUE(fetch.Includes(second_id));
+    EXPECT_FALSE(fetch.DidPing(second_id, ManifestFetchData::ROLLCALL));
+    auto other = std::make_unique<ManifestFetchData>(
+        url, 12, "OTHER", query, mode, DownloadFetchPriority::kForeground);
+    ASSERT_TRUE(other->AddExtension(second_id, "2.0", &ping, "bar", "ondemand",
+                                    ManifestLocation::kInternal,
+                                    DownloadFetchPriority::kForeground));
+    ASSERT_EQ(fetch.full_url(), other->full_url());
+    EXPECT_EQ(DownloadFetchPriority::kBackground, fetch.fetch_priority());
+    fetch.Merge(std::move(other));
+    EXPECT_EQ(2u, fetch.request_ids().size());
+    EXPECT_TRUE(fetch.request_ids().contains(11));
+    EXPECT_TRUE(fetch.request_ids().contains(12));
+    EXPECT_EQ(DownloadFetchPriority::kForeground, fetch.fetch_priority());
+  }
+}
