+      boundTestVisible('#no-search-results', false);
+      assertEquals(
+          4, itemList.shadowRoot.querySelectorAll('extensions-item').length);
+    }
+
+    itemList.extensions = [];
+    itemList.apps = [];
+    itemList.filter = 'non-existent name';
+    await microtasksFinished();
+    boundTestVisible('#no-items', true);
+    boundTestVisible('#no-search-results', false);
+    assertEquals(
+        0, itemList.shadowRoot.querySelectorAll('extensions-item').length);
+  });
