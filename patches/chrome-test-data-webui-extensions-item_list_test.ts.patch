+  // <if expr="is_android">
+  test('AndroidPhoneWidths', async () => {
+    for (const direction of ['ltr', 'rtl']) {
+      itemList.dir = direction;
+      for (const width of [320, 360, 393, 768]) {
+        itemList.style.width = `${width}px`;
+        await microtasksFinished();
+        const bounds = itemList.getBoundingClientRect();
+        const cards =
+            itemList.shadowRoot.querySelectorAll('extensions-item');
+        assertTrue(cards.length > 0);
+        for (const card of cards) {
+          const rect = card.getBoundingClientRect();
+          assertTrue(rect.width > 0);
+          assertTrue(rect.left >= bounds.left);
+          assertTrue(rect.right <= bounds.right);
+          assertTrue(rect.width <= 400);
+        }
+        const wrapper =
+            itemList.shadowRoot.querySelector<HTMLElement>('#content-wrapper')!;
+        assertTrue(wrapper.scrollWidth <= wrapper.clientWidth);
+      }
+    }
+  });
+  // </if>
+
