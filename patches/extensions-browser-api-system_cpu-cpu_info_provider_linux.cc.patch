+#if BUILDFLAG(IS_ANDROID)
+bool CpuInfoProvider::ParseCpuTimeForAndroid(
+    const std::string& contents,
+    long ticks_per_second,
+    std::vector<api::system_cpu::ProcessorInfo>* infos) {
+  DCHECK(infos);
+  if (ticks_per_second <= 0) {
+    return false;
+  }
+  const double milliseconds_per_tick = 1000.0 / ticks_per_second;
+  std::istringstream iss(contents);
+  std::string line;
+  // The first row aggregates all processors; the API reports each cpuN row.
+  std::getline(iss, line);
+  while (std::getline(iss, line)) {
+    if (line.compare(0, 3, "cpu") != 0) {
+      continue;
+    }
+    uint64_t user = 0, nice = 0, sys = 0, idle = 0;
+    uint32_t pindex = 0;
+    int vals = UNSAFE_TODO(sscanf(line.c_str(),
+                                "cpu%" SCNu32 " %" SCNu64 " %" SCNu64
+                                " %" SCNu64 " %" SCNu64,
+                                &pindex, &user, &nice, &sys, &idle));
+    if (vals != 5 || pindex >= infos->size()) {
+      return false;
+    }
+    auto& usage = infos->at(pindex).usage;
+    // Convert before adding so valid uint64 counters cannot wrap their sums.
+    usage.kernel = static_cast<double>(sys) * milliseconds_per_tick;
+    usage.user = (static_cast<double>(user) + static_cast<double>(nice)) *
+                 milliseconds_per_tick;
+    usage.idle = static_cast<double>(idle) * milliseconds_per_tick;
+    usage.total = usage.user + usage.kernel + usage.idle;
+  }
   return true;
 }
+#endif  // BUILDFLAG(IS_ANDROID)
 
 }  // namespace extensions
