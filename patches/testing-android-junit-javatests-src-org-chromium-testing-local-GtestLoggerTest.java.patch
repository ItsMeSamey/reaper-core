+    private static JsonRun runJsonFixture(String... methods) throws Exception {
+        File output = File.createTempFile("json-listener-test-", ".json");
+        try {
+            JUnitCore core = new JUnitCore();
+            core.addListener(new JsonListener(new JsonLogger(output)));
+            List<Result> results = new ArrayList<>();
+            for (String method : methods) {
+                results.add(core.run(Request.method(JsonListenerFixture.class, method)));
+            }
+            return new JsonRun(new JSONObject(Files.readString(output.toPath())), results);
+        } finally {
+            Files.deleteIfExists(output.toPath());
+        }
+    }
+
+    private static void assertJsonStatus(JSONObject report, String method, String status)
+            throws Exception {
+        JSONArray iterations = report.getJSONArray("per_iteration_data");
+        Assert.assertEquals(1, iterations.length());
+        JSONArray attempts =
+                iterations.getJSONObject(0)
+                        .getJSONArray(JsonListenerFixture.class.getName() + "#" + method);
+        Assert.assertEquals(1, attempts.length());
+        Assert.assertEquals(status, attempts.getJSONObject(0).getString("status"));
+        Assert.assertTrue(attempts.getJSONObject(0).getLong("elapsed_time_ms") >= 0);
+    }
