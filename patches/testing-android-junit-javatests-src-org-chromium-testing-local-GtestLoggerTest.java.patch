+    @Test
+    public void testGtestListener_RealOutcomesAndStateReset() {
+        GtestListenerFixture.passingBodies = 0;
+        GtestListenerFixture.failingBodies = 0;
+        GtestListenerFixture.assumptionBodies = 0;
+        GtestListenerFixture.assumptionContinued = 0;
+        GtestListenerFixture.ignoredBodies = 0;
+        ByteArrayOutputStream actual = new ByteArrayOutputStream();
+        JUnitCore core = new JUnitCore();
+        core.addListener(new GtestListener(new GtestLogger(new PrintStream(actual))));
+        Result result = core.run(GtestListenerFixture.class);
+        Assert.assertEquals(3, result.getRunCount());
+        Assert.assertEquals(1, result.getFailureCount());
+        Assert.assertEquals(1, result.getAssumptionFailureCount());
+        Assert.assertEquals(1, result.getIgnoreCount());
+        Assert.assertFalse(result.wasSuccessful());
+        Assert.assertEquals(1, GtestListenerFixture.passingBodies);
+        Assert.assertEquals(1, GtestListenerFixture.failingBodies);
+        Assert.assertEquals(1, GtestListenerFixture.assumptionBodies);
+        Assert.assertEquals(0, GtestListenerFixture.assumptionContinued);
+        Assert.assertEquals(0, GtestListenerFixture.ignoredBodies);
+        String output = actual.toString();
+        String fixture = GtestListenerFixture.class.getName() + ".";
+        Assert.assertTrue(output.contains("[       OK ] " + fixture + "passing ("));
+        Assert.assertTrue(output.contains("[   FAILED ] " + fixture + "failing ("));
+        Assert.assertTrue(output.contains("[  SKIPPED ] " + fixture + "assumption ("));
+        Assert.assertTrue(output.contains("[  SKIPPED ] " + fixture + "ignored (0 ms)\n"));
+        Assert.assertFalse(output.contains("[       OK ] " + fixture + "assumption"));
+        Assert.assertFalse(output.contains("[       OK ] " + fixture + "ignored"));
+        Assert.assertTrue(output.contains("[==========] 4 tests ran. ("));
+        Assert.assertTrue(output.contains("[  PASSED  ] 1 tests.\n"));
+        Assert.assertTrue(output.contains("[  SKIPPED ] 2 tests, listed below:\n"));
+        Assert.assertTrue(output.contains("[  FAILED  ] 1 tests.\n"));
+        actual.reset();
+        result = core.run(Request.method(GtestListenerFixture.class, "passing"));
+        Assert.assertEquals(1, result.getRunCount());
+        Assert.assertEquals(0, result.getFailureCount());
+        Assert.assertEquals(0, result.getAssumptionFailureCount());
+        Assert.assertEquals(0, result.getIgnoreCount());
+        Assert.assertEquals(2, GtestListenerFixture.passingBodies);
+        output = actual.toString();
+        Assert.assertTrue(output.contains("[       OK ] " + fixture + "passing ("));
+        Assert.assertTrue(output.contains("[==========] 1 tests ran. ("));
+        Assert.assertTrue(output.contains("[  PASSED  ] 1 tests.\n"));
+        Assert.assertFalse(output.contains("[  SKIPPED ]"));
+        Assert.assertFalse(output.contains("[  FAILED  ]"));
+    }
