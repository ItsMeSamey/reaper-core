+    @Test
+    public void testJsonListener_StateResetsBetweenTests() throws Exception {
+        JsonRun run = runJsonFixture("failing", "assumption", "passing");
+        Assert.assertEquals(1, run.results.get(0).getFailureCount());
+        Assert.assertEquals(1, run.results.get(1).getAssumptionFailureCount());
+        Assert.assertEquals(0, run.results.get(2).getFailureCount());
+        Assert.assertEquals(0, run.results.get(2).getAssumptionFailureCount());
+        assertJsonStatus(run.report, "failing", "FAILURE");
+        assertJsonStatus(run.report, "assumption", "SKIPPED");
+        assertJsonStatus(run.report, "passing", "SUCCESS");
+        Assert.assertEquals(3, run.report.getJSONArray("all_tests").length());
