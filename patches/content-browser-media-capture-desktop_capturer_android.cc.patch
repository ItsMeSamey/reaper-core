+// A Java WebContents observer alone cannot see a requesting subframe enter
+// BFCache, navigate, or disappear. Keep the original document until grant
+// expiry or projection completion, including after the picker itself has been
+// destroyed.
+class ScreenCaptureDocumentObserver final : public WebContentsObserver {
+ public:
+  static bool Register(WebContents* owner,
+                       RenderFrameHost* frame,
+                       int32_t source_id,
+                       base::OnceClosure on_revoke) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    if (!owner || owner->IsBeingDestroyed() || !frame || !frame->IsActive() ||
+        WebContents::FromRenderFrameHost(frame) != owner || source_id <= 0 ||
+        !on_revoke || Observers().contains(source_id)) {
+      return false;
+    }
+    Observers().emplace(source_id,
+                        std::make_unique<ScreenCaptureDocumentObserver>(
+                            frame, source_id, std::move(on_revoke)));
+    return true;
+  }
+
+  static void Release(int32_t source_id) {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    Observers().erase(source_id);
+  }
+
+  ScreenCaptureDocumentObserver(RenderFrameHost* frame,
+                                int32_t source_id,
+                                base::OnceClosure on_revoke)
+      : WebContentsObserver(WebContents::FromRenderFrameHost(frame)),
+        document_(frame->GetWeakDocumentPtr()),
+        frame_id_(frame->GetGlobalId()),
+        source_id_(source_id),
+        on_revoke_(std::move(on_revoke)) {}
+
+  void DidStartNavigation(NavigationHandle* navigation) override {
+    auto* frame = document_.AsRenderFrameHostIfValid();
+    if (!frame ||
+        (!navigation->IsSameDocument() &&
+         navigation->GetFrameTreeNodeId() == frame->GetFrameTreeNodeId())) {
+      Revoke();
+    }
+  }
+
+  void DidFinishNavigation(NavigationHandle* navigation) override {
+    if (!document_.AsRenderFrameHostIfValid())
+      Revoke();
+  }
+
+  void RenderFrameHostStateChanged(
+      RenderFrameHost* frame,
+      RenderFrameHost::LifecycleState old_state,
+      RenderFrameHost::LifecycleState new_state) override {
+    if (frame->GetGlobalId() == frame_id_ &&
+        new_state != RenderFrameHost::LifecycleState::kActive)
+      Revoke();
+  }
+
+  void RenderFrameDeleted(RenderFrameHost* frame) override {
+    if (frame->GetGlobalId() == frame_id_)
+      Revoke();
+  }
+
+  void WebContentsDestroyed() override { Revoke(); }
+
+ private:
+  static std::map<int32_t, std::unique_ptr<ScreenCaptureDocumentObserver>>&
+  Observers() {
+    static base::NoDestructor<
+        std::map<int32_t, std::unique_ptr<ScreenCaptureDocumentObserver>>>
+        observers;
+    return *observers;
+  }
+
+  void Revoke() {
+    DCHECK_CURRENTLY_ON(BrowserThread::UI);
+    auto it = Observers().find(source_id_);
+    if (it == Observers().end() || it->second.get() != this)
+      return;
+    // Remove the entry before Java can synchronously release it. Keep this
+    // observer alive until the callback returns, with no remaining
+    // observations.
+    auto keep_alive = std::move(it->second);
+    Observers().erase(it);
+    Observe(nullptr);
+    std::move(on_revoke_).Run();
+  }
+
+  const WeakDocumentPtr document_;
+  const GlobalRenderFrameHostId frame_id_;
+  const int32_t source_id_;
+  base::OnceClosure on_revoke_;
+};
+
+// Android planes may omit the final row's padding from their ByteBuffer.
+std::optional<base::span<const uint8_t>> GetCroppedPlaneData(
+    JNIEnv* env,
+    const base::android::JavaRef<jobject>& buffer,
+    int pixel_stride,
+    int row_stride,
+    int left,
+    int top,
+    int width,
+    int height) {
+  if (buffer.is_null() || pixel_stride <= 0 || row_stride <= 0 || left < 0 ||
+      top < 0 || width <= 0 || height <= 0) {
+    return std::nullopt;
+  }
+  auto bytes = base::android::MaybeJavaByteBufferToSpan(env, buffer);
+  if (!bytes) {
+    return std::nullopt;
+  }
+  const auto row_end =
+      (base::CheckedNumeric<size_t>(left) + width - 1) * pixel_stride + 1;
+  size_t checked_row_end;
+  size_t checked_end;
+  size_t checked_offset;
+  if (!row_end.AssignIfValid(&checked_row_end) ||
+      checked_row_end > static_cast<size_t>(row_stride) ||
+      !((base::CheckedNumeric<size_t>(top) + height - 1) * row_stride + row_end)
+           .AssignIfValid(&checked_end) ||
+      checked_end > bytes->size() ||
+      !(base::CheckedNumeric<size_t>(top) * row_stride +
+        base::CheckedNumeric<size_t>(left) * pixel_stride)
+           .AssignIfValid(&checked_offset)) {
+    return std::nullopt;
+  }
+  return bytes->subspan(checked_offset, checked_end - checked_offset);
+}
 
