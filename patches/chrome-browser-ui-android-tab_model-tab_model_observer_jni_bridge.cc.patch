 void TabModelObserverJniBridge::NotifyShutdown() {
+  ScopedDispatch dispatch(this);
+  if (shutting_down_) {
+    return;
+  }
+  shutting_down_ = true;
+  // The owner is being destroyed: no deferred callback may refer to it. Stop
+  // Java delivery now, while retaining this dispatcher through native
+  // callbacks.
+  on_empty_.Reset();
+  DetachFromJava();
   for (auto& observer : model_observers_) {
     observer.OnTabModelDestroyed(*tab_model_);
   }
   for (auto& observer : interface_observers_) {
     observer.OnTabListDestroyed(*tab_model_);
   }
+  model_observers_.Clear();
+  interface_observers_.Clear();
+  tab_model_ = nullptr;
 }
 
