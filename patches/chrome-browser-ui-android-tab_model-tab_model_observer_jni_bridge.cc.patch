+
+void TabModelObserverJniBridge::ReleaseOwnerIfEmpty() {
+  if (dispatch_depth_ || has_observers() || !on_empty_) {
+    return;
+  }
+  // The callback may release the last owner reference and delete this bridge.
+  // Keep its callable alive independently and do not access members afterward.
+  auto on_empty = on_empty_;
+  on_empty.Run();
+}
