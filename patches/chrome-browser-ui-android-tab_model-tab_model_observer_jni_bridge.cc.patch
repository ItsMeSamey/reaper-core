+void TabModelObserverJniBridge::DidChangeSplit(
+    JNIEnv* env,
+    const std::vector<int>& affected_tab_ids) {
+  ScopedDispatch dispatch(this);
+  if (shutting_down_) {
+    return;
+  }
+  std::vector<tabs::TabHandle> affected;
+  for (int id : affected_tab_ids) {
+    for (tabs::TabInterface* tab : tab_model_->GetAllTabs()) {
+      if (static_cast<TabAndroid*>(tab)->GetAndroidId() == id) {
+        affected.push_back(tab->GetHandle());
+        break;
+      }
+    }
+  }
+  for (tabs::TabHandle handle : affected) {
+    for (auto& observer : interface_observers_) {
+      auto* tab = handle.Get();
+      if (!tab || tab_model_->GetIndexOfTab(handle) < 0)
+        break;
+      observer.OnSplitChanged(*tab_model_, tab);
+      if (shutting_down_) {
+        return;
+      }
+    }
+  }
 }
 
