+// Layouts: planar, separate stride-two planes, NV12, NV21.
+class DesktopCapturerAndroidYuvTest
+    : public DesktopCapturerAndroidTest,
+      public testing::WithParamInterface<std::tuple<int, bool>> {};
+
+TEST_P(DesktopCapturerAndroidYuvTest, PaddedCroppedKnownColors) {
+  StartCapturer(/*start_success=*/true);
+  const auto [layout, odd_crop] = GetParam();
+  const int uv_pixel_stride = layout == 0 ? 1 : 2;
+  const int y_stride = 8;
+  const int u_stride = layout >= 2 ? 8 : 3 * uv_pixel_stride + 2;
+  const int v_stride = layout >= 2 ? 8 : 3 * uv_pixel_stride + 4;
+  // Only the bytes through the final sample are mapped, not final-row padding.
+  std::vector<uint8_t> y(y_stride * 3 + 6, 0xcd);
+  std::vector<uint8_t> u_storage(u_stride + 2 * uv_pixel_stride + 1, 0xcd);
+  std::vector<uint8_t> v_storage(v_stride + 2 * uv_pixel_stride + 1, 0xcd);
+  std::vector<uint8_t> interleaved(8 + 6, 0xcd);
+  base::span<uint8_t> u(u_storage);
+  base::span<uint8_t> v(v_storage);
+  if (layout >= 2) {
+    u = base::span(interleaved).subspan(layout == 2 ? 0u : 1u);
+    v = base::span(interleaved).subspan(layout == 2 ? 1u : 0u);
+  }
+
+  // BT.601 limited-range red, green and blue in two-by-two chroma blocks.
+  constexpr std::array<std::array<uint8_t, 3>, 3> kYuv = {
+      {{81, 90, 240}, {145, 54, 34}, {41, 240, 110}}};
+  constexpr std::array<std::array<uint8_t, 3>, 3> kRgb = {
+      {{255, 0, 0}, {0, 255, 0}, {0, 0, 255}}};
+  for (int row = 0; row < 4; ++row) {
+    for (int column = 0; column < 6; ++column) {
+      base::span(y)[row * y_stride + column] =
+          kYuv[(row / 2 + column / 2) % 3][0];
+    }
+  }
+  for (int row = 0; row < 2; ++row) {
+    for (int column = 0; column < 3; ++column) {
+      u[row * u_stride + column * uv_pixel_stride] =
+          kYuv[(row + column) % 3][1];
+      v[row * v_stride + column * uv_pixel_stride] =
+          kYuv[(row + column) % 3][2];
+    }
+  }
+  const gfx::Rect crop =
+      odd_crop ? gfx::Rect(1, 1, 3, 3) : gfx::Rect(2, 0, 3, 3);
+  PushI420Frame(y, u, v, y_stride, u_stride, v_stride, uv_pixel_stride, crop);
+  const auto& [result, frame] = CaptureFrame();
+  ASSERT_EQ(result, webrtc::DesktopCapturer::Result::SUCCESS);
+  ASSERT_TRUE(frame);
+  ASSERT_EQ(frame->size().width(), crop.width());
+  ASSERT_EQ(frame->size().height(), crop.height());
+  EXPECT_EQ(frame->pixel_format(), webrtc::FOURCC_ABGR);
+  EXPECT_EQ(frame->capture_time_ms(), 0);
+  const webrtc::DesktopRegion region(
+      webrtc::DesktopRect::MakeSize(frame->size()));
+  EXPECT_TRUE(frame->updated_region().Equals(region));
+  // SAFETY: BasicDesktopFrame owns stride * height bytes.
+  const auto pixels = UNSAFE_BUFFERS(
+      base::span(frame->data(),
+                 base::checked_cast<size_t>(frame->stride() * crop.height())));
+  for (int row = 0; row < crop.height(); ++row) {
+    for (int column = 0; column < crop.width(); ++column) {
+      const auto& expected =
+          kRgb[((row + crop.y()) / 2 + (column + crop.x()) / 2) % 3];
+      const auto pixel = pixels.subspan(row * frame->stride() + column * 4, 4u);
+      for (int channel = 0; channel < 3; ++channel) {
+        EXPECT_NEAR(pixel[channel], expected[channel], 2);
+      }
+      EXPECT_EQ(pixel[3], 255);
+    }
+  }
+}
+
+INSTANTIATE_TEST_SUITE_P(Android420Layouts,
+                         DesktopCapturerAndroidYuvTest,
+                         testing::Combine(testing::Values(0, 1, 2, 3),
+                                          testing::Bool()));
