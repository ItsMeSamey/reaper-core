+
+  std::unique_ptr<sessions::SessionWindow> MakeWindow(int selected_index,
+                                                      int last_index = 3) {
+    auto window = std::make_unique<sessions::SessionWindow>();
+    window->window_id = SessionID::NewUnique();
+    window->type = sessions::SessionWindow::TYPE_NORMAL;
+    window->selected_tab_index = selected_index;
+    for (int tab_index = 0; tab_index <= last_index; ++tab_index) {
+      auto tab = std::make_unique<sessions::SessionTab>();
+      tab->window_id = window->window_id;
+      tab->tab_id = SessionID::NewUnique();
+      tab->tab_visual_index = tab_index;
+      tab->current_navigation_index = 1;
+      tab->pinned = tab_index == 0;
+      if (tab_index != 1) {
+        for (int i = 0; i < 3; ++i) {
+          sessions::SerializedNavigationEntry navigation;
+          navigation.set_index(i);
+          navigation.set_virtual_url(SavedUrl(tab_index, i));
+          navigation.set_title(u"Saved page");
+          navigation.set_transition_type(ui::PAGE_TRANSITION_TYPED);
+          tab->navigations.push_back(std::move(navigation));
+        }
+      }
+      window->tabs.push_back(std::move(tab));
+    }
+    return window;
+  }
+
+  BrowserWindowInterface* FindRestoredWindow(const base::Value& result) {
+    const auto* window = result.GetDict().FindDict("window");
+    if (!window) {
+      ADD_FAILURE() << "sessions.restore did not return a window";
+      return nullptr;
+    }
+    const int id = utils::GetInteger(*window, "id");
+    BrowserWindowInterface* match = nullptr;
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* browser) {
+          if (ExtensionTabUtil::GetWindowId(browser) == id) {
+            match = browser;
+            return false;
+          }
+          return true;
+        });
+    return match;
+  }
+
+  void ExpectWindow(BrowserWindowInterface* browser,
+                    const std::vector<int>& original_indices,
+                    int active_index,
+                    const std::set<int>& pinned_indices = {0}) {
+    ASSERT_TRUE(browser);
+    EXPECT_EQ(GetProfile(), browser->GetProfile());
+    auto* tabs = TabListInterface::From(browser);
+    ASSERT_TRUE(tabs);
+    ASSERT_EQ(static_cast<int>(original_indices.size()), tabs->GetTabCount());
+    EXPECT_EQ(active_index, tabs->GetActiveIndex());
+    ASSERT_TRUE(tabs->GetActiveTab());
+    ASSERT_TRUE(content::WaitForLoadStop(tabs->GetActiveTab()->GetContents()));
+    for (int i = 0; i < tabs->GetTabCount(); ++i) {
+      SCOPED_TRACE(i);
+      auto* tab = tabs->GetTab(i);
+      EXPECT_EQ(pinned_indices.contains(original_indices[i]), tab->IsPinned());
+      auto* contents = tab->GetContents();
+      ASSERT_TRUE(contents);
+      EXPECT_EQ(GetProfile(), contents->GetBrowserContext());
+      auto& controller = contents->GetController();
+      ASSERT_EQ(3, controller.GetEntryCount());
+      EXPECT_EQ(1, controller.GetCurrentEntryIndex());
+      EXPECT_TRUE(controller.CanGoBack());
+      EXPECT_TRUE(controller.CanGoForward());
+      for (int j = 0; j < 3; ++j) {
+        EXPECT_EQ(SavedUrl(original_indices[i], j),
+                  controller.GetEntryAtIndex(j)->GetVirtualURL());
+      }
+    }
+  }
+
+  size_t WindowCount() {
+    size_t count = 0;
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* browser) {
+          if (browser->GetProfile() == GetProfile()) {
+            ++count;
+          }
+          return true;
+        });
+    return count;
+  }
+
+ private:
+  std::set<int> initial_window_ids_;
+};
