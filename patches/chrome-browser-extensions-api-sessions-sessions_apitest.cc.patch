+// Exercise the real native tab history together with the real Java
+// closed-window manager. Only native entry timestamps/IDs are adjusted to make
+// ordering and numeric namespace collisions deterministic, without sleeps or a
+// fake backend.
+class ExtensionSessionsMixedHistoryTest : public ExtensionSessionsTest {
+ protected:
+  void CreateMixedHistory(bool grouped_split = false, bool extra_tab = false) {
+    auto* service = TabRestoreServiceFactory::GetForProfile(GetProfile());
+    ASSERT_TRUE(service);
+    ASSERT_TRUE(service->entries().empty());
+    NavigateToURLInNewTab(GURL("chrome://version/"));
+    CloseTabForWebContents(GetWebContentsAt(1));
+    ASSERT_EQ(1u, service->entries().size());
+    ASSERT_EQ(sessions::tab_restore::Type::TAB,
+              service->entries().front()->type);
+
+    BrowserWindowInterface* second =
+        CreateBrowserWindowWithType(BrowserWindowInterface::TYPE_NORMAL);
+    ASSERT_TRUE(second);
+    auto* tabs = TabListInterface::From(second);
+    ASSERT_TRUE(tabs);
+    ASSERT_EQ(1, tabs->GetTabCount());
+    auto* contents = tabs->GetTab(0)->GetContents();
+    ASSERT_TRUE(NavigateToURL(contents, GURL("chrome://version/")));
+    ASSERT_TRUE(NavigateToURL(contents, GURL("chrome://credits/")));
+    window_navigation_count_ = contents->GetController().GetEntryCount();
+    ASSERT_GE(window_navigation_count_, 2);
+    if (grouped_split || extra_tab) {
+      tabs->OpenTab(GURL("chrome://version/"), -1);
+      ASSERT_EQ(2, tabs->GetTabCount());
+      ASSERT_TRUE(content::WaitForLoadStop(tabs->GetTab(1)->GetContents()));
+    }
+    if (grouped_split) {
+      std::vector<tabs::TabHandle> members = {tabs->GetTab(0)->GetHandle(),
+                                              tabs->GetTab(1)->GetHandle()};
+      group_id_ = tabs->CreateTabGroup(members);
+      ASSERT_TRUE(group_id_);
+      tabs->SetTabGroupVisualData(
+          *group_id_,
+          tab_groups::TabGroupVisualData(u"Restored group",
+                                         tab_groups::TabGroupColorId::kBlue));
+      tabs->ActivateTab(members[0]);
+      split_id_ = tabs->CreateSplit(members);
+      ASSERT_TRUE(split_id_);
+    }
+    CloseWindowAndWait(second);
+
+    auto result = utils::RunFunctionAndReturnSingleResult(
+        CreateFunction<SessionsGetRecentlyClosedFunction>(true).get(), "[]",
+        GetProfile());
+    ASSERT_TRUE(result);
+    ASSERT_TRUE(result->is_list());
+    ASSERT_EQ(2u, result->GetList().size());
+    for (const auto& entry : result->GetList()) {
+      if (const auto* window = entry.GetDict().FindDict("window")) {
+        window_session_id_ = utils::GetString(*window, "sessionId");
+        const auto* closed_tabs = window->FindList("tabs");
+        ASSERT_TRUE(closed_tabs);
+        for (const auto& closed_tab : *closed_tabs) {
+          child_session_ids_.push_back(
+              utils::GetString(closed_tab.GetDict(), "sessionId"));
+        }
+      }
+    }
+    constexpr char prefix[] = "android-window:";
+    ASSERT_TRUE(window_session_id_.starts_with(prefix));
+    const auto separator = window_session_id_.find(':', sizeof(prefix) - 1);
+    ASSERT_NE(std::string::npos, separator);
+    ASSERT_TRUE(base::StringToInt(
+        window_session_id_.substr(sizeof(prefix) - 1,
+                                  separator - (sizeof(prefix) - 1)),
+        &window_instance_id_));
+    ASSERT_TRUE(base::StringToInt64(window_session_id_.substr(separator + 1),
+                                    &window_closure_time_));
+    ASSERT_EQ(1u, service->entries().size());
+  }
+
+  std::optional<base::Value> Restore(const std::string& arguments) {
+    return utils::RunFunctionAndReturnSingleResult(
+        CreateFunction<SessionsRestoreFunction>(true).get(), arguments,
+        GetProfile());
+  }
+
+  std::string window_session_id_;
+  int window_instance_id_ = -1;
+  int window_navigation_count_ = 0;
+  int64_t window_closure_time_ = 0;
+  std::vector<std::string> child_session_ids_;
+  std::optional<tab_groups::TabGroupId> group_id_;
+  std::optional<split_tabs::SplitTabId> split_id_;
+};
