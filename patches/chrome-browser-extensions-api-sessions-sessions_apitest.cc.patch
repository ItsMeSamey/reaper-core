+  ASSERT_GT(window_instance_id_, 0);
+  service->entries().front()->id =
+      SessionID::FromSerializedValue(window_instance_id_);
+  BrowserCreatedWaiter waiter;
+  auto result = Restore("[\"" + window_session_id_ + "\"]");
+  ASSERT_TRUE(result);
