+class ExtensionSessionsNativeCollectionsTest : public ExtensionSessionsTest {
+ protected:
+  TabModel* model() {
+    return static_cast<TabModel*>(
+        TabListInterface::From(browser_window_interface()));
+  }
+
+  void CloseGroupedTab() {
+    NavigateToURLInNewTab(GURL("chrome://version/"));
+    auto* contents = GetWebContentsAt(1);
+    ASSERT_TRUE(NavigateToURL(contents, GURL("chrome://credits/")));
+    navigation_count_ = contents->GetController().GetEntryCount();
+    NavigateToURLInNewTab(GURL("chrome://version/"));
+    auto group = model()->CreateTabGroup(
+        {model()->GetTab(1)->GetHandle(), model()->GetTab(2)->GetHandle()});
+    ASSERT_TRUE(group);
+    model()->SetTabGroupVisualData(
+        *group, tab_groups::TabGroupVisualData(
+                    u"Native saved group", tab_groups::TabGroupColorId::kBlue));
+    CloseTabForWebContents(contents);
+    auto* service = TabRestoreServiceFactory::GetForProfile(GetProfile());
+    ASSERT_EQ(1u, service->entries().size());
+    ASSERT_EQ(sessions::tab_restore::Type::TAB,
+              service->entries().front()->type);
+    const auto& saved = static_cast<const sessions::tab_restore::Tab&>(
+        *service->entries().front());
+    ASSERT_TRUE(saved.group);
+    closed_id_ = saved.id;
+  }
+
+  void CloseSplit() {
+    NavigateToURLInNewTab(GURL("chrome://version/"));
+    NavigateToURLInNewTab(GURL("chrome://credits/"));
+    auto* first = model()->GetTab(1)->GetContents();
+    auto* second = model()->GetTab(2)->GetContents();
+    model()->ActivateTab(model()->GetTab(1)->GetHandle());
+    auto split = model()->CreateSplit(
+        {model()->GetTab(1)->GetHandle(), model()->GetTab(2)->GetHandle()});
+    ASSERT_TRUE(split);
+    auto* service = TabRestoreServiceFactory::GetForProfile(GetProfile());
+    // Use the real service's closing-split transaction. The subsequent real tab
+    // closes are suppressed by its cached session IDs, exactly as bulk closure.
+    service->CreateHistoricalSplit(model()->GetLiveTabContext(), *split);
+    ASSERT_EQ(1u, service->entries().size());
+    ASSERT_EQ(sessions::tab_restore::Type::SPLIT,
+              service->entries().front()->type);
+    const auto& saved = static_cast<const sessions::tab_restore::Split&>(
+        *service->entries().front());
+    ASSERT_EQ(2u, saved.tabs.size());
+    closed_id_ = saved.id;
+    first_child_id_ = saved.tabs[0]->id;
+    second_child_id_ = saved.tabs[1]->id;
+    CloseTabForWebContents(first);
+    CloseTabForWebContents(second);
