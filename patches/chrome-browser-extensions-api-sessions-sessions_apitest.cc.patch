+// Keep both closed instances distinct: create both live windows before closing
+// either, so allocation cannot reuse a formerly closed instance slot.
+class ExtensionSessionsMultipleWindowsTest : public ExtensionSessionsTest {
+ protected:
+  void CreateHistories() {
+    NavigateToURLInNewTab(GURL("chrome://version/"));
+    CloseTabForWebContents(GetWebContentsAt(1));
+    auto* first =
+        CreateBrowserWindowWithType(BrowserWindowInterface::TYPE_NORMAL);
+    auto* second =
+        CreateBrowserWindowWithType(BrowserWindowInterface::TYPE_NORMAL);
+    ASSERT_TRUE(first);
+    ASSERT_TRUE(second);
+    ASSERT_NE(first, second);
+    ASSERT_TRUE(
+        NavigateToURL(TabListInterface::From(first)->GetTab(0)->GetContents(),
+                      GURL("chrome://version/")));
+    ASSERT_TRUE(
+        NavigateToURL(TabListInterface::From(second)->GetTab(0)->GetContents(),
+                      GURL("chrome://credits/")));
+    CloseWindowAndWait(first);
+    CloseWindowAndWait(second);
+  }
+
+  std::optional<base::Value> List(const std::string& arguments = "[]") {
+    return utils::RunFunctionAndReturnSingleResult(
+        CreateFunction<SessionsGetRecentlyClosedFunction>(true).get(),
+        arguments, GetProfile());
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(ExtensionSessionsMultipleWindowsTest,
+                       ListsBothWindowsAndNativeTabWithDistinctChildren) {
+  ASSERT_NO_FATAL_FAILURE(CreateHistories());
+  auto result = List();
+  ASSERT_TRUE(result);
+  ASSERT_EQ(3u, result->GetList().size());
+  std::vector<std::string> window_ids;
+  std::vector<std::string> child_ids;
+  size_t native_count = 0;
+  for (const auto& session : result->GetList()) {
+    const auto* window = session.GetDict().FindDict("window");
+    if (!window) {
+      ASSERT_TRUE(session.GetDict().FindDict("tab"));
+      ++native_count;
+      continue;
+    }
+    window_ids.push_back(utils::GetString(*window, "sessionId"));
+    const auto* tabs = window->FindList("tabs");
+    ASSERT_TRUE(tabs);
+    ASSERT_EQ(1u, tabs->size());
+    child_ids.push_back(utils::GetString((*tabs)[0].GetDict(), "sessionId"));
+  }
+  EXPECT_EQ(1u, native_count);
+  ASSERT_EQ(2u, window_ids.size());
+  EXPECT_NE(window_ids[0], window_ids[1]);
+  EXPECT_NE(child_ids[0], child_ids[1]);
+}
+
+IN_PROC_BROWSER_TEST_F(ExtensionSessionsMultipleWindowsTest,
+                       MaxResultsBoundsTheMergedHistoryAndAllowsZero) {
+  ASSERT_NO_FATAL_FAILURE(CreateHistories());
+  auto* service = TabRestoreServiceFactory::GetForProfile(GetProfile());
+  ASSERT_EQ(1u, service->entries().size());
+  service->entries().front()->timestamp = base::Time::Now() + base::Days(1);
+  auto empty = List("[{\"maxResults\":0}]");
+  ASSERT_TRUE(empty);
+  EXPECT_TRUE(empty->GetList().empty());
+  auto one = List("[{\"maxResults\":1}]");
+  ASSERT_TRUE(one);
+  ASSERT_EQ(1u, one->GetList().size());
+  EXPECT_TRUE(one->GetList()[0].GetDict().FindDict("tab"));
+  auto two = List("[{\"maxResults\":2}]");
+  ASSERT_TRUE(two);
+  ASSERT_EQ(2u, two->GetList().size());
+  EXPECT_TRUE(two->GetList()[0].GetDict().FindDict("tab"));
+  EXPECT_TRUE(two->GetList()[1].GetDict().FindDict("window"));
+  auto all = List();
+  ASSERT_TRUE(all);
+  EXPECT_EQ(3u, all->GetList().size());
+}
+
+IN_PROC_BROWSER_TEST_F(ExtensionSessionsMultipleWindowsTest,
+                       NativeWindowMergeUsesMillisecondsWithinTheSameSecond) {
+  ASSERT_NO_FATAL_FAILURE(CreateHistories());
+  auto all = List();
+  ASSERT_TRUE(all);
+  int64_t latest_window = 0;
+  std::string latest_id;
+  for (const auto& session : all->GetList()) {
+    if (const auto* window = session.GetDict().FindDict("window")) {
+      const auto id = utils::GetString(*window, "sessionId");
+      int64_t timestamp;
+      ASSERT_TRUE(
+          base::StringToInt64(id.substr(id.rfind(':') + 1), &timestamp));
+      if (timestamp > latest_window) {
+        latest_window = timestamp;
+        latest_id = id;
+      }
+    }
+  }
+  ASSERT_GT(latest_window, 0);
+  auto* service = TabRestoreServiceFactory::GetForProfile(GetProfile());
+  ASSERT_EQ(1u, service->entries().size());
+  // When the real close happened exactly on a whole second, use the next
+  // millisecond and require native first; otherwise require window first.
+  const bool native_newer = latest_window % 1000 == 0;
+  service->entries().front()->timestamp =
+      base::Time::FromMillisecondsSinceUnixEpoch(latest_window +
+                                                 (native_newer ? 1 : -1));
+  auto result = List("[{\"maxResults\":1}]");
+  ASSERT_TRUE(result);
+  ASSERT_EQ(1u, result->GetList().size());
+  if (native_newer) {
+    EXPECT_TRUE(result->GetList()[0].GetDict().FindDict("tab"));
+  } else {
+    const auto* window = result->GetList()[0].GetDict().FindDict("window");
+    ASSERT_TRUE(window);
+    EXPECT_EQ(latest_id, utils::GetString(*window, "sessionId"));
+  }
+}
