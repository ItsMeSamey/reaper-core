+    base::RunLoop().RunUntilIdle();
+    auto* delegate = service->GetOpenTabsUIDelegate();
+    ASSERT_TRUE(delegate);
+    auto windows = delegate->GetForeignSession("foreign-window");
+    ASSERT_EQ(1u, windows.size());
+    ASSERT_EQ(3u, windows[0]->tabs.size());
