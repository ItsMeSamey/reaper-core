+  EXPECT_EQ(GURL("chrome://credits/"), contents->GetURL());
+  EXPECT_EQ(window_navigation_count_,
+            contents->GetController().GetEntryCount());
+  ASSERT_EQ(1u, service->entries().size());
+  EXPECT_EQ(window_instance_id_, service->entries().front()->id.id());
