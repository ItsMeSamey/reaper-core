+class ExtensionSessionsAndroidForeignWindowTest : public ExtensionSessionsTest {
+ public:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    ExtensionSessionsTest::SetUpCommandLine(command_line);
+    // The restored window launches a normal ChromeTabbedActivity.
+    command_line->AppendSwitch("disable-fre");
+  }
+
+  void SetUpOnMainThread() override {
+    ExtensionSessionsTest::SetUpOnMainThread();
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* browser) {
+          initial_window_ids_.insert(ExtensionTabUtil::GetWindowId(browser));
+          return true;
+        });
+    base::FilePath test_data;
+    ASSERT_TRUE(base::PathService::Get(chrome::DIR_TEST_DATA, &test_data));
+    embedded_test_server()->ServeFilesFromDirectory(test_data);
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  void TearDownOnMainThread() override {
+    // Close only windows created by this fixture, including a window left by a
+    // failing assertion. Closing tabs alone does not explicitly finish each
+    // additional ChromeTabbedActivity.
+    std::vector<base::WeakPtr<BrowserWindowInterface>> restored_windows;
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* browser) {
+          if (!initial_window_ids_.contains(
+                  ExtensionTabUtil::GetWindowId(browser))) {
+            restored_windows.push_back(browser->GetWeakPtr());
+          }
+          return true;
+        });
+    for (const auto& browser : restored_windows) {
+      if (browser) {
+        browser->GetWindow()->Close();
+      }
+    }
+    EXPECT_TRUE(base::test::RunUntil([&] {
+      for (const auto& browser : restored_windows) {
+        if (browser) {
+          return false;
+        }
+      }
+      return true;
+    }));
+    ExtensionSessionsTest::TearDownOnMainThread();
+  }
+
+ protected:
+  GURL SavedUrl(int tab, int navigation) {
+    return embedded_test_server()->GetURL(base::StringPrintf(
+        "/title1.html?tab=%d&navigation=%d", tab, navigation));
+  }
+
+  void CreateForeignWindowModel(
+      bool popup = false,
+      std::unique_ptr<syncer::MockDataTypeWorker>* retained_worker = nullptr) {
+    syncer::DataTypeActivationRequest request;
+    request.error_handler = base::DoNothing();
+    request.cache_guid = kTestCacheGuid;
+    request.authenticated_gaia_id = GaiaId("SomeGaiaId");
+    auto* service = SessionSyncServiceFactory::GetForProfile(GetProfile());
+    base::test::TestFuture<std::unique_ptr<syncer::DataTypeActivationResponse>>
+        sync_start;
+    service->GetControllerDelegate()->OnSyncStarting(request,
+                                                     sync_start.GetCallback());
+    auto worker = syncer::MockDataTypeWorker::CreateWorkerAndConnectSync(
+        sync_start.Take());
+
+    sync_pb::EntitySpecifics header;
+    BuildSessionSpecifics("foreign-window", header.mutable_session());
+    BuildWindowSpecifics(20, {100, 101, 102}, header.mutable_session());
+    auto* window =
+        header.mutable_session()->mutable_header()->mutable_window(0);
+    window->set_selected_tab_index(2);
+    window->set_browser_type(popup
+                                 ? sync_pb::SyncEnums_BrowserType_TYPE_POPUP
+                                 : sync_pb::SyncEnums_BrowserType_TYPE_TABBED);
+    syncer::EntityData data;
+    data.client_tag_hash = TagHashFromSpecifics(header.session());
+    data.id = "FakeId:" + data.client_tag_hash.value();
+    data.specifics = header;
+    data.creation_time = base::Time::Now();
+    data.modification_time = data.creation_time;
+    syncer::UpdateResponseData update;
+    update.entity = std::move(data);
+    update.response_version = 1;
+    syncer::UpdateResponseDataList updates;
+    updates.push_back(std::move(update));
+    worker->UpdateFromServer(std::move(updates));
+    for (int tab_index = 0; tab_index < 3; ++tab_index) {
+      sync_pb::EntitySpecifics entity;
+      BuildTabSpecifics("foreign-window", 100 + tab_index, tab_index,
+                        entity.mutable_session());
+      auto* tab = entity.mutable_session()->mutable_tab();
+      tab->set_window_id(20);
+      tab->set_tab_visual_index(tab_index);
+      tab->set_current_navigation_index(1);
+      tab->set_pinned(tab_index == 0);
+      tab->clear_navigation();
+      for (int i = 0; i < 3; ++i) {
+        auto* navigation = tab->add_navigation();
+        navigation->set_virtual_url(SavedUrl(tab_index, i).spec());
+        navigation->set_title("Saved page");
+        navigation->set_page_transition(
+            sync_pb::SyncEnums_PageTransition_TYPED);
+      }
+      worker->UpdateFromServer(TagHashFromSpecifics(entity.session()), entity);
+    }
+    // Exercise the real SessionSyncService model, not a restore delegate fake.
+    base::RunLoop().RunUntilIdle();
+    if (retained_worker) {
+      *retained_worker = std::move(worker);
