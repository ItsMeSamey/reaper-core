+  async function flushOptionsPresentation(timer: MockTimer) {
+    timer.tick(0);
+    // The first render removes the old owner; the second mounts the new one.
+    await manager.updateComplete;
+    await manager.updateComplete;
+    const dialog =
+        manager.shadowRoot.querySelector('extensions-options-dialog');
+    if (dialog) {
+      await dialog.updateComplete;
+    }
+    await Promise.resolve();
+    return dialog;
