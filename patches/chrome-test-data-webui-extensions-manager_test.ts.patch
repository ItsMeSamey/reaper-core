+      const pendingRetry = new PromiseResolver<boolean>();
+      dialog.delegate = {retryLoadUnpacked: () => pendingRetry.promise};
+      const retry = dialog.shadowRoot.querySelector<HTMLElement>('.action-button')!;
+      retry.click();
