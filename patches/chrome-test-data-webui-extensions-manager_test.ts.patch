+  // Hold the actual manager's zero-delay presentation boundary. Guest creation
+  // is a separate options-dialog suite; here we observe the public show call.
+  async function withPendingOptions(
+      run: (timer: MockTimer, shownIds: string[]) => Promise<void>) {
+    const prototype = customElements.get('extensions-options-dialog')!
+                          .prototype as ExtensionsOptionsDialogElement;
+    const originalShow = prototype.show;
+    const shownIds: string[] = [];
+    const timer = new MockTimer();
+    prototype.show = function(info: chrome.developerPrivate.ExtensionInfo) {
+      shownIds.push(info.id);
+    };
+    timer.install();
+    const mockSetTimeout = window.setTimeout.bind(window);
+    const callbackResults: Array<Promise<void>> = [];
+    const callbackErrors: unknown[] = [];
+    // MockTimer ignores callback return values. Observe the actual async
+    // presentation callback so a rejected stale DOM lookup fails this test.
+    window.setTimeout = ((
+        handler: TimerHandler, delay?: number, ...args: unknown[]) => {
+      if (typeof handler !== 'function') {
+        return mockSetTimeout(handler, delay, ...args);
+      }
+      return mockSetTimeout(() => {
+        const result = handler(...args);
+        if (result instanceof Promise) {
+          // Attach both handlers immediately; do not leave a stray rejected
+          // promise for browser-global error handling after the test ends.
+          callbackResults.push(result.then(
+              () => {}, error => {callbackErrors.push(error);}));
+        }
+      }, delay);
+    }) as typeof window.setTimeout;
+    try {
+      await run(timer, shownIds);
+      await Promise.all(callbackResults);
+      assertEquals(0, callbackErrors.length, String(callbackErrors[0]));
+    } finally {
+      timer.uninstall();
+      prototype.show = originalShow;
+      navigation.navigateTo({page: Page.LIST});
+    }
+  }
