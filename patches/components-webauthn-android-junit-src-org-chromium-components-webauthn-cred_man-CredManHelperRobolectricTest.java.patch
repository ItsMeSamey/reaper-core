+    private ShadowCredentialManager startGetRequestForRetiredResultTest() {
+        mRequestCallback =
+                WebauthnRequestCallback.forGetCredential(mGetCredentialResponseCallback, null);
+        when(mAuthenticationContextProviderMock.getRequestCallback()).thenReturn(mRequestCallback);
+        int status =
+                mCredManHelper.startGetRequest(
+                        mRequestOptions, mOriginString, null, mClientDataHash, false);
+        assertThat(status).isEqualTo(AuthenticatorStatus.SUCCESS);
+        ShadowCredentialManager manager = Shadow.extract(mCredentialManager);
+        assertThat(manager.getGetCredentialCallback()).isNotNull();
+        // The per-request provider returns null after cancellation, even when a
+        // replacement request in this document is using the same browser bridge.
+        when(mAuthenticationContextProviderMock.getRequestCallback()).thenReturn(null);
+        Mockito.clearInvocations(mBrowserBridge, mGetCredentialResponseCallback, mFrameHost);
+        return manager;
+    }
+
+    @Test
+    @SmallTest
+    public void testRetiredGetErrorDoesNotMutateBrowserDelegate() {
+        ShadowCredentialManager manager = startGetRequestForRetiredResultTest();
+        manager.getGetCredentialCallback()
+                .onError(
+                        new GetCredentialException(
+                                GetCredentialException.TYPE_USER_CANCELED, "late"));
+        Mockito.verifyNoInteractions(mBrowserBridge, mGetCredentialResponseCallback, mFrameHost);
+    }
+
+    @Test
+    @SmallTest
+    public void testRetiredGetResultDoesNotFillOrCleanBrowserDelegate() {
+        ShadowCredentialManager manager = startGetRequestForRetiredResultTest();
+        manager.getGetCredentialCallback()
+                .onResult(
+                        new GetCredentialResponse(
+                                createPasswordCredential("old-user", "old-password")));
+        Mockito.verifyNoInteractions(mBrowserBridge, mGetCredentialResponseCallback, mFrameHost);
+    }
+
+    @Test
+    @SmallTest
+    public void testRetiredConditionalBarrierDoesNotPublishNewBrowserRequest() {
+        mRequestOptions.mediation = Mediation.CONDITIONAL;
+        mRequestCallback =
+                WebauthnRequestCallback.forGetCredential(mGetCredentialResponseCallback, null);
+        when(mAuthenticationContextProviderMock.getRequestCallback()).thenReturn(mRequestCallback);
+        mCredManHelper.startPrefetchRequest(
+                mRequestOptions, mOriginString, null, mClientDataHash, mBarrier, null, false);
+        ShadowCredentialManager manager = Shadow.extract(mCredentialManager);
+        manager.getPrepareGetCredentialCallback()
+                .onResult(Shadow.newInstanceOf(PrepareGetCredentialResponse.class));
+        ArgumentCaptor<Runnable> ready = ArgumentCaptor.forClass(Runnable.class);
+        verify(mBarrier).onCredManSuccessful(ready.capture());
+        when(mAuthenticationContextProviderMock.getRequestCallback()).thenReturn(null);
+        Mockito.clearInvocations(mBrowserBridge, mGetCredentialResponseCallback, mFrameHost);
+
+        // Enumeration completed before cancellation, but the delayed barrier
+        // must not install the old request into a replacement document delegate.
+        ready.getValue().run();
+        Mockito.verifyNoInteractions(mBrowserBridge, mGetCredentialResponseCallback, mFrameHost);
+        assertThat(manager.getGetCredentialCallback()).isNull();
+    }
