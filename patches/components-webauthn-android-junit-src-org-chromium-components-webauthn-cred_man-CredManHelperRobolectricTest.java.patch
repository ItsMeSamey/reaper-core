+    @Test
+    @SmallTest
+    public void testCompletionCleanupUsesOriginalBridgeWithoutResolvingReplacement() {
+        WebauthnBrowserBridge replacement = Mockito.mock(WebauthnBrowserBridge.class);
+        java.util.concurrent.atomic.AtomicReference<WebauthnBrowserBridge> currentBridge =
+                new java.util.concurrent.atomic.AtomicReference<>(mBrowserBridge);
+        mCredManHelper =
+                new CredManHelper(
+                        mAuthenticationContextProviderMock,
+                        currentBridge::get,
+                        /* playServicesAvailable= */ true);
+        mCredManHelper.setMetricsHelperForTesting(mMetricsHelper);
+        mRequestCallback =
+                WebauthnRequestCallback.forGetCredential(mGetCredentialResponseCallback, null);
+        when(mAuthenticationContextProviderMock.getRequestCallback()).thenReturn(mRequestCallback);
+        assertThat(
+                        mCredManHelper.startGetRequest(
+                                mRequestOptions, mOriginString, null, mClientDataHash, false))
+                .isEqualTo(AuthenticatorStatus.SUCCESS);
+        // Completion callbacks must not consult a provider that now resolves a
+        // different request's document-scoped bridge.
+        currentBridge.set(replacement);
+        mRequestCallback.onComplete(
+                WebauthnRequestResponse.forFailedGetCredential(
+                        AuthenticatorStatus.ABORT_ERROR, new RequestMetrics.Builder().build()));
+        verify(mBrowserBridge).cleanupRequest(any());
+        Mockito.verifyNoInteractions(replacement);
+    }
