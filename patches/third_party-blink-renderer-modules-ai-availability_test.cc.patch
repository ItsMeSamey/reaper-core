+TEST(AvailabilityTest, AndroidTranslatorStatusesPreserveAvailability) {
+  base::HistogramTester histograms;
+  using Result = mojom::blink::CanCreateTranslatorResult;
+  struct Case {
+    Result result;
+    Availability expected;
+  };
+  const Case cases[] = {
+      {Result::kReadily, Availability::kAvailable},
+      {Result::kAfterDownloadLibraryNotReady, Availability::kDownloadable},
+      {Result::kAfterDownloadLanguagePackNotReady, Availability::kDownloadable},
+      {Result::kAfterDownloadLibraryAndLanguagePackNotReady,
+       Availability::kDownloadable},
+      {Result::kAfterDownloadTranslatorCreationRequired,
+       Availability::kDownloadable},
+      {Result::kNoNotSupportedLanguage, Availability::kUnavailable},
+      {Result::kNoServiceCrashed, Availability::kUnavailable},
+      {Result::kNoDisallowedByPolicy, Availability::kUnavailable},
+      {Result::kNoExceedsServiceCountLimitation, Availability::kUnavailable},
+      {Result::kNoInvalidStoragePartition, Availability::kUnavailable},
+  };
+  for (const auto& test_case : cases) {
+    EXPECT_EQ(
+        HandleTranslatorAvailabilityCheckResult(nullptr, test_case.result),
+        test_case.expected);
+  }
+  const auto name = AIMetrics::GetAvailabilityMetricName(
+      AIMetrics::AISessionType::kTranslator);
+  histograms.ExpectBucketCount(name, Availability::kAvailable, 1);
+  histograms.ExpectBucketCount(name, Availability::kDownloadable, 4);
+  histograms.ExpectBucketCount(name, Availability::kUnavailable, 5);
+  histograms.ExpectTotalCount(name, 10);
+}
+
+TEST(AvailabilityTest, AndroidDetectionStatusesPreserveAvailability) {
+  base::HistogramTester histograms;
+  using Result = language_detection::mojom::blink::LanguageDetectionModelStatus;
+  EXPECT_EQ(HandleLanguageDetectionModelCheckResult(nullptr, Result::kReadily),
+            Availability::kAvailable);
+  EXPECT_EQ(
+      HandleLanguageDetectionModelCheckResult(nullptr, Result::kAfterDownload),
+      Availability::kDownloadable);
+  EXPECT_EQ(
+      HandleLanguageDetectionModelCheckResult(nullptr, Result::kNotAvailable),
+      Availability::kUnavailable);
+  const auto name = AIMetrics::GetAvailabilityMetricName(
+      AIMetrics::AISessionType::kLanguageDetector);
+  histograms.ExpectBucketCount(name, Availability::kAvailable, 1);
+  histograms.ExpectBucketCount(name, Availability::kDownloadable, 1);
+  histograms.ExpectBucketCount(name, Availability::kUnavailable, 1);
+  histograms.ExpectTotalCount(name, 3);
+}
