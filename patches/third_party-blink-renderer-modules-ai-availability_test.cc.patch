+namespace {
+base::ScopedClosureRunner TrapOptionalModelBinding(
+    const BrowserInterfaceBrokerProxy& broker,
+    int* bindings) {
+  EXPECT_TRUE(broker.SetBinderForTesting(
+      "blink.mojom.AIManager",
+      base::BindRepeating(
+          [](int* calls, mojo::ScopedMessagePipeHandle pipe) { ++*calls; },
+          base::Unretained(bindings))));
+  return base::ScopedClosureRunner(base::BindOnce(
+      [](const BrowserInterfaceBrokerProxy* broker) {
+        broker->SetBinderForTesting("blink.mojom.AIManager", {});
+      },
+      base::Unretained(&broker)));
+}
+
+class TestLanguageDetectionDriver final
+    : public language_detection::mojom::blink::ContentLanguageDetectionDriver {
+ public:
+  void Bind(mojo::ScopedMessagePipeHandle pipe) {
+    receiver_.Bind(
+        mojo::PendingReceiver<
+            language_detection::mojom::blink::ContentLanguageDetectionDriver>(
+            std::move(pipe)));
+  }
+  void GetLanguageDetectionModel(
+      GetLanguageDetectionModelCallback callback) override {
+    std::move(callback).Run(base::File());
+  }
+  void GetLanguageDetectionModelStatus(
+      GetLanguageDetectionModelStatusCallback callback) override {
+    ++status_requests;
+    std::move(callback).Run(language_detection::mojom::blink::
+                                LanguageDetectionModelStatus::kReadily);
+  }
+  int status_requests = 0;
+
+ private:
+  mojo::Receiver<
+      language_detection::mojom::blink::ContentLanguageDetectionDriver>
+      receiver_{this};
+};
+}  // namespace
