+TEST(AvailabilityTest, AndroidDetectionBrokerRouteDoesNotBindModelFactory) {
+  test::TaskEnvironment task_environment;
+  V8TestingScope scope;
+  auto* context = scope.GetExecutionContext();
+  const auto& broker = context->GetBrowserInterfaceBroker();
+  int ai_bindings = 0;
+  auto reset_ai = TrapOptionalModelBinding(broker, &ai_bindings);
+  TestLanguageDetectionDriver driver;
+  ASSERT_TRUE(broker.SetBinderForTesting(
+      language_detection::mojom::blink::ContentLanguageDetectionDriver::Name_,
+      base::BindRepeating(&TestLanguageDetectionDriver::Bind,
+                          base::Unretained(&driver))));
+  base::ScopedClosureRunner reset_driver(base::BindOnce(
+      [](const BrowserInterfaceBrokerProxy* broker) {
+        broker->SetBinderForTesting(language_detection::mojom::blink::
+                                        ContentLanguageDetectionDriver::Name_,
+                                    {});
+      },
+      base::Unretained(&broker)));
+  bool completed = false;
+  AIInterfaceProxy::GetLanguageDetectionModelStatus(
+      context,
+      base::BindOnce(
+          [](bool* done,
+             language_detection::mojom::blink::LanguageDetectionModelStatus
+                 status) {
+            *done = true;
+            EXPECT_EQ(status, language_detection::mojom::blink::
+                                  LanguageDetectionModelStatus::kReadily);
+          },
+          base::Unretained(&completed)));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(completed);
+  EXPECT_EQ(driver.status_requests, 1);
+  EXPECT_EQ(ai_bindings, 0);
