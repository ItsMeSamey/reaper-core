+TEST(AvailabilityTest, AndroidTranslationBrokerRouteDoesNotBindModelFactory) {
+  test::TaskEnvironment task_environment;
+  V8TestingScope scope;
+  auto* context = scope.GetExecutionContext();
+  const auto& broker = context->GetBrowserInterfaceBroker();
+  int ai_bindings = 0;
+  auto reset_ai = TrapOptionalModelBinding(broker, &ai_bindings);
+  int translation_bindings = 0;
+  ASSERT_TRUE(broker.SetBinderForTesting(
+      mojom::blink::TranslationManager::Name_,
+      base::BindRepeating(
+          [](int* calls, mojo::ScopedMessagePipeHandle pipe) { ++*calls; },
+          base::Unretained(&translation_bindings))));
+  base::ScopedClosureRunner reset_translation(base::BindOnce(
+      [](const BrowserInterfaceBrokerProxy* broker) {
+        broker->SetBinderForTesting(mojom::blink::TranslationManager::Name_,
+                                    {});
+      },
+      base::Unretained(&broker)));
+  auto& remote = AIInterfaceProxy::GetTranslationManagerRemote(context);
+  EXPECT_TRUE(remote.is_bound());
+  EXPECT_EQ(&remote, &AIInterfaceProxy::GetTranslationManagerRemote(context));
+  EXPECT_EQ(translation_bindings, 1);
+  EXPECT_EQ(ai_bindings, 0);
+}
