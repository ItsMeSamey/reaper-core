+bool TabCollectionTabModelImpl::CreateSplit(
+    JNIEnv* env,
+    const base::Token& token,
+    const std::vector<TabAndroid*>& tabs,
+    int layout,
+    double ratio) {
+  if (token.is_zero() || tabs.size() != 2 || !tabs[0] || !tabs[1] ||
+      tabs[0] == tabs[1] || layout < 0 || layout > 1 || !std::isfinite(ratio) ||
+      ratio <= 0 || ratio >= 1) {
+    return false;
+  }
+  auto split_id = split_tabs::SplitTabId::FromRawToken(token);
+  if (tab_strip_collection_->GetSplitTabCollection(split_id)) {
+    return false;
+  }
+  int first = GetIndexOfTabRecursive(tabs[0]);
+  int second = GetIndexOfTabRecursive(tabs[1]);
+  if (first < 0 || second != first + 1 || tabs[0]->GetSplit() ||
+      tabs[1]->GetSplit() || tabs[0]->profile() != profile_ ||
+      tabs[1]->profile() != profile_ ||
+      tabs[0]->GetParentCollection() != tabs[1]->GetParentCollection()) {
+    return false;
+  }
+  static_assert(static_cast<int>(split_tabs::SplitTabLayout::kSideBySide) == 0);
+  static_assert(static_cast<int>(split_tabs::SplitTabLayout::kStacked) == 1);
+  tab_strip_collection_->CreateSplit(
+      split_id, {tabs[0], tabs[1]},
+      split_tabs::SplitTabVisualData(
+          static_cast<split_tabs::SplitTabLayout>(layout), ratio));
+  return true;
+}
+
+void TabCollectionTabModelImpl::Unsplit(JNIEnv* env, const base::Token& token) {
+  if (!token.is_zero()) {
+    tab_strip_collection_->Unsplit(split_tabs::SplitTabId::FromRawToken(token));
+  }
+}
+
+void TabCollectionTabModelImpl::UnsplitForInsertion(
+    size_t index,
+    const std::vector<TabInterface*>& excluded_tabs) {
+  std::vector<TabInterface*> remaining;
+  for (TabInterface* tab : *tab_strip_collection_) {
+    if (std::ranges::find(excluded_tabs, tab) == excluded_tabs.end()) {
+      remaining.push_back(tab);
+    }
+  }
+  if (index == 0 || index >= remaining.size()) {
+    return;
+  }
+  auto split = remaining[index - 1]->GetSplit();
+  if (split && split == remaining[index]->GetSplit()) {
+    tab_strip_collection_->Unsplit(*split);
+  }
 }
 
