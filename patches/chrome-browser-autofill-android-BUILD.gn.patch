+# Stage only selected resources; keep excluded or retired files out of the
+# strict resource directory scan without changing validation.
+_autofill_resource_directories = []
+_autofill_resource_sources = []
+_autofill_resource_copy_deps = []
+foreach(_source, _autofill_resource_spec.sources) {
+  _directory = get_path_info(_source, "dir")
+  if (filter_include(_autofill_resource_directories, [ _directory ]) == []) {
