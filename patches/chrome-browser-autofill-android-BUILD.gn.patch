+  }
+  _root = "$target_gen_dir/autofill_resources_selected/" +
+          string_replace(_directory, "/", "_")
+  _qualifier = get_path_info(_directory, "file")
+  _file = get_path_info(_source, "file")
+  _autofill_resource_sources += [ "$_root/$_qualifier/$_file" ]
+}
+foreach(_directory, _autofill_resource_directories) {
+  _qualifier = get_path_info(_directory, "file")
+  _copy_target = "copy_selected_autofill_$_qualifier"
+  copy_ex(_copy_target) {
+    sources = filter_include(_autofill_resource_spec.sources, [ "$_directory/*" ])
+    _root = "$target_gen_dir/autofill_resources_selected/" +
+            string_replace(_directory, "/", "_")
+    dest = "$_root/$_qualifier"
+    outputs = process_file_template(sources, [ "$dest/{{source_file_part}}" ])
+    args = [ "--clear" ]
+  }
+  _autofill_resource_copy_deps += [ ":$_copy_target" ]
+}
