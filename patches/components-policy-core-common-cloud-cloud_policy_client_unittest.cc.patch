+TEST_F(CloudPolicyClientTest, EnterpriseReportsUnavailableWithoutStartingJobs) {
+  EXPECT_CALL(job_creation_handler_, OnJobCreation).Times(0);
+  for (bool registered : {false, true}) {
+    if (registered) {
+      RegisterClient();
+    }
+    const auto previous_status = client_->last_dm_status();
+    base::test::TestFuture<CloudPolicyClient::Result> desktop;
+    client_->UploadChromeDesktopReport(
+        std::make_unique<em::ChromeDesktopReportRequest>(), desktop.GetCallback());
+    ASSERT_TRUE(desktop.IsReady());
+    EXPECT_EQ(desktop.Get(),
+              CloudPolicyClient::Result(DM_STATUS_SERVICE_MANAGEMENT_NOT_SUPPORTED));
+
+    base::test::TestFuture<CloudPolicyClient::Result> profile;
+    client_->UploadChromeProfileReport(
+        false, std::make_unique<em::ChromeProfileReportRequest>(),
+        profile.GetCallback());
+    ASSERT_TRUE(profile.IsReady());
+    EXPECT_EQ(profile.Get(),
+              CloudPolicyClient::Result(DM_STATUS_SERVICE_MANAGEMENT_NOT_SUPPORTED));
+
+    base::test::TestFuture<CloudPolicyClient::Result> os_user;
+    client_->UploadChromeOsUserReport(
+        std::make_unique<em::ChromeOsUserReportRequest>(), os_user.GetCallback());
+    ASSERT_TRUE(os_user.IsReady());
+    EXPECT_EQ(os_user.Get(),
+              CloudPolicyClient::Result(DM_STATUS_SERVICE_MANAGEMENT_NOT_SUPPORTED));
+    task_environment_->RunUntilIdle();
+    EXPECT_EQ(client_->GetActiveRequestCountForTest(), 0);
+    EXPECT_EQ(client_->last_dm_status(), previous_status);
+  }
+}
+
+TEST_F(CloudPolicyClientTest, ReportChallengeUnavailableWithoutStartingJobs) {
+  EXPECT_CALL(job_creation_handler_, OnJobCreation).Times(0);
+  for (bool registered : {false, true}) {
+    if (registered) {
+      RegisterClient();
+    }
+    const auto previous_status = client_->last_dm_status();
+    base::test::TestFuture<DeviceManagementStatus,
+                           const em::GenerateChromeProfileChallengeResponse&>
+        result;
+    client_->GenerateChromeProfileChallenge(result.GetCallback());
+    ASSERT_TRUE(result.IsReady());
+    const auto [status, response] = result.Get();
+    EXPECT_EQ(status, DM_STATUS_SERVICE_MANAGEMENT_NOT_SUPPORTED);
+    EXPECT_FALSE(response.has_challenge());
+    task_environment_->RunUntilIdle();
+    EXPECT_EQ(client_->GetActiveRequestCountForTest(), 0);
+    EXPECT_EQ(client_->last_dm_status(), previous_status);
+  }
+}
