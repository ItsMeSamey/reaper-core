+#if BUILDFLAG(IS_ANDROID)
+IN_PROC_BROWSER_TEST_F(ScriptingAPITest,
+                       UpdatedScriptsKeepOmittedPersistence) {
+  TestExtensionDir test_dir;
+  test_dir.WriteManifest(R"({
+    "name": "Persistence update", "manifest_version": 3, "version": "1",
+    "permissions": ["scripting"],
+    "host_permissions": ["http://example.com/*"]
+  })");
+  test_dir.WriteFile(FILE_PATH_LITERAL("script.js"), "void 0;");
+  scoped_refptr<const Extension> extension =
+      LoadExtension(test_dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+  auto run = [&](scoped_refptr<ExtensionFunction> function,
+                 const std::string& args) {
+    function->set_extension(extension.get());
+    return api_test_utils::RunFunction(function, args, profile());
+  };
+  auto get_scripts = [&]() {
+    auto function =
+        base::MakeRefCounted<ScriptingGetRegisteredContentScriptsFunction>();
+    function->set_extension(extension.get());
+    return api_test_utils::RunFunctionAndReturnSingleResult(function, "[]",
+                                                          profile());
+  };
+  ASSERT_TRUE(run(
+      base::MakeRefCounted<ScriptingRegisterContentScriptsFunction>(),
+      R"([[{"id":"keep", "matches":["http://example.com/*"],
+            "js":["script.js"]},
+           {"id":"session", "matches":["http://example.com/*"],
+            "js":["script.js"], "persistAcrossSessions":false},
+           {"id":"to_session", "matches":["http://example.com/*"],
+            "js":["script.js"]},
+           {"id":"to_persist", "matches":["http://example.com/*"],
+            "js":["script.js"], "persistAcrossSessions":false}]])"));
+  ASSERT_TRUE(run(
+      base::MakeRefCounted<ScriptingUpdateContentScriptsFunction>(),
+      R"([[{"id":"keep", "runAt":"document_end"},
+           {"id":"session", "runAt":"document_end"},
+           {"id":"to_session", "persistAcrossSessions":false},
+           {"id":"to_persist", "persistAcrossSessions":true}]])"));
+  auto scripts = get_scripts();
+  ASSERT_TRUE(scripts && scripts->is_list());
+  ASSERT_EQ(4u, scripts->GetList().size());
+  for (const auto& script : scripts->GetList()) {
+    const auto& dict = script.GetDict();
+    const std::string* id = dict.FindString("id");
+    ASSERT_TRUE(id);
+    const bool expected = *id == "keep" || *id == "to_persist";
+    EXPECT_EQ(std::optional<bool>(expected),
+              dict.FindBool("persistAcrossSessions"));
+  }
+
+  // Read the real StateStore after the update's queued writes. Metadata alone
+  // would not prove which registrations will be available to the next loader.
+  base::test::TestFuture<std::optional<base::Value>> stored;
+  ExtensionSystem::Get(profile())
+      ->dynamic_user_scripts_store()
+      ->GetExtensionValue(extension->id(), scripting::kRegisteredScriptsStorageKey,
+                          stored.GetCallback());
+  const auto& value = stored.Get();
+  ASSERT_TRUE(value && value->is_list());
+  std::set<std::string> stored_ids;
+  for (const auto& script : value->GetList()) {
+    const std::string* id = script.GetDict().FindString("id");
+    ASSERT_TRUE(id);
+    stored_ids.insert(UserScript::TrimPrefixFromScriptID(*id));
+  }
+  ASSERT_EQ((std::set<std::string>{"keep", "to_persist"}), stored_ids);
+
+  // Reconstruct the loader from its stored registrations, without rerunning a
+  // worker that could register them again. This is not a process-restart test.
+  DisableExtension(extension->id());
+  extension_registrar()->EnableExtension(extension->id());
+  ContentScriptLoadWaiter waiter(
+      ExtensionSystem::Get(profile())
+          ->user_script_manager()
+          ->GetUserScriptLoaderForExtension(extension->id()));
+  waiter.Wait();
+  scripts = get_scripts();
+  ASSERT_TRUE(scripts && scripts->is_list());
+  std::set<std::string> restored_ids;
+  for (const auto& script : scripts->GetList()) {
+    const auto& dict = script.GetDict();
+    const std::string* id = dict.FindString("id");
+    ASSERT_TRUE(id);
+    restored_ids.insert(*id);
+    EXPECT_EQ(std::optional<bool>(true), dict.FindBool("persistAcrossSessions"));
+  }
+  EXPECT_EQ(stored_ids, restored_ids);
+}
