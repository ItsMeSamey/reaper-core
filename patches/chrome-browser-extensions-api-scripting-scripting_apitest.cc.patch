+IN_PROC_BROWSER_TEST_F(ScriptingAPITest, UpdatedScriptChangesExecutionWorld) {
+  TestExtensionDir test_dir;
+  test_dir.WriteManifest(R"({
+    "name": "World update", "manifest_version": 3, "version": "1",
+    "permissions": ["scripting"],
+    "host_permissions": ["http://example.com/*"]
+  })");
+  test_dir.WriteFile(FILE_PATH_LITERAL("script.js"), R"(
+    window.reaperUpdatedScriptWorld = 'injected';
+    const markExecution = () => {
+      document.documentElement.setAttribute('data-reaper-script-executed', 'yes');
+    };
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', markExecution, {once: true});
+    } else {
+      markExecution();
+    }
+  )");
+  const Extension* extension = LoadExtension(test_dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+  auto run = [&](scoped_refptr<ExtensionFunction> function,
+                 const std::string& args) {
+    function->set_extension(extension);
+    return api_test_utils::RunFunction(function, args, profile());
+  };
+  auto expect_world = [&](const char* world, int navigation) {
+    auto function =
+        base::MakeRefCounted<ScriptingGetRegisteredContentScriptsFunction>();
+    function->set_extension(extension);
+    auto scripts = api_test_utils::RunFunctionAndReturnSingleResult(
+        function, "[]", profile());
+    ASSERT_TRUE(scripts && scripts->is_list());
+    ASSERT_EQ(1u, scripts->GetList().size());
+    const auto& dict = scripts->GetList()[0].GetDict();
+    const std::string* actual_world = dict.FindString("world");
+    ASSERT_TRUE(actual_world);
+    EXPECT_EQ(world, *actual_world);
+    OpenURLInCurrentTab(embedded_test_server()->GetURL(
+        "example.com", base::StringPrintf("/simple.html?world=%d", navigation)));
+    // A shared DOM marker proves the script ran in either world; absence of a
+    // page global alone could also mean no injection happened.
+    EXPECT_EQ("yes", content::EvalJs(
+                         GetActiveWebContents(),
+                         "document.documentElement.getAttribute("
+                         "'data-reaper-script-executed')"));
+    // EvalJs runs in the page's main world, so isolated-world writes must not
+    // appear here. Navigation gives each assertion a fresh document.
+    EXPECT_EQ(std::string(world) == "MAIN" ? "string" : "undefined",
+              content::EvalJs(GetActiveWebContents(),
+                              "typeof window.reaperUpdatedScriptWorld"));
+  };
+  ASSERT_TRUE(run(
+      base::MakeRefCounted<ScriptingRegisterContentScriptsFunction>(),
+      R"([[{"id":"world", "matches":["http://example.com/*"],
+            "js":["script.js"], "runAt":"document_end"}]])"));
+  expect_world("ISOLATED", 1);
+  ASSERT_TRUE(run(base::MakeRefCounted<ScriptingUpdateContentScriptsFunction>(),
+                  R"([[{"id":"world", "world":"MAIN"}]])"));
+  expect_world("MAIN", 2);
+  ASSERT_TRUE(run(base::MakeRefCounted<ScriptingUpdateContentScriptsFunction>(),
+                  R"([[{"id":"world", "runAt":"document_start"}]])"));
+  expect_world("MAIN", 3);
+  ASSERT_TRUE(run(base::MakeRefCounted<ScriptingUpdateContentScriptsFunction>(),
+                  R"([[{"id":"world", "world":"ISOLATED"}]])"));
+  expect_world("ISOLATED", 4);
+}
+#endif  // BUILDFLAG(IS_ANDROID)
 
