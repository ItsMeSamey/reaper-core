-            resource_manager_->GetStaticResourceWithTint(
-                keyboard_focus_ring_resource_id, keyboard_focus_ring_color,
-                true));
-    focus_ring_layer->SetIsDrawable(true);
-    focus_ring_layer->SetUIResourceId(
