-      text_layer->SetHideLayerAndSubtree(false);
-      text_layer->SetOpacity(SkColorGetA(tint) * (1.0f / 255.f));
-    } else {
-      text_layer->SetHideLayerAndSubtree(true);
-    }
-  }
-
-  // 4. Focus Ring
-  if (is_keyboard_focused && visible) {
