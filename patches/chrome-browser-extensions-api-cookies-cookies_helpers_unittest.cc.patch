+#if BUILDFLAG(IS_ANDROID)
+TEST(CookiesHelperUnittest, MatchFilterExcludesUnrepresentablePartitionKeys) {
+  api::cookies::GetAll::Params::Details details;
+  cookies_helpers::MatchFilter filter(&details);
+  filter.SetCookiePartitionKeyCollection(
+      net::CookiePartitionKeyCollection::ContainsAll());
+
+  const auto make_cookie = [](std::optional<net::CookiePartitionKey> key) {
+    return net::CanonicalCookie::CreateUnsafeCookieForTesting(
+        "cookiename", "cookievalue", "example.com", "/", base::Time::Now(),
+        base::Time(), base::Time(), base::Time(), true, false,
+        net::CookieSameSite::NO_RESTRICTION, net::COOKIE_PRIORITY_DEFAULT,
+        net::CookieSourceType::kOther, key);
+  };
+  auto unpartitioned = make_cookie(std::nullopt);
+  auto serializable = make_cookie(net::CookiePartitionKey::FromURLForTesting(
+      GURL("https://example.com")));
+  auto transient = make_cookie(net::CookiePartitionKey::FromURLForTesting(
+      GURL("https://example.com"),
+      net::CookiePartitionKey::AncestorChainBit::kCrossSite,
+      base::UnguessableToken::Create()));
+  auto opaque = make_cookie(net::CookiePartitionKey::FromURLForTesting(
+      GURL("data:text/plain,opaque")));
+  ASSERT_TRUE(unpartitioned);
+  ASSERT_TRUE(serializable);
+  ASSERT_TRUE(transient);
+  ASSERT_TRUE(opaque);
+
+  // Test the filter only; do not serialize an unrepresentable partition key.
+  EXPECT_TRUE(filter.MatchesCookie(*unpartitioned));
+  EXPECT_TRUE(filter.MatchesCookie(*serializable));
+  EXPECT_FALSE(filter.MatchesCookie(*transient));
+  EXPECT_FALSE(filter.MatchesCookie(*opaque));
+  details.name = "different-name";
+  EXPECT_FALSE(filter.MatchesCookie(*unpartitioned));
+  EXPECT_FALSE(filter.MatchesCookie(*serializable));
+}
+#endif
+
 }  // namespace extensions
