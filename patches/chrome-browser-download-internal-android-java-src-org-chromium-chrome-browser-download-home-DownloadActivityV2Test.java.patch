+    private View findAttachedRevealRow(OfflineItem item) {
+        RecyclerView list = (RecyclerView) mDownloadCoordinator.getListViewForTesting();
+        for (int i = 0; i < list.getChildCount(); i++) {
+            View row = list.getChildAt(i);
+            ArrayList<View> matches = new ArrayList<>();
+            row.findViewsWithText(matches, item.title, View.FIND_VIEWS_WITH_TEXT);
+            for (View match : matches) {
+                if (match instanceof TextView
+                        && item.title.contentEquals(((TextView) match).getText())
+                        && isDisplayed().matches(match)) {
+                    Rect visible = new Rect();
+                    Rect viewport = new Rect();
+                    if (match.getGlobalVisibleRect(visible)
+                            && list.getGlobalVisibleRect(viewport)
+                            && Rect.intersects(visible, viewport)) {
+                        return row;
+                    }
+                }
+            }
+        }
+        return null;
+    }
+
