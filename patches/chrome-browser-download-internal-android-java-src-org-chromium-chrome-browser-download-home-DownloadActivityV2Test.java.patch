+    /** Holds the actual initial source callback instead of faking a populated list model. */
+    private static class DelayedOfflineContentProvider extends StubbedOfflineContentProvider {
+        private Callback<ArrayList<OfflineItem>> mPendingItems;
+
+        @Override
+        public void getAllItems(Callback<ArrayList<OfflineItem>> callback) {
+            Assert.assertNull(mPendingItems);
+            mPendingItems = callback;
+        }
+
+        void releaseItems(List<OfflineItem> items) {
+            Assert.assertNotNull(mPendingItems);
+            Callback<ArrayList<OfflineItem>> callback = mPendingItems;
+            mPendingItems = null;
+            getItems().clear();
+            getItems().addAll(items);
+            callback.onResult(new ArrayList<>(items));
+        }
+    }
+
