+    private static ArrayList<OfflineItem> createRevealItems(int count) {
+        ArrayList<OfflineItem> items = new ArrayList<>();
+        for (int i = 0; i < count; i++) {
+            // Distinct days force DateListPaginator to stop at multiple page boundaries.
+            OfflineItem item =
+                    StubbedProvider.createOfflineItem(
+                            "reveal-guid-" + i,
+                            JUnitTestGURLs.URL_1,
+                            OfflineItemState.COMPLETE,
+                            1024,
+                            "reveal item " + i,
+                            "/data/fake_path/Downloads/reveal-" + i,
+                            1_700_000_000_000L - i * 86_400_000L,
+                            1024,
+                            OfflineItemFilter.OTHER);
+            item.id = new ContentId("download", "reveal-guid-" + i);
+            items.add(item);
+        }
+        return items;
+    }
+
+    private void setRevealItems(List<OfflineItem> items) {
+        mStubbedOfflineContentProvider.getItems().clear();
