+
+    private static final String EXTENSION_ORIGIN =
+            "chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+
+    private android.app.NotificationManager extensionNotificationManager() {
+        android.app.NotificationManager manager =
+                org.chromium.base.ContextUtils.getApplicationContext()
+                        .getSystemService(android.app.NotificationManager.class);
+        org.robolectric.Shadows.shadowOf(manager).setNotificationsEnabled(true);
+        return manager;
+    }
+
+    @Test
+    @org.robolectric.annotation.Config(sdk = android.os.Build.VERSION_CODES.Q)
+    public void testExtensionStatusReadsCurrentAppPolicyInsteadOfCachedResult() {
+        android.app.NotificationManager manager = extensionNotificationManager();
+        NotificationProxyUtils.setNotificationEnabledForTest(true);
+        org.robolectric.Shadows.shadowOf(manager).setNotificationsEnabled(false);
+        assertThat(
+                NotificationSystemStatusUtil.getExtensionNotificationStatusSync(EXTENSION_ORIGIN),
+                is(NotificationSystemStatusUtil.APP_NOTIFICATIONS_STATUS_DISABLED));
+
+        NotificationProxyUtils.setNotificationEnabledForTest(false);
+        org.robolectric.Shadows.shadowOf(manager).setNotificationsEnabled(true);
+        assertThat(
+                NotificationSystemStatusUtil.getExtensionNotificationStatusSync(EXTENSION_ORIGIN),
+                is(NotificationSystemStatusUtil.APP_NOTIFICATIONS_STATUS_ENABLED));
+    }
+
+    @Test
+    @org.robolectric.annotation.Config(sdk = android.os.Build.VERSION_CODES.Q)
+    public void testExtensionStatusDoesNotCreateChannelsOrGroups() {
+        android.app.NotificationManager manager = extensionNotificationManager();
+        int channelCount = manager.getNotificationChannels().size();
+        int groupCount = manager.getNotificationChannelGroups().size();
+        assertThat(
+                NotificationSystemStatusUtil.getExtensionNotificationStatusSync(EXTENSION_ORIGIN),
+                is(NotificationSystemStatusUtil.APP_NOTIFICATIONS_STATUS_ENABLED));
+        assertThat(manager.getNotificationChannels().size(), is(channelCount));
+        assertThat(manager.getNotificationChannelGroups().size(), is(groupCount));
+    }
+
+    @Test
+    @org.robolectric.annotation.Config(sdk = android.os.Build.VERSION_CODES.Q)
+    public void testExtensionStatusUsesOwnOriginChannelAndPreservesIt() {
+        android.app.NotificationManager manager = extensionNotificationManager();
+        // An unrelated disabled site's channel cannot disable this extension.
+        manager.createNotificationChannel(
+                new android.app.NotificationChannel(
+                        "web:https://unrelated.example;1",
+                        "Unrelated",
+                        android.app.NotificationManager.IMPORTANCE_NONE));
+        assertThat(
+                NotificationSystemStatusUtil.getExtensionNotificationStatusSync(EXTENSION_ORIGIN),
+                is(NotificationSystemStatusUtil.APP_NOTIFICATIONS_STATUS_ENABLED));
+        String channelId = "web:" + EXTENSION_ORIGIN + ";2";
+        manager.createNotificationChannel(
+                new android.app.NotificationChannel(
+                        channelId, "Extension", android.app.NotificationManager.IMPORTANCE_NONE));
+        int channelCount = manager.getNotificationChannels().size();
+        assertThat(
+                NotificationSystemStatusUtil.getExtensionNotificationStatusSync(EXTENSION_ORIGIN),
+                is(NotificationSystemStatusUtil.APP_NOTIFICATIONS_STATUS_DISABLED));
+        assertThat(manager.getNotificationChannels().size(), is(channelCount));
+        assertThat(
+                manager.getNotificationChannel(channelId).getImportance(),
+                is(android.app.NotificationManager.IMPORTANCE_NONE));
+    }
+
+    @Test
+    @org.robolectric.annotation.Config(sdk = android.os.Build.VERSION_CODES.Q)
+    public void testExtensionStatusRespectsFallbackSitesChannel() {
+        android.app.NotificationManager manager = extensionNotificationManager();
+        String fallback =
+                org.chromium.chrome.browser.notifications.channels.ChromeChannelDefinitions
+                        .ChannelId.SITES;
+        manager.createNotificationChannel(
+                new android.app.NotificationChannel(
+                        fallback, "Sites", android.app.NotificationManager.IMPORTANCE_NONE));
+        assertThat(
+                NotificationSystemStatusUtil.getExtensionNotificationStatusSync(EXTENSION_ORIGIN),
+                is(NotificationSystemStatusUtil.APP_NOTIFICATIONS_STATUS_DISABLED));
+        manager.createNotificationChannel(
+                new android.app.NotificationChannel(
+                        "web:" + EXTENSION_ORIGIN + ";3",
+                        "Extension",
+                        android.app.NotificationManager.IMPORTANCE_DEFAULT));
+        assertThat(
+                NotificationSystemStatusUtil.getExtensionNotificationStatusSync(EXTENSION_ORIGIN),
+                is(NotificationSystemStatusUtil.APP_NOTIFICATIONS_STATUS_ENABLED));
+    }
+
+    @Test
+    @org.robolectric.annotation.Config(sdk = android.os.Build.VERSION_CODES.Q)
+    public void testExtensionStatusRespectsBlockedGroupWithoutCreatingFallback() {
+        android.app.NotificationManager manager = extensionNotificationManager();
+        String groupId =
+                org.chromium.chrome.browser.notifications.channels.ChromeChannelDefinitions
+                        .ChannelGroupId.GENERAL;
+        android.app.NotificationChannelGroup group =
+                new android.app.NotificationChannelGroup(groupId, "General");
+        // Android's user-controlled blocked field has no application setter. Only
+        // the test uses reflection to model an OS-settings change.
+        org.robolectric.util.ReflectionHelpers.callInstanceMethod(
+                group,
+                "setBlocked",
+                org.robolectric.util.ReflectionHelpers.ClassParameter.from(boolean.class, true));
+        manager.createNotificationChannelGroup(group);
+        int channelCount = manager.getNotificationChannels().size();
+        assertThat(
+                NotificationSystemStatusUtil.getExtensionNotificationStatusSync(EXTENSION_ORIGIN),
+                is(NotificationSystemStatusUtil.APP_NOTIFICATIONS_STATUS_DISABLED));
+        assertThat(manager.getNotificationChannels().size(), is(channelCount));
+    }
 }
