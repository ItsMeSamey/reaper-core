+    private static SharedMemory memoryWithUtf8(String message) throws Exception {
+        byte[] bytes = message.getBytes(StandardCharsets.UTF_8);
+        SharedMemory memory = SharedMemory.create("native-message-test", bytes.length);
+        ByteBuffer mapped = memory.mapReadWrite();
+        try {
+            mapped.put(bytes);
+        } finally {
+            SharedMemory.unmap(mapped);
+        }
+        return memory;
+    }
+
+    @Test
+    public void testLargeOutboundUsesSharedMemoryWithExactUtf8Body() throws Exception {
+        NativeMessageAndroidPort port = new NativeMessageAndroidPort();
+        String body = "\"" + "x".repeat(70_000) + "\ud83d\ude00" + "\"";
+        List<String> received = new ArrayList<>();
+        IExtensionNativeMessagePort remote = new IExtensionNativeMessagePort.Stub() {
+            @Override
+            public void postMessage(MessagePayload payload, Bundle extras) {
+                Assert.assertEquals(MessagePayload.sharedMemory, payload.getTag());
+                SharedMemory memory = payload.getSharedMemory();
+                try {
+                    Assert.assertEquals(body.getBytes(StandardCharsets.UTF_8).length, memory.getSize());
+                    ByteBuffer mapped = memory.mapReadOnly();
+                    try {
+                        byte[] bytes = new byte[mapped.remaining()];
+                        mapped.get(bytes);
+                        received.add(new String(bytes, StandardCharsets.UTF_8));
+                    } finally {
+                        SharedMemory.unmap(mapped);
+                    }
+                } catch (Exception e) {
+                    throw new AssertionError(e);
+                } finally {
+                    memory.close();
+                }
+            }
+            @Override
+            public void disconnect() {}
+        };
+        port.onConnected(remote);
+        port.forwardMessageToApp(body);
+        Assert.assertEquals(List.of(body), received);
+    }
