+    /**
+     * Records real close/protection requests missing from the host SharedMemory shadow.
+     * Backing-file bytes and Parcel ownership still use Robolectric; this is not kernel proof.
+     */
+    @Implements(SharedMemory.class)
+    public static class RecordingSharedMemory extends ShadowSharedMemory {
+        private static final int ALL_PROTECTIONS =
+                OsConstants.PROT_READ | OsConstants.PROT_WRITE | OsConstants.PROT_EXEC;
+
+        @RealObject private SharedMemory mSharedMemory;
+        private boolean mClosed;
+        private int mProtection = ALL_PROTECTIONS;
+
+        @Implementation
+        protected boolean setProtect(int prot) {
+            if (mClosed) throw new IllegalStateException("SharedMemory is closed");
+            if ((prot & ~ALL_PROTECTIONS) != 0) {
+                throw new IllegalArgumentException("Invalid protection flags");
+            }
+            if ((prot & ~mProtection) != 0) return false;
+            boolean accepted =
+                    Shadow.directlyOn(
+                            mSharedMemory,
+                            SharedMemory.class,
+                            "setProtect",
+                            ClassParameter.from(int.class, prot));
+            if (accepted) mProtection = prot;
+            return accepted;
+        }
+
+        @Implementation
+        protected void close() {
+            if (mClosed) return;
+            Shadow.directlyOn(mSharedMemory, SharedMemory.class, "close");
+            mClosed = true;
+        }
+
+        @Override
+        @Implementation
+        protected ByteBuffer map(int prot, int offset, int length) throws ErrnoException {
+            if (mClosed) throw new IllegalStateException("SharedMemory is closed");
+            if ((prot & ~mProtection) != 0) {
+                throw new ErrnoException("mmap", OsConstants.EACCES);
+            }
+            return super.map(prot, offset, length);
+        }
+    }
 
