+    @Test
+    public void testBrowserEncoderExactlyMaximumSharedMemoryBodyAndOversizedControl()
+            throws Exception {
+        String body = "\"" + "x".repeat(NativeMessagePayloadCodec.MAX_TO_HOST_BYTES - 2) + "\"";
+        try (NativeMessagePayloadCodec.Encoded encoded =
+                NativeMessagePayloadCodec.encodeToHost(body)) {
+            Assert.assertEquals(MessagePayload.sharedMemory, encoded.payload.getTag());
+            Assert.assertEquals(NativeMessagePayloadCodec.MAX_TO_HOST_BYTES, encoded.byteLength);
+            SharedMemory memory = encoded.payload.getSharedMemory();
+            Assert.assertEquals(NativeMessagePayloadCodec.MAX_TO_HOST_BYTES, memory.getSize());
+            // The codec requested read-only protection; the host shadow models that restriction.
+            Assert.assertThrows(ErrnoException.class, memory::mapReadWrite);
+        }
+        Assert.assertThrows(IOException.class,
+                () -> NativeMessagePayloadCodec.encodeToHost(body + " "));
+    }
