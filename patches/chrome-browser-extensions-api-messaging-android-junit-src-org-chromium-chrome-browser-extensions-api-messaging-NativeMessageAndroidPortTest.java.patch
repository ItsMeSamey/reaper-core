+    @Test
+    public void testRejectedLocalFrameIsConsumedAndClosesChannel() throws Exception {
+        String body = "\"" + "x".repeat(70_000) + "\"";
+        MessagePayload[] rejected = new MessagePayload[1];
+        IExtensionNativeMessagePort local = new IExtensionNativeMessagePort.Stub() {
+            @Override
+            public void postMessage(MessagePayload payload, Bundle extras) {
+                rejected[0] = payload;
+                try {
+                    throw new SecurityException("Local SDK authorization/session rejected");
+                } finally {
+                    // This models the SDK's fresh-owned-frame rejection contract.
+                    disposeOwnedPayload(payload);
+                }
+            }
+            @Override
+            public void disconnect() {
+                throw new SecurityException("The same local SDK grant is still rejected");
+            }
+        };
+        NativeMessageAndroidPort port = new NativeMessageAndroidPort();
+        TestPortObserver observer = new TestPortObserver() {
+            @Override
+            public void onChannelClosed(String errorMessage) {
+                super.onChannelClosed(errorMessage);
+                // Model the native channel teardown, which invokes Java destroy().
+                port.destroy();
+            }
+        };
+        port.setObserver(observer);
+        port.setTestObserver(observer);
+        port.onConnected(local);
+        try {
+            port.forwardMessageToApp(body);
+            Assert.assertNotNull(observer.closedError);
+            Assert.assertTrue(observer.isPortDestroyed);
+            Assert.assertNotNull(rejected[0]);
+            Assert.assertThrows(
+                    IllegalStateException.class, rejected[0].getSharedMemory()::mapReadOnly);
+        } finally {
+            disposeOwnedPayload(rejected[0]);
+        }
+    }
