+
+bool AndroidLiveTabContext::RestoreSplitByTabIds(
+    const std::vector<int>& tab_ids,
+    split_tabs::SplitTabId split_id,
+    const split_tabs::SplitTabVisualData& visual_data) {
+  const auto& models = TabModelList::models();
+  if (std::ranges::find(models, tab_model_) == models.end()) {
+    return false;
+  }
+  JNIEnv* env = base::android::AttachCurrentThread();
+  auto model = tab_model_->GetJavaObject();
+  if (!model)
+    return false;
+  return TabModelJniBridge::RestoreSplit(
+      env, model, split_id.token(), tab_ids,
+      static_cast<int>(visual_data.split_layout()), visual_data.split_ratio());
