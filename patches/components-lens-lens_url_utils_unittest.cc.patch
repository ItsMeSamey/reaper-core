+#if BUILDFLAG(IS_ANDROID)
+TEST(LensUrlUtilsTest, AndroidQueryHelpersPreserveInputs) {
+  const GURL original_url(
+      "https://example.test/search?q=flowers&source=ordinary#section");
+  EXPECT_EQ(original_url,
+            lens::AppendInvocationSourceParamToURL(
+                original_url, lens::LensOverlayInvocationSource::kAppMenu,
+                /*is_contextual_tasks=*/false));
+  EXPECT_EQ(original_url,
+            lens::AppendInvocationSourceParamToURL(
+                original_url, lens::LensOverlayInvocationSource::kAppMenu,
+                /*is_contextual_tasks=*/true));
+
+  std::string query_string = "q=flowers&lm=existing&x=1";
+  const std::string original_query = query_string;
+  std::vector<lens::mojom::LatencyLogPtr> log_data;
+  log_data.push_back(lens::mojom::LatencyLog::New());
+  lens::AppendLogsQueryParam(&query_string, log_data);
+  EXPECT_EQ(original_query, query_string);
+}
