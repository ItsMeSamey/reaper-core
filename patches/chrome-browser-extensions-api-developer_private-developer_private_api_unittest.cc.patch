+TEST_F(DeveloperPrivateApiUnitTest, InstallFromFileWaitsForSignedInstall) {
+  ExtensionFunction::ScopedUserGestureForTests gesture;
+  profile()->GetPrefs()->SetBoolean(prefs::kExtensionsUIDeveloperMode, true);
+  TestExtensionDir test_dir;
+  test_dir.WriteManifest(
+      R"({"name":"Local picker test","version":"1.0","manifest_version":3})");
+  const base::FilePath crx = test_dir.Pack();
+  auto disable_ui = ExtensionInstallUI::disable_ui_for_tests(true);
+  ScopedTestDialogAutoConfirm confirm(ScopedTestDialogAutoConfirm::ACCEPT);
+  auto contents =
+      content::WebContentsTester::CreateTestWebContents(profile(), nullptr);
+  auto function =
+      base::MakeRefCounted<api::DeveloperPrivateInstallFromFileFunction>();
+  function->SetRenderFrameHost(contents->GetPrimaryMainFrame());
+  function->set_accept_dialog_for_testing(true);
+  function->set_selected_file_for_testing(ui::SelectedFileInfo(crx));
+  ASSERT_TRUE(api_test_utils::RunFunction(function.get(), "[]", profile()));
+  ASSERT_EQ(1u, function->GetResultListForTest()->size());
+  EXPECT_TRUE((*function->GetResultListForTest())[0].GetBool());
+  bool installed = false;
+  for (const auto& extension : registry()->enabled_extensions()) {
+    installed |= extension->name() == "Local picker test";
+  }
+  EXPECT_TRUE(installed);
+  EXPECT_TRUE(base::PathExists(crx));
+
+  // Same-key updates keep the normal install-then-reenable lifecycle. API
+  // success must not retire a still-valid prompt for the original document.
+  test_dir.WriteManifest(
+      R"({"name":"Local picker test","version":"2.0","manifest_version":3,
+          "permissions":["tabs"]})");
+  const base::FilePath update_crx = test_dir.Pack("update.crx");
+  auto update = base::MakeRefCounted<api::DeveloperPrivateInstallFromFileFunction>();
+  update->SetRenderFrameHost(contents->GetPrimaryMainFrame());
+  update->set_accept_dialog_for_testing(true);
+  update->set_selected_file_for_testing(ui::SelectedFileInfo(update_crx));
+  ASSERT_TRUE(api_test_utils::RunFunction(update.get(), "[]", profile()));
+  ASSERT_EQ(1u, update->GetResultListForTest()->size());
+  EXPECT_TRUE((*update->GetResultListForTest())[0].GetBool());
+  task_environment()->RunUntilIdle();
+  bool updated_and_enabled = false;
+  for (const auto& extension : registry()->enabled_extensions()) {
+    if (extension->name() == "Local picker test") {
+      EXPECT_EQ("2.0", extension->version().GetString());
+      updated_and_enabled = extension->version().GetString() == "2.0";
+    }
+  }
+  EXPECT_TRUE(updated_and_enabled);
+  EXPECT_TRUE(base::PathExists(update_crx));
+}
