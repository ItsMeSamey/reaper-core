+TEST_F(DeveloperPrivateApiUnitTest, LoadUnpackedAndroidLocalAndSafRetryPaths) {
+  class InstallLifecycleObserver : public ExtensionRegistryObserver {
+   public:
+    explicit InstallLifecycleObserver(ExtensionRegistry* registry) {
+      observation_.Observe(registry);
+    }
+    void OnExtensionInstalled(content::BrowserContext*, const Extension*,
+                              bool) override {
+      ++installed_count_;
+    }
+    void OnExtensionLoaded(content::BrowserContext*, const Extension*) override {
+      ++loaded_count_;
+    }
+    void OnExtensionUnloaded(content::BrowserContext*, const Extension*,
+                             UnloadedExtensionReason) override {
+      ++unloaded_count_;
+    }
+    int installed_count() const { return installed_count_; }
+    int loaded_count() const { return loaded_count_; }
+    int unloaded_count() const { return unloaded_count_; }
+
+   private:
+    int installed_count_ = 0;
+    int loaded_count_ = 0;
+    int unloaded_count_ = 0;
+    base::ScopedObservation<ExtensionRegistry, ExtensionRegistryObserver>
+        observation_{this};
+  };
+
+  // Drive the actual listener boundary after the original sender is destroyed.
+  // The subclass changes only picker timing, not StartFileLoad or its result.
+  class DelayedSelection : public api::DeveloperPrivateLoadUnpackedFunction {
+   public:
+    DelayedSelection(base::OnceClosure close_source, base::FilePath path)
+        : close_source_(std::move(close_source)), path_(std::move(path)) {}
+
+   private:
+    ~DelayedSelection() override = default;
+    ResponseAction Run() override {
+      AddRef();  // The selection is pending; Finish() releases this reference.
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&DelayedSelection::CompleteSelection, this));
+      return RespondLater();
+    }
+    void CompleteSelection() {
+      std::move(close_source_).Run();
+      FileSelected(ui::SelectedFileInfo(path_), 0);
+    }
+    base::OnceClosure close_source_;
+    base::FilePath path_;
+  };
+
+  std::unique_ptr<content::WebContents> web_contents(
+      content::WebContentsTester::CreateTestWebContents(profile(), nullptr));
+  DeveloperPrivateAPI* api = DeveloperPrivateAPI::Get(profile());
+
+  for (int path_form = 0; path_form < 2; ++path_form) {
+    SCOPED_TRACE(path_form);
+    TestExtensionDir dir;
+    dir.WriteManifest(
+        R"({
+             "name": "Android path forms",
+             "version": 1,
+             "manifest_version": 3
+           })");
+    const base::FilePath native_path =
+        base::MakeAbsoluteFilePath(dir.UnpackedPath());
+    ASSERT_FALSE(native_path.empty());
+    ASSERT_TRUE(native_path.IsAbsolute());
+    ASSERT_FALSE(native_path.IsContentUri());
+
+    base::FilePath selected_path = native_path;
+    base::FilePath registered_path = native_path;
+    if (path_form == 1) {
+      auto tree_uri =
+          base::test::android::GetInMemoryContentTreeUriFromCacheDirDirectory(
+              native_path);
+      ASSERT_TRUE(tree_uri);
+      selected_path = *tree_uri;
+      ASSERT_TRUE(selected_path.IsContentUri());
+      auto virtual_path = base::ResolveToVirtualDocumentPath(selected_path);
+      ASSERT_TRUE(virtual_path);
+      registered_path = *virtual_path;
+    }
+
+    const ExtensionIdSet current_ids =
+        registry()->enabled_extensions().GetIDs();
+    auto function =
+        base::MakeRefCounted<api::DeveloperPrivateLoadUnpackedFunction>();
+    function->set_accept_dialog_for_testing(true);
+    function->set_selected_file_for_testing(ui::SelectedFileInfo(selected_path));
+    function->SetRenderFrameHost(web_contents->GetPrimaryMainFrame());
+    std::optional<base::Value> result =
+        api_test_utils::RunFunctionAndReturnSingleResult(
+            function.get(),
+            "[{\"failQuietly\": true, \"populateError\": true}]", profile());
+    ASSERT_TRUE(result);
+    auto error = api::developer_private::LoadError::FromValue(*result);
+    ASSERT_TRUE(error);
+    EXPECT_NE(std::string::npos, error->error.find("version"));
+    const std::string retry_guid = error->retry_guid;
+    ASSERT_FALSE(retry_guid.empty());
+    EXPECT_EQ(registered_path,
+              api->GetUnpackedPath(web_contents.get(), retry_guid));
+    // SAF picker metadata keeps the original URI; retries keep the virtual path.
+    EXPECT_EQ(selected_path, api->last_unpacked_directory());
+    EXPECT_EQ(current_ids, registry()->enabled_extensions().GetIDs());
+
+    const std::string retry_args = base::StringPrintf(
+        R"([{"failQuietly":true,"populateError":true,"retryGuid":"%s"}])",
+        retry_guid.c_str());
+    function =
+        base::MakeRefCounted<api::DeveloperPrivateLoadUnpackedFunction>();
+    // Retrying must use the registered path without opening another chooser.
+    function->set_accept_dialog_for_testing(false);
+    function->SetRenderFrameHost(web_contents->GetPrimaryMainFrame());
+    result = api_test_utils::RunFunctionAndReturnSingleResult(
+        function.get(), retry_args, profile());
+    ASSERT_TRUE(result);
+    error = api::developer_private::LoadError::FromValue(*result);
+    ASSERT_TRUE(error);
+    EXPECT_NE(std::string::npos, error->error.find("version"));
+    EXPECT_EQ(retry_guid, error->retry_guid);
+    EXPECT_EQ(registered_path,
+              api->GetUnpackedPath(web_contents.get(), retry_guid));
+    EXPECT_EQ(selected_path, api->last_unpacked_directory());
+
+    dir.WriteManifest(
+        R"({
+             "name": "Android path forms",
+             "version": "1.0",
+             "manifest_version": 3
+           })");
+    function =
+        base::MakeRefCounted<api::DeveloperPrivateLoadUnpackedFunction>();
+    function->set_accept_dialog_for_testing(false);
+    function->SetRenderFrameHost(web_contents->GetPrimaryMainFrame());
+    result = api_test_utils::RunFunctionAndReturnSingleResult(
+        function.get(), retry_args, profile());
+    EXPECT_FALSE(result);
+    EXPECT_TRUE(function->GetError().empty());
+    ExtensionIdSet added_ids = base::STLSetDifference<ExtensionIdSet>(
+        registry()->enabled_extensions().GetIDs(), current_ids);
+    ASSERT_EQ(1u, added_ids.size());
+    EXPECT_EQ(registered_path,
+              registry()->enabled_extensions().GetByID(*added_ids.begin())->path());
+    EXPECT_EQ(registered_path,
+              api->GetUnpackedPath(web_contents.get(), retry_guid));
+    EXPECT_EQ(selected_path, api->last_unpacked_directory());
+
+    // Isolate this late callback from the successful load/retry above. The
+    // selected extension is already installed, so IDs alone cannot detect an
+    // unintended same-ID reinstall or reload.
+    task_environment()->RunUntilIdle();
+    InstallLifecycleObserver late_callback_lifecycle(registry());
+    auto closing_contents =
+        content::WebContentsTester::CreateTestWebContents(profile(), nullptr);
+    const ExtensionIdSet installed_before =
+        registry()->enabled_extensions().GetIDs();
+    auto late_selection = base::MakeRefCounted<DelayedSelection>(
+        base::BindLambdaForTesting([&] { closing_contents.reset(); }),
+        selected_path);
+    late_selection->SetRenderFrameHost(closing_contents->GetPrimaryMainFrame());
+    EXPECT_EQ("Could not find a valid web contents.",
+              api_test_utils::RunFunctionAndReturnError(
+                  late_selection.get(), "[]", profile()));
+    EXPECT_FALSE(closing_contents);
+    task_environment()->RunUntilIdle();
+    EXPECT_EQ(0, late_callback_lifecycle.installed_count());
+    EXPECT_EQ(0, late_callback_lifecycle.loaded_count());
+    EXPECT_EQ(0, late_callback_lifecycle.unloaded_count());
+    EXPECT_EQ(installed_before, registry()->enabled_extensions().GetIDs());
+    EXPECT_EQ(selected_path, api->last_unpacked_directory());
+    EXPECT_EQ(registered_path,
+              api->GetUnpackedPath(web_contents.get(), retry_guid));
+  }
+}
