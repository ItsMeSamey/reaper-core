+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindLambdaForTesting([&] {
+        contents.reset();
+        EXPECT_TRUE(function->GetResultListForTest());
+      }));
+  ASSERT_TRUE(api_test_utils::RunFunction(function.get(), "[]", profile()));
+  EXPECT_FALSE(contents);
+  ASSERT_EQ(1u, function->GetResultListForTest()->size());
+  EXPECT_FALSE((*function->GetResultListForTest())[0].GetBool());
+  task_environment()->RunUntilIdle();
+  for (const auto& extension : registry()->GenerateInstalledExtensionsSet()) {
+    EXPECT_NE("Closed sender test", extension->name());
+  }
+  EXPECT_TRUE(base::PathExists(crx));
+
+  // A surviving tab can navigate before unpack finishes. The API retires its
+  // callback, and the installer must not show a delayed prompt on the new page.
+  contents = content::WebContentsTester::CreateTestWebContents(profile(), nullptr);
+  auto navigating =
+      base::MakeRefCounted<api::DeveloperPrivateInstallFromFileFunction>();
+  navigating->SetRenderFrameHost(contents->GetPrimaryMainFrame());
+  navigating->set_accept_dialog_for_testing(true);
+  navigating->set_selected_file_for_testing(ui::SelectedFileInfo(crx));
+  ExtensionInstallPrompt::g_last_prompt_type_for_tests =
+      InstallPromptData::UNSET_PROMPT_TYPE;
+  std::unique_ptr<content::NavigationSimulator> pending_navigation;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindLambdaForTesting([&] {
+        pending_navigation = content::NavigationSimulator::CreateRendererInitiated(
+            GURL("https://example.test/replacement"), contents.get());
+        pending_navigation->Start();
+        EXPECT_TRUE(navigating->GetResultListForTest());
+      }));
+  ASSERT_TRUE(api_test_utils::RunFunction(navigating.get(), "[]", profile()));
+  ASSERT_EQ(1u, navigating->GetResultListForTest()->size());
+  EXPECT_FALSE((*navigating->GetResultListForTest())[0].GetBool());
+  // A late picker result must not revive the retired request.
+  navigating->FileSelected(ui::SelectedFileInfo(crx), 0);
+  ASSERT_TRUE(pending_navigation);
+  pending_navigation->Commit();
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(InstallPromptData::UNSET_PROMPT_TYPE,
+            ExtensionInstallPrompt::g_last_prompt_type_for_tests);
+  EXPECT_FALSE((*navigating->GetResultListForTest())[0].GetBool());
+  for (const auto& extension : registry()->GenerateInstalledExtensionsSet()) {
+    EXPECT_NE("Closed sender test", extension->name());
+  }
+
+  // Retiring that request must not poison an explicit fresh attempt.
+  ScopedTestDialogAutoConfirm accept(ScopedTestDialogAutoConfirm::ACCEPT);
+  auto retry = base::MakeRefCounted<api::DeveloperPrivateInstallFromFileFunction>();
+  retry->SetRenderFrameHost(contents->GetPrimaryMainFrame());
+  retry->set_accept_dialog_for_testing(true);
+  retry->set_selected_file_for_testing(ui::SelectedFileInfo(crx));
+  ASSERT_TRUE(api_test_utils::RunFunction(retry.get(), "[]", profile()));
+  ASSERT_EQ(1u, retry->GetResultListForTest()->size());
+  EXPECT_TRUE((*retry->GetResultListForTest())[0].GetBool());
+  EXPECT_TRUE(base::PathExists(crx));
+}
