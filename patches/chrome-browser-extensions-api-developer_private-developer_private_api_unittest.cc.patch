+TEST_F(DeveloperPrivateApiUnitTest,
+       InstallFromFileRendererLossNoticeIsTabScopedAndConsumedOnce) {
+  ExtensionFunction::ScopedUserGestureForTests gesture;
+  profile()->GetPrefs()->SetBoolean(prefs::kExtensionsUIDeveloperMode, true);
+  auto contents =
+      content::WebContentsTester::CreateTestWebContents(profile(), nullptr);
+  auto other_contents =
+      content::WebContentsTester::CreateTestWebContents(profile(), nullptr);
+  auto read_notice = [&](content::WebContents* sender, bool web_ui = true) {
+    auto query = base::MakeRefCounted<
+        api::DeveloperPrivateGetProfileConfigurationFunction>();
+    query->SetRenderFrameHost(sender->GetPrimaryMainFrame());
+    query->set_source_context_type(web_ui ? mojom::ContextType::kWebUi
+                                         : mojom::ContextType::kWebPage);
+    EXPECT_TRUE(api_test_utils::RunFunction(query.get(), "[]", profile()));
+    const auto* result = query->GetResultListForTest();
+    EXPECT_TRUE(result);
+    if (!result || result->size() != 1u) {
+      return false;
+    }
+    return (*result)[0]
+        .GetDict()
+        .FindBool("interruptedLocalImport")
+        .value_or(false);
+  };
+
+  auto cancelled =
+      base::MakeRefCounted<api::DeveloperPrivateInstallFromFileFunction>();
+  cancelled->SetRenderFrameHost(contents->GetPrimaryMainFrame());
+  cancelled->set_accept_dialog_for_testing(false);
+  ASSERT_TRUE(api_test_utils::RunFunction(cancelled.get(), "[]", profile()));
+  // An observer callback after an ordinary completed cancellation is inert.
+  static_cast<content::WebContentsObserver*>(cancelled.get())
+      ->PrimaryMainFrameRenderProcessGone(
+          base::TERMINATION_STATUS_PROCESS_WAS_KILLED);
+  EXPECT_FALSE(read_notice(contents.get()));
+
+  TestExtensionDir test_dir;
+  test_dir.WriteManifest(
+      R"({"name":"Interrupted local import","version":"1.0","manifest_version":3})");
+  const base::FilePath crx = test_dir.Pack();
+  auto disable_ui = ExtensionInstallUI::disable_ui_for_tests(true);
+  ScopedTestDialogAutoConfirm confirm(ScopedTestDialogAutoConfirm::CANCEL);
+  auto pending =
+      base::MakeRefCounted<api::DeveloperPrivateInstallFromFileFunction>();
+  pending->SetRenderFrameHost(contents->GetPrimaryMainFrame());
+  pending->set_accept_dialog_for_testing(true);
+  pending->set_selected_file_for_testing(ui::SelectedFileInfo(crx));
+  // Exercise the production observer callback before the native async reply.
+  // Actual Android renderer replacement remains a separate device regression.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindLambdaForTesting([&] {
+        static_cast<content::WebContentsObserver*>(pending.get())
+            ->PrimaryMainFrameRenderProcessGone(
+                base::TERMINATION_STATUS_PROCESS_WAS_KILLED);
+      }));
+  ASSERT_TRUE(api_test_utils::RunFunction(pending.get(), "[]", profile()));
+  ASSERT_EQ(1u, pending->GetResultListForTest()->size());
+  EXPECT_FALSE((*pending->GetResultListForTest())[0].GetBool());
+  pending->FileSelected(ui::SelectedFileInfo(crx), 0);
+  task_environment()->RunUntilIdle();
+  EXPECT_FALSE(read_notice(contents.get(), false));
+  EXPECT_FALSE(read_notice(other_contents.get()));
+  EXPECT_TRUE(read_notice(contents.get()));
+  EXPECT_FALSE(read_notice(contents.get()));
+  static_cast<content::WebContentsObserver*>(pending.get())
+      ->PrimaryMainFrameRenderProcessGone(
+          base::TERMINATION_STATUS_PROCESS_WAS_KILLED);
+  EXPECT_FALSE(read_notice(contents.get()));
+  for (const auto& extension : registry()->GenerateInstalledExtensionsSet()) {
+    EXPECT_NE("Interrupted local import", extension->name());
+  }
+  EXPECT_TRUE(base::PathExists(crx));
+}
