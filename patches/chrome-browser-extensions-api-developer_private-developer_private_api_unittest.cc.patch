+TEST_F(DeveloperPrivateApiUnitTest,
+       AndroidUserScriptsAccessPublishesFreshPrefsEvent) {
+  auto* extension_system =
+      static_cast<TestExtensionSystem*>(ExtensionSystem::Get(profile()));
+  extension_system->CreateUserScriptManager();
+  UserScriptManager* user_script_manager =
+      extension_system->user_script_manager();
+  ASSERT_TRUE(user_script_manager);
+
+  // This existing fixture has userScripts permission, but no background worker,
+  // content scripts or registered user scripts. Incidental worker events must
+  // not supply the missing settings update.
+  const Extension* extension = LoadUnpackedExtension();
+  ASSERT_TRUE(extension);
+  const ExtensionId id = extension->id();
+  base::RunLoop().RunUntilIdle();
+  ASSERT_FALSE(user_script_manager->AreUserScriptsAllowed(*extension));
+
+  auto update_access = [&](bool enabled) {
+    base::ListValue args;
+    args.Append(base::DictValue()
+                    .Set("extensionId", id)
+                    .Set("userScriptsAccess", enabled));
+    auto function = base::MakeRefCounted<
+        api::DeveloperPrivateUpdateExtensionConfigurationFunction>();
+    function->set_source_context_type(mojom::ContextType::kWebUi);
+    return RunFunction(function, args);
+  };
+
+  // No listener means the optional developer-private event router is absent.
+  ASSERT_FALSE(DeveloperPrivateAPI::Get(profile())
+                   ->developer_private_event_router());
+  ASSERT_TRUE(update_access(false));
+  EXPECT_FALSE(user_script_manager->AreUserScriptsAllowed(*extension));
+
+  EventRouter* event_router = EventRouter::Get(profile());
+  event_router->AddEventListener(
+      api::developer_private::OnItemStateChanged::kEventName,
+      render_process_host(), crx_file::id_util::GenerateId("listener"));
+  base::RunLoop().RunUntilIdle();
+  ItemStatePrefsChangedObserver observer(event_router, id);
+
+  // Repeated explicit settings updates also reconcile stale open pages; they
+  // must report current state, not the preference's pre-update allowed map.
+  for (bool enabled : {true, true, false, false}) {
+    SCOPED_TRACE(enabled);
+    observer.Reset();
+    ASSERT_EQ(0, observer.matching_event_count());
+    ASSERT_TRUE(update_access(enabled));
+    base::RunLoop().RunUntilIdle();
+    // The observer keeps the last payload: count every matching event so a
+    // stale-then-fresh pair or duplicate cannot hide behind that last value.
+    ASSERT_EQ(1, observer.matching_event_count());
+    auto info = observer.event_info();
+    EXPECT_EQ(id, info.id);
+    EXPECT_TRUE(info.user_scripts_access.is_enabled);
+    EXPECT_EQ(enabled, info.user_scripts_access.is_active);
+    EXPECT_EQ(enabled, user_script_manager->AreUserScriptsAllowed(*extension));
+  }
+}
