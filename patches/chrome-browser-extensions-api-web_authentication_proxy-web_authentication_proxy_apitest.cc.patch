+IN_PROC_BROWSER_TEST_F(WebAuthenticationProxyApiTest,
+                       NavigationCancelsProxyAndRejectsStaleCompletion) {
+  TestExtensionDir test_dir;
+  test_dir.WriteManifest(R"({"name":"Proxy navigation","version":"1",
+    "manifest_version":3,"permissions":["webAuthenticationProxy"],
+    "background":{"service_worker":"worker.js"}})");
+  test_dir.WriteFile(FILE_PATH_LITERAL("worker.js"), R"(
+    chrome.webAuthenticationProxy.onGetRequest.addListener(({requestId}) => {
+      chrome.test.sendMessage('request-started');
+    });
+    chrome.webAuthenticationProxy.onRequestCanceled.addListener(async requestId => {
+      try {
+        await chrome.webAuthenticationProxy.completeGetRequest({requestId,
+          error:{name:'NotAllowedError',message:'stale'}});
+        chrome.test.sendMessage('unexpected-stale-success');
+      } catch (error) {
+        chrome.test.assertEq('Invalid requestId', error.message);
+        chrome.test.sendMessage('request-cancelled-and-stale-rejected');
+      }
+    });
+    chrome.webAuthenticationProxy.attach().then(() => chrome.test.sendMessage('ready'));
+  )");
+  ExtensionTestMessageListener ready("ready");
+  ASSERT_TRUE(LoadExtension(test_dir.UnpackedPath()));
+  ASSERT_TRUE(ready.WaitUntilSatisfied());
+  auto* contents = GetActiveWebContents();
+  ASSERT_TRUE(NavigateToURL(contents, https_test_server_.GetURL("a.test", "/page.html")));
+  ExtensionTestMessageListener started("request-started");
+  ExtensionTestMessageListener cancelled("request-cancelled-and-stale-rejected");
+  ASSERT_TRUE(content::ExecJs(contents, R"(
+    void (window.pendingCredential = navigator.credentials.get({publicKey:{
+      rpId:'a.test',challenge:new Uint8Array([1])
+    }}).catch(error=>error.name));
+  )"));
+  ASSERT_TRUE(started.WaitUntilSatisfied());
+  ASSERT_TRUE(NavigateToURL(contents,
+      https_test_server_.GetURL("a.test", "/page.html?replacement-document")));
+  EXPECT_TRUE(cancelled.WaitUntilSatisfied());
+}
