+IN_PROC_BROWSER_TEST_F(WebAuthenticationProxyBackForwardCacheTest,
+                       RestoredDocumentKeepsProxyBinding) {
+  TestExtensionDir test_dir;
+  test_dir.WriteManifest(R"({"name":"Proxy BFCache","version":"1",
+    "manifest_version":3,"permissions":["webAuthenticationProxy"],
+    "background":{"service_worker":"worker.js"}})");
+  test_dir.WriteFile(FILE_PATH_LITERAL("worker.js"), R"(
+    chrome.webAuthenticationProxy.onIsUvpaaRequest.addListener(({requestId}) => {
+      chrome.webAuthenticationProxy.completeIsUvpaaRequest({requestId,isUvpaa:true});
+      chrome.test.sendMessage('proxied-uvpaa');
+    });
+    chrome.webAuthenticationProxy.attach().then(() => chrome.test.sendMessage('ready'));
+  )");
+  ExtensionTestMessageListener ready("ready");
+  ASSERT_TRUE(LoadExtension(test_dir.UnpackedPath()));
+  ASSERT_TRUE(ready.WaitUntilSatisfied());
+  auto* contents = GetActiveWebContents();
+  ASSERT_TRUE(NavigateToURL(contents, https_test_server_.GetURL("a.test", "/page.html")));
+  {
+    ExtensionTestMessageListener proxied("proxied-uvpaa");
+    EXPECT_EQ(true, content::EvalJs(contents,
+        "PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable()"));
+    ASSERT_TRUE(proxied.WaitUntilSatisfied());
+  }
+  auto original_document = contents->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  ASSERT_TRUE(NavigateToURL(contents, https_test_server_.GetURL("b.test", "/page.html")));
+  ASSERT_TRUE(original_document.AsRenderFrameHostIfValid());
+  ASSERT_TRUE(original_document.AsRenderFrameHostIfValid()->IsInLifecycleState(
+      content::RenderFrameHost::LifecycleState::kInBackForwardCache));
+  ASSERT_TRUE(content::HistoryGoBack(contents));
+  ASSERT_EQ(original_document.AsRenderFrameHostIfValid(), contents->GetPrimaryMainFrame());
+  ExtensionTestMessageListener proxied_after_restore("proxied-uvpaa");
+  EXPECT_EQ(true, content::EvalJs(contents,
+      "PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable()"));
+  EXPECT_TRUE(proxied_after_restore.WaitUntilSatisfied());
+}
