+IN_PROC_BROWSER_TEST_F(WebAuthenticationProxyApiTest,
+                       ProxyCannotBypassRelyingPartyAndAppIdChecks) {
+  TestExtensionDir test_dir;
+  test_dir.WriteManifest(R"({"name":"Proxy validation","version":"1",
+    "manifest_version":3,"permissions":["webAuthenticationProxy"],
+    "background":{"service_worker":"worker.js"}})");
+  test_dir.WriteFile(FILE_PATH_LITERAL("worker.js"), R"(
+    chrome.webAuthenticationProxy.onCreateRequest.addListener(({requestId}) => {
+      chrome.webAuthenticationProxy.completeCreateRequest({requestId,
+        error:{name:'InvalidStateError',message:'Request reached the proxy'}});
+    });
+    chrome.webAuthenticationProxy.onGetRequest.addListener(({requestId}) => {
+      chrome.webAuthenticationProxy.completeGetRequest({requestId,
+        error:{name:'InvalidStateError',message:'Request reached the proxy'}});
+    });
+    chrome.webAuthenticationProxy.attach().then(() => chrome.test.sendMessage('ready'));
+  )");
+  ExtensionTestMessageListener ready("ready");
+  ASSERT_TRUE(LoadExtension(test_dir.UnpackedPath()));
+  ASSERT_TRUE(ready.WaitUntilSatisfied());
+  auto* contents = GetActiveWebContents();
+  ASSERT_TRUE(NavigateToURL(contents, https_test_server_.GetURL("a.test", "/page.html")));
+  // The extension would respond InvalidStateError if either request were forwarded.
+  EXPECT_EQ("SecurityError", content::EvalJs(contents, R"(
+    navigator.credentials.create({publicKey:{
+      rp:{id:'unrelated.test',name:'test'}, challenge:new Uint8Array([1]),
+      user:{id:new Uint8Array([1]),name:'test',displayName:'test'},
+      pubKeyCredParams:[{type:'public-key',alg:-7}]
+    }}).then(()=>'unexpected-success', error=>error.name);
+  )"));
+  EXPECT_EQ("SecurityError", content::EvalJs(contents, R"(
+    navigator.credentials.get({publicKey:{rpId:'a.test', challenge:new Uint8Array([1]),
+      extensions:{appid:'https://unrelated.test/appid'}
+    }}).then(()=>'unexpected-success', error=>error.name);
+  )"));
+}
