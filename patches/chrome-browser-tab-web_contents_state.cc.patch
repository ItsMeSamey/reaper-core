+static ScopedJavaLocalRef<jobjectArray>
+JNI_WebContentsState_GetSerializedContainerIds(
+    JNIEnv* env, const JavaRef<jobject>& state, int saved_state_version) {
+  bool is_off_the_record = false;
+  int selected = 0;
+  std::vector<sessions::SerializedNavigationEntry> navigations;
+  auto bytes = base::android::JavaByteBufferToSpan(env, state);
+  if (!WebContentsState::ExtractNavigationEntries(
+          bytes, saved_state_version, &is_off_the_record, &selected,
+          &navigations) || is_off_the_record) {
+    return ScopedJavaLocalRef<jobjectArray>();
+  }
+  std::vector<std::string> ids;
+  for (const auto& navigation : navigations) {
+    const auto& key = navigation.storage_partition_key();
+    if (!key) continue;
+    if (key->first != "containers" || key->second.empty() ||
+        !containers::android::IsContainerIdWellFormed(key->second)) {
+      return ScopedJavaLocalRef<jobjectArray>();
+    }
+    if (!ids.empty() && ids.front() != key->second) {
+      return ScopedJavaLocalRef<jobjectArray>();
+    }
+    ids.push_back(key->second);
+  }
+  return base::android::ToJavaArrayOfStrings(env, ids);
+}
+
+static bool JNI_WebContentsState_HasContainerIdentityConflict(
+    JNIEnv* env, Profile* profile, const JavaRef<jobject>& state,
+    int saved_state_version, const std::string& container_id) {
+  bool is_off_the_record = profile->IsOffTheRecord();
+  int selected = 0;
+  std::vector<sessions::SerializedNavigationEntry> navigations;
+  auto bytes = base::android::JavaByteBufferToSpan(env, state);
+  if (!WebContentsState::ExtractNavigationEntries(
+          bytes, saved_state_version, &is_off_the_record, &selected, &navigations)) {
+    return false; // Ordinary corrupt data may use the separately persisted jar.
+  }
+  if (is_off_the_record != profile->IsOffTheRecord()) return true;
+  for (const auto& navigation : navigations) {
+    const auto& key = navigation.storage_partition_key();
+    if (key && (key->first != "containers" || key->second != container_id)) return true;
+  }
+  return false;
+}
