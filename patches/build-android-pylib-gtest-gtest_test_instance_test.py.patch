 class GtestTestInstanceTests(unittest.TestCase):
+    def testOwnedDataRootAbsentPreservesDefault(self):
+        self.assertEqual('chromium_tests_root', gtest_test_instance.GetTestDataRootName(None))
+        self.assertEqual({}, gtest_test_instance.GetTestDataRootExtras(None))
+
+    def testOwnedDataRootIsPassedUnchanged(self):
+        for token in ('a', 'run_783-09', 'x' * 64):
+            name = 'chromium_tests_root_' + token
+            self.assertEqual(name, gtest_test_instance.GetTestDataRootName(name))
+            self.assertEqual(
+                {'org.chromium.native_test.NativeTest.TestDataRootName': name},
+                gtest_test_instance.GetTestDataRootExtras(name),
+            )
+
+    def testOwnedDataRootCannotSelectSharedOrEscapeDirectory(self):
+        for name in ('', 'chromium_tests_root', 'chromium_tests_root_',
+                     '/sdcard/chromium_tests_root_x', '../chromium_tests_root_x',
+                     'chromium_tests_root_x/child', 'chromium_tests_root_x/..',
+                     'chromium_tests_root_x\n', 'chromium_tests_root_é',
+                     'chromium_tests_root_' + 'x' * 65, 123, True):
+            with self.subTest(name=name):
+                with self.assertRaises(ValueError):
+                    gtest_test_instance.GetTestDataRootExtras(name)
+
+    def testLaunchDisplayAbsentPreservesDefaultExtras(self):
+        self.assertEqual({}, gtest_test_instance.GetLaunchDisplayExtras(None))
+
+    def testLaunchDisplayExplicitIdIsInstrumentationExtra(self):
+        key = ('org.chromium.native_test.'
+               'NativeTestInstrumentationTestRunner.LaunchDisplayId')
+        for display_id in (0, 1560, 2147483647):
+            with self.subTest(display_id=display_id):
+                self.assertEqual(
+                    {key: display_id},
+                    gtest_test_instance.GetLaunchDisplayExtras(display_id),
+                )
+
+    def testLaunchDisplayInvalidIdCannotFallBackToDefault(self):
+        for display_id in (-1, 2147483648, True, '1560', 1.5):
+            with self.subTest(display_id=display_id):
+                with self.assertRaises(ValueError):
+                    gtest_test_instance.GetLaunchDisplayExtras(display_id)
+
