+
+  async function androidCanUpdateConfiguredWorldsAtCapacity() {
+    if ((await chrome.runtime.getPlatformInfo()).os !== 'android') {
+      chrome.test.succeed();
+      return;
+    }
+    await cleanUpState();
+
+    await chrome.userScripts.configureWorld({csp: 'default original'});
+    for (let i = 0; i < 99; ++i) {
+      await chrome.userScripts.configureWorld({
+        worldId: `capacity-${i}`,
+        csp: 'named original',
+        messaging: true,
+      });
+    }
+    chrome.test.assertEq(
+        100, (await chrome.userScripts.getWorldConfigurations()).length);
+
+    // A named-world edit preserves omitted properties and consumes no slot.
+    await chrome.userScripts.configureWorld({
+      worldId: 'capacity-0',
+      csp: 'named updated',
+    });
+    await chrome.userScripts.configureWorld({worldId: 'capacity-0'});
+    let worlds = await chrome.userScripts.getWorldConfigurations();
+    const named = worlds.find(world => world.worldId === 'capacity-0');
+    chrome.test.assertEq('named updated', named.csp);
+    chrome.test.assertTrue(named.messaging);
+
+    // Empty and omitted IDs both update the already-configured default world.
+    await chrome.userScripts.configureWorld({
+      worldId: '',
+      csp: 'default updated',
+    });
+    await chrome.userScripts.configureWorld({messaging: true});
+    await chrome.userScripts.configureWorld({});
+    worlds = await chrome.userScripts.getWorldConfigurations();
+    const defaultWorld = worlds.find(world => world.worldId === undefined);
+    chrome.test.assertEq('default updated', defaultWorld.csp);
+    chrome.test.assertTrue(defaultWorld.messaging);
+    chrome.test.assertEq(100, worlds.length);
+
+    await chrome.test.assertPromiseRejects(
+        chrome.userScripts.configureWorld({worldId: 'one more', csp: 'new'}),
+        'Error: You may only configure up to 100 ' +
+            'individual user script worlds.');
+    chrome.test.assertEq(
+        100, (await chrome.userScripts.getWorldConfigurations()).length);
+
+    // Removing one configuration releases exactly one slot for a new world.
+    await chrome.userScripts.resetWorldConfiguration('capacity-98');
+    await chrome.userScripts.configureWorld({worldId: 'one more', csp: 'new'});
+    worlds = await chrome.userScripts.getWorldConfigurations();
+    chrome.test.assertEq(100, worlds.length);
+    chrome.test.assertEq('new', worlds.find(world => world.worldId === 'one more').csp);
+    await cleanUpState();
     chrome.test.succeed();
   },
 
