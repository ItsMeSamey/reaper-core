+      _bottom_bar_resource_directories += [ _directory ]
+    }
+    _root = "$target_gen_dir/bottom_bar_resources_selected/" +
+            string_replace(_directory, "/", "_")
+    _qualifier = get_path_info(_directory, "file")
+    _file = get_path_info(_source, "file")
+    _bottom_bar_resource_sources += [ "$_root/$_qualifier/$_file" ]
+  }
+  foreach(_directory, _bottom_bar_resource_directories) {
+    _qualifier = get_path_info(_directory, "file")
+    _copy_target = "copy_selected_bottom_bar_" +
+                   string_replace(_directory, "/", "-")
+    copy_ex(_copy_target) {
+      sources = filter_include(_bottom_bar_resource_spec.sources, [ "$_directory/*" ])
+      _root = "$target_gen_dir/bottom_bar_resources_selected/" +
+              string_replace(_directory, "/", "_")
+      dest = "$_root/$_qualifier"
+      outputs = process_file_template(sources, [ "$dest/{{source_file_part}}" ])
+      args = [ "--clear" ]
+    }
+    _bottom_bar_resource_copy_deps += [ ":$_copy_target" ]
+  }
+}
+
+android_resources("java_resources") {
+  sources = _bottom_bar_resource_spec.sources
+  if (is_android) {
+    sources = []
+    sources += _bottom_bar_resource_sources
+  }
