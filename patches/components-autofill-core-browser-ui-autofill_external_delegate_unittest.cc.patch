+                      AutofillSuggestionTriggerSource::kAtMemoryContextMenu,
+                      AutofillSuggestionTriggerSource::kGlic}) {
+    external_delegate().OnQuery(incoming, incoming.fields().front(),
+                                gfx::Rect(), source);
+    EXPECT_EQ(external_delegate().GetQueriedFieldId(), ordinary_query);
+  }
+  for (auto type :
+       {SuggestionType::kAtMemorySearchResult,
+        SuggestionType::kAtMemorySearchAffordance,
+        SuggestionType::kAtMemoryOpenGemini,
+        SuggestionType::kPersonalContextNotice,
+        SuggestionType::kMaximizeCreditCardBenefitsEntry,
+        SuggestionType::kFillAutofillAi, SuggestionType::kFetchingAmbientData,
+        SuggestionType::kRemoveAutofillAi, SuggestionType::kManageAutofillAi,
+        SuggestionType::kAutofillAiPrivateInferenceNotice}) {
+    Suggestion incoming_suggestion(type);
+    external_delegate().DidSelectSuggestion(incoming_suggestion);
+    external_delegate().DidAcceptSuggestion(
+        incoming_suggestion, SuggestionPosition{.multi_index = {0}});
+    EXPECT_FALSE(external_delegate().RemoveSuggestion(incoming_suggestion));
+    EXPECT_EQ(external_delegate().GetQueriedFieldId(), ordinary_query);
+  }
+}
+
+TEST_F(AutofillExternalDelegateTest,
+       AndroidReturnedRowsPruneNestedUnsupportedItemsAndKeepOrdinaryRows) {
+  IssueOnQuery();
+  Suggestion address = CreateAutofillSuggestion(SuggestionType::kAddressEntry,
+                                                u"address suggestion");
+  address.children = {
+      Suggestion(SuggestionType::kAtMemorySearchResult),
+      CreateAutofillSuggestion(SuggestionType::kAutocompleteEntry,
+                               u"ordinary nested value"),
+      Suggestion(SuggestionType::kPersonalContextNotice)};
+  Suggestion payment = CreateAutofillSuggestion(
+      SuggestionType::kCreditCardEntry, u"ordinary card");
+  EXPECT_CALL(autofill_client(), ShowAutofillSuggestions(_, _))
+      .WillOnce([](const AutofillClient::PopupOpenArgs& args,
+                   base::WeakPtr<AutofillSuggestionDelegate>) {
+        EXPECT_EQ(args.suggestions.size(), 2u);
+        if (args.suggestions.size() != 2u) {
+          return AutofillClient::SuggestionUiSessionId(1);
+        }
+        EXPECT_EQ(args.suggestions[0].type, SuggestionType::kAddressEntry);
+        EXPECT_EQ(args.suggestions[1].type, SuggestionType::kCreditCardEntry);
+        EXPECT_THAT(
+            args.suggestions[0].children,
+            ElementsAre(testing::Field(&Suggestion::type,
+                                       SuggestionType::kAutocompleteEntry)));
+        return AutofillClient::SuggestionUiSessionId(1);
+      });
+  OnSuggestionsReturned(
+      queried_field(),
+      {Suggestion(SuggestionType::kMaximizeCreditCardBenefitsEntry), address,
+       Suggestion(SuggestionType::kAtMemorySearchAffordance), payment});
+}
