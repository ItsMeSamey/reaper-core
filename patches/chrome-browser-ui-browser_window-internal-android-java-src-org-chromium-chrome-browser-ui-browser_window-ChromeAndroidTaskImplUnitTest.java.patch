+        var delegate = new TestBrowserFullscreenDelegate();
+        var objects =
+                withBrowserFullscreenDelegate(
+                        createActivityScopedObjects(2, nativeDeps.mMockProfile), delegate);
+        var activity = assertNonNull(objects.mActivityWindowAndroid.getActivity().get());
