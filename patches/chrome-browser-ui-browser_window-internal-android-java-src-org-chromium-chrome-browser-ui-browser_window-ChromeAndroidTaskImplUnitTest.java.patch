+        var previousWindow = previousDeps.mActivityWindowAndroidMocks.mMockActivityWindowAndroid;
+        var currentWindow = currentDeps.mActivityWindowAndroidMocks.mMockActivityWindowAndroid;
+        var previousActivity = previousDeps.mActivityWindowAndroidMocks.mMockActivity;
+        var currentActivity = currentDeps.mActivityWindowAndroidMocks.mMockActivity;
+        var previousActivityManager =
+                (ActivityManager) previousActivity.getSystemService(Context.ACTIVITY_SERVICE);
+        var currentActivityManager =
+                (ActivityManager) currentActivity.getSystemService(Context.ACTIVITY_SERVICE);
+
+        // Retain the stock metrics fixture while making the focus gate non-desktop.
+        AppHeaderUtils.setAppInDesktopWindowForTesting(false);
+        when(previousActivity.isInMultiWindowMode()).thenReturn(false);
+        when(currentActivity.isInMultiWindowMode()).thenReturn(false);
+        assertFalse(
