+    /** Counts lifecycle calls while retaining the real supplier's observer behavior. */
+    private static class RecordingTabModelSupplier implements MonotonicObservableSupplier<TabModel> {
+        private final MonotonicObservableSupplier<TabModel> mDelegate;
+        private int mAddSyncObserverCalls;
+        private int mRemoveObserverCalls;
+
+        RecordingTabModelSupplier(MonotonicObservableSupplier<TabModel> delegate) {
+            mDelegate = delegate;
+        }
+
+        @Override
+        public @Nullable TabModel get() {
+            return mDelegate.get();
+        }
+
+        @Override
+        public @Nullable TabModel addObserver(
+                Callback<TabModel> observer, @NotifyBehavior int behavior) {
+            return mDelegate.addObserver(observer, behavior);
+        }
+
+        @Override
+        public @Nullable TabModel addSyncObserverAndPostIfNonNull(Callback<TabModel> observer) {
+            mAddSyncObserverCalls++;
+            return mDelegate.addSyncObserverAndPostIfNonNull(observer);
+        }
+
+        @Override
+        public void removeObserver(Callback<TabModel> observer) {
+            mRemoveObserverCalls++;
+            mDelegate.removeObserver(observer);
+        }
+
+        @Override
+        public int getObserverCount() {
+            return mDelegate.getObserverCount();
+        }
+    }
