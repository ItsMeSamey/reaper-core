+        currentTask.showInactive();
+
+        assertEquals(State.PENDING_UPDATE, currentTask.getState());
+        assertEquals(
+                false,
+                currentTask
+                        .getPendingActionManagerForTesting()
+                        .isActiveFuture(currentTask.getState()));
+        assertFalse(currentTask.isActive());
+        assertTrue("Actual focus waits for the OS callback", currentWindow.isTopResumedActivity());
+        assertTrue(currentTask.isVisible());
+        verify(previousActivityManager, times(1)).moveTaskToFront(eq(1), eq(0));
+        verify(currentActivityManager, never()).moveTaskToFront(anyInt(), anyInt());
+
+        currentTask.showInactive();
+        verify(previousActivityManager, times(1)).moveTaskToFront(eq(1), eq(0));
+
+        when(previousWindow.isTopResumedActivity()).thenReturn(true);
+        previousTask.onTopResumedActivityChangedWithNative(true);
+        when(currentWindow.isTopResumedActivity()).thenReturn(false);
+        currentTask.onTopResumedActivityChangedWithNative(false);
+
+        assertEquals(State.IDLE, currentTask.getState());
+        assertNoPendingActions(currentTask);
+        assertNull(
+                currentTask
+                        .getPendingActionManagerForTesting()
+                        .isActiveFuture(currentTask.getState()));
+        assertFalse(currentTask.isActive());
+        assertTrue(previousTask.isActive());
+        assertEquals(State.IDLE, previousTask.getState());
+        assertTrue(currentTask.isVisible());
