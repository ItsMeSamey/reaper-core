+        when(previousWindow.isTopResumedActivity()).thenReturn(false);
+        previousTask.onTopResumedActivityChangedWithNative(false);
+        when(currentWindow.isTopResumedActivity()).thenReturn(true);
+        currentTask.onTopResumedActivityChangedWithNative(true);
+        assertTrue(
+                currentTask.getLastActivatedTimeMillis() > previousTask.getLastActivatedTimeMillis());
+        assertEquals(State.IDLE, currentTask.getState());
+        assertTrue(currentTask.isActive());
