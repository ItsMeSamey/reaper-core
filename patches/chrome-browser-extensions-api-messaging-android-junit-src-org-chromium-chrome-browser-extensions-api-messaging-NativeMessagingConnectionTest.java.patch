+    @Test
+    public void testPendingSessionsRemoteExceptionClosesAllPortsInBothRoutes() throws Exception {
+        for (boolean authorized : new boolean[] {false, true}) {
+            NativeMessagingConnection.Observer connectionObserver =
+                    Mockito.mock(NativeMessagingConnection.Observer.class);
+            NativeMessagingConnection connection =
+                    new NativeMessagingConnection(TARGET_PACKAGE, connectionObserver);
+            IBrowserNativeMessageService service = Mockito.mock(IBrowserNativeMessageService.class);
+            if (authorized) {
+                Mockito.doThrow(new RemoteException("Pending authorized authentication failed"))
+                        .when(service).connectAuthorizedExtension(
+                                Mockito.any(), Mockito.any(), Mockito.any());
+            } else {
+                Mockito.doThrow(new RemoteException("Pending legacy authentication failed"))
+                        .when(service).connectExtension(Mockito.any(), Mockito.any(), Mockito.any());
+            }
+            NativeMessageAndroidPort port1 = new NativeMessageAndroidPort();
+            NativeMessageAndroidPort port2 = new NativeMessageAndroidPort();
+            NativeMessageAndroidPort.TestObserver observer1 =
+                    Mockito.mock(NativeMessageAndroidPort.TestObserver.class);
+            NativeMessageAndroidPort.TestObserver observer2 =
+                    Mockito.mock(NativeMessageAndroidPort.TestObserver.class);
+            port1.setTestObserver(observer1);
+            port2.setTestObserver(observer2);
+
+            // Both sessions must be pending before the real service-connection callback.
+            Assert.assertNull(connection.addPort(EXT_1, true, authorized, port1));
+            Assert.assertNull(connection.addPort(EXT_2, false, authorized, port2));
+            Assert.assertNotNull(connection.getSessionForTesting(EXT_1));
+            Assert.assertNotNull(connection.getSessionForTesting(EXT_2));
+            Assert.assertTrue(connection.isBound());
+            Assert.assertNull(connection.getServiceForTesting());
+            mTestContext.triggerServiceConnected(serviceBinder(service));
+            RobolectricUtil.runAllBackgroundAndUi();
+
+            // Do not assume which HashMap entry authenticates first.
+            String error = NativeMessagingConnection.getUnableToConnectError(TARGET_PACKAGE);
+            Mockito.verify(observer1).onChannelClosed(error);
+            Mockito.verify(observer2).onChannelClosed(error);
+            Mockito.verify(observer1, Mockito.never()).onMessageFromApp(Mockito.anyString());
+            Mockito.verify(observer2, Mockito.never()).onMessageFromApp(Mockito.anyString());
+            Assert.assertNull(connection.getSessionForTesting(EXT_1));
+            Assert.assertNull(connection.getSessionForTesting(EXT_2));
+            Assert.assertFalse(connection.isBound());
+            Assert.assertNull(connection.getServiceForTesting());
+            connection.unbind();
+            Mockito.verify(connectionObserver).onUnbound(TARGET_PACKAGE);
+            if (authorized) {
+                Mockito.verify(service).connectAuthorizedExtension(
+                        Mockito.eq(EXT_1), Mockito.any(), Mockito.any());
+                Mockito.verify(service).connectAuthorizedExtension(
+                        Mockito.eq(EXT_2), Mockito.any(), Mockito.any());
+                Mockito.verify(service, Mockito.never()).connectExtension(
+                        Mockito.any(), Mockito.any(), Mockito.any());
+            } else {
+                Mockito.verify(service).connectExtension(
+                        Mockito.eq(EXT_1), Mockito.any(), Mockito.any());
+                Mockito.verify(service).connectExtension(
+                        Mockito.eq(EXT_2), Mockito.any(), Mockito.any());
+                Mockito.verify(service, Mockito.never()).connectAuthorizedExtension(
+                        Mockito.any(), Mockito.any(), Mockito.any());
+            }
+        }
+    }
