+    @Test
+    public void testLocalGrantRejectionRetiresOnlyNewPort() throws Exception {
+        boolean[] currentGrant = {true};
+        IExtensionNativeMessagePort accepted = Mockito.mock(IExtensionNativeMessagePort.class);
+        IExtensionNativeMessageService localSession = new IExtensionNativeMessageService.Stub() {
+            @Override
+            public void closeConnection() {}
+
+            @Override
+            public void connectPort(
+                    IExtensionNativeMessageCallback receiver, IConnectPortCallback callback)
+                    throws RemoteException {
+                if (!currentGrant[0]) {
+                    throw new SecurityException("Local SDK grant is no longer current");
+                }
+                callback.onSuccess(accepted);
+            }
+        };
+        NativeMessagingConnection connection =
+                new NativeMessagingConnection(TARGET_PACKAGE, mObserver);
+        NativeMessageAndroidPort oldPort = new NativeMessageAndroidPort();
+        NativeMessageAndroidPort newPort = new NativeMessageAndroidPort();
+        NativeMessageAndroidPort.TestObserver oldObserver =
+                Mockito.mock(NativeMessageAndroidPort.TestObserver.class);
+        NativeMessageAndroidPort.TestObserver newObserver =
+                Mockito.mock(NativeMessageAndroidPort.TestObserver.class);
+        oldPort.setTestObserver(oldObserver);
+        newPort.setTestObserver(newObserver);
+        try {
+            mTestContext.triggerServiceConnected(authorizedLocalServiceBinder(localSession));
+            Assert.assertNull(connection.addPort(EXT_1, true, true, oldPort));
+            RobolectricUtil.runAllBackgroundAndUi();
+            var session = connection.getSessionForTesting(EXT_1);
+            Assert.assertNotNull(session);
+            Assert.assertSame(localSession, session.getServiceForTesting());
+            currentGrant[0] = false;
+            String error = NativeMessagingConnection.getUnableToConnectError(TARGET_PACKAGE);
+            Assert.assertEquals(error, connection.addPort(EXT_1, true, true, newPort));
+            RobolectricUtil.runAllBackgroundAndUi();
+            Mockito.verify(newObserver).onChannelClosed(Mockito.anyString());
+            Mockito.verify(newObserver, Mockito.never()).onMessageFromApp(Mockito.anyString());
+            Mockito.verify(oldObserver, Mockito.never()).onChannelClosed(Mockito.anyString());
+            Assert.assertSame(session, connection.getSessionForTesting(EXT_1));
+            Assert.assertTrue(connection.isBound());
+            // A retired rejected port cannot keep the otherwise idle session alive.
+            oldPort.destroy();
+            ShadowLooper.idleMainLooper(60, TimeUnit.SECONDS);
+            Assert.assertNull(connection.getSessionForTesting(EXT_1));
+            Assert.assertFalse(connection.isBound());
+            Mockito.verify(mObserver).onUnbound(TARGET_PACKAGE);
+        } finally {
+            oldPort.destroy();
+            newPort.destroy();
+            connection.unbind();
+        }
+    }
