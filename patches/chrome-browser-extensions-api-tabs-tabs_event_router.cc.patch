+void TabsEventRouter::TabEntry::DispatchSplitPropertyUpdates() {
+  std::set<std::string> properties;
+  properties.swap(pending_split_properties_);
+  if (!properties.empty()) {
+    router_->TabUpdated(this, std::move(properties));
+  }
+}
