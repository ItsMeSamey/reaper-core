+void TabsEventRouter::TabEntry::QueueSplitPropertyUpdate(const char* property) {
+  bool already_pending = !pending_split_properties_.empty();
+  pending_split_properties_.insert(property);
+  if (!already_pending) {
+    // Java coalesces multi-tab mutations before returning to the UI event loop.
+    // Pin/group callbacks occur while normalizing the tree; serialize the full
+    // extension Tab object only after its final split membership is restored.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&TabEntry::DispatchSplitPropertyUpdates,
+                                  weak_factory_.GetWeakPtr()));
+  }
