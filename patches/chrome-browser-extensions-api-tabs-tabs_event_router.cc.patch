+#if BUILDFLAG(IS_ANDROID)
+bool WillDispatchNativeTabEvent(
+    tabs::TabHandle handle,
+    bool created,
+    bool active,
+    const std::set<std::string>& changed_property_names,
+    content::BrowserContext* browser_context,
+    mojom::ContextType target_context,
+    const Extension* extension,
+    const base::DictValue* listener_filter,
+    std::optional<base::ListValue>& event_args_out,
+    mojom::EventFilteringInfoPtr& event_filtering_info_out,
+    bool* dispatch_separate_event_out) {
+  auto* tab = handle.Get();
+  if (!tab) {
+    return false;
+  }
+  auto scrub = ExtensionTabUtil::GetScrubTabBehavior(
+      extension, target_context, *tab);
+  auto value = ExtensionTabUtil::CreateTabObject(*tab, scrub, extension).ToValue();
+  event_args_out.emplace();
+  if (created) {
+    value.Set(tabs_constants::kSelectedKey, active);
+    value.Set(tabs_constants::kActiveKey, active);
+  } else {
+    base::DictValue changed;
+    for (const auto& key : changed_property_names) {
+      if (auto* property = value.Find(key)) {
+        changed.Set(key, property->Clone());
+      }
+    }
+    event_args_out->Append(ExtensionTabUtil::GetTabId(*tab));
+    event_args_out->Append(std::move(changed));
+  }
+  event_args_out->Append(std::move(value));
+  return true;
+}
+
+void DispatchNativeTabEvent(tabs::TabInterface& tab,
+                            bool created,
+                            std::set<std::string> changed = {}) {
+  auto* profile = tab.GetProfile();
+  auto event = std::make_unique<Event>(
+      created ? events::TABS_ON_CREATED : events::TABS_ON_UPDATED,
+      created ? api::tabs::OnCreated::kEventName : api::tabs::OnUpdated::kEventName,
+      base::ListValue(), profile);
+  event->user_gesture = EventRouter::UserGestureState::kNotEnabled;
+  event->will_dispatch_callback = base::BindRepeating(
+      &WillDispatchNativeTabEvent, tab.GetHandle(), created, tab.IsActivated(),
+      std::move(changed));
+  EventRouter::Get(profile)->BroadcastEvent(std::move(event));
+}
+#endif
+
