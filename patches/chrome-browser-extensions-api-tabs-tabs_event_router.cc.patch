+TabsEventRouter::PendingTab::PendingTab(TabsEventRouter& router,
+                                        TabAndroid& tab,
+                                        TabListInterface* tab_list,
+                                        int index)
+    : tab_list(tab_list), index(index),
+      last_known_split(tab.GetSplit()), router_(router), handle_(tab.GetHandle()) {
+  observation_.Observe(&tab);
+  pinned_subscription_ = tab.RegisterPinnedStateChanged(base::BindRepeating(
+      [](PendingTab* entry, tabs::TabInterface* tab, bool) {
+        entry->PropertyChanged(*tab, kPinnedKey);
+      }, base::Unretained(this)));
+  group_subscription_ = tab.RegisterGroupChanged(base::BindRepeating(
+      [](PendingTab* entry, tabs::TabInterface* tab,
+         std::optional<tab_groups::TabGroupId>) {
+        entry->PropertyChanged(*tab, kGroupIdKey);
+      }, base::Unretained(this)));
+}
+
+TabsEventRouter::PendingTab::~PendingTab() = default;
+
+void TabsEventRouter::PendingTab::PropertyChanged(
+    tabs::TabInterface& tab, const char* property) {
+  if (!last_known_split) {
+    DispatchNativeTabEvent(tab, false, {property});
+    return;
+  }
+  // Java normalizes the collection temporarily when changing split members.
+  // Match eager tabs: serialize only after the final split tree is restored.
+  const bool already_pending = !changed_properties.empty();
+  changed_properties.insert(property);
+  if (!already_pending) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&PendingTab::DispatchProperties,
+                                 weak_factory_.GetWeakPtr()));
+  }
+}
+
+void TabsEventRouter::PendingTab::DispatchProperties() {
+  if (auto* tab = handle_.Get(); tab && !changed_properties.empty()) {
+    auto changed = std::move(changed_properties);
+    changed_properties.clear();
+    DispatchNativeTabEvent(*tab, false, std::move(changed));
+  }
+}
+
+void TabsEventRouter::PendingTab::OnInitWebContents(TabAndroid* tab) {
+  // MaterializeTab removes this observer and deletes this pending entry.
+  router_->MaterializeTab(*tab);
+}
+
+void TabsEventRouter::PendingTab::OnTabAndroidDestroyed(TabAndroid* tab) {
+  observation_.Reset();
+  // The tab can be destroyed while detached from every tracked model.
+  // Erasing the entry also cancels its posted split-property callback.
+  router_->pending_tabs_.erase(tab->GetHandle());
+}
+
+TabsEventRouter::PendingTab* TabsEventRouter::GetPendingTab(
+    tabs::TabInterface& tab) {
+  auto it = pending_tabs_.find(tab.GetHandle());
+  return it == pending_tabs_.end() ? nullptr : it->second.get();
+}
+
+void TabsEventRouter::MaterializeTab(TabAndroid& tab) {
+  auto it = pending_tabs_.find(tab.GetHandle());
+  CHECK(it != pending_tabs_.end());
+  content::WebContents* contents = tab.GetContents();
+  CHECK(contents);
+  const int index = it->second->index;
+  const auto handle = tab.GetHandle();
+  auto changed_properties = std::move(it->second->changed_properties);
+  pending_tabs_.erase(it);
+  RegisterForTabNotifications(*contents, index);
+  if (handle.Get() && handle.Get()->GetContents() == contents &&
+      !changed_properties.empty()) {
+    DispatchTabUpdatedEvent(contents, std::move(changed_properties));
+  }
+}
