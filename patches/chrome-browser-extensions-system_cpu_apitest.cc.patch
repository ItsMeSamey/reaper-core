 #include "extensions/buildflags/buildflags.h"
@@ -19,6 +24,15 @@ class MockCpuInfoProviderImpl : public CpuInfoProvider {
   MockCpuInfoProviderImpl(const MockCpuInfoProviderImpl&) = delete;
   MockCpuInfoProviderImpl& operator=(const MockCpuInfoProviderImpl&) = delete;
 
+#if BUILDFLAG(IS_ANDROID)
+  static bool ParseAndroidCpuTime(
+      const std::string& contents,
+      long ticks_per_second,
+      std::vector<api::system_cpu::ProcessorInfo>* infos) {
