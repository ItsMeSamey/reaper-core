+// Create an ordinary destination group from the real incoming-tab hook, before
+// the reparented group is restored. No group-creation notification is simulated.
+class CreateUnrelatedGroupOnIncomingTab : public TabModelObserver {
+ public:
+  CreateUnrelatedGroupOnIncomingTab(TabModel* model,
+                                   TabListInterface* tab_list,
+                                   TabGroupsMoveFunction* function)
+      : model_(model), tab_list_(tab_list), function_(function) {
+    model_->AddObserver(this);
+  }
+
+  ~CreateUnrelatedGroupOnIncomingTab() override {
+    if (model_) {
+      model_->RemoveObserver(this);
+    }
+  }
+
+  void WillAddTab(TabAndroid*, TabModel::TabLaunchType) override {
+    if (handled_incoming_tab_) {
+      return;
+    }
+    handled_incoming_tab_ = true;
+    EXPECT_FALSE(function_->did_respond());
+    unrelated_group_ =
+        tab_list_->CreateTabGroup({tab_list_->GetTab(0)->GetHandle()});
+    EXPECT_TRUE(unrelated_group_.has_value());
+    EXPECT_FALSE(function_->did_respond());
+  }
+
+  void OnTabModelDestroyed(TabModel& model) override {
+    if (&model == model_) {
+      model_ = nullptr;
+    }
+  }
+
+  const std::optional<TabGroupId>& unrelated_group() const {
+    return unrelated_group_;
+  }
+
+ private:
+  raw_ptr<TabModel> model_;
+  raw_ptr<TabListInterface> tab_list_;
+  raw_ptr<TabGroupsMoveFunction> function_;
+  bool handled_incoming_tab_ = false;
+  std::optional<TabGroupId> unrelated_group_;
+};
+
+IN_PROC_BROWSER_TEST_F(TabGroupsApiBrowserTest,
+                       AndroidCrossWindowMoveIgnoresUnrelatedGroupCreation) {
+  ASSERT_TRUE(SupportsTabGroups());
+  auto extension = ExtensionBuilder("MV3 tabGroups move")
+                       .SetManifestVersion(3)
+                       .AddAPIPermission("tabGroups")
+                       .Build();
+  TabGroupId group = CreateTabGroup({2, 3, 4});
+  const int group_id = ExtensionTabUtil::GetGroupId(group);
+  BrowserWindowInterface* target_browser =
+      CreateBrowserWindowWithType(BrowserWindowInterface::TYPE_NORMAL);
+  ASSERT_TRUE(ExtensionTabUtil::SupportsTabGroups(target_browser));
+  target_browser->GetWindow()->Activate();
+  TabListInterface* target_tabs = TabListInterface::From(target_browser);
+  ASSERT_TRUE(target_tabs);
+  ASSERT_EQ(1, target_tabs->GetTabCount());
+  TabModel* target_model = TabModelList::FindTabModelWithWindowSessionId(
+      target_browser->GetSessionID());
+  ASSERT_TRUE(target_model);
+
+  auto function = base::MakeRefCounted<TabGroupsMoveFunction>();
+  function->set_extension(extension);
+  {
+    CreateUnrelatedGroupOnIncomingTab create_unrelated(target_model, target_tabs,
+                                                      function.get());
+    constexpr char kFormatArgs[] =
+        R"([%d, {"windowId": %d, "index": 1}])";
+    const std::string args = base::StringPrintf(
+        kFormatArgs, group_id, ExtensionTabUtil::GetWindowId(target_browser));
+    ASSERT_TRUE(api_test_utils::RunFunction(function.get(), args, profile(),
+                                            api_test_utils::FunctionMode::kNone));
+    ASSERT_TRUE(create_unrelated.unrelated_group());
+    EXPECT_NE(group, *create_unrelated.unrelated_group());
+    const base::ListValue* results = function->GetResultListForTest();
+    ASSERT_TRUE(results);
+    ASSERT_EQ(1u, results->size());
+    ASSERT_TRUE((*results)[0].is_dict());
+    const auto& group_info = (*results)[0].GetDict();
+    ASSERT_TRUE(group_info.FindInt("id"));
+    EXPECT_EQ(group_id, *group_info.FindInt("id"));
+    ASSERT_TRUE(group_info.FindInt("windowId"));
+    EXPECT_EQ(ExtensionTabUtil::GetWindowId(target_browser),
+              *group_info.FindInt("windowId"));
+    EXPECT_TRUE(function->HasOneRef());
+  }
+
+  // The normal matching completion retires the observer and its pending ref.
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(4, target_tabs->GetTabCount());
+  EXPECT_EQ(group, target_tabs->GetTab(1)->GetGroup().value());
+  EXPECT_EQ(group, target_tabs->GetTab(2)->GetGroup().value());
+  EXPECT_EQ(group, target_tabs->GetTab(3)->GetGroup().value());
+  EXPECT_TRUE(function->HasOneRef());
+  for (tabs::TabInterface* tab : target_tabs->GetAllTabs()) {
+    tab->Close();
+  }
+}
