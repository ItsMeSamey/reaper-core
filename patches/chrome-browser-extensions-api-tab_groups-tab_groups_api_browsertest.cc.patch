+IN_PROC_BROWSER_TEST_F(TabGroupsMoveAndroidLifecycleTest,
+                       TargetRetirementCallbackCanShutdownOwningContext) {
+  ExtensionFunction::EnsureShutdownNotifierFactoryBuilt();
+  struct CallbackState {
+    std::unique_ptr<TestingProfile> profile = std::make_unique<TestingProfile>();
+    std::shared_ptr<bool> destroyed = std::make_shared<bool>(false);
+    int callback_count = 0;
+  };
+  auto state = std::make_shared<CallbackState>();
+  auto dispatcher =
+      std::make_unique<ExtensionFunctionDispatcher>(state->profile.get());
+  BrowserWindowInterface* target_browser =
+      CreateBrowserWindowWithType(BrowserWindowInterface::TYPE_NORMAL);
+  target_browser->GetWindow()->Activate();
+  TabModel* model = TabModelList::FindTabModelWithWindowSessionId(
+      target_browser->GetSessionID());
+  ASSERT_TRUE(model);
+  auto function =
+      base::MakeRefCounted<DestructionObservedTabGroupsMoveFunction>(
+          state->destroyed);
+  function->SetDispatcher(dispatcher->AsWeakPtr());
+  function->set_has_callback(true);
+  function->set_response_callback(base::BindLambdaForTesting(
+      [state](ExtensionFunction::ResponseType response, base::ListValue,
+              const std::string& error, mojom::ExtraResponseDataPtr) {
+        ++state->callback_count;
+        EXPECT_EQ(ExtensionFunction::ResponseType::kFailed, response);
+        EXPECT_EQ("Failed to move group.", error);
+        EXPECT_FALSE(*state->destroyed);
+        state->profile.reset();
+        // The terminal token and callback keeper still protect the function.
+        EXPECT_FALSE(*state->destroyed);
+      }));
+  ArmPendingMove(function.get(), model, CreateTabGroup({2, 3, 4}));
+  dispatcher.reset();
+  function.reset();
+  EXPECT_FALSE(*state->destroyed);
+  target_browser->GetWindow()->Close();
+  ASSERT_TRUE(base::test::RunUntil([&] { return *state->destroyed; }));
+  EXPECT_EQ(1, state->callback_count);
+  EXPECT_FALSE(state->profile);
+}
