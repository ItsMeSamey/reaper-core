+// These private arm-helper cases isolate real context-shutdown ownership. The
+// observed browser model belongs to the normal test profile, so they bypass
+// MoveGroup's same-profile eligibility checks and do not prove a full launch.
+class TabGroupsMoveAndroidLifecycleTest : public TabGroupsApiBrowserTest {
+ protected:
+  void ArmPendingMove(TabGroupsMoveFunction* function,
+                      TabModel* model,
+                      TabGroupId group) {
+    function->BeginPendingMove(model, group);
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(TabGroupsMoveAndroidLifecycleTest,
+                       OwningContextShutdownRetiresArmedMove) {
+  TabModel* model = TabModelList::FindTabModelWithWindowSessionId(
+      browser_window_interface()->GetSessionID());
+  ASSERT_TRUE(model);
+  const TabGroupId group = CreateTabGroup({2, 3, 4});
+  ExtensionFunction::EnsureShutdownNotifierFactoryBuilt();
+  auto private_profile = std::make_unique<TestingProfile>();
+  auto dispatcher =
+      std::make_unique<ExtensionFunctionDispatcher>(private_profile.get());
+  auto destroyed = std::make_shared<bool>(false);
+  auto function =
+      base::MakeRefCounted<DestructionObservedTabGroupsMoveFunction>(destroyed);
+  function->SetDispatcher(dispatcher->AsWeakPtr());
+  api_test_utils::SendResponseHelper response(function.get());
+  ArmPendingMove(function.get(), model, group);
+  EXPECT_FALSE(function->HasOneRef());
+
+  // SetDispatcher installed the genuine owning-context shutdown subscription.
+  // Destroy the dispatcher first so it retains no dangling profile pointer.
+  dispatcher.reset();
+  private_profile.reset();
+  EXPECT_EQ(nullptr, function->browser_context());
+  EXPECT_TRUE(function->HasOneRef());
+  EXPECT_FALSE(response.has_response());
+  CreateTabGroup({0});
+  EXPECT_TRUE(function->HasOneRef());
+  EXPECT_FALSE(response.has_response());
+  function.reset();
+  EXPECT_TRUE(*destroyed);
+}
