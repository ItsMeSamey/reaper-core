+IN_PROC_BROWSER_TEST_F(TabGroupsApiBrowserTest,
+                       AndroidRejectedCrossWindowMoveBalancesArmedReference) {
+  ASSERT_TRUE(SupportsTabGroups());
+  auto extension = ExtensionBuilder("MV3 rejected tabGroups move")
+                       .SetManifestVersion(3)
+                       .AddAPIPermission("tabGroups")
+                       .Build();
+  const TabGroupId group = CreateTabGroup({2, 3, 4});
+  BrowserWindowInterface* target_browser =
+      CreateBrowserWindowWithType(BrowserWindowInterface::TYPE_NORMAL);
+  target_browser->GetWindow()->Activate();
+  TabListInterface* target_tabs = TabListInterface::From(target_browser);
+  ASSERT_TRUE(target_tabs);
+  ASSERT_TRUE(target_tabs->OpenTab(GURL("about:blank"), 1));
+  ASSERT_TRUE(target_tabs->OpenTab(GURL("about:blank"), 2));
+  ASSERT_TRUE(target_tabs->CreateTabGroup(
+      {target_tabs->GetTab(0)->GetHandle(), target_tabs->GetTab(1)->GetHandle()}));
+
+  auto function = base::MakeRefCounted<TabGroupsMoveFunction>();
+  function->set_extension(extension);
+  const std::string args = base::StringPrintf(
+      R"([%d, {"windowId": %d, "index": 1}])",
+      ExtensionTabUtil::GetGroupId(group),
+      ExtensionTabUtil::GetWindowId(target_browser));
+  EXPECT_EQ(
+      "Cannot move the group to an index that is in the middle of another group.",
+      api_test_utils::RunFunctionAndReturnError(function, args, profile()));
+  EXPECT_TRUE(function->HasOneRef());
+  // Immediate rejection has removed the observer, so a real subsequent group
+  // creation cannot deliver a second response or reacquire the move token.
+  EXPECT_TRUE(
+      target_tabs->CreateTabGroup({target_tabs->GetTab(2)->GetHandle()}));
+  EXPECT_TRUE(function->HasOneRef());
+  for (tabs::TabInterface* tab : target_tabs->GetAllTabs()) {
+    tab->Close();
+  }
+}
