+// Track only destruction, without retaining the function through its callback.
+class DestructionObservedTabGroupsMoveFunction : public TabGroupsMoveFunction {
+ public:
+  explicit DestructionObservedTabGroupsMoveFunction(
+      std::shared_ptr<bool> destroyed)
+      : destroyed_(std::move(destroyed)) {}
+
+ protected:
+  ~DestructionObservedTabGroupsMoveFunction() override { *destroyed_ = true; }
+
+ private:
+  const std::shared_ptr<bool> destroyed_;
+};
+
+IN_PROC_BROWSER_TEST_F(TabGroupsApiBrowserTest,
+                       AndroidPendingMoveRetiresWhenTargetWindowCloses) {
+  ASSERT_TRUE(SupportsTabGroups());
+  auto extension = ExtensionBuilder("MV3 pending tabGroups move")
+                       .SetManifestVersion(3)
+                       .AddAPIPermission("tabGroups")
+                       .Build();
+  const TabGroupId group = CreateTabGroup({2, 3, 4});
+  BrowserWindowInterface* target_browser =
+      CreateBrowserWindowWithType(BrowserWindowInterface::TYPE_NORMAL);
+  ASSERT_TRUE(ExtensionTabUtil::SupportsTabGroups(target_browser));
+  target_browser->GetWindow()->Activate();
+
+  auto destroyed = std::make_shared<bool>(false);
+  auto function =
+      base::MakeRefCounted<DestructionObservedTabGroupsMoveFunction>(destroyed);
+  function->set_extension(extension);
+  auto dispatcher = std::make_unique<ExtensionFunctionDispatcher>(profile());
+  function->SetDispatcher(dispatcher->AsWeakPtr());
+  function->SetArgs(base::ListValue()
+                        .Append(ExtensionTabUtil::GetGroupId(group))
+                        .Append(base::DictValue()
+                                    .Set("windowId", ExtensionTabUtil::GetWindowId(
+                                                         target_browser))
+                                    .Set("index", 1)));
+  api_test_utils::SendResponseHelper response(function.get());
+  function->RunWithValidation().Execute();
+  // This normal cross-window path defers delivery through the persistent store.
+  EXPECT_FALSE(function->did_respond());
+  EXPECT_FALSE(function->HasOneRef());
+  function.reset();
+  EXPECT_FALSE(*destroyed);
+
+  // Request normal window closure before pumping the queued reparenting work.
+  // No model-destruction or API-completion callback is fabricated.
+  target_browser->GetWindow()->Close();
+  response.WaitForResponse();
+  EXPECT_FALSE(response.GetResponse());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(*destroyed);
+}
