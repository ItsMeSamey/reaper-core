+                test_instance.extras = gtest_test_instance.GetTestDataRootExtras(name)
+                delegate = local_device_gtest_run._ApkDelegate(test_instance, mock.Mock())
+                self.assertEqual(expected, delegate.GetTestDataRoot(device))
 
