+# Stage only selected resources; keep excluded or retired files out of the
+# strict resource directory scan without changing validation.
+_omnibox_resource_directories = []
+_omnibox_resource_sources = []
+_omnibox_resource_copy_deps = []
+foreach(_source, _omnibox_resource_spec.sources) {
+  _directory = get_path_info(_source, "dir")
+  if (filter_include(_omnibox_resource_directories, [ _directory ]) == []) {
+    _omnibox_resource_directories += [ _directory ]
+  }
+  _root = "$target_gen_dir/omnibox_resources_selected/" +
+          string_replace(_directory, "/", "_")
+  _qualifier = get_path_info(_directory, "file")
+  _file = get_path_info(_source, "file")
+  _omnibox_resource_sources += [ "$_root/$_qualifier/$_file" ]
+}
+foreach(_directory, _omnibox_resource_directories) {
+  _qualifier = get_path_info(_directory, "file")
+  _copy_target = "copy_selected_omnibox_$_qualifier"
+  copy_ex(_copy_target) {
+    sources = filter_include(_omnibox_resource_spec.sources, [ "$_directory/*" ])
+    _root = "$target_gen_dir/omnibox_resources_selected/" +
+            string_replace(_directory, "/", "_")
+    dest = "$_root/$_qualifier"
+    outputs = process_file_template(sources, [ "$dest/{{source_file_part}}" ])
+    args = [ "--clear" ]
+  }
+  _omnibox_resource_copy_deps += [ ":$_copy_target" ]
+}
