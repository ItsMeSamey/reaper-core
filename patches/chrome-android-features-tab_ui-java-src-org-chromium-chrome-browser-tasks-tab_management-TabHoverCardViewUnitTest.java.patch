     @Test
+    public void show_UnsupportedProductAlertsRetainOrdinaryCard() {
+        var url = JUnitTestGURLs.EXAMPLE_URL;
+        when(mHoveredTab.getTitle()).thenReturn("Ordinary tab");
+        when(mHoveredTab.getUrl()).thenReturn(url);
+        when(mHoveredTab.getId()).thenReturn(1);
+        when(mHoveredTab.getAlertState()).thenReturn(TabAlert.TAB_CAPTURING);
+        mTabHoverCardView.show(mHoveredTab, 10f, 20f);
+        verify(mHoveredTab).addObserver(mTabObserverCaptor.capture());
+        TabObserver observer = mTabObserverCaptor.getValue();
+        assertEquals(View.VISIBLE, mAlertStatusView.getVisibility());
+        for (int unsupported : new int[] {TabAlert.GLIC_SHARING, TabAlert.GLIC_ACCESSING}) {
+            observer.onAlertStateChanged(mHoveredTab, unsupported);
+            assertEquals(View.GONE, mAlertStatusView.getVisibility());
+            assertEquals("Ordinary tab", mTitleView.getText().toString());
+            assertTrue(mTabHoverCardView.isShowingForTesting());
+        }
+        observer.onAlertStateChanged(mHoveredTab, TabAlert.AUDIO_PLAYING);
+        assertEquals(View.VISIBLE, mAlertStatusView.getVisibility());
+        assertEquals(
+                mContext.getString(R.string.tooltip_tab_alert_state_audio_playing),
+                mAlertStatusView.getText().toString());
+        mTabHoverCardView.hide();
+        verify(mHoveredTab).removeObserver(observer);
+    }
