+// Keep the production mapper under test, but use ordinary temporary JSON files
+// for index I/O. A DocumentsProvider and picker consent remain device coverage.
+class FileBackedRulesetSourceAndroidSafCacheTest : public FileSequenceHelperTest {
+ protected:
+  void SetUp() override {
+    FileSequenceHelperTest::SetUp();
+    ASSERT_TRUE(directory_.CreateUniqueTempDir());
+  }
+
+  FileBackedRulesetSource Source(std::string_view filename = "rules.json",
+                                int ruleset_id = 1) {
+    return FileBackedRulesetSource(
+        directory_.GetPath().AppendASCII(filename),
+        directory_.GetPath().AppendASCII("cache").AppendASCII(
+            base::NumberToString(ruleset_id)),
+        RulesetID(ruleset_id), GetMaximumRulesPerRuleset(),
+        GenerateDummyExtensionID(), true, true);
+  }
+
+  FileBackedRulesetSource SourceInProfileCache(std::string_view filename,
+                                             int ruleset_id) {
+    return FileBackedRulesetSource(
+        directory_.GetPath().AppendASCII(filename),
+        FileBackedRulesetSource::GetSafStaticRulesCacheDirectory(
+            directory_.GetPath(), GenerateDummyExtensionID())
+            .AppendASCII("test-source")
+            .AppendASCII(base::NumberToString(ruleset_id)),
+        RulesetID(ruleset_id), GetMaximumRulesPerRuleset(),
+        GenerateDummyExtensionID(), true, true);
+  }
+
+  void WriteRules(const FileBackedRulesetSource& source,
+                  std::string_view filter) {
+    const std::string json = base::StrCat(
+        {R"([{"id":1,"priority":1,"action":{"type":"block"},"condition":{"urlFilter":")",
+         filter, R"(","resourceTypes":["xmlhttprequest"]}}])"});
+    ASSERT_TRUE(base::WriteFile(source.json_path(), json));
+  }
+
+  IndexAndPersistJSONRulesetResult Index(
+      const FileBackedRulesetSource& source) {
+    return source.IndexAndPersistJSONRuleset(
+        RulesetSource::kRaiseErrorOnInvalidRules);
+  }
+
+  std::string Read(const base::FilePath& path) {
+    std::string data;
+    EXPECT_TRUE(base::ReadFileToString(path, &data));
+    return data;
+  }
+
+  void CheckMonitorCancellation(bool prefs_only) {
+    auto monitor = RulesMonitorService::CreateInstanceForTesting(browser_context());
+    const ExtensionId id = GenerateDummyExtensionID();
+    const auto root = FileBackedRulesetSource::GetSafStaticRulesCacheDirectory(
+        browser_context()->GetPath(), id);
+    auto make_source = [&](const char* name, int rule_id) {
+      return FileBackedRulesetSource(
+          directory_.GetPath().AppendASCII(name),
+          root.AppendASCII("test-source").AppendASCII(base::NumberToString(rule_id)),
+          RulesetID(rule_id), GetMaximumRulesPerRuleset(), id, true, true);
+    };
+    auto first = make_source("monitor-first.json", 1);
+    auto second = make_source("monitor-second.json", 2);
+    WriteRules(first, "first.example");
+    WriteRules(second, "second.example");
+    auto initial_first = Index(first);
+    auto initial_second = Index(second);
+    ASSERT_EQ(IndexAndPersistJSONRulesetResult::Status::kSuccess, initial_first.status);
+    ASSERT_EQ(IndexAndPersistJSONRulesetResult::Status::kSuccess, initial_second.status);
+    ASSERT_TRUE(base::DeletePathRecursively(root));
+    auto extension = ExtensionBuilder("pending SAF cache")
+                         .SetID(id)
+                         .SetManifestKey("permissions", base::ListValue().Append(
+                                                            "declarativeNetRequest"))
+                         .Build();
+    ASSERT_TRUE(extension);
+    auto make_data = [&] {
+      LoadRequestData data(id, base::Version("1.0"),
+                           LoadRulesetRequestSource::kOnExtensionLoad);
+      data.rulesets.emplace_back(first.Clone());
+      data.rulesets.back().set_expected_checksum(initial_first.ruleset_checksum);
+      data.rulesets.emplace_back(second.Clone());
+      data.rulesets.back().set_expected_checksum(initial_second.ruleset_checksum);
+      return data;
+    };
+    base::RunLoop done;
+    auto callbacks = base::BarrierClosure(2, done.QuitClosure());
+    auto slice = FileSequenceHelper::SetIndexingTimeSliceForTesting(base::TimeDelta());
+    base::WaitableEvent release_file_tasks;
+    GetExtensionFileTaskRunner()->PostTask(FROM_HERE, base::BindOnce(
+        [](base::WaitableEvent* release) {
+          base::ScopedAllowBaseSyncPrimitivesForTesting allow_wait;
+          release->Wait();
+        }, &release_file_tasks));
+    // The real bridge creates the flag. Do not manually populate it here.
+    monitor->LoadRulesetsForTesting(make_data(), base::BindOnce(
+        [](base::RepeatingClosure callbacks, LoadRequestData data) {
+          EXPECT_TRUE(data.load_request_id.is_zero());
+          EXPECT_TRUE(data.saf_cache_cancelled);
+          if (data.saf_cache_cancelled) {
+            EXPECT_TRUE(data.saf_cache_cancelled->data.IsSet());
+          }
+          EXPECT_FALSE(data.rulesets[0].did_load_successfully());
+          EXPECT_FALSE(data.rulesets[1].did_load_successfully());
+          callbacks.Run();
+        }, callbacks));
+    if (prefs_only) {
+      monitor->OnExtensionPrefsDeleted(id);
+    } else {
+      monitor->OnExtensionUnloaded(browser_context(), extension.get(),
+                                   UnloadedExtensionReason::DISABLE);
+    }
+    // Same ID, new request: the old flag/token cannot invalidate this load.
+    monitor->LoadRulesetsForTesting(make_data(), base::BindOnce(
+        [](base::RepeatingClosure callbacks, int first_checksum,
+           int second_checksum, LoadRequestData data) {
+          EXPECT_FALSE(data.load_request_id.is_zero());
+          EXPECT_TRUE(data.saf_cache_cancelled);
+          if (data.saf_cache_cancelled) {
+            EXPECT_FALSE(data.saf_cache_cancelled->data.IsSet());
+          }
+          EXPECT_TRUE(data.rulesets[0].did_load_successfully());
+          EXPECT_TRUE(data.rulesets[1].did_load_successfully());
+          EXPECT_EQ(first_checksum, data.rulesets[0].expected_checksum());
+          EXPECT_EQ(second_checksum, data.rulesets[1].expected_checksum());
+          EXPECT_FALSE(data.rulesets[0].new_checksum().has_value());
+          EXPECT_FALSE(data.rulesets[1].new_checksum().has_value());
+          callbacks.Run();
+        }, callbacks, initial_first.ruleset_checksum, initial_second.ruleset_checksum));
+    release_file_tasks.Signal();
+    // Bridge callbacks still settle with zeroed stale tokens; neither is dropped.
+    // Every asynchronous path above uses EXPECT and unconditionally runs its barrier.
+    done.Run();
+    EXPECT_TRUE(base::PathExists(first.IndexedPathForChecksum(initial_first.ruleset_checksum)));
+    EXPECT_TRUE(base::PathExists(second.IndexedPathForChecksum(initial_second.ruleset_checksum)));
+    EXPECT_TRUE(base::PathExists(first.json_path()));
+    EXPECT_TRUE(base::PathExists(second.json_path()));
+  }
+
+  base::ScopedTempDir directory_;
+};
