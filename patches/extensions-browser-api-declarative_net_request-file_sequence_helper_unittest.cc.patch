+TEST_F(FileBackedRulesetSourceAndroidSafCacheTest,
+       MapperKeepsOriginalSourceAndSeparatesProfilesAndTrees) {
+  auto extension = ExtensionBuilder("SAF cache")
+                       .SetPath(base::FilePath("/SAF/provider/tree/first"))
+                       .SetLocation(mojom::ManifestLocation::kUnpacked)
+                       .Build();
+  DNRManifestData::RulesetInfo info;
+  info.id = RulesetID(1);
+  info.relative_path = base::FilePath("rules.json");
+  info.enabled = true;
+  const auto original_path = extension->path();
+  const auto original_id = extension->id();
+  const auto profile = directory_.GetPath().AppendASCII("profile");
+  auto source = FileBackedRulesetSource::CreateStatic(*extension, info, profile);
+  auto other_profile = FileBackedRulesetSource::CreateStatic(
+      *extension, info, directory_.GetPath().AppendASCII("other"));
+  auto other_extension = ExtensionBuilder("SAF cache")
+                             .SetPath(base::FilePath("/SAF/provider/tree/second"))
+                             .SetLocation(mojom::ManifestLocation::kUnpacked)
+                             .Build();
+  auto other_tree =
+      FileBackedRulesetSource::CreateStatic(*other_extension, info, profile);
+  EXPECT_EQ(original_path.Append(info.relative_path), source.json_path());
+  EXPECT_EQ(original_id, source.extension_id());
+  EXPECT_EQ(original_path, extension->path());
+  EXPECT_TRUE(profile.IsParent(source.IndexedPathForChecksum(17)));
+  EXPECT_NE(source.IndexedPathForChecksum(17),
+            other_profile.IndexedPathForChecksum(17));
+  EXPECT_NE(source.IndexedPathForChecksum(17),
+            other_tree.IndexedPathForChecksum(17));
+  EXPECT_NE(source.IndexedPathForChecksum(17), source.IndexedPathForChecksum(18));
+  EXPECT_EQ(source.IndexedPathForChecksum(17),
+            source.Clone().IndexedPathForChecksum(17));
+}
