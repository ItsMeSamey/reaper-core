+TEST_F(FileBackedRulesetSourceAndroidSafCacheTest,
+       CancelledSliceCannotRecreateCacheAndNewRequestStillLoads) {
+  auto first = SourceInProfileCache("first.json", 1);
+  auto second = SourceInProfileCache("second.json", 2);
+  WriteRules(first, "first.example");
+  WriteRules(second, "second.example");
+  const auto root = FileBackedRulesetSource::GetSafStaticRulesCacheDirectory(
+      directory_.GetPath(), GenerateDummyExtensionID());
+  auto cancelled =
+      base::MakeRefCounted<base::RefCountedData<base::AtomicFlag>>();
+  auto current =
+      base::MakeRefCounted<base::RefCountedData<base::AtomicFlag>>();
+  auto helper = std::make_unique<FileSequenceHelper>();
+  auto time_slice =
+      FileSequenceHelper::SetIndexingTimeSliceForTesting(base::TimeDelta());
+  base::RunLoop done;
+  auto callbacks = base::BarrierClosure(2, done.QuitClosure());
+  LoadRequestData old_data(GenerateDummyExtensionID(), base::Version("1.0"),
+                           LoadRulesetRequestSource::kOnExtensionLoad);
+  old_data.saf_cache_cancelled = cancelled;
+  old_data.rulesets.emplace_back(first.Clone());
+  old_data.rulesets.emplace_back(second.Clone());
+  LoadRequestData new_data(GenerateDummyExtensionID(), base::Version("1.0"),
+                           LoadRulesetRequestSource::kOnExtensionLoad);
+  new_data.saf_cache_cancelled = current;
+  new_data.rulesets.emplace_back(first.Clone());
+  new_data.rulesets.emplace_back(second.Clone());
+  auto runner = GetExtensionFileTaskRunner();
+  // One outer task queues cleanup before starting the old request. Its first
+  // zero-budget slice must queue the continuation behind that cleanup.
+  runner->PostTask(FROM_HERE, base::BindOnce(
+      [](FileSequenceHelper* helper, base::FilePath root,
+         scoped_refptr<base::RefCountedData<base::AtomicFlag>> cancelled,
+         scoped_refptr<base::RefCountedData<base::AtomicFlag>> current,
+         base::RepeatingClosure callbacks, LoadRequestData old_data,
+         LoadRequestData new_data) {
+        GetExtensionFileTaskRunner()->PostTask(FROM_HERE, base::BindOnce(
+            [](FileSequenceHelper* helper, base::FilePath root,
+               scoped_refptr<base::RefCountedData<base::AtomicFlag>> cancelled,
+               scoped_refptr<base::RefCountedData<base::AtomicFlag>> current,
+               base::RepeatingClosure callbacks, LoadRequestData new_data) {
+              base::WaitableEvent flag_set;
+              content::GetUIThreadTaskRunner({base::TaskPriority::USER_BLOCKING})
+                  ->PostTask(FROM_HERE, base::BindOnce(
+                      [](scoped_refptr<base::RefCountedData<base::AtomicFlag>> flag,
+                         base::WaitableEvent* ready) {
+                        flag->data.Set();
+                        ready->Signal();
+                      }, cancelled, &flag_set));
+              { base::ScopedAllowBaseSyncPrimitivesForTesting allow_wait;
+                flag_set.Wait(); }
+              EXPECT_TRUE(base::PathExists(root));
+              EXPECT_TRUE(base::DeletePathRecursively(root));
+              EXPECT_FALSE(base::PathExists(root));
+              EXPECT_FALSE(current->data.IsSet());
+              helper->LoadRulesets(std::move(new_data), base::BindOnce(
+                  [](base::RepeatingClosure callbacks, LoadRequestData data) {
+                    EXPECT_TRUE(data.rulesets[0].did_load_successfully());
+                    EXPECT_TRUE(data.rulesets[1].did_load_successfully());
+                    EXPECT_FALSE(data.saf_cache_cancelled->data.IsSet());
+                    callbacks.Run();
+                  }, callbacks));
+            }, helper, root, cancelled, current, callbacks, std::move(new_data)));
+        helper->LoadRulesets(std::move(old_data), base::BindOnce(
+            [](base::RepeatingClosure callbacks, LoadRequestData data) {
+              EXPECT_TRUE(data.rulesets[0].did_load_successfully());
+              EXPECT_FALSE(data.rulesets[1].load_ruleset_result().has_value());
+              EXPECT_TRUE(data.saf_cache_cancelled->data.IsSet());
+              callbacks.Run();
+            }, callbacks));
+      }, base::Unretained(helper.get()), root, cancelled, current, callbacks,
+      std::move(old_data), std::move(new_data)));
+  done.Run();
+  EXPECT_TRUE(base::PathExists(root));
+  EXPECT_TRUE(base::PathExists(first.json_path()));
+  EXPECT_TRUE(base::PathExists(second.json_path()));
+  runner->DeleteSoon(FROM_HERE, std::move(helper));
+}
