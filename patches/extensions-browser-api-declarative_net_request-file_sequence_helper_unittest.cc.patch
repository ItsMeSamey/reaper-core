+TEST_F(FileBackedRulesetSourceAndroidSafCacheTest,
+       OversizedGeneratedIndexReindexesWithinExistingSmallLimit) {
+  constexpr size_t kLimit = 12 * 1024;
+  auto source = Source();
+  WriteRules(source, "valid");
+  auto result = Index(source);
+  ASSERT_EQ(IndexAndPersistJSONRulesetResult::Status::kSuccess, result.status);
+  const auto path = source.IndexedPathForChecksum(result.ruleset_checksum);
+  const auto original = Read(path);
+  const auto source_json = Read(source.json_path());
+  ASSERT_LT(original.size(), kLimit);
+  ASSERT_LT(source_json.size(), kLimit);
+  auto limit = CreateScopedMaxRulesetSizeOverrideForTesting(kLimit);
+  ASSERT_TRUE(base::WriteFile(path, std::string(kLimit + 1, 'x')));
+  std::unique_ptr<RulesetMatcher> matcher;
+  EXPECT_EQ(LoadRulesetResult::kErrorRulesetFileSizeLimitExceeded,
+            source.CreateVerifiedMatcher(result.ruleset_checksum, &matcher));
+  std::vector<TestCase> cases;
+  cases.emplace_back(source.Clone());
+  cases.back().checksum = result.ruleset_checksum;
+  cases.back().expected_result.has_new_checksum = false;
+  cases.back().expected_result.load_result = LoadRulesetResult::kSuccess;
+  TestLoadRulesets(cases);
+  EXPECT_EQ(original, Read(path));
+  EXPECT_EQ(source_json, Read(source.json_path()));
+}
