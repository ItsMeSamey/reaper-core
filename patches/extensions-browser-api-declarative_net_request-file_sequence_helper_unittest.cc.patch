+TEST_F(FileBackedRulesetSourceAndroidSafCacheTest,
+       FailedLaterRulesetKeepsPreviouslyInstalledIndexAndPrefs) {
+  auto source = Source();
+  WriteRules(source, "previous");
+  auto old_result = Index(source);
+  ASSERT_EQ(IndexAndPersistJSONRulesetResult::Status::kSuccess,
+            old_result.status);
+  const int old_checksum = old_result.ruleset_checksum;
+  const auto old_path = source.IndexedPathForChecksum(old_checksum);
+  const auto old_bytes = Read(old_path);
+  PrefsHelper prefs(*ExtensionPrefs::Get(browser_context()));
+  prefs.SetStaticRulesetChecksum(source.extension_id(), source.id(), old_checksum);
+
+  WriteRules(source, "candidate");
+  auto candidate = Index(source);
+  ASSERT_EQ(IndexAndPersistJSONRulesetResult::Status::kSuccess, candidate.status);
+  ASSERT_NE(old_checksum, candidate.ruleset_checksum);
+  auto later = Source("later.json", 2);
+  ASSERT_TRUE(base::WriteFile(later.json_path(), "{invalid"));
+  EXPECT_EQ(IndexAndPersistJSONRulesetResult::Status::kError, Index(later).status);
+
+  // Install prefs are committed only by the installer after every ruleset and
+  // policy check succeeds. Indexing a rejected candidate must not change them.
+  int stored_checksum = -1;
+  ASSERT_TRUE(prefs.GetStaticRulesetChecksum(source.extension_id(), source.id(),
+                                           stored_checksum));
+  EXPECT_EQ(old_checksum, stored_checksum);
+  EXPECT_EQ(old_bytes, Read(old_path));
+  std::unique_ptr<RulesetMatcher> matcher;
+  EXPECT_EQ(LoadRulesetResult::kSuccess,
+            source.CreateVerifiedMatcher(old_checksum, &matcher));
+  WriteRules(later, "corrected");
+  EXPECT_EQ(IndexAndPersistJSONRulesetResult::Status::kSuccess, Index(later).status);
+  EXPECT_EQ(old_bytes, Read(old_path));
+}
