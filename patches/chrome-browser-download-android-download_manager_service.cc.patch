+// static
+bool DownloadManagerService::ShowDownloadsForExtension(
+    const JavaRef<jobject>& tab) {
+  return Java_DownloadManagerService_showDownloadsForExtension(
+      base::android::AttachCurrentThread(), tab);
+}
+
+// static
+bool DownloadManagerService::CanShowDownloadItemForExtension(
+    const JavaRef<jobject>& tab,
+    Profile* item_profile) {
+  return !tab.is_null() && item_profile && !item_profile->ShutdownStarted() &&
+         Java_DownloadManagerService_canShowDownloadItemForExtension(
+             base::android::AttachCurrentThread(), tab,
+             item_profile->GetJavaObject());
+}
+
+// static
+int64_t DownloadManagerService::ShowDownloadItemForExtension(
+    const JavaRef<jobject>& tab,
+    download::DownloadItem* item,
+    base::OnceCallback<void(bool)> callback) {
+  content::BrowserContext* context =
+      item ? content::DownloadItemUtils::GetBrowserContext(item) : nullptr;
+  Profile* item_profile =
+      context ? Profile::FromBrowserContext(context) : nullptr;
+  if (!item || item->GetGuid().empty() ||
+      !CanShowDownloadItemForExtension(tab, item_profile)) {
+    std::move(callback).Run(false);
+    return 0;
+  }
+  if (g_download_item_reveal_callbacks_for_testing) {
+    return g_download_item_reveal_callbacks_for_testing->show.Run(
+        item, std::move(callback));
+  }
+  const auto id = OfflineItemUtils::GetContentIdForDownload(item);
+  return Java_DownloadManagerService_showDownloadItemForExtension(
+      base::android::AttachCurrentThread(), tab, item_profile->GetJavaObject(),
+      id.name_space, id.id, std::move(callback));
+}
+
+// static
+void DownloadManagerService::CancelDownloadItemForExtension(int64_t token) {
+  if (token && g_download_item_reveal_callbacks_for_testing) {
+    g_download_item_reveal_callbacks_for_testing->cancel.Run(token);
+    return;
+  }
+  if (token) {
+    Java_DownloadManagerService_cancelDownloadItemForExtension(
+        base::android::AttachCurrentThread(), token);
+  }
+}
+
+// static
+base::AutoReset<
+    const DownloadManagerService::DownloadItemRevealCallbacksForTesting*>
+DownloadManagerService::SetDownloadItemRevealCallbacksForTesting(
+    const DownloadItemRevealCallbacksForTesting* callbacks) {
+  CHECK_IS_TEST();
+  return base::AutoReset<const DownloadItemRevealCallbacksForTesting*>(
+      &g_download_item_reveal_callbacks_for_testing, callbacks);
+}
+
+static bool JNI_DownloadManagerService_ShouldSuppressDownloadUi(
+    JNIEnv* env,
+    Profile* profile) {
+  if (!profile) {
+    return true;
+  }
+  DownloadCoreService* service =
+      DownloadCoreServiceFactory::GetForBrowserContext(profile);
+  return service && !service->IsDownloadUiEnabled();
+}
