+    @Test
+    public void testContainerMetadataPreservesDefaultNamedTemporaryAndUnknownIds() throws Exception {
+        File file = mTemporaryFolder.newFile("tab_state_containers");
+        TabModelMetadata normal = new TabModelMetadata(1);
+        String named = "4a4d13b6-c971-4c61-ae11-e7a864f58165";
+        List<String> expected = new ArrayList<>(List.of("", named, "t-" + named));
+        expected.add(null);
+        for (String id : expected) {
+            normal.ids.add(100 + normal.ids.size());
+            normal.urls.add("https://same.example/");
+            normal.containerIds.add(id);
+        }
+        TabMetadataFileManager.saveListToFile(file,
+                new TabModelSelectorMetadata(normal, new TabModelMetadata(-1)));
+        List<String> ids = new ArrayList<>();
+        try (DataInputStream stream = new DataInputStream(new FileInputStream(file))) {
+            TabMetadataFileManager.readSavedMetadataFile(stream, new OnTabStateReadCallback() {
+                @Override
+                public void onDetailsRead(int index, int id, String url,
+                        int incognito, boolean normalActive, boolean otrActive) {}
+                @Override
+                public void onDetailsReadWithContainer(int index, int id, String url,
+                        int incognito, boolean normalActive, boolean otrActive,
+                        String containerId) {
+                    ids.add(containerId);
+                    assertEquals("https://same.example/", url);
+                }
+            }, null);
+        }
+        assertEquals(expected, ids);
+        assertNull(ids.get(3));
+    }
