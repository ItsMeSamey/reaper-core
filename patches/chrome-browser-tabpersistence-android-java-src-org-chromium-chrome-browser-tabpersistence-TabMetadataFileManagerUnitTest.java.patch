+    @Test
+    public void testReadVersionSixContainerMetadata() throws Exception {
+        String named = "4a4d13b6-c971-4c61-ae11-e7a864f58165";
+        List<String> expected = List.of("", named, "t-" + named);
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        DataOutputStream out = new DataOutputStream(bytes);
+        out.writeInt(6);
+        out.writeInt(expected.size());
+        out.writeInt(0);
+        out.writeInt(-1);
+        out.writeInt(0);
+        for (int i = 0; i < expected.size(); i++) {
+            out.writeInt(100 + i);
+            out.writeUTF("https://same.example/");
+            out.writeUTF(expected.get(i));
+        }
+        out.flush();
+
+        List<String> ids = new ArrayList<>();
+        TabMetadataFileManager.readSavedMetadataFile(
+                new DataInputStream(new ByteArrayInputStream(bytes.toByteArray())),
+                new OnTabStateReadCallback() {
+                    @Override
+                    public void onDetailsRead(
+                            int index, int id, String url, int incognito,
+                            boolean normalActive, boolean otrActive) {}
+
+                    @Override
+                    public void onDetailsReadWithContainer(
+                            int index, int id, String url, int incognito,
+                            boolean normalActive, boolean otrActive, String containerId) {
+                        ids.add(containerId);
+                    }
+                },
+                null);
+        assertEquals(expected, ids);
+    }
