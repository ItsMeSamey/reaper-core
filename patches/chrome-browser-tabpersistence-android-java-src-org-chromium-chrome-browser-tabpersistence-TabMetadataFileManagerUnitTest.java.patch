+    @Test
+    public void testContainerSyntaxRejectsNoncanonicalAliases() {
+        String named = "4a4d13b6-c971-4c61-ae11-e7a864f58165";
+        assertTrue(org.chromium.chrome.browser.tab.Tab.isContainerIdWellFormed(""));
+        assertTrue(org.chromium.chrome.browser.tab.Tab.isContainerIdWellFormed(named));
+        assertTrue(org.chromium.chrome.browser.tab.Tab.isContainerIdWellFormed("t-" + named));
+        assertFalse(org.chromium.chrome.browser.tab.Tab.isContainerIdWellFormed(null));
+        assertFalse(org.chromium.chrome.browser.tab.Tab.isContainerIdWellFormed(named.toUpperCase()));
+        assertFalse(org.chromium.chrome.browser.tab.Tab.isContainerIdWellFormed("t-t-" + named));
+        assertFalse(org.chromium.chrome.browser.tab.Tab.isContainerIdWellFormed("1-1-1-1-1"));
+    }
