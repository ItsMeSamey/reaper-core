+    /** Policy changes do not start a download service or create a UI controller. */
+    static void onDownloadUiPolicyChanged() {
+        ThreadUtils.assertOnUiThread();
+        DownloadManagerService service = sDownloadManagerService;
+        if (service == null || service.mMessageUiController == null) return;
+        service.mMessageUiController.onDownloadUiPolicyChanged();
+    }
+
+    /** Match the original-profile aggregator and the item's exact existing OTR profile. */
+    public static boolean shouldSuppressDownloadUi(@Nullable String serializedOtrProfileId) {
+        ThreadUtils.assertOnUiThread();
+        // Extension policy exists only after full profile initialization. Reduced-mode
+        // background downloads must keep their normal notification lifecycle.
+        if (!ProfileManager.isInitialized()) return false;
+        Profile profile = ProfileManager.getLastUsedRegularProfile();
+        if (!profile.isNativeInitialized()) return true;
+        if (serializedOtrProfileId != null) {
+            OtrProfileId otrProfileId =
+                    OtrProfileId.deserializeWithoutVerify(serializedOtrProfileId);
+            if (otrProfileId == null) return true;
+            Profile otrProfile = profile.getOffTheRecordProfile(otrProfileId, false);
+            if (otrProfile == null) return true;
+            profile = otrProfile;
+        }
+        return !profile.isNativeInitialized()
+                || DownloadManagerServiceJni.get().shouldSuppressDownloadUi(profile);
+    }
