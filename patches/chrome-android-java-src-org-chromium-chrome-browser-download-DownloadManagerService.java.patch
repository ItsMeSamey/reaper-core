+    /** Checks an explicit foreground host without creating a request or an OTR profile. */
+    @CalledByNative
+    static boolean canShowDownloadItemForExtension(
+            @Nullable Tab tab, @Nullable Profile itemProfile) {
+        ThreadUtils.assertOnUiThread();
+        return getDownloadItemRevealHost(tab, itemProfile) != null;
+    }
+
+    private static @Nullable Activity getDownloadItemRevealHost(
+            @Nullable Tab tab, @Nullable Profile itemProfile) {
+        if (tab == null || !tab.isInitialized() || tab.isDestroyed() || tab.isClosing()
+                || tab.isHidden() || itemProfile == null || !itemProfile.isNativeInitialized()
+                || itemProfile.shutdownStarted()) {
+            return null;
+        }
+        Profile tabProfile = tab.getProfile();
+        if (!tabProfile.isNativeInitialized() || tabProfile.shutdownStarted()) return null;
+        Profile original = itemProfile.getOriginalProfile();
+        if (!original.isNativeInitialized() || original.shutdownStarted()
+                || tabProfile.getOriginalProfile() != original) {
+            return null;
+        }
+        if (itemProfile.isOffTheRecord()
+                && (!itemProfile.isPrimaryOtrProfile()
+                        || original.getOffTheRecordProfile(
+                                        assumeNonNull(itemProfile.getOtrProfileId()), false)
+                                != itemProfile)) {
+            return null;
+        }
+        WindowAndroid window = tab.getWindowAndroid();
+        Activity host = window == null ? null : window.getActivity().get();
+        if (host == null || host.isFinishing() || host.isDestroyed()
+                || ApplicationStatus.getStateForActivity(host) != ActivityState.RESUMED) {
+            return null;
+        }
+        return host;
+    }
+
+    /** Reveal the exact native-authorized item; acknowledgment comes from the Downloads list. */
+    @CalledByNative
+    static long showDownloadItemForExtension(
+            @Nullable Tab tab,
+            @Nullable Profile itemProfile,
+            @JniType("std::string") String itemNamespace,
+            @JniType("std::string") String guid,
+            @JniType("base::OnceCallback<void(bool)>&&") Callback<Boolean> completion) {
+        ThreadUtils.assertOnUiThread();
+        Activity host = getDownloadItemRevealHost(tab, itemProfile);
+        if (host == null || itemNamespace.isEmpty() || guid.isEmpty()) {
+            completion.onResult(false);
+            return 0;
+        }
+        return DownloadActivityLauncher.getInstance().showDownloadItem(
+                host, assumeNonNull(itemProfile), new ContentId(itemNamespace, guid), completion);
+    }
+
+    @CalledByNative
+    static void cancelDownloadItemForExtension(long token) {
+        ThreadUtils.assertOnUiThread();
+        if (token != 0) DownloadActivityLauncher.getInstance().cancelDownloadItem(token);
+    }
+
+    /** Opens Android's downloads collection in the actual extension window's profile. */
+    @CalledByNative
+    static boolean showDownloadsForExtension(@Nullable Tab tab) {
+        ThreadUtils.assertOnUiThread();
+        if (tab == null || tab.isDestroyed() || tab.isClosing()) return false;
+        WindowAndroid window = tab.getWindowAndroid();
+        Activity activity = window == null ? null : window.getActivity().get();
+        if (activity == null || activity.isFinishing() || activity.isDestroyed()) return false;
+        Profile profile = tab.getProfile();
+        if (profile.shutdownStarted()) return false;
+        try {
+            // Pass the real tab so regular-profile calls cannot inherit an unrelated
+            // last-focused incognito tab. Keep the normal download UI and permissions.
+            return DownloadUtils.showDownloadManager(
+                    activity, tab, profile.getOtrProfileId(), DownloadOpenSource.UNKNOWN);
+        } catch (ActivityNotFoundException | SecurityException exception) {
+            Log.e(TAG, "Cannot open extension downloads collection", exception);
+            return false;
+        }
+    }
