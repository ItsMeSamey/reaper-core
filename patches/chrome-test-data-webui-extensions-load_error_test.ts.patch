+  async function checkAndroidSupersededRetryPreservesNewError() {
+    for (const outcome of ['success', 'failure']) {
+      for (const sameError of [false, true]) {
+        loadError.remove();
+        loadError = document.createElement('extensions-load-error');
+        loadError.delegate = mockDelegate;
+        loadError.loadError = stubLoadError;
+        document.body.appendChild(loadError);
+        await microtasksFinished();
+        loadError.show();
+        const oldRetry = new PromiseResolver<boolean>();
+        mockDelegate.retryLoadUnpacked = () => oldRetry.promise;
+        const retry = loadError.shadowRoot.querySelector<HTMLElement>('.action-button')!;
+        const cancel = loadError.shadowRoot.querySelector<HTMLElement>('.cancel-button')!;
+        retry.focus();
+        retry.click();
+        await microtasksFinished();
+        assertTrue(retry.hasAttribute('disabled'));
+
+        // manager.onLoadError_ reuses the open dialog and calls show() for
+        // each new event, including a repeated presentation of the same Error.
+        const newerError = sameError ? stubLoadError :
+            {...stubLoadError, error: 'Newer failure', retryGuid: 'newer-guid'};
+        loadError.loadError = newerError;
+        loadError.show();
+        await microtasksFinished();
+        assertTrue(retry.hasAttribute('disabled'));
+        cancel.focus();
+        const chosenFocus = getDeepActiveElement();
+        if (outcome === 'success') {
+          oldRetry.resolve(true);
+        } else {
+          oldRetry.reject({...stubLoadError, error: 'Old retry failed'});
+        }
+        await microtasksFinished();
+        assertTrue(loadError.$.dialog.getNative().open);
+        assertEquals(newerError, loadError.loadError);
+        assertEquals(chosenFocus, getDeepActiveElement());
+        assertFalse(retry.hasAttribute('disabled'));
+
+        // A subsequent explicit Retry still delivers the current result.
+        const currentRetry = new PromiseResolver<boolean>();
+        mockDelegate.retryLoadUnpacked = () => currentRetry.promise;
+        retry.click();
+        await microtasksFinished();
+        assertTrue(retry.hasAttribute('disabled'));
+        currentRetry.resolve(true);
+        await microtasksFinished();
+        assertFalse(loadError.$.dialog.getNative().open);
+      }
+    }
+  }
+
+  async function checkAndroidSupersededRetryDuringFocusRender() {
+    for (const startNewRetry of [false, true]) {
+      loadError.remove();
+      loadError = document.createElement('extensions-load-error');
+      loadError.delegate = mockDelegate;
+      loadError.loadError = stubLoadError;
+      document.body.appendChild(loadError);
+      await microtasksFinished();
+      loadError.show();
+      const oldRetry = new PromiseResolver<boolean>();
+      mockDelegate.retryLoadUnpacked = () => oldRetry.promise;
+      const retry = loadError.shadowRoot.querySelector<HTMLElement>('.action-button')!;
+      const cancel = loadError.shadowRoot.querySelector<HTMLElement>('.cancel-button')!;
+      retry.focus();
+      retry.click();
+      await microtasksFinished();
+
+      // Hold only the callback's render await; Lit still performs real updates.
+      const renderGate = new PromiseResolver<boolean>();
+      let awaitedRender = false;
+      Object.defineProperty(loadError, 'updateComplete', {
+        configurable: true,
+        get: () => {
+          awaitedRender = true;
+          return renderGate.promise;
+        },
+      });
+      try {
+        oldRetry.reject({...stubLoadError, error: 'Old retry failed'});
+        await microtasksFinished();
+        assertTrue(awaitedRender);
+        assertFalse(retry.hasAttribute('disabled'));
+        const newerError = {...stubLoadError, error: 'Newer failure'};
+        loadError.loadError = newerError;
+        loadError.show();
+        await microtasksFinished();
+        const currentRetry = new PromiseResolver<boolean>();
+        mockDelegate.retryLoadUnpacked = () => currentRetry.promise;
+        if (startNewRetry) {
+          retry.click();
+          await microtasksFinished();
+          assertTrue(retry.hasAttribute('disabled'));
+          cancel.focus();
+        } else {
+          cancel.focus();
+          cancel.blur();
+          // The old focus condition accepts body; only request ownership may
+          // stop its late continuation from focusing the newer presentation.
+          assertEquals(document.body, getDeepActiveElement());
+        }
+        const chosenFocus = getDeepActiveElement();
+        renderGate.resolve(true);
+        await microtasksFinished();
+        assertTrue(loadError.$.dialog.getNative().open);
+        assertEquals(newerError, loadError.loadError);
+        assertEquals(startNewRetry, retry.hasAttribute('disabled'));
+        assertEquals(chosenFocus, getDeepActiveElement());
+        if (startNewRetry) {
+          currentRetry.resolve(true);
+          await microtasksFinished();
+          assertFalse(loadError.$.dialog.getNative().open);
+        }
+      } finally {
+        Reflect.deleteProperty(loadError, 'updateComplete');
+        renderGate.resolve(true);
+        loadError.close();
+      }
+    }
+  }
