+                        + mToolbarButtonsContainer.getPaddingRight();
+        int controlsWidth = toolbarWidth - getPaddingLeft() - getPaddingRight();
+        if (mToolbarButtonsContainer.getLayoutParams() instanceof MarginLayoutParams margins) {
+            occupiedWidth += margins.leftMargin + margins.rightMargin;
+            controlsWidth -= margins.leftMargin + margins.rightMargin;
+        }
+        if (extensionsContainer.getLayoutParams() instanceof MarginLayoutParams margins) {
+            occupiedWidth += margins.leftMargin + margins.rightMargin;
+        }
+        int controlsWidthSpec =
+                MeasureSpec.makeMeasureSpec(Math.max(0, controlsWidth), MeasureSpec.AT_MOST);
+        int controlsHeightSpec =
+                MeasureSpec.makeMeasureSpec(
+                        mToolbarButtonsContainer.getMeasuredHeight(), MeasureSpec.EXACTLY);
+        for (int i = 0; i < mToolbarButtonsContainer.getChildCount(); i++) {
+            View child = mToolbarButtonsContainer.getChildAt(i);
+            if (child == extensionsContainer || child.getVisibility() == GONE) continue;
+            ViewGroup.LayoutParams params = child.getLayoutParams();
+            int horizontalMargins = 0;
+            int verticalMargins = 0;
+            if (params instanceof MarginLayoutParams margins) {
+                horizontalMargins = margins.leftMargin + margins.rightMargin;
+                verticalMargins = margins.topMargin + margins.bottomMargin;
+            }
+            // The initial bounded pass may clip controls following an oversized extension list.
+            // Measure their own demand without that list's widthUsed. AT_MOST preserves intrinsic
+            // sizing for the Brave toolbar include, whose layout width is MATCH_PARENT.
+            child.measure(
