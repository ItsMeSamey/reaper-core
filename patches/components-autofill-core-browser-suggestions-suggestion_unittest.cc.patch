+#if BUILDFLAG(IS_ANDROID)
+TEST(SuggestionTest, AndroidUnsupportedRowsCannotBecomeSelectableOrAcceptable) {
+  using enum SuggestionType;
+  for (SuggestionType type : {kAtMemoryAiDisclosure,
+                              kAtMemoryFetching,
+                              kAtMemoryGenericError,
+                              kAtMemoryInactivityNudge,
+                              kAtMemoryNoConnection,
+                              kAtMemoryOpenGemini,
+                              kAtMemorySearchAffordance,
+                              kAtMemorySearchResult,
+                              kAtMemorySourceAttribution,
+                              kAutocompleteAtMemoryButton,
+                              kPersonalContextNotice,
+                              kManageEnhancedAutofill,
+                              kMaximizeCreditCardBenefitsEntry,
+                              kManageAutofillAi,
+                              kManageAutofillAiIdentityDocs,
+                              kManageAutofillAiShopping,
+                              kManageAutofillAiTravel,
+                              kFillAutofillAi,
+                              kFetchingAmbientData,
+                              kAutofillAiOtherOrders,
+                              kAutofillAiPrivateInferenceNotice,
+                              kAutofillAiOtherShipments,
+                              kRemoveAutofillAi,
+                              kAutofillAiSourceAttribution}) {
+    for (auto acceptability :
+         {Suggestion::Acceptability::kSelectableAndAcceptable,
+          Suggestion::Acceptability::kSelectableButUnacceptable,
+          Suggestion::Acceptability::kUnselectableAndUnacceptable}) {
+      Suggestion suggestion(type);
+      suggestion.acceptability = acceptability;
+      EXPECT_FALSE(suggestion.IsSelectable());
+      EXPECT_FALSE(suggestion.IsAcceptable());
+    }
+  }
+}
+
+TEST(SuggestionTest,
+     AndroidOrdinaryAddressAndPaymentPayloadCopiesRemainUsable) {
+  const Suggestion::Guid guid("00000000-0000-0000-0000-000000000123");
+  Suggestion address(SuggestionType::kAddressEntry);
+  address.payload = Suggestion::AutofillProfilePayload(guid);
+  Suggestion address_copy = address;
+  EXPECT_EQ(address_copy.GetPayload<Suggestion::AutofillProfilePayload>().guid,
+            guid);
+  EXPECT_TRUE(address_copy.IsSelectable());
+  EXPECT_TRUE(address_copy.IsAcceptable());
+  address_copy.acceptability =
+      Suggestion::Acceptability::kSelectableButUnacceptable;
+  EXPECT_TRUE(address_copy.IsSelectable());
+  EXPECT_FALSE(address_copy.IsAcceptable());
+
+  Suggestion payment(SuggestionType::kCreditCardEntry);
+  payment.payload = Suggestion::PaymentsPayload(u"Ordinary card", true, guid);
+  Suggestion payment_copy = payment;
+  EXPECT_EQ(payment_copy.GetPayload<Suggestion::PaymentsPayload>().guid, guid);
+  EXPECT_TRUE(payment_copy.IsSelectable());
+  EXPECT_TRUE(payment_copy.IsAcceptable());
+}
+#endif  // BUILDFLAG(IS_ANDROID)
+
 }  // namespace autofill
