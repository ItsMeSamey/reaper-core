+    def testSetUp_skipClearDataPreservesEveryInstalledApk(self):
+        device, apks = self._SetUpInstallPolicy(True)
+        self.assertEqual(device.Install.call_count, 3)
+        for apk, call in zip(apks, device.Install.call_args_list):
+            self.assertIs(call.args[0], apk)
+            self.assertIs(call.kwargs.get('reinstall', False), True)
+            self.assertIs(call.kwargs['force_queryable'], False)
+        device.Uninstall.assert_not_called()
+        device.ClearApplicationState.assert_not_called()
+
+    def testSetUp_defaultInstallIsolationUnchanged(self):
+        device, apks = self._SetUpInstallPolicy(False)
+        self.assertEqual(device.Install.call_count, len(apks))
+        for call in device.Install.call_args_list:
+            self.assertIs(call.kwargs.get('reinstall', False), False)
