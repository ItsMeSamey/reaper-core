+    @Test
+    public void testProxyCreateWithoutGmsAndStructuredError() {
+        GmsCoreUtils.setGmsCoreVersionForTesting(0);
+        WebAuthenticationProxyBridge bridge = enableProxy();
+        Authenticator.MakeCredential_Response callback =
+                mock(Authenticator.MakeCredential_Response.class);
+        mAuthenticator.makeCredential(Fido2ApiTestHelper.createDefaultMakeCredentialOptions(), callback);
+        verify(mProxyNatives).makeCredential(eq(1L), any());
+        verify(mFido2CredentialRequestMock, never())
+                .handleMakeCredentialRequest(any(), any(), any(), any(), any());
+        WebAuthnDomExceptionDetails error = new WebAuthnDomExceptionDetails();
+        error.name = "InvalidStateError";
+        error.message = "The remote credential already exists.";
+        java.nio.ByteBuffer serialized = error.serialize();
+        byte[] bytes = new byte[serialized.remaining()];
+        serialized.get(bytes);
+        bridge.onMakeResponse(AuthenticatorStatus.ERROR_WITH_DOM_EXCEPTION_DETAILS, null, bytes);
+        ArgumentCaptor<WebAuthnDomExceptionDetails> returned =
+                ArgumentCaptor.forClass(WebAuthnDomExceptionDetails.class);
+        verify(callback).call(eq(AuthenticatorStatus.ERROR_WITH_DOM_EXCEPTION_DETAILS),
+                any(), returned.capture());
+        assertEquals(error.name, returned.getValue().name);
+        assertEquals(error.message, returned.getValue().message);
+    }
