+    @Test
+    public void testCancelledRequestProviderCannotResolveReplacement() {
+        WebAuthenticationProxyBridge bridge = enableOrdinaryRequestGuard();
+        Authenticator.MakeCredential_Response first =
+                mock(Authenticator.MakeCredential_Response.class);
+        mAuthenticator.makeCredential(
+                Fido2ApiTestHelper.createDefaultMakeCredentialOptions(), first);
+        AuthenticationContextProvider oldContext = capturedContext();
+        WebauthnRequestCallback oldCallback = oldContext.getRequestCallback();
+        ArgumentCaptor<Long> id = ArgumentCaptor.forClass(Long.class);
+        verify(mProxyNatives).startRequestGuard(eq(1L), id.capture(), eq(false));
+        bridge.onRequestInvalidated(id.getValue());
+        verify(first).call(eq(AuthenticatorStatus.ABORT_ERROR), any(), any());
+        assertNull(oldContext.getRequestCallback());
+        Authenticator.MakeCredential_Response replacement =
+                mock(Authenticator.MakeCredential_Response.class);
+        mAuthenticator.makeCredential(
+                Fido2ApiTestHelper.createDefaultMakeCredentialOptions(), replacement);
+        // Old OS work can retain both the provider and the original callback.
+        assertNull(oldContext.getRequestCallback());
+        assertTrue(oldContext.shouldBlockUserInteraction());
+        oldCallback.onComplete(
+                WebauthnRequestResponse.forSuccessfulMakeCredential(
+                        new MakeCredentialAuthenticatorResponse(),
+                        new RequestMetrics.Builder().build()));
+        bridge.onRequestInvalidated(id.getValue());
+        verify(first, times(1)).call(anyInt(), any(), any());
+        verify(replacement, never()).call(anyInt(), any(), any());
+        verify(mProxyNatives, times(2)).startRequestGuard(eq(1L), anyLong(), eq(false));
+    }
