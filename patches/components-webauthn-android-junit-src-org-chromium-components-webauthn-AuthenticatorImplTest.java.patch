+    @Test
+    public void testProxyCannotAcceptConfirmationAfterNativeSuspension() {
+        GmsCoreUtils.setGmsCoreVersionForTesting(GmsCoreUtils.GMSCORE_MIN_VERSION);
+        CreateConfirmationUiDelegate confirmation = mock(CreateConfirmationUiDelegate.class);
+        when(confirmation.show(any(), any())).thenReturn(true);
+        mAuthenticator = new AuthenticatorImpl(ApplicationProvider.getApplicationContext(),
+                mWebContents, mIntentSender, confirmation, mRenderFrameHost, mTopOrigin);
+        enableProxy();
+        when(mProxyNatives.isActive(1L)).thenReturn(false);
+        Authenticator.MakeCredential_Response callback =
+                mock(Authenticator.MakeCredential_Response.class);
+        mAuthenticator.makeCredential(Fido2ApiTestHelper.createDefaultMakeCredentialOptions(), callback);
+        ArgumentCaptor<Runnable> accept = ArgumentCaptor.forClass(Runnable.class);
+        verify(confirmation).show(accept.capture(), any());
+        // A proxy attaches only after suspension invalidated the original document watch.
+        when(mProxyNatives.startRequestGuard(eq(1L), anyLong(), anyBoolean())).thenReturn(true);
+        when(mProxyNatives.isRequestValid(eq(1L), anyLong())).thenReturn(true);
+        when(mProxyNatives.beginRequestInteraction(eq(1L), anyLong())).thenReturn(true);
+        when(mProxyNatives.canCompleteRequest(eq(1L), anyLong())).thenReturn(true);
+        when(mProxyNatives.isActive(1L)).thenReturn(true);
+        // Java cancellation is still queued when the old acceptance arrives.
+        when(mProxyNatives.finishConfirmation(eq(1L), anyLong())).thenReturn(false);
+        accept.getValue().run();
+        verify(confirmation).cancel();
+        verify(callback).call(eq(AuthenticatorStatus.ABORT_ERROR), any(), any());
+        verify(mProxyNatives, never()).makeCredential(anyLong(), any());
+        verify(mFido2CredentialRequestMock, never())
+                .handleMakeCredentialRequest(any(), any(), any(), any(), any());
+    }
