+    private void showSitePermissionsPageForRemovalTest(String extensionId) {
+        // Preserve real PropertyModel read-after-write behavior while retaining the existing
+        // fixture's mock model, so the back callback refreshes the newly selected main page.
+        AtomicInteger currentPage =
+                new AtomicInteger(ExtensionsMenuProperties.Page.SITE_PERMISSIONS);
+        when(mMenuPropertyModel.get(ExtensionsMenuProperties.CURRENT_PAGE))
+                .thenAnswer(invocation -> currentPage.get());
+        doAnswer(
+                        invocation -> {
+                            currentPage.set(invocation.getArgument(1));
+                            return null;
+                        })
+                .when(mMenuPropertyModel)
+                .set(eq(ExtensionsMenuProperties.CURRENT_PAGE), anyInt());
+        when(mSitePermissionsPropertyModel.get(SitePermissionsPageProperties.EXTENSION_ID))
+                .thenReturn(extensionId);
+        // Native GetMenuEntry CHECKs this stale index after removal. Any such lookup is a bug.
+        when(mExtensionsMenuBridgeJniMock.getMenuEntry(anyLong(), anyInt()))
+                .thenThrow(new AssertionError("Removed action index must not be queried"));
+        clearInvocations(mMenuPropertyModel, mExtensionsMenuBridgeJniMock);
     }

