+    private void assertSiteAccessToggleUsesRefreshedOrigin(
+            boolean updateSingleAction, boolean turnOn) {
+        when(mMenuPropertyModel.get(ExtensionsMenuProperties.CURRENT_PAGE))
+                .thenReturn(ExtensionsMenuProperties.Page.MAIN);
+        ExtensionsMenuTypes.MenuEntryState initialEntry =
+                ExtensionTestUtils.createMenuEntryWithHostPermissions(
+                        "id_a", "Extension A", ICON_RED, /* isPinned= */ false);
+        when(mExtensionsMenuBridgeJniMock.getMenuEntries(anyLong()))
+                .thenReturn(List.of(initialEntry));
+        mBridgeCaptor.getValue().onReady();
+        assertEquals(1, mActionModels.size());
+        PropertyModel model = mActionModels.get(0).model;
+
+        String currentOrigin = "https://other.example";
+        assertFalse(currentOrigin.equals(initialEntry.origin));
+        ExtensionsMenuTypes.ControlState refreshedToggle =
+                new ExtensionsMenuTypes.ControlState(
+                        ExtensionsMenuTypes.ControlState.Status.ENABLED,
+                        /* text= */ "",
+                        /* accessibleName= */ "",
+                        /* tooltipText= */ currentOrigin,
+                        /* isOn= */ !turnOn,
+                        /* icon= */ null);
+        ExtensionsMenuTypes.MenuEntryState refreshedEntry =
+                new ExtensionsMenuTypes.MenuEntryState(
+                        initialEntry.id,
+                        initialEntry.actionButton,
+                        initialEntry.contextMenuButton,
+                        refreshedToggle,
+                        initialEntry.sitePermissionsButton,
+                        initialEntry.isEnterprise,
+                        currentOrigin);
+        if (updateSingleAction) {
+            when(mExtensionsMenuBridgeJniMock.getMenuEntry(anyLong(), eq(0)))
+                    .thenReturn(refreshedEntry);
+            mBridgeCaptor.getValue().onActionUpdated(0);
+        } else {
+            when(mExtensionsMenuBridgeJniMock.getMenuEntries(anyLong()))
+                    .thenReturn(List.of(refreshedEntry));
+            mMenuMediator.onModelChanged();
+        }
+
+        // Exercise the updated listener on the retained row, not a reconstructed model.
+        assertEquals(1, mActionModels.size());
+        assertSame(model, mActionModels.get(0).model);
+        assertEquals(
+                currentOrigin, model.get(ExtensionsMenuItemProperties.SITE_ACCESS_TOGGLE_TOOLTIP));
+        assertEquals(!turnOn, model.get(ExtensionsMenuItemProperties.SITE_ACCESS_TOGGLE_CHECKED));
+        CompoundButton.OnCheckedChangeListener listener =
+                model.get(ExtensionsMenuItemProperties.SITE_ACCESS_TOGGLE_ON_CLICK);
+        listener.onCheckedChanged(null, turnOn);
+
+        verify(mExtensionsMenuBridgeJniMock)
+                .onExtensionToggleSelected(
+                        EXTENSIONS_MENU_BRIDGE_POINTER, "id_a", currentOrigin, turnOn);
+        verify(mExtensionsMenuBridgeJniMock, never())
+                .onExtensionToggleSelected(
+                        eq(EXTENSIONS_MENU_BRIDGE_POINTER),
+                        eq("id_a"),
+                        eq(initialEntry.origin),
+                        anyBoolean());
+        verify(mOnDismissMenu, times(turnOn ? 0 : 1)).run();
+    }
