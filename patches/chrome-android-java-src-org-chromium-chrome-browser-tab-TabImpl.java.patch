+
+    void setContainerIdForCreation(String containerId) {
+        if (mContainerIdentityAssigned || isInitialized() || mWebContents != null) {
+            throw new IllegalStateException("Cannot change an initialized tab's container");
+        }
+        if (!ContainersBridge.isContainerIdValid(mProfile, containerId)) {
+            throw new IllegalArgumentException("Invalid or unavailable storage container");
+        }
+        if (!containerId.isEmpty()) ContainersPersistentTabReferences.invalidate(mProfile);
+        mContainerId = containerId;
+        mContainerIdentityAssigned = true;
+    }
+
+    void setSeparateStoragePartitionExperimentForCreation(WebContents contents) {
+        if (!mContainerIdentityAssigned || !mContainerId.isEmpty() || isInitialized()
+                || mWebContents != null || mSeparateStoragePartitionExperiment) {
+            throw new IllegalStateException("Cannot change an initialized tab's storage policy");
+        }
+        if (!WebContentsFactory.isWebContentsForSeparateStoragePartitionExperiment(
+                mProfile, contents)) {
+            throw new IllegalArgumentException("Invalid speculative CCT contents");
+        }
+        mSeparateStoragePartitionExperiment = true;
+    }
+
+    private boolean matchesExpectedStoragePartition(WebContents contents) {
+        return mSeparateStoragePartitionExperiment
+                ? mContainerId.isEmpty()
+                        && WebContentsFactory.isWebContentsForSeparateStoragePartitionExperiment(
+                                mProfile, contents)
+                : ContainersBridge.isWebContentsInContainer(mProfile, contents, mContainerId);
+    }
+
+    private @Nullable WebContents createContainerWebContents(
+            boolean initiallyHidden, boolean initializeRenderer) {
+        WebContents contents =
+                mSeparateStoragePartitionExperiment
+                        ? WebContentsFactory.createWebContentsWithSeparateStoragePartitionForExperiment(
+                                mProfile)
+                        : WebContentsFactory.createWebContentsForContainer(
+                                mProfile, initiallyHidden, initializeRenderer, mContainerId);
+        mContainerAdmissionFailed = contents == null;
+        return contents;
+    }
