+    @Test
+    public void browserFullscreenWithoutTabUsesRealImmersiveFlagsAndRestoresOrdinaryFlags() {
+        var decor = mActivity.getWindow().getDecorView();
+        decor.setSystemUiVisibility(View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR);
+        mFullscreenHtmlApiHandlerLegacy.setBrowserFullscreenMode(true);
+        assertTrue(mFullscreenHtmlApiHandlerLegacy.getBrowserFullscreenMode());
+        assertTrue(mFullscreenHtmlApiHandlerLegacy.getFullscreenUiModeSupplier().get());
+        Assert.assertFalse(mFullscreenHtmlApiHandlerLegacy.getPersistentFullscreenMode());
+        assertTrue(mFullscreenHtmlApiHandlerLegacy.isStatusBarHidden(decor));
+        assertTrue(mFullscreenHtmlApiHandlerLegacy.isNavigationBarHidden(decor));
+        assertTrue((decor.getSystemUiVisibility() & View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY) != 0);
+        mFullscreenHtmlApiHandlerLegacy.setBrowserFullscreenMode(false);
+        Assert.assertFalse(mFullscreenHtmlApiHandlerLegacy.getFullscreenUiModeSupplier().get());
+        Assert.assertFalse(mFullscreenHtmlApiHandlerLegacy.isStatusBarHidden(decor));
+        Assert.assertFalse(mFullscreenHtmlApiHandlerLegacy.isNavigationBarHidden(decor));
+        assertTrue((decor.getSystemUiVisibility() & View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR) != 0);
+    }
+
+    @Test
+    public void exitingTabFullscreenPreservesIndependentBrowserFullscreen() {
+        doReturn(null).when(mTab).getWebContents();
+        doReturn(true).when(mTab).isUserInteractable();
+        mFullscreenHtmlApiHandlerLegacy.setTabForTesting(mTab);
+        mFullscreenHtmlApiHandlerLegacy.setBrowserFullscreenMode(true);
+        mFullscreenHtmlApiHandlerLegacy.onEnterFullscreen(
+                mTab, new FullscreenOptions(false, false, INVALID_DISPLAY));
+        assertTrue(mFullscreenHtmlApiHandlerLegacy.getPersistentFullscreenMode());
+        mFullscreenHtmlApiHandlerLegacy.exitPersistentFullscreenMode();
+        Assert.assertFalse(mFullscreenHtmlApiHandlerLegacy.getPersistentFullscreenMode());
+        assertTrue(mFullscreenHtmlApiHandlerLegacy.getFullscreenUiModeSupplier().get());
+        assertTrue(
+                mFullscreenHtmlApiHandlerLegacy.isNavigationBarHidden(
+                        mActivity.getWindow().getDecorView()));
+        mFullscreenHtmlApiHandlerLegacy.setBrowserFullscreenMode(false);
+        Assert.assertFalse(mFullscreenHtmlApiHandlerLegacy.getFullscreenUiModeSupplier().get());
+    }
+
+    @Test
+    public void backExitsBrowserFullscreenAndRetainsExclusiveAccessDelegate() {
+        mFullscreenHtmlApiHandlerLegacy.setBrowserFullscreenMode(true);
+        var tabHandler = Mockito.mock(BackPressHandler.class);
+        var tabState = ObservableSuppliers.createNonNull(true);
+        doReturn(tabState).when(tabHandler).getHandleBackPressChangedSupplier();
+        doReturn(BackPressHandler.BackPressResult.SUCCESS).when(tabHandler).handleBackPress();
+        var handler = new FullscreenBackPressHandler(mFullscreenHtmlApiHandlerLegacy, tabHandler);
+        assertTrue(handler.getHandleBackPressChangedSupplier().get());
+        assertEquals(BackPressHandler.BackPressResult.SUCCESS, handler.handleBackPress());
+        Assert.assertFalse(mFullscreenHtmlApiHandlerLegacy.getBrowserFullscreenMode());
+        verify(tabHandler).handleBackPress();
+        handler.destroy();
+        mFullscreenHtmlApiHandlerLegacy.setBrowserFullscreenMode(true);
+        mFullscreenHtmlApiHandlerLegacy.setBrowserFullscreenMode(false);
+    }
+
