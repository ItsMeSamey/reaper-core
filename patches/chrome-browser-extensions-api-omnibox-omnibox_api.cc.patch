+#if BUILDFLAG(IS_ANDROID)
+// static
+bool ExtensionOmniboxEventRouter::IsValidAndroidInput(Profile* profile,
+                                                     const GURL& url) {
+  if (!profile || !url.is_valid() || !url.SchemeIs(kExtensionScheme) ||
+      url.path() != "/" || url.has_ref() || url.has_username() ||
+      url.has_password() || url.has_port()) {
+    return false;
+  }
+  std::string input;
+  if (!net::GetValueForKeyInQuery(url, "q", &input)) {
+    return false;
+  }
+  const Extension* extension = ExtensionRegistry::Get(profile)
+                                   ->enabled_extensions().GetByID(std::string(url.host()));
+  return extension && !OmniboxInfo::GetKeyword(extension).empty() &&
+         (!profile->IsOffTheRecord() ||
+          util::IsIncognitoEnabled(extension->id(), profile));
+}
+#endif  // BUILDFLAG(IS_ANDROID)
 
