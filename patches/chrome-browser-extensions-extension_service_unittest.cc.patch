+class AndroidInstalledUpdateLifetimeTest : public ExtensionServiceTest {
+ protected:
+  void SetUp() override {
+    ExtensionServiceTest::SetUp();
+    InitializeEmptyExtensionService();
+    const Extension* installed =
+        InstallCRX(data_dir().AppendASCII("good.crx"), INSTALL_NEW);
+    ASSERT_TRUE(installed);
+    public_key_ = installed->public_key();
+    ASSERT_TRUE(update_root_.CreateUniqueTempDir());
+    update_dir_ = update_root_.GetPath().AppendASCII("update");
+    ASSERT_TRUE(base::CopyDirectory(installed->path(), update_dir_, true));
+    std::string error;
+    auto manifest = file_util::LoadManifest(update_dir_, &error);
+    ASSERT_TRUE(manifest) << error;
+    manifest->Set("version", "1.0.0.1");
+    JSONFileValueSerializer serializer(update_dir_.Append(kManifestFilename));
+    ASSERT_TRUE(serializer.Serialize(base::Value(std::move(*manifest))));
+  }
+
+  void TearDown() override {
+    // There is no held production callback or blocked task to release on an
+    // assertion failure. Drain before removing the installer's observation.
+    task_environment()->RunUntilIdle();
+    installer_.reset();
+    ExtensionServiceTest::TearDown();
+  }
+
+  void AddResultCallback() {
+    installer_->AddInstallerCallback(base::BindOnce(
+        [](std::shared_ptr<int> calls,
+           CrxInstaller::InstallerResultCallback done,
+           const std::optional<CrxInstallError>& error) {
+          ++*calls;
+          std::move(done).Run(error);
+        },
+        completions_,
+        result_.GetCallback<const std::optional<CrxInstallError>&>()));
+  }
+
+  void StartUnpackedUpdate() {
+    installer_ = CrxInstaller::CreateSilent(profile());
+    installer_->set_delete_source(true);
+    // Exercise the commit boundary without waiting for the idle update gate.
+    installer_->set_install_immediately(true);
+    AddResultCallback();
+    installer_->UpdateExtensionFromUnpackedCrx(kGoodCrx, public_key_,
+                                               update_dir_);
+  }
+
+  void ExpectUninstalledFailure() {
+    ASSERT_TRUE(result_.Wait());
+    const auto& error = result_.Get();
+    ASSERT_TRUE(error);
+    EXPECT_EQ(CrxInstallErrorType::OTHER, error->type());
+    EXPECT_EQ(CrxInstallErrorDetail::UPDATE_NON_EXISTING_EXTENSION,
+              error->detail());
+    task_environment()->RunUntilIdle();
+    EXPECT_EQ(1, *completions_);
+    EXPECT_FALSE(registry()->GetInstalledExtension(kGoodCrx));
+    EXPECT_FALSE(prefs()->GetInstalledExtensionInfo(kGoodCrx));
+    EXPECT_FALSE(prefs()->GetGrantedPermissions(kGoodCrx));
+    EXPECT_FALSE(
+        DelayedInstallManager::Get(profile())->GetPendingExtensionUpdate(
+            kGoodCrx));
+    EXPECT_FALSE(base::PathExists(update_dir_));
+  }
+
+  InstallTracker* tracker() {
+    return InstallTrackerFactory::GetForBrowserContext(profile());
+  }
+
+  base::ScopedTempDir update_root_;
+  base::FilePath update_dir_;
+  std::string public_key_;
+  scoped_refptr<CrxInstaller> installer_;
+  std::shared_ptr<int> completions_ = std::make_shared<int>(0);
+  base::test::TestFuture<std::optional<CrxInstallError>> result_;
+};
+
+TEST_F(AndroidInstalledUpdateLifetimeTest,
+       UninstallAtBeginRejectsUnpackedUpdate) {
+  InstalledUpdateBeginAction action(
+      tracker(), kGoodCrx,
+      base::BindLambdaForTesting([&] { UninstallExtension(kGoodCrx); }));
+  StartUnpackedUpdate();
+  ExpectUninstalledFailure();
+}
+
+TEST_F(AndroidInstalledUpdateLifetimeTest, UninstallAtBeginRejectsCrxUpdate) {
+  const base::FilePath crx_path =
+      temp_dir().GetPath().AppendASCII("update.crx");
+  ASSERT_TRUE(base::CopyFile(data_dir().AppendASCII("good2.crx"), crx_path));
+  CRXFileInfo crx_info(crx_path, GetTestVerifierFormat());
+  crx_info.extension_id = kGoodCrx;
+  ExtensionUpdater updater(profile());
+  updater.InitAndEnable(prefs(), prefs()->pref_service(), base::Minutes(10),
+                        nullptr, ExtensionDownloader::Factory());
+  installer_ = updater.CreateUpdateInstaller(crx_info, true);
+  ASSERT_TRUE(installer_);
+  installer_->set_install_immediately(true);
+  AddResultCallback();
+  InstalledUpdateBeginAction action(
+      tracker(), kGoodCrx,
+      base::BindLambdaForTesting([&] { UninstallExtension(kGoodCrx); }));
+  installer_->InstallCrxFile(crx_info);
+  ASSERT_TRUE(result_.Wait());
+  ASSERT_TRUE(result_.Get());
+  EXPECT_EQ(CrxInstallErrorDetail::UPDATE_NON_EXISTING_EXTENSION,
+            result_.Get()->detail());
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(1, *completions_);
+  EXPECT_FALSE(registry()->GetInstalledExtension(kGoodCrx));
+  EXPECT_FALSE(prefs()->GetInstalledExtensionInfo(kGoodCrx));
+  EXPECT_FALSE(DelayedInstallManager::Get(profile())->GetPendingExtensionUpdate(
+      kGoodCrx));
+  EXPECT_FALSE(base::PathExists(crx_path));
+}
+
+TEST_F(AndroidInstalledUpdateLifetimeTest,
+       UninstallAfterPreAssetsCheckRejectsCommit) {
+  auto uninstalled_after_finalizing = std::make_shared<bool>(false);
+  InstalledUpdateFinalizingAction action(
+      InstallStageTrackerFactory::GetForBrowserContext(profile()), kGoodCrx,
+      base::BindLambdaForTesting([this, uninstalled_after_finalizing] {
+        *uninstalled_after_finalizing = true;
+        EXPECT_TRUE(registrar()->UninstallExtension(
+            kGoodCrx, UNINSTALL_REASON_FOR_TESTING, nullptr));
+      }));
+  StartUnpackedUpdate();
+  ExpectUninstalledFailure();
+  EXPECT_TRUE(*uninstalled_after_finalizing);
+}
+
+TEST_F(AndroidInstalledUpdateLifetimeTest,
+       ReinstallDoesNotRevivePendingUpdate) {
+  base::FilePath replacement_path;
+  scoped_refptr<const Extension> replacement;
+  InstalledUpdateBeginAction action(
+      tracker(), kGoodCrx, base::BindLambdaForTesting([&] {
+        UninstallExtension(kGoodCrx);
+        replacement =
+            InstallCRX(data_dir().AppendASCII("good2.crx"), INSTALL_NEW);
+        ASSERT_TRUE(replacement);
+        replacement_path = replacement->path();
+      }));
+  StartUnpackedUpdate();
+  ASSERT_TRUE(result_.Wait());
+  ASSERT_TRUE(result_.Get());
+  EXPECT_EQ(CrxInstallErrorDetail::UPDATE_NON_EXISTING_EXTENSION,
+            result_.Get()->detail());
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(1, *completions_);
+  ASSERT_TRUE(replacement);
+  EXPECT_EQ(replacement.get(), registry()->GetInstalledExtension(kGoodCrx));
+  EXPECT_EQ("1.0.0.1", replacement->VersionString());
+  EXPECT_TRUE(prefs()->GetInstalledExtensionInfo(kGoodCrx));
+  EXPECT_TRUE(base::PathExists(replacement_path.Append(kManifestFilename)));
+  EXPECT_FALSE(base::PathExists(update_dir_));
+}
+
+TEST_F(AndroidInstalledUpdateLifetimeTest,
+       DisableDoesNotCancelInstalledUpdate) {
+  InstalledUpdateBeginAction action(
+      tracker(), kGoodCrx, base::BindLambdaForTesting([&] {
+        registrar()->DisableExtension(kGoodCrx,
+                                      {disable_reason::DISABLE_USER_ACTION});
+      }));
+  StartUnpackedUpdate();
+  ASSERT_TRUE(result_.Wait());
+  EXPECT_FALSE(result_.Get());
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(1, *completions_);
+  const Extension* updated =
+      registry()->disabled_extensions().GetByID(kGoodCrx);
+  ASSERT_TRUE(updated);
+  EXPECT_EQ("1.0.0.1", updated->VersionString());
+  EXPECT_TRUE(
+      prefs()->HasDisableReason(kGoodCrx, disable_reason::DISABLE_USER_ACTION));
+  EXPECT_FALSE(base::PathExists(update_dir_));
+}
+
+TEST_F(AndroidInstalledUpdateLifetimeTest, ReloadDoesNotCancelInstalledUpdate) {
+  InstalledUpdateBeginAction action(
+      tracker(), kGoodCrx, base::BindLambdaForTesting([&] {
+        TestExtensionRegistryObserver observer(registry(), kGoodCrx);
+        registrar()->ReloadExtension(kGoodCrx);
+        EXPECT_TRUE(observer.WaitForExtensionLoaded());
+      }));
+  StartUnpackedUpdate();
+  ASSERT_TRUE(result_.Wait());
+  EXPECT_FALSE(result_.Get());
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(1, *completions_);
+  const Extension* updated = registry()->enabled_extensions().GetByID(kGoodCrx);
+  ASSERT_TRUE(updated);
+  EXPECT_EQ("1.0.0.1", updated->VersionString());
+  EXPECT_FALSE(base::PathExists(update_dir_));
+}
