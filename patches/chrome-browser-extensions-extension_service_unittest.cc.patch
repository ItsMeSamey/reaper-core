+// Intervene after the installed-ID lookup using the real install notification,
+// before the installer posts its unpack work. Move the action before running it
+// so a nested same-ID reinstall does not invoke it again.
+class InstalledUpdateBeginAction : public InstallObserver {
+ public:
+  InstalledUpdateBeginAction(InstallTracker* tracker,
+                             ExtensionId id,
+                             base::OnceClosure action)
+      : id_(std::move(id)), action_(std::move(action)) {
+    observation_.Observe(tracker);
+  }
+
+  void OnBeginCrxInstall(content::BrowserContext* context,
+                         const ExtensionId& id) override {
+    if (id == id_ && action_) {
+      std::move(action_).Run();
+    }
+  }
+
+ private:
+  const ExtensionId id_;
+  base::OnceClosure action_;
+  base::ScopedObservation<InstallTracker, InstallObserver> observation_{this};
+};
+
+// The finalizing notification is synchronous inside ConfirmInstall. Posting
+// the action lets its pre-assets check and file task scheduling finish first;
+// this UI task is ahead of the file task's later ReportSuccessFromUIThread.
+class InstalledUpdateFinalizingAction : public InstallStageTracker::Observer {
+ public:
+  InstalledUpdateFinalizingAction(InstallStageTracker* tracker,
+                                  ExtensionId id,
+                                  base::OnceClosure action)
+      : id_(std::move(id)), action_(std::move(action)) {
+    observation_.Observe(tracker);
+  }
+
+  void OnExtensionDataChangedForTesting(
+      const ExtensionId& id,
+      const content::BrowserContext* context,
+      const InstallStageTracker::InstallationData& data) override {
+    if (id == id_ && action_ &&
+        data.installation_stage == InstallationStage::kFinalizing) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, std::move(action_));
+    }
+  }
+
+ private:
+  const ExtensionId id_;
+  base::OnceClosure action_;
+  base::ScopedObservation<InstallStageTracker, InstallStageTracker::Observer>
+      observation_{this};
+};
+
+}  // namespace
