+    "name": "Download open worker lifetime",
+    "version": "1.0",
+    "manifest_version": 3,
+    "permissions": ["downloads", "downloads.open"],
+    "background": {"service_worker": "background.js"}
+  })");
+  extension_dir.WriteFile(FILE_PATH_LITERAL("background.js"), "// blank");
+  service_worker_test_utils::TestServiceWorkerContextObserver registered(
+      current_profile());
+  const Extension* extension =
+      ExtensionBrowserTest::LoadExtension(extension_dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+  const int64_t version_id = registered.WaitForWorkerActivated();
+
+  static const HistoryDownloadInfo history[] = {
+      {FILE_PATH_LITERAL("held.txt"), DownloadItem::COMPLETE,
+       download::DOWNLOAD_DANGER_TYPE_NOT_DANGEROUS}};
+  DownloadManager::DownloadVector items;
+  ASSERT_TRUE(CreateHistoryDownloads(history, &items));
+  ASSERT_EQ(1u, items.size());
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return GetOnRecordManager()->IsManagerInitialized(); }));
+  ASSERT_TRUE(GetActiveWebContents());
+  ui::WindowAndroid* window = GetActiveWebContents()->GetTopLevelNativeWindow();
+  ASSERT_TRUE(window);
+  sender_ = GetActiveWebContents()->GetWeakPtr();
+  ASSERT_TRUE(CaptureDownloadOpenDialog(sender_.get(), /*include_pending=*/true)
+                  .is_null());
+
+  auto& registry = ExtensionFunctionRegistry::GetInstance();
+  const auto original = registry.GetFactoriesForTesting().at("downloads.open");
+  ASSERT_TRUE(registry.OverrideFunctionForTesting(
+      "downloads.open", &NewExtensionFunction<ObservedDownloadsOpenFunction>));
+  base::ScopedClosureRunner restore_factory(base::BindOnce(
+      [](ExtensionFunctionRegistry::FactoryEntry entry) {
+        ExtensionFunctionRegistry::GetInstance().Register(entry);
+      },
+      original));
+  ExtensionTestMessageListener canceled(errors::kOpenPermission);
+  canceled.set_extension_id(extension->id());
+  const std::string script = base::StringPrintf(R"(
+    chrome.test.runWithUserGesture(() => {
+      chrome.downloads.open(%d).then(
+        () => chrome.test.sendMessage('unexpected open'),
+        error => chrome.test.sendMessage(error.message));
+      chrome.test.sendScriptResult('started');
+    });)",
+                                                items[0]->GetId());
+  request_dispatched_ = true;
+  const auto script_result = BackgroundScriptExecutor::ExecuteScript(
+      current_profile(), extension->id(), script,
+      BackgroundScriptExecutor::ResultCapture::kSendScriptResult);
+  EXPECT_EQ("started", script_result);
+  ASSERT_TRUE(started_.Wait());
+  auto function = started_.Take();
+  function_ = function->GetWeakPtrForTesting();
+  dispatch_observed_ = true;
+  const bool captured = base::test::RunUntil([&] {
+    if (sender_) {
+      modal_.Reset(CaptureDownloadOpenDialog(sender_.get()));
+    }
+    return !modal_.is_null() || function->did_respond();
+  });
+  ASSERT_TRUE(captured);
+  ASSERT_TRUE(function->is_from_service_worker());
+  ASSERT_FALSE(function->did_respond());
+  ASSERT_FALSE(modal_.is_null());
+  ASSERT_FALSE(
+      android_test::GetDownloadOpenDialogParagraphsForTesting(
+          base::android::AttachCurrentThread(), modal_)
+          .empty());
+  // The test must not retain the request when checking keepalive release.
+  function.reset();
+  base::RunLoop().RunUntilIdle();
+
+  content::ServiceWorkerContext* context = GetServiceWorkerContext();
+  service_worker_test_utils::TestServiceWorkerContextObserver stopped(
+      context, extension->id());
+  stopped.SetRunningId(version_id);
+  content::AdvanceClockAfterRequestTimeout(context, version_id, &tick_clock_);
+  ASSERT_TRUE(content::TriggerTimeoutAndCheckRunningState(context, version_id));
+
+  // Cancel the real held dialog; its actual API response must still reach JS.
+  ASSERT_TRUE(android_test::ClickDownloadOpenDialogForTesting(
+      base::android::AttachCurrentThread(), modal_, /*accept=*/false));
+  ASSERT_TRUE(canceled.WaitUntilSatisfied());
+  EXPECT_FALSE(items[0]->GetOpened());
+  base::RunLoop().RunUntilIdle();
+  content::AdvanceClockAfterRequestTimeout(context, version_id, &tick_clock_);
+  ASSERT_FALSE(
+      content::TriggerTimeoutAndCheckRunningState(context, version_id));
+  stopped.WaitForWorkerStopped();
+}
