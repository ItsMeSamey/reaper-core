+class DownloadOpenWorkerLifetimeTest : public DownloadExtensionTest {
+ protected:
+  void TearDownOnMainThread() override {
+    if (request_dispatched_ && !dispatch_observed_) {
+      // The start callback belongs to this fixture, including failed
+      // assertions.
+      CHECK(started_.Wait());
+      auto function = started_.Take();
+      function_ = function->GetWeakPtrForTesting();
+      dispatch_observed_ = true;
+    }
+    if (function_ && !function_->did_respond()) {
+      CHECK(base::test::RunUntil([&] {
+        if (modal_.is_null() && sender_) {
+          modal_.Reset(CaptureDownloadOpenDialog(sender_.get(),
+                                                 /*include_pending=*/true));
+        }
+        return !modal_.is_null() || !function_ || function_->did_respond();
+      }));
+      if (function_ && !function_->did_respond()) {
+        android_test::DismissDownloadOpenDialogForTesting(
+            base::android::AttachCurrentThread(), modal_);
+        CHECK(base::test::RunUntil(
+            [&] { return !function_ || function_->did_respond(); }));
+      }
+    }
+    if (!modal_.is_null()) {
+      android_test::DismissDownloadOpenDialogForTesting(
+          base::android::AttachCurrentThread(), modal_);
+    }
+    modal_.Reset();
+    base::RunLoop().RunUntilIdle();
+    // ServiceWorkerVersion must not retain a pointer to this fixture's clock.
+    content::ResetTickClockToDefaultForAllLiveServiceWorkerVersions(
+        GetServiceWorkerContext());
+    DownloadExtensionTest::TearDownOnMainThread();
+  }
+
+  base::SimpleTestTickClock tick_clock_;
+  base::test::TestFuture<scoped_refptr<ObservedDownloadsOpenFunction>> started_;
+  DownloadsOpenStartedCallback started_callback_ = started_.GetCallback();
+  base::AutoReset<DownloadsOpenStartedCallback*> reset_started_{
+      &g_downloads_open_started, &started_callback_};
+  bool request_dispatched_ = false;
+  bool dispatch_observed_ = false;
+  base::WeakPtr<ObservedDownloadsOpenFunction> function_;
+  base::WeakPtr<content::WebContents> sender_;
+  base::android::ScopedJavaGlobalRef<jobject> modal_;
+};
