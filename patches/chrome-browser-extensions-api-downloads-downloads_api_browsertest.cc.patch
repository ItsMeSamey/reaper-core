+// The real API's host/profile checks run before this boundary. Hold the native
+// completion so authorization and shutdown races are independent of UI timing.
+class AndroidDownloadRevealBoundary {
+ public:
+  AndroidDownloadRevealBoundary()
+      : callbacks_{base::BindRepeating(&AndroidDownloadRevealBoundary::Show,
+                                       base::Unretained(this)),
+                   base::BindRepeating(&AndroidDownloadRevealBoundary::Cancel,
+                                       base::Unretained(this))},
+        override_(
+            DownloadManagerService::SetDownloadItemRevealCallbacksForTesting(
+                &callbacks_)) {}
+
+  bool shown = true;
+  bool synchronous = false;
+  bool suppress_reply = false;
+  int show_count = 0;
+  int cancel_count = 0;
+  int consumed_count = 0;
+  std::string guid;
+  raw_ptr<content::BrowserContext> item_context = nullptr;
+  base::OnceClosure before_reply;
+
+ private:
+  int64_t Show(DownloadItem* item, base::OnceCallback<void(bool)> callback) {
+    ++show_count;
+    guid = item->GetGuid();
+    item_context = content::DownloadItemUtils::GetBrowserContext(item);
+    callback_ = std::move(callback);
+    if (synchronous) {
+      Reply();
+    } else if (!suppress_reply) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&AndroidDownloadRevealBoundary::Reply,
+                                    weak_factory_.GetWeakPtr()));
+    }
+    return 41;
+  }
+
+  void Reply() {
+    if (before_reply) {
+      std::move(before_reply).Run();
+    }
+    if (callback_) {
+      ++consumed_count;
+      std::move(callback_).Run(shown);
+    }
+  }
+
+  void Cancel(int64_t token) {
+    EXPECT_EQ(41, token);
+    ++cancel_count;
+    // Java also consumes the JNI callback after request retirement. It must be
+    // harmless when the native function has already cancelled or shut down.
+    if (callback_) {
+      ++consumed_count;
+      std::move(callback_).Run(false);
+    }
+  }
+
+  DownloadManagerService::DownloadItemRevealCallbacksForTesting callbacks_;
+  base::AutoReset<
+      const DownloadManagerService::DownloadItemRevealCallbacksForTesting*>
+      override_;
+  base::OnceCallback<void(bool)> callback_;
+  base::WeakPtrFactory<AndroidDownloadRevealBoundary> weak_factory_{this};
+};
