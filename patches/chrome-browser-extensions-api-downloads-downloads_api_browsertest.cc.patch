+// Exercises the actual extension function and held Android DialogModel. The
+// synthetic native invocation has no sender frame; it does not execute JS.
+class DownloadOpenPermissionTest : public DownloadExtensionTest {
+ protected:
+  void SetUpOnMainThread() override {
+    DownloadExtensionTest::SetUpOnMainThread();
+    extension_dir_.WriteManifest(R"({
+      "name": "Optional download open",
+      "version": "1.0",
+      "manifest_version": 3,
+      "permissions": ["downloads"],
+      "optional_permissions": ["downloads.open"]
+    })");
+    open_extension_ =
+        ExtensionBrowserTest::LoadExtension(extension_dir_.UnpackedPath());
+    ASSERT_TRUE(open_extension_);
+    base::test::TestFuture<void> granted;
+    PermissionsUpdater(current_profile())
+        .GrantOptionalPermissions(
+            *open_extension_,
+            PermissionsParser::GetOptionalPermissions(open_extension_.get()),
+            granted.GetCallback());
+    ASSERT_TRUE(granted.Wait());
+    ASSERT_TRUE(open_extension_->permissions_data()->HasAPIPermission(
+        mojom::APIPermissionID::kDownloadsOpen));
+  }
+
+  void StartPendingOpen() {
+    static const HistoryDownloadInfo history[] = {
+        {FILE_PATH_LITERAL("file.txt"), DownloadItem::COMPLETE,
+         download::DOWNLOAD_DANGER_TYPE_NOT_DANGEROUS}};
+    DownloadManager::DownloadVector items;
+    ASSERT_TRUE(CreateHistoryDownloads(history, &items));
+    ASSERT_EQ(1u, items.size());
+    item_ = items[0].get();
+    ASSERT_TRUE(item_);
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return GetOnRecordManager()->IsManagerInitialized(); }));
+    ASSERT_TRUE(GetActiveWebContents());
+    ui::WindowAndroid* window =
+        GetActiveWebContents()->GetTopLevelNativeWindow();
+    ASSERT_TRUE(window);
+    sender_ = GetActiveWebContents()->GetWeakPtr();
+    ASSERT_TRUE(
+        CaptureDownloadOpenDialog(sender_.get(), /*include_pending=*/true)
+            .is_null());
+
+    open_function_ = base::MakeRefCounted<DownloadsOpenFunction>();
+    open_function_->set_extension(open_extension_);
+    open_function_->set_user_gesture(true);
+    base::ListValue args;
+    args.Append(static_cast<int>(item_->GetId()));
+    open_function_->SetArgs(std::move(args));
+    dispatcher_ =
+        std::make_unique<ExtensionFunctionDispatcher>(current_profile());
+    open_function_->SetDispatcher(dispatcher_->AsWeakPtr());
+    response_ = std::make_unique<api_test_utils::SendResponseHelper>(
+        open_function_.get());
+    open_function_->RunWithValidation().Execute();
+    const bool captured = base::test::RunUntil([&] {
+      if (sender_) {
+        modal_.Reset(CaptureDownloadOpenDialog(sender_.get()));
+      }
+      return !modal_.is_null() || response_->has_response();
+    });
+    ASSERT_TRUE(captured);
+    ASSERT_FALSE(response_->has_response());
+    ASSERT_FALSE(modal_.is_null());
+    ASSERT_FALSE(
+        android_test::GetDownloadOpenDialogParagraphsForTesting(
+            base::android::AttachCurrentThread(), modal_)
+            .empty());
+    ASSERT_FALSE(item_->GetOpened());
+  }
+
+  void AcceptAndExpectDenial() {
+    ASSERT_TRUE(response_);
+    ASSERT_FALSE(response_->has_response());
+    ASSERT_TRUE(android_test::ClickDownloadOpenDialogForTesting(
+        base::android::AttachCurrentThread(), modal_, /*accept=*/true));
+    response_->WaitForResponse();
+    EXPECT_FALSE(response_->GetResponse());
+    EXPECT_EQ(errors::kOpenPermission, open_function_->GetError());
+    EXPECT_FALSE(item_->GetOpened());
+    // Retiring the captured model again must not produce a second response.
+    android_test::DismissDownloadOpenDialogForTesting(
+        base::android::AttachCurrentThread(), modal_);
+    base::RunLoop().RunUntilIdle();
+  }
+
+  void TearDownOnMainThread() override {
+    if (response_ && !response_->has_response()) {
+      // Keep the Unretained response helper alive until the real request ends.
+      // A failed current-model assertion may leave our dialog in the TAB queue.
+      CHECK(base::test::RunUntil([&] {
+        if (modal_.is_null() && sender_) {
+          modal_.Reset(CaptureDownloadOpenDialog(sender_.get(),
+                                                 /*include_pending=*/true));
+        }
+        return !modal_.is_null() || response_->has_response();
+      }));
+      if (!response_->has_response()) {
+        android_test::DismissDownloadOpenDialogForTesting(
+            base::android::AttachCurrentThread(), modal_);
+        CHECK(base::test::RunUntil([&] { return response_->has_response(); }));
+      }
+    }
+    if (!modal_.is_null()) {
+      android_test::DismissDownloadOpenDialogForTesting(
+          base::android::AttachCurrentThread(), modal_);
+    }
+    modal_.Reset();
+    base::RunLoop().RunUntilIdle();
+    response_.reset();
+    open_function_.reset();
+    dispatcher_.reset();
+    item_ = nullptr;
+    open_extension_.reset();
+    DownloadExtensionTest::TearDownOnMainThread();
+  }
+
+  TestExtensionDir extension_dir_;
+  scoped_refptr<const Extension> open_extension_;
+  raw_ptr<DownloadItem> item_ = nullptr;
+  std::unique_ptr<ExtensionFunctionDispatcher> dispatcher_;
+  scoped_refptr<DownloadsOpenFunction> open_function_;
+  std::unique_ptr<api_test_utils::SendResponseHelper> response_;
+  base::WeakPtr<content::WebContents> sender_;
+  base::android::ScopedJavaGlobalRef<jobject> modal_;
+};
