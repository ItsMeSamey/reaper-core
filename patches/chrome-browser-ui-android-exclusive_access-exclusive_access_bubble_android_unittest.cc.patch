+TEST_F(ExclusiveAccessBubbleAndroidTest,
+       ContextAppliesCopiedNameOnlyToMatchingExtensionOrigin) {
+  base::test::ScopedFeatureList features;
+  features.InitAndEnableFeature(features::kFullscreenBubbleShowOrigin);
+  const GURL extension_url(
+      "chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/");
+  ExclusiveAccessBubbleParams params;
+  params.type =
+      EXCLUSIVE_ACCESS_BUBBLE_TYPE_EXTENSION_FULLSCREEN_EXIT_INSTRUCTION;
+  params.origin = url::Origin::Create(extension_url);
+  const auto fallback = url_formatter::FormatOriginForSecurityDisplay(
+      params.origin, url_formatter::SchemeDisplay::OMIT_CRYPTOGRAPHIC);
+  const std::u16string name = u"Approved fullscreen extension";
+  auto bridge = std::make_unique<MockBridge>();
+  auto* bridge_ptr = bridge.get();
+  EXPECT_CALL(*bridge_ptr, IsVisible()).WillRepeatedly(Return(false));
+  EXPECT_CALL(*bridge_ptr, IsKeyboardConnected()).WillRepeatedly(Return(false));
+  EXPECT_CALL(
+      *bridge_ptr,
+      Update(l10n_util::GetStringFUTF16(
+          IDS_FULLSCREEN_TOUCH_BASED_EXIT_FULLSCREEN_WITH_ORIGIN, fallback)))
+      .Times(1);
+  EXPECT_CALL(*bridge_ptr, Show()).Times(1);
+  auto bubble = std::make_unique<ExclusiveAccessBubbleAndroid>(
+      params, base::DoNothing(), std::move(bridge));
+  testing::Mock::VerifyAndClearExpectations(bridge_ptr);
+  ExclusiveAccessContextAndroid context;
+  context.SetBrowserFullscreenExtensionIdentity(extension_url, name);
+  context.SetBubbleForTesting(std::move(bubble));
+  params.force_update = true;
+  EXPECT_CALL(*bridge_ptr, IsVisible()).WillOnce(Return(false));
+  EXPECT_CALL(*bridge_ptr, IsKeyboardConnected()).WillOnce(Return(false));
+  EXPECT_CALL(
+      *bridge_ptr,
+      Update(l10n_util::GetStringFUTF16(
+          IDS_FULLSCREEN_TOUCH_BASED_EXIT_FULLSCREEN_WITH_ORIGIN, name)))
+      .Times(1);
+  EXPECT_CALL(*bridge_ptr, Show()).Times(1);
+  EXPECT_CALL(*bridge_ptr, Hide()).Times(1);
+  context.UpdateExclusiveAccessBubble(params, base::DoNothing());
+}
