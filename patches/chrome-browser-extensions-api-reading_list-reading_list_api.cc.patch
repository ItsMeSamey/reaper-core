 //////////////////////////////////////////////////////////////////////////////
 /////////////////////// ReadingListAddEntryFunction //////////////////////////
 //////////////////////////////////////////////////////////////////////////////
 
 ReadingListAddEntryFunction::ReadingListAddEntryFunction() = default;
 ReadingListAddEntryFunction::~ReadingListAddEntryFunction() = default;
+
+#if BUILDFLAG(IS_ANDROID)
+void ReadingListAddEntryFunction::OnBrowserContextShutdown() {
+  reading_list_model_ = nullptr;
+  if (!reading_list_observation_.IsObserving()) {
+    return;
+  }
+  // All keyed services still exist during the shutdown notification. The dual
+  // model does not forward its inner models' shutdown/deletion notifications.
+  reading_list_observation_.Reset();
+  Respond(Error(kReadingListShutdownError));
+  Release();  // Balances the pending-load AddRef() in Run(), exactly once.
+}
+#endif
 
