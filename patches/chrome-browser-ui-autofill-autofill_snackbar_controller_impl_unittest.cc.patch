+#if BUILDFLAG(IS_ANDROID)
+TEST_F(AutofillSnackbarControllerImplTest,
+       RetiredAiRequestsDoNotBlockOrdinarySnackbarOrRetainCallbacks) {
+  base::MockCallback<base::OnceClosure> retired_action;
+  base::MockCallback<base::OnceClosure> retired_dismiss;
+  base::MockCallback<base::OnceClosure> ordinary_action;
+  base::MockCallback<base::OnceClosure> ordinary_dismiss;
+  AutofillSnackbarControllerImpl actual_controller(web_contents());
+
+  EXPECT_CALL(retired_action, Run).Times(0);
+  EXPECT_CALL(retired_dismiss, Run).Times(0);
+  for (AutofillSnackbarType type :
+       {AutofillSnackbarType::kAutofillAiSaveToWalletFailure,
+        AutofillSnackbarType::kAutofillAiFetchEntityFailure}) {
+    actual_controller.ShowWithDurationAndCallback(
+        type, base::Seconds(1), retired_action.Get(), retired_dismiss.Get());
+  }
+  EXPECT_EQ(actual_controller.GetDuration(),
+            AutofillSnackbarControllerImpl::kDefaultSnackbarDuration);
+
+  actual_controller.ShowWithDurationAndCallback(
+      AutofillSnackbarType::kVirtualCard, base::Seconds(3),
+      ordinary_action.Get(), ordinary_dismiss.Get());
+  EXPECT_EQ(actual_controller.GetDuration(), base::Seconds(3));
+  EXPECT_EQ(actual_controller.GetMessageText(),
+            l10n_util::GetStringUTF16(
+                IDS_AUTOFILL_VIRTUAL_CARD_NUMBER_SNACKBAR_MESSAGE_TEXT));
+  EXPECT_EQ(actual_controller.GetActionButtonText(),
+            l10n_util::GetStringUTF16(
+                IDS_AUTOFILL_VIRTUAL_CARD_NUMBER_SNACKBAR_ACTION_TEXT));
+  EXPECT_CALL(ordinary_action, Run).Times(1);
+  actual_controller.OnActionClicked();
+  EXPECT_CALL(ordinary_dismiss, Run).Times(1);
+  actual_controller.OnDismissed();
+  actual_controller.OnDismissed();
+}
+
+TEST_F(AutofillSnackbarControllerImplTest,
+       RetiredPaymentsRequestDoesNotReplaceShowingBnplCardOrCallback) {
+  base::MockCallback<base::OnceClosure> retired_action;
+  base::MockCallback<base::OnceClosure> ordinary_action;
+  AutofillSnackbarControllerImpl actual_controller(web_contents());
+  CreditCard original_card;
+  original_card.set_is_bnpl_card(true);
+  original_card.SetNickname(u"Affirm");
+  actual_controller.ShowPaymentsSnackbar(AutofillSnackbarType::kBnpl,
+                                         original_card, ordinary_action.Get());
+
+  CreditCard rejected_card;
+  rejected_card.set_is_bnpl_card(true);
+  rejected_card.SetNickname(u"Replaced");
+  EXPECT_CALL(retired_action, Run).Times(0);
+  for (AutofillSnackbarType type :
+       {AutofillSnackbarType::kAutofillAiSaveToWalletFailure,
+        AutofillSnackbarType::kAutofillAiFetchEntityFailure}) {
+    actual_controller.ShowPaymentsSnackbar(type, rejected_card,
+                                           retired_action.Get());
+  }
+  EXPECT_EQ(
+      actual_controller.GetMessageText(),
+      l10n_util::GetStringFUTF16(
+          IDS_AUTOFILL_BNPL_FILLED_CARD_SNACKBAR_MESSAGE_TEXT, u"Affirm"));
+  EXPECT_EQ(actual_controller.GetActionButtonText(),
+            l10n_util::GetStringUTF16(
+                IDS_AUTOFILL_VIRTUAL_CARD_NUMBER_SNACKBAR_ACTION_TEXT));
+  EXPECT_CALL(ordinary_action, Run).Times(1);
+  actual_controller.OnActionClicked();
+  actual_controller.OnDismissed();
+}
+#endif  // BUILDFLAG(IS_ANDROID)
