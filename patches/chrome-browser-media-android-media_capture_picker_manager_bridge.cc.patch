+
+bool MediaCapturePickerManagerBridge::IsAllowed(
+    DesktopMediaList::Type type) const {
+  auto* frame = request_document_.AsRenderFrameHostIfValid();
+  if (!frame || !frame->IsActive() || callback_.is_null() ||
+      !(std::ranges::contains(params_.android_allowed_sources, type) ||
+        (type == DesktopMediaList::Type::kWebContents &&
+         std::ranges::contains(params_.android_allowed_sources,
+                               DesktopMediaList::Type::kCurrentTab))))
+    return false;
+  auto* initiator = content::WebContents::FromRenderFrameHost(frame);
+  if (initiator != web_contents())
+    return false;
+  auto level =
+      std::min(params_.allowed_capture_level,
+               capture_policy::GetAllowedCaptureLevel(
+                   frame->GetLastCommittedOrigin().GetURL(), initiator));
+  if (type == DesktopMediaList::Type::kScreen) {
+    return level >= AllowedScreenCaptureLevel::kDesktop &&
+           !params_.exclude_monitor_type_surfaces && !params_.capture_this_tab;
+  }
+  // Public Android screen-consent results do not identify a window versus a
+  // complete display. The open-source picker intentionally offers no windows.
+  return type == DesktopMediaList::Type::kWebContents &&
+         level >= AllowedScreenCaptureLevel::kSameOrigin;
+}
+
+bool MediaCapturePickerManagerBridge::ShouldFilterWebContents(
+    content::WebContents* candidate) {
+  if (!candidate || candidate->IsBeingDestroyed() ||
+      !IsAllowed(DesktopMediaList::Type::kWebContents))
+    return true;
+  auto* frame = request_document_.AsRenderFrameHostIfValid();
+  auto* initiator = content::WebContents::FromRenderFrameHost(frame);
+  if (candidate->GetBrowserContext() != initiator->GetBrowserContext() ||
+      (params_.exclude_self_browser_surface && candidate == initiator) ||
+      ((params_.capture_this_tab ||
+        (!std::ranges::contains(params_.android_allowed_sources,
+                                DesktopMediaList::Type::kWebContents) &&
+         std::ranges::contains(params_.android_allowed_sources,
+                               DesktopMediaList::Type::kCurrentTab))) &&
+       candidate != initiator))
+    return true;
+  if (params_.includable_web_contents_filter &&
+      !params_.includable_web_contents_filter.Run(candidate))
+    return true;
+  auto level =
+      std::min(params_.allowed_capture_level,
+               capture_policy::GetAllowedCaptureLevel(
+                   frame->GetLastCommittedOrigin().GetURL(), initiator));
+  return !capture_policy::GetIncludableWebContentsFilter(
+              frame->GetLastCommittedOrigin().GetURL(), level)
+              .Run(candidate);
+}
