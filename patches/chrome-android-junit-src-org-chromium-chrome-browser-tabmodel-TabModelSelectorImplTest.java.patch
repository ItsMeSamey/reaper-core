+    @Test
+    public void splitRefreshDoesNotWakeHiddenActivity() {
+        Tab first = addSplitVisibilityTab(51);
+        Tab second = addSplitVisibilityTab(52);
+        doReturn(first.getWindowAndroid()).when(second).getWindowAndroid();
+        mRegularTabModel.setIndex(0, TabSelectionType.FROM_USER);
+        mTabModelSelector.requestToShowTab(first, TabSelectionType.FROM_USER);
+        doReturn(true).when(first).isHidden();
+        SplitInfo pair = new SplitInfo(new Token(2, 3), 51, 52, SplitInfo.SIDE_BY_SIDE, 0.5);
+        doReturn(pair).when(mRegularTabModel).getSplitInfoForTab(51);
+        org.mockito.Mockito.clearInvocations(first, second);
+        mTabModelSelector.refreshSplitVisibility();
+        verify(first, never()).show(TabSelectionType.FROM_USER);
+        verify(second, never()).show(TabSelectionType.FROM_USER);
+        doReturn(null).when(mRegularTabModel).getSplitInfoForTab(51);
+        mTabModelSelector.refreshSplitVisibility();
+        verify(first, never()).show(TabSelectionType.FROM_USER);
+        verify(second, never()).show(TabSelectionType.FROM_USER);
+    }
