+    private Tab addSplitVisibilityTab(int id) {
+        Tab tab = mock(Tab.class);
+        when(tab.getId()).thenReturn(id);
+        when(tab.getProfile()).thenReturn(mProfile);
+        when(tab.getUserDataHost()).thenReturn(new UserDataHost());
+        WindowAndroid window = mock(WindowAndroid.class);
+        org.chromium.content_public.browser.WebContents contents =
+                mock(org.chromium.content_public.browser.WebContents.class);
+        when(contents.getTopLevelNativeWindow()).thenReturn(window);
+        doReturn(contents).when(tab).getWebContents();
+        doReturn(window).when(tab).getWindowAndroid();
+        doReturn(false).when(tab).isDetachedFromActivity();
+        doReturn(false).when(tab).isHidden();
+        when(tab.isInitialized()).thenReturn(true);
+        mRegularTabModel.addTab(
+                tab,
+                mRegularTabModel.getCount(),
+                TabLaunchType.FROM_CHROME_UI,
+                TabCreationState.LIVE_IN_BACKGROUND);
+        return tab;
+    }
