+                   .AddAPIPermission("alarms")
+                   .Build();
+  SeedAlarm(extension_->id(), base::Time::Now() + base::Hours(1));
+  SeedAlarm(other->id(), base::Time::Now() + base::Hours(2));
+  Enable(extension_);
+  Enable(other);
+  auto restored = std::make_shared<RestoreCallbackResult>();
+  manager_->GetAlarm(other->id(), "stored", ObserveRestoredAlarm(restored));
+  Disable(extension_);
+  FinishBackendWithoutUi();
+  task_environment()->RunUntilIdle();
+
+  EXPECT_EQ(0, manager_->GetCountForExtension(extension_->id()));
+  EXPECT_EQ(1, restored->calls);
+  EXPECT_EQ(1, restored->released);
+  EXPECT_TRUE(restored->has_alarm);
+}
+
+TEST_F(ExtensionAlarmsStateStoreTest, ReadyCallbackReenablesWithoutOldActions) {
+  SeedAlarm(extension_->id(), base::Time::Now() + base::Hours(1));
+  Enable(extension_);
+  auto first = std::make_shared<RestoreCallbackResult>();
+  auto retired = std::make_shared<RestoreCallbackResult>();
+  auto replacement = std::make_shared<RestoreCallbackResult>();
+  manager_->GetAlarm(
+      extension_->id(), "stored",
+      ObserveRestoredAlarm(
+          first, base::BindLambdaForTesting([this, replacement]() {
+            Disable(extension_);
+            Enable(extension_);
+            manager_->GetAlarm(extension_->id(), "stored",
+                               ObserveRestoredAlarm(replacement));
+          })));
+  manager_->GetAlarm(extension_->id(), "stored", ObserveRestoredAlarm(retired));
+  FinishBackendWithoutUi();
+  task_environment()->RunUntilIdle();
+
+  EXPECT_EQ(1, first->calls);
+  EXPECT_EQ(1, first->released);
+  EXPECT_EQ(0, retired->calls);
+  EXPECT_EQ(1, retired->released);
+  EXPECT_EQ(1, replacement->calls);
+  EXPECT_EQ(1, replacement->released);
+  EXPECT_TRUE(replacement->has_alarm);
+}
+
+TEST_F(ExtensionAlarmsStateStoreTest, ReadyCallbackCanDestroyManager) {
+  SeedAlarm(extension_->id(), base::Time::Now() + base::Hours(1));
+  Enable(extension_);
+  auto first = std::make_shared<RestoreCallbackResult>();
+  auto retired = std::make_shared<RestoreCallbackResult>();
+  manager_->GetAlarm(
+      extension_->id(), "stored",
+      ObserveRestoredAlarm(
+          first, base::BindLambdaForTesting([this]() { DestroyManager(); })));
+  manager_->GetAlarm(extension_->id(), "stored", ObserveRestoredAlarm(retired));
+  FinishBackendWithoutUi();
+  task_environment()->RunUntilIdle();
+
+  EXPECT_FALSE(manager_);
+  EXPECT_EQ(1, first->calls);
+  EXPECT_EQ(1, first->released);
+  EXPECT_EQ(0, retired->calls);
+  EXPECT_EQ(1, retired->released);
+}
+
+TEST_F(ExtensionAlarmsStateStoreTest, UnloadReleasesPendingApiBeforeReenable) {
+  SeedAlarm(extension_->id(), base::Time::Now() + base::Hours(1));
+  Enable(extension_);
+  auto result = std::make_shared<RestoreApiResult>();
+  StartApi(base::MakeRefCounted<ObservedAlarmsClearAllFunction>(result),
+           base::ListValue(), result);
+  // StartApi has released its external reference; only the real ready action
+  // owns the API function now. Its destruction is legal while disabled.
+  EXPECT_FALSE(result->destroyed);
+  Disable(extension_);
+  EXPECT_TRUE(result->destroyed);
+  EXPECT_EQ(0, result->successful_responses);
+  // DCHECK builds may synthesize a failure in ExtensionFunction's destructor;
+  // this test intentionally does not assert a build-dependent callback count.
+  Enable(extension_);
+  FinishBackendWithoutUi();
+  task_environment()->RunUntilIdle();
+
+  EXPECT_EQ(0, result->successful_responses);
+  EXPECT_TRUE(FindAlarm(extension_->id()));
+  EXPECT_EQ(1u, ReadStoredAlarms(extension_->id()).size());
+}
+
+TEST_F(ExtensionAlarmsStateStoreTest, DestroyedManagerDropsRealPendingRead) {
+  SeedAlarm(extension_->id(), base::Time::Now() + base::Hours(1));
+  Enable(extension_);
+  auto retired = std::make_shared<RestoreCallbackResult>();
+  manager_->GetAlarm(extension_->id(), "stored", ObserveRestoredAlarm(retired));
+  DestroyManager();
+  EXPECT_EQ(0, retired->calls);
+  EXPECT_EQ(1, retired->released);
+  FinishBackendWithoutUi();
+  task_environment()->RunUntilIdle();
+
+  EXPECT_EQ(0, retired->calls);
+  EXPECT_EQ(1, retired->released);
+  EXPECT_EQ(1u, ReadStoredAlarms(extension_->id()).size());
+}
