+TEST_F(ExtensionAlarmsSchedulingTest,
+       EffectiveRepeatIntervalPreservesRequestedPeriod) {
+  const base::TimeDelta minimum = alarms_api_constants::GetMinimumDelay(
+      Manifest::IsUnpackedLocation(extension()->location()),
+      extension()->manifest_version());
+  ASSERT_GT(minimum, base::TimeDelta());
+  const base::Time start = base::Time::FromSecondsSinceUnixEpoch(10);
+  for (const base::TimeDelta requested :
+       {minimum / 2, minimum, minimum * 2}) {
+    test_clock_.SetNow(start);
+    alarm_manager_->last_poll_times_.clear();
+    alarm_delegate_->alarms_seen.clear();
+
+    api::alarms::AlarmCreateInfo info;
+    info.name = "repeat";
+    info.when = start.InMillisecondsFSinceUnixEpoch();
+    info.period_in_minutes = requested.InSecondsF() / 60.0;
+    const double requested_minutes = *info.period_in_minutes;
+    alarm_manager_->AddAlarm(extension()->id(),
+                             Alarm(info, minimum, test_clock_.Now()),
+                             base::DoNothing());
+    alarm_manager_->PollAlarms();
+    ASSERT_EQ(1u, alarm_delegate_->alarms_seen.size());
+
+    const base::TimeDelta effective = std::max(minimum, requested);
+    base::test::TestFuture<Alarm*> alarm_future;
+    alarm_manager_->GetAlarm(extension()->id(), "repeat",
+                             alarm_future.GetCallback());
+    Alarm* alarm = alarm_future.Get();
+    ASSERT_TRUE(alarm);
+    ASSERT_TRUE(alarm->js_alarm->period_in_minutes);
+    EXPECT_DOUBLE_EQ(requested_minutes, *alarm->js_alarm->period_in_minutes);
+    EXPECT_DOUBLE_EQ((start + effective).InMillisecondsFSinceUnixEpoch(),
+                     alarm->js_alarm->scheduled_time);
+    EXPECT_EQ(start + effective, alarm_manager_->next_poll_time_);
+
+    // A delayed poll skips missed occurrences but retains the original phase.
+    test_clock_.Advance(effective * 2 + effective / 2);
+    alarm_manager_->PollAlarms();
+    EXPECT_EQ(2u, alarm_delegate_->alarms_seen.size());
+    EXPECT_DOUBLE_EQ((start + effective * 3).InMillisecondsFSinceUnixEpoch(),
+                     alarm->js_alarm->scheduled_time);
+    EXPECT_DOUBLE_EQ(requested_minutes, *alarm->js_alarm->period_in_minutes);
+    RemoveAlarm("repeat");
+  }
+}
+#endif  // BUILDFLAG(IS_ANDROID)
