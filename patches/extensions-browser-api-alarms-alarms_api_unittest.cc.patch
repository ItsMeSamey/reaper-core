+           first);
+  StartApi(base::MakeRefCounted<AlarmsCreateFunction>(),
+           base::test::ParseJsonList(R"(["second", {"delayInMinutes": 120}])"),
+           second);
+  FinishBackendWithoutUi();
+  task_environment()->RunUntilIdle();
