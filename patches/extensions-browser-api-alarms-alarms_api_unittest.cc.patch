+TEST_F(ExtensionAlarmsStateStoreTest, CreateChecksQuotaAfterInitialRestore) {
+  const base::ListValue original =
+      SeedAlarms(AlarmManager::kMaxAlarmsPerExtension);
+  Enable(extension_);
+  auto result = std::make_shared<RestoreApiResult>();
+  StartApi(base::MakeRefCounted<AlarmsCreateFunction>(),
+           base::test::ParseJsonList(
+               R"(["extra", {"delayInMinutes": 120}])"),
+           result);
+  EXPECT_EQ(0, result->successful_responses);
+  EXPECT_EQ(0, result->failed_responses);
+  FinishBackendWithoutUi();
+  EXPECT_EQ(0, result->successful_responses);
+  EXPECT_EQ(0, result->failed_responses);
+  task_environment()->RunUntilIdle();
+
+  EXPECT_EQ(0, result->successful_responses);
+  EXPECT_EQ(1, result->failed_responses);
+  EXPECT_EQ("An extension cannot have more than 500 active alarms.",
+            result->error);
+  EXPECT_EQ(AlarmManager::kMaxAlarmsPerExtension,
+            manager_->GetCountForExtension(extension_->id()));
+  EXPECT_FALSE(FindAlarm(extension_->id(), "extra"));
+  EXPECT_EQ(original, ReadStoredAlarms(extension_->id()));
+}
