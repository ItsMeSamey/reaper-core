+// These tests retain the real StateStore frontend, sequenced backend, registry
+// notifications, AlarmManager and event delegate/router. Only the value-store
+// storage implementation is in memory. No restore callback is invoked directly.
+class ExtensionAlarmsStateStoreTest : public ExtensionsTest {
+ public:
+  ExtensionAlarmsStateStoreTest()
+      : ExtensionsTest(content::BrowserTaskEnvironment::TimeSource::MOCK_TIME) {
+  }
+
+ protected:
+  void SetUp() override {
+    ExtensionsTest::SetUp();
+    extensions_browser_client()->set_extension_system_factory(&system_factory_);
+    store_ = ExtensionSystem::Get(browser_context())->state_store();
+    ASSERT_TRUE(store_);
+    ASSERT_TRUE(store_->IsInitialized());
+
+    auto* router = static_cast<EventRouter*>(
+        EventRouterFactory::GetInstance()->SetTestingFactoryAndUse(
+            browser_context(),
+            base::BindOnce([](content::BrowserContext* context)
+                               -> std::unique_ptr<KeyedService> {
+              return std::make_unique<EventRouter>(
+                  context, ExtensionPrefs::Get(context));
+            })));
+    event_observer_ = std::make_unique<TestEventRouterObserver>(router);
+    manager_ = static_cast<AlarmManager*>(
+        AlarmManager::GetFactoryInstance()->SetTestingFactoryAndUse(
+            browser_context(),
+            base::BindOnce([](content::BrowserContext* context)
+                               -> std::unique_ptr<KeyedService> {
+              return std::make_unique<AlarmManager>(context);
+            })));
+    dispatcher_ =
+        std::make_unique<ExtensionFunctionDispatcher>(browser_context());
+    extension_ = ExtensionBuilder("Persistent alarms")
+                     .SetManifestVersion(3)
+                     .AddAPIPermission("alarms")
+                     .Build();
+  }
+
+  void TearDown() override {
+    // Retire any API callbacks while their extension is actually disabled.
+    std::vector<scoped_refptr<const Extension>> enabled;
+    for (const auto& extension : registry()->enabled_extensions()) {
+      enabled.push_back(extension);
+    }
+    for (const auto& extension : enabled) {
+      Disable(extension);
+    }
+    DestroyManager();
+    task_environment()->RunUntilIdle();
+    dispatcher_.reset();
+    event_observer_.reset();
+    extension_.reset();
+    store_ = nullptr;
+    ExtensionsTest::TearDown();
+  }
+
+  ExtensionRegistry* registry() {
+    return ExtensionRegistry::Get(browser_context());
+  }
+
+  void Enable(const scoped_refptr<const Extension>& extension) {
+    registry()->RemoveDisabled(extension->id());
+    CHECK(registry()->AddEnabled(extension));
+    registry()->TriggerOnLoaded(extension.get());
+  }
+
+  void Disable(const scoped_refptr<const Extension>& extension) {
+    CHECK(registry()->AddDisabled(extension));
+    CHECK(registry()->RemoveEnabled(extension->id()));
+    registry()->TriggerOnUnloaded(extension.get(),
+                                  UnloadedExtensionReason::DISABLE);
+  }
+
+  void DestroyManager() {
+    manager_ = nullptr;
+    AlarmManager::GetFactoryInstance()->SetTestingFactory(browser_context(),
+                                                          {});
+  }
+
+  // Finish backend operations without pumping UI. Thus both GetA and GetB can
+  // own real old snapshots before callbackA runs any queued API action.
+  void FinishBackendWithoutUi() {
+    auto marker = std::make_shared<base::WaitableEvent>();
+    CHECK(GetExtensionFileTaskRunner()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](std::shared_ptr<base::WaitableEvent> marker) {
+                         marker->Signal();
+                       },
+                       marker)));
+    base::ScopedAllowBaseSyncPrimitivesForTesting allow_wait;
+    CHECK(marker->TimedWait(TestTimeouts::action_timeout()));
+  }
+
+  void SeedAlarm(const ExtensionId& id, base::Time when) {
+    base::ListValue alarms;
+    alarms.Append(
+        base::DictValue()
+            .Set("name", "stored")
+            .Set("scheduledTime", when.InMillisecondsFSinceUnixEpoch())
+            .Set("persistAcrossSessions", true));
+    store_->SetExtensionValue(id, "alarms", base::Value(std::move(alarms)));
+    FinishBackendWithoutUi();
+  }
+
+  base::ListValue SeedAlarms(int count) {
+    base::ListValue alarms;
+    const double when =
+        (base::Time::Now() + base::Hours(1)).InMillisecondsFSinceUnixEpoch();
+    for (int i = 0; i < count; ++i) {
+      alarms.Append(base::DictValue()
+                        .Set("name", "stored-" + std::to_string(i))
+                        .Set("scheduledTime", when)
+                        .Set("persistAcrossSessions", true));
+    }
+    store_->SetExtensionValue(extension_->id(), "alarms",
+                              base::Value(alarms.Clone()));
+    FinishBackendWithoutUi();
+    return alarms;
+  }
+
+  base::ListValue ReadStoredAlarms(const ExtensionId& id) {
+    base::test::TestFuture<std::optional<base::Value>> value;
+    store_->GetExtensionValue(id, "alarms", value.GetCallback());
+    CHECK(value.Wait());
+    CHECK(value.Get());
+    CHECK(value.Get()->is_list());
+    return value.Get()->GetList().Clone();
+  }
+
+  Alarm* FindAlarm(const ExtensionId& id,
+                   const std::string& name = "stored") {
+    base::test::TestFuture<Alarm*> result;
+    manager_->GetAlarm(id, name, result.GetCallback());
+    return result.Get();
+  }
+
+  void StartApi(scoped_refptr<ExtensionFunction> function,
+                base::ListValue args,
+                std::shared_ptr<RestoreApiResult> result) {
+    function->set_extension(extension_.get());
+    function->SetDispatcher(dispatcher_->AsWeakPtr());
+    function->SetArgs(std::move(args));
+    function->set_has_callback(true);
+    function->set_response_callback(base::BindOnce(
+        [](std::shared_ptr<RestoreApiResult> result,
+           ExtensionFunction::ResponseType response, base::ListValue values,
+           const std::string& error, mojom::ExtraResponseDataPtr extra) {
+          if (response == ExtensionFunction::ResponseType::kSucceeded) {
+            ++result->successful_responses;
+            result->values = std::move(values);
+          } else {
+            ++result->failed_responses;
+            result->error = error;
+          }
+        },
+        std::move(result)));
+    function->RunWithValidation().Execute();
+  }
+
+  MockExtensionSystemFactory<AlarmStateStoreExtensionSystem> system_factory_;
+  raw_ptr<StateStore> store_ = nullptr;
+  raw_ptr<AlarmManager> manager_ = nullptr;
+  std::unique_ptr<TestEventRouterObserver> event_observer_;
+  std::unique_ptr<ExtensionFunctionDispatcher> dispatcher_;
+  scoped_refptr<const Extension> extension_;
+};
