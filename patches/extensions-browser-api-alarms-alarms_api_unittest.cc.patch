+struct RestoreCallbackResult {
+  int calls = 0;
+  int released = 0;
+  bool has_alarm = false;
+  double scheduled_time = 0;
+};
+
+AlarmManager::GetAlarmCallback ObserveRestoredAlarm(
+    std::shared_ptr<RestoreCallbackResult> result,
+    base::OnceClosure action = {}) {
+  base::ScopedClosureRunner release(base::BindOnce(
+      [](std::shared_ptr<RestoreCallbackResult> result) { ++result->released; },
+      result));
+  return base::BindOnce(
+      [](std::shared_ptr<RestoreCallbackResult> result,
+         base::ScopedClosureRunner release, base::OnceClosure action,
+         Alarm* alarm) {
+        ++result->calls;
+        result->has_alarm = alarm != nullptr;
+        if (alarm) {
+          result->scheduled_time = alarm->js_alarm->scheduled_time;
+        }
+        if (action) {
+          std::move(action).Run();
+        }
+      },
+      std::move(result), std::move(release), std::move(action));
+}
+
+struct RestoreApiResult {
+  int successful_responses = 0;
+  int failed_responses = 0;
+  std::string error;
+  bool destroyed = false;
+  base::ListValue values;
+};
+
