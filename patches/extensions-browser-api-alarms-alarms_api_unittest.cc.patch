+  Disable(extension_);
+  Enable(extension_);
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(AlarmManager::kMaxAlarmsPerExtension,
+            manager_->GetCountForExtension(extension_->id()));
+  EXPECT_TRUE(FindAlarm(extension_->id(), "first"));
+  EXPECT_FALSE(FindAlarm(extension_->id(), "second"));
+}
