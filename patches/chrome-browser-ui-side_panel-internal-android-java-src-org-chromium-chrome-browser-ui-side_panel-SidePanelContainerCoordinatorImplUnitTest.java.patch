+    @Test
+    @Config(sdk = {33, 34})
+    public void testDestroyCompletesDeferredReplacementOnceBeforeBridgeRemoval() {
+        try (var fixture = new ReplacementFixture()) {
+            var oldView = new View(fixture.activityController.get());
+            var nextView = fixture.replace(oldView);
+            Runnable lateFrame = nextView.nextFrame();
+            when(fixture.tabModel.getProfile())
+                    .thenReturn(null);
+            doAnswer(invocation -> {
+                fixture.coordinator.startOpeningPanel(new SidePanelContent(new View(
+                        fixture.activityController.get())), true);
+                fixture.coordinator.startReplacingPanelContent(new SidePanelContent(
+                        new DeferredFrameView(fixture.activityController.get())));
+                return null;
+            }).when(fixture.nativeCoordinator).onPanelContentReplaced(NATIVE_COORDINATOR);
+
+            fixture.coordinator.destroy();
+            fixture.coordinator.destroy();
+            assertNull(fixture.coordinator.getContentView());
+            assertNull(oldView.getParent());
+            assertNull(nextView.getParent());
+            lateFrame.run();
+            lateFrame.run();
+            verify(fixture.nativeCoordinator, times(1))
+                    .onPanelContentReplaced(NATIVE_COORDINATOR);
+            verify(fixture.sideUi, times(1)).unregisterSideUiContainer(fixture.coordinator);
+        }
+    }
+
+    @Test
+    @Config(sdk = {33, 34})
+    public void testCompletionPreservesReentrantDeferredReplacement() {
+        try (var fixture = new ReplacementFixture()) {
+            var oldView = new View(fixture.activityController.get());
+            var firstView = fixture.replace(oldView);
+            var secondView = new DeferredFrameView(fixture.activityController.get());
+            int[] completions = {0};
+            doAnswer(invocation -> {
+                if (++completions[0] == 1) {
+                    fixture.coordinator.startReplacingPanelContent(
+                            new SidePanelContent(secondView));
+                }
+                return null;
+            }).when(fixture.nativeCoordinator).onPanelContentReplaced(NATIVE_COORDINATOR);
+
+            fixture.coordinator.completePendingContentReplacement();
+            assertNull(oldView.getParent());
+            assertNotNull(firstView.getParent());
+            assertNotNull(secondView.nextFrame());
+            assertEquals(secondView, fixture.coordinator.getContentView());
+            fixture.coordinator.completePendingContentReplacement();
+            assertNull(firstView.getParent());
+            assertNotNull(secondView.getParent());
+            firstView.nextFrame().run();
+            secondView.nextFrame().run();
+            verify(fixture.nativeCoordinator, times(2))
+                    .onPanelContentReplaced(NATIVE_COORDINATOR);
+        }
+    }
