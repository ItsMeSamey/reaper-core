+    private static final int TASK_ID = 204067;
+    private static final long NATIVE_COORDINATOR = 204;
+
+    public static class TestActivity extends Activity {
+        @Override
+        public int getTaskId() {
+            return TASK_ID;
+        }
+    }
+
+    /** A real View which queues only the native successful-presentation boundary. */
+    private static class DeferredFrameView extends FrameLayout implements ThinWebView {
+        private Runnable mNextFrame;
+
+        DeferredFrameView(Activity activity) {
+            super(activity);
+        }
+
+        @Override
+        public View getView() {
+            return this;
+        }
+
+        @Override
+        public void attachWebContents(
+                WebContents webContents, View contentView, ThinWebViewAttachParams attachParams) {}
+
+        @Override
+        public void runOnNextFrame(Runnable runnable) {
+            mNextFrame = runnable;
+        }
+
+        Runnable nextFrame() {
+            assertNotNull(mNextFrame);
+            return mNextFrame;
+        }
+
+        @Override
+        public void resizeWebContents(int width, int height) {}
+
+        @Override
+        public void destroy() {}
+    }
