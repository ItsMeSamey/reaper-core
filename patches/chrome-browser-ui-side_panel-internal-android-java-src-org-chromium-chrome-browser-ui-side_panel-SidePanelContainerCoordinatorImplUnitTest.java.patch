+    private static class ReplacementFixture implements AutoCloseable {
+        final ActivityController<TestActivity> activityController;
+        final ChromeAndroidTaskUnitTestSupport.ChromeAndroidTaskWithMockDeps task;
+        final ChromeAndroidTask chromeTask;
+        final TabModelSelector tabModelSelector = mock(TabModelSelector.class);
+        final TabModel tabModel = mock(TabModel.class);
+        final WeakReference<Activity> originalActivity;
+        final SideUiCoordinator sideUi = mock(SideUiCoordinator.class);
+        final SidePanelCoordinatorAndroidBridge.Natives nativeCoordinator =
+                mock(SidePanelCoordinatorAndroidBridge.Natives.class);
+        final SidePanelContainerCoordinatorImpl coordinator;
+
+        ReplacementFixture() {
+            activityController = Robolectric.buildActivity(TestActivity.class);
+            activityController.get().setTheme(R.style.Theme_BrowserUI_DayNight);
+            activityController.setup();
+            task = ChromeAndroidTaskUnitTestSupport.createChromeAndroidTaskWithMockDeps(
+                    TASK_ID, /* isPendingTask= */ false, /* isDesktopMode= */ false);
+            var window = task.mActivityWindowAndroidMocks.mMockActivityWindowAndroid;
+            var tracker = ChromeAndroidTaskTrackerFactory.getInstance();
+            tracker.remove(TASK_ID);
+            when(tabModel.getProfile()).thenReturn(task.mMockProfile);
+            SettableMonotonicObservableSupplier<TabModel> tabModelSupplier =
+                    ObservableSuppliers.createMonotonic();
+            tabModelSupplier.set(tabModel);
+            when(tabModelSelector.getModel(false)).thenReturn(tabModel);
+            when(tabModelSelector.getCurrentTabModelSupplier()).thenReturn(tabModelSupplier);
+            when(tabModelSelector.getCurrentModel()).thenReturn(tabModel);
+            var incognitoTabModel = mock(IncognitoTabModel.class);
+            when(tabModelSelector.getModel(true)).thenReturn(incognitoTabModel);
+            when(tabModelSelector.getModels()).thenReturn(List.of(tabModel, incognitoTabModel));
+            when(incognitoTabModel.getProfile()).thenReturn(null);
+            chromeTask = tracker.obtainTask(
+                    BrowserWindowType.NORMAL,
+                    new ChromeAndroidTask.ActivityScopedObjects(
+                            window, tabModelSelector, BrowserWindowType.NORMAL,
+                            SupportedProfileType.REGULAR, mock(DesktopWindowStateManager.class)),
+                    /* pendingId= */ null);
+            assertNotNull(chromeTask);
+            originalActivity = window.getActivity();
+            when(window.getActivity()).thenReturn(new WeakReference<>(activityController.get()));
+
+            SidePanelContainerCoordinatorImpl createdCoordinator = null;
+            try {
+                var registryNative = mock(WindowScopedSidePanelRegistryBridge.Natives.class);
+                when(registryNative.create(any(), anyLong())).thenReturn(1L);
+                WindowScopedSidePanelRegistryBridgeJni.setInstanceForTesting(registryNative);
+                when(nativeCoordinator.create(any(), anyLong())).thenReturn(NATIVE_COORDINATOR);
+                SidePanelCoordinatorAndroidBridgeJni.setInstanceForTesting(nativeCoordinator);
+
+                chromeTask.addFeature(
+                        new ChromeAndroidTaskFeatureKey(
+                                ExtensionSidePanelManagerBridge.class,
+                                task.mMockProfile,
+                                window,
+                                tabModel),
+                        () -> mock(ExtensionSidePanelManagerBridge.class));
+                createdCoordinator = new SidePanelContainerCoordinatorImpl(
+                        window, sideUi, tabModelSelector, mock(TopControlsStacker.class));
+                createdCoordinator.init();
+                createdCoordinator.configDeferredViewReplacementForTesting(true);
+                coordinator = createdCoordinator;
+            } catch (RuntimeException | Error failure) {
+                try {
+                    closeFixture(createdCoordinator);
+                } catch (RuntimeException | Error cleanupFailure) {
+                    failure.addSuppressed(cleanupFailure);
+                }
+                throw failure;
+            }
+        }
+
+        DeferredFrameView replace(View oldView) {
+            coordinator.startOpeningPanel(new SidePanelContent(oldView), true);
+            var next = new DeferredFrameView(activityController.get());
+            coordinator.startReplacingPanelContent(new SidePanelContent(next));
+            assertNotNull(next.nextFrame());
+            return next;
+        }
+
+        private void closeFixture(SidePanelContainerCoordinatorImpl createdCoordinator) {
+            try {
+                when(tabModel.getProfile()).thenReturn(task.mMockProfile);
+                if (createdCoordinator != null) createdCoordinator.destroy();
+            } finally {
+                // The task registered with this original Activity's lifecycle dispatcher.
+                when(task.mActivityWindowAndroidMocks.mMockActivityWindowAndroid.getActivity())
+                        .thenReturn(originalActivity);
+                try {
+                    ChromeAndroidTaskTrackerFactory.getInstance().remove(TASK_ID);
+                } finally {
+                    activityController.pause().stop().destroy();
+                }
+            }
+        }
