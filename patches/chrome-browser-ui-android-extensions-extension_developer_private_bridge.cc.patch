+// Only live-process callbacks reside here. Neither a pointer nor this map is
+// serialized.
+struct PendingUnpackedImport {
+  base::WeakPtr<content::WebContents> source;
+  ExtensionDeveloperPrivateBridge::UnpackedSelectionCallback callback;
+};
+
+std::map<std::string, PendingUnpackedImport>& PendingImports() {
+  static base::NoDestructor<std::map<std::string, PendingUnpackedImport>>
+      pending;
+  return *pending;
+}
+
+void CompleteJavaImport(const std::string& id, std::string error) {
+  Java_ReaperExtensionImportCoordinator_onNativeComplete(
+      base::android::AttachCurrentThread(), id, error);
+}
+
+bool IsExtensionsManager(content::WebContents* source) {
+  if (!source || source->IsBeingDestroyed())
+    return false;
+  auto* frame = source->GetPrimaryMainFrame();
+  if (!frame || !frame->IsActive() || !frame->IsRenderFrameLive())
+    return false;
+  const GURL& url = source->GetLastCommittedURL();
+  return url.SchemeIs(content::kChromeUIScheme) &&
+         url.host() == chrome::kChromeUIExtensionsHost;
+}
+
+void FinishImportError(const std::string& id, const std::string& error) {
+  auto node = PendingImports().extract(id);
+  if (!node.empty()) {
+    const bool original_can_report =
+        IsExtensionsManager(node.mapped().source.get());
+    if (!original_can_report)
+      CompleteJavaImport(id, error);
+    const std::string display_error =
+        Java_ReaperExtensionImportCoordinator_localizeError(
+            base::android::AttachCurrentThread(), error);
+    std::move(node.mapped().callback).Run(base::FilePath(), display_error);
+    // A live original WebUI reports the error; a destroyed page cannot do so.
+    if (original_can_report)
+      CompleteJavaImport(id, std::string());
+  } else {
+    CompleteJavaImport(id, error);
+  }
+}
+
+}  // namespace
+
+ExtensionDeveloperPrivateBridge::UnpackedInstallCompletion
+ExtensionDeveloperPrivateBridge::MakeUnpackedImportCompletion(
+    base::OnceCallback<void(std::string)> terminal) {
+  auto callbacks = base::SplitOnceCallback(std::move(terminal));
+  base::ScopedClosureRunner abandoned(base::BindPostTaskToCurrentDefault(
+      base::BindOnce(std::move(callbacks.second),
+                     std::string("reaper.import.interrupted"))));
+  return base::BindOnce(
+      [](base::OnceCallback<void(std::string)> completed,
+         base::ScopedClosureRunner abandoned, const Extension* extension,
+         const base::FilePath& path, const std::u16string& error) {
+        static_cast<void>(abandoned.Release());
+        std::move(completed).Run(extension ? std::string()
+                                           : base::UTF16ToUTF8(error));
+      },
+      std::move(callbacks.first), std::move(abandoned));
+}
+
+// Shared with the ordinary developerPrivate entry so restoration cannot omit
+// its checks.
+std::string ExtensionDeveloperPrivateBridge::UnpackedImportPolicyError(
+    Profile* profile) {
+  if (!profile)
+    return "Could not find the original profile.";
+  if (supervised_user::AreExtensionsPermissionsEnabled(profile)) {
+    return "Child account users cannot load unpacked extensions.";
+  }
+  if (!profile->GetPrefs()->GetBoolean(prefs::kExtensionsUIDeveloperMode)) {
+    return "Must be in developer mode to load unpacked extensions.";
+  }
+  if (ExtensionManagementFactory::GetForBrowserContext(profile)
+          ->BlocklistedByDefault()) {
+    return "Extension installation is blocked by policy.";
+  }
+  return {};
+}
+
+bool ExtensionDeveloperPrivateBridge::StartUnpackedImport(
+    content::WebContents* source,
+    UnpackedSelectionCallback callback,
+    std::string* request_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto* tab = source ? TabAndroid::FromWebContents(source) : nullptr;
+  auto* window = source ? source->GetTopLevelNativeWindow() : nullptr;
+  auto* profile = source
+                      ? Profile::FromBrowserContext(source->GetBrowserContext())
+                      : nullptr;
+  if (!tab || !window || !IsExtensionsManager(source) || !profile ||
+      profile->IsOffTheRecord() ||
+      !UnpackedImportPolicyError(profile).empty()) {
+    return false;
+  }
+  ChromeSelectFilePolicy picker_policy(source);
+  if (!picker_policy.CanOpenSelectFileDialog()) {
+    picker_policy.SelectFileDenied();
+    return false;
+  }
+  const std::string id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  PendingImports().emplace(
+      id, PendingUnpackedImport{source->GetWeakPtr(), std::move(callback)});
+  const bool started = Java_ReaperExtensionImportCoordinator_start(
+      base::android::AttachCurrentThread(), window->GetJavaObject(),
+      source->GetJavaWebContents(), id, profile->GetBaseName().AsUTF8Unsafe(),
+      profile->GetCreationTime().ToDeltaSinceWindowsEpoch().InMicroseconds(),
+      tab->GetAndroidId(),
+      base::FeatureList::IsEnabled(ui::kCheckIntentCallerPermission));
+  if (!started) {
+    PendingImports().erase(id);
+    return false;
+  }
+  *request_id = id;
+  return true;
+}
+
+void ExtensionDeveloperPrivateBridge::ForgetUnpackedImport(
+    const std::string& id) {
+  PendingImports().erase(id);
+}
+
+void ExtensionDeveloperPrivateBridge::CompleteUnpackedImport(
+    const std::string& id,
+    const std::string& error) {
+  PendingImports().erase(id);
+  if (!id.empty())
+    CompleteJavaImport(id, error);
+}
