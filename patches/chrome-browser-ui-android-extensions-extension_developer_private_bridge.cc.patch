+// Java calls only for its own recorded request and a matching RESULT_OK
+// receipt, never because a persisted URI grant happens to exist. DISPATCHING
+// after process loss is an interrupted operation, not permission to repeat an
+// install of uncertain outcome.
+static int32_t JNI_ReaperExtensionImportCoordinator_Resume(
+    JNIEnv* env,
+    content::WebContents* source,
+    int32_t tab_id,
+    const std::string& id,
+    const std::string& profile_name,
+    int64_t profile_creation,
+    int32_t state,
+    const std::string& uri) {
+  constexpr int kDeferred = 0;
+  constexpr int kStarted = 1;
+  constexpr int kFinished = 2;
+  constexpr int kApproved = 2;
+  constexpr int kCancelled = 3;
+  constexpr int kFailed = 4;
+  constexpr int kInterrupted = 5;
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto* tab = source ? TabAndroid::FromWebContents(source) : nullptr;
+  auto* profile = source
+                      ? Profile::FromBrowserContext(source->GetBrowserContext())
+                      : nullptr;
+  if (!source || source->IsBeingDestroyed() || !tab || !profile ||
+      tab->GetAndroidId() != tab_id ||
+      profile->GetBaseName().AsUTF8Unsafe() != profile_name ||
+      profile->GetCreationTime().ToDeltaSinceWindowsEpoch().InMicroseconds() !=
+          profile_creation) {
+    return kDeferred;
+  }
+  // A restored tab may not have created/committed its WebUI yet. The activity
+  // tab observer retries on content/page readiness; do not mislabel startup as
+  // a changed source.
+  auto* frame = source->GetPrimaryMainFrame();
+  if (!frame || !frame->IsRenderFrameLive() ||
+      source->GetLastCommittedURL().is_empty()) {
+    return kDeferred;
+  }
+  if (!base::Uuid::ParseLowercase(id).is_valid() || profile->IsOffTheRecord() ||
+      !IsExtensionsManager(source)) {
+    FinishImportError(id, "reaper.import.source_changed");
+    return kFinished;
+  }
+  if (state != kApproved) {
+    if (state == kCancelled) {
+      auto cancelled = PendingImports().extract(id);
+      if (!cancelled.empty()) {
+        std::move(cancelled.mapped().callback)
+            .Run(base::FilePath(), "File selection was canceled.");
+      }
+      CompleteJavaImport(id, std::string());
+      return kFinished;
+    }
+    if (state == kFailed || state == kInterrupted) {
+      FinishImportError(id, "reaper.import.interrupted");
+      return kFinished;
+    }
+    return kDeferred;
+  }
+  const std::string policy_error =
+      ExtensionDeveloperPrivateBridge::UnpackedImportPolicyError(profile);
+  if (!policy_error.empty()) {
+    FinishImportError(id, policy_error);
+    return kFinished;
+  }
+  if (!ChromeSelectFilePolicy::FileSelectDialogsAllowed()) {
+    FinishImportError(id, "reaper.import.file_policy_blocked");
+    return kFinished;
+  }
+  const base::FilePath selected(uri);
+  if (!selected.IsContentUri()) {
+    FinishImportError(id, "reaper.import.folder_unavailable");
+    return kFinished;
+  }
+  auto live = PendingImports().extract(id);
+  if (!live.empty() && live.mapped().source.get() == source) {
+    std::move(live.mapped().callback).Run(selected, std::string());
+    return kStarted;
+  }
+  if (!live.empty()) {
+    // Notify the resumed manager before retiring the old callback: its Finish()
+    // also clears the receipt and the old page may no longer render any error.
+    CompleteJavaImport(id, "reaper.import.source_changed");
+    std::move(live.mapped().callback)
+        .Run(base::FilePath(), "The original extension page was recreated.");
+    return kFinished;
+  }
+  auto virtual_path = base::ResolveToVirtualDocumentPath(selected);
+  if (!virtual_path) {
+    FinishImportError(id, "reaper.import.folder_unavailable");
+    return kFinished;
+  }
+  auto installer = UnpackedInstaller::Create(profile);
+  installer->set_be_noisy_on_failure(false);
+  // Shutdown may drop rather than invoke UnpackedInstaller's callback.
+  installer->set_completion_callback(
+      ExtensionDeveloperPrivateBridge::MakeUnpackedImportCompletion(
+          base::BindOnce(&CompleteJavaImport, id)));
+  installer->Load(*virtual_path);
+  return kStarted;
+}
+
+// Retire-only operation, invoked only after Java's explicit cancellation
+// confirmation. A closed/replaced original tab must not permanently block all
+// future imports. This path never resolves a URI, creates an installer or
+// activates the old profile.
+static bool JNI_ReaperExtensionImportCoordinator_Discard(
+    JNIEnv* env,
+    content::WebContents* source,
+    int32_t current_tab_id,
+    const std::string& id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto* tab = source ? TabAndroid::FromWebContents(source) : nullptr;
+  if (!tab || tab->GetAndroidId() != current_tab_id ||
+      !IsExtensionsManager(source) ||
+      !base::Uuid::ParseLowercase(id).is_valid()) {
+    return false;
+  }
+  auto node = PendingImports().extract(id);
+  if (!node.empty()) {
+    std::move(node.mapped().callback)
+        .Run(base::FilePath(), "File selection was canceled.");
+  }
+  CompleteJavaImport(id, std::string());
+  return true;
+}
 
