+TEST_F(WebstorePrivateBeginInstallWithManifest3Test,
+       EnterpriseRequestUnavailablePreservesPolicyAndOrdinaryInstall) {
+  EnableExtensionRequest(true);
+  VerifyPendingList({}, profile());
+  auto web_contents = CreateSenderWebContents(profile());
+  auto function =
+      base::MakeRefCounted<WebstorePrivateBeginInstallWithManifest3Function>();
+  function->SetRenderFrameHost(web_contents->GetPrimaryMainFrame());
+  const int approvals_before = WebstorePrivateApi::GetPendingApprovalsCountForTesting();
+  {
+    ScopedTestDialogAutoConfirm auto_confirm(ScopedTestDialogAutoConfirm::ACCEPT);
+    api_test_utils::RunFunction(function.get(),
+                                GenerateArgs(kExtensionId, kExtensionManifest),
+                                profile());
+  }
+  VerifyBlockedByPolicyFunctionResult(function.get(), std::u16string());
+  VerifyPendingList({}, profile());
+  EXPECT_EQ(WebstorePrivateApi::GetPendingApprovalsCountForTesting(), approvals_before);
+
+  // Removing report transmission does not bypass the policy or disable normal consent.
+  EnableExtensionRequest(false);
+  function =
+      base::MakeRefCounted<WebstorePrivateBeginInstallWithManifest3Function>();
+  function->SetRenderFrameHost(web_contents->GetPrimaryMainFrame());
+  {
+    ScopedTestDialogAutoConfirm auto_confirm(ScopedTestDialogAutoConfirm::ACCEPT);
+    auto response = RunFunctionAndReturnValue(
+        function.get(), GenerateArgs(kExtensionId, kExtensionManifest));
+    ASSERT_TRUE(response);
+    ASSERT_TRUE(response->is_string());
+    EXPECT_TRUE(response->GetString().empty());
+  }
+  VerifyPendingList({}, profile());
+  EXPECT_EQ(WebstorePrivateApi::GetPendingApprovalsCountForTesting(),
+            approvals_before + 1);
+}
+
+TEST_F(WebstorePrivateBeginInstallWithManifest3Test,
+       CompleteInstallWithoutSenderAllowsRetry) {
+  auto web_contents = CreateSenderWebContents(profile());
+  InstallTracker* tracker =
+      ExtensionsBrowserClient::Get()->GetInstallTracker(profile());
+  ASSERT_TRUE(tracker);
+  ASSERT_FALSE(tracker->GetActiveInstall(kExtensionId));
+  const int approvals_before =
+      WebstorePrivateApi::GetPendingApprovalsCountForTesting();
+
+  // Each attempt requires a fresh approval through the ordinary consent path.
+  for (int attempt = 0; attempt < 2; ++attempt) {
+    SCOPED_TRACE(attempt);
+    {
+      auto begin = base::MakeRefCounted<
+          WebstorePrivateBeginInstallWithManifest3Function>();
+      begin->SetRenderFrameHost(web_contents->GetPrimaryMainFrame());
+      ScopedTestDialogAutoConfirm auto_confirm(
+          ScopedTestDialogAutoConfirm::ACCEPT);
+      auto response = RunFunctionAndReturnValue(
+          begin.get(), GenerateArgs(kExtensionId, kExtensionManifest));
+      ASSERT_TRUE(response);
+      ASSERT_TRUE(response->is_string());
+      EXPECT_TRUE(response->GetString().empty());
+    }
+    ASSERT_EQ(WebstorePrivateApi::GetPendingApprovalsCountForTesting(),
+              approvals_before + 1);
+    ASSERT_TRUE(tracker->GetActiveInstall(kExtensionId));
+
+    // This owned unit call has a valid pending approval but no sender frame.
+    auto complete =
+        base::MakeRefCounted<WebstorePrivateCompleteInstallFunction>();
+    EXPECT_EQ(function_constants::kCouldNotFindSenderWebContents,
+              RunFunctionAndReturnError(
+                  complete.get(),
+                  WebstorePrivateApiTestBase::GenerateArgs(kExtensionId)));
+    EXPECT_EQ(WebstorePrivateApi::GetPendingApprovalsCountForTesting(),
+              approvals_before);
+    EXPECT_FALSE(tracker->GetActiveInstall(kExtensionId));
+    EXPECT_FALSE(
+        ExtensionRegistry::Get(profile())->GetInstalledExtension(kExtensionId));
+  }
+}
+
