+    /** Preserve saved pairs while their second member is still being loaded. */
+    private @Nullable TabState extractTabState(Tab tab) {
+        TabState state = TabStateExtractor.from(tab);
+        Tab.SplitData pending = mPendingSplitRestores.get(tab);
+        if (state != null && pending != null) {
+            state.splitTabId = pending.getToken();
+            state.splitLayout = pending.getLayout();
+            state.splitRatio = pending.getRatio();
+            state.splitPosition = pending.getPosition();
+        }
+        return state;
+    }
+
+    /** Rebuild real native collections only when both saved members have arrived. */
+    @VisibleForTesting
+    void restorePendingSplits() {
+        ThreadUtils.assertOnUiThread();
+        Map<Tab, Tab.SplitData> saved = new HashMap<>(mPendingSplitRestores);
+        mPendingSplitRestores.clear();
+        for (boolean incognito : new boolean[] {false, true}) {
+            if (mDestroyed) return;
+            TabModel model = mTabModelSelector.getModel(incognito);
+            Map<Token, List<Tab>> pairs = new HashMap<>();
+            for (Entry<Tab, Tab.SplitData> entry : saved.entrySet()) {
+                Tab tab = entry.getKey();
+                if (tab.isDestroyed()
+                        || tab.isIncognito() != incognito
+                        || model.getTabById(tab.getId()) != tab) continue;
+                pairs.computeIfAbsent(entry.getValue().getToken(), ignored -> new ArrayList<>())
+                        .add(tab);
+            }
+            for (List<Tab> members : pairs.values()) {
+                if (mDestroyed) return;
+                members.removeIf(tab -> tab.isDestroyed() || model.getTabById(tab.getId()) != tab);
+                boolean restored = false;
+                if (members.size() == 2) {
+                    Tab first = members.get(0);
+                    Tab second = members.get(1);
+                    Tab.SplitData a = assumeNonNull(saved.get(first));
+                    Tab.SplitData b = assumeNonNull(saved.get(second));
+                    if (a.getPosition() != b.getPosition()
+                            && a.getLayout() == b.getLayout()
+                            && Double.compare(a.getRatio(), b.getRatio()) == 0) {
+                        restored =
+                                model.restoreSplit(
+                                        new SplitInfo(
+                                                a.getToken(),
+                                                a.getPosition() == 0
+                                                        ? first.getId()
+                                                        : second.getId(),
+                                                a.getPosition() == 0
+                                                        ? second.getId()
+                                                        : first.getId(),
+                                                a.getLayout(),
+                                                a.getRatio()));
+                    }
+                }
+                if (mDestroyed) return;
+                if (!restored) {
+                    for (Tab member : members) {
+                        // A user or synchronous observer may already have made a different real
+                        // pair.
+                        if (!member.isDestroyed()
+                                && model.getTabById(member.getId()) == member
+                                && model.getSplitInfoForTab(member.getId()) == null) {
+                            member.setSplitData(null, 0, 0.5, -1);
+                        }
+                    }
+                }
+            }
