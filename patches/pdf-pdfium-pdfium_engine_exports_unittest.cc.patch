+#if BUILDFLAG(IS_ANDROID)
+// A black marker occupies the middle 80% of each physical page dimension.
+// Pixel samples well away from its boundary do not depend on antialiasing.
+bool AddPrinterGeometryMarker(FPDF_PAGE page) {
+  const float width = FPDF_GetPageWidthF(page);
+  const float height = FPDF_GetPageHeightF(page);
+  ScopedFPDFPageObject marker(FPDFPageObj_CreateNewRect(
+      width * 0.1f, height * 0.1f, width * 0.8f, height * 0.8f));
+  if (!marker || !FPDFPageObj_SetFillColor(marker.get(), 0, 0, 0, 255) ||
+      !FPDFPath_SetDrawMode(marker.get(), FPDF_FILLMODE_WINDING, false)) {
+    return false;
+  }
+  FPDFPage_InsertObject(page, marker.release());
+  return FPDFPage_GenerateContent(page);
+}
+#endif  // BUILDFLAG(IS_ANDROID)
