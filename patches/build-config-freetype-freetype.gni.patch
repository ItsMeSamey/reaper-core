diff --git a/build/config/freetype/freetype.gni b/build/config/freetype/freetype.gni
--- a/build/config/freetype/freetype.gni
+++ b/build/config/freetype/freetype.gni
@@ -3,6 +3,7 @@
 # found in the LICENSE file.
 
 import("//build/config/cast.gni")
+import("//build/config/chrome_build.gni")
 
 declare_args() {
   # Blink no longer needs FreeType. PDFium needs a recent and properly
@@ -24,5 +25,9 @@
   # This should be kept in sync with the value of `enable_pdf` in
   # //pdf/features.gni, but for layering reasons,
   # we can't import pdf's features.gni here.
-  enable_freetype = !is_android && !is_ios && !is_castos && !is_fuchsia
+  # Android extension printer providers reuse PDFium without enabling the
+  # browser PDF viewer. Keep Chromium's curated FreeType and Skia font backend.
+  # chrome_build.gni clears is_desktop_android in non-Android toolchains.
+  enable_freetype =
+      (!is_android && !is_ios && !is_castos && !is_fuchsia) || is_desktop_android
 }
