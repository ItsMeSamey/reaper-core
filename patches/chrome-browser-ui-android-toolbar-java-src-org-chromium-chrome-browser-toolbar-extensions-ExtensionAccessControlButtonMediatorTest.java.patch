+    @Test
+    public void testCompactRequestMessageRemovalPreservesRemainingRequest() {
+        ExtensionsToolbarBridge.Observer observer = mToolbarObserverCaptor.getValue();
+        prepareCompactMessageDismissal();
+        stubRequestAction("b", "Extension B");
+        when(mContext.getString(R.string.extensions_request_access_button))
+                .thenReturn("Allow $1 extensions?");
+        when(mExtensionsToolbarBridge.getRequestAccessButtonParams(mWebContents))
+                .thenReturn(new RequestAccessButtonParams(new String[] {"a", "b"}, "A and B"));
+        observer.onRequestAccessButtonParamsChanged();
+
+        ArgumentCaptor<PropertyModel> messages = ArgumentCaptor.forClass(PropertyModel.class);
+        verify(mMessageDispatcher)
+                .enqueueWindowScopedMessage(messages.capture(), any(Boolean.class));
+        PropertyModel original = messages.getValue();
+        assertEquals("Allow 2 extensions?", original.get(MessageBannerProperties.TITLE));
+
+        when(mExtensionsToolbarBridge.getRequestAccessButtonParams(mWebContents))
+                .thenReturn(new RequestAccessButtonParams(new String[] {"b"}, "Request B"));
+        observer.onActionRemoved("a");
+
+        verify(mMessageDispatcher, times(2))
+                .enqueueWindowScopedMessage(messages.capture(), any(Boolean.class));
+        PropertyModel remaining = messages.getValue();
+        assertEquals("Allow Extension B?", remaining.get(MessageBannerProperties.TITLE));
+        assertEquals(
+                "Request from Extension B", remaining.get(MessageBannerProperties.DESCRIPTION));
+        InOrder order = inOrder(mMessageDispatcher);
+        order.verify(mMessageDispatcher)
+                .enqueueWindowScopedMessage(same(original), any(Boolean.class));
+        order.verify(mMessageDispatcher).dismissMessage(same(original), anyInt());
+        order.verify(mMessageDispatcher)
+                .enqueueWindowScopedMessage(same(remaining), any(Boolean.class));
+
+        // Removing an unrelated action and an unchanged params update must not
+        // dismiss or enqueue the still-current B request again.
+        observer.onActionRemoved("c");
+        observer.onRequestAccessButtonParamsChanged();
+        verify(mMessageDispatcher, times(2))
+                .enqueueWindowScopedMessage(any(), any(Boolean.class));
+        verify(mMessageDispatcher, never()).dismissMessage(same(remaining), anyInt());
+        verify(mExtensionsToolbarBridge, never()).onRequestAccessButtonClicked(any());
+    }
