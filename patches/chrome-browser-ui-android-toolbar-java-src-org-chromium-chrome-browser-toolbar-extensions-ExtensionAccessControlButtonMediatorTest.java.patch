+    @Test
+    public void testWideRequestButtonRefreshesWhenActionRemoved() {
+        ExtensionsToolbarBridge.Observer observer = mToolbarObserverCaptor.getValue();
+        when(mExtensionsToolbarBridge.getRequestAccessButtonParams(mWebContents))
+                .thenReturn(new RequestAccessButtonParams(new String[] {"a"}, "Request A"));
+        observer.onRequestAccessButtonParamsChanged();
+        assertTrue(mModel.get(ExtensionsToolbarProperties.IS_REQUEST_ACCESS_BUTTON_VISIBLE));
+
+        observer.onActionRemoved("c");
+        assertTrue(mModel.get(ExtensionsToolbarProperties.IS_REQUEST_ACCESS_BUTTON_VISIBLE));
+        assertEquals(
+                1, mModel.get(ExtensionsToolbarProperties.REQUEST_ACCESS_BUTTON_EXTENSION_COUNT));
+
+        when(mExtensionsToolbarBridge.getRequestAccessButtonParams(mWebContents))
+                .thenReturn(new RequestAccessButtonParams(new String[0], ""));
+        observer.onActionRemoved("a");
+        assertFalse(mModel.get(ExtensionsToolbarProperties.IS_REQUEST_ACCESS_BUTTON_VISIBLE));
+        verify(mMessageDispatcher, never())
+                .enqueueWindowScopedMessage(any(), any(Boolean.class));
+        verify(mExtensionsToolbarBridge, never()).onRequestAccessButtonClicked(any());
+    }
+
+    private void prepareCompactMessageDismissal() {
+        when(mIsWindowCompactSupplier.get()).thenReturn(true);
+        // The real dispatcher invokes this callback synchronously when removing
+        // either a displayed message or one waiting in its window queue.
+        doAnswer(
+                        invocation -> {
+                            PropertyModel message = invocation.getArgument(0);
+                            int reason = invocation.getArgument(1);
+                            message.get(MessageBannerProperties.ON_DISMISSED).onResult(reason);
+                            return null;
+                        })
+                .when(mMessageDispatcher)
+                .dismissMessage(any(), anyInt());
+    }
+
+    private void stubRequestAction(String id, String name) {
+        ExtensionAction action = mock(ExtensionAction.class);
+        when(action.getName()).thenReturn(name);
+        when(mExtensionsToolbarBridge.getAction(id, mWebContents)).thenReturn(action);
+        when(mContext.getString(
+                        R.string.extensions_request_access_message_title_single_extension, name))
+                .thenReturn("Allow " + name + "?");
+        when(mContext.getString(
+                        R.string.extensions_request_access_message_description_single_extension,
+                        "example.com",
+                        name))
+                .thenReturn("Request from " + name);
+    }
