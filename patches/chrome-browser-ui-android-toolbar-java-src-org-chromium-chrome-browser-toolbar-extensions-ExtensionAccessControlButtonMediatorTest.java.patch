+    @Test
+    public void testCompactRequestMessageDismissedWhenActionRemoved() {
+        ExtensionsToolbarBridge.Observer observer = mToolbarObserverCaptor.getValue();
+        prepareCompactMessageDismissal();
+        stubRequestAction("a", "Extension A");
+        when(mExtensionsToolbarBridge.getRequestAccessButtonParams(mWebContents))
+                .thenReturn(new RequestAccessButtonParams(new String[] {"a"}, "Request A"));
+        observer.onRequestAccessButtonParamsChanged();
+
+        ArgumentCaptor<PropertyModel> messages = ArgumentCaptor.forClass(PropertyModel.class);
+        verify(mMessageDispatcher)
+                .enqueueWindowScopedMessage(messages.capture(), any(Boolean.class));
+        PropertyModel original = messages.getValue();
+
+        // Native action IDs are already updated before this removal callback.
+        when(mExtensionsToolbarBridge.getRequestAccessButtonParams(mWebContents))
+                .thenReturn(new RequestAccessButtonParams(new String[0], ""));
+        observer.onActionRemoved("a");
+
+        verify(mMessageDispatcher).dismissMessage(same(original), anyInt());
+        observer.onRequestAccessButtonParamsChanged();
+        verify(mMessageDispatcher)
+                .enqueueWindowScopedMessage(any(), any(Boolean.class));
+        assertFalse(mModel.get(ExtensionsToolbarProperties.IS_REQUEST_ACCESS_BUTTON_VISIBLE));
+        verify(mExtensionsToolbarBridge, never()).onRequestAccessButtonClicked(any());
+    }
