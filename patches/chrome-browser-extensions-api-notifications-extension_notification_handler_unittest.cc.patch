+TEST_F(ExtensionNotificationHandlerTest,
+       AndroidLegacyNotificationEventsRemainReadable) {
+  TestingProfile::Builder builder;
+  auto regular = builder.Build();
+  Profile* incognito = regular->GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  ASSERT_TRUE(incognito);
+  // The old format has no profile witness. Preserve event compatibility rather
+  // than claiming the new isolation guarantee for these persisted keys.
+  const std::string public_id = "reaper-extension:v1:legacy-caller-id";
+  const std::string legacy_id = std::string(kChromeExtensionId) + "-" + public_id;
+  EXPECT_EQ(std::optional<std::string>(public_id),
+            GetUnscopedNotificationId(regular.get(), kChromeExtensionId, legacy_id));
+  EXPECT_EQ(std::optional<std::string>(public_id),
+            GetUnscopedNotificationId(incognito, kChromeExtensionId, legacy_id));
+  RecordingExtensionNotificationHandler handler;
+  handler.OnClick(regular.get(), GURL(kChromeExtensionOrigin), legacy_id,
+                   std::nullopt, std::nullopt, base::DoNothing());
+  handler.OnClose(incognito, GURL(kChromeExtensionOrigin), legacy_id, false,
+                   base::DoNothing());
+  ASSERT_EQ(2u, handler.recorded_events().size());
+  EXPECT_EQ(regular.get(), handler.recorded_events()[0].profile.get());
+  EXPECT_EQ(incognito, handler.recorded_events()[1].profile.get());
+  EXPECT_EQ("notifications.onClicked", handler.recorded_events()[0].name);
+  EXPECT_EQ("notifications.onClosed", handler.recorded_events()[1].name);
+  EXPECT_EQ(public_id, handler.recorded_events()[0].args[0].GetString());
+  EXPECT_EQ(public_id, handler.recorded_events()[1].args[0].GetString());
+}
+#endif  // BUILDFLAG(IS_ANDROID)
