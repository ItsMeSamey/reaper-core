+TEST_F(ExtensionNotificationHandlerTest,
+       AndroidProfileScopedEventsPreserveCallerAndProfile) {
+  TestingProfile::Builder builder;
+  auto regular = builder.Build();
+  Profile* incognito = regular->GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  ASSERT_TRUE(incognito);
+  NotificationDisplayServiceTester display_tester(regular.get());
+  auto* helper =
+      ExtensionNotificationDisplayHelperFactory::GetForProfile(regular.get());
+  ASSERT_TRUE(helper);
+  const std::string public_id = "same-notification-id";
+  const std::string regular_id =
+      CreateProfileScopedNotificationId(regular.get(), kChromeExtensionId, public_id);
+  const std::string incognito_id =
+      CreateProfileScopedNotificationId(incognito, kChromeExtensionId, public_id);
+  const GURL origin(kChromeExtensionOrigin);
+  message_center::Notification notification(
+      message_center::NOTIFICATION_TYPE_SIMPLE, regular_id, u"Title", u"Body",
+      ui::ImageModel(), u"Source", origin,
+      message_center::NotifierId(message_center::NotifierType::APPLICATION,
+                                 kChromeExtensionId),
+      message_center::RichNotificationData(), nullptr);
+  helper->Display(notification);
+  ASSERT_TRUE(helper->GetByNotificationId(regular_id));
+
+  RecordingExtensionNotificationHandler handler;
+  int completions = 0;
+  auto completed = [&completions]() {
+    return base::BindOnce([](int* count) { ++*count; }, &completions);
+  };
+  handler.OnClick(regular.get(), origin, incognito_id, std::nullopt, std::nullopt,
+                   completed());
+  handler.OnClose(regular.get(), origin, incognito_id, true, completed());
+  EXPECT_EQ(2, completions);
+  EXPECT_TRUE(handler.recorded_events().empty());
+  EXPECT_TRUE(helper->GetByNotificationId(regular_id));
+
+  handler.OnClick(regular.get(), origin, regular_id, std::nullopt, std::nullopt,
+                   completed());
+  handler.OnClick(incognito, origin, incognito_id, std::nullopt, std::nullopt,
+                   completed());
+  handler.OnClick(incognito, origin, incognito_id, 1, std::nullopt, completed());
+  handler.OnClose(regular.get(), origin, regular_id, false, completed());
+  handler.OnClose(incognito, origin, incognito_id, true, completed());
+  EXPECT_EQ(7, completions);
+  ASSERT_EQ(5u, handler.recorded_events().size());
+  const std::vector<Profile*> expected_profiles = {
+      regular.get(), incognito, incognito, regular.get(), incognito};
+  const std::vector<std::string> expected_names = {
+      "notifications.onClicked", "notifications.onClicked",
+      "notifications.onButtonClicked", "notifications.onClosed",
+      "notifications.onClosed"};
+  for (size_t i = 0; i < handler.recorded_events().size(); ++i) {
+    SCOPED_TRACE(i);
+    const auto& event = handler.recorded_events()[i];
+    EXPECT_EQ(expected_profiles[i], event.profile.get());
+    EXPECT_EQ(kChromeExtensionId, event.extension_id);
+    EXPECT_EQ(expected_names[i], event.name);
+    ASSERT_EQ(i < 2 ? 1u : 2u, event.args.size());
+    EXPECT_EQ(public_id, event.args[0].GetString());
+  }
+  EXPECT_EQ(1, handler.recorded_events()[2].args[1].GetInt());
+  EXPECT_FALSE(handler.recorded_events()[3].args[1].GetBool());
+  EXPECT_TRUE(handler.recorded_events()[4].args[1].GetBool());
+  EXPECT_FALSE(helper->GetByNotificationId(regular_id));
+}
