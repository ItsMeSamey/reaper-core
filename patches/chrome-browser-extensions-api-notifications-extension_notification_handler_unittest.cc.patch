+#if BUILDFLAG(IS_ANDROID)
+class RecordingExtensionNotificationHandler : public ExtensionNotificationHandler {
+ public:
+  struct RecordedEvent {
+    raw_ptr<Profile> profile;
+    ExtensionId extension_id;
+    std::string name;
+    base::ListValue args;
+  };
+
+  const std::vector<RecordedEvent>& recorded_events() const { return events_; }
+
+ private:
+  void SendEvent(Profile* profile,
+                 const ExtensionId& extension_id,
+                 events::HistogramValue histogram_value,
+                 const std::string& event_name,
+                 EventRouter::UserGestureState user_gesture,
+                 base::ListValue args) override {
+    events_.push_back({profile, extension_id, event_name, std::move(args)});
+  }
+
+  std::vector<RecordedEvent> events_;
+};
+
+TEST_F(ExtensionNotificationHandlerTest, AndroidProfileScopedIdentityIsolation) {
+  base::ScopedTempDir profiles_dir;
+  ASSERT_TRUE(profiles_dir.CreateUniqueTempDir());
+  TestingProfile::Builder regular_builder;
+  regular_builder.SetPath(profiles_dir.GetPath().AppendASCII("Profile A"));
+  auto regular = regular_builder.Build();
+  TestingProfile::Builder other_builder;
+  other_builder.SetPath(profiles_dir.GetPath().AppendASCII("Profile B"));
+  auto other = other_builder.Build();
+  Profile* incognito = regular->GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  ASSERT_TRUE(incognito);
+
+  const std::string public_id = "report:reaper-extension:v1:ordinary-id";
+  const std::string regular_id =
+      CreateProfileScopedNotificationId(regular.get(), kChromeExtensionId, public_id);
+  const std::string incognito_id =
+      CreateProfileScopedNotificationId(incognito, kChromeExtensionId, public_id);
+  const std::string other_id =
+      CreateProfileScopedNotificationId(other.get(), kChromeExtensionId, public_id);
+  EXPECT_NE(regular_id, incognito_id);
+  EXPECT_NE(regular_id, other_id);
+  EXPECT_NE(incognito_id, other_id);
+  EXPECT_EQ(regular_id,
+            CreateProfileScopedNotificationId(regular.get(), kChromeExtensionId,
+                                              public_id));
+  EXPECT_EQ(incognito_id,
+            CreateProfileScopedNotificationId(incognito, kChromeExtensionId,
+                                              public_id));
+  EXPECT_EQ(std::optional<std::string>(public_id),
+            GetUnscopedNotificationId(regular.get(), kChromeExtensionId, regular_id));
+  EXPECT_EQ(std::optional<std::string>(public_id),
+            GetUnscopedNotificationId(incognito, kChromeExtensionId, incognito_id));
+  EXPECT_FALSE(GetUnscopedNotificationId(regular.get(), kChromeExtensionId,
+                                         incognito_id));
+  EXPECT_FALSE(GetUnscopedNotificationId(incognito, kChromeExtensionId, regular_id));
+  EXPECT_FALSE(GetUnscopedNotificationId(other.get(), kChromeExtensionId, regular_id));
+  EXPECT_FALSE(GetUnscopedNotificationId(regular.get(),
+                                         "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+                                         regular_id));
+  EXPECT_FALSE(GetUnscopedNotificationId(regular.get(), kChromeExtensionId,
+                                         "reaper-extension:v1:"));
+  EXPECT_FALSE(GetUnscopedNotificationId(
+      regular.get(), kChromeExtensionId,
+      CreateProfileScopedNotificationId(regular.get(), kChromeExtensionId, "")));
+}
