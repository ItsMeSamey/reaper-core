+#if BUILDFLAG(IS_ANDROID)
+std::optional<std::vector<std::string>>
+TabStateStorageDatabase::GetPersistedContainerIds() {
+  if (!db_.is_open()) return std::nullopt;
+  sql::Statement rows(db_.GetCachedStatement(
+      SQL_FROM_HERE,
+      "SELECT payload FROM nodes WHERE is_off_the_record = 0 AND type = ?"));
+  if (!rows.is_valid()) return std::nullopt;
+  rows.BindInt(0, static_cast<int>(TabStorageType::kTab));
+  std::vector<std::string> ids;
+  while (rows.Step()) {
+    auto payload = rows.ColumnBlob(0);
+    tabs_pb::TabState state;
+    if (!state.ParseFromArray(payload.data(), payload.size())) return std::nullopt;
+    if (!state.container_id().empty()) {
+      std::string_view uuid = state.container_id();
+      if (uuid.starts_with("t-"))
+        uuid.remove_prefix(2);
+      // A malformed persisted identity makes the inventory incomplete. Never
+      // publish partial references that could authorize deleting a live jar.
+      if (!base::Uuid::ParseLowercase(uuid).is_valid())
+        return std::nullopt;
+      ids.push_back(state.container_id());
+    }
+  }
+  if (!rows.Succeeded()) return std::nullopt;
+  return ids;
+}
+#endif
