 #if BUILDFLAG(IS_ANDROID)
+void TabGroupsMoveFunction::BeginPendingMove(
+    TabModel* target_model,
+    tab_groups::TabGroupId expected_group) {
+  DCHECK(!pending_move_ref_held_);
+  AddRef();
+  pending_move_ref_held_ = true;
+  observer_helper_ =
+      std::make_unique<ObserverHelper>(this, target_model, expected_group);
+}
+
+bool TabGroupsMoveFunction::RetirePendingMove() {
+  // Clear the latch and detach before Respond() can reenter model/context
+  // shutdown. The caller owns balancing this precise token after its callback.
+  const bool release_pending_ref = std::exchange(pending_move_ref_held_, false);
+  observer_helper_.reset();
+  return release_pending_ref;
+}
+
 void TabGroupsMoveFunction::OnTabGroupCreated(tab_groups::TabGroupId group_id) {
-  observer_helper_.reset();
-
-  auto group_object = ExtensionTabUtil::CreateTabGroupObject(group_id);
-  CHECK(group_object);
-  Respond(ArgumentList(api::tab_groups::Get::Results::Create(*group_object)));
-
-  Release();  // Balanced in MoveGroup().
+  if (!pending_move_ref_held_) {
+    return;
+  }
+  scoped_refptr<TabGroupsMoveFunction> keep_alive(this);
+  const bool release_pending_ref = RetirePendingMove();
+  if (!did_respond() && !response_callback_is_null() && browser_context() &&
+      !browser_context()->ShutdownStarted()) {
+    auto group_object = ExtensionTabUtil::CreateTabGroupObject(group_id);
+    if (group_object) {
+      Respond(ArgumentList(api::tab_groups::Get::Results::Create(*group_object)));
+    } else {
+      Respond(Error(kFailedToMoveGroupError));
+    }
+  }
+  if (release_pending_ref) {
+    Release();
+  }
+}
+
+void TabGroupsMoveFunction::OnTargetModelDestroyed() {
+  if (!pending_move_ref_held_) {
+    return;
+  }
+  scoped_refptr<TabGroupsMoveFunction> keep_alive(this);
+  const bool release_pending_ref = RetirePendingMove();
+  if (!did_respond() && !response_callback_is_null() && browser_context() &&
+      !browser_context()->ShutdownStarted()) {
+    Respond(Error(kFailedToMoveGroupError));
+  }
+  if (release_pending_ref) {
+    Release();
+  }
+}
+
+void TabGroupsMoveFunction::OnBrowserContextShutdown() {
+  // The base shutdown callback keeps any existing owner alive. An unstarted
+  // function owns no token; do not acquire or release a reference for it here.
+  if (RetirePendingMove()) {
+    Release();
+  }
 }
