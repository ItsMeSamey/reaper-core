+    private static String getContainerBrowserTestDataDirectory(Context context) {
+        if (sReaperContainerBrowserTestDataDir != null) return sReaperContainerBrowserTestDataDir;
+        File root = new File(context.getCacheDir(), "reaper-container-browser-" + UUID.randomUUID());
+        if (!root.mkdir()) throw new IllegalStateException("Cannot create private browser-test root");
+        String[] paths = {
+            "chrome/test/data/title1.html",
+            "net/data/ssl/certificates/root_ca_cert.pem",
+            "paks/browser_tests.pak"
+        };
+        try {
+            byte[] buffer = new byte[64 * 1024];
+            for (String relativePath : paths) {
+                File destination = new File(root, relativePath);
+                File parent = destination.getParentFile();
+                if (!parent.isDirectory() && !parent.mkdirs()) {
+                    throw new IOException("Cannot create private browser-test data directory");
+                }
+                String assetPath =
+                        relativePath.equals("paks/browser_tests.pak")
+                                ? "browser_tests.pak"
+                                : "reaper_container_browser_test_data/" + relativePath;
+                try (InputStream input = context.getAssets().open(assetPath);
+                        FileOutputStream output = new FileOutputStream(destination)) {
+                    int count;
+                    while ((count = input.read(buffer)) != -1) output.write(buffer, 0, count);
+                }
+            }
+        } catch (IOException error) {
+            throw new IllegalStateException("Cannot populate private browser-test root", error);
+        }
+        sReaperContainerBrowserTestDataDir = root.getAbsolutePath();
+        Log.i(TAG, "Using app-private browser-test root: %s", sReaperContainerBrowserTestDataDir);
+        return sReaperContainerBrowserTestDataDir;
+    }
+
+    private static synchronized String getTestDataDirectory(Activity activity) {
+        Context context = activity.getApplicationContext();
+        String packageName = context.getPackageName();
+        if (REAPER_CONTAINER_BROWSER_PACKAGE.equals(packageName)) {
+            return getContainerBrowserTestDataDirectory(context);
+        }
+        boolean chrome = REAPER_CHROME_SCRIPT_LOADER_PACKAGE.equals(packageName);
+        boolean extensions = REAPER_EXTENSIONS_SCRIPT_LOADER_PACKAGE.equals(packageName);
+        if (!chrome && !extensions) return UrlUtils.getIsolatedTestRoot();
+        if (sReaperScriptLoaderTestDataDir != null) return sReaperScriptLoaderTestDataDir;
+
+        // Keep one new app-private root per process. Never read or clear the shared test root.
+        File root = new File(context.getCacheDir(), "reaper-script-loader-" + UUID.randomUUID());
+        if (!root.mkdir()) throw new IllegalStateException("Cannot create private test root");
+        if (chrome && !new File(root, "chrome/test/data").mkdirs()) {
+            throw new IllegalStateException("Cannot create private Chrome test data directory");
+        }
+        String[] paths =
+                chrome
+                        ? new String[] {
+                            "paks/chrome_100_percent.pak", "paks/en-US.pak", "paks/resources.pak"
+                        }
+                        : new String[] {"extensions_shell_and_test.pak"};
+        try {
+            byte[] buffer = new byte[64 * 1024];
+            for (String relativePath : paths) {
+                File destination = new File(root, relativePath);
+                if (extensions && BuildConfig.IS_DESKTOP_ANDROID) {
+                    destination = new File(new File(root, "paks"), relativePath);
+                }
+                File parent = destination.getParentFile();
+                if (!parent.isDirectory() && !parent.mkdirs()) {
+                    throw new IOException("Cannot create private resource directory");
+                }
+                try (InputStream input =
+                                context.getAssets().open("reaper_script_loader_test_data/" + relativePath);
+                        FileOutputStream output = new FileOutputStream(destination)) {
+                    int count;
+                    while ((count = input.read(buffer)) != -1) output.write(buffer, 0, count);
+                }
+            }
+        } catch (IOException error) {
+            throw new IllegalStateException("Cannot populate private script-loader test root", error);
+        }
+        sReaperScriptLoaderTestDataDir = root.getAbsolutePath();
+        Log.i(TAG, "Using app-private script-loader test root: %s", sReaperScriptLoaderTestDataDir);
+        return sReaperScriptLoaderTestDataDir;
+    }
