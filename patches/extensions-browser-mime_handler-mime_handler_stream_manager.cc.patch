+
+void MimeHandlerStreamManager::FinishAndroidNativeFallback(
+    content::GlobalRenderFrameHostId embedder_id,
+    int32_t stream_instance_id) {
+  auto* embedder = content::RenderFrameHost::FromID(embedder_id);
+  if (!embedder ||
+      content::WebContents::FromRenderFrameHost(embedder) != web_contents()) {
+    return;
+  }
+  auto* stream = GetClaimedStreamInfo(embedder);
+  if (!stream || stream->instance_id() != stream_instance_id) {
+    return;
+  }
+  auto* extension_frame = web_contents()->UnsafeFindFrameByFrameTreeNodeId(
+      stream->extension_host_frame_tree_node_id());
+  if (extension_frame && extension_frame->GetParent() == embedder &&
+      IsExtensionHost(extension_frame)) {
+    // This lookup is checked against both the surviving RFH and stream
+    // identity; it cannot navigate another frame after a cross-process swap.
+    content::NavigationController::LoadURLParams params{
+        GURL(url::kAboutBlankURL)};
+    params.frame_tree_node_id = extension_frame->GetFrameTreeNodeId();
+    params.should_replace_current_entry = true;
+    auto weak_this = weak_factory_.GetWeakPtr();
+    web_contents()->GetController().LoadURLWithParams(params);
+    embedder = content::RenderFrameHost::FromID(embedder_id);
+    if (!weak_this || !embedder) {
+      return;
+    }
+    stream = GetClaimedStreamInfo(embedder);
+    if (!stream || stream->instance_id() != stream_instance_id) {
+      return;
+    }
+  }
+  DeleteClaimedStreamInfo(embedder);
+  // No accesses below: removing the last stream deletes this manager.
+}
