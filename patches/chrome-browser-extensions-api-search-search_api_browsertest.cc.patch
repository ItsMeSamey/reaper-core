+#if BUILDFLAG(IS_ANDROID)
+  void CloseAndroidWindowTabs() {
+    auto* tab_model = static_cast<TabModel*>(GetTabListInterface());
+    ASSERT_TRUE(tab_model);
+    ASSERT_FALSE(tab_model->IsOffTheRecord());
+    tab_model->ForceCloseAllTabs();
+    ASSERT_EQ(0, tab_model->GetTabCount());
+    ASSERT_EQ(nullptr, tab_model->GetActiveWebContents());
+    ASSERT_TRUE(GetBrowserWindowInterface());
+    ASSERT_EQ(tab_model, TabListInterface::From(GetBrowserWindowInterface()));
+  }
+
+  void SetLocalSearchProvider() {
+    ASSERT_TRUE(embedded_test_server()->Start());
+    TemplateURLData data;
+    data.SetShortName(u"Loopback search");
+    data.SetKeyword(u"loopback.test");
+    data.SetURL(embedded_test_server()->GetURL("/title1.html").spec() +
+                "?q={searchTerms}");
+    auto* service = TemplateURLServiceFactory::GetForProfile(profile());
+    service->SetUserSelectedDefaultSearchProvider(
+        service->Add(std::make_unique<TemplateURL>(data)));
+  }
+#endif
