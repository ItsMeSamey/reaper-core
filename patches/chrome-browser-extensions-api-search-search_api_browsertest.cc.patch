+#if BUILDFLAG(IS_ANDROID)
+IN_PROC_BROWSER_TEST_F(SearchApiBrowserTest, EmptyAndroidWindowCurrentTab) {
+  ASSERT_NO_FATAL_FAILURE(CloseAndroidWindowTabs());
+  // No sender WebContents simulates a service-worker call.
+  scoped_refptr<const Extension> extension = CreateSearchExtension();
+  for (const char* input : {R"([{"text":"test"}])",
+                            R"([{"text":"test","disposition":"CURRENT_TAB"}])"}) {
+    auto function = CreateSearchFunction(extension);
+    EXPECT_EQ("No active browser.", api_test_utils::RunFunctionAndReturnError(
+                                        function.get(), input, profile()));
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(SearchApiBrowserTest, EmptyAndroidWindowNewTab) {
+  ASSERT_NO_FATAL_FAILURE(SetLocalSearchProvider());
+  ASSERT_NO_FATAL_FAILURE(CloseAndroidWindowTabs());
+  auto* window = GetBrowserWindowInterface();
+  size_t window_count = GetAllBrowserWindowInterfaces().size();
+  ASSERT_TRUE(api_test_utils::RunFunction(
+      function(), R"([{"text":"test","disposition":"NEW_TAB"}])", profile()));
+  EXPECT_EQ(window_count, GetAllBrowserWindowInterfaces().size());
+  auto* model = static_cast<TabModel*>(TabListInterface::From(window));
+  ASSERT_EQ(1, model->GetTabCount());
+  auto* contents = model->GetActiveWebContents();
+  ASSERT_TRUE(contents);
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  EXPECT_EQ(embedded_test_server()->GetURL("/title1.html?q=test"),
+            contents->GetLastCommittedURL());
+}
+
+IN_PROC_BROWSER_TEST_F(SearchApiBrowserTest, EmptyAndroidWindowNewWindow) {
+  ASSERT_NO_FATAL_FAILURE(SetLocalSearchProvider());
+  ASSERT_NO_FATAL_FAILURE(CloseAndroidWindowTabs());
+  auto* original = GetBrowserWindowInterface();
+  auto original_windows = GetAllBrowserWindowInterfaces();
+  ASSERT_TRUE(api_test_utils::RunFunction(
+      function(), R"([{"text":"test","disposition":"NEW_WINDOW"}])", profile()));
+  auto windows = GetAllBrowserWindowInterfaces();
+  ASSERT_EQ(original_windows.size() + 1, windows.size());
+  EXPECT_EQ(0, TabListInterface::From(original)->GetTabCount());
+  for (auto* window : windows) {
+    if (std::ranges::contains(original_windows, window)) continue;
+    EXPECT_EQ(profile(), window->GetProfile());
+    auto* model = static_cast<TabModel*>(TabListInterface::From(window));
+    ASSERT_EQ(1, model->GetTabCount());
+    auto* contents = model->GetActiveWebContents();
+    ASSERT_TRUE(contents);
+    ASSERT_TRUE(content::WaitForLoadStop(contents));
+    EXPECT_EQ(embedded_test_server()->GetURL("/title1.html?q=test"),
+              contents->GetLastCommittedURL());
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(SearchApiBrowserTest,
+                       IncognitoDoesNotFallBackToOtherProfile) {
+  // Keep both a regular window and a different OTR window available.
+  ASSERT_TRUE(PlatformOpenURLOffTheRecord(profile(), GURL("about:blank")));
+  Profile* isolated_otr = profile()->GetOffTheRecordProfile(
+      Profile::OTRProfileID::CreateUniqueForTesting(), /*create_if_needed=*/true);
+  scoped_refptr<const Extension> extension = CreateSearchExtension();
+  for (const char* input : {R"([{"text":"test"}])",
+                            R"([{"text":"test","disposition":"NEW_TAB"}])",
+                            R"([{"text":"test","disposition":"NEW_WINDOW"}])"}) {
+    auto function = CreateSearchFunction(extension);
+    EXPECT_EQ("No active browser.", api_test_utils::RunFunctionAndReturnError(
+                                        function.get(), input, isolated_otr,
+                                        api_test_utils::FunctionMode::kIncognito));
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(SearchApiBrowserTest, RegularCallerIncognitoOptIn) {
+  ASSERT_NO_FATAL_FAILURE(SetLocalSearchProvider());
+  auto* regular_model = GetTabListInterface();
+  int regular_count = regular_model->GetTabCount();
+  content::WebContents* otr_contents =
+      PlatformOpenURLOffTheRecord(profile(), GURL("about:blank"));
+  ASSERT_TRUE(otr_contents);
+  BrowserWindowInterface* last_active = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* window) {
+        last_active = window;
+        return false;
+      });
+  ASSERT_TRUE(last_active);
+  ASSERT_EQ(otr_contents->GetBrowserContext(), last_active->GetProfile());
+  auto* otr_model = TabListInterface::From(last_active);
+  int otr_count = otr_model->GetTabCount();
+
+  scoped_refptr<const Extension> extension = CreateSearchExtension();
+  auto allowed = CreateSearchFunction(extension);
+  ASSERT_TRUE(api_test_utils::RunFunction(
+      allowed.get(), R"([{"text":"test","disposition":"NEW_TAB"}])", profile(),
+      api_test_utils::FunctionMode::kIncognito));
+  EXPECT_EQ(otr_count + 1, otr_model->GetTabCount());
+  EXPECT_EQ(regular_count, regular_model->GetTabCount());
+
+  auto regular_only = CreateSearchFunction(extension);
+  ASSERT_TRUE(api_test_utils::RunFunction(
+      regular_only.get(), R"([{"text":"test","disposition":"NEW_TAB"}])", profile()));
+  EXPECT_EQ(otr_count + 1, otr_model->GetTabCount());
+  EXPECT_EQ(regular_count + 1, regular_model->GetTabCount());
+}
+#endif  // BUILDFLAG(IS_ANDROID)
