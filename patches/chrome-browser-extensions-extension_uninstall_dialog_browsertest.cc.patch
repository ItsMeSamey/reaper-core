+#if BUILDFLAG(IS_ANDROID)
+namespace {
+
+class ScopedUninstallDialogShownObserver {
+ public:
+  ScopedUninstallDialogShownObserver()
+      : callback_(base::BindLambdaForTesting([this] {
+          ++count_;
+          if (!shown_.IsReady()) {
+            shown_.SetValue();
+          }
+        })) {
+    ExtensionUninstallDialog::SetOnShownCallbackForTesting(&callback_);
+  }
+
+  ~ScopedUninstallDialogShownObserver() {
+    ExtensionUninstallDialog::SetOnShownCallbackForTesting(nullptr);
+  }
+
+  int count() const { return count_; }
+  bool Wait() { return shown_.Wait(); }
+
+ private:
+  int count_ = 0;
+  base::test::TestFuture<void> shown_;
+  base::RepeatingClosure callback_;
+};
+
+}  // namespace
+
+class AndroidExtensionUninstallDialogBrowserTest : public ExtensionBrowserTest {
+ protected:
+  scoped_refptr<const Extension> LoadExtensionWithoutIcon() {
+    test_dir_.WriteManifest(R"({
+      "name": "Pending uninstall dialog",
+      "version": "1.0",
+      "manifest_version": 3
+    })");
+    return LoadExtension(test_dir_.UnpackedPath());
+  }
+
+  void WaitPastDefaultIconCallback() {
+    // With no manifest icon, IconImage::LoadImageForScaleAsync posts its
+    // completion to this sequence. This marker follows that exact queued task.
+    base::test::TestFuture<void> marker;
+    ASSERT_TRUE(base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, marker.GetCallback()));
+    ASSERT_TRUE(marker.Wait());
+  }
+
+  void CheckRemovalBeforeIconLoad(bool terminated, bool destroy_on_close) {
+    scoped_refptr<const Extension> extension = LoadExtensionWithoutIcon();
+    ASSERT_TRUE(extension);
+    auto* registrar = ExtensionRegistrar::Get(profile());
+    auto* registry = ExtensionRegistry::Get(profile());
+    if (terminated) {
+      registrar->TerminateExtension(extension->id());
+      ASSERT_TRUE(registry->terminated_extensions().Contains(extension->id()));
+    } else {
+      DisableExtension(extension->id());
+      ASSERT_TRUE(registry->disabled_extensions().Contains(extension->id()));
+    }
+
+    ScopedTestDialogAutoConfirm auto_confirm(ScopedTestDialogAutoConfirm::NONE);
+    ScopedUninstallDialogShownObserver shown;
+    std::unique_ptr<ExtensionUninstallDialog> dialog;
+    int close_count = 0;
+    TestExtensionUninstallDialogDelegate delegate(
+        base::BindLambdaForTesting([&] {
+          ++close_count;
+          if (destroy_on_close) {
+            dialog.reset();
+          }
+        }));
+    // Keep the delegate alive if an assertion exits with a shown dialog.
+    base::ScopedClosureRunner cleanup(
+        base::BindLambdaForTesting([&] { dialog.reset(); }));
+    dialog = ExtensionUninstallDialog::Create(
+        profile(), GetActiveWebContents()->GetTopLevelNativeWindow(), &delegate);
+    auto weak_dialog = dialog->AsWeakPtr();
+    dialog->ConfirmUninstall(extension, UNINSTALL_REASON_FOR_TESTING,
+                             UNINSTALL_SOURCE_FOR_TESTING);
+    ASSERT_EQ(0, shown.count());
+    ASSERT_EQ(0, close_count);
+
+    // Do not pump the UI sequence between ConfirmUninstall and removal. A
+    // disabled/terminated target emits no unload event that could show the UI.
+    ASSERT_TRUE(registrar->UninstallExtension(
+        extension->id(), UNINSTALL_REASON_FOR_TESTING, nullptr));
+    EXPECT_EQ(1, close_count);
+    EXPECT_TRUE(delegate.canceled());
+    EXPECT_EQ(u"Extension was removed before dialog closed.", delegate.error());
+    EXPECT_EQ(!destroy_on_close, static_cast<bool>(weak_dialog));
+    EXPECT_FALSE(registry->GetInstalledExtension(extension->id()));
+
+    WaitPastDefaultIconCallback();
+    EXPECT_EQ(0, shown.count());
+    EXPECT_EQ(1, close_count);
+  }
+
+ private:
+  TestExtensionDir test_dir_;
+};
+
+IN_PROC_BROWSER_TEST_F(AndroidExtensionUninstallDialogBrowserTest,
+                       DisabledExtensionRemovedBeforeIconLoad) {
+  CheckRemovalBeforeIconLoad(/*terminated=*/false, /*destroy_on_close=*/false);
+}
+
+IN_PROC_BROWSER_TEST_F(AndroidExtensionUninstallDialogBrowserTest,
+                       TerminatedExtensionRemovedBeforeIconLoad) {
+  CheckRemovalBeforeIconLoad(/*terminated=*/true, /*destroy_on_close=*/false);
+}
+
+IN_PROC_BROWSER_TEST_F(AndroidExtensionUninstallDialogBrowserTest,
+                       PendingRemovalDelegateDestroysDialog) {
+  CheckRemovalBeforeIconLoad(/*terminated=*/false, /*destroy_on_close=*/true);
+}
+
+IN_PROC_BROWSER_TEST_F(AndroidExtensionUninstallDialogBrowserTest,
+                       DisabledExtensionRemovedAfterDialogShown) {
+  scoped_refptr<const Extension> extension = LoadExtensionWithoutIcon();
+  ASSERT_TRUE(extension);
+  DisableExtension(extension->id());
+  ScopedTestDialogAutoConfirm auto_confirm(ScopedTestDialogAutoConfirm::NONE);
+  ScopedUninstallDialogShownObserver shown;
+  base::test::TestFuture<void> closed;
+  TestExtensionUninstallDialogDelegate delegate(closed.GetRepeatingCallback());
+  auto dialog = ExtensionUninstallDialog::Create(
+      profile(), GetActiveWebContents()->GetTopLevelNativeWindow(), &delegate);
+  dialog->ConfirmUninstall(extension, UNINSTALL_REASON_FOR_TESTING,
+                           UNINSTALL_SOURCE_FOR_TESTING);
+  ASSERT_TRUE(shown.Wait());
+  EXPECT_EQ(1, shown.count());
+  EXPECT_FALSE(closed.IsReady());
+
+  ASSERT_TRUE(ExtensionRegistrar::Get(profile())->UninstallExtension(
+      extension->id(), UNINSTALL_REASON_FOR_TESTING, nullptr));
+  ASSERT_TRUE(closed.Wait());
+  EXPECT_TRUE(delegate.canceled());
+  EXPECT_EQ(u"Extension was removed before dialog closed.", delegate.error());
+  WaitPastDefaultIconCallback();
+  EXPECT_EQ(1, shown.count());
+}
+
+IN_PROC_BROWSER_TEST_F(AndroidExtensionUninstallDialogBrowserTest,
+                       UnchangedTargetAutoCancelPreservesInstallation) {
+  scoped_refptr<const Extension> extension = LoadExtensionWithoutIcon();
+  ASSERT_TRUE(extension);
+  DisableExtension(extension->id());
+  ScopedTestDialogAutoConfirm auto_confirm(ScopedTestDialogAutoConfirm::CANCEL);
+  ScopedUninstallDialogShownObserver shown;
+  base::test::TestFuture<void> closed;
+  TestExtensionUninstallDialogDelegate delegate(closed.GetRepeatingCallback());
+  auto dialog = ExtensionUninstallDialog::Create(
+      profile(), GetActiveWebContents()->GetTopLevelNativeWindow(), &delegate);
+  dialog->ConfirmUninstall(extension, UNINSTALL_REASON_FOR_TESTING,
+                           UNINSTALL_SOURCE_FOR_TESTING);
+  ASSERT_TRUE(closed.Wait());
+  EXPECT_TRUE(delegate.canceled());
+  EXPECT_EQ(u"User canceled uninstall dialog", delegate.error());
+  EXPECT_EQ(1, shown.count());
+  EXPECT_TRUE(ExtensionRegistry::Get(profile())->disabled_extensions().Contains(
+      extension->id()));
+  WaitPastDefaultIconCallback();
+  EXPECT_EQ(1, shown.count());
+}
+#endif  // BUILDFLAG(IS_ANDROID)
+
 }  // namespace extensions
