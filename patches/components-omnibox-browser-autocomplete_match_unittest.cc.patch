+#if BUILDFLAG(IS_ANDROID)
+TEST_F(AutocompleteMatchTest,
+       AndroidAiKeywordPlaceholderUnavailableAndCoreScopesRemainAvailable) {
+  TemplateURLData ai_data;
+  ai_data.starter_pack_id = static_cast<int>(
+      template_url_starter_pack_data::StarterPackId::kAiMode);
+  TemplateURL ai_template(ai_data);
+  EXPECT_TRUE(
+      AutocompleteMatch::GetKeywordPlaceholder(&ai_template, false).empty());
+  EXPECT_TRUE(
+      AutocompleteMatch::GetKeywordPlaceholder(&ai_template, true).empty());
+
+  TemplateURLData ask_brave_data;
+  ask_brave_data.starter_pack_id = static_cast<int>(
+      template_url_starter_pack_data::StarterPackId::kAskBraveSearch);
+  TemplateURL ask_brave_template(ask_brave_data);
+  EXPECT_TRUE(AutocompleteMatch::GetKeywordPlaceholder(&ask_brave_template,
+                                                     false)
+                  .empty());
+  EXPECT_TRUE(AutocompleteMatch::GetKeywordPlaceholder(&ask_brave_template, true)
+                  .empty());
+
+  constexpr template_url_starter_pack_data::StarterPackId kRetainedScopes[] = {
+      template_url_starter_pack_data::StarterPackId::kBookmarks,
+      template_url_starter_pack_data::StarterPackId::kHistory,
+      template_url_starter_pack_data::StarterPackId::kTabs};
+  for (auto scope : kRetainedScopes) {
+    TemplateURLData data;
+    data.starter_pack_id = static_cast<int>(scope);
+    TemplateURL retained_template(data);
+    EXPECT_FALSE(AutocompleteMatch::GetKeywordPlaceholder(&retained_template,
+                                                        false)
+                     .empty());
+  }
+}
+
+TEST_F(AutocompleteMatchTest, AndroidExtensionKeywordProvenance) {
+  auto* service = search_engines_test_environment_.template_url_service();
+  service->Load();
+  ASSERT_TRUE(service->loaded());
+  constexpr char kExtensionId[] = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+  service->RegisterExtensionControlledTURL(
+      kExtensionId, "keyword", "test",
+      "chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/?q={searchTerms}",
+      base::Time::Now(), /*unscoped_mode_allowed=*/false);
+  auto provider = base::MakeRefCounted<FakeAutocompleteProvider>(
+      AutocompleteProvider::TYPE_KEYWORD);
+  AutocompleteMatch match(provider.get(), 1000, false,
+                          AutocompleteMatchType::SEARCH_OTHER_ENGINE);
+  match.keyword = u"test";
+  match.destination_url =
+      GURL("chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/?q=test");
+  EXPECT_TRUE(match.IsExtensionKeywordSuggestion(service));
+  EXPECT_FALSE(match.IsExtensionKeywordSuggestion(nullptr));
+
+  TemplateURLData ordinary;
+  ordinary.SetKeyword(u"ordinary");
+  ordinary.SetURL(
+      "chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/?q={searchTerms}");
+  service->Add(std::make_unique<TemplateURL>(ordinary));
+  match.keyword = u"ordinary";
+  EXPECT_FALSE(match.IsExtensionKeywordSuggestion(service));
+  match.keyword = u"test";
+
+  match.type = AutocompleteMatchType::URL_WHAT_YOU_TYPED;
+  EXPECT_FALSE(match.IsExtensionKeywordSuggestion(service));
+  match.type = AutocompleteMatchType::SEARCH_OTHER_ENGINE;
+  match.keyword.clear();
+  EXPECT_FALSE(match.IsExtensionKeywordSuggestion(service));
+  match.keyword = u"test";
+  match.destination_url =
+      GURL("chrome-extension://bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/?q=test");
+  EXPECT_FALSE(match.IsExtensionKeywordSuggestion(service));
+  match.destination_url =
+      GURL("chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/?q=test");
+  service->RemoveExtensionControlledTURL(kExtensionId,
+                                         TemplateURL::OMNIBOX_API_EXTENSION);
+  EXPECT_FALSE(match.IsExtensionKeywordSuggestion(service));
+}
+#endif  // BUILDFLAG(IS_ANDROID)
