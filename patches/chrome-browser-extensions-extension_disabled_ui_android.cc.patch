+  auto* owner = static_cast<DisabledMessageOwner*>(
+      profile->GetUserData(kDisabledMessageOwnerKey));
+  if (!owner) {
+    auto new_owner = std::make_unique<DisabledMessageOwner>(profile);
+    owner = new_owner.get();
+    profile->SetUserData(kDisabledMessageOwnerKey, std::move(new_owner));
+  }
+  owner->Add(*extension, is_remote_install);
