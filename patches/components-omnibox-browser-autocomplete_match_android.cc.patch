+bool AutocompleteMatch::IsExtensionKeywordSuggestion(
+    const TemplateURLService* template_url_service) const {
+  if (type != AutocompleteMatchType::SEARCH_OTHER_ENGINE || !provider ||
+      (provider->type() != AutocompleteProvider::TYPE_KEYWORD &&
+       provider->type() != AutocompleteProvider::TYPE_UNSCOPED_EXTENSION)) {
+    return false;
+  }
+  const TemplateURL* template_url = GetTemplateURL(template_url_service);
+  return template_url &&
+         template_url->type() == TemplateURL::OMNIBOX_API_EXTENSION &&
+         destination_url.SchemeIs("chrome-extension") &&
+         destination_url.host() == template_url->GetExtensionId();
+}
 
