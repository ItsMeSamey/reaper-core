diff --git a/chrome/browser/resources/extensions/item_mixin.ts b/chrome/browser/resources/extensions/item_mixin.ts
index 2043fb3aeacdc59424061e31275e23ea8569d955..07a174467c6055bda5d72499bc14fd1095f8ac57 100644
--- a/chrome/browser/resources/extensions/item_mixin.ts
+++ b/chrome/browser/resources/extensions/item_mixin.ts
@@ -111,17 +111,49 @@
       toastManager.duration = 0;
       toastManager.show(loadTimeData.getString('itemReloading'));
 
+      // <if expr="is_android">
+      // Match the toolbar's ownership check. A comment also distinguishes a
+      // newer toast with the same label without adding layout or AX text.
+      const content = toastManager.$.content;
+      const marker = document.createComment('extension-reload');
+      content.appendChild(marker);
+      const finishToast = () => {
+        if (marker.parentNode !== content) {
+          return false;
+        }
+        marker.remove();
+        toastManager.hide();
+        toastManager.duration = TOAST_DURATION_MS;
+        return true;
+      };
+      // </if>
+
       assert(this.delegate);
       assert(this.data);
       try {
         await this.delegate.reloadItem(this.data.id);
+        // <if expr="is_android">
+        if (finishToast()) {
+          toastManager.show(loadTimeData.getString('itemReloaded'));
+        }
+        // </if>
+        // <if expr="not is_android">
         toastManager.hide();
         toastManager.duration = TOAST_DURATION_MS;
         toastManager.show(loadTimeData.getString('itemReloaded'));
+        // </if>
       } catch (loadError) {
+        // <if expr="is_android">
+        finishToast();
+        // </if>
+        // <if expr="not is_android">
         toastManager.hide();
+        // </if>
         throw loadError;
       } finally {
+        // <if expr="is_android">
+        marker.remove();
+        // </if>
         this.isReloading_ = false;
       }
     }
