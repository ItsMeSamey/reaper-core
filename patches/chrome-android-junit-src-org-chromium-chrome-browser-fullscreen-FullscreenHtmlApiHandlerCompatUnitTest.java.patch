+    @Test
+    @Config(
+            shadows = {FullscreenShadowActivity.class},
+            sdk = Build.VERSION_CODES.UPSIDE_DOWN_CAKE)
+    public void browserExpansionTransfersFromTabUntilBothOrdinaryOwnersExit() {
+        ((FullscreenShadowActivity) Shadows.shadowOf(mActivity)).inMultiWindowMode = true;
+        doReturn(null).when(mTab).getWebContents();
+        doReturn(true).when(mTab).isUserInteractable();
+        mFullscreenHtmlApiHandlerCompat.setTabForTesting(mTab);
+        mFullscreenHtmlApiHandlerCompat.onEnterFullscreen(
+                mTab, new FullscreenOptions(false, false, INVALID_DISPLAY));
+        mFullscreenHtmlApiHandlerCompat.setBrowserFullscreenMode(true);
+        mFullscreenHtmlApiHandlerCompat.exitPersistentFullscreenMode();
+        var shadow = (FullscreenShadowActivity) Shadows.shadowOf(mActivity);
+        assertEquals(1, (int) shadow.counters.get(Activity.FULLSCREEN_MODE_REQUEST_ENTER));
+        assertFalse(shadow.counters.containsKey(Activity.FULLSCREEN_MODE_REQUEST_EXIT));
+        assertFalse(mFullscreenHtmlApiHandlerCompat.getPersistentFullscreenMode());
+        assertTrue(mFullscreenHtmlApiHandlerCompat.getFullscreenUiModeSupplier().get());
+        mFullscreenHtmlApiHandlerCompat.setBrowserFullscreenMode(false);
+        assertEqualNumberOfEnterAndExitActivityFullscreenMode(1);
+        assertFalse(mFullscreenHtmlApiHandlerCompat.getFullscreenUiModeSupplier().get());
+    }
