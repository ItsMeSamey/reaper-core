+    @Test
+    @Config(
+            shadows = {FullscreenShadowActivity.class},
+            sdk = Build.VERSION_CODES.UPSIDE_DOWN_CAKE)
+    public void browserFullscreenUsesRealCompatBarsWithoutEnteringDomFullscreen() {
+        mFullscreenHtmlApiHandlerCompat.setBrowserFullscreenMode(true);
+        assertTrue(mFullscreenHtmlApiHandlerCompat.getBrowserFullscreenMode());
+        assertTrue(mFullscreenHtmlApiHandlerCompat.getFullscreenUiModeSupplier().get());
+        assertFalse(mFullscreenHtmlApiHandlerCompat.getPersistentFullscreenMode());
+        var controller =
+                WindowCompat.getInsetsController(
+                        mActivity.getWindow(), mActivity.getWindow().getDecorView());
+        assertEquals(
+                WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE,
+                controller.getSystemBarsBehavior());
+        mFullscreenHtmlApiHandlerCompat.setBrowserFullscreenMode(false);
+        assertFalse(mFullscreenHtmlApiHandlerCompat.getFullscreenUiModeSupplier().get());
+        assertEquals(
+                WindowInsetsControllerCompat.BEHAVIOR_DEFAULT, controller.getSystemBarsBehavior());
+        assertEqualNumberOfEnterAndExitActivityFullscreenMode(0);
+    }
