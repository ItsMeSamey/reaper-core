+    @Test
+    public void testContainerMarkerColorAndThicknessReachNative() throws Exception {
+        mStripLayoutTab.setContainerBadge(containerBadge());
+        mTabStripSceneLayer.pushStripTabs(
+                mStripLayoutHelperManager, mLayerTitleCache, mStripLayoutTabs, 0);
+        assertContainerMarkerCalls(0xffd93025);
+    }
+
+    @Test
+    public void testReusedTabClearsContainerMarkerInNativeFrame() throws Exception {
+        mStripLayoutTab.setContainerBadge(containerBadge());
+        mTabStripSceneLayer.pushStripTabs(
+                mStripLayoutHelperManager, mLayerTitleCache, mStripLayoutTabs, 0);
+        mStripLayoutTab.setContainerBadge(null);
+        mTabStripSceneLayer.pushStripTabs(
+                mStripLayoutHelperManager, mLayerTitleCache, mStripLayoutTabs, 0);
+        assertContainerMarkerCalls(0xffd93025, 0);
+    }
+
+    @Test
+    public void testIncognitoMarkerIsClearedBeforeNativeCall() throws Exception {
+        mStripLayoutTab.setContainerBadge(containerBadge());
+        when(mStripLayoutTab.isIncognito()).thenReturn(true);
+        mTabStripSceneLayer.pushStripTabs(
+                mStripLayoutHelperManager, mLayerTitleCache, mStripLayoutTabs, 0);
+        assertContainerMarkerCalls(0);
+    }
+
+    private void assertContainerMarkerCalls(int... expectedColors) {
+        java.util.List<org.mockito.invocation.Invocation> calls =
+                mockingDetails(mTabStripSceneMock).getInvocations().stream()
+                        .filter(call -> call.getMethod().getName().equals("putStripTabLayer"))
+                        .toList();
+        assertEquals(expectedColors.length, calls.size());
+        for (int index = 0; index < expectedColors.length; index++) {
+            Object[] arguments = calls.get(index).getArguments();
+            assertEquals(expectedColors[index], arguments[arguments.length - 2]);
+            assertEquals(3.f * DP_TO_PX, (Float) arguments[arguments.length - 1], 0.0001f);
+        }
+    }
+
+    private static ContainerTabBadge.Info containerBadge() throws Exception {
+        java.lang.reflect.Constructor<ContainerTabBadge.Info> constructor =
+                ContainerTabBadge.Info.class.getDeclaredConstructor(
+                        String.class, String.class, int.class, int.class);
+        constructor.setAccessible(true);
+        return constructor.newInstance("Work", "Container: Work", 0xffd93025, 1);
+    }
