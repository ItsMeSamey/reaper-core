+IN_PROC_BROWSER_TEST_F(IsolatedCctHistoricalTabSaverBrowserTest,
+                       IsolatedMayLaunchUrlCctAdoptsActualFactoryContentsOnly) {
+  net::EmbeddedTestServer https(net::EmbeddedTestServer::TYPE_HTTPS);
+  https.ServeFilesFromSourceDirectory("chrome/test/data");
+  ASSERT_TRUE(https.Start());
+  const auto url = https.GetURL("/android/google.html");
+  auto* default_contents = GetActiveWebContents();
+  ASSERT_TRUE(content::NavigateToURL(default_contents, url));
+  ASSERT_TRUE(
+      content::ExecJs(default_contents, "localStorage.reaperCct = 'default'"));
+
+  JNIEnv* env = base::android::AttachCurrentThread();
+  auto factory = base::android::GetClass(
+      env, "org/chromium/chrome/browser/content/WebContentsFactory");
+  auto warmup_class =
+      base::android::GetClass(env, "org/chromium/chrome/browser/WarmupManager");
+  const auto create = env->GetStaticMethodID(
+      factory.obj(),
+      "createWebContentsWithSeparateStoragePartitionForExperiment",
+      "(Lorg/chromium/chrome/browser/profiles/Profile;)"
+      "Lorg/chromium/content_public/browser/WebContents;");
+  const auto matches = env->GetStaticMethodID(
+      factory.obj(), "isWebContentsForSeparateStoragePartitionExperiment",
+      "(Lorg/chromium/chrome/browser/profiles/Profile;"
+      "Lorg/chromium/content_public/browser/WebContents;)Z");
+  const auto get_warmup =
+      env->GetStaticMethodID(warmup_class.obj(), "getInstance",
+                             "()Lorg/chromium/chrome/browser/WarmupManager;");
+  const auto regular_spare =
+      env->GetMethodID(warmup_class.obj(), "createRegularSpareTab",
+                       "(Lorg/chromium/chrome/browser/profiles/Profile;"
+                       "Lorg/chromium/content_public/browser/WebContents;)V");
+  const auto isolated_spare = env->GetMethodID(
+      warmup_class.obj(),
+      "createRegularSpareTabForSeparateStoragePartitionExperiment",
+      "(Lorg/chromium/chrome/browser/profiles/Profile;"
+      "Lorg/chromium/content_public/browser/WebContents;)V");
+  const auto destroy_spare =
+      env->GetMethodID(warmup_class.obj(), "destroySpareTab", "()V");
+  const auto take_spare =
+      env->GetMethodID(warmup_class.obj(), "takeSpareTab",
+                       "(Lorg/chromium/chrome/browser/profiles/Profile;ZI)"
+                       "Lorg/chromium/chrome/browser/tab/Tab;");
+  ASSERT_TRUE(create && matches && get_warmup && regular_spare &&
+              isolated_spare && destroy_spare && take_spare);
+  auto profile = GetProfile()->GetJavaObject();
+  auto warmup = base::android::ScopedJavaLocalRef<jobject>::Adopt(
+      env, env->CallStaticObjectMethod(warmup_class.obj(), get_warmup));
+  ASSERT_FALSE(env->ExceptionCheck());
+  ASSERT_FALSE(warmup.is_null());
+  base::WeakPtr<content::WebContents> isolated_contents;
+  base::android::ScopedJavaGlobalRef<jobject> cleanup_tab;
+  base::ScopedClosureRunner cleanup(base::BindOnce(
+      [](JNIEnv* env, base::android::ScopedJavaGlobalRef<jobject> manager,
+         jmethodID destroy_spare,
+         base::WeakPtr<content::WebContents>* isolated_contents_ptr,
+         base::android::ScopedJavaGlobalRef<jobject>* cleanup_tab_ptr) {
+        auto& isolated_contents = *isolated_contents_ptr;
+        auto& cleanup_tab = *cleanup_tab_ptr;
+        // An assertion may return with a Java exception pending. Clear it so
+        // cleanup can release the actual Java/native owners on every exit.
+        env->ExceptionClear();
+        env->CallVoidMethod(manager.obj(), destroy_spare);
+        const bool spare_destroyed = !env->ExceptionCheck();
+        EXPECT_TRUE(spare_destroyed);
+        env->ExceptionClear();
+        if (!cleanup_tab.is_null()) {
+          auto tab_class = base::android::GetClass(
+              env, "org/chromium/chrome/browser/tab/Tab");
+          env->CallVoidMethod(
+              cleanup_tab.obj(),
+              env->GetMethodID(tab_class.obj(), "destroy", "()V"));
+          EXPECT_FALSE(env->ExceptionCheck());
+          env->ExceptionClear();
+        } else if (spare_destroyed && isolated_contents) {
+          // Rejected factory contents have not transferred into a Tab. If a
+          // spare adopted them, destroying that spare invalidated this weak
+          // ptr.
+          delete isolated_contents.get();
+        }
+      },
+      base::Unretained(env),
+      base::android::ScopedJavaGlobalRef<jobject>(warmup), destroy_spare,
+      base::Unretained(&isolated_contents), base::Unretained(&cleanup_tab)));
+  env->CallVoidMethod(warmup.obj(), destroy_spare);
+  auto java_contents = base::android::ScopedJavaLocalRef<jobject>::Adopt(
+      env, env->CallStaticObjectMethod(factory.obj(), create, profile.obj()));
+  ASSERT_FALSE(env->ExceptionCheck());
+  auto *contents = content::WebContents::FromJavaWebContents(java_contents);
+  if (contents) {
+    isolated_contents = contents->GetWeakPtr();
+  }
+  ASSERT_TRUE(contents);
+  auto config = contents->GetSiteInstance()
+                    ->GetSecurityPrincipal()
+                    .GetStoragePartitionConfig();
+  EXPECT_EQ(config.partition_domain(),
+            "MayLaunchUrlUsesSeparateStoragePartitionDomain");
+  EXPECT_EQ(config.partition_name(), "1");
+  EXPECT_TRUE(config.in_memory());
+  EXPECT_EQ(contents->GetBrowserContext(), GetProfile());
+  EXPECT_FALSE(containers::android::WebContentsMatchesContainer(GetProfile(),
+                                                                contents, ""));
+  EXPECT_TRUE(env->CallStaticBooleanMethod(factory.obj(), matches,
+                                           profile.obj(), java_contents.obj()));
+  EXPECT_FALSE(env->CallStaticBooleanMethod(
+      factory.obj(), matches,
+      GetProfile()
+          ->GetPrimaryOTRProfile(/*create_if_needed=*/true)
+          ->GetJavaObject()
+          .obj(),
+      java_contents.obj()));
+
+  // The ordinary spare path must still reject the nondefault partition before
+  // it allocates a Tab or WindowAndroid. The rejected contents remain usable.
+  env->CallVoidMethod(warmup.obj(), regular_spare, profile.obj(),
+                      java_contents.obj());
+  ASSERT_TRUE(env->ExceptionCheck());
+  auto exception = env->ExceptionOccurred();
+  env->ExceptionClear();
+  auto illegal_argument =
+      base::android::GetClass(env, "java/lang/IllegalArgumentException");
+  EXPECT_TRUE(env->IsInstanceOf(exception, illegal_argument.obj()));
+  env->DeleteLocalRef(exception);
+  env->CallVoidMethod(warmup.obj(), isolated_spare, profile.obj(),
+                      default_contents->GetJavaWebContents().obj());
+  ASSERT_TRUE(
+      env->ExceptionCheck());  // Dedicated route rejects default contents too.
+  env->ExceptionClear();
+  auto* named = OpenContainer("4a4d13b6-c971-4c61-ae11-e7a864f58165");
+  ASSERT_TRUE(named);
+  env->CallVoidMethod(warmup.obj(), isolated_spare, profile.obj(),
+                      named->web_contents()->GetJavaWebContents().obj());
+  ASSERT_TRUE(
+      env->ExceptionCheck());  // It also rejects genuine Reaper containers.
+  env->ExceptionClear();
+
+  // Seed a real ordinary spare. The trusted CCT boundary must replace it,
+  // not return its default storage when the caller supplies isolated contents.
+  env->CallVoidMethod(warmup.obj(), regular_spare, profile.obj(),
+                      static_cast<jobject>(nullptr));
+  ASSERT_FALSE(env->ExceptionCheck());
+  env->CallVoidMethod(warmup.obj(), isolated_spare, profile.obj(),
+                      java_contents.obj());
+  ASSERT_FALSE(env->ExceptionCheck());
+  const jint launch = static_cast<jint>(
+      TabModel::TabLaunchType::FROM_SPECULATIVE_BACKGROUND_CREATION);
+  auto java_tab = base::android::ScopedJavaLocalRef<jobject>::Adopt(
+      env, env->CallObjectMethod(warmup.obj(), take_spare, profile.obj(),
+                                 JNI_TRUE, launch));
+  if (!java_tab.is_null()) {
+    cleanup_tab.Reset(java_tab);
+  }
+  ASSERT_FALSE(env->ExceptionCheck());
+  ASSERT_FALSE(java_tab.is_null());
+  auto *tab = TabAndroid::GetNativeTab(env, java_tab);
+  ASSERT_TRUE(tab);
+  EXPECT_EQ(tab->web_contents(), contents);
+  EXPECT_EQ(tab->GetContainerId(), "");
+  ASSERT_TRUE(content::NavigateToURL(contents, url));
+  EXPECT_EQ(contents->GetSiteInstance()
+                ->GetSecurityPrincipal()
+                .GetStoragePartitionConfig(),
+            config);
+  ASSERT_TRUE(content::ExecJs(contents, "localStorage.reaperCct = 'isolated'"));
+  EXPECT_EQ(content::EvalJs(contents, "localStorage.reaperCct"), "isolated");
+  EXPECT_EQ(content::EvalJs(default_contents, "localStorage.reaperCct"),
+            "default");
+  EXPECT_TRUE(env->CallStaticBooleanMethod(factory.obj(), matches,
+                                           profile.obj(), java_contents.obj()));
+  EXPECT_FALSE(containers::android::WebContentsMatchesContainer(GetProfile(),
+                                                                contents, ""));
+}
