+IN_PROC_BROWSER_TEST_F(ContainerHistoricalTabSaverBrowserTest,
+                       ContainerSerializedColdContentsRestoreKeepsJavaIdentityAndRejectsDefault) {
+  constexpr char id[] = "t-4a4d13b6-c971-4c61-ae11-e7a864f58165";
+  auto* tab = OpenContainer(id);
+  ASSERT_TRUE(tab);
+  ASSERT_TRUE(content::NavigateToURL(tab->web_contents(),
+      embedded_test_server()->GetURL("/android/google.html")));
+  JNIEnv* env = base::android::AttachCurrentThread();
+  WebContentsStateByteBuffer state(
+      WebContentsState::GetContentsStateAsByteBuffer(env, tab->web_contents()), 2);
+  auto restored = WebContentsState::RestoreContentsFromByteBuffer(
+      GetProfile(), &state, true, true, id);
+  ASSERT_TRUE(restored);
+  EXPECT_TRUE(containers::android::WebContentsMatchesContainer(GetProfile(), restored.get(), id));
+  EXPECT_FALSE(WebContentsState::RestoreContentsFromByteBuffer(
+      GetProfile(), &state, true, true, ""));
+  auto* model = TabModelList::FindTabModelWithWindowSessionId(tab->GetWindowId());
+  ASSERT_TRUE(model);
+  auto* added = model->CreateTab(nullptr, std::move(restored), model->GetTabCount(),
+      TabModel::TabLaunchType::FROM_RECENT_TABS, false);
+  ASSERT_TRUE(added);
+  auto* restored_tab = TabAndroid::FromTabInterface(added);
+  ASSERT_TRUE(restored_tab);
+  EXPECT_EQ(restored_tab->GetContainerId(), id);
+  EXPECT_TRUE(containers::android::WebContentsMatchesContainer(
+      GetProfile(), restored_tab->web_contents(), id));
+}
