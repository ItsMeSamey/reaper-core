+    auto* added = model->CreateTab(nullptr, content::WebContents::Create(params),
+        model->GetTabCount(), TabModel::TabLaunchType::FROM_RECENT_TABS, false);
+    return added ? TabAndroid::FromTabInterface(added) : nullptr;
