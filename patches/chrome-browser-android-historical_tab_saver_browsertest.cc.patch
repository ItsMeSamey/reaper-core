+IN_PROC_BROWSER_TEST_F(ContainerHistoricalTabSaverBrowserTest,
+                       ContainerJavaAdoptionSeparatesTwoRealDomStorageJars) {
+  Navigate();
+  auto* default_contents = GetActiveWebContents();
+  constexpr char first_id[] = "4a4d13b6-c971-4c61-ae11-e7a864f58165";
+  constexpr char second_id[] = "22a6d27a-e4ef-46ec-8f8f-11a93d558b33";
+  auto* first = OpenContainer(first_id);
+  auto* second = OpenContainer(second_id);
+  ASSERT_TRUE(first && second);
+  EXPECT_EQ(first->GetContainerId(), first_id);
+  EXPECT_EQ(second->GetContainerId(), second_id);
+  ASSERT_TRUE(containers::android::WebContentsMatchesContainer(
+      GetProfile(), first->web_contents(), first_id));
+  ASSERT_TRUE(containers::android::WebContentsMatchesContainer(
+      GetProfile(), second->web_contents(), second_id));
+  const auto url = embedded_test_server()->GetURL("/android/google.html");
+  ASSERT_TRUE(content::NavigateToURL(first->web_contents(), url));
+  ASSERT_TRUE(content::NavigateToURL(second->web_contents(), url));
+  ASSERT_TRUE(content::ExecJs(default_contents, "localStorage.reaperContainer = 'default'"));
+  ASSERT_TRUE(content::ExecJs(first->web_contents(), "localStorage.reaperContainer = 'first'"));
+  ASSERT_TRUE(content::ExecJs(second->web_contents(), "localStorage.reaperContainer = 'second'"));
+  EXPECT_EQ(content::EvalJs(default_contents, "localStorage.reaperContainer"), "default");
+  EXPECT_EQ(content::EvalJs(first->web_contents(), "localStorage.reaperContainer"), "first");
+  EXPECT_EQ(content::EvalJs(second->web_contents(), "localStorage.reaperContainer"), "second");
+  EXPECT_FALSE(containers::android::WebContentsMatchesContainer(
+      GetProfile(), first->web_contents(), second_id));
+}
