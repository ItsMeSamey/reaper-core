+IN_PROC_BROWSER_TEST_F(HistoricalTabSaverBrowserTest,
+                       SplitHistoryKeepsOrderAndReconstructsAfterGrouping) {
+  Navigate();
+  JNIEnv* env = base::android::AttachCurrentThread();
+  TabAndroid* leading = TabAndroid::FromWebContents(GetActiveWebContents());
+  ASSERT_TRUE(leading);
+  TabModel* model =
+      TabModelList::FindTabModelWithWindowSessionId(leading->GetWindowId());
+  ASSERT_TRUE(model);
+  const GURL url = embedded_test_server()->GetURL("/android/google.html");
+  auto* opened = model->OpenTab(url, model->GetTabCount(), false);
+  ASSERT_TRUE(opened);
+  TabAndroid* trailing = TabAndroid::FromWebContents(opened->GetContents());
+  ASSERT_TRUE(trailing);
+  ASSERT_TRUE(content::NavigateToURL(trailing->web_contents(), url));
+  const auto id = split_tabs::SplitTabId::GenerateNew();
+  ASSERT_TRUE(TabModelJniBridge::RestoreSplit(
+      env, model->GetJavaObject(), id.token(),
+      std::vector<int>{leading->GetAndroidId(), trailing->GetAndroidId()}, 1,
+      0.37));
+  ASSERT_EQ(leading->GetSplit(), id);
+  ASSERT_EQ(trailing->GetSplit(), id);
+
+  std::vector<WebContentsStateByteBuffer> states;
+  states.emplace_back(WebContentsState::GetContentsStateAsByteBuffer(
+                          env, trailing->web_contents()),
+                      2);
+  states.emplace_back(WebContentsState::GetContentsStateAsByteBuffer(
+                          env, leading->web_contents()),
+                      2);
+  AndroidLiveTabContextCloseWrapper closing(model, {trailing, leading}, {}, {},
+                                            {}, std::move(states));
+  auto* first = closing.GetLiveTabAt(0);
+  auto* second = closing.GetLiveTabAt(1);
+  ASSERT_NE(first, second);
+  EXPECT_EQ(&static_cast<sessions::ContentLiveTab*>(first)->GetWebContents(),
+            leading->web_contents());
+  EXPECT_EQ(&static_cast<sessions::ContentLiveTab*>(second)->GetWebContents(),
+            trailing->web_contents());
+  EXPECT_EQ(closing.GetLiveTabAt(0), first);
+  model->Unsplit(id);
+  EXPECT_FALSE(leading->GetSplit());
+  EXPECT_EQ(closing.GetSplitForTab(0), id);
+  EXPECT_EQ(closing.GetSplitForTab(1), id);
+  ASSERT_TRUE(closing.GetVisualDataForSplit(id));
+  EXPECT_EQ(closing.GetVisualDataForSplit(id)->split_layout(),
+            split_tabs::SplitTabLayout::kStacked);
+  EXPECT_DOUBLE_EQ(closing.GetVisualDataForSplit(id)->split_ratio(), 0.37);
+
+  auto* service = TabRestoreServiceFactory::GetForProfile(GetProfile());
+  ASSERT_TRUE(service);
+  service->ClearEntries();
+  service->BrowserClosing(&closing);
+  service->BrowserClosed(&closing);
+  ASSERT_EQ(service->entries().size(), 1u);
+  ASSERT_EQ(service->entries().front()->type,
+            sessions::tab_restore::Type::WINDOW);
+  const auto& saved = static_cast<const sessions::tab_restore::Window&>(
+      *service->entries().front());
+  ASSERT_EQ(saved.tabs.size(), 2u);
+  EXPECT_EQ(saved.tabs[0]->split_id, id);
+  EXPECT_EQ(saved.tabs[1]->split_id, id);
+  ASSERT_TRUE(saved.tabs[0]->split_visual_data);
+  EXPECT_DOUBLE_EQ(saved.tabs[0]->split_visual_data->split_ratio(), 0.37);
+
+  AndroidLiveTabContextRestoreWrapper restoring(model);
+  restoring.ReconstructSplit(first, second, id,
+                             *closing.GetVisualDataForSplit(id));
+  EXPECT_FALSE(leading->GetSplit());
+  // The Java group restore happens at this boundary in the real bridge.
+  restoring.RestoreSplits();
+  EXPECT_EQ(leading->GetSplit(), id);
+  EXPECT_EQ(trailing->GetSplit(), id);
+  restoring.RestoreSplits();
+  EXPECT_EQ(leading->GetSplit(), id);
+
+  std::vector<WebContentsStateByteBuffer> orphan_state;
+  orphan_state.emplace_back(WebContentsState::GetContentsStateAsByteBuffer(
+                                env, leading->web_contents()),
+                            2);
+  AndroidLiveTabContextCloseWrapper orphan(model, {leading}, {}, {}, {},
+                                           std::move(orphan_state));
+  EXPECT_FALSE(orphan.GetSplitForTab(0));
+  model->Unsplit(id);
+  service->ClearEntries();
+}
 
 // Test WebContentsByteBuffer non-empty object creation.
