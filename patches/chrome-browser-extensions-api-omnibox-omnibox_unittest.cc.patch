+#if BUILDFLAG(IS_ANDROID)
+class AndroidOmniboxInputTest : public testing::Test {
+ protected:
+  scoped_refptr<const Extension> AddExtension(bool has_keyword) {
+    ExtensionBuilder builder(has_keyword ? "keyword" : "ordinary");
+    if (has_keyword) {
+      builder.SetManifestKey("omnibox",
+                             base::DictValue().Set("keyword", "test"));
+    }
+    auto extension = builder.Build();
+    ExtensionRegistry::Get(&profile_)->AddEnabled(extension);
+    return extension;
+  }
+
+  bool IsValid(Profile* profile, const GURL& url) {
+    return ExtensionOmniboxEventRouter::IsValidAndroidInput(profile, url);
+  }
+
+  content::BrowserTaskEnvironment task_environment_;
+  TestingProfile profile_;
+};
+
+TEST_F(AndroidOmniboxInputTest, RejectsInvalidStaleAndOrdinaryExtensionUrls) {
+  EXPECT_FALSE(IsValid(nullptr, GURL("chrome-extension://missing/?q=test")));
+  EXPECT_FALSE(IsValid(&profile_, GURL()));
+  EXPECT_FALSE(IsValid(&profile_, GURL("https://example.test/?q=test")));
+  EXPECT_FALSE(IsValid(&profile_, GURL("chrome-extension://missing/?q=test")));
+
+  auto ordinary = AddExtension(false);
+  EXPECT_FALSE(IsValid(&profile_, ordinary->GetResourceURL("?q=test")));
+  auto keyword = AddExtension(true);
+  const GURL command = keyword->GetResourceURL("?q=test");
+  EXPECT_TRUE(IsValid(&profile_, command));
+  EXPECT_TRUE(IsValid(&profile_, keyword->GetResourceURL("?q=")));
+  EXPECT_FALSE(IsValid(&profile_, keyword->GetResourceURL("page.html?q=test")));
+  EXPECT_FALSE(IsValid(&profile_, keyword->GetResourceURL("")));
+  EXPECT_FALSE(IsValid(&profile_, keyword->GetResourceURL("?q=test#fragment")));
+  ExtensionRegistry::Get(&profile_)->RemoveEnabled(keyword->id());
+  EXPECT_FALSE(IsValid(&profile_, command));
+  ExtensionRegistry::Get(&profile_)->AddDisabled(keyword);
+  EXPECT_FALSE(IsValid(&profile_, command));
+}
+
+TEST_F(AndroidOmniboxInputTest, RechecksIncognitoPermission) {
+  auto keyword = AddExtension(true);
+  const GURL command = keyword->GetResourceURL("?q=test");
+  Profile* incognito = profile_.GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  EXPECT_TRUE(IsValid(&profile_, command));
+  EXPECT_FALSE(IsValid(incognito, command));
+  ExtensionPrefs::Get(&profile_)->SetIsIncognitoEnabled(keyword->id(), true);
+  EXPECT_TRUE(IsValid(incognito, command));
+  ExtensionPrefs::Get(&profile_)->SetIsIncognitoEnabled(keyword->id(), false);
+  EXPECT_FALSE(IsValid(incognito, command));
+}
+#endif  // BUILDFLAG(IS_ANDROID)
 }  // namespace extensions
