+        assert(enable_linker_map, "Reaper link provenance requires linker maps")
+        assert(reaper_link_timeout_seconds >= 1 &&
+                   reaper_link_timeout_seconds <= 28800,
+               "Reaper link timeout must be between 1 and 28800 seconds")
+        inputs = [ "//brave/build/android/reaper_link_provenance.py" ]
+        reaper_link_receipt = "$sofile_with_symbols.link-provenance.json"
+        reaper_link_collector = rebase_path(
