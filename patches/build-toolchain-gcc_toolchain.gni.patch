+                root_build_dir)
+        reaper_source_root = rebase_path("//", root_build_dir)
+        command = "\"$python_path\" -I -B \"$reaper_link_collector\" --link-timeout-seconds=$reaper_link_timeout_seconds --source-root=\"$reaper_source_root\" --receipt=\"$reaper_link_receipt\" --output=\"$sofile\" --unstripped=\"$sofile_with_symbols\" --map=\"$map_file\" -- " + command
+      }
+
       if (target_cpu == "mipsel" && is_component_build && is_android) {
         rspfile_content = "-Wl,--start-group -Wl,--whole-archive {{inputs}} {{solibs}} -Wl,--no-whole-archive {{libs}} -Wl,--end-group"
       } else if (current_os == "aix") {
@@ -548,6 +571,9 @@
