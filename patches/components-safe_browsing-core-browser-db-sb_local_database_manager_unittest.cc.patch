+TEST_P(SBLocalDatabaseManagerTest_ExtensionSkipNetworkQuery,
+       ExtensionOnlyMatchAndDisableRestart) {
+  ResetExtensionOnlyDatabaseManager();
+  const FullHashStr bad_id("aapbdbdomjkkjkaonfhkkikfgjllcleb");
+  const FullHashStr good_id("aapbdbdomjkkjkaonfhkkikfgjllclec");
+  StoreAndHashPrefixes prefixes;
+  prefixes.emplace_back(GetChromeExtMalwareId(),
+                        GetParam().enable_v5 ? SBStore::ExtensionIdToHash(bad_id)
+                                             : bad_id);
+  ReplaceSBDatabase(prefixes, /*stores_available=*/true);
+  TestExtensionClient client({bad_id});
+  EXPECT_FALSE(sb_local_database_manager_->CheckExtensionIDs(
+      {bad_id, good_id}, &client));
+  WaitForTasksOnTaskRunner();
+  EXPECT_TRUE(client.on_check_extensions_result_called());
+
+  StopLocalDatabaseManager();
+  EXPECT_FALSE(sb_local_database_manager_->IsDatabaseReady());
+  TestExtensionClient disabled_client({});
+  EXPECT_TRUE(sb_local_database_manager_->CheckExtensionIDs(
+      {bad_id}, &disabled_client));
+  StartLocalDatabaseManager();
+  WaitForTasksOnTaskRunner();
+  EXPECT_TRUE(sb_local_database_manager_->IsDatabaseReady());
+  EXPECT_EQ(StoresToCheck({GetChromeExtMalwareId()}),
+            sb_local_database_manager_->GetStoresForFullHashRequests());
+}
+
+TEST_P(SBLocalDatabaseManagerTest_ExtensionSkipNetworkQuery,
+       ExtensionOnlyQueuedCancellationAndShutdown) {
+  ResetExtensionOnlyDatabaseManager();
+  StopLocalDatabaseManager();
+  StartLocalDatabaseManager();
+  TestExtensionClient cancelled({});
+  EXPECT_FALSE(sb_local_database_manager_->CheckExtensionIDs(
+      {"aapbdbdomjkkjkaonfhkkikfgjllcleb"}, &cancelled));
+  EXPECT_EQ(1u, GetQueuedChecks().size());
+  sb_local_database_manager_->CancelCheck(&cancelled);
+  EXPECT_TRUE(GetQueuedChecks().empty());
+  WaitForTasksOnTaskRunner();
+  EXPECT_FALSE(cancelled.on_check_extensions_result_called());
+
+  StopLocalDatabaseManager();
+  StartLocalDatabaseManager();
+  TestExtensionClient disabled({});
+  EXPECT_FALSE(sb_local_database_manager_->CheckExtensionIDs(
+      {"aapbdbdomjkkjkaonfhkkikfgjllcleb"}, &disabled));
+  StopLocalDatabaseManager();
+  EXPECT_TRUE(disabled.on_check_extensions_result_called());
+
+  StartLocalDatabaseManager();
+  TestExtensionClient shutdown({});
+  EXPECT_FALSE(sb_local_database_manager_->CheckExtensionIDs(
+      {"aapbdbdomjkkjkaonfhkkikfgjllcleb"}, &shutdown));
+  ShutdownLocalDatabaseManager();
+  EXPECT_TRUE(GetQueuedChecks().empty());
+  EXPECT_FALSE(shutdown.on_check_extensions_result_called());
 }
 
