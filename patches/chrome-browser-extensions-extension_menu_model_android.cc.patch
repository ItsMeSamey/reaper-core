+void CollectVisibleExtensionIds(
+    ui::MenuModel& model,
+    const std::map<int, MenuItem::Id>& extension_items,
+    ExtensionIdSet& ids) {
+  for (size_t i = 0; i < model.GetItemCount(); ++i) {
+    if (!model.IsVisibleAt(i)) {
+      continue;
+    }
+    // Match the row types copied by MenuModelBridge::AddExtensionItems.
+    switch (model.GetTypeAt(i)) {
+      case ui::MenuModel::TYPE_COMMAND:
+      case ui::MenuModel::TYPE_HIGHLIGHTED:
+      case ui::MenuModel::TYPE_CHECK:
+      case ui::MenuModel::TYPE_RADIO:
+      case ui::MenuModel::TYPE_SUBMENU:
+        break;
+      default:
+        continue;
+    }
+    auto item = extension_items.find(model.GetCommandIdAt(i));
+    if (item != extension_items.end() &&
+        !item->second.extension_key.extension_id.empty()) {
+      ids.insert(item->second.extension_key.extension_id);
+    }
+    if (auto* submenu = model.GetSubmenuModelAt(i)) {
+      CollectVisibleExtensionIds(*submenu, extension_items, ids);
+    }
+  }
+}
+
+}  // namespace

