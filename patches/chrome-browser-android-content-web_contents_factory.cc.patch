+// Keep creation and the trusted CCT adoption check bound to the same config.
+content::StoragePartitionConfig ExperimentPartitionConfig(Profile* profile) {
+  return content::StoragePartitionConfig::Create(
+      profile, "MayLaunchUrlUsesSeparateStoragePartitionDomain", "1",
+      /*in_memory=*/true);
+}
+
+}  // namespace
+
+static bool
+JNI_WebContentsFactory_IsWebContentsForSeparateStoragePartitionExperiment(
+    JNIEnv* env,
+    Profile* profile,
+    content::WebContents* web_contents) {
+  if (!profile || profile->ShutdownStarted() || profile->IsOffTheRecord() ||
+      !web_contents ||
+      web_contents->IsBeingDestroyed() ||
+      web_contents->GetBrowserContext() != profile) {
+    return false;
+  }
+  auto* site_instance = web_contents->GetSiteInstance();
+  return site_instance && site_instance->GetBrowserContext() == profile &&
+         site_instance->GetSecurityPrincipal().GetStoragePartitionConfig() ==
+             ExperimentPartitionConfig(profile);
+}

