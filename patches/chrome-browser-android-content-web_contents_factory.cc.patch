 static ScopedJavaLocalRef<jobject>
+JNI_WebContentsFactory_CreateWebContentsForContainer(
+    JNIEnv* env,
+    Profile* profile,
+    bool initially_hidden,
+    bool initialize_renderer,
+    bool uses_platform_autofill,
+    int64_t j_target_network,
+    const std::string& container_id,
+    const JavaRef<jthrowable>& j_creator_location) {
+  auto partition = containers::android::ResolveContainerStoragePartition(
+      profile, container_id);
+  if (!partition) {
+    return {};
+  }
+  content::WebContents::CreateParams params(profile);
+  if (!container_id.empty()) {
+    params.site_instance =
+        content::SiteInstance::CreateForFixedStoragePartition(
+            profile, GURL(), *partition);
+  }
+  params.initially_hidden = initially_hidden;
+  params.initially_use_platform_autofill = uses_platform_autofill;
+  params.desired_renderer_state =
+      initialize_renderer
+          ? content::WebContents::CreateParams::kInitializeAndWarmupRendererProcess
+          : content::WebContents::CreateParams::kOkayToHaveRendererProcess;
+  params.target_network = j_target_network;
+  params.java_creator_location = j_creator_location;
+  auto web_contents = content::WebContents::Create(params);
+  if (!container_id.empty()) {
+    // Preserve this admitted identity's metadata before it can be removed from
+    // the selector. Android does not use the desktop navigation tracker.
+    auto* service = ContainersServiceFactory::GetForProfile(profile);
+    CHECK(service);
+    service->MarkContainerUsed(container_id);
+  }
+  return web_contents.release()->GetJavaWebContents();
+}
