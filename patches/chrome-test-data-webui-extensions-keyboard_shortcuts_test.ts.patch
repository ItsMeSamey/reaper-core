+  test('AndroidWideCommandControlsStayOnOneRow', async function() {
+    keyboardShortcuts.style.display = 'block';
+    keyboardShortcuts.style.width = '680px';
+    keyboardShortcuts.items = [oneCommand];
+    await microtasksFinished();
+    const card = keyboardShortcuts.shadowRoot.querySelector<HTMLElement>(
+        '.shortcut-card')!;
+    const groups = card.querySelectorAll<HTMLElement>(
+        '.command-name, .shortcut-input-container, .shortcut-scope-container');
+    assertEquals(3, groups.length);
+    for (const direction of ['ltr', 'rtl']) {
+      keyboardShortcuts.dir = direction;
+      const bounds = card.getBoundingClientRect();
+      const rects = Array.from(groups, group => group.getBoundingClientRect());
+      // Ordinary controls must still share a row, not become a phone stack.
+      assertTrue(
+          Math.max(...rects.map(rect => rect.top)) <
+          Math.min(...rects.map(rect => rect.bottom)));
+      for (let i = 0; i < rects.length; ++i) {
+        const rect = rects[i]!;
+        assertTrue(rect.width > 0 && rect.height > 0);
+        assertTrue(rect.left >= bounds.left - 1);
+        assertTrue(rect.right <= bounds.right + 1);
+        if (i > 0) {
+          const previous = rects[i - 1]!;
+          if (direction === 'ltr') {
+            assertTrue(previous.right <= rect.left + 1);
+          } else {
+            assertTrue(previous.left >= rect.right - 1);
+          }
+        }
+      }
+    }
+  });
