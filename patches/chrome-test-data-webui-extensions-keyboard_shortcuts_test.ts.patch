+  test('AndroidLastCardRemovalReleasesCapture', async function() {
+    keyboardShortcuts.items = [oneCommand];
+    await microtasksFinished();
+    const input = keyboardShortcuts.shadowRoot.querySelector('cr-shortcut-input')!;
+    input.$.edit.click();
+    await microtasksFinished();
+    assertTrue(input.isCapturing());
+    assertTrue(await testDelegate.whenCalled('setShortcutHandlingSuspended'));
+    testDelegate.reset();
+
+    keyboardShortcuts.items = [];
+    await microtasksFinished();
+    assertFalse(input.isConnected);
+    assertFalse(input.isCapturing());
+    assertFalse(await testDelegate.whenCalled('setShortcutHandlingSuspended'));
+    assertEquals(1, testDelegate.getCallCount('setShortcutHandlingSuspended'));
+    assertEquals(0, testDelegate.getCallCount('updateExtensionCommandKeybinding'));
+  });
+
+  test('AndroidRemovedCommandCannotRetargetCapturedInput', async function() {
+    keyboardShortcuts.items = [twoCommands];
+    await microtasksFinished();
+    const input = keyboardShortcuts.shadowRoot.querySelector('cr-shortcut-input')!;
+    input.$.edit.click();
+    await microtasksFinished();
+    assertTrue(input.isCapturing());
+    testDelegate.reset();
+
+    keyboardShortcuts.items = [{
+      ...twoCommands,
+      commands: [twoCommands.commands[1]!],
