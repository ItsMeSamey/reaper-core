+  test('AndroidLateEndCannotReleaseReplacementOrRecapturedInput', async function() {
+    keyboardShortcuts.items = [oneCommand, twoCommands];
+    await microtasksFinished();
+    const inputs = keyboardShortcuts.shadowRoot.querySelectorAll('cr-shortcut-input');
+    const first = inputs[0]!;
+    const second = inputs[1]!;
+    first.$.edit.click();
+    await microtasksFinished();
+    assertTrue(first.isCapturing());
+    testDelegate.reset();
+
+    second.$.edit.click();
+    assertTrue(second.isCapturing());
+    // Deliver the second real capture before the old blur's awaited end.
+    second.dispatchEvent(new CustomEvent('input-capture-change', {
+      bubbles: true, composed: true, detail: true,
+    }));
+    await microtasksFinished();
+    assertTrue(second.isCapturing());
+    assertDeepEquals([true], testDelegate.getArgs('setShortcutHandlingSuspended'));
+    testDelegate.reset();
+
+    first.dispatchEvent(new CustomEvent('input-capture-change', {
+      bubbles: true, composed: true, detail: false,
+    }));
+    await microtasksFinished();
+    assertTrue(second.isCapturing());
+    assertEquals(0, testDelegate.getCallCount('setShortcutHandlingSuspended'));
+
+    second.cancelCapture();
+    await microtasksFinished();
+    assertFalse(second.isCapturing());
+    assertDeepEquals([false], testDelegate.getArgs('setShortcutHandlingSuspended'));
+    testDelegate.reset();
+    second.$.edit.click();
+    await microtasksFinished();
+    assertTrue(second.isCapturing());
+    assertDeepEquals([true], testDelegate.getArgs('setShortcutHandlingSuspended'));
+    testDelegate.reset();
+    // A delayed duplicate end from its previous capture must not end this one.
+    second.dispatchEvent(new CustomEvent('input-capture-change', {
+      bubbles: true, composed: true, detail: false,
+    }));
+    await microtasksFinished();
+    assertTrue(second.isCapturing());
+    assertEquals(0, testDelegate.getCallCount('setShortcutHandlingSuspended'));
+    assertEquals(0, testDelegate.getCallCount('updateExtensionCommandKeybinding'));
+  });
