+  test('AndroidDisconnectCancelsPendingCaptureStart', async function() {
+    keyboardShortcuts.items = [oneCommand];
+    await microtasksFinished();
+    const input = keyboardShortcuts.shadowRoot.querySelector('cr-shortcut-input')!;
+    input.$.edit.click();
+    // Edit focuses synchronously; startCapture_ is now awaiting its update.
+    // Disconnect before that pending start can notify the page.
+    assertTrue(input.isCapturing());
+    assertEquals(0, testDelegate.getCallCount('setShortcutHandlingSuspended'));
+    keyboardShortcuts.remove();
+    await microtasksFinished();
+    assertFalse(input.isCapturing());
+    assertEquals(0, testDelegate.getCallCount('setShortcutHandlingSuspended'));
+    assertEquals(0, testDelegate.getCallCount('updateExtensionCommandKeybinding'));
+  });
