+  test('AndroidResponsiveCommandControls', async function() {
+    // The card is the query container, so this also exercises a narrow split
+    // window without depending on the WebUI test runner's viewport size.
+    keyboardShortcuts.style.display = 'block';
+    const longLabel = 'ExtensionCommandWithALongLocalizedLabel'.repeat(3);
+    oneCommand.name = longLabel;
+    oneCommand.commands[0]!.description = longLabel;
+    keyboardShortcuts.items = [oneCommand];
+    await microtasksFinished();
+    const card = keyboardShortcuts.shadowRoot.querySelector<HTMLElement>(
+        '.shortcut-card')!;
+    const command = card.querySelector<HTMLElement>('.command-entry')!;
+    const shortcutInput = command.querySelector('cr-shortcut-input')!;
+    const labels = command.querySelectorAll<HTMLElement>(
+        '.shortcut-input-label, .shortcut-scope-label');
+    for (const label of labels) {
+      label.textContent = longLabel;
+    }
+
+    const rootStyle = document.documentElement.style;
+    const originalRootFontSize = rootStyle.getPropertyValue('font-size');
+    const originalRootFontPriority = rootStyle.getPropertyPriority('font-size');
+    try {
+      // Include the inner input cap and both sides of the layout breakpoint.
+      for (const width of [200, 320, 360, 430, 600, 601, 680]) {
+        keyboardShortcuts.style.width = `${width}px`;
+        for (const fontSize of [13, 26]) {
+          keyboardShortcuts.style.fontSize = `${fontSize}px`;
+          let smallRootLabelSize = 0;
+          for (const rootFontSize of [16, 32]) {
+            rootStyle.setProperty('font-size', `${rootFontSize}px`, 'important');
+            const labelSize = Number.parseFloat(
+                getComputedStyle(labels[0]!).fontSize);
+            if (rootFontSize === 16) {
+              smallRootLabelSize = labelSize;
+            } else {
+              // Ensure this tests actual rem growth, not just inherited fonts.
+              assertTrue(labelSize > smallRootLabelSize);
+            }
+            for (const direction of ['ltr', 'rtl']) {
+              keyboardShortcuts.dir = direction;
+              const bounds = card.getBoundingClientRect();
+              const groups = command.querySelectorAll<HTMLElement>(
+                  '.command-name, .shortcut-input-container, ' +
+                  '.shortcut-scope-container');
+              const groupRects: DOMRect[] = [];
+              for (const group of groups) {
+                const rect = group.getBoundingClientRect();
+                assertTrue(rect.width > 0 && rect.height > 0);
+                assertTrue(rect.left >= bounds.left - 1);
+                assertTrue(rect.right <= bounds.right + 1);
+                assertTrue(rect.top >= bounds.top - 1);
+                assertTrue(rect.bottom <= bounds.bottom + 1);
+                assertTrue(group.scrollWidth <= group.clientWidth + 1);
+                for (const previous of groupRects) {
+                  if (width <= 600) {
+                    assertTrue(rect.top >= previous.bottom - 1);
+                  }
+                  // Both horizontal rows and vertical stacks must not overlap.
+                  assertTrue(
+                      rect.right <= previous.left + 1 ||
+                      rect.left >= previous.right - 1 ||
+                      rect.bottom <= previous.top + 1 ||
+                      rect.top >= previous.bottom - 1);
+                }
+                groupRects.push(rect);
+              }
+              const controls = [
+                shortcutInput.shadowRoot.querySelector<HTMLElement>('#main')!,
+                shortcutInput.$.input,
+                command.querySelector<HTMLElement>('select')!,
+                card.querySelector<HTMLElement>('.card-title span')!,
+                ...labels,
+              ];
+              for (const control of controls) {
+                const rect = control.getBoundingClientRect();
+                assertTrue(rect.width > 0 && rect.height > 0);
+                assertTrue(rect.left >= bounds.left - 1);
+                assertTrue(rect.right <= bounds.right + 1);
+                assertTrue(rect.top >= bounds.top - 1);
+                assertTrue(rect.bottom <= bounds.bottom + 1);
+                assertTrue(control.scrollWidth <= control.clientWidth + 1);
+              }
+              assertTrue(card.scrollWidth <= card.clientWidth + 1);
+            }
+          }
+        }
+      }
+    } finally {
+      if (originalRootFontSize) {
+        rootStyle.setProperty(
+            'font-size', originalRootFontSize, originalRootFontPriority);
+      } else {
+        rootStyle.removeProperty('font-size');
+      }
+    }
+  });
+  // </if>
