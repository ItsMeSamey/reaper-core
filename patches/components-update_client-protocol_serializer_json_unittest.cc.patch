+#if BUILDFLAG(IS_ANDROID)
+TEST(SerializeRequestJSON, AndroidOmitsOptionalTelemetryKeepsUpdateData) {
+  // Exercise construction and the wire boundary independently. A passive DTO
+  // filled by another caller must not reintroduce optional reporting fields.
+  auto app = MakeProtocolApp(
+      "id1", base::Version("1.0"), "", "", "install-id", "en-US", 1234,
+      "ondemand", "internal", {{"attr", "value"}}, "", "", "", "", {},
+      /*cached_hashes=*/{}, MakeProtocolUpdateCheck(false, "2", false, true),
+      {{"install", "needed-data", ""}}, protocol_request::Ping(),
+      std::vector<base::DictValue>());
+  EXPECT_TRUE(app.lang.empty());
+  EXPECT_TRUE(app.install_id.empty());
+  EXPECT_EQ(kDateUnknown, app.install_date);
+  EXPECT_FALSE(app.ping);
+  EXPECT_FALSE(app.events);
+  app.lang = "en-US";
+  app.install_id = "install-id";
+  app.install_date = 1234;
+  app.ping = protocol_request::Ping();
+  app.ping->date_last_active = 1234;
+  app.ping->date_last_roll_call = 1234;
+  app.events.emplace();
+  app.events->emplace_back().Set("eventtype", 3);
+  std::vector<protocol_request::App> apps;
+  apps.push_back(std::move(app));
+  auto request = MakeProtocolRequest(
+      false, "{15160585-8ADE-4D3C-839B-1281A6035D1F}", "prod_id", "1.0",
+      "channel", "OS", "", std::nullopt, {}, {}, std::move(apps));
+  EXPECT_EQ(0u, request.hw.physmemory);
+  request.hw.physmemory = 16;
+  request.hw.avx = true;
+  auto root = base::JSONReader::Read(
+      ProtocolSerializerJSON().Serialize(request), base::JSON_PARSE_RFC);
+  ASSERT_TRUE(root);
+  ASSERT_TRUE(root->is_dict());
+  const auto* wire_request = root->GetDict().FindDict("request");
+  ASSERT_TRUE(wire_request);
+  const auto* hw = wire_request->FindDict("hw");
+  ASSERT_TRUE(hw);
+  EXPECT_TRUE(hw->empty());
+  for (const char* key : {"@updater", "prodversion", "@os", "arch"}) {
+    ASSERT_TRUE(wire_request->FindString(key)) << key;
+    EXPECT_FALSE(wire_request->FindString(key)->empty()) << key;
+  }
+  EXPECT_EQ("prod_id", *wire_request->FindString("@updater"));
+  EXPECT_EQ("1.0", *wire_request->FindString("prodversion"));
+  const auto* os = wire_request->FindDict("os");
+  ASSERT_TRUE(os);
+  for (const char* key : {"platform", "arch", "version"}) {
+    ASSERT_TRUE(os->FindString(key)) << key;
+    EXPECT_FALSE(os->FindString(key)->empty()) << key;
+  }
+  EXPECT_EQ("OS", *os->FindString("platform"));
+  const auto* wire_apps = wire_request->FindList("apps");
+  ASSERT_TRUE(wire_apps);
+  ASSERT_EQ(1u, wire_apps->size());
+  ASSERT_TRUE(wire_apps->front().is_dict());
+  const auto& wire_app = wire_apps->front().GetDict();
+  for (const char* key : {"lang", "iid", "installdate", "ping", "events"}) {
+    EXPECT_FALSE(wire_app.contains(key)) << key;
+  }
+  for (const char* key :
+       {"appid", "version", "attr", "installsource", "installedby"}) {
+    ASSERT_TRUE(wire_app.FindString(key)) << key;
+    EXPECT_FALSE(wire_app.FindString(key)->empty()) << key;
+  }
+  EXPECT_EQ("id1", *wire_app.FindString("appid"));
+  EXPECT_EQ("1.0", *wire_app.FindString("version"));
+  EXPECT_EQ("value", *wire_app.FindString("attr"));
+  EXPECT_EQ("ondemand", *wire_app.FindString("installsource"));
+  EXPECT_EQ("internal", *wire_app.FindString("installedby"));
+  const auto* update_check = wire_app.FindDict("updatecheck");
+  ASSERT_TRUE(update_check);
+  ASSERT_TRUE(update_check->FindString("targetversionprefix"));
+  EXPECT_EQ("2", *update_check->FindString("targetversionprefix"));
+  const auto* install_data = wire_app.FindList("data");
+  ASSERT_TRUE(install_data);
+  ASSERT_EQ(1u, install_data->size());
+  ASSERT_TRUE(install_data->front().is_dict());
+  const auto& install_data_item = install_data->front().GetDict();
+  ASSERT_TRUE(install_data_item.FindString("index"));
+  EXPECT_EQ("needed-data", *install_data_item.FindString("index"));
+}
+#endif  // BUILDFLAG(IS_ANDROID)
 
