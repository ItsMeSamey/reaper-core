+  async function checkAndroidLoadUnpackedCompletionPreservesFocus() {
+    toolbar.inDevMode = true;
+    toolbar.canLoadUnpacked = true;
+    await microtasksFinished();
+    const button = toolbar.$.loadUnpacked as CrButtonElement;
+    for (const scenario of [
+           'blur-cancel', 'blur-success', 'blur-error',
+           'search-cancel', 'search-success', 'search-error',
+           'hidden-cancel', 'denied-cancel',
+         ]) {
+      toolbar.inDevMode = true;
+      toolbar.canLoadUnpacked = true;
+      await microtasksFinished();
+      let resolve!: (success: boolean) => void;
+      let reject!: (error: Error) => void;
+      mockDelegate.loadUnpacked = () => new Promise<boolean>((yes, no) => {
+        resolve = yes;
+        reject = no;
+      });
+      button.focus();
+      assertEquals(button, toolbar.shadowRoot.activeElement);
+      button.click();
+      await microtasksFinished();
+      assertTrue(button.disabled);
+      if (scenario.startsWith('search-')) {
+        toolbar.focusSearchInput();
+      } else if (scenario === 'hidden-cancel') {
+        toolbar.inDevMode = false;
+      } else if (scenario === 'denied-cancel') {
+        toolbar.canLoadUnpacked = false;
+      }
+      await microtasksFinished();
+      const chosenFocus = getDeepActiveElement();
+      if (scenario.startsWith('search-')) {
+        assertTrue(toolbar.isSearchFocused());
+      } else {
+        assertEquals(document.body, chosenFocus);
+      }
+      if (scenario.endsWith('-error')) {
+        reject(new Error('Unreadable unpacked extension'));
+      } else {
+        resolve(scenario.endsWith('-success'));
+      }
+      await microtasksFinished();
+      assertFalse(button.disabled);
+      if (scenario.startsWith('blur-')) {
+        assertEquals(button, toolbar.shadowRoot.activeElement);
+        const nativeButton = getDeepActiveElement();
+        assertTrue(nativeButton instanceof HTMLButtonElement);
+        assertFalse(nativeButton.disabled);
+      } else {
+        assertEquals(chosenFocus, getDeepActiveElement());
+      }
+    }
+  }
