+  async function checkAndroidDetachedUnpackedCompletion() {
+    const input = document.createElement('input');
+    document.body.appendChild(input);
+    for (const outcome of ['success', 'error']) {
+      getToastManager().hide();
+      const detachedToolbar = document.createElement('extensions-toolbar');
+      detachedToolbar.inDevMode = true;
+      detachedToolbar.canLoadUnpacked = true;
+      detachedToolbar.delegate = mockDelegate;
+      document.body.appendChild(detachedToolbar);
+      await microtasksFinished();
+      let resolve!: (success: boolean) => void;
+      let reject!: (error: Error) => void;
+      mockDelegate.loadUnpacked = () => new Promise<boolean>((yes, no) => {
+        resolve = yes;
+        reject = no;
+      });
+      const errors: unknown[] = [];
+      detachedToolbar.addEventListener('load-error', event => {
+        errors.push((event as CustomEvent).detail);
+      });
+      const button = detachedToolbar.$.loadUnpacked as CrButtonElement;
+      button.click();
+      await microtasksFinished();
+      assertTrue(button.disabled);
+      detachedToolbar.remove();
+      assertFalse(detachedToolbar.isConnected);
+      input.focus();
+      assertEquals(input, getDeepActiveElement());
+      if (outcome === 'error') {
+        reject(new Error('Unreadable detached unpacked extension'));
+      } else {
+        resolve(true);
+      }
+      await microtasksFinished();
+      assertFalse(getToastManager().isToastOpen);
+      assertEquals(0, errors.length);
+      assertEquals(input, getDeepActiveElement());
+      // Detached Lit controls need not render their final enabled state.
+    }
+    input.remove();
+  }
