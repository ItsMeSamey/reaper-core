+  async function checkAndroidUnpackedErrorDialogReturnsFocus() {
+    toolbar.inDevMode = true;
+    toolbar.canLoadUnpacked = true;
+    await microtasksFinished();
+    let reject!: (error: Error) => void;
+    mockDelegate.loadUnpacked = () => new Promise<boolean>((_yes, no) => {
+      reject = no;
+    });
+    const dialog = document.createElement('extensions-load-error');
+    dialog.delegate = mockDelegate;
+    let opened!: () => void;
+    const shown = new Promise<void>(resolve => { opened = resolve; });
+    // Match the manager's deferred dialog presentation after load-error.
+    toolbar.addEventListener('load-error', event => {
+      setTimeout(async () => {
+        dialog.loadError = (event as CustomEvent<Error>).detail;
+        document.body.appendChild(dialog);
+        await dialog.updateComplete;
+        dialog.show();
+        opened();
+      }, 0);
+    }, {once: true});
+    const button = toolbar.$.loadUnpacked;
+    button.focus();
+    button.click();
+    await microtasksFinished();
+    reject(new Error('Unreadable unpacked extension'));
+    await shown;
+    await microtasksFinished();
+    assertTrue(dialog.$.dialog.getNative().open);
+    assertFalse(button.matches(':focus-within'));
+    dialog.close();
+    await microtasksFinished();
+    assertEquals(button, toolbar.shadowRoot.activeElement);
+    dialog.remove();
+  }
