+#if BUILDFLAG(IS_ANDROID)
+TEST_F(NtpCustomBackgroundServiceTest,
+       WallpaperFlagPreservesOrdinaryPrefsAndLocalImageCopy) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(ntp_features::kCustomizeChromeWallpaperSearch);
+  sync_preferences::TestingPrefServiceSyncable prefs_service;
+  NtpCustomBackgroundService::RegisterProfilePrefs(prefs_service.registry());
+  EXPECT_NE(nullptr, prefs_service.FindPreference(prefs::kNtpCustomBackgroundDict));
+  EXPECT_FALSE(prefs_service.GetBoolean(prefs::kNtpCustomBackgroundLocalToDevice));
+  EXPECT_TRUE(prefs_service.GetString(prefs::kNtpCustomBackgroundLocalToDeviceId)
+                  .empty());
+  EXPECT_FALSE(prefs_service.GetBoolean(prefs::kNtpCustomBackgroundInspiration));
+  EXPECT_EQ(nullptr, prefs_service.FindPreference(prefs::kNtpWallpaperSearchHistory));
+
+  EXPECT_CALL(observer_, OnCustomBackgroundImageUpdated).Times(1);
+  const base::FilePath path = profile().GetPath().AppendASCII("ordinary_local_image");
+  const base::FilePath copy_path = profile().GetPath().AppendASCII(
+      chrome::kChromeUIUntrustedNewTabPageBackgroundFilename);
+  ASSERT_TRUE(base::WriteFile(path, "ordinary_background_bytes"));
+  custom_background_service_->SelectLocalBackgroundImage(path);
+  task_environment_.RunUntilIdle();
+
+  std::string copied;
+  ASSERT_TRUE(base::ReadFileToString(copy_path, &copied));
+  EXPECT_EQ("ordinary_background_bytes", copied);
+  EXPECT_TRUE(profile().GetPrefs()->GetBoolean(
+      prefs::kNtpCustomBackgroundLocalToDevice));
+  EXPECT_TRUE(profile().GetPrefs()->GetString(
+      prefs::kNtpCustomBackgroundLocalToDeviceId).empty());
+  auto background = custom_background_service_->GetCustomBackground();
+  ASSERT_TRUE(background);
+  EXPECT_TRUE(background->is_uploaded_image);
+  EXPECT_TRUE(custom_background_service_->IsCustomBackgroundSet());
+}
+
+TEST_F(NtpCustomBackgroundServiceTest,
+       WallpaperFlagPreservesSyncedBackgroundReplacingLocalImage) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(ntp_features::kCustomizeChromeWallpaperSearch);
+  EXPECT_CALL(observer_, OnCustomBackgroundImageUpdated).Times(2);
+  const base::FilePath path = profile().GetPath().AppendASCII(
+      chrome::kChromeUIUntrustedNewTabPageBackgroundFilename);
+  ASSERT_TRUE(base::WriteFile(path, "ordinary_local_background"));
+  custom_background_service_->SelectLocalBackgroundImage(path);
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(profile().GetPrefs()->GetBoolean(
+      prefs::kNtpCustomBackgroundLocalToDevice));
+  ASSERT_TRUE(base::PathExists(path));
+
+  const GURL synced_url("https://example.test/synced-background");
+  profile().GetTestingPrefService()->SetUserPref(
+      prefs::kNtpCustomBackgroundDict,
+      GetBackgroundInfoAsDict(synced_url, GURL()));
+  task_environment_.RunUntilIdle();
+  auto background = custom_background_service_->GetCustomBackground();
+  ASSERT_TRUE(background);
+  EXPECT_EQ(synced_url, background->custom_background_url);
+  EXPECT_FALSE(background->is_uploaded_image);
+  EXPECT_FALSE(profile().GetPrefs()->GetBoolean(
+      prefs::kNtpCustomBackgroundLocalToDevice));
+  EXPECT_FALSE(base::PathExists(path));
+}
+#endif
