+bool AndroidLiveTabContextRestoreWrapper::RestoreTabGroups(TabModel* model) {
+  const auto is_live = [model] {
+    const auto& models = TabModelList::models();
+    return std::ranges::find(models, model) != models.end();
+  };
+  JNIEnv* env = base::android::AttachCurrentThread();
+  for (const auto& [id, group] : tab_groups_) {
+    if (!is_live()) {
+      return false;
+    }
+    recent_tabs::Java_RecentlyClosedBridge_restoreTabGroup(
+        env, model, group.visual_data.title(),
+        static_cast<int>(group.visual_data.color()), group.tab_ids);
+  }
+  return is_live();
+}
