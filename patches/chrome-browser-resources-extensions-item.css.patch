diff --git a/chrome/browser/resources/extensions/item.css b/chrome/browser/resources/extensions/item.css
--- a/chrome/browser/resources/extensions/item.css
+++ b/chrome/browser/resources/extensions/item.css
@@ -255,3 +255,59 @@
   height: 0;
   overflow: hidden;
 }
+
+<if expr="is_android">
+#card,
+#card.review-prompting-enabled,
+#card.dev-mode,
+#card.dev-mode.review-prompting-enabled {
+  height: auto;
+}
+
+#card {
+  min-height: var(--extensions-card-height);
+}
+
+#card.review-prompting-enabled {
+  min-height: 180px;
+}
+
+#card.dev-mode {
+  min-height: 208px;
+}
+
+#card.dev-mode.review-prompting-enabled {
+  min-height: 228px;
+}
+
+#button-strip,
+#button-strip > .flex {
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+#button-strip {
+  height: auto;
+  min-height: var(--cr-section-min-height);
+  padding-inline: 12px;
+}
+
+#button-strip > .flex {
+  min-width: 0;
+}
+
+#button-strip cr-button {
+  height: auto;
+  line-height: 1.4;
+  margin-inline-start: 0;
+  max-width: 100%;
+  min-height: var(--cr-button-height);
+  min-width: min(5.14em, 100%);
+  overflow-wrap: anywhere;
+  white-space: normal;
+}
+
+#button-strip cr-icon-button {
+  --cr-icon-button-size: 48px;
+}
+</if>
