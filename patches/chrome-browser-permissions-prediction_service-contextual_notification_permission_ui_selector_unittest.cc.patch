+#if BUILDFLAG(IS_ANDROID)
+TEST_F(ContextualNotificationPermissionUiSelectorTest,
+       CancelPendingPreloadLookupAndReuse) {
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitAndEnableFeature(features::kQuietNotificationPrompts);
+  LoadTestPreloadData();
+  CrowdDenyPreloadData::GetInstance()->set_is_ready_to_use_for_testing(false);
+
+  permissions::MockPermissionRequest request(
+      GURL(kTestOriginNoData), permissions::RequestType::kNotifications);
+  base::MockCallback<
+      ContextualNotificationPermissionUiSelector::DecisionMadeCallback>
+      cancelled_callback;
+  EXPECT_CALL(cancelled_callback, Run).Times(0);
+  selector().SelectUiToUse(web_contents(), &request, cancelled_callback.Get());
+  selector().Cancel();
+
+  // Finishing the component load must not complete the cancelled selection.
+  LoadTestPreloadData();
+  RunUntilIdle();
+
+  // Invalidation must allow a subsequent selection to use fresh weak pointers.
+  QueryAndExpectDecisionForUrl(GURL(kTestOriginNoData),
+                               Decision::UseNormalUiAndShowNoWarning());
+}
+
+TEST_F(ContextualNotificationPermissionUiSelectorTest,
+       CancelPendingSafeBrowsingReleasesCompletionAndReuse) {
+  using Config = QuietNotificationPermissionUiConfig;
+  base::test::ScopedFeatureList feature_list;
+  feature_list.InitWithFeaturesAndParameters(
+      {{features::kQuietNotificationPrompts,
+        {{Config::kEnableCrowdDenyTriggering, "true"},
+         {Config::kCrowdDenyHoldBackChance, "0.0"}}}},
+      {});
+  LoadTestPreloadData();
+  LoadTestSafeBrowsingBlocklist();
+
+  permissions::MockPermissionRequest request(
+      GURL(kTestOriginSpammy), permissions::RequestType::kNotifications);
+  auto completion_state = std::make_shared<int>(0);
+  std::weak_ptr<int> completion_lifetime = completion_state;
+  selector().SelectUiToUse(
+      web_contents(), &request,
+      base::BindOnce(
+          [](std::shared_ptr<int>, const Decision&) {
+            ADD_FAILURE() << "Cancelled selection completed";
+          },
+          std::move(completion_state)));
+  ASSERT_FALSE(completion_lifetime.expired());
+
+  selector().Cancel();
+  EXPECT_TRUE(completion_lifetime.expired());
+  selector().Cancel();
+  RunUntilIdle();
+
+  QueryAndExpectDecisionForUrl(GURL(kTestOriginNoData),
+                               Decision::UseNormalUiAndShowNoWarning());
+}
+#endif  // BUILDFLAG(IS_ANDROID)
