 #include "url/gurl.h"

 namespace extensions {
+
+#if BUILDFLAG(IS_ANDROID)
+namespace {
+
+// This cannot be mistaken for an old key, which starts with an extension ID.
+constexpr char kProfileScopedNotificationPrefix[] = "reaper-extension:v1:";
+
+}  // namespace
+
+std::string CreateProfileScopedNotificationId(Profile* profile,
+                                            const std::string& extension_id,
+                                            const std::string& id) {
+  CHECK(profile);
+  std::string scope =
+      base::HexEncode(NotificationPlatformBridge::GetProfileId(profile));
+  if (profile->IsOffTheRecord()) {
+    scope += ":otr:" + base::HexEncode(profile->GetOTRProfileID().Serialize());
+  } else {
+    scope += ":regular";
+  }
+  return std::string(kProfileScopedNotificationPrefix) + scope + ":" +
+         extension_id + "-" + id;
+}
+
+std::optional<std::string> GetUnscopedNotificationId(
+    Profile* profile,
+    const std::string& extension_id,
+    const std::string& scoped_id) {
+  if (scoped_id.starts_with(kProfileScopedNotificationPrefix)) {
+    const std::string expected_prefix =
+        CreateProfileScopedNotificationId(profile, extension_id, "");
+    if (!scoped_id.starts_with(expected_prefix) ||
+        scoped_id.size() == expected_prefix.size()) {
+      return std::nullopt;
+    }
+    return scoped_id.substr(expected_prefix.size());
+  }
+
+  // A persisted legacy key has no profile witness. Preserve its original
+  // event ID without treating it as proof of profile ownership.
+  const std::string legacy_prefix = extension_id + "-";
+  if (!scoped_id.starts_with(legacy_prefix)) {
+    return std::nullopt;
+  }
+  return scoped_id.substr(legacy_prefix.size());
+}
+#endif  // BUILDFLAG(IS_ANDROID)

