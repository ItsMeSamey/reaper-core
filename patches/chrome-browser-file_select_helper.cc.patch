+// Model selection is distinct from Activity visibility and from the current
+// tab retained by each regular/incognito model. Retire the original request
+// when its model loses selection, even if that model is selected again later.
+class FileSelectHelper::AndroidPickerModelObserver : public TabModelObserver {
+ public:
+  AndroidPickerModelObserver(FileSelectHelper* helper, TabModel* model)
+      : helper_(helper), model_(model) {
+    model_->AddObserver(this);
+  }
+  ~AndroidPickerModelObserver() override {
+    if (model_) {
+      model_->RemoveObserver(this);
+    }
+  }
+  void OnWillActiveStateChange(TabModel& model, bool active) override {
+    if (!active) {
+      helper_->RunFileChooserEnd();
+    }
+  }
+  void OnTabModelDestroyed(TabModel& model) override {
+    // Shutdown can be dispatched by the model's last JNI observer bridge.
+    // Forget the dying model before the owner deletes this observer.
+    model_ = nullptr;
+    helper_->RunFileChooserEnd();
+  }
+
+ private:
+  raw_ptr<FileSelectHelper> helper_;
+  raw_ptr<TabModel> model_;
+};
