+
+bool FileSelectHelper::IsAndroidPickerOwnerValid() const {
+  auto* document = requesting_document_.AsRenderFrameHostIfValid();
+  if (!document || !document->IsActive() || document != render_frame_host_ ||
+      !web_contents_ ||
+      WebContents::FromRenderFrameHost(document) != web_contents_ ||
+      !IsValidProfile(profile_) ||
+      Profile::FromBrowserContext(web_contents_->GetBrowserContext()) !=
+          profile_) {
+    return false;
+  }
+  auto* tab = requesting_tab_.get();
+  if (!tab) {
+    return false;
+  }
+  if (android_extension_picker_request_) {
+    auto* browser = requesting_extension_browser_.get();
+    auto* tab_list = browser ? TabListInterface::From(browser) : nullptr;
+    if (!browser || !tab_list ||
+        GetAndroidExtensionPickerBrowser(web_contents_, profile_) != browser ||
+        tab_list->GetActiveTab() != tab ||
+        browser->GetProfile() != tab->GetProfile() ||
+        !web_contents_->GetTopLevelNativeWindow()) {
+      return false;
+    }
+  } else if (TabAndroid::FromWebContents(web_contents_) != tab ||
+             tab->GetContents() != web_contents_ ||
+             tab->GetProfile() != profile_) {
+    return false;
+  }
+  auto* model =
+      TabModelList::GetTabModelForTabAndroid(TabAndroid::FromTabInterface(tab));
+  return model && model->GetProfile() == tab->GetProfile() &&
+         model->IsActiveModel() && model->GetActiveTab() == tab;
+}
