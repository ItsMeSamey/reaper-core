 public class DevToolsActivity extends BaseCustomTabActivity {
     private static final String WEB_CONTENTS_KEY =
             "org.chromium.chrome.browser.devtools.DevTools.WebContents";
+
+    private @Nullable WebContents mFrontendContents;
+    private @Nullable Profile mFrontendProfile;
+
+    @Override
+    protected boolean isStartedUpCorrectly(Intent intent) {
+        // A native-owned frontend can only survive within this browser process.
+        // Do not recreate an incognito profile for an obsolete activity intent.
+        if (!super.isStartedUpCorrectly(intent) || !LibraryLoader.getInstance().isInitialized()) {
+            return false;
+        }
+        intent.setExtrasClassLoader(WebContents.class.getClassLoader());
+        WebContents contents = IntentUtils.safeGetParcelableExtra(intent, WEB_CONTENTS_KEY);
+        if (contents == null || contents.isDestroyed()) return false;
+        Profile profile = Profile.fromWebContents(contents);
+        if (profile == null || profile.shutdownStarted()) return false;
+        mFrontendContents = contents;
+        mFrontendProfile = profile;
+        return true;
+    }
+
+    @Override
+    protected OneshotSupplier<ProfileProvider> createProfileProvider() {
+        Profile frontendProfile = assumeNonNull(mFrontendProfile);
+        getLifecycleDispatcher().register((DestroyObserver) this::releaseUnattachedFrontend);
+        OneshotSupplierImpl<ProfileProvider> supplier = new OneshotSupplierImpl<>();
+        supplier.set(
+                new ProfileProvider() {
+                    @Override
+                    public Profile getOriginalProfile() {
+                        return frontendProfile.getOriginalProfile();
+                    }
+
+                    @Override
+                    public @Nullable Profile getOffTheRecordProfile(boolean createIfNeeded) {
+                        // The frontend already owns the exact primary or DevTools OTR profile.
+                        // Creating a CCT-specific profile would change extension isolation.
+                        if (!frontendProfile.isOffTheRecord()) {
+                            assert !createIfNeeded;
+                            return null;
+                        }
+                        return frontendProfile.shutdownStarted() ? null : frontendProfile;
+                    }
+                });
+        return supplier;
+    }
 
