+    /** Returns recent selections with current app-owned labels, without rewriting history. */
+    public ArrayList<SettingsIndexData.Entry> getEntriesForDisplay(SettingsIndexData index) {
+        return resolveEntriesForDisplay(values(), index);
+    }
+
+    /** Refreshes labels from the available index; IDs, order and selection arguments stay intact. */
+    static ArrayList<SettingsIndexData.Entry> resolveEntriesForDisplay(
+            Iterable<SettingsIndexData.Entry> entries, SettingsIndexData index) {
+        ArrayList<SettingsIndexData.Entry> result = new ArrayList<>();
+        for (SettingsIndexData.Entry entry : entries) {
+            SettingsIndexData.Entry current = index.getEntry(entry.id);
+            if (current == null || !current.isSearchable) continue;
+            result.add(
+                    new SettingsIndexData.Entry.Builder(entry)
+                            .setTitle(current.title)
+                            .setSummary(current.summary)
+                            .setHeader(current.header)
+                            .build());
+        }
+        return result;
+    }
