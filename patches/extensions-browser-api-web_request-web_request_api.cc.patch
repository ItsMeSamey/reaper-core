 void WebRequestAPI::ResetURLLoaderFactories() {
+#if BUILDFLAG(IS_ANDROID)
+  // This service is shared with OTR profiles. Each existing related context
+  // owns its own partitions and factories, including container/webview jars.
+  // Invalidation grants no extension permission and must not create OTR
+  // profiles.
+  for (content::BrowserContext* context :
+       ExtensionsBrowserClient::Get()->GetRelatedContextsForFactoryReset(
+           browser_context_)) {
+    context->ForEachLoadedStoragePartition(
+        [](content::StoragePartition* partition) {
+          partition->ResetURLLoaderFactories();
+        });
+  }
+#else
   browser_context_->GetDefaultStoragePartition()->ResetURLLoaderFactories();
+#endif
   if (g_test_observer) {
     g_test_observer->OnDidResetURLLoaderFactories();
   }
