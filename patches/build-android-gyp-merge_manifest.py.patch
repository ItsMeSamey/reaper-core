+# PositionXmlParser's bounded parser pool emits this JUL INFO record while
+# parsing large manifest closures. Accept only a stream consisting entirely of
+# these exact records; any warning, error, traceback or unfamiliar output still
+# reaches CheckOutput unchanged and remains subject to --warnings-as-errors.
+_POOL_INFO_RE = re.compile(
+    r'(?:(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) '
+    r'(?:[1-9]|[12][0-9]|3[01]), [0-9]{4} '
+    r'(?:[1-9]|1[0-2]):[0-5][0-9]:[0-5][0-9] (?:AM|PM) '
+    r'com\.android\.utils\.PositionXmlParser\$SaxParserPool '
+    r'checkLimitWhenCreate\r?\n'
+    r'INFO: Maximum pool size reached in com\.android\.utils\.PositionXmlParser\r?\n)+'
+)
+
+
+def _FilterParserPoolInfo(stderr):
+    if _POOL_INFO_RE.fullmatch(stderr):
+        # Keep the original diagnostics visible, including on a nonzero exit
+        # or missing/stale output. Only their failure classification changes.
+        sys.stderr.write(stderr)
+        return ''
+    return stderr
 
 
