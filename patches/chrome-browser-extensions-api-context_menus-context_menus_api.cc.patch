-ExtensionFunction::ResponseAction ContextMenusCreateFunction::Run() {
+ExtensionFunction::ResponseAction ContextMenusFunction::Run() {
+#if BUILDFLAG(IS_ANDROID)
+  waiting_for_restore_ = true;
+  pending_restore_request_ =
+      MenuManager::Get(browser_context())
+          ->RunAfterInitialRestore(
+              *extension(),
+              base::BindOnce(&ContextMenusFunction::OnInitialRestoreReady,
+                             this));
+  return did_respond() ? AlreadyResponded() : RespondLater();
+#else
+  return RunOnReady();
+#endif
+}
+
+#if BUILDFLAG(IS_ANDROID)
+void ContextMenusFunction::OnInitialRestoreReady(bool ready) {
+  if (did_respond()) {
+    return;
+  }
+  waiting_for_restore_ = false;
+  pending_restore_request_.RunAndReset();
+  if (!ready || !browser_context() ||
+      Profile::FromBrowserContext(browser_context())->ShutdownStarted() ||
+      ExtensionRegistry::Get(browser_context())
+              ->enabled_extensions()
+              .GetByID(extension_id()) != extension()) {
+    Respond(Error(
+        "Context menu operation cancelled before restoration completed."));
+    return;
+  }
+  RunOnReady().Execute();
+}
+
+void ContextMenusFunction::OnBrowserContextShutdown() {
+  if (!waiting_for_restore_ || did_respond()) {
+    return;
+  }
+  waiting_for_restore_ = false;
+  // ExtensionFunction::Shutdown protects a live last reference while this
+  // cancellation drops the manager's callback. Do not resurrect a zero-ref
+  // function already awaiting DeleteSoon.
+  pending_restore_request_.RunAndReset();
+  Respond(
+      Error("Context menu operation cancelled before restoration completed."));
+}
+#endif
