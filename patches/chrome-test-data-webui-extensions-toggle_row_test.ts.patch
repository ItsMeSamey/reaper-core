+  test('AndroidWarningRowAllowsPanningAndRetainsToggleSemantics', async () => {
+    await row.updateComplete;
+    const toggle = row.$.crToggle;
+    await toggle.updateComplete;
+    await microtasksFinished();
+    // Brave's cr-toggle delegates activation to Nala's native switch button.
+    // Clicking the outer host only stops propagation; it does not toggle.
+    const getToggleButton = (): HTMLButtonElement => {
+      const button = toggle.$.toggle.shadowRoot?.querySelector('button');
+      assertTrue(button instanceof HTMLButtonElement);
+      assertEquals('switch', button.getAttribute('role'));
+      return button;
+    };
+    assertFalse(getToggleButton().disabled);
+    const warning = row.querySelector<HTMLElement>('#label')!;
+
+    // The browser intersects touch-action along the hit target's ancestors.
+    // Warning/label gestures can pan vertically; the switch keeps its own drag.
+    assertEquals('pan-y', getComputedStyle(row).touchAction);
+    assertEquals('auto', getComputedStyle(warning).touchAction);
+    assertEquals('auto', getComputedStyle(row.getLabel()).touchAction);
+    assertEquals('none', getComputedStyle(toggle).touchAction);
+    assertFalse(row.checked);
+
+    let changes = 0;
+    row.addEventListener('change', () => ++changes);
+    row.disabled = true;
+    await row.updateComplete;
+    await toggle.updateComplete;
+    await microtasksFinished();
+    assertTrue(getToggleButton().disabled);
+    row.getLabel().click();
+    getToggleButton().click();
+    await row.updateComplete;
+    assertEquals(0, changes);
+    assertFalse(row.checked);
+    assertEquals('pan-y', getComputedStyle(row).touchAction);
+
+    row.disabled = false;
+    await row.updateComplete;
+    await toggle.updateComplete;
+    await microtasksFinished();
+    assertFalse(getToggleButton().disabled);
+    let changed = eventToPromise('change', row);
+    row.getLabel().click();
+    await changed;
+    assertTrue(row.checked);
+    assertEquals(1, changes);
+
+    await microtasksFinished();
+    assertEquals('true', getToggleButton().getAttribute('aria-checked'));
+    changed = eventToPromise('change', row);
+    getToggleButton().click();
+    await changed;
+    assertFalse(row.checked);
+    assertEquals(2, changes);
+  });
