+  test('AndroidSwitchReferencesLiveRowLabel', async () => {
+    await row.updateComplete;
+    const toggle = row.$.crToggle;
+    await toggle.updateComplete;
+    await microtasksFinished();
+    const button = toggle.$.toggle.shadowRoot?.querySelector('button');
+    assertTrue(button instanceof HTMLButtonElement);
+    assertEquals('switch', button.getAttribute('role'));
+    assertEquals(1, button.ariaLabelledByElements?.length);
+    assertEquals(row.getLabel(), button.ariaLabelledByElements?.[0]);
+
+    const warning = row.querySelector<HTMLElement>('#label')!;
+    warning.textContent = 'Updated extension permission';
+    await microtasksFinished();
+    // This verifies the live relation, not a computed accessibility-tree name.
+    const labelSlot = row.getLabel().querySelector('slot')!;
+    assertEquals(warning, labelSlot.assignedElements()[0]);
+    assertEquals('Updated extension permission', warning.textContent);
+    assertEquals(row.getLabel(), button.ariaLabelledByElements?.[0]);
+    assertFalse(button.hasAttribute('aria-label'));
+  });
+
+  test('AndroidSwitchLabelSurvivesRowReconnect', async () => {
+    await row.updateComplete;
+    const toggle = row.$.crToggle;
+    await toggle.updateComplete;
+    await microtasksFinished();
+    const previousButton = toggle.$.toggle.shadowRoot?.querySelector('button');
+    assertTrue(previousButton instanceof HTMLButtonElement);
+    row.remove();
+    document.body.appendChild(row);
+    await row.updateComplete;
+    await toggle.updateComplete;
+    await microtasksFinished();
+    const button = toggle.$.toggle.shadowRoot?.querySelector('button');
+    assertTrue(button instanceof HTMLButtonElement);
+    assertFalse(button === previousButton);
+    assertEquals(1, button.ariaLabelledByElements?.length);
+    assertEquals(row.getLabel(), button.ariaLabelledByElements?.[0]);
+  });
