+    private void touchActionWithCallbackBeforeRelease(
+            String contentDescription, Runnable beforeRelease) {
+        ThreadUtils.runOnUiThreadBlocking(
+                () -> {
+                    ViewGroup container =
+                            mActivityTestRule.getActivity().findViewById(R.id.extension_action_list);
+                    assertNotNull(container);
+                    View target = findViewWithContentDescription(container, contentDescription);
+                    assertNotNull(target);
+                    assertSame(container, target.getParent());
+                    float x = target.getX() + target.getWidth() / 2f;
+                    float y = target.getY() + target.getHeight() / 2f;
+                    long downTime = SystemClock.uptimeMillis();
+                    MotionEvent down =
+                            MotionEvent.obtain(downTime, downTime, MotionEvent.ACTION_DOWN, x, y, 0);
+                    MotionEvent up =
+                            MotionEvent.obtain(downTime, downTime + 1, MotionEvent.ACTION_UP, x, y, 0);
+                    down.setSource(InputDevice.SOURCE_TOUCHSCREEN);
+                    up.setSource(InputDevice.SOURCE_TOUCHSCREEN);
+                    try {
+                        assertTrue(container.dispatchTouchEvent(down));
+                        assertTrue(target.isPressed());
+                        // Removal updates the adapter synchronously, before the next layout.
+                        beforeRelease.run();
+                        assertSame(container, target.getParent());
+                        assertTrue(target.isAttachedToWindow());
+                        assertTrue(target.hasOnClickListeners());
+                        // Dispatch through RecyclerView and the installed ExtensionActionDragHelper.
+                        assertTrue(container.dispatchTouchEvent(up));
+                    } finally {
+                        down.recycle();
+                        up.recycle();
+                    }
+                });
+    }
