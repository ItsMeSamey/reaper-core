+base::android::ScopedJavaLocalRef<jobject>
+ExtensionDevToolsClientHost::FindWarningWindow() {
+  Profile* target_profile = warning_profile_.get();
+  if (!target_profile || target_profile->ShutdownStarted()) {
+    return {};
+  }
+  if (WebContents* contents = agent_host_->GetWebContents();
+      contents && Profile::FromBrowserContext(contents->GetBrowserContext()) ==
+                      target_profile) {
+    if (auto* window = contents->GetTopLevelNativeWindow()) {
+      auto java_window = window->GetJavaObject();
+      if (!messages::MessageDispatcherBridge::Get()
+               ->GetMessageDispatcher(java_window)
+               .is_null()) {
+        return java_window;
+      }
+    }
+  }
+  auto* browsers = ProfileBrowserCollection::GetForProfile(target_profile);
+  if (!browsers) {
+    return {};
+  }
+  base::android::ScopedJavaLocalRef<jobject> result;
+  browsers->ForEach(
+      [target_profile, &result](BrowserWindowInterface* browser) {
+        if (browser->GetProfile() != target_profile ||
+            browser->IsDeleteScheduled()) {
+          return true;
+        }
+        auto* base_window = browser->GetWindow();
+        if (!base_window) {
+          return true;
+        }
+        auto* window = base_window->GetNativeWindow();
+        if (!window) {
+          // A pending BWI does not yet guarantee an Android OS window.
+          return true;
+        }
+        auto java_window = window->GetJavaObject();
+        if (java_window.is_null() || messages::MessageDispatcherBridge::Get()
+                                         ->GetMessageDispatcher(java_window)
+                                         .is_null()) {
+          return true;
+        }
+        result = std::move(java_window);
+        return false;
+      },
+      BrowserCollection::Order::kActivation);
+  return result;
+}
