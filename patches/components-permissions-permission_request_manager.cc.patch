+
+void PermissionRequestManager::OnAndroidTabModelActiveChanged(bool active) {
+  const bool previously_active = tab_is_active_;
+  android_tab_model_active_ = active;
+  tab_is_active_ =
+      active && (tab_subscriptions_.empty() || android_native_tab_active_) &&
+      web_contents()->GetVisibility() != content::Visibility::HIDDEN;
+  // Model deselection is not an OS permission Activity hiding Chrome. Keep the
+  // underlying request pending, but prevent an outstanding OS callback from
+  // resolving a prompt for a model the user has left.
+  if (!active && view_ &&
+      view_->GetTabSwitchingBehavior() ==
+          PermissionPrompt::TabSwitchingBehavior::kKeepPromptAlive) {
+    auto weak_this = weak_factory_.GetWeakPtr();
+    DeletePrompt();
+    if (!weak_this) {
+      return;
+    }
+  }
+  if (previously_active != tab_is_active_) {
+    OnTabActiveChanged();
+  }
+}
