+#if BUILDFLAG(IS_ANDROID)
+void PermissionRequestManager::RefreshAndroidTabModelObserver(
+    tabs::TabInterface* tab_interface) {
+  android_tab_model_observation_.RunAndReset();
+  android_tab_model_observation_ =
+      PermissionsClient::Get()->ObserveAndroidTabModel(
+          tab_interface,
+          base::BindRepeating(
+              &PermissionRequestManager::OnAndroidTabModelActiveChanged,
+              weak_factory_.GetWeakPtr()));
+  OnAndroidTabModelActiveChanged(
+      PermissionsClient::Get()->IsAndroidTabModelActive(tab_interface));
