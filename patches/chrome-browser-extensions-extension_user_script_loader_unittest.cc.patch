+TEST_F(ExtensionUserScriptLoaderTest,
+       AndroidFailedUnregisterRestoresRegistrationForRetry) {
+  TestingProfile profile;
+  auto extension =
+      ExtensionBuilder("Test").SetPath(temp_dir_.GetPath()).Build();
+  ControlledExtensionScriptLoader loader(&profile, *extension);
+  const std::string id = "_dc_retry";
+  int registered = 0;
+  loader.Register(id, "/* published */",
+                  base::BindLambdaForTesting(
+                      [&](const std::optional<std::string>& error) {
+                        EXPECT_FALSE(error);
+                        ++registered;
+                      }));
+  loader.CompleteLoad(true);
+  ASSERT_EQ(1, registered);
+  ASSERT_TRUE(loader.IsDynamicScriptRegistrationCurrent(id));
+  ASSERT_TRUE(loader.GetPersistentDynamicScriptIDs().contains(id));
+
+  int errors = 0;
+  loader.RemoveDynamicScripts(
+      {id}, base::BindLambdaForTesting(
+                [&](const std::optional<std::string>& error) {
+                  EXPECT_TRUE(error);
+                  ++errors;
+                }));
+  EXPECT_TRUE(loader.GetPersistentDynamicScriptIDs().contains(id));
+  loader.CompleteLoad(false);
+  ASSERT_EQ(1, errors);
+  EXPECT_TRUE(loader.IsDynamicScriptRegistrationCurrent(id));
+  EXPECT_TRUE(loader.GetPersistentDynamicScriptIDs().contains(id));
+  // This is the exact ID set used by explicit-unregister API validation.
+  EXPECT_TRUE(loader.GetDynamicScriptIDs(
+                        UserScript::Source::kDynamicContentScript)
+                  .contains(id));
+  ASSERT_EQ(1u, loader.GetLoadedDynamicScripts().size());
+  ASSERT_EQ(1u, loader.GetLoadedDynamicScripts()[0]->js_scripts().size());
+  EXPECT_EQ("/* published */",
+            loader.GetLoadedDynamicScripts()[0]->js_scripts()[0]->GetContent());
+
+  int removed = 0;
+  loader.RemoveDynamicScripts(
+      {id}, base::BindLambdaForTesting(
+                [&](const std::optional<std::string>& error) {
+                  EXPECT_FALSE(error);
+                  ++removed;
+                }));
+  loader.CompleteLoad(true);
+  EXPECT_EQ(1, removed);
+  EXPECT_FALSE(loader.IsDynamicScriptRegistrationCurrent(id));
+  EXPECT_FALSE(loader.GetPersistentDynamicScriptIDs().contains(id));
+  EXPECT_TRUE(loader.GetDynamicScriptIDs(
+                        UserScript::Source::kDynamicContentScript)
+                  .empty());
+  EXPECT_TRUE(loader.GetLoadedDynamicScripts().empty());
+}
