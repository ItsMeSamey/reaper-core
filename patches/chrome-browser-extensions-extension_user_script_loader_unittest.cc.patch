+UserScriptList MakeOwnedScripts(const base::FilePath& extension_root,
+                                const std::string& extension_id,
+                                const std::string& id,
+                                const std::string& contents) {
+  auto script = std::make_unique<UserScript>();
+  script->set_id(id);
+  script->add_url_pattern(
+      URLPattern(URLPattern::SCHEME_ALL, "https://example.test/*"));
+  auto js = UserScript::Content::CreateFile(
+      extension_root, base::FilePath(FILE_PATH_LITERAL("owned.js")),
+      GURL("chrome-extension://" + extension_id + "/owned.js"));
+  js->set_content(contents);
+  script->js_scripts().push_back(std::move(js));
+  UserScriptList scripts;
+  scripts.push_back(std::move(script));
+  return scripts;
+}
+
+// Control only the existing asynchronous load reply. Invalid results do not
+// require resource exhaustion or execute any registered JavaScript.
+class ControlledExtensionScriptLoader : public ExtensionUserScriptLoader {
+ public:
+  ControlledExtensionScriptLoader(TestingProfile* profile,
+                                  const Extension& extension,
+                                  StateStore* state_store = nullptr)
+      : ExtensionUserScriptLoader(profile, extension, state_store,
+                                  /*content_verifier=*/nullptr),
+        extension_root_(extension.path()),
+        file_loader_(profile, extension, /*state_store=*/nullptr,
+                     /*content_verifier=*/nullptr) {
+    SetReady(true);
+  }
+
+  bool has_pending_load() const { return !pending_callback_.is_null(); }
+
+  void Register(const std::string& id,
+                const std::string& contents,
+                DynamicScriptsModifiedCallback callback) {
+    ASSERT_TRUE(base::WriteFile(extension_root_.AppendASCII("owned.js"), contents));
+    auto operation = BeginDynamicScriptOperation({id});
+    AddOwnedDynamicScripts(
+        operation, MakeOwnedScripts(extension_root_, host_id().id, id, contents),
+        {id}, std::move(callback));
+  }
+
+  void CompleteLoad(bool valid) {
+    ASSERT_TRUE(has_pending_load());
+    auto callback = std::move(pending_callback_);
+    // Complete from the test body after any StateStore callback has unwound.
+    // The ordinary file loader waits using a non-nestable RunLoop.
+    auto scripts = file_loader_.LoadScriptsForTest(std::move(pending_scripts_));
+    auto region = valid ? Serialize(scripts) : base::ReadOnlySharedMemoryRegion();
+    ASSERT_EQ(valid, region.IsValid());
+    std::move(callback).Run(std::move(scripts), std::move(region));
+    // A terminal may have destroyed this loader. Do not access members here.
+  }
+
+ private:
+  void LoadScripts(UserScriptList scripts,
+                   const std::set<std::string>& added_script_ids,
+                   LoadScriptsCallback callback) override {
+    ASSERT_FALSE(has_pending_load());
+    // StateStore may enter here from a UI task. Capture without blocking;
+    // CompleteLoad populates the real file bytes from the test body.
+    pending_scripts_ = std::move(scripts);
+    pending_callback_ = std::move(callback);
+  }
+
+  base::FilePath extension_root_;
+  ExtensionUserScriptLoader file_loader_;
+  UserScriptList pending_scripts_;
+  LoadScriptsCallback pending_callback_;
+};
+
+void FlushStore(StateStore& store) {
+  base::RunLoop loop;
+  store.FlushForTesting(loop.QuitClosure());
+  loop.Run();
+}
+
+std::set<std::string> ReadStoredScriptIds(StateStore& store,
+                                        const ExtensionId& extension_id) {
+  std::set<std::string> ids;
+  base::RunLoop loop;
+  store.GetExtensionValue(
+      extension_id, scripting::kRegisteredScriptsStorageKey,
+      base::BindLambdaForTesting([&](std::optional<base::Value> value) {
+        EXPECT_TRUE(value && value->is_list());
+        if (value && value->is_list()) {
+          for (const auto& entry : value->GetList()) {
+            EXPECT_TRUE(entry.is_dict());
+            if (!entry.is_dict()) {
+              continue;
+            }
+            const std::string* id = entry.GetDict().FindString("id");
+            EXPECT_NE(nullptr, id);
+            if (id) {
+              ids.insert(*id);
+            }
+          }
+        }
+        loop.Quit();
+      }));
+  loop.Run();
+  return ids;
+}
