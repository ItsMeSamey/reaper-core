+TEST_F(ExtensionUserScriptLoaderTest,
+       AndroidInitialFailurePreservesStoredScriptsAcrossLaterWrite) {
+  TestingProfile profile;
+  ASSERT_TRUE(base::WriteFile(
+      temp_dir_.GetPath().AppendASCII("owned.js"), "/* previously accepted */"));
+  auto extension = ExtensionBuilder("Test")
+                       .SetPath(temp_dir_.GetPath())
+                       .SetManifestVersion(3)
+                       .AddAPIPermission("scripting")
+                       .AddHostPermission("https://example.test/*")
+                       .Build();
+  ExtensionRegistry::Get(&profile)->AddEnabled(extension);
+  auto factory =
+      base::MakeRefCounted<value_store::ValueStoreFactoryImpl>(temp_dir_.GetPath());
+  StateStore store(&profile, factory, StateStore::BackendType::SCRIPTS,
+                   /*deferred_load=*/false);
+  const std::string stored_id = "_dc_stored";
+  const std::string later_id = "_dc_later";
+  {
+    ControlledExtensionScriptLoader seed(&profile, *extension, &store);
+    seed.Register(stored_id, "/* previously accepted */",
+                  base::BindLambdaForTesting(
+                      [](const std::optional<std::string>& error) {
+                        EXPECT_FALSE(error);
+                      }));
+    seed.CompleteLoad(true);
+    ASSERT_TRUE(seed.GetPersistentDynamicScriptIDs().contains(stored_id));
+    FlushStore(store);
+  }
+  EXPECT_EQ(std::set<std::string>({stored_id}),
+            ReadStoredScriptIds(store, extension->id()));
+
+  ControlledExtensionScriptLoader loader(&profile, *extension, &store);
+  int initial_errors = 0;
+  ASSERT_TRUE(loader.AddScriptsForExtensionLoad(
+      *extension,
+      base::BindLambdaForTesting(
+          [&](UserScriptLoader* completed_loader,
+              const std::optional<std::string>& error) {
+            EXPECT_EQ(&loader, completed_loader);
+            EXPECT_TRUE(error);
+            ++initial_errors;
+          })));
+  FlushStore(store);
+  ASSERT_TRUE(loader.has_pending_load());
+  loader.CompleteLoad(false);
+  EXPECT_EQ(1, initial_errors);
+  EXPECT_FALSE(loader.initial_load_complete());
+  EXPECT_TRUE(loader.GetPendingDynamicScriptIDsForTesting().empty());
+  EXPECT_TRUE(loader.IsDynamicScriptRegistrationCurrent(stored_id));
+  EXPECT_TRUE(loader.GetPersistentDynamicScriptIDs().contains(stored_id));
+  ASSERT_TRUE(loader.GetLoadedScriptsForTesting());
+  EXPECT_TRUE(loader.GetLoadedScriptsForTesting()->empty());
+  EXPECT_EQ(std::set<std::string>({stored_id}),
+            ReadStoredScriptIds(store, extension->id()));
+
+  int later_successes = 0;
+  loader.Register(later_id, "/* later accepted */",
+                  base::BindLambdaForTesting(
+                      [&](const std::optional<std::string>& error) {
+                        EXPECT_FALSE(error);
+                        ++later_successes;
+                      }));
+  loader.CompleteLoad(true);
+  FlushStore(store);
+  EXPECT_EQ(1, initial_errors);
+  EXPECT_EQ(1, later_successes);
+  EXPECT_EQ(std::set<std::string>({stored_id, later_id}),
+            ReadStoredScriptIds(store, extension->id()));
+  // Persisting the prior registration does not claim automatic native retry.
+  ASSERT_TRUE(loader.GetLoadedScriptsForTesting());
+  ASSERT_EQ(1u, loader.GetLoadedScriptsForTesting()->size());
+  EXPECT_EQ(later_id, loader.GetLoadedScriptsForTesting()->front()->id());
+}
