+TEST_F(ExtensionUserScriptLoaderTest,
+       AndroidFailedRemovalAndReplacementPreservePublishedRegistration) {
+  TestingProfile profile;
+  auto extension =
+      ExtensionBuilder("Test").SetPath(temp_dir_.GetPath()).Build();
+  ControlledExtensionScriptLoader loader(&profile, *extension);
+  const std::string id = "_dc_replace";
+  loader.Register(id, "/* old bytes */",
+                  base::BindLambdaForTesting(
+                      [](const std::optional<std::string>& error) {
+                        EXPECT_FALSE(error);
+                      }));
+  loader.CompleteLoad(true);
+  ASSERT_TRUE(loader.IsDynamicScriptRegistrationCurrent(id));
+  // Establish real file bytes in the published base state before rollback.
+  ASSERT_TRUE(loader.GetLoadedScriptsForTesting());
+  ASSERT_EQ(1u, loader.GetLoadedScriptsForTesting()->size());
+  ASSERT_EQ(1u, loader.GetLoadedScriptsForTesting()->front()->js_scripts().size());
+  ASSERT_EQ("/* old bytes */",
+            loader.GetLoadedScriptsForTesting()
+                ->front()
+                ->js_scripts()[0]
+                ->GetContent());
+
+  int errors = 0;
+  auto failed = [&errors](const std::optional<std::string>& error) {
+    EXPECT_TRUE(error);
+    ++errors;
+  };
+  loader.RemoveDynamicScripts({id}, base::BindLambdaForTesting(failed));
+  loader.Register(id, "/* failed replacement */",
+                  base::BindLambdaForTesting(failed));
+  loader.CompleteLoad(false);
+  EXPECT_EQ(0, errors);
+  ASSERT_TRUE(loader.has_pending_load());
+  loader.CompleteLoad(false);
+  EXPECT_EQ(2, errors);
+  EXPECT_TRUE(loader.GetPendingDynamicScriptIDsForTesting().empty());
+  EXPECT_TRUE(loader.IsDynamicScriptRegistrationCurrent(id));
+  EXPECT_TRUE(loader.GetPersistentDynamicScriptIDs().contains(id));
+  EXPECT_TRUE(loader.GetDynamicScriptIDs(
+                        UserScript::Source::kDynamicContentScript)
+                  .contains(id));
+  ASSERT_EQ(1u, loader.GetLoadedDynamicScripts().size());
+  ASSERT_EQ(1u, loader.GetLoadedDynamicScripts()[0]->js_scripts().size());
+  EXPECT_EQ("/* old bytes */",
+            loader.GetLoadedDynamicScripts()[0]->js_scripts()[0]->GetContent());
+  ASSERT_TRUE(loader.GetLoadedScriptsForTesting());
+  ASSERT_EQ(1u, loader.GetLoadedScriptsForTesting()->size());
+  ASSERT_EQ(1u, loader.GetLoadedScriptsForTesting()->front()->js_scripts().size());
+  EXPECT_EQ("/* old bytes */",
+            loader.GetLoadedScriptsForTesting()
+                ->front()
+                ->js_scripts()[0]
+                ->GetContent());
+
+  int removed = 0;
+  loader.RemoveDynamicScripts(
+      {id}, base::BindLambdaForTesting(
+                [&](const std::optional<std::string>& error) {
+                  EXPECT_FALSE(error);
+                  ++removed;
+                }));
+  loader.CompleteLoad(true);
+  EXPECT_EQ(1, removed);
+  EXPECT_TRUE(loader.GetLoadedDynamicScripts().empty());
+  EXPECT_FALSE(loader.GetPersistentDynamicScriptIDs().contains(id));
+}
