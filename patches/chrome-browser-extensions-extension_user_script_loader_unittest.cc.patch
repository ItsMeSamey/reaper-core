+TEST_F(ExtensionUserScriptLoaderTest,
+       AndroidCoreConfigMapFactoryRegisteredBeforeUse) {
+  EnsureCoreBrowserContextKeyedServiceFactoriesBuilt();
+  // Inspect by name before invoking any config-map getter: a lazy GetInstance()
+  // here would hide the missing early registration that aborts ordinary loads.
+  std::vector<raw_ptr<DependencyNode, VectorExperimental>> factories;
+  ASSERT_TRUE(BrowserContextDependencyManager::GetInstance()
+                  ->GetDependencyGraphForTesting()
+                  .GetConstructionOrder(&factories));
+  bool config_map_registered = false;
+  for (const auto& node : factories) {
+    auto* factory = static_cast<KeyedServiceBaseFactory*>(node.get());
+    if (std::string(factory->name()) == "ExtensionConfigMap") {
+      config_map_registered = true;
+    }
+  }
+  ASSERT_TRUE(config_map_registered);
+
+  // Registering the singleton must not opt a profile into a config provider.
+  TestingProfile profile;
+  EXPECT_EQ(nullptr,
+            ExtensionConfigMapFactory::GetForBrowserContext(&profile));
+}
