+    /** A value snapshot used only while a real split is closing. */
+    final class SplitData {
+        private final Token mToken;
+        private final int mLayout;
+        private final double mRatio;
+        private final int mPosition;
+
+        public SplitData(Token token, int layout, double ratio, int position) {
+            mToken = token;
+            mLayout = layout;
+            mRatio = ratio;
+            mPosition = position;
+        }
+
+        public Token getToken() {
+            return mToken;
+        }
+
+        public int getLayout() {
+            return mLayout;
+        }
+
+        public double getRatio() {
+            return mRatio;
+        }
+
+        public int getPosition() {
+            return mPosition;
+        }
+
+        public static boolean isValid(
+                @Nullable Token token, int layout, double ratio, int position) {
+            return token != null
+                    && !token.isZero()
+                    && (layout == 0 || layout == 1)
+                    && Double.isFinite(ratio)
+                    && ratio > 0
+                    && ratio < 1
+                    && (position == 0 || position == 1);
+        }
+    }
+
+    /** Mirrored native split membership; persisted state is restored into the native model. */
+    default @Nullable Token getSplitTabId() {
+        return null;
+    }
+
+    default int getSplitLayout() {
+        return 0;
+    }
+
+    default double getSplitRatio() {
+        return 0.5;
+    }
+
+    default int getSplitPosition() {
+        return -1;
+    }
+
+    default void setSplitData(@Nullable Token token, int layout, double ratio, int position) {}
+
+    default void captureSplitDataForClosure() {}
+
+    default @Nullable SplitData getSplitDataForClosure() {
+        return null;
+    }
+
+    default void clearSplitDataForClosure() {}
