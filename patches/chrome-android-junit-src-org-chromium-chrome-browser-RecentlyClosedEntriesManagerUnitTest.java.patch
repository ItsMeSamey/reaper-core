+    // This plain reader fake retains the original fixture name and regression assertions.
+    public static class ShadowClosedWindowTabStore
+            implements RecentlyClosedEntriesManager.ClosedWindowTabReader {
+        static final List<Callback<List<ClosedWindowTabInfo>>> sCallbacks = new ArrayList<>();
+        static List<ClosedWindowTabInfo> sSyncResult = Collections.emptyList();
+        static int sSyncReads;
+
+        @Override
+        public void getTabListForClosedWindow(
+                int instanceId, Callback<List<ClosedWindowTabInfo>> callback) {
+            sCallbacks.add(callback);
+        }
+
+        @Override
+        public List<ClosedWindowTabInfo> getTabListForClosedWindow(int instanceId) {
+            sSyncReads++;
+            return sSyncResult;
+        }
+
+        public static void reset() {
+            sCallbacks.clear();
+            sSyncResult = Collections.emptyList();
+            sSyncReads = 0;
+        }
+    }
+
+    private void setUpClosedWindowTabStore() {
+        ShadowClosedWindowTabStore.reset();
+        mRecentlyClosedEntriesManager.setClosedWindowTabReaderForTesting(
+                new ShadowClosedWindowTabStore());
+    }
+
+    private static RecentlyClosedWindow closedWindowForPrefetch(long timestamp, String title) {
+        return new RecentlyClosedWindow(
+                timestamp, 42, "https://current.example/", "Window", title, 1);
+    }
+
+    private static List<ClosedWindowTabInfo> closedWindowTabInfo(int id, String url) {
+        return List.of(new ClosedWindowTabInfo(id, new GURL(url), true));
+    }
+
+    private void assertInvalidatedPrefetchCannotFillNewRequest(boolean restoreWindow) {
+        RecentlyClosedWindow oldWindow = closedWindowForPrefetch(1000L, "Old active title");
+        RecentlyClosedWindow currentWindow = closedWindowForPrefetch(2000L, "Current active title");
+        mRecentlyClosedEntriesManager.preFetchTabsForWindow(oldWindow);
+        if (restoreWindow) {
+            mRecentlyClosedEntriesManager.onWindowRestored(42);
+        } else {
+            mRecentlyClosedEntriesManager.clearTabListCache();
+        }
+        mRecentlyClosedEntriesManager.preFetchTabsForWindow(currentWindow);
+        assertEquals(2, ShadowClosedWindowTabStore.sCallbacks.size());
+
+        // Complete the invalidated read while its replacement is pending, then the current read.
+        ShadowClosedWindowTabStore.sCallbacks.get(0)
+                .onResult(closedWindowTabInfo(10, "https://old.example/"));
+        ShadowClosedWindowTabStore.sCallbacks.get(1)
+                .onResult(closedWindowTabInfo(20, "https://current.example/"));
+        List<RecentlyClosedTab> tabs =
+                mRecentlyClosedEntriesManager.getTabsForClosedWindow(currentWindow);
+        assertEquals(0, ShadowClosedWindowTabStore.sSyncReads);
+        assertEquals(1, tabs.size());
+        assertEquals(20, tabs.get(0).getSessionId());
+        assertEquals("https://current.example/", tabs.get(0).getUrl().getSpec());
+        assertEquals("Current active title", tabs.get(0).getTitle());
+        assertEquals(2000L, tabs.get(0).getTimestamp());
+    }
