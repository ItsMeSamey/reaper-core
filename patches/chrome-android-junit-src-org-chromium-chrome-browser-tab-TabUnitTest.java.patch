+    @Test
+    @SmallTest
+    public void testVisibilityTransitionsNotifyOnceInOrder() {
+        prepareVisibilityTestTab();
+        doAnswer(
+                        invocation -> {
+                            assertFalse(mTab.isHidden());
+                            return null;
+                        })
+                .when(mNativeMock)
+                .sendDidBecomeVisibleUpdate(1);
+        doAnswer(
+                        invocation -> {
+                            assertFalse(mTab.isHidden());
+                            return null;
+                        })
+                .when(mNativeMock)
+                .sendWillBecomeHiddenUpdate(1);
+
+        mTab.show(TabSelectionType.FROM_USER);
+        mTab.show(TabSelectionType.FROM_USER);
+        mTab.hide(TabHidingType.CHANGED_TABS);
+        mTab.hide(TabHidingType.CHANGED_TABS);
+        mTab.show(TabSelectionType.FROM_USER);
+        mTab.hide(TabHidingType.CHANGED_TABS);
+
+        assertTrue(mTab.isHidden());
+        InOrder order = inOrder(mNativeMock, mObserver);
+        order.verify(mNativeMock).sendDidBecomeVisibleUpdate(1);
+        order.verify(mNativeMock).onShow(1);
+        order.verify(mObserver).onShown(mTab, TabSelectionType.FROM_USER);
+        order.verify(mNativeMock).sendWillBecomeHiddenUpdate(1);
+        order.verify(mObserver).onHidden(mTab, TabHidingType.CHANGED_TABS);
+        order.verify(mNativeMock).sendDidBecomeVisibleUpdate(1);
+        order.verify(mNativeMock).onShow(1);
+        order.verify(mObserver).onShown(mTab, TabSelectionType.FROM_USER);
+        order.verify(mNativeMock).sendWillBecomeHiddenUpdate(1);
+        order.verify(mObserver).onHidden(mTab, TabHidingType.CHANGED_TABS);
+        verify(mNativeMock, times(2)).sendDidBecomeVisibleUpdate(1);
+        verify(mNativeMock, times(2)).sendWillBecomeHiddenUpdate(1);
+        verify(mNativeMock, never()).sendDidActivateUpdate(anyLong());
+        verify(mNativeMock, never()).sendWillDeactivateUpdate(anyLong());
+    }
