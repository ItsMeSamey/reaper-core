+    private void prepareVisibilityTestTab() {
+        mTab = spy(mTab);
+        mTab.setNativePtrForTesting(1);
+        // Keep the production show/hide state machine, without creating a renderer.
+        doReturn(false).when(mTab).loadIfNeeded(anyBoolean());
+    }
