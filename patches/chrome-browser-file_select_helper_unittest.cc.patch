+
+#if BUILDFLAG(IS_ANDROID)
+namespace {
+class AndroidPickerListener : public content::FileSelectListener {
+ public:
+  void FileSelected(std::vector<blink::mojom::FileChooserFileInfoPtr> files,
+                    const base::FilePath& base_dir,
+                    blink::mojom::FileChooserParams::Mode mode) override {
+    ++selected;
+    if (on_selected) {
+      std::move(on_selected).Run();
+    }
+  }
+  void FileSelectionCanceled() override { ++canceled; }
+
+  int selected = 0;
+  int canceled = 0;
+  base::OnceClosure on_selected;
+
+ private:
+  ~AndroidPickerListener() override = default;
+};
+}  // namespace
+
+class AndroidFileSelectHelperTest : public ChromeRenderViewHostTestHarness {
+ public:
+  AndroidFileSelectHelperTest() {
+    // Exercise navigation that replaces a document while retaining its RFH.
+    feature_list_.InitAndDisableFeature(::features::kRenderDocument);
+  }
+
+ protected:
+  void SetUp() override {
+    ChromeRenderViewHostTestHarness::SetUp();
+    model_ = std::make_unique<OwningTestTabModel>(profile());
+    model_->SetIsActiveModel(true);
+    tab_ = model_->AddTabFromWebContents(CreateTestWebContents(), 0, true);
+    content::NavigationSimulator::NavigateAndCommitFromBrowser(
+        tab_->GetContents(), GURL("https://picker.test/first"));
+    listener_ = base::MakeRefCounted<AndroidPickerListener>();
+    helper_ = new FileSelectHelper(profile());
+    helper_->web_contents_ = tab_->GetContents();
+    helper_->render_frame_host_ = tab_->GetContents()->GetPrimaryMainFrame();
+    helper_->requesting_document_ =
+        helper_->render_frame_host_->GetWeakDocumentPtr();
+    helper_->android_file_picker_request_ = true;
+    helper_->listener_ = listener_;
+    helper_->self_ptr_ = helper_;
+    helper_->InitLifecycleObserver(tab_->GetContents());
+  }
+
+  void TearDown() override {
+    helper_->RunFileChooserEnd();
+    // Destroy real observed contents while the helper is retained locally.
+    model_.reset();
+    tab_ = nullptr;
+    helper_.reset();
+    ChromeRenderViewHostTestHarness::TearDown();
+  }
+
+  void Hide(bool picker_started) {
+    helper_->android_file_picker_started_ = picker_started;
+    // The model's native callback precedes the Java visibility flag change.
+    tab_->SendWillBecomeHiddenUpdate(nullptr);
+    tab_->GetContents()->WasHidden();
+  }
+
+  void DeliverResult() { helper_->NotifyListenerAndEnd({}); }
+  bool OwnerValid() const { return helper_->IsAndroidPickerOwnerValid(); }
+  void CompletePreparation() {
+    helper_->GetSanitizedFilenameOnUIThread(FileChooserParams::New());
+  }
+  void RetainTemporaryFile(const base::FilePath& path) {
+    helper_->temporary_files_.push_back(path);
+  }
+
+  base::test::ScopedFeatureList feature_list_;
+  std::unique_ptr<OwningTestTabModel> model_;
+  raw_ptr<TabAndroid> tab_ = nullptr;
+  scoped_refptr<FileSelectHelper> helper_;
+  scoped_refptr<AndroidPickerListener> listener_;
+};
+
+TEST_F(AndroidFileSelectHelperTest,
+       PermissionModelObserverUsesPreAndPostCommitState) {
+  auto* client = ChromePermissionsClient::GetInstance();
+  ASSERT_TRUE(client->IsAndroidTabModelActive(tab_));
+  std::vector<std::pair<bool, bool>> transitions;
+  auto observation = client->ObserveAndroidTabModel(
+      tab_, base::BindLambdaForTesting([&](bool active) {
+        transitions.emplace_back(active, model_->IsActiveModel());
+      }));
+  model_->SetIsActiveModel(false);
+  EXPECT_FALSE(client->IsAndroidTabModelActive(tab_));
+  model_->SetIsActiveModel(true);
+  EXPECT_THAT(transitions, testing::ElementsAre(std::pair(false, true),
+                                                std::pair(true, true)));
+  observation.RunAndReset();
+  model_->SetIsActiveModel(false);
+  EXPECT_EQ(2u, transitions.size());
+}
+
+TEST_F(AndroidFileSelectHelperTest, PassiveVisiblePaneCannotReceiveResult) {
+  ASSERT_TRUE(OwnerValid());
+  model_->AddTabFromWebContents(CreateTestWebContents(), 1, true);
+  tab_->GetContents()->WasShown();  // Both split panes remain visible.
+  DeliverResult();
+  EXPECT_EQ(1, listener_->canceled);
+  EXPECT_EQ(0, listener_->selected);
+}
+
+TEST_F(AndroidFileSelectHelperTest, InactiveModelCannotReceiveResult) {
+  ASSERT_TRUE(OwnerValid());
+  model_->SetIsActiveModel(false);
+  ASSERT_EQ(tab_.get(), model_->GetActiveTab());
+  DeliverResult();
+  EXPECT_EQ(1, listener_->canceled);
+  EXPECT_EQ(0, listener_->selected);
+}
+
+TEST_F(AndroidFileSelectHelperTest, ModelSwitchRoundTripDoesNotRevivePicker) {
+  ASSERT_TRUE(OwnerValid());
+  model_->SetIsActiveModel(false);
+  EXPECT_EQ(1, listener_->canceled);
+  model_->SetIsActiveModel(true);
+  DeliverResult();
+  EXPECT_EQ(1, listener_->canceled);
+  EXPECT_EQ(0, listener_->selected);
+}
+
+TEST_F(AndroidFileSelectHelperTest, HiddenPreparationCancelsBeforeAsyncReply) {
+  ASSERT_TRUE(OwnerValid());
+  Hide(false);
+  EXPECT_EQ(1, listener_->canceled);
+  CompletePreparation();
+  EXPECT_EQ(1, listener_->canceled);
+  EXPECT_EQ(0, listener_->selected);
+}
+
+TEST_F(AndroidFileSelectHelperTest, OsPickerHideAllowsOriginalOwnerResult) {
+  ASSERT_TRUE(OwnerValid());
+  Hide(true);
+  EXPECT_EQ(0, listener_->canceled);
+  ASSERT_TRUE(OwnerValid());
+  DeliverResult();
+  EXPECT_EQ(0, listener_->canceled);
+  EXPECT_EQ(1, listener_->selected);
+}
+
+TEST_F(AndroidFileSelectHelperTest, SameRfhNavigationRejectsOldDocumentResult) {
+  auto* frame = tab_->GetContents()->GetPrimaryMainFrame();
+  ASSERT_TRUE(OwnerValid());
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(
+      tab_->GetContents(), GURL("https://picker.test/replacement"));
+  ASSERT_EQ(frame, tab_->GetContents()->GetPrimaryMainFrame());
+  DeliverResult();
+  EXPECT_EQ(1, listener_->canceled);
+  EXPECT_EQ(0, listener_->selected);
+}
+
+TEST_F(AndroidFileSelectHelperTest, MetadataCancellationCompletesExactlyOnce) {
+  base::ScopedTempDir temporary;
+  ASSERT_TRUE(temporary.CreateUniqueTempDir());
+  base::FilePath path = temporary.GetPath().AppendASCII("stripped.jpg");
+  ASSERT_TRUE(base::WriteFile(path, "image"));
+  RetainTemporaryFile(path);
+  tab_->SendWillDeactivateUpdate(nullptr);
+  EXPECT_EQ(1, listener_->canceled);
+  DeliverResult();  // The image metadata worker returns after cancellation.
+  EXPECT_EQ(1, listener_->canceled);
+  EXPECT_EQ(0, listener_->selected);
+  model_.reset();
+  tab_ = nullptr;
+  task_environment()->RunUntilIdle();
+  EXPECT_FALSE(base::PathExists(path));
+}
+
+TEST_F(AndroidFileSelectHelperTest,
+       SuccessfulListenerCanDeactivateReentrantly) {
+  listener_->on_selected = base::BindLambdaForTesting(
+      [&] { tab_->SendWillDeactivateUpdate(nullptr); });
+  DeliverResult();
+  EXPECT_EQ(1, listener_->selected);
+  EXPECT_EQ(0, listener_->canceled);
+}
+#endif  // BUILDFLAG(IS_ANDROID)
 
