+  resources.OverrideLocaleStringResource(IDS_APP_CLOSE, u"\U0001F512 Third");
+  resources.OverrideLocaleStringResource(
+      IDS_CONCAT_THREE_STRINGS_WITH_COMMA,
+      u"\U0001F680 $3, then $1 and $2 \U0001F31F");
+  std::vector<int> clicked;
+  auto dialog_model =
+      DialogModel::Builder()
+          .SetTitle(u"UTF-16 localized replacements")
+          .AddOkButton(base::DoNothing())
+          .SetDialogDestroyingCallback(
+              base::BindLambdaForTesting([&]() { dialog_destroyed_ = true; }))
+          .AddParagraph(DialogModelLabel::CreateWithReplacements(
+              IDS_CONCAT_THREE_STRINGS_WITH_COMMA,
+              {DialogModelLabel::CreateLink(
+                   IDS_APP_OK,
+                   base::BindLambdaForTesting([&]() { clicked.push_back(1); })),
+               DialogModelLabel::CreatePlainText(u"\U0001F4C4 plain"),
+               DialogModelLabel::CreateLink(
+                   IDS_APP_CLOSE,
+                   base::BindLambdaForTesting([&]() { clicked.push_back(3); }))}))
+          .Build();
+  ModalDialogWrapper::ShowTabModal(std::move(dialog_model), window_->get());
+  base::ScopedClosureRunner close_dialog(base::BindLambdaForTesting([&]() {
+    if (!dialog_destroyed_) {
+      static_cast<DialogModelHost*>(ModalDialogWrapper::GetDialogForTesting())
+          ->Close();
+    }
+  }));
+
+  const auto paragraphs = fake_dialog_manager_->GetMessageParagraphs();
+  ASSERT_EQ(1u, paragraphs.size());
+  EXPECT_EQ(u"\U0001F680 \U0001F512 Third, then First \U0001F9E9 and "
+            u"\U0001F4C4 plain \U0001F31F",
+            paragraphs[0]);
+  EXPECT_TRUE(clicked.empty());
+  fake_dialog_manager_->ClickLinkInMessageParagraphs(0);
+  EXPECT_EQ((std::vector<int>{3}), clicked);
+  fake_dialog_manager_->ClickLinkInMessageParagraphs(1);
+  EXPECT_EQ((std::vector<int>{3, 1}), clicked);
+  fake_dialog_manager_->ClickPositiveButton();
+  EXPECT_TRUE(dialog_destroyed_);
+}
