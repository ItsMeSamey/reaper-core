+void RemoveVariationsHeaderIfNeeded(
+    const net::RedirectInfo& redirect,
+    const network::mojom::URLResponseHead& response,
+    InIncognito incognito,
+    std::vector<std::string>* removed_headers) {
+  removed_headers->push_back(kClientDataHeader);
+}
+std::unique_ptr<network::SimpleURLLoader>
+CreateSimpleURLLoaderWithVariationsHeader(
+    std::unique_ptr<network::ResourceRequest> request,
+    InIncognito incognito,
+    SignedIn signed_in,
+    const net::NetworkTrafficAnnotationTag& annotation) {
+  // Preserve normal updater/security transport and all unrelated request state.
+  request->cors_exempt_headers.RemoveHeader(kClientDataHeader);
+  return network::SimpleURLLoader::Create(std::move(request), annotation);
+}
+std::unique_ptr<network::SimpleURLLoader>
+CreateSimpleURLLoaderWithVariationsHeaderUnknownSignedIn(
+    std::unique_ptr<network::ResourceRequest> request,
+    InIncognito incognito,
+    const net::NetworkTrafficAnnotationTag& annotation) {
+  return CreateSimpleURLLoaderWithVariationsHeader(
+      std::move(request), incognito, SignedIn::kNo, annotation);
+}
+bool HasVariationsHeader(const network::ResourceRequest& request) {
+  return request.cors_exempt_headers.HasHeader(kClientDataHeader);
+}
+bool GetVariationsHeader(const network::ResourceRequest& request,
+                         std::string* out) {
+  auto value = request.cors_exempt_headers.GetHeader(kClientDataHeader);
+  if (!value) {
+    return false;
+  }
+  *out = *value;
+  return true;
+}
