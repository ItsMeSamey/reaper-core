+    @Test
+    public void testSplitFlatBufferRoundTripPreservesVisualsAndGroup() {
+        for (boolean encrypted : new boolean[] {false, true}) {
+            for (int position = 0; position < 2; position++) {
+                TabState state =
+                        createTabState(new WebContentsState(ByteBuffer.allocateDirect(0), VERSION));
+                state.splitTabId = new Token(73, 91);
+                state.splitLayout = position;
+                state.splitRatio = 0.37;
+                state.splitPosition = position;
+                FlatBufferTabStateSerializer serializer =
+                        new FlatBufferTabStateSerializer(encrypted);
+                TabState restored = serializer.deserialize(serializer.serialize(state));
+                Assert.assertNotNull(restored);
+                assertEquals(state.splitTabId, restored.splitTabId);
+                assertEquals(state.splitLayout, restored.splitLayout);
+                assertEquals(0.37, restored.splitRatio, 0);
+                assertEquals(position, restored.splitPosition);
+                assertEquals(TAB_GROUP_ID, restored.tabGroupId);
+                assertEquals(IS_PINNED, restored.isPinned);
+                assertEquals(encrypted, restored.isIncognito);
+            }
+        }
+    }
