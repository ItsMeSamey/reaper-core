+    @Test
+    public void testIntentCompletedWithNullResultUsesCameraOutput() {
+        TestSelectFileDialog selectFileDialog = new TestSelectFileDialog(0);
+        WindowAndroid windowAndroid = Mockito.mock(WindowAndroid.class);
+        when(windowAndroid.getApplicationContext()).thenReturn(ContextUtils.getApplicationContext());
+        Uri cameraOutputUri = Uri.parse("file:///storage/emulated/0/DCIM/Camera/IMG_0.jpg");
+        ReflectionHelpers.setField(selectFileDialog, "mWindowAndroid", windowAndroid);
+        ReflectionHelpers.setField(selectFileDialog, "mCameraOutputUri", cameraOutputUri);
+        int callCount = mOnActionCallback.getCallCount();
+
+        selectFileDialog.onIntentCompleted(Activity.RESULT_OK, null);
+
+        assertEquals(1, selectFileDialog.mFileSelectionSuccess);
+        assertEquals(0, selectFileDialog.mFileSelectionAborted);
+        assertEquals(callCount + 1, mOnActionCallback.getCallCount());
+        ArgumentCaptor<Intent> scannerIntent = ArgumentCaptor.forClass(Intent.class);
+        Mockito.verify(windowAndroid).sendBroadcast(scannerIntent.capture());
+        assertEquals(Intent.ACTION_MEDIA_SCANNER_SCAN_FILE, scannerIntent.getValue().getAction());
+        assertEquals(cameraOutputUri, scannerIntent.getValue().getData());
+    }
