+// static
+api::tabs::Tab ExtensionTabUtil::CreateTabObject(
+    tabs::TabInterface& tab,
+    ScrubTabBehavior scrub_tab_behavior,
+    const Extension* extension,
+    TabListInterface* tab_list,
+    int tab_index) {
+  if (tab.GetContents()) {
+    return CreateTabObject(tab.GetContents(), scrub_tab_behavior, extension,
+                           tab_list, tab_index);
+  }
+  auto* browser = tab.GetBrowserWindowInterface();
+  if (!tab_list && browser) {
+    tab_list = TabListInterface::From(browser);
+    if (tab_list) {
+      tab_index = tab_list->GetIndexOfTab(tab.GetHandle());
+    }
+  }
+  api::tabs::Tab object;
+  object.id = browser && !BrowserSupportsTabs(browser)
+                  ? api::tabs::TAB_ID_NONE : GetTabId(tab);
+  object.index = tab_index;
+  object.window_id = GetWindowIdOfTab(tab);
+  object.status = api::tabs::TabStatus::kUnloaded;
+  object.last_accessed = tab.GetLastActiveTime().InMillisecondsFSinceUnixEpoch();
+  object.active = tab.IsActivated();
+  object.selected = object.active;
+  object.highlighted = tab.IsSelected();
+  object.pinned = tab.IsPinned();
+  object.group_id = tab.GetGroup() ? GetGroupId(*tab.GetGroup()) : -1;
+  object.split_view_id = tab.GetSplit() ? GetSplitId(*tab.GetSplit()) : -1;
+  object.incognito = tab.GetProfile()->IsOffTheRecord();
+  // Absent contents have no live renderer, audible/capture or page-node state.
+  // Deferred session restores are unloaded, not necessarily discarded/frozen.
+  object.audible = false;
+  object.discarded = false;
+  object.frozen = false;
+  object.auto_discardable = true;
+  api::tabs::MutedInfo muted;
+  muted.muted = false;
+  object.muted_info = std::move(muted);
+#if BUILDFLAG(IS_ANDROID)
+  auto* android_tab = TabAndroid::FromTabInterface(&tab);
+  object.url = android_tab->GetCommittedURL().spec();
+  object.title = base::UTF16ToUTF8(android_tab->GetCommittedTitle());
+  const GURL pending_url = android_tab->GetPendingURL();
+  if (!pending_url.is_empty()) {
+    object.pending_url = pending_url.spec();
+  }
+#else
+  object.url = tab.GetURL().spec();
+  object.title = base::UTF16ToUTF8(tab.GetTitle());
+#endif
+  if (tab_list) {
+    if (auto* opener = tab_list->GetOpenerForTab(tab.GetHandle())) {
+      object.opener_tab_id = GetTabId(*opener);
+    }
+  }
+  ScrubTabForExtension(extension, nullptr, &object, scrub_tab_behavior);
+  return object;
+}
+
+// static
+ExtensionTabUtil::ScrubTabBehavior ExtensionTabUtil::GetScrubTabBehavior(
+    const Extension* extension,
+    mojom::ContextType context,
+    const tabs::TabInterface& tab) {
+  if (tab.GetContents()) {
+    return GetScrubTabBehavior(extension, context, tab.GetContents());
+  }
+  GURL committed_url = tab.GetURL();
+  GURL pending_url;
+#if BUILDFLAG(IS_ANDROID)
+  auto* android_tab = TabAndroid::FromTabInterface(&tab);
+  committed_url = android_tab->GetCommittedURL();
+  pending_url = android_tab->GetPendingURL();
+#endif
+  const int id = GetTabId(tab);
+  return {GetScrubTabBehaviorImpl(extension, context, committed_url, id),
+          GetScrubTabBehaviorImpl(extension, context, pending_url, id)};
 }
 
