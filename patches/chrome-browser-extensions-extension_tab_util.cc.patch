+#if BUILDFLAG(IS_ANDROID)
+// static
+bool ExtensionTabUtil::IsTabAutoDiscardable(content::WebContents* contents) {
+  if (!performance_manager::PerformanceManager::IsAvailable() ||
+      !performance_manager::PerformanceManager::
+          GetPrimaryPageNodeForWebContents(contents)) {
+    return true;
+  }
+  return performance_manager::PageLiveStateDecorator::IsAutoDiscardable(
+      contents);
+}
+
+// static
+bool ExtensionTabUtil::IsTabFrozen(content::WebContents* contents) {
+  if (!performance_manager::PerformanceManager::IsAvailable()) {
+    return false;
+  }
+  auto page =
+      performance_manager::PerformanceManager::GetPrimaryPageNodeForWebContents(
+          contents);
+  return page && page->GetLifecycleState() ==
+                     performance_manager::PageNode::LifecycleState::kFrozen;
+}
+
+// static
+bool ExtensionTabUtil::SetTabAutoDiscardable(content::WebContents* contents,
+                                             bool value) {
+  if (!performance_manager::PerformanceManager::IsAvailable() ||
+      !performance_manager::PerformanceManager::
+          GetPrimaryPageNodeForWebContents(contents)) {
+    return false;
+  }
+  performance_manager::PageLiveStateDecorator::SetIsAutoDiscardable(contents,
+                                                                    value);
+  return true;
+}
+#endif  // BUILDFLAG(IS_ANDROID)
