+int ExtensionTabUtil::GetTabId(const tabs::TabInterface& tab) {
+  if (tab.GetContents()) {
+    return GetTabId(tab.GetContents());
+  }
+  return tabs::SessionMappedTabHandleFactory::GetInstance()
+      .GetSessionIdForHandle(tab.GetHandle().raw_value())
+      .value_or(api::tabs::TAB_ID_NONE);
+}
+
+int ExtensionTabUtil::GetWindowIdOfTab(const tabs::TabInterface& tab) {
+  if (tab.GetContents()) {
+    return GetWindowIdOfTab(tab.GetContents());
+  }
+#if BUILDFLAG(IS_ANDROID)
+  return TabAndroid::FromTabInterface(&tab)->GetWindowId().id();
+#else
+  return api::tabs::TAB_ID_NONE;
+#endif
+}
