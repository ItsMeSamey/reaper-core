+TEST(AnnotatorTest, AndroidFailedResultCallbackCanRetrySameImage) {
+  base::test::TaskEnvironment test_task_env(
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME);
+  TestServerURLLoaderFactory test_url_factory(
+      "https://ia-pa.googleapis.com/v1/");
+  Annotator annotator(GURL(kTestServerUrl), GURL(""), std::string(), kThrottle,
+                      1, 1.0, test_url_factory.AsSharedURLLoaderFactory(),
+                      std::make_unique<TestAnnotatorClient>());
+  TestImageProcessor first_processor;
+  TestImageProcessor retry_processor;
+  std::optional<mojom::AnnotateImageError> first_error;
+  std::optional<mojom::AnnotateImageError> retry_error;
+  std::vector<mojom::Annotation> first_annotations;
+  std::vector<mojom::Annotation> retry_annotations;
+  int first_completions = 0;
+  int retry_completions = 0;
+  annotator.AnnotateImage(
+      kImage1Url, kDescLang, first_processor.GetPendingRemote(),
+      base::BindOnce([&](mojom::AnnotateImageResultPtr result) {
+        ++first_completions;
+        ReportResult(&first_error, &first_annotations, std::move(result));
+        annotator.AnnotateImage(
+            kImage1Url, kDescLang, retry_processor.GetPendingRemote(),
+            base::BindOnce([&](mojom::AnnotateImageResultPtr retry_result) {
+              ++retry_completions;
+              ReportResult(&retry_error, &retry_annotations,
+                           std::move(retry_result));
+            }));
+      }));
+  test_task_env.RunUntilIdle();
+  ASSERT_THAT(first_processor.callbacks(), SizeIs(1));
+  std::move(first_processor.callbacks()[0]).Run({1, 2, 3}, kDescDim, kDescDim);
+  first_processor.callbacks().pop_back();
+  test_task_env.RunUntilIdle();
+  test_task_env.FastForwardBy(kThrottle);
+  const std::string request =
+      ReformatJson(base::StringPrintf(kTemplateRequest, kImage1Url, "AQID"));
+  test_url_factory.ExpectRequestAndSimulateResponse(
+      "annotation", {}, request, "", net::HTTP_INTERNAL_SERVER_ERROR);
+  test_task_env.RunUntilIdle();
+  EXPECT_EQ(first_completions, 1);
+  EXPECT_EQ(first_error, mojom::AnnotateImageError::kFailure);
+  EXPECT_THAT(first_annotations, IsEmpty());
+  EXPECT_EQ(retry_completions, 0);
+  ASSERT_THAT(retry_processor.callbacks(), SizeIs(1));
+  std::move(retry_processor.callbacks()[0]).Run({1, 2, 3}, kDescDim, kDescDim);
+  retry_processor.callbacks().pop_back();
+  test_task_env.RunUntilIdle();
+  test_task_env.FastForwardBy(kThrottle);
+  test_url_factory.ExpectRequestAndSimulateResponse(
+      "annotation", {}, request, kOcrSuccessResponse, net::HTTP_OK);
+  test_task_env.RunUntilIdle();
+  EXPECT_EQ(retry_completions, 1);
+  EXPECT_EQ(retry_error, std::nullopt);
+  EXPECT_THAT(retry_annotations,
+              UnorderedElementsAre(AnnotatorEq(mojom::AnnotationType::kOcr, 1.0,
+                                               "Region 1\nRegion 2")));
+  TestImageProcessor cached_processor;
+  int cached_completions = 0;
+  annotator.AnnotateImage(
+      kImage1Url, kDescLang, cached_processor.GetPendingRemote(),
+      base::BindOnce([&](mojom::AnnotateImageResultPtr result) {
+        ++cached_completions;
+        ASSERT_EQ(result->which(),
+                  mojom::AnnotateImageResult::Tag::kAnnotations);
+        EXPECT_THAT(result->get_annotations(), SizeIs(1));
+      }));
+  test_task_env.RunUntilIdle();
+  EXPECT_EQ(cached_completions, 1);
+  EXPECT_THAT(cached_processor.callbacks(), IsEmpty());
+  EXPECT_THAT(test_url_factory.requests(), IsEmpty());
+}
