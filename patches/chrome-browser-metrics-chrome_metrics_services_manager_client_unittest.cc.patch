+TEST_F(ChromeMetricsServicesManagerClientTest,
+       AndroidSeedFetchStaysAbsentWithOverridesAndCachedState) {
+  content::BrowserTaskEnvironment task_environment;
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitchASCII(
+      "variations-server-url", "https://example.invalid/seed");
+  command_line.GetProcessCommandLine()->AppendSwitchASCII(
+      "variations-seed-fetch-interval", "1");
+  metrics_services_manager::MetricsServicesManager manager(
+      std::make_unique<ChromeMetricsServicesManagerClient>(local_state()));
+  auto* service = manager.GetVariationsService();
+  ASSERT_NE(nullptr, service);
+  const std::string original_country =
+      local_state()->GetString(variations::prefs::kVariationsCountry);
+  const base::Time original_fetch_time =
+      local_state()->GetTime(variations::prefs::kVariationsLastFetchTime);
+  const base::Time cached_fetch_time = base::Time::Now() - base::Hours(1);
+  local_state()->SetString(variations::prefs::kVariationsCountry, "nz");
+  local_state()->SetTime(variations::prefs::kVariationsLastFetchTime,
+                         cached_fetch_time);
+  auto* cached_store = service->GetSeedStoreForTesting();
+  variations::VariationsService::EnableFetchForTesting();
+  service->PerformPreMainMessageLoopStartup();
+  service->OnAppEnterForeground();
+  service->StartRepeatedVariationsSeedFetchForTesting();
+  task_environment.RunUntilIdle();
+  EXPECT_EQ(0, service->request_count());
+  EXPECT_EQ(nullptr, service->GetResourceRequestAllowedNotifierForTesting());
+  EXPECT_TRUE(service->IsSeedFetchingPaused());
+  EXPECT_EQ(cached_store, service->GetSeedStoreForTesting());
+  EXPECT_EQ("nz", service->GetLatestCountry());
+  EXPECT_EQ(cached_fetch_time, service->GetLatestSeedFetchTime());
+  local_state()->SetString(variations::prefs::kVariationsCountry,
+                           original_country);
+  local_state()->SetTime(variations::prefs::kVariationsLastFetchTime,
+                         original_fetch_time);
+}
+#endif  // BUILDFLAG(IS_ANDROID)
