+TEST_F(ChromeMetricsServicesManagerClientTest,
+       AndroidRemoteServicesStayAbsentDuringStartupCallbacks) {
+  content::BrowserTaskEnvironment task_environment;
+  local_state()->SetBoolean(metrics::prefs::kMetricsReportingEnabled, true);
+  metrics_services_manager::MetricsServicesManager manager(
+      std::make_unique<ChromeMetricsServicesManagerClient>(local_state()));
+  manager.UpdateUploadPermissions(true);
+  manager.GetOnDidStartLoadingCb().Run();
+  manager.GetOnDidStopLoadingCb().Run();
+  manager.GetOnRendererUnresponsiveCb().Run();
+  EXPECT_EQ(nullptr, manager.GetMetricsService());
+  EXPECT_EQ(nullptr, manager.GetUkmService());
+  EXPECT_EQ(nullptr, manager.GetDwaService());
+  EXPECT_EQ(nullptr, manager.GetPumaService());
+  EXPECT_EQ(nullptr, manager.GetStructuredMetricsService());
+  for (auto type :
+       {metrics::MetricsLogUploader::UMA, metrics::MetricsLogUploader::UKM,
+        metrics::MetricsLogUploader::DWA,
+        metrics::MetricsLogUploader::PRIVATE_METRICS,
+        metrics::MetricsLogUploader::STRUCTURED_METRICS}) {
+    EXPECT_EQ(nullptr, manager.GetReportingService(type));
+  }
+  EXPECT_FALSE(manager.IsMetricsReportingEnabled());
+  EXPECT_FALSE(manager.IsMetricsConsentGiven());
+  EXPECT_FALSE(manager.IsUkmAllowedForAllProfiles());
+  EXPECT_FALSE(manager.IsDwaAllowedForAllProfiles());
+}
+
+TEST_F(ChromeMetricsServicesManagerClientTest,
+       AndroidLocalBeaconPreservesPriorShutdownForOomDecisions) {
+  content::BrowserTaskEnvironment task_environment;
+  metrics_services_manager::MetricsServicesManager manager(
+      std::make_unique<ChromeMetricsServicesManagerClient>(local_state()));
+  const bool previous_shutdown_clean = manager.WasLastShutdownClean();
+  manager.LogHasSessionShutdownCleanly(false);
+  EXPECT_FALSE(
+      local_state()->GetBoolean(metrics::prefs::kStabilityExitedCleanly));
+  EXPECT_EQ(previous_shutdown_clean, manager.WasLastShutdownClean());
+  manager.LogHasSessionShutdownCleanly(true);
+  EXPECT_TRUE(
+      local_state()->GetBoolean(metrics::prefs::kStabilityExitedCleanly));
+  EXPECT_EQ(previous_shutdown_clean, manager.WasLastShutdownClean());
+  EXPECT_EQ(nullptr, manager.GetMetricsService());
+}
+
+TEST_F(ChromeMetricsServicesManagerClientTest,
+       AndroidSyntheticRegistryPublishesLocalTrials) {
+  content::BrowserTaskEnvironment task_environment;
+  metrics_services_manager::MetricsServicesManager manager(
+      std::make_unique<ChromeMetricsServicesManagerClient>(local_state()));
+  auto* registry = manager.GetSyntheticTrialRegistry();
+  ASSERT_NE(nullptr, registry);
+  LocalTrialObserver observer;
+  base::ScopedObservation<variations::SyntheticTrialRegistry,
+                          variations::SyntheticTrialObserver>
+      observation(&observer);
+  observation.Observe(registry);
+  EXPECT_TRUE(LocalTrialAccessor::RegisterSyntheticFieldTrialForRegistry(
+      registry, "ReaperLocalStartupContract", "LocalOnly",
+      variations::SyntheticTrialAnnotationMode::kCurrentLog));
+  EXPECT_EQ(1, observer.notifications);
+  EXPECT_EQ("LocalOnly", observer.observed_group);
+  EXPECT_FALSE(registry->GetCurrentSyntheticFieldTrialsForTest().empty());
+  EXPECT_EQ(nullptr, manager.GetMetricsService());
+}
