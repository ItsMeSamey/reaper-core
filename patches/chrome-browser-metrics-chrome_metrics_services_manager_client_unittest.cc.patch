+namespace {
+class LocalTrialAccessor : public metrics::MetricsServiceAccessor {
+ public:
+  using MetricsServiceAccessor::RegisterSyntheticFieldTrialForRegistry;
+};
+
+class LocalTrialObserver : public variations::SyntheticTrialObserver {
+ public:
+  void OnSyntheticTrialsChanged(
+      const std::vector<variations::SyntheticTrialGroup>& updated,
+      const std::vector<variations::SyntheticTrialGroup>& removed,
+      const std::vector<variations::SyntheticTrialGroup>& groups) override {
+    ++notifications;
+    for (const auto& group : groups) {
+      if (group.trial_name() == "ReaperLocalStartupContract") {
+        observed_group = group.group_name();
+      }
+    }
+  }
+  int notifications = 0;
+  std::string observed_group;
+};
