+        const firstDelegate = new TestService();
+        const secondDelegate = new TestService();
+        let finishA: () => void = () => {};
+        let finishB: () => void = () => {};
+        const calls: string[] = [];
+        const loadError = {message: 'Expected first reload failure'};
+        firstDelegate.reloadItem = (id: string) => {
+          calls.push(id);
+          return new Promise<void>((resolve, reject) => {
+            finishA = failA ? () => reject(loadError) : resolve;
+          });
+        };
+        secondDelegate.reloadItem = (id: string) => {
+          calls.push(id);
+          return new Promise<void>(resolve => { finishB = resolve; });
+        };
+        item.delegate = firstDelegate;
+        second.delegate = secondDelegate;
+        document.body.appendChild(second);
+        await microtasksFinished();
+        const timer = new MockTimer();
+        timer.install();
+        try {
+          const first = item.reloadItem().then(
+              () => null, error => error);
+          const firstMarker = toast.$.content.lastChild!;
+          assertEquals(Node.COMMENT_NODE, firstMarker.nodeType);
+          const secondReload = second.reloadItem();
+          const secondMarker = toast.$.content.lastChild!;
+          assertEquals(Node.COMMENT_NODE, secondMarker.nodeType);
+          assertEquals(null, firstMarker.parentNode);
+          assertDeepEquals([item.data!.id, second.data!.id], calls);
+          assertTrue(toast.isToastOpen);
+          assertEquals(0, toast.duration);
+          if (finishBFirst) {
+            finishB();
+            await secondReload;
+            await toast.updateComplete;
+            await toast.$.toast.updateComplete;
+            const duration = toast.duration;
+            const elapsed = Math.floor(duration / 2);
+            assertTrue(elapsed > 0);
+            assertTrue(toast.isToastOpen);
+            const completedContent = toast.$.content.lastChild;
+            timer.tick(elapsed);
+            finishA();
+            assertEquals(failA ? loadError : null, await first);
+            await toast.updateComplete;
+            await toast.$.toast.updateComplete;
+            assertTrue(toast.isToastOpen, 'Stale A must not hide completed B');
+            assertEquals(duration, toast.duration);
+            assertEquals(completedContent, toast.$.content.lastChild);
+            assertEquals(loadTimeData.getString('itemReloaded'),
+                toast.$.content.textContent);
+            timer.tick(duration - elapsed - 1);
+            assertTrue(toast.isToastOpen);
+            timer.tick(1);
+            assertFalse(toast.isToastOpen, 'B retains its original auto-hide deadline');
+          } else {
+            finishA();
+            assertEquals(failA ? loadError : null, await first);
+            assertTrue(toast.isToastOpen, 'A must not hide B pending status');
+            assertEquals(0, toast.duration, 'A must not shorten B pending status');
+            assertEquals(secondMarker, toast.$.content.lastChild);
+            assertEquals(loadTimeData.getString('itemReloading'),
+                toast.$.content.textContent);
+            finishB();
+            await secondReload;
+            assertEquals(null, secondMarker.parentNode);
+            assertTrue(toast.isToastOpen);
+            assertTrue(toast.duration > 0);
+            assertEquals(loadTimeData.getString('itemReloaded'),
+                toast.$.content.textContent);
+          }
+        } finally {
+          toast.hide();
+          await toast.$.toast.updateComplete;
