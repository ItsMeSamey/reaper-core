+    const unpacked = createExtensionInfo(
+        {location: chrome.developerPrivate.Location.UNPACKED});
+    const corrupt = createStoreItemData();
+    corrupt.state = chrome.developerPrivate.ExtensionState.DISABLED;
+    corrupt.disableReasons.corruptInstall = true;
+    const terminated = createStoreItemData(
+        {state: chrome.developerPrivate.ExtensionState.TERMINATED});
+    const cases = [
+      {data: upload, devMode: false, control: '#account-upload-button'},
+      {data: unpacked, devMode: true, control: '#dev-reload-button'},
+      {data: corrupt, devMode: false, control: '#repair-button'},
+      {data: terminated, devMode: false, control: '#terminated-reload-button'},
+    ];
+    for (const entry of cases) {
+      entry.data.runtimeErrors = [createRuntimeError(entry.data.id)];
+      item.data = entry.data;
+      item.inDevMode = entry.devMode;
+      await microtasksFinished();
+      testVisible(item, '#errors-button', true);
+      testVisible(item, entry.control, true);
+      // Exercise long localized labels without depending on a UI locale.
+      for (const button of item.shadowRoot.querySelectorAll(
+               '#button-strip cr-button')) {
+        for (const node of button.childNodes) {
+          if (node.nodeType === Node.TEXT_NODE && node.textContent?.trim()) {
+            node.textContent = 'Extension action with a long localized label';
+          }
+        }
+      }
+      for (const fontSize of [13, 26]) {
+        item.style.fontSize = `${fontSize}px`;
+        for (const direction of ['ltr', 'rtl']) {
+          item.dir = direction;
+          const card = item.shadowRoot.querySelector<HTMLElement>('#card')!;
+          const bounds = card.getBoundingClientRect();
+          const controls = item.shadowRoot.querySelectorAll<HTMLElement>(
+              '#button-strip cr-button, #button-strip cr-icon-button, ' +
+              '#button-strip cr-toggle');
+          const rects: DOMRect[] = [];
+          for (const control of controls) {
+            const rect = control.getBoundingClientRect();
+            if (!rect.width || !rect.height) {
+              continue;
+            }
+            assertTrue(rect.left >= bounds.left && rect.right <= bounds.right);
+            assertTrue(rect.top >= bounds.top && rect.bottom <= bounds.bottom);
+            if (control.tagName !== 'CR-TOGGLE') {
+              assertTrue(rect.height >= 48);
+            }
+            if (control.tagName === 'CR-BUTTON') {
+              assertEquals(`${fontSize}px`, getComputedStyle(control).fontSize);
+            }
+            for (const other of rects) {
+              assertFalse(
+                  rect.left < other.right && rect.right > other.left &&
+                  rect.top < other.bottom && rect.bottom > other.top);
+            }
+            rects.push(rect);
+          }
+          assertTrue(rects.length >= 4);
+          assertTrue(card.scrollWidth <= card.clientWidth);
+        }
+      }
+    }
+  });
