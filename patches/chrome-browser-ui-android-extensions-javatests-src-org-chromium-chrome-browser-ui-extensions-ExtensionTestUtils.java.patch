 public class ExtensionTestUtils {
+    // Holds the actual shown model and manager. Tests never replace the Activity's
+    // manager or synthesize the native permission-completion callback.
+    private static final class InstallDialogHandle {
+        final ModalDialogManager manager;
+        final PropertyModel model;
+        final LinearLayout permissions;
+
+        InstallDialogHandle(
+                ModalDialogManager manager, PropertyModel model, LinearLayout permissions) {
+            this.manager = manager;
+            this.model = model;
+            this.permissions = permissions;
+        }
+    }
+
+    @CalledByNativeForTesting
+    private static @Nullable Object captureInstallDialogForTesting(
+            @JniType("content::WebContents*") WebContents sender) {
+        ThreadUtils.assertOnUiThread();
+        if (sender.isDestroyed()) return null;
+        WindowAndroid window = sender.getTopLevelNativeWindow();
+        if (window == null) return null;
+        ModalDialogManager manager = window.getModalDialogManager();
+        if (manager == null) return null;
+        PropertyModel model = manager.getCurrentDialogForTest();
+        if (model == null || model.get(ModalDialogProperties.TAB_MODAL_OWNER) != sender) {
+            return null;
+        }
+        View content = model.get(ModalDialogProperties.CUSTOM_VIEW);
+        if (content == null) return null;
+        LinearLayout permissions = content.findViewById(R.id.permissions_container);
+        if (permissions == null) return null;
+        return new InstallDialogHandle(manager, model, permissions);
+    }
+
+    @CalledByNativeForTesting
+    private static @JniType("std::vector<std::u16string>") String[]
+            getInstallDialogPermissionsForTesting(Object capturedDialog) {
+        ThreadUtils.assertOnUiThread();
+        InstallDialogHandle handle = (InstallDialogHandle) capturedDialog;
+        ArrayList<String> messages = new ArrayList<>();
+        for (int i = 0; i < handle.permissions.getChildCount(); ++i) {
+            TextView text =
+                    handle.permissions.getChildAt(i).findViewById(R.id.permission_item_text);
+            if (text != null) messages.add(text.getText().toString());
+        }
+        return messages.toArray(new String[0]);
+    }
+
+    @CalledByNativeForTesting
+    private static boolean clickInstallDialogForTesting(Object capturedDialog, boolean accept) {
+        ThreadUtils.assertOnUiThread();
+        InstallDialogHandle handle = (InstallDialogHandle) capturedDialog;
+        if (handle.manager.getCurrentDialogForTest() != handle.model) return false;
+        handle.model
+                .get(ModalDialogProperties.CONTROLLER)
+                .onClick(
+                        handle.model,
+                        accept
+                                ? ModalDialogProperties.ButtonType.POSITIVE
+                                : ModalDialogProperties.ButtonType.NEGATIVE);
+        return true;
+    }
+
+    @CalledByNativeForTesting
+    private static void dismissInstallDialogForTesting(Object capturedDialog) {
+        ThreadUtils.assertOnUiThread();
+        InstallDialogHandle handle = (InstallDialogHandle) capturedDialog;
+        // ModalDialogManager ignores an already-retired model. Never dismiss an
+        // unrelated current dialog while cleaning up a failed assertion.
+        handle.manager.dismissDialog(handle.model, DialogDismissalCause.UNKNOWN);
+    }
+
+    // Downloads uses an ordinary paragraph DialogModel, without an explicit tab owner.
+    // Keep this separate from the install helper's original-tab/custom-view checks.
+    private static final class DownloadOpenDialogHandle {
+        final ModalDialogManager manager;
+        final PropertyModel model;
+
+        DownloadOpenDialogHandle(ModalDialogManager manager, PropertyModel model) {
+            this.manager = manager;
+            this.model = model;
+        }
+    }
+
+    @CalledByNativeForTesting
+    private static @Nullable Object captureDownloadOpenDialogForTesting(
+            @JniType("content::WebContents*") WebContents sender,
+            @JniType("std::u16string") String expectedTitle,
+            boolean includePending) {
+        ThreadUtils.assertOnUiThread();
+        if (sender.isDestroyed()) return null;
+        WindowAndroid window = sender.getTopLevelNativeWindow();
+        if (window == null) return null;
+        ModalDialogManager manager = window.getModalDialogManager();
+        if (manager == null) return null;
+        DownloadOpenDialogHandle current =
+                matchDownloadOpenDialog(manager, manager.getCurrentDialogForTest(), expectedTitle);
+        if (current != null || !includePending) return current;
+        List<PropertyModel> pending =
+                manager.getPendingDialogsForTest(ModalDialogManager.ModalDialogType.TAB);
+        if (pending == null) return null;
+        for (PropertyModel model : pending) {
+            DownloadOpenDialogHandle match = matchDownloadOpenDialog(manager, model, expectedTitle);
+            if (match != null) return match;
+        }
+        return null;
+    }
+
+    private static @Nullable DownloadOpenDialogHandle matchDownloadOpenDialog(
+            ModalDialogManager manager, @Nullable PropertyModel model, String expectedTitle) {
+        if (model == null) return null;
+        CharSequence title = model.get(ModalDialogProperties.TITLE);
+        ArrayList<CharSequence> paragraphs = model.get(ModalDialogProperties.MESSAGE_PARAGRAPHS);
+        if (title == null
+                || !expectedTitle.contentEquals(title)
+                || model.get(ModalDialogProperties.CUSTOM_VIEW) != null
+                || paragraphs == null
+                || paragraphs.isEmpty()) {
+            return null;
+        }
+        return new DownloadOpenDialogHandle(manager, model);
+    }
+
+    @CalledByNativeForTesting
+    private static @JniType("std::vector<std::u16string>") String[]
+            getDownloadOpenDialogParagraphsForTesting(Object capturedDialog) {
+        ThreadUtils.assertOnUiThread();
+        DownloadOpenDialogHandle handle = (DownloadOpenDialogHandle) capturedDialog;
+        ArrayList<String> messages = new ArrayList<>();
+        for (CharSequence paragraph : handle.model.get(ModalDialogProperties.MESSAGE_PARAGRAPHS)) {
+            messages.add(paragraph.toString());
+        }
+        return messages.toArray(new String[0]);
+    }
+
+    @CalledByNativeForTesting
+    private static boolean clickDownloadOpenDialogForTesting(Object capturedDialog, boolean accept) {
+        ThreadUtils.assertOnUiThread();
+        DownloadOpenDialogHandle handle = (DownloadOpenDialogHandle) capturedDialog;
+        if (handle.manager.getCurrentDialogForTest() != handle.model) return false;
+        handle.model
+                .get(ModalDialogProperties.CONTROLLER)
+                .onClick(
+                        handle.model,
+                        accept
+                                ? ModalDialogProperties.ButtonType.POSITIVE
+                                : ModalDialogProperties.ButtonType.NEGATIVE);
+        return true;
+    }
+
+    @CalledByNativeForTesting
+    private static void dismissDownloadOpenDialogForTesting(Object capturedDialog) {
+        ThreadUtils.assertOnUiThread();
+        DownloadOpenDialogHandle handle = (DownloadOpenDialogHandle) capturedDialog;
+        handle.manager.dismissDialog(handle.model, DialogDismissalCause.UNKNOWN);
+    }
