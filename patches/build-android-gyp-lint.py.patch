+def _FilterLintStderr(output):
+    """Ignores only the parser cache's non-diagnostic JUL INFO record."""
+    pool_header = re.compile(
+        r'(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) '
+        r'(?:[1-9]|[12][0-9]|3[01]), [0-9]{4} '
+        r'(?:[1-9]|1[0-2]):[0-5][0-9]:[0-5][0-9] (?:AM|PM) '
+        r'com\.android\.utils\.PositionXmlParser\$SaxParserPool '
+        r'checkLimitWhenCreate\n')
+    pool_message = ('INFO: Maximum pool size reached in '
+                    'com.android.utils.PositionXmlParser\n')
+    lines = output.splitlines(keepends=True)
+    retained = []
+    index = 0
+    while index < len(lines):
+        if (index + 1 < len(lines) and pool_header.fullmatch(lines[index])
+                and lines[index + 1] == pool_message):
+            # The pinned pool code still creates/returns a parser after this log.
+            index += 2
+        else:
+            retained.append(lines[index])
+            index += 1
+    return build_utils.FilterReflectiveAccessJavaWarnings(''.join(retained))
+
+
+def _CreateLintManifest(android_manifest, source_manifests, output_path):
+    """Preserves existing lint annotations on the effective app declarations."""
+    android = '{http://schemas.android.com/apk/res/android}'
+    tools = '{http://schemas.android.com/tools}'
+    allowed = (tools + 'ignore', tools + 'targetApi')
+    merged = ElementTree.parse(android_manifest).getroot()
+    merged_package = merged.get('package', '')
+
+    def has_annotations(element):
+        return any(any(key in node.attrib for key in allowed)
+                   for node in element.iter())
+
+    def qualified_name(value, package):
+        if value.startswith('.'):
+            return package + value
+        return package + '.' + value if '.' not in value else value
+
+    def shape(element):
+        return (element.tag,
+                tuple(sorted((key, value) for key, value in element.attrib.items()
+                             if not key.startswith(tools))),
+                tuple(shape(child) for child in element))
+
+    def matches(source, target, package):
+        if source.tag != target.tag:
+            return False
+        name = source.get(android + 'name')
+        if name is not None:
+            return qualified_name(name, package) == qualified_name(
+                target.get(android + 'name', ''), merged_package)
+        if source.tag == 'intent-filter':
+            return shape(source) == shape(target)
+        return all(target.get(key) == value for key, value in source.attrib.items()
+                   if not key.startswith(tools))
+
+    def transfer(source, target, package, primary):
+        annotations = [(key, source.get(key)) for key in allowed
+                       if key in source.attrib]
+        if annotations and not primary and source.tag in ('manifest', 'application'):
+            raise ValueError('Dependency annotation would broaden app scope: '
+                             + source.tag)
+        for key, value in annotations:
+            previous = target.get(key)
+            if key == tools + 'ignore':
+                values = [item.strip() for group in (previous, value) if group
+                          for item in group.split(',') if item.strip()]
+                target.set(key, ','.join(dict.fromkeys(values)))
+            elif previous is not None and previous != value:
+                raise ValueError('Conflicting tools:targetApi annotation')
+            else:
+                target.set(key, value)
+        for child in source:
+            if not has_annotations(child):
+                continue
+            candidates = [node for node in target if matches(child, node, package)]
+            if len(candidates) != 1:
+                raise ValueError('No unique effective declaration for annotation: '
+                                 + child.tag + ' ' + child.get(android + 'name', ''))
+            transfer(child, candidates[0], package, primary)
+
+    for index, source_manifest in enumerate(source_manifests):
+        source = ElementTree.parse(source_manifest).getroot()
+        transfer(source, merged, source.get('package', ''), index == 0)
+    # Only this lint-owned copy is written. Packaging and source manifests stay intact.
+    _WriteXmlFile(merged, output_path)
+    return output_path
+
