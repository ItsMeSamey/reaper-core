+  CHECK(success_callback_);
+  const bool release_start_ref = RetireOperation(/*report_failure=*/false);
+  auto callback = std::move(success_callback_);
+  failure_callback_ = base::NullCallback();
+  std::move(callback).Run(id_);
+  if (release_start_ref) {
+    Release();  // Balanced in Start().
+  }
+#else
   CHECK(success_callback_);
   std::move(success_callback_).Run(id_);
   failure_callback_ = base::NullCallback();
   extension_registry_observation_.Reset();
 
   Release();  // Balanced in Start().
+#endif
