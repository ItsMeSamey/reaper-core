+#if BUILDFLAG(IS_ANDROID)
+bool WebstoreInstaller::RetireOperation(bool report_failure) {
+  completed_ = true;
+  const bool release_start_ref = std::exchange(start_ref_held_, false);
+  extension_registry_observation_.Reset();
+  content::BrowserContext* context = std::exchange(browser_context_, nullptr);
+  download_progress_timer_.Stop();
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  approval_.reset();
+  pending_modules_.clear();
+  crx_installer_.reset();
+
+  // Shutdown clears the context before arriving here. During ordinary failure,
+  // notify the tracker before callbacks or download cancellation can retire it.
+  if (report_failure && context) {
+    ExtensionsBrowserClient::Get()->GetInstallTracker(context)->OnInstallFailure(
+        id_);
+  }
+  // OnDownloadDestroyed can clear this member during the tracker notification.
+  if (download_item_) {
+    DownloadItem* item = std::exchange(download_item_, nullptr);
+    item->RemoveObserver(this);
+    if (item->GetState() == DownloadItem::IN_PROGRESS) {
+      item->Cancel(/*user_cancel=*/false);
+    }
+  }
+  return release_start_ref;
+}
+#endif
+
 void WebstoreInstaller::ReportFailure(const std::string& error,
                                       FailureReason reason) {
+#if BUILDFLAG(IS_ANDROID)
+  if (completed_) {
+    return;
+  }
+  scoped_refptr<WebstoreInstaller> keep_alive(this);
+  CHECK(failure_callback_);
+  const bool release_start_ref = RetireOperation(/*report_failure=*/true);
+  auto callback = std::move(failure_callback_);
+  success_callback_ = base::NullCallback();
+  std::move(callback).Run(id_, error, reason);
+  if (release_start_ref) {
+    Release();  // Balanced in Start().
+  }
+#else
   CHECK(failure_callback_);
   std::move(failure_callback_).Run(id_, error, reason);
   success_callback_ = base::NullCallback();
@@ -682,15 +846,31 @@
