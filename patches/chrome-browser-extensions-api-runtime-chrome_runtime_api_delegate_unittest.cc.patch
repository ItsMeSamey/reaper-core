+#if BUILDFLAG(IS_ANDROID)
+class RuntimeURLTestTabModel : public OwningTestTabModel {
+ public:
+  enum class Result { kAccept, kReject, kDestroyDuringCreation };
+
+  RuntimeURLTestTabModel(Profile* profile,
+                         TabModelType type = TabModelType::kStandard,
+                         Result result = Result::kAccept)
+      : OwningTestTabModel(profile,
+                           chrome::android::ActivityType::kTabbed,
+                           type),
+        result_(result) {}
+
+  tabs::TabInterface* CreateTab(TabAndroid* parent,
+                                std::unique_ptr<content::WebContents> contents,
+                                int index,
+                                TabLaunchType launch_type,
+                                bool should_pin) override {
+    ++creation_count;
+    last_contents = contents->GetWeakPtr();
+    if (result_ == Result::kReject) {
+      return nullptr;
+    }
+    tabs::TabInterface* tab = OwningTestTabModel::CreateTab(
+        parent, std::move(contents), index, launch_type, should_pin);
+    if (result_ == Result::kDestroyDuringCreation) {
+      // Simulate synchronous closure after the tab creator reports success.
+      // The delegate must not dereference either pointer after this callback.
+      ForceCloseAllTabs();
+    }
+    return tab;
+  }
+
+  int creation_count = 0;
+  base::WeakPtr<content::WebContents> last_contents;
+
+ private:
+  const Result result_;
+};
+
+using ChromeRuntimeAPIAndroidTest = ChromeRenderViewHostTestHarness;
+
+TEST_F(ChromeRuntimeAPIAndroidTest,
+       UninstallURLRequiresStandardMatchingProfile) {
+  Profile* incognito =
+      profile()->GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  RuntimeURLTestTabModel other_profile(incognito);
+  RuntimeURLTestTabModel archived(profile(), TabModel::TabModelType::kArchived);
+  RuntimeURLTestTabModel regular(profile());
+  std::unique_ptr<RuntimeAPIDelegate> delegate =
+      std::make_unique<ChromeRuntimeAPIDelegate>(profile());
+  const GURL uninstall_url("https://example.test/uninstalled");
+  delegate->OpenURL(uninstall_url);
+
+  EXPECT_EQ(0, other_profile.creation_count);
+  EXPECT_EQ(0, archived.creation_count);
+  EXPECT_EQ(1, regular.creation_count);
+  ASSERT_TRUE(regular.last_contents);
+  auto* entry = regular.last_contents->GetController().GetPendingEntry();
+  ASSERT_TRUE(entry);
+  EXPECT_EQ(uninstall_url, entry->GetURL());
+  EXPECT_EQ(profile(), regular.last_contents->GetBrowserContext());
+}
+
+TEST_F(ChromeRuntimeAPIAndroidTest, UninstallURLDoesNotUseNonstandardModel) {
+  RuntimeURLTestTabModel archived(profile(), TabModel::TabModelType::kArchived);
+  std::unique_ptr<RuntimeAPIDelegate> delegate =
+      std::make_unique<ChromeRuntimeAPIDelegate>(profile());
+  delegate->OpenURL(GURL("https://example.test/uninstalled"));
+  EXPECT_EQ(0, archived.creation_count);
+}
+
+TEST_F(ChromeRuntimeAPIAndroidTest, UninstallURLDoesNotUseOtherProfile) {
+  RuntimeURLTestTabModel incognito(
+      profile()->GetPrimaryOTRProfile(/*create_if_needed=*/true));
+  std::unique_ptr<RuntimeAPIDelegate> delegate =
+      std::make_unique<ChromeRuntimeAPIDelegate>(profile());
+  delegate->OpenURL(GURL("https://example.test/uninstalled"));
+  EXPECT_EQ(0, incognito.creation_count);
+}
+
+TEST_F(ChromeRuntimeAPIAndroidTest, UninstallURLCreationFailureIsSafe) {
+  for (auto result : {RuntimeURLTestTabModel::Result::kReject,
+                      RuntimeURLTestTabModel::Result::kDestroyDuringCreation}) {
+    RuntimeURLTestTabModel model(profile(), TabModel::TabModelType::kStandard,
+                                 result);
+    std::unique_ptr<RuntimeAPIDelegate> delegate =
+        std::make_unique<ChromeRuntimeAPIDelegate>(profile());
+    delegate->OpenURL(GURL("https://example.test/uninstalled"));
+    EXPECT_EQ(1, model.creation_count);
+    EXPECT_FALSE(model.last_contents);
+    EXPECT_EQ(0, model.GetTabCount());
+  }
+}
+
+TEST_F(ChromeRuntimeAPIAndroidTest, DevToolsUsesItsAttachedWindowSessionID) {
+  std::unique_ptr<RuntimeAPIDelegate> delegate =
+      std::make_unique<ChromeRuntimeAPIDelegate>(profile());
+  EXPECT_EQ(extension_misc::kUnknownWindowId,
+            delegate->GetDeveloperToolsWindowId(nullptr));
+  auto contents = CreateTestWebContents();
+  extensions::SetViewType(contents.get(),
+                          extensions::mojom::ViewType::kDeveloperTools);
+  EXPECT_EQ(extension_misc::kUnknownWindowId,
+            delegate->GetDeveloperToolsWindowId(contents.get()));
+  sessions::SessionTabHelper::CreateForWebContents(
+      contents.get(), sessions::SessionTabHelper::DelegateLookup());
+  auto tab = TabAndroid::CreateForTesting(profile(), 1234, std::move(contents));
+  const SessionID window_id = SessionID::NewUnique();
+  tab->SetWindowSessionID(window_id);
+  EXPECT_EQ(window_id.id(),
+            delegate->GetDeveloperToolsWindowId(tab->GetContents()));
+
+  // Reattachment changes the real session ID; no active-window cache is used.
+  const SessionID next_window_id = SessionID::NewUnique();
+  tab->SetWindowSessionID(next_window_id);
+  EXPECT_EQ(next_window_id.id(),
+            delegate->GetDeveloperToolsWindowId(tab->GetContents()));
+}
