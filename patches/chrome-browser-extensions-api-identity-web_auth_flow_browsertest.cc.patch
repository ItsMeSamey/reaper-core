+#if BUILDFLAG(IS_ANDROID)
+// Observe actual native window creation/destruction, including a popup that
+// closes inside its asynchronous creation callback before the test can poll.
+class PendingAuthPopupObserver : public BrowserCollectionObserver {
+ public:
+  explicit PendingAuthPopupObserver(Profile* profile) : profile_(profile) {
+    for (auto* browser : GetAllBrowserWindowInterfaces()) {
+      initial_windows_.push_back(browser->GetWeakPtr());
+      initial_ids_.insert(browser->GetSessionID().id());
+    }
+    observation_.Observe(GlobalBrowserCollection::GetInstance());
+  }
+
+  void OnBrowserCreated(BrowserWindowInterface* browser) override {
+    if (browser->GetProfile() != profile_ ||
+        browser->GetType() != BrowserWindowInterface::TYPE_POPUP ||
+        initial_ids_.contains(browser->GetSessionID().id())) {
+      return;
+    }
+    ++created_count_;
+    created_window_ = browser->GetWeakPtr();
+  }
+
+  bool CreatedPopupWasDestroyed() const {
+    return created_count_ == 1 && !created_window_;
+  }
+
+  int created_count() const { return created_count_; }
+  base::WeakPtr<BrowserWindowInterface> created_window() const {
+    return created_window_;
+  }
+
+  void ExpectInitialWindowsStillLive() const {
+    for (const auto& browser : initial_windows_) {
+      EXPECT_TRUE(browser);
+      if (browser) {
+        EXPECT_TRUE(initial_ids_.contains(browser->GetSessionID().id()));
+      }
+    }
+  }
+
+ private:
+  const raw_ptr<Profile> profile_;
+  std::set<int> initial_ids_;
+  std::vector<base::WeakPtr<BrowserWindowInterface>> initial_windows_;
+  int created_count_ = 0;
+  base::WeakPtr<BrowserWindowInterface> created_window_;
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      observation_{this};
+};
+
+// Hold the real pending Android task before Activity creation.
+// Releasing the hold runs the ordinary popup/Tab transfer and native callback.
+class WebAuthFlowPendingWindowAndroidBrowserTest
+    : public WebAuthFlowBrowserTest {
+ public:
+  void SetUpOnMainThread() override {
+    WebAuthFlowBrowserTest::SetUpOnMainThread();
+    for (auto* browser : GetAllBrowserWindowInterfaces()) {
+      initial_window_ids_.insert(browser->GetSessionID().id());
+    }
+    ASSERT_TRUE(HeldPendingTaskIds().empty());
+  }
+
+  void TearDownOnMainThread() override {
+    // Delete the flow before disposing only the test-held pending tasks.
+    // This cleanup also runs if an ASSERT failed with duplicate requests held.
+    if (web_auth_flow()) {
+      DeleteWebAuthFlow();
+    }
+    base::RunLoop().RunUntilIdle();
+    Java_BrowserWindowCreatorBridge_clearActivityCreationPauseForTesting(
+        base::android::AttachCurrentThread());
+
+    std::vector<base::WeakPtr<BrowserWindowInterface>> created_windows;
+    for (auto* browser : GetAllBrowserWindowInterfaces()) {
+      if (!initial_window_ids_.contains(browser->GetSessionID().id())) {
+        created_windows.push_back(browser->GetWeakPtr());
+      }
+    }
+    for (const auto& browser : created_windows) {
+      if (browser) {
+        browser->GetWindow()->Close();
+        EXPECT_TRUE(base::test::RunUntil([&browser] { return !browser; }));
+      }
+    }
+    WebAuthFlowBrowserTest::TearDownOnMainThread();
+  }
+
+  std::vector<int> HeldPendingTaskIds() {
+    JNIEnv* env = base::android::AttachCurrentThread();
+    std::vector<int> ids;
+    base::android::JavaIntArrayToIntVector(
+        env,
+        Java_BrowserWindowCreatorBridge_getHeldPendingTaskIdsForTesting(env),
+        &ids);
+    return ids;
+  }
+
+  void PauseActivityCreation() {
+    Java_BrowserWindowCreatorBridge_pauseActivityCreationForTesting(
+        base::android::AttachCurrentThread());
+  }
+
+  void StartHeldFlow(const GURL& url) {
+    PauseActivityCreation();
+    WebAuthFlowTestNavigationObserver navigation(url);
+    StartWebAuthFlow(url);
+    navigation.Wait();
+    ASSERT_TRUE(
+        base::test::RunUntil([this] { return !HeldPendingTaskIds().empty(); }));
+    ASSERT_EQ(1u, HeldPendingTaskIds().size());
+    ASSERT_TRUE(web_contents());
+  }
+
+  void ResumeAndWaitForPopup() {
+    ASSERT_TRUE(web_auth_flow());
+    const auto ids = HeldPendingTaskIds();
+    ASSERT_EQ(1u, ids.size());
+    base::test::TestFuture<void> displayed;
+    web_auth_flow()->SetPopupDisplayedCallbackForTesting(
+        displayed.GetCallback());
+    Java_BrowserWindowCreatorBridge_resumePendingTaskActivityCreationForTesting(
+        base::android::AttachCurrentThread(), ids.front());
+    ASSERT_TRUE(displayed.Wait());
+    ASSERT_TRUE(HeldPendingTaskIds().empty());
+  }
+
+  void ResumeAndWaitForClosedPopup(PendingAuthPopupObserver& observer) {
+    const auto ids = HeldPendingTaskIds();
+    ASSERT_EQ(1u, ids.size());
+    Java_BrowserWindowCreatorBridge_resumePendingTaskActivityCreationForTesting(
+        base::android::AttachCurrentThread(), ids.front());
+    ASSERT_TRUE(base::test::RunUntil(
+        [&observer] { return observer.CreatedPopupWasDestroyed(); }));
+    EXPECT_TRUE(HeldPendingTaskIds().empty());
+    observer.ExpectInitialWindowsStillLive();
+  }
+
+ private:
+  std::set<int> initial_window_ids_;
+};
