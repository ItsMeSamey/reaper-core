+IN_PROC_BROWSER_TEST_F(WebAuthFlowPendingWindowAndroidBrowserTest,
+                       PendingSecondNavigationTransfersOriginalContentsOnce) {
+  const size_t initial_windows = GetAllBrowserWindowInterfaces().size();
+  EXPECT_CALL(mock(), OnAuthFlowFailure(testing::_)).Times(0);
+  const GURL first_url = embedded_test_server()->GetURL("/title1.html");
+  ASSERT_NO_FATAL_FAILURE(StartHeldFlow(first_url));
+  const auto original = web_contents()->GetWeakPtr();
+  const auto held_ids = HeldPendingTaskIds();
+
+  const GURL second_url = embedded_test_server()->GetURL("/title2.html");
+  EXPECT_CALL(mock(), OnAuthFlowURLChange(second_url));
+  ASSERT_TRUE(content::NavigateToURLFromRenderer(original.get(), second_url));
+  ASSERT_TRUE(content::WaitForLoadStop(original.get()));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(held_ids, HeldPendingTaskIds());
+  EXPECT_EQ(initial_windows, GetAllBrowserWindowInterfaces().size());
+  ASSERT_TRUE(original);
+  ASSERT_EQ(original.get(), web_contents());
+
+  ASSERT_NO_FATAL_FAILURE(ResumeAndWaitForPopup());
+  ASSERT_TRUE(original);
+  auto* popup = browser_window_util::GetBrowserForTabContents(*original);
+  ASSERT_TRUE(popup);
+  EXPECT_EQ(BrowserWindowInterface::TYPE_POPUP, popup->GetType());
+  EXPECT_EQ(GetProfile(), popup->GetProfile());
+  EXPECT_EQ(initial_windows + 1, GetAllBrowserWindowInterfaces().size());
+  auto* tabs = TabListInterface::From(popup);
+  ASSERT_TRUE(tabs);
+  // The existing creator may bootstrap another tab before WebAuthFlow inserts
+  // the provider contents. This regression only promises one popup request and
+  // one transfer of the original contents, not removal of that bootstrap tab.
+  int original_contents_count = 0;
+  for (auto* tab : tabs->GetAllTabs()) {
+    if (tab->GetContents() == original.get()) {
+      ++original_contents_count;
+    }
+  }
+  EXPECT_EQ(1, original_contents_count);
+  EXPECT_EQ(original.get(), web_contents());
+  EXPECT_EQ(second_url, original->GetLastCommittedURL());
+}
