+IN_PROC_BROWSER_TEST_F(
+    WebAuthFlowPendingWindowAndroidBrowserTest,
+    PendingRealRegularProfileDestructionRetiresFlowAndRequest) {
+  // WebAuthFlow supports regular Profiles. Keep the live browser's Profile
+  // while this test independently owns and destroys another regular Profile.
+  ASSERT_FALSE(GetProfile()->IsOffTheRecord());
+  const size_t initial_windows = GetAllBrowserWindowInterfaces().size();
+  PendingAuthPopupObserver unrelated_windows(GetProfile());
+
+  // TestingProfile installs a new global fake facade. Preserve the effective
+  // facade of the running browser explicitly; native browsertests do not enable
+  // ResettersForTesting. The fixture-only generated JNI helper keeps this route
+  // reachable when the test APK is shrunk, without keeping production test APIs.
+  JNIEnv* env = base::android::AttachCurrentThread();
+  auto prior_facade = base::android::ScopedJavaGlobalRef<jobject>(
+      Java_WebAuthFlowTestBridge_getAccountManagerFacade(env));
+  ASSERT_FALSE(prior_facade.is_null());
+  base::ScopedClosureRunner restore_facade(base::BindOnce(
+      [](base::android::ScopedJavaGlobalRef<jobject> facade) {
+        Java_WebAuthFlowTestBridge_restoreAccountManagerFacade(
+            base::android::AttachCurrentThread(), facade);
+      },
+      std::move(prior_facade)));
+
+  // The ordinary network factory is null by default for TestingProfile. Install
+  // its actual public service before keyed-service initialization so navigation
+  // uses the real regular-profile context and declared factory dependencies.
+  TestingProfile::Builder builder;
+  builder.AddTestingFactory(
+      ProfileNetworkContextServiceFactory::GetInstance(),
+      base::BindOnce([](content::BrowserContext* context)
+                         -> std::unique_ptr<KeyedService> {
+        return std::make_unique<ProfileNetworkContextService>(
+            Profile::FromBrowserContext(context));
+      }));
+  auto owned_profile = builder.Build();
+  restore_facade.RunAndReset();
+  ASSERT_TRUE(owned_profile);
+  ASSERT_FALSE(owned_profile->IsOffTheRecord());
+  ASSERT_EQ(owned_profile.get(), owned_profile->GetOriginalProfile());
+  const auto profile_lifetime = owned_profile->GetWeakPtr();
+  base::ScopedClosureRunner cleanup_profile(base::BindOnce(
+      [](std::unique_ptr<TestingProfile>* owner,
+         base::WeakPtr<Profile> lifetime) {
+        if (*owner) {
+          ProfileDestroyer::DestroyOriginalProfileWhenAppropriate(
+              std::move(*owner));
+        }
+        EXPECT_TRUE(base::test::RunUntil([lifetime] { return !lifetime; }));
+      },
+      &owned_profile, profile_lifetime));
+  ASSERT_FALSE(owned_profile->GetJavaObject().is_null());
+  ASSERT_TRUE(ProfileNetworkContextServiceFactory::GetForContext(
+      owned_profile.get()));
+
+  EXPECT_CALL(mock(), OnAuthFlowFailure(testing::_)).Times(0);
+  PauseActivityCreation();
+  const GURL auth_url = embedded_test_server()->GetURL("/title1.html");
+  WebAuthFlowTestNavigationObserver navigation(auth_url);
+  StartWebAuthFlow(auth_url, WebAuthFlow::Mode::INTERACTIVE,
+                   owned_profile.get());
+  navigation.Wait();
+  ASSERT_TRUE(
+      base::test::RunUntil([this] { return !HeldPendingTaskIds().empty(); }));
+  ASSERT_EQ(1u, HeldPendingTaskIds().size());
+  ASSERT_TRUE(web_contents());
+  ASSERT_EQ(owned_profile.get(), web_contents()->GetBrowserContext());
+  const auto provider_contents = web_contents()->GetWeakPtr();
+  base::test::TestFuture<void> displayed;
+  web_auth_flow()->SetPopupDisplayedCallbackForTesting(displayed.GetCallback());
+
+  // Move the independently owned regular Profile into the real ordinary
+  // destroyer. Its Java notification cancels the exact pending native request
+  // before native ProfileObservers retire the auth flow. Never reuse its pointer.
+  ProfileDestroyer::DestroyOriginalProfileWhenAppropriate(
+      std::move(owned_profile));
+  EXPECT_TRUE(HeldPendingTaskIds().empty());
+  EXPECT_FALSE(provider_contents);
+  ASSERT_TRUE(web_auth_flow());
+  EXPECT_FALSE(web_contents());
+  EXPECT_FALSE(displayed.IsReady());
+  unrelated_windows.ExpectInitialWindowsStillLive();
+  EXPECT_EQ(initial_windows, GetAllBrowserWindowInterfaces().size());
+
+  // Notification alone is insufficient: wait for the Profile's actual object
+  // deletion, including renderer-deferred disposal, through its captured weak.
+  ASSERT_TRUE(base::test::RunUntil(
+      [profile_lifetime] { return !profile_lifetime; }));
+  EXPECT_TRUE(HeldPendingTaskIds().empty());
+  EXPECT_FALSE(displayed.IsReady());
+  unrelated_windows.ExpectInitialWindowsStillLive();
+  EXPECT_EQ(initial_windows, GetAllBrowserWindowInterfaces().size());
+  DeleteWebAuthFlow();
+  base::RunLoop().RunUntilIdle();
+}
