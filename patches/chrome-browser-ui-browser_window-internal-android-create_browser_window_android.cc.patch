+namespace {
+
+bool CanEnterAndroidBrowserFullscreen(Profile& profile) {
+  return !profile.ShutdownStarted() &&
+         profile.GetPrefs()->GetBoolean(prefs::kFullscreenAllowed);
+}
+
+std::string GetFullscreenExtensionDisplayName(
+    Profile& profile,
+    const std::string& extension_url) {
+  if (extension_url.empty()) {
+    return {};
+  }
+  constexpr UrlIdentity::TypeSet allowed_types = {
+      UrlIdentity::Type::kDefault, UrlIdentity::Type::kChromeExtension};
+  constexpr UrlIdentity::FormatOptions options{
+      .default_options = {
+          UrlIdentity::DefaultFormatOptions::kOmitCryptographicScheme}};
+  return base::UTF16ToUTF8(UrlIdentity::CreateFromUrl(&profile,
+                                                      GURL(extension_url),
+                                                      allowed_types, options)
+                               .name);
+}
+
+}  // namespace
+
+void SetAndroidBrowserWindowFullscreen(BrowserWindowInterface& browser_window,
+                                       bool fullscreen,
+                                       const std::string& extension_url) {
+  if (browser_window.IsDeleteScheduled() ||
+      (fullscreen &&
+       !CanEnterAndroidBrowserFullscreen(*browser_window.GetProfile()))) {
+    return;
+  }
+  // AndroidBrowserWindow is backed by this platform's AndroidBaseWindow. Keep
+  // the private implementation behind the existing public window API target.
+  static_cast<AndroidBaseWindow*>(browser_window.GetWindow())
+      ->SetFullscreen(fullscreen, extension_url,
+                      fullscreen
+                          ? GetFullscreenExtensionDisplayName(
+                                *browser_window.GetProfile(), extension_url)
+                          : std::string());
+}
