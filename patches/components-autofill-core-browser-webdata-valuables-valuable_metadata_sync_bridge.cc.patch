+#if BUILDFLAG(IS_ANDROID)
+bool ValuableMetadataSyncBridge::IsLoyaltyCardMetadata(
+    const sync_pb::AutofillValuableMetadataSpecifics& specifics) const {
+  if (specifics.pass_type() ==
+      sync_pb::AutofillValuableMetadataSpecifics::LOYALTY_CARD) {
+    return true;
+  }
+  if (specifics.pass_type() !=
+          sync_pb::AutofillValuableMetadataSpecifics::PASS_TYPE_UNSPECIFIED ||
+      !web_data_backend_ || !web_data_backend_->GetDatabase()) {
+    return false;
+  }
+  ValuablesTable* table =
+      ValuablesTable::FromWebDatabase(web_data_backend_->GetDatabase());
+  return table && table->GetLoyaltyCardById(ValuableId(specifics.valuable_id()))
+                      .has_value();
+}
+#endif  // BUILDFLAG(IS_ANDROID)
 
