+TEST(UkmEntryBuilderTest, AndroidMetricUpdatesDoNotAllocateAnEntry) {
+  UkmEntryBuilder builder(ConvertToSourceId(1, SourceIdType::NAVIGATION_ID),
+                          "Kangaroo.Jumped");
+  EXPECT_TRUE(builder.GetEntryForTesting().is_null());
+  builder.SetMetric("Length", 4);
+  builder.SetMetric("Length", 5);
+  EXPECT_TRUE(builder.GetEntryForTesting().is_null());
+  EXPECT_TRUE(builder.TakeEntry().is_null());
+  EXPECT_TRUE(builder.TakeEntry().is_null());
+}
+
+TEST(UkmEntryBuilderTest, AndroidRecordNeverCallsTheRecorder) {
+  testing::StrictMock<MockUkmRecorder> recorder;
+  UkmEntryBuilder builder(ConvertToSourceId(2, SourceIdType::NAVIGATION_ID),
+                          "Kangaroo.Jumped");
+  builder.SetMetric("Length", 4);
+  builder.Record(&recorder);
+  builder.Record(&recorder);
+  EXPECT_TRUE(builder.GetEntryForTesting().is_null());
+  EXPECT_TRUE(builder.TakeEntry().is_null());
+}
