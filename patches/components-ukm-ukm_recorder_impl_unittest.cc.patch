+#if BUILDFLAG(IS_ANDROID)
+TEST(UkmRecorderImplTest, AndroidDelegatingRecorderDoesNotRegisterOrCollect) {
+  base::test::TaskEnvironment env;
+  TestAutoSetUkmRecorder first;
+  TestAutoSetUkmRecorder second;
+  EXPECT_FALSE(DelegatingUkmRecorder::Get()->HasMultipleDelegates());
+
+  const SourceId id =
+      SourceIdObj::FromOtherId(UkmRecorder::GetNewSourceID(),
+                              SourceIdType::PAYMENT_APP_ID)
+          .ToInt64();
+  ASSERT_NE(kInvalidSourceId, id);
+  TestRecordingHelper(UkmRecorder::Get())
+      .UpdateSourceURL(id, GURL("https://example.com"));
+  TestEvent1(id).SetCpuTime(1).Record(UkmRecorder::Get());
+  env.RunUntilIdle();
+
+  EXPECT_TRUE(first.GetSources().empty());
+  EXPECT_TRUE(second.GetSources().empty());
+  EXPECT_EQ(0u, first.entries_count());
+  EXPECT_EQ(0u, second.entries_count());
+}
