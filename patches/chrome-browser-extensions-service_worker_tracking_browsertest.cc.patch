+#if BUILDFLAG(IS_ANDROID)
+int g_initialized_platform_info_runs = 0;
+
+// Inspects the real immediate API registration and then runs its original body.
+class InitializedPlatformInfoFunction : public RuntimeGetPlatformInfoFunction {
+ private:
+  ~InitializedPlatformInfoFunction() override = default;
+
+  ResponseAction Run() override {
+    ++g_initialized_platform_info_runs;
+    EXPECT_TRUE(worker_id());
+    ProcessManager* pm = ProcessManager::Get(browser_context());
+    const auto workers = pm->GetServiceWorkersForExtension(extension()->id());
+    EXPECT_EQ(1u, workers.size());
+    if (workers.size() == 1) {
+      EXPECT_TRUE(workers[0].start_token);
+      size_t matching_records = 0;
+      for (const auto& record :
+           pm->GetServiceWorkerKeepaliveDataForRecords(extension()->id())) {
+        if (record.activity_type == Activity::API_FUNCTION &&
+            record.extra_data == "runtime.getPlatformInfo") {
+          ++matching_records;
+          EXPECT_EQ(workers[0], record.worker_id);
+          EXPECT_TRUE(record.worker_id.start_token == workers[0].start_token);
+        }
+      }
+      EXPECT_EQ(1u, matching_records);
+    }
+    return RuntimeGetPlatformInfoFunction::Run();
+  }
+};
+#endif
 
