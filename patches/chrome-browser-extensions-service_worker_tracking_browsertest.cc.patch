+#if BUILDFLAG(IS_ANDROID)
+IN_PROC_BROWSER_TEST_F(ServiceWorkerTrackingBrowserTest,
+                       ApiKeepaliveCapturesInitializedWorkerToken) {
+  auto sw_host_factory_callback = base::BindRepeating(
+      [](content::RenderProcessHost* render_process_host,
+         mojo::PendingAssociatedReceiver<mojom::ServiceWorkerHost> receiver)
+          -> std::unique_ptr<ServiceWorkerHost> {
+        return std::make_unique<ServiceWorkerHostNoStartNotification>(
+            render_process_host, std::move(receiver));
+      });
+  auto sw_host_factory =
+      ServiceWorkerHost::SetFactoryForTesting(&sw_host_factory_callback);
+
+  auto& registry = ExtensionFunctionRegistry::GetInstance();
+  const auto original =
+      registry.GetFactoriesForTesting().at("runtime.getPlatformInfo");
+  ASSERT_TRUE(registry.OverrideFunctionForTesting(
+      "runtime.getPlatformInfo",
+      &NewExtensionFunction<InitializedPlatformInfoFunction>));
+  base::ScopedClosureRunner restore_factory(base::BindOnce(
+      [](ExtensionFunctionRegistry::FactoryEntry entry) {
+        ExtensionFunctionRegistry::GetInstance().Register(entry);
+      },
+      original));
+  base::AutoReset<int> reset_runs(&g_initialized_platform_info_runs, 0);
+
+  TestExtensionDir test_dir;
+  test_dir.WriteManifest(R"({
+    "name": "Initialized API accounting",
+    "manifest_version": 3,
+    "version": "1.0",
+    "background": {"service_worker": "background.js"}
+  })");
+  test_dir.WriteFile(FILE_PATH_LITERAL("background.js"), R"(
+    chrome.runtime.getPlatformInfo(() => {
+      chrome.test.assertNoLastError();
+      chrome.test.sendMessage('initialized API completed');
+    });
+  )");
+  ExtensionTestMessageListener completed("initialized API completed");
+  const Extension* extension = LoadExtension(
+      test_dir.UnpackedPath(),
+      {.wait_for_renderers = false, .wait_for_registration_stored = true});
+  ASSERT_TRUE(extension);
+  extension_ = extension;
+  ASSERT_TRUE(completed.WaitUntilSatisfied());
+  EXPECT_EQ(1, g_initialized_platform_info_runs);
+  ServiceWorkerState* worker_state = GetWorkerState();
+  ASSERT_TRUE(worker_state);
+  EXPECT_EQ(ServiceWorkerState::RendererState::kInitialized,
+            worker_state->renderer_state());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(ProcessManager::Get(profile())
+                  ->GetServiceWorkerKeepaliveDataForRecords(extension->id())
+                  .empty());
+  browsertest_util::StopServiceWorkerForExtensionGlobalScope(profile(),
+                                                            extension->id());
+}
+#endif
