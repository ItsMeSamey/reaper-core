+    @Test
+    public void fullscreenRequestIsIndependentOfOrdinaryFocusAndConsumedOnce() {
+        mManager.requestFullscreen(true);
+        mManager.requestAction(PendingAction.SHOW_INACTIVE);
+        assertEquals(true, mManager.getFullscreenRequest());
+        assertEquals(true, mManager.takeFullscreenRequest());
+        assertNull(mManager.takeFullscreenRequest());
+        assertEquals(PendingAction.NONE, mManager.getPendingActionsForTesting()[0]);
+        assertEquals(PendingAction.SHOW_INACTIVE, mManager.getPendingActionsForTesting()[1]);
+    }
+
+    @Test
+    public void maximizeAndRestoreOverridePendingFullscreenRequest() {
+        mManager.requestFullscreen(true);
+        mManager.requestMaximize();
+        assertEquals(false, mManager.getFullscreenRequest());
+        mManager.requestFullscreen(true);
+        mManager.requestRestore(TEST_SET_BOUNDS_INPUT_1);
+        assertEquals(false, mManager.takeFullscreenRequest());
+        assertEquals(PendingAction.RESTORE, mManager.getPendingActionsForTesting()[0]);
+        assertEquals(TEST_SET_BOUNDS_INPUT_1, mManager.getFutureBoundsInDp());
+    }
