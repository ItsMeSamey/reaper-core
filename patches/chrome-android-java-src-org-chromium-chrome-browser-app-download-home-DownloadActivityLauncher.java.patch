+    /**
+     * Reveals an authorized item in the browser's Downloads UI. The native caller owns a deadline
+     * and must cancel the returned request if its extension context shuts down.
+     */
+    public long showDownloadItem(
+            Activity host, Profile itemProfile, ContentId id, Callback<Boolean> completion) {
+        ThreadUtils.assertOnUiThread();
+        if (host.isFinishing()
+                || host.isDestroyed()
+                || ApplicationStatus.getStateForActivity(host) != ActivityState.RESUMED
+                || !isRevealProfileAvailable(itemProfile)) {
+            completion.onResult(false);
+            return 0;
+        }
+        long token = mNextRevealRequest++;
+        if (token == 0) token = mNextRevealRequest++;
+        RevealRequest request = new RevealRequest(token, itemProfile, id, completion);
+        mRevealRequests.put(token, request);
+        ProfileManager.addObserver(request);
+        Intent intent = new Intent(host, DownloadActivity.class);
+        intent.putExtra(EXTRA_REVEAL_REQUEST, token);
+        OtrProfileId otrProfileId = itemProfile.getOtrProfileId();
+        if (otrProfileId != null) {
+            intent.putExtra(
+                    DownloadUtils.EXTRA_OTR_PROFILE_ID, OtrProfileId.serialize(otrProfileId));
+        }
+        try {
+            // A fresh internal Activity gives each reveal its own profile and lifetime, on both
+            // phones and tablets. Do not reuse a differently profiled SINGLE_TOP Activity.
+            host.startActivity(intent);
+        } catch (ActivityNotFoundException | SecurityException exception) {
+            finishReveal(request, false);
+            return 0;
+        }
+        return token;
+    }
