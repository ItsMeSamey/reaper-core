+#if BUILDFLAG(IS_ANDROID)
+// Android display leases are restricted to foreground windows; CPU leases use
+// the platform's normal wake-lock contract and never bypass device policy.
+class AndroidPowerDelegate {
+ public:
+  virtual ~AndroidPowerDelegate() = default;
+  // Transactional acquisition errors leave the previous aggregate unchanged.
+  // Nontransactional removal must revoke no-longer-requested resources before
+  // acquiring any remaining lease. New display requests require a foreground
+  // window; existing requests may wait for one to return.
+  virtual std::optional<std::string> Apply(bool system,
+                                           bool display,
+                                           bool require_foreground_display,
+                                           bool transactional) = 0;
+  virtual void Cancel() = 0;
+};
+#endif
 
