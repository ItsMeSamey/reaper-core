+#if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
+class ExtensionWindowFullscreenAndroidBrowserTest
+    : public CreateBrowserWindowAndroidBrowserTest {
+ protected:
+  std::optional<std::string> GetWindowState(BrowserWindowInterface* window) {
+    auto function = base::MakeRefCounted<extensions::WindowsGetFunction>();
+    function->set_extension(extension_);
+    base::ListValue args;
+    args.Append(window->GetSessionID().id());
+    auto result = extensions::api_test_utils::RunFunctionAndReturnSingleResult(
+        function, std::move(args), GetProfile());
+    if (!result || !result->is_dict()) {
+      return std::nullopt;
+    }
+    const std::string* state = result->GetDict().FindString("state");
+    return state ? std::make_optional(*state) : std::nullopt;
+  }
+
+  bool UpdateWindowState(BrowserWindowInterface* window,
+                         const std::string& state) {
+    auto function = base::MakeRefCounted<extensions::WindowsUpdateFunction>();
+    function->set_extension(extension_);
+    base::ListValue args;
+    args.Append(window->GetSessionID().id());
+    args.Append(base::DictValue().Set("state", state));
+    auto result = extensions::api_test_utils::RunFunctionAndReturnSingleResult(
+        function, std::move(args), GetProfile());
+    return result && result->is_dict() &&
+           result->GetDict().FindInt("id") == window->GetSessionID().id();
+  }
+
+  std::optional<base::Value> CreateWindowWithApi(const std::string& type) {
+    auto function = base::MakeRefCounted<extensions::WindowsCreateFunction>();
+    function->set_extension(extension_);
+    base::ListValue args;
+    args.Append(base::DictValue().Set("type", type).Set("state", "fullscreen"));
+    return extensions::api_test_utils::RunFunctionAndReturnSingleResult(
+        function, std::move(args), GetProfile());
+  }
+
+  BrowserWindowInterface* FindWindowById(int id) {
+    for (auto* window : GetAllBrowserWindowInterfaces()) {
+      if (window->GetProfile() == GetProfile() &&
+          window->GetSessionID().id() == id) {
+        return window;
+      }
+    }
+    return nullptr;
+  }
+
+ private:
+  scoped_refptr<const extensions::Extension> extension_ =
+      extensions::ExtensionBuilder("Reaper fullscreen window provider")
+          .SetManifestVersion(3)
+          .Build();
+};
+
+IN_PROC_BROWSER_TEST_F(ExtensionWindowFullscreenAndroidBrowserTest,
+                       FullscreenCreate_GetAndUpdateUseRegisteredRealWindow) {
+  auto* window = CreateBrowserWindowAsync(
+      BrowserWindowInterface::TYPE_NORMAL, GetProfile(),
+      ui::mojom::WindowShowState::kFullscreen);
+  ASSERT_NE(window, nullptr);
+  auto cleanup = CloseCreatedWindowOnExit(window);
+  ASSERT_NE(extensions::BrowserExtensionWindowController::From(window),
+            nullptr);
+  EXPECT_EQ(GetWindowState(window), "fullscreen");
+  ASSERT_TRUE(UpdateWindowState(window, "normal"));
+  EXPECT_FALSE(window->GetWindow()->IsFullscreen());
+  EXPECT_EQ(GetWindowState(window), "normal");
+  ASSERT_TRUE(UpdateWindowState(window, "fullscreen"));
+  EXPECT_TRUE(window->GetWindow()->IsFullscreen());
+  EXPECT_EQ(GetWindowState(window), "fullscreen");
+}
+
+IN_PROC_BROWSER_TEST_F(
+    ExtensionWindowFullscreenAndroidBrowserTest,
+    FullscreenPolicyDeniesEntryButAlwaysAllowsRealWindowExit) {
+  auto* window = CreateBrowserWindowAsync(
