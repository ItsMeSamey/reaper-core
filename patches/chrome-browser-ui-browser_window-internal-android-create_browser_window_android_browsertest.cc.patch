+class ContentsDestroyedObserver : public content::WebContentsObserver {
+ public:
+  ContentsDestroyedObserver(content::WebContents* contents, bool& destroyed)
+      : content::WebContentsObserver(contents), destroyed_(destroyed) {}
+
+  void WebContentsDestroyed() override { destroyed_ = true; }
+
+ private:
+  bool& destroyed_;
+};
 }  // namespace
 
