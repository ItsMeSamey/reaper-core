+  base::ScopedClosureRunner restore(base::BindLambdaForTesting([&] {
+    profile->GetPrefs()->SetBoolean(prefs::kFullscreenAllowed, old_allowed);
+  }));
+  profile->GetPrefs()->SetBoolean(prefs::kFullscreenAllowed, false);
+  ASSERT_TRUE(UpdateWindowState(window, "normal"));
+  EXPECT_FALSE(window->GetWindow()->IsFullscreen());
+  EXPECT_EQ(GetWindowState(window), "normal");
+  ASSERT_TRUE(UpdateWindowState(window, "fullscreen"));
+  EXPECT_FALSE(window->GetWindow()->IsFullscreen());
+  EXPECT_EQ(GetWindowState(window), "normal");
+}
+
+IN_PROC_BROWSER_TEST_F(
+    ExtensionWindowFullscreenAndroidBrowserTest,
+    NormalWindowUpdateExitsActualDomFullscreenAndPreservesBrowserQuery) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  auto* window = CreateBrowserWindowAsync(BrowserWindowInterface::TYPE_NORMAL,
+                                          GetProfile());
+  ASSERT_NE(window, nullptr);
+  auto cleanup = CloseCreatedWindowOnExit(window);
+  auto* tabs = TabListInterface::From(window);
+  ASSERT_NE(tabs, nullptr);
+  ASSERT_NE(tabs->GetActiveTab(), nullptr);
+  content::WebContents* contents = tabs->GetActiveTab()->GetContents();
+  ASSERT_TRUE(content::NavigateToURL(
+      contents, embedded_test_server()->GetURL("/empty.html")));
+  ASSERT_EQ(content::EvalJs(contents, R"(
+    document.documentElement.requestFullscreen().then(
+        () => document.fullscreenElement !== null);
+  )"),
+            true);
+  EXPECT_TRUE(window->GetWindow()->IsFullscreen());
+  EXPECT_EQ(GetWindowState(window), "fullscreen");
+  ASSERT_TRUE(content::ExecJs(contents, R"(
+    window.reaperFullscreenExit = new Promise(resolve => {
+      document.addEventListener('fullscreenchange', () => {
+        if (!document.fullscreenElement) resolve(true);
+      }, {once: true});
+    });
+  )"));
+  ASSERT_TRUE(UpdateWindowState(window, "normal"));
+  EXPECT_EQ(content::EvalJs(contents, "window.reaperFullscreenExit"), true);
+  EXPECT_EQ(content::EvalJs(contents, "document.fullscreenElement === null"),
+            true);
+  EXPECT_FALSE(window->GetWindow()->IsFullscreen());
+  EXPECT_EQ(GetWindowState(window), "normal");
+}
+
+IN_PROC_BROWSER_TEST_F(
+    ExtensionWindowFullscreenAndroidBrowserTest,
+    WindowsCreateFullscreenNormalAndPopup_ReportAppliedStateAtCompletion) {
+  for (const std::string type : {"normal", "popup"}) {
+    std::set<int> existing_ids;
+    for (auto* window : GetAllBrowserWindowInterfaces()) {
+      existing_ids.insert(window->GetSessionID().id());
+    }
+    auto result = CreateWindowWithApi(type);
+    ASSERT_TRUE(result);
+    ASSERT_TRUE(result->is_dict());
+    auto id = result->GetDict().FindInt("id");
+    ASSERT_TRUE(id);
+    ASSERT_FALSE(existing_ids.contains(*id));
+    auto* window = FindWindowById(*id);
+    ASSERT_NE(window, nullptr);
+    auto cleanup = CloseCreatedWindowOnExit(window);
+    EXPECT_EQ(window->GetType(), type == "normal"
+                                     ? BrowserWindowInterface::TYPE_NORMAL
+                                     : BrowserWindowInterface::TYPE_POPUP);
+    ASSERT_NE(extensions::BrowserExtensionWindowController::From(window),
+              nullptr);
+    const std::string* state = result->GetDict().FindString("state");
+    ASSERT_NE(state, nullptr);
+    EXPECT_EQ(*state, "fullscreen");
+    EXPECT_TRUE(window->GetWindow()->IsFullscreen());
+    EXPECT_EQ(GetWindowState(window), "fullscreen");
+    ASSERT_TRUE(UpdateWindowState(window, "normal"));
+    EXPECT_FALSE(window->GetWindow()->IsFullscreen());
+    EXPECT_EQ(GetWindowState(window), "normal");
+  }
+}
+#endif  // BUILDFLAG(ENABLE_EXTENSIONS_CORE)
