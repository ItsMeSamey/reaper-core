+IN_PROC_BROWSER_TEST_F(
+    CreateBrowserWindowAndroidBrowserTest,
+    CreateBrowserWindowSync_FullscreenPolicyDenial_RetiresOwnedContents) {
+  Profile* profile = GetProfile();
+  const bool old_allowed =
+      profile->GetPrefs()->GetBoolean(prefs::kFullscreenAllowed);
+  base::ScopedClosureRunner restore(base::BindLambdaForTesting([&] {
+    profile->GetPrefs()->SetBoolean(prefs::kFullscreenAllowed, old_allowed);
+  }));
+  profile->GetPrefs()->SetBoolean(prefs::kFullscreenAllowed, false);
+  auto contents =
+      content::WebContents::Create(content::WebContents::CreateParams(profile));
+  bool destroyed = false;
+  ContentsDestroyedObserver observer(contents.get(), destroyed);
+  BrowserWindowCreateParams params(BrowserWindowInterface::TYPE_NORMAL,
+                                   *profile, false);
+  params.initial_show_state = ui::mojom::WindowShowState::kFullscreen;
+  params.web_contents = std::move(contents);
+  EXPECT_EQ(CreateBrowserWindow(std::move(params)), nullptr);
+  EXPECT_TRUE(destroyed);
+}
+
+IN_PROC_BROWSER_TEST_F(
+    CreateBrowserWindowAndroidBrowserTest,
+    CreateBrowserWindowAsync_FullscreenPolicyDenial_CompletesOnceAsynchronously) {
+  Profile* profile = GetProfile();
+  const bool old_allowed =
+      profile->GetPrefs()->GetBoolean(prefs::kFullscreenAllowed);
+  base::ScopedClosureRunner restore(base::BindLambdaForTesting([&] {
+    profile->GetPrefs()->SetBoolean(prefs::kFullscreenAllowed, old_allowed);
+  }));
+  profile->GetPrefs()->SetBoolean(prefs::kFullscreenAllowed, false);
+  auto contents =
+      content::WebContents::Create(content::WebContents::CreateParams(profile));
+  bool destroyed = false;
+  ContentsDestroyedObserver observer(contents.get(), destroyed);
+  BrowserWindowCreateParams params(BrowserWindowInterface::TYPE_POPUP, *profile,
+                                   false);
+  params.initial_show_state = ui::mojom::WindowShowState::kFullscreen;
+  params.web_contents = std::move(contents);
+  base::test::TestFuture<BrowserWindowInterface*> future;
+  int completions = 0;
+  CreateBrowserWindow(std::move(params),
+                      base::BindLambdaForTesting([&](BrowserWindowInterface* window) {
+                        ++completions;
+                        future.SetValue(window);
+                      }));
+  EXPECT_EQ(completions, 0);
+  EXPECT_TRUE(destroyed);
+  EXPECT_EQ(future.Get(), nullptr);
+  EXPECT_EQ(completions, 1);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(completions, 1);
+}
