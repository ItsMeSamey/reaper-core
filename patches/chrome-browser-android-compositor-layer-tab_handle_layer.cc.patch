+void TabHandleLayer::SetContainerMarker(SkColor color, float thickness) {
+  const gfx::Size bounds = decoration_tab_->bounds();
+  if (SkColorGetA(color) != 255 || !std::isfinite(thickness) || thickness <= 0 ||
+      bounds.height() < 2 || bounds.width() <= 0) {
+    container_marker_->SetIsDrawable(false);
+    return;
+  }
+  // Limit the rounded height before multiplying the inset. Double represents
+  // every gfx::Size integer exactly, so rounding cannot escape the integer cap.
+  const int max_height = std::min(bounds.height() / 2, bounds.width() / 4);
+  if (max_height <= 0) {
+    container_marker_->SetIsDrawable(false);
+    return;
+  }
+  const int height = static_cast<int>(std::ceil(std::min(
+      static_cast<double>(thickness), static_cast<double>(max_height))));
+  const int inset = height * 2;
+  const int width = std::max(0, bounds.width() - inset * 2);
+  container_marker_->SetIsDrawable(height > 0 && width > 0);
+  if (height <= 0 || width <= 0) return;
+  container_marker_->SetBackgroundColor(SkColor4f::FromColor(color));
+  container_marker_->SetBounds(gfx::Size(width, height));
+  container_marker_->SetPosition(gfx::PointF(inset, height));
+  container_marker_->SetRoundedCorner(gfx::RoundedCornersF(height * 0.5f));
+}
