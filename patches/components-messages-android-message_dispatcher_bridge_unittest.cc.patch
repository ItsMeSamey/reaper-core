+TEST(MessageDispatcherBridgeTest,
+     DispatcherObserverLeaseUsesFirstAndLastSubscriber) {
+  MessageDispatcherBridgeForTesting bridge;
+  auto first = bridge.AddDispatcherChangedCallback(base::BindRepeating([] {}));
+  auto second = bridge.AddDispatcherChangedCallback(base::BindRepeating([] {}));
+  EXPECT_EQ(bridge.notifications_enabled, std::vector<bool>({true}));
+  first = {};
+  EXPECT_EQ(bridge.notifications_enabled, std::vector<bool>({true}));
+  second = {};
+  EXPECT_EQ(bridge.notifications_enabled, std::vector<bool>({true, false}));
+}
+
+TEST(MessageDispatcherBridgeTest,
+     DispatcherChangesReachOnlySubscribedCallbacks) {
+  MessageDispatcherBridgeForTesting bridge;
+  int first_count = 0;
+  int second_count = 0;
+  auto first = bridge.AddDispatcherChangedCallback(
+      base::BindRepeating([](int* count) { ++*count; }, &first_count));
+  auto second = bridge.AddDispatcherChangedCallback(
+      base::BindRepeating([](int* count) { ++*count; }, &second_count));
+  EXPECT_EQ(first_count, 0);
+  EXPECT_EQ(second_count, 0);
+  bridge.NotifyDispatcherChanged();
+  EXPECT_EQ(first_count, 1);
+  EXPECT_EQ(second_count, 1);
+  first = {};
+  bridge.NotifyDispatcherChanged();
+  EXPECT_EQ(first_count, 1);
+  EXPECT_EQ(second_count, 2);
+}
+
+TEST(MessageDispatcherBridgeTest,
+     DispatcherSubscriptionCanEndDuringNotification) {
+  MessageDispatcherBridgeForTesting bridge;
+  base::CallbackListSubscription subscription;
+  int count = 0;
+  subscription = bridge.AddDispatcherChangedCallback(base::BindRepeating(
+      [](base::CallbackListSubscription* subscription, int* count) {
+        ++*count;
+        *subscription = {};
+      },
+      &subscription, &count));
+  bridge.NotifyDispatcherChanged();
+  bridge.NotifyDispatcherChanged();
+  EXPECT_EQ(count, 1);
+  EXPECT_EQ(bridge.notifications_enabled, std::vector<bool>({true, false}));
+}
+
 }  // namespace messages
