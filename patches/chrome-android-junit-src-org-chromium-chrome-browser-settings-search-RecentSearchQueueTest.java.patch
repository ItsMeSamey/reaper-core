+    @Test
+    public void testDisplayRefreshesRestoredLabelsWithoutRewritingHistory() {
+        var old = displayEntry("about", "About Brave", "Brave information", "Brave privacy");
+        mQueue.add(old);
+        mQueue.flushIfDirty();
+        String persisted = mPreferences.readString(PREF_KEY, "");
+        mQueue.persistToDiskAndReset();
+        mQueue = RecentSearchQueue.getInstance();
+        mQueue.restoreFromDisk();
+
+        var index = new SettingsIndexData();
+        var current = displayEntry("about", "About Reaper", "Reaper information", "Reaper privacy");
+        index.addEntry(current.id, current);
+        var displayed = mQueue.getEntriesForDisplay(index);
+
+        assertEquals(1, displayed.size());
+        assertEquals("About Reaper", displayed.get(0).title);
+        assertEquals("Reaper information", displayed.get(0).summary);
+        assertEquals("Reaper privacy", displayed.get(0).header);
+        assertEquals("About Brave", assumeNonNull(mQueue.get("about")).title);
+        assertEquals(persisted, mPreferences.readString(PREF_KEY, ""));
+        mQueue.flushIfDirty();
+        assertEquals(persisted, mPreferences.readString(PREF_KEY, ""));
+    }
