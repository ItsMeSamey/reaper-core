+    @Test
+    public void testDisplayRefreshPreservesOrderAndSelectionArguments() {
+        Bundle arguments = new Bundle();
+        arguments.putString("user_selection", "retain exactly");
+        var first =
+                new SettingsIndexData.Entry.Builder(displayEntry("one", "Old one", null, null))
+                        .setArguments(arguments)
+                        .setFragment("OriginalTarget")
+                        .setHighlightKey("original_highlight")
+                        .setSubViewPos(7)
+                        .build();
+        var second = displayEntry("two", "Old two", null, null);
+        mQueue.add(first);
+        mQueue.add(second);
+        var index = new SettingsIndexData();
+        var freshSecond = displayEntry("two", "New two", null, null);
+        var freshFirst =
+                new SettingsIndexData.Entry.Builder(displayEntry("one", "New one", null, null))
+                        .setFragment("UnrelatedCurrentArguments")
+                        .build();
+        index.addEntry(freshSecond.id, freshSecond);
+        index.addEntry(freshFirst.id, freshFirst);
+
+        var displayed = mQueue.getEntriesForDisplay(index);
+
+        assertEquals("one", displayed.get(0).key);
+        assertEquals("two", displayed.get(1).key);
+        assertEquals(first.id, displayed.get(0).id);
+        assertEquals(first.parentFragment, displayed.get(0).parentFragment);
+        assertEquals("OriginalTarget", displayed.get(0).fragment);
+        assertEquals("original_highlight", displayed.get(0).highlightKey);
+        assertEquals(7, displayed.get(0).subViewPos);
+        assertSame(arguments, displayed.get(0).extras);
+        assertSame(first, mQueue.get("one"));
+    }
