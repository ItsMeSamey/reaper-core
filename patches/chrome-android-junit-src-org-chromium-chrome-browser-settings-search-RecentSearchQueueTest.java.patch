+    @Test
+    public void testDisplayRefreshesParcelableResultHeaderAndLabels() {
+        var old = displayEntry("about", "About Brave", "Brave information", "Brave privacy");
+        Parcel parcel = Parcel.obtain();
+        try {
+            old.writeToParcel(parcel, 0);
+            parcel.setDataPosition(0);
+            var restored = SettingsIndexData.Entry.CREATOR.createFromParcel(parcel);
+            var index = new SettingsIndexData();
+            var current = displayEntry("about", "About Reaper", "Reaper information", "Reaper privacy");
+            index.addEntry(current.id, current);
+
+            var displayed = RecentSearchQueue.resolveEntriesForDisplay(Arrays.asList(restored), index);
+
+            assertEquals("About Reaper", displayed.get(0).title);
+            assertEquals("Reaper information", displayed.get(0).summary);
+            assertEquals("Reaper privacy", displayed.get(0).header);
+            assertEquals("About Brave", restored.title);
+            assertEquals("Brave privacy", restored.header);
+        } finally {
+            parcel.recycle();
+        }
+    }
