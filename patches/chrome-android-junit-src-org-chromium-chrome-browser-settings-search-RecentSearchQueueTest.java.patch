+    @Test
+    public void testDisplayUsesCurrentLabelsAgainAfterIndexRebuild() {
+        var stored = displayEntry("about", "About Brave", "Old summary", "Old group");
+        mQueue.add(stored);
+        var index = new SettingsIndexData();
+        var first = displayEntry("about", "About Reaper", "New summary", "New group");
+        index.addEntry(first.id, first);
+        assertEquals("About Reaper", mQueue.getEntriesForDisplay(index).get(0).title);
+        index.clear();
+        var next = displayEntry("about", "Reaper info", null, "Current group");
+        index.addEntry(next.id, next);
+
+        var displayed = mQueue.getEntriesForDisplay(index).get(0);
+
+        assertEquals("Reaper info", displayed.title);
+        assertNull(displayed.summary);
+        assertEquals("Current group", displayed.header);
+        assertSame(stored, mQueue.get("about"));
+    }
