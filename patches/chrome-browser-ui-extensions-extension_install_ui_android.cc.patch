 void ExtensionInstallUIAndroid::OnInstallFailure(
     const extensions::CrxInstallError& error) {
-  // TODO(crbug.com/397754565): Implement this.
-  NOTIMPLEMENTED() << "OnInstallFailure";
+  if (IsUiDisabled() || skip_post_install_ui() || !profile()) {
+    return;
+  }
+
+  content::WebContents* web_contents = GetWebContentsForProfile(profile());
+  if (!web_contents || web_contents->IsBeingDestroyed() ||
+      web_contents->GetBrowserContext() != profile() ||
+      !web_contents->GetTopLevelNativeWindow()) {
+    return;
+  }
+
+  auto dialog_model =
+      ui::DialogModel::Builder()
+          .SetTitle(l10n_util::GetStringUTF16(
+              IDS_EXTENSIONS_LOAD_ERROR_ALERT_HEADING))
+          .AddParagraph(ui::DialogModelLabel(error.message()))
+          .AddOkButton(base::DoNothing())
+          .Build();
+  ShowWebModalDialog(web_contents, std::move(dialog_model));
 }
