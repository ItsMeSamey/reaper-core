+// static
+scoped_refptr<SBLocalDatabaseManager>
+SBLocalDatabaseManager::CreateForExtensionBlocklist(
+    const base::FilePath& base_path,
+    scoped_refptr<base::SequencedTaskRunner> ui_task_runner,
+    scoped_refptr<base::SequencedTaskRunner> io_task_runner,
+    ExtendedReportingLevelCallback extended_reporting_level_callback) {
+  auto manager = Create(base_path, std::move(ui_task_runner),
+                        std::move(io_task_runner),
+                        std::move(extended_reporting_level_callback));
+  // No stores or requests are created until StartOnUIThread(). Restrict both
+  // list updates and full-hash requests before starting the shared backend.
+  manager->list_infos_ = ListInfos({ListInfo(
+      true, "ChromeExtMalware", GetChromeExtMalwareId(),
+      SBThreatType::SB_THREAT_TYPE_EXTENSION)});
+  return manager;
+}
