diff --git a/extensions/browser/user_script_loader.cc b/extensions/browser/user_script_loader.cc
--- a/extensions/browser/user_script_loader.cc
+++ b/extensions/browser/user_script_loader.cc
@@ -54,6 +54,11 @@
 // associated with the callback will not cause any script changes.
 const char kNoScriptChangesErrorMsg[] =
     "No changes to loaded scripts would result from this operation.";
+
+#if BUILDFLAG(IS_ANDROID)
+const char kUserScriptSerializationErrorMsg[] =
+    "Scripts could not be loaded because shared memory could not be created.";
