+    /** Called only after a successful public Android screen-consent result was registered. */
+    public static boolean prepareScreenCapture(Context context, int captureId) {
+        if (captureId <= 0 || !isBackgroundMediaCapturingEnabled()) return false;
+        Intent intent = new Intent(context, MediaCaptureNotificationService.class);
+        intent.setAction(ACTION_MEDIA_CAPTURE_UPDATE);
+        // Normal Tab notifications use nonnegative IDs. Keep grants from extension pages separate.
+        intent.putExtra(NOTIFICATION_ID_EXTRA, -captureId);
+        intent.putExtra(NOTIFICATION_MEDIA_IS_INCOGNITO, true);
+        intent.putIntegerArrayListExtra(
+                NOTIFICATION_MEDIA_TYPE_EXTRA, new ArrayList<>(List.of(MediaType.SCREEN_CAPTURE)));
+        try {
+            return context.startForegroundService(intent) != null;
+        } catch (RuntimeException error) {
+            Log.w(TAG, "Unable to prepare screen capture foreground service", error);
+            return false;
+        }
+    }
+
+    /** Remove the notification for an expired, rejected, stopped or destroyed consent grant. */
+    public static void finishScreenCapture(int captureId) {
+        if (captureId <= 0) return;
+        Context context = ContextUtils.getApplicationContext();
+        Intent intent = new Intent(context, MediaCaptureNotificationService.class);
+        intent.setAction(ACTION_MEDIA_CAPTURE_UPDATE);
+        intent.putExtra(NOTIFICATION_ID_EXTRA, -captureId);
+        intent.putIntegerArrayListExtra(NOTIFICATION_MEDIA_TYPE_EXTRA, new ArrayList<>());
+        try {
+            context.startService(intent);
+        } catch (RuntimeException error) {
+            Log.w(TAG, "Unable to clear screen capture foreground service", error);
         }
     }
 
