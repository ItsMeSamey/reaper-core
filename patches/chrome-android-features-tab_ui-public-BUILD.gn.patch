+      "android/java/res/drawable-mdpi/glic_split_button_keyfocus.9.png",
+      "android/java/res/drawable-xhdpi/glic_button_keyfocus.9.png",
+      "android/java/res/drawable-xhdpi/glic_split_button_keyfocus.9.png",
+      "android/java/res/drawable-xxhdpi/glic_button_keyfocus.9.png",
+      "android/java/res/drawable-xxhdpi/glic_split_button_keyfocus.9.png",
