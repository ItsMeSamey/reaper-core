+}
+
+if (is_android) {
+  _tab_ui_public_resource_directories = []
+  _tab_ui_public_resource_sources = []
+  _tab_ui_public_resource_copy_deps = []
+  foreach(_source, _tab_ui_public_resource_spec.sources) {
+    _directory = get_path_info(_source, "dir")
+    if (filter_include(_tab_ui_public_resource_directories, [ _directory ]) == []) {
+      _tab_ui_public_resource_directories += [ _directory ]
+    }
+    _root = "$target_gen_dir/tab_ui_public_resources_selected/" +
+            string_replace(_directory, "/", "_")
+    _qualifier = get_path_info(_directory, "file")
+    _file = get_path_info(_source, "file")
+    _tab_ui_public_resource_sources += [ "$_root/$_qualifier/$_file" ]
+  }
+  foreach(_directory, _tab_ui_public_resource_directories) {
+    _qualifier = get_path_info(_directory, "file")
+    _copy_target = "copy_selected_tab_ui_public_" +
+                   string_replace(_directory, "/", "-")
+    copy_ex(_copy_target) {
+      sources = filter_include(_tab_ui_public_resource_spec.sources, [ "$_directory/*" ])
+      _root = "$target_gen_dir/tab_ui_public_resources_selected/" +
+              string_replace(_directory, "/", "_")
+      dest = "$_root/$_qualifier"
+      outputs = process_file_template(sources, [ "$dest/{{source_file_part}}" ])
+      args = [ "--clear" ]
+    }
+    _tab_ui_public_resource_copy_deps += [ ":$_copy_target" ]
+  }
+}
+
+android_resources("ui_java_resources") {
+  sources = _tab_ui_public_resource_spec.sources
+  if (is_android) {
+    sources = []
+    sources += _tab_ui_public_resource_sources
+    deps = _tab_ui_public_resource_copy_deps
+  }
 }

