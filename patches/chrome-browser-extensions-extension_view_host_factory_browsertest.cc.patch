diff --git a/chrome/browser/extensions/extension_view_host_factory_browsertest.cc b/chrome/browser/extensions/extension_view_host_factory_browsertest.cc
--- a/chrome/browser/extensions/extension_view_host_factory_browsertest.cc
+++ b/chrome/browser/extensions/extension_view_host_factory_browsertest.cc
@@ -9,8 +9,10 @@
 #include "base/memory/scoped_refptr.h"
 #include "chrome/browser/extensions/extension_browsertest.h"
 #include "chrome/browser/extensions/extension_view_host.h"
+#include "chrome/browser/extensions/window_controller.h"
 #include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/tab_list/tab_list_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
 #include "content/public/test/browser_test.h"
 #include "extensions/buildflags/buildflags.h"
 #include "extensions/common/extension.h"
@@ -40,6 +42,29 @@
   EXPECT_EQ(extension.get(), host->extension());
   EXPECT_EQ(browser_context, host->browser_context());
   EXPECT_EQ(mojom::ViewType::kExtensionPopup, host->extension_host_type());
+  ASSERT_TRUE(host->GetExtensionWindowController());
+  EXPECT_EQ(GetBrowserWindowInterface(),
+            host->GetExtensionWindowController()->GetBrowserWindowInterface());
+#if BUILDFLAG(IS_ANDROID)
+  // Host ownership must not depend on whether a side-panel view has been
+  // attached yet, nor fall back to whichever browser was last focused.
+  auto window_panel = ExtensionViewHostFactory::CreateSidePanelHost(
+      *extension, extension->url(), GetBrowserWindowInterface(), nullptr);
+  ASSERT_TRUE(window_panel->GetExtensionWindowController());
+  EXPECT_EQ(GetBrowserWindowInterface(),
+            window_panel->GetExtensionWindowController()
+                ->GetBrowserWindowInterface());
+  auto* tab_list = TabListInterface::From(GetBrowserWindowInterface());
+  ASSERT_TRUE(tab_list);
+  auto* active_tab = tab_list->GetActiveTab();
+  ASSERT_TRUE(active_tab);
+  auto tab_panel = ExtensionViewHostFactory::CreateSidePanelHost(
+      *extension, extension->url(), nullptr, active_tab);
+  ASSERT_TRUE(tab_panel->GetExtensionWindowController());
+  EXPECT_EQ(
+      GetBrowserWindowInterface(),
+      tab_panel->GetExtensionWindowController()->GetBrowserWindowInterface());
+#endif
 }
 
