+  ExpectCompleted(regular, true);
+  EXPECT_EQ(1, incognito->responses);
+  EXPECT_TRUE(Find("R"));
+  EXPECT_FALSE(Find("I", /*incognito=*/true));
+  EXPECT_TRUE(Find("U"));
