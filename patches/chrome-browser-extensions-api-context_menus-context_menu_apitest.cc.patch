+IN_PROC_BROWSER_TEST_F(ExtensionContextMenuPendingWriteAndroidTest,
+                       DisableFlushPreservesChangedAndUntouchedItems) {
+  RestoreSeededMenus();
+  ASSERT_NO_FATAL_FAILURE(UpdateParent());
+  DisableCurrent();
+  EXPECT_EQ(1, write_count_);
+  EXPECT_FALSE(Find("P"));
+  ExpectStoredTree("updated parent");
+  PumpPastWriteDelay();
+  EXPECT_EQ(1, write_count_);
+  ExpectStoredTree("updated parent");
+}
