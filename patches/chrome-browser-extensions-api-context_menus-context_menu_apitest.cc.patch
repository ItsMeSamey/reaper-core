+// Exercise acknowledged API mutations against the real one-second storage
+// timer. No UI task is pumped between a mutation and its immediate unload.
+class ExtensionContextMenuPendingWriteAndroidTest
+    : public ExtensionContextMenuRestoreAndroidTest {
+ public:
+  void TearDownOnMainThread() override {
+    // A failed assertion must not leave a callback referring to test locals.
+    on_write_.Reset();
+    ExtensionContextMenuRestoreAndroidTest::TearDownOnMainThread();
+  }
+
+ protected:
+  void WillWriteToStorage(const std::string& extension_id) override {
+    if (!extension_ || extension_id != extension_->id()) {
+      return;
+    }
+    ++write_count_;
+    if (on_write_) {
+      std::move(on_write_).Run();
+    }
+  }
+
+  void RestoreSeededMenus() {
+    SeedMenus();
+    BeginRestore();
+    FlushStorage();
+    CHECK(Find("P"));
+    CHECK(Find("C"));
+    CHECK(Find("U"));
+    CHECK_EQ(write_count_, 0);
+  }
+
+  void UpdateParent() {
+    auto result = StartApi<ContextMenusUpdateFunction>(
+        base::ListValue().Append("P").Append(
+            base::DictValue().Set("title", "updated parent")));
+    ASSERT_EQ(1, result->responses);
+    ASSERT_EQ(1, result->successes);
+    // Function destruction may be deferred; do not pump UI and fire the timer
+    // before the caller can exercise the immediate lifecycle transition.
+  }
+
+  std::optional<base::Value> ReadStoredMenus() {
+    base::test::TestFuture<std::optional<base::Value>> read;
+    store_->GetExtensionValue(extension_->id(), "context_menus",
+                              read.GetCallback());
+    CHECK(read.Wait());
+    return read.Take();
+  }
+
+  void ExpectStoredTree(const std::string& parent_title) {
+    auto value = ReadStoredMenus();
+    ASSERT_TRUE(value);
+    base::ListValue expected;
+    expected.Append(SavedItem("P", parent_title));
+    expected.Append(SavedItem("C", "stored child", "P"));
+    expected.Append(SavedItem("U", "untouched"));
+    // Compare the real serialized parent/child order, IDs, flags and titles,
+    // including the untouched subtree; an empty replacement cannot pass.
+    EXPECT_EQ(base::Value(std::move(expected)), *value);
+  }
+
+  void PumpPastWriteDelay() {
+    // The production coalescing delay is one second. A later UI task plus a
+    // real StateStore roundtrip catches a surviving obsolete timer, not just
+    // the synchronous state immediately after the lifecycle notification.
+    base::test::TestFuture<void> elapsed;
+    CHECK(base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, elapsed.GetCallback(), base::Seconds(2)));
+    CHECK(elapsed.Wait());
+    FlushStorage();
+  }
+
+  void UninstallCurrent() {
+    std::u16string error;
+    ASSERT_TRUE(ExtensionRegistrar::Get(profile())->UninstallExtension(
+        extension_->id(), UNINSTALL_REASON_FOR_TESTING, &error,
+        base::OnceClosure()));
+    EXPECT_TRUE(error.empty());
+  }
+
+  int write_count_ = 0;
+  base::OnceClosure on_write_;
+};
