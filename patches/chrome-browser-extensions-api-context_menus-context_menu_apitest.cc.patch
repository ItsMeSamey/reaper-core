+IN_PROC_BROWSER_TEST_F(ExtensionContextMenuDocumentAndroidTest,
+                       RetainedMenuRejectsReplacedDocument) {
+  extension_dir_.WriteManifest(R"({
+    "name": "Context menu document", "version": "1", "manifest_version": 3,
+    "permissions": ["contextMenus"],
+    "background": {"service_worker": "worker.js"}
+  })");
+  extension_dir_.WriteFile(FILE_PATH_LITERAL("worker.js"), R"(
+    chrome.contextMenus.onClicked.addListener(() => {
+      chrome.test.sendMessage('document-clicked');
+    });
+    chrome.runtime.onInstalled.addListener(() => {
+      chrome.contextMenus.create({
+        id: 'document', title: 'Document action', contexts: ['page']
+      }, () => {
+        chrome.test.assertNoLastError();
+        chrome.test.sendMessage('document-menu-ready');
+      });
+    });
+  )");
+  ExtensionTestMessageListener ready("document-menu-ready");
+  const Extension* extension = LoadExtension(extension_dir_.UnpackedPath());
+  ASSERT_TRUE(extension);
+  ASSERT_TRUE(ready.WaitUntilSatisfied());
+  ASSERT_TRUE(embedded_test_server()->Start());
+  content::WebContents* contents = GetActiveWebContents();
+  ASSERT_TRUE(NavigateToURL(
+      contents, embedded_test_server()->GetURL("/title1.html")));
+  content::RenderFrameHost* source_frame = contents->GetPrimaryMainFrame();
+  ASSERT_TRUE(source_frame->IsActive());
+  ASSERT_TRUE(source_frame->IsRenderFrameLive());
+  const content::WeakDocumentPtr source_document =
+      source_frame->GetWeakDocumentPtr();
+  ASSERT_EQ(source_frame, source_document.AsRenderFrameHostIfValid());
+  content::ContextMenuParams params;
+  params.page_url = source_frame->GetLastCommittedURL();
+  ExtensionMenuModel retained_menu(*source_frame, params);
+  retained_menu.PopulateModel();
+  const auto& items = retained_menu.matcher_for_test().extension_item_map();
+  ASSERT_EQ(1u, items.size());
+  EXPECT_EQ(extension->id(), items.begin()->second.extension_key.extension_id);
+  EXPECT_EQ("document", items.begin()->second.string_uid);
+  const int command_id = items.begin()->first;
+  TestEventRouterObserver events(EventRouter::Get(profile()));
+  auto click_count = [&events]() {
+    size_t count = 0;
+    for (const auto& event : events.all_events()) {
+      if (event->event_name == "contextMenus.onClicked") {
+        ++count;
+      }
+    }
+    return count;
+  };
+  {
+    ExtensionTestMessageListener clicked("document-clicked");
+    retained_menu.ExecuteCommand(command_id, 0);
+    ASSERT_TRUE(clicked.WaitUntilSatisfied());
+  }
+  ASSERT_EQ(1u, click_count());
+  events.ClearEvents();
+
+  ASSERT_TRUE(NavigateToURL(
+      contents, embedded_test_server()->GetURL("/title2.html")));
+  // Do not dereference the old pointer if a future navigation policy swaps RFHs.
+  ASSERT_EQ(source_frame, contents->GetPrimaryMainFrame());
+  content::RenderFrameHost* current_frame = contents->GetPrimaryMainFrame();
+  ASSERT_TRUE(current_frame->IsActive());
+  ASSERT_TRUE(current_frame->IsRenderFrameLive());
+  EXPECT_FALSE(source_document.AsRenderFrameHostIfValid());
+  ASSERT_EQ(current_frame,
+            current_frame->GetWeakDocumentPtr().AsRenderFrameHostIfValid());
+  // The native router observes dispatch synchronously: no timeout is used as
+  // evidence that an expired document did not receive an action.
+  retained_menu.ExecuteCommand(command_id, 0);
+  EXPECT_EQ(0u, click_count());
+
+  params.page_url = current_frame->GetLastCommittedURL();
+  ExtensionMenuModel fresh_menu(*current_frame, params);
+  fresh_menu.PopulateModel();
+  const auto& fresh_items = fresh_menu.matcher_for_test().extension_item_map();
+  ASSERT_EQ(1u, fresh_items.size());
+  {
+    ExtensionTestMessageListener clicked("document-clicked");
+    fresh_menu.ExecuteCommand(fresh_items.begin()->first, 0);
+    ASSERT_TRUE(clicked.WaitUntilSatisfied());
+  }
+  EXPECT_EQ(1u, click_count());
+}
