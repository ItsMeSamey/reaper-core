+struct MenuRestoreApiResult {
+  int responses = 0;
+  int successes = 0;
+  bool destroyed = false;
+  std::string error;
+};
+
+// Observe lifetime without replacing any actual API behavior.
+template <class Function>
+class ObservedMenuRestoreFunction : public Function {
+ public:
+  explicit ObservedMenuRestoreFunction(
+      std::shared_ptr<MenuRestoreApiResult> result)
+      : result_(std::move(result)) {}
+
+ protected:
+  ~ObservedMenuRestoreFunction() override { result_->destroyed = true; }
+
+ private:
+  std::shared_ptr<MenuRestoreApiResult> result_;
+};
+
+}  // namespace
+
+// An installed ordinary MV3 extension, its actual StateStore/registry, and
+// real API functions. Hold only UI delivery of real storage replies; never
+// call ReadFromStorage or a synthetic readiness predicate directly.
+class ExtensionContextMenuRestoreAndroidTest
+    : public ExtensionContextMenuApiTest,
+      public MenuManager::TestObserver {
+ public:
+  void SetUpOnMainThread() override {
+    ExtensionContextMenuApiTest::SetUpOnMainThread();
+    extension_dir_.WriteManifest(R"({
+      "name": "Menu restore ordering", "version": "1", "manifest_version": 3,
+      "permissions": ["contextMenus"], "incognito": "split",
+      "background": {"service_worker": "worker.js"}
+    })");
+    extension_dir_.WriteFile(
+        FILE_PATH_LITERAL("worker.js"),
+        "chrome.runtime.onInstalled.addListener(() => {});");
+    extension_ = LoadExtension(extension_dir_.UnpackedPath(),
+                               {.allow_in_incognito = true});
+    ASSERT_TRUE(extension_);
+    manager_ = MenuManager::Get(profile());
+    store_ = ExtensionSystem::Get(profile())->state_store();
+    ASSERT_TRUE(manager_);
+    ASSERT_TRUE(store_);
+    FlushStorage();
+    ASSERT_TRUE(store_->IsInitialized());
+    manager_->AddObserver(this);
+    observing_ = true;
+    dispatcher_ = std::make_unique<ExtensionFunctionDispatcher>(profile());
+  }
+
+  void TearDownOnMainThread() override {
+    if (extension_) {
+      DisableCurrent();
+    }
+    if (store_) {
+      FlushStorage();
+    }
+    if (observing_) {
+      manager_->RemoveObserver(this);
+    }
+    dispatcher_.reset();
+    extension_.reset();
+    manager_ = nullptr;
+    store_ = nullptr;
+    ExtensionContextMenuApiTest::TearDownOnMainThread();
+  }
+
+ protected:
+  void DidReadFromStorage(const std::string& extension_id) override {
+    if (extension_ && extension_id == extension_->id()) {
+      ++read_count_;
+    }
+  }
+
+  void DisableCurrent() {
+    ExtensionRegistrar::Get(profile())->DisableExtension(
+        extension_->id(), {disable_reason::DISABLE_USER_ACTION});
+  }
+
+  // A bounded marker completes earlier backend work without pumping UI.
+  void FinishBackendWithoutUi() {
+    auto marker = std::make_shared<base::WaitableEvent>();
+    CHECK(GetExtensionFileTaskRunner()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](std::shared_ptr<base::WaitableEvent> marker) {
+                         marker->Signal();
+                       },
+                       marker)));
+    base::ScopedAllowBaseSyncPrimitivesForTesting allow_wait;
+    CHECK(marker->TimedWait(TestTimeouts::action_timeout()));
+  }
+
+  void FlushStorage() {
+    base::test::TestFuture<void> flushed;
+    store_->FlushForTesting(flushed.GetCallback());
+    CHECK(flushed.Wait());
+  }
+
+  MenuItem::Id Id(const std::string& id, bool incognito = false) {
+    MenuItem::Id result(incognito, MenuItem::ExtensionKey(extension_->id()));
+    result.string_uid = id;
+    return result;
+  }
+
+  MenuItem* Find(const std::string& id, bool incognito = false) {
+    return manager_->GetItemById(Id(id, incognito));
+  }
+
+  base::DictValue SavedItem(const std::string& id,
+                            const std::string& title,
+                            const std::string& parent = {}) {
+    MenuItem item(Id(id), title, false, true, true, MenuItem::NORMAL,
+                  MenuItem::ContextList(MenuItem::ALL));
+    auto value = item.ToValue();
+    if (!parent.empty()) {
+      value.Set("parent_uid", parent);
+    }
+    return value;
+  }
+
+  void SeedMenus() {
+    base::ListValue items;
+    items.Append(SavedItem("P", "stored parent"));
+    items.Append(SavedItem("C", "stored child", "P"));
+    items.Append(SavedItem("U", "untouched"));
+    SeedValue(base::Value(std::move(items)));
+  }
+
+  void SeedValue(base::Value value) {
+    DisableCurrent();
+    store_->SetExtensionValue(extension_->id(), "context_menus",
+                              std::move(value));
+    FinishBackendWithoutUi();
+    read_count_ = 0;
+  }
+
+  void BeginRestore() {
+    ExtensionRegistrar::Get(profile())->EnableExtension(extension_->id());
+    CHECK_EQ(extension_.get(),
+             ExtensionRegistry::Get(profile())->enabled_extensions().GetByID(
+                 extension_->id()));
+    FinishBackendWithoutUi();
+  }
+
+  static base::ListValue CreateArgs(const std::string& id,
+                                    const std::string& title,
+                                    const std::string& parent = {}) {
+    auto properties = base::DictValue().Set("id", id).Set("title", title);
+    if (!parent.empty()) {
+      properties.Set("parentId", parent);
+    }
+    return base::ListValue().Append(std::move(properties));
+  }
+
+  template <class Function>
+  std::shared_ptr<MenuRestoreApiResult> StartApi(
+      base::ListValue args,
+      base::OnceClosure on_response = {},
+      ExtensionFunctionDispatcher* dispatcher = nullptr) {
+    auto result = std::make_shared<MenuRestoreApiResult>();
+    auto function =
+        base::MakeRefCounted<ObservedMenuRestoreFunction<Function>>(result);
+    function->set_extension(extension_.get());
+    function->SetDispatcher(
+        (dispatcher ? dispatcher : dispatcher_.get())->AsWeakPtr());
+    function->SetArgs(std::move(args));
+    function->set_has_callback(true);
+    function->set_response_callback(base::BindOnce(
+        [](std::shared_ptr<MenuRestoreApiResult> result,
+           base::OnceClosure on_response,
+           ExtensionFunction::ResponseType response, base::ListValue values,
+           const std::string& error, mojom::ExtraResponseDataPtr extra) {
+          ++result->responses;
+          result->successes +=
+              response == ExtensionFunction::ResponseType::kSucceeded;
+          result->error = error;
+          if (on_response) {
+            std::move(on_response).Run();
+          }
+        },
+        result, std::move(on_response)));
+    function->RunWithValidation().Execute();
+    return result;
+  }
+
+  void ExpectCompleted(const std::shared_ptr<MenuRestoreApiResult>& result,
+                       bool success) {
+    EXPECT_EQ(1, result->responses);
+    EXPECT_EQ(success ? 1 : 0, result->successes);
+    EXPECT_TRUE(result->destroyed);
+  }
+
+  TestExtensionDir extension_dir_;
+  scoped_refptr<const Extension> extension_;
+  raw_ptr<MenuManager> manager_ = nullptr;
+  raw_ptr<StateStore> store_ = nullptr;
+  std::unique_ptr<ExtensionFunctionDispatcher> dispatcher_;
+  int read_count_ = 0;
+  bool observing_ = false;
+};
