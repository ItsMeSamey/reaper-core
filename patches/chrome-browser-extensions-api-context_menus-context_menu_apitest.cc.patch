+IN_PROC_BROWSER_TEST_F(ExtensionContextMenuRestoreAndroidTest,
+                       RemoveAllThenCreateDoesNotResurrectSavedChildren) {
+  SeedMenus();
+  BeginRestore();
+  std::vector<int> responses;
+  auto removed = StartApi<ContextMenusRemoveAllFunction>(
+      {}, base::BindOnce([](std::vector<int>* order) { order->push_back(1); },
+                         &responses));
+  auto created = StartApi<ContextMenusCreateFunction>(
+      CreateArgs("P", "current parent"),
+      base::BindOnce([](std::vector<int>* order) { order->push_back(2); },
+                     &responses));
+  EXPECT_EQ(0, removed->responses);
+  EXPECT_EQ(0, created->responses);
+  EXPECT_FALSE(Find("P"));
+  FlushStorage();
+  ExpectCompleted(removed, true);
+  ExpectCompleted(created, true);
+  EXPECT_EQ((std::vector<int>{1, 2}), responses);
+  ASSERT_TRUE(Find("P"));
+  EXPECT_EQ("current parent", Find("P")->title());
+  EXPECT_TRUE(Find("P")->children().empty());
+  EXPECT_FALSE(Find("C"));
+  EXPECT_FALSE(Find("U"));
+  EXPECT_EQ(1, read_count_);
+}
