+  ASSERT_NO_FATAL_FAILURE(UpdateParent());
+  on_write_ = base::BindLambdaForTesting([this] {
+    // The outer disable already moved this extension out of the enabled
+    // set. Uninstall therefore need not emit a second unload callback.
+    EXPECT_TRUE(
+        ExtensionRegistry::Get(profile())->disabled_extensions().Contains(
+            extension_->id()));
+    UninstallCurrent();
+  });
+  DisableCurrent();
+  EXPECT_EQ(1, write_count_);
+  EXPECT_FALSE(ReadStoredMenus());
+  PumpPastWriteDelay();
+  EXPECT_EQ(1, write_count_);
+  EXPECT_FALSE(ReadStoredMenus());
+}
