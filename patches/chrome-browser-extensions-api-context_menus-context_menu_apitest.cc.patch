+IN_PROC_BROWSER_TEST_F(ExtensionContextMenuPendingWriteAndroidTest,
+                       SameObjectReenableReadsFlushedMutation) {
+  RestoreSeededMenus();
+  ASSERT_NO_FATAL_FAILURE(UpdateParent());
+  DisableCurrent();
+  // BeginRestore asserts the registrar reuses this exact Extension object.
