+IN_PROC_BROWSER_TEST_F(ExtensionContextMenuPendingWriteAndroidTest,
+                       WriteObserverDisableReenableKeepsOwnedSnapshot) {
+  RestoreSeededMenus();
+  ASSERT_NO_FATAL_FAILURE(UpdateParent());
+  base::test::TestFuture<void> observed;
+  on_write_ =
+      base::BindLambdaForTesting([this, done = observed.GetCallback()]() mutable {
+        DisableCurrent();
+        BeginRestore();
+        std::move(done).Run();
+      });
+  ASSERT_TRUE(observed.Wait());
+  FlushStorage();
+  // The reentrant unload must neither recursively notify this observer nor
+  // let the obsolete outer write serialize freed MenuItem pointers.
+  EXPECT_EQ(1, write_count_);
+  ASSERT_TRUE(Find("P"));
+  EXPECT_EQ("updated parent", Find("P")->title());
+  EXPECT_TRUE(Find("C"));
+  EXPECT_TRUE(Find("U"));
+  ExpectStoredTree("updated parent");
+}
