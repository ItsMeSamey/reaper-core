+IN_PROC_BROWSER_TEST_F(ExtensionContextMenuPendingWriteAndroidTest,
+                       UpdateKeyRemovalCancelsPendingOldTree) {
+  RestoreSeededMenus();
+  ASSERT_NO_FATAL_FAILURE(UpdateParent());
+  // Exercise the real registry/StateStore and registrar lifecycle boundary in
+  // installer order. This test does not synthesize a new version or claim to
+  // cover the unrelated unpacking/installation pipeline.
+  ExtensionRegistry::Get(profile())->TriggerOnWillBeInstalled(
+      extension_.get(), /*is_update=*/true, extension_->name());
+  ExtensionRegistrar::Get(profile())->RemoveExtension(
+      extension_->id(), UnloadedExtensionReason::UPDATE);
+  PumpPastWriteDelay();
+  EXPECT_EQ(0, write_count_);
+  EXPECT_FALSE(ReadStoredMenus());
+}
