+// Keep the same live RFH across an ordinary document replacement so this test
+// distinguishes document ownership from frame liveness without deleting a frame.
+class ExtensionContextMenuDocumentAndroidTest
+    : public ExtensionContextMenuApiTest {
+ public:
+  ExtensionContextMenuDocumentAndroidTest() {
+    // Control both independent policies that can replace a same-site RFH.
+    navigation_features_.InitWithFeatures(
+        {}, {::features::kRenderDocument, ::features::kBackForwardCache});
+  }
+
+ protected:
+  TestExtensionDir extension_dir_;
+
+ private:
+  base::test::ScopedFeatureList navigation_features_;
+};
