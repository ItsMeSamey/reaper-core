+#if BUILDFLAG(IS_ANDROID)
+void ExtensionCommandsGlobalRegistry::RefreshAndroidRegistrations() {
+  // Base Shutdown clears this context before profile services are destroyed.
+  auto* context = ExtensionKeybindingRegistry::browser_context();
+  if (!context)
+    return;
+  auto* registry = ExtensionRegistry::Get(context);
+  if (!registry)
+    return;
+  std::vector<scoped_refptr<const Extension>> enabled(
+      registry->enabled_extensions().begin(),
+      registry->enabled_extensions().end());
+  // Remove before adding: repeated connection notifications must not duplicate
+  // targets or preserve a formerly accepted registration after OS revocation.
+  for (const auto& extension : enabled)
+    RemoveExtensionKeybinding(extension.get(), std::string());
+  auto* listener = static_cast<ui::GlobalAcceleratorListenerAndroid*>(
+      ui::GlobalAcceleratorListener::GetInstance());
+  if (listener->HasBackend() && !listener->IsShortcutHandlingSuspended())
+    Init();
+}
