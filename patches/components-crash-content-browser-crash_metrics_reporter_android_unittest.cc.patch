+TEST_F(CrashMetricsReporterTest,
+       RemovedObserverDoesNotReceiveDeferredNotification) {
+  ChildExitObserver::TerminationInfo info;
+  info.process_host_id = 75;
+  info.process_type = content::PROCESS_TYPE_UTILITY;
+  info.app_state = base::android::APPLICATION_STATE_HAS_RUNNING_ACTIVITIES;
+  info.normal_termination = true;
+  CrashMetricsReporterObserver observer;
+  auto* reporter = CrashMetricsReporter::GetInstance();
+  reporter->AddObserver(&observer);
+  reporter->ChildProcessExited(info);
+  reporter->RemoveObserver(&observer);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(0, observer.callback_count());
+  EXPECT_EQ(-1, observer.process_host_id());
 }
 
