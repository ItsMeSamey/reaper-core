+
+base::ScopedClosureRunner MenuManager::RunAfterInitialRestore(
+    const Extension& extension,
+    base::OnceCallback<void(bool)> callback) {
+  if (shutting_down_ || ExtensionRegistry::Get(browser_context_)
+                                ->enabled_extensions()
+                                .GetByID(extension.id()) != &extension) {
+    std::move(callback).Run(false);
+    return {};
+  }
+  auto it = initial_restores_.find(extension.id());
+  if (it == initial_restores_.end()) {
+    std::move(callback).Run(true);
+    return {};
+  }
+  const uint64_t request_id = ++next_restore_request_id_;
+  CHECK_NE(request_id, 0u);
+  auto cancellation = base::ScopedClosureRunner(base::BindOnce(
+      &MenuManager::CancelRestoreRequest, weak_ptr_factory_.GetWeakPtr(),
+      extension.id(), it->second.generation, request_id));
+  it->second.requests.push_back({request_id, std::move(callback)});
+  return cancellation;
+}
+
+void MenuManager::CancelRestoreRequest(const std::string& extension_id,
+                                       uint64_t generation,
+                                       uint64_t request_id) {
+  auto it = initial_restores_.find(extension_id);
+  if (it == initial_restores_.end() || it->second.generation != generation) {
+    return;
+  }
+  auto& requests = it->second.requests;
+  auto request =
+      std::ranges::find(requests, request_id, &PendingRestoreRequest::id);
+  if (request == requests.end()) {
+    return;
+  }
+  // Detach before releasing the retained ExtensionFunction. Its destruction
+  // must not observe an entry which is still being erased.
+  auto callback = std::move(request->callback);
+  requests.erase(request);
+}
+
+void MenuManager::FailRestoreRequests(
+    std::deque<PendingRestoreRequest> requests) {
+  for (auto& request : requests) {
+    std::move(request.callback).Run(false);
+  }
+}
+
+void MenuManager::OnInitialRestoreRead(const std::string& extension_id,
+                                       uint64_t generation,
+                                       std::optional<base::Value> value) {
+  auto it = initial_restores_.find(extension_id);
+  if (it == initial_restores_.end() || it->second.generation != generation) {
+    return;
+  }
+  if (ExtensionRegistry::Get(browser_context_)
+          ->enabled_extensions()
+          .GetByID(extension_id) != it->second.extension.get()) {
+    auto requests = std::move(it->second.requests);
+    initial_restores_.erase(it);
+    FailRestoreRequests(std::move(requests));
+    return;
+  }
+  auto weak_this = weak_ptr_factory_.GetWeakPtr();
+  ReadFromStorage(extension_id, std::move(value));
+  // Keep the record until all earlier requests finish, including requests
+  // appended by a reentrant API response or read-complete observer.
+  while (weak_this) {
+    auto current = weak_this->initial_restores_.find(extension_id);
+    if (current == weak_this->initial_restores_.end() ||
+        current->second.generation != generation) {
+      return;
+    }
+    if (current->second.requests.empty()) {
+      weak_this->initial_restores_.erase(current);
+      return;
+    }
+    auto callback = std::move(current->second.requests.front().callback);
+    current->second.requests.pop_front();
+    std::move(callback).Run(true);
+  }
+}
