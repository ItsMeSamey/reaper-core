+
+bool MenuManager::IsCurrentPendingWrite(
+    const MenuItem::ExtensionKey& extension_key,
+    uint64_t write_id) const {
+  const auto pending = pending_write_ids_.find(extension_key);
+  return !shutting_down_ && pending != pending_write_ids_.end() &&
+         pending->second == write_id;
+}
+
+void MenuManager::SubmitPendingWrite(
+    const MenuItem::ExtensionKey& extension_key,
+    uint64_t write_id,
+    base::Value value) {
+  if (!IsCurrentPendingWrite(extension_key, write_id)) {
+    return;
+  }
+  auto weak_this = weak_ptr_factory_.GetWeakPtr();
+  // A disable/termination flush can reenter an in-flight notification. Commit
+  // that owned snapshot without recursively notifying the same ObserverList.
+  if (!notifying_write_observers_) {
+    notifying_write_observers_ = true;
+    for (TestObserver& observer : observers_) {
+      observer.WillWriteToStorage(extension_key.extension_id);
+      if (!weak_this) {
+        return;
+      }
+      if (!IsCurrentPendingWrite(extension_key, write_id)) {
+        notifying_write_observers_ = false;
+        return;
+      }
+    }
+    notifying_write_observers_ = false;
+  }
+  // The value owns all item data: an observer may have removed the live tree.
+  // Retire this write before submission; do not access members after Set.
+  pending_write_ids_.erase(extension_key);
+  if (store_) {
+    store_->SetExtensionValue(extension_key.extension_id, kContextMenusKey,
+                              std::move(value));
+  }
+}
+
+void MenuManager::WriteToStorageInternal(
+    const MenuItem::ExtensionKey& extension_key,
+    uint64_t write_id) {
+  if (!IsCurrentPendingWrite(extension_key, write_id)) {
+    return;
+  }
+  write_tasks_.erase(extension_key);
+  SubmitPendingWrite(extension_key, write_id,
+                     SerializeMenuItems(extension_key));
+}
