 void MenuManager::OnExtensionUnloaded(content::BrowserContext* browser_context,
                                       const Extension* extension,
                                       UnloadedExtensionReason reason) {
+#if BUILDFLAG(IS_ANDROID)
+  auto retired = initial_restores_.extract(extension->id());
+  const MenuItem::ExtensionKey extension_key(extension->id());
+  write_tasks_.erase(extension_key);
+  const bool had_pending_write = pending_write_ids_.erase(extension_key) != 0;
+  std::optional<base::Value> pending_value;
+  uint64_t write_id = 0;
+  // Disable (including reload) and renderer termination retain stored menus.
+  // UPDATE/UNINSTALL must not undo StateStore's registered-key removal. Other
+  // unloads, including PROFILE_SHUTDOWN, cancel without a new durability
+  // promise.
+  if (had_pending_write && !shutting_down_ && store_ &&
+      (reason == UnloadedExtensionReason::DISABLE ||
+       reason == UnloadedExtensionReason::TERMINATE)) {
+    pending_value = SerializeMenuItems(extension_key);
+    write_id = ++next_pending_write_id_;
+    CHECK_NE(write_id, 0u);
+    pending_write_ids_[extension_key] = write_id;
