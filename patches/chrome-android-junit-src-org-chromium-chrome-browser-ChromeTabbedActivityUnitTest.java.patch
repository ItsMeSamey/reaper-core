+    @Test
+    @EnableFeatures(ChromeFeatureList.UNIVERSAL_KEYBOARD_HANDLING)
+    public void testUniversalKeyboardCallbacks_browserHandlingTakesPriority() {
+        ExtensionsToolbarCoordinator coordinator = mock(ExtensionsToolbarCoordinator.class);
+        KeyboardTestChromeTabbedActivity activity = createKeyboardActivity(coordinator);
+
+        assertTrue(
+                activity.preHandleKeyboardEvent(
+                        new KeyEvent(KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_SEARCH)));
+        assertEquals(R.id.focus_url_bar, activity.mLastMenuAction);
+        activity.mBrowserKeyHandled = true;
+        assertTrue(activity.handleKeyboardEvent(extensionShortcut()));
+
+        verifyNoInteractions(coordinator);
+    }
+
+    @Test
+    @EnableFeatures(ChromeFeatureList.UNIVERSAL_KEYBOARD_HANDLING)
+    public void testUniversalKeyboardCallbacks_ignoreKeyUpAndRepeats() {
+        ExtensionsToolbarCoordinator coordinator = mock(ExtensionsToolbarCoordinator.class);
+        KeyboardTestChromeTabbedActivity activity = createKeyboardActivity(coordinator);
+        KeyEvent keyUp = new KeyEvent(KeyEvent.ACTION_UP, KeyEvent.KEYCODE_1);
+        KeyEvent repeated = new KeyEvent(0, 0, KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_1, 1);
+
+        assertFalse(activity.preHandleKeyboardEvent(keyUp));
+        assertFalse(activity.handleKeyboardEvent(keyUp));
+        assertFalse(activity.preHandleKeyboardEvent(repeated));
+        assertFalse(activity.handleKeyboardEvent(repeated));
+
+        verifyNoInteractions(coordinator);
+    }
+
