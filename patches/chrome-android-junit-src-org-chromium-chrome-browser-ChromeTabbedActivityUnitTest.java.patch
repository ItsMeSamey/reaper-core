+    private static class KeyboardTestChromeTabbedActivity extends TestChromeTabbedActivity {
+        private final FullscreenManager mFullscreenManager = mock(FullscreenManager.class);
+        private boolean mBrowserKeyHandled;
+        private int mLastMenuAction;
+
+        @Override
+        public FullscreenManager getFullscreenManager() {
+            return mFullscreenManager;
+        }
+
+        @Override
+        public boolean onKeyDown(int keyCode, KeyEvent event) {
+            return mBrowserKeyHandled;
+        }
+
+        @Override
+        public boolean onMenuOrKeyboardAction(int id, boolean fromMenu) {
+            mLastMenuAction = id;
+            return true;
+        }
+    }
+
+    private KeyboardTestChromeTabbedActivity createKeyboardActivity(
+            ExtensionsToolbarCoordinator coordinator) {
+        KeyboardTestChromeTabbedActivity activity =
+                Robolectric.buildActivity(KeyboardTestChromeTabbedActivity.class).get();
+        activity.setDidFinishNativeInitialization(true);
+        ReflectionHelpers.setField(activity, "mUiWithNativeInitialized", true);
+        ToolbarManager toolbarManager = mock(ToolbarManager.class);
+        when(toolbarManager.getExtensionsToolbarCoordinator()).thenReturn(coordinator);
+        OneshotSupplierImpl<ToolbarManager> toolbarSupplier = new OneshotSupplierImpl<>();
+        toolbarSupplier.set(toolbarManager);
+        RootUiCoordinator rootUiCoordinator = mock(RootUiCoordinator.class);
+        when(rootUiCoordinator.getToolbarManagerSupplier()).thenReturn(toolbarSupplier);
+        ReflectionHelpers.setField(activity, "mRootUiCoordinator", rootUiCoordinator);
+        return activity;
+    }
+
+    private KeyEvent extensionShortcut() {
+        return new KeyEvent(
+                0,
+                0,
+                KeyEvent.ACTION_DOWN,
+                KeyEvent.KEYCODE_1,
+                0,
+                KeyEvent.META_CTRL_ON | KeyEvent.META_SHIFT_ON);
+    }
