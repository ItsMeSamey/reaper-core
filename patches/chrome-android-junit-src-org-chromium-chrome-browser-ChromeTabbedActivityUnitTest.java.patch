+    @Test
+    @EnableFeatures(ChromeFeatureList.UNIVERSAL_KEYBOARD_HANDLING)
+    public void testPreHandleKeyboardEvent_routesExtensionShortcutOnce() {
+        ExtensionsToolbarCoordinator coordinator = mock(ExtensionsToolbarCoordinator.class);
+        KeyboardTestChromeTabbedActivity activity = createKeyboardActivity(coordinator);
+        KeyEvent event = extensionShortcut();
+        when(coordinator.dispatchKeyEvent(event)).thenReturn(true);
+
+        assertTrue(activity.preHandleKeyboardEvent(event));
+
+        verify(coordinator, times(1)).dispatchKeyEvent(event);
+    }
+
