 #endif  // BUILDFLAG(IS_ANDROID)
+
+#if BUILDFLAG(IS_ANDROID)
+namespace {
+class ActiveTabBluetoothChooser final : public content::BluetoothChooser {
+ public:
+  ActiveTabBluetoothChooser(content::RenderFrameHost* frame,
+                            const EventHandler& event_handler)
+      : event_handler_(event_handler) {
+    request_ = std::make_unique<ActiveDeviceChooserRequest>(
+        frame, base::BindOnce(&ActiveTabBluetoothChooser::Cancel,
+                              weak_factory_.GetWeakPtr()));
+    if (!request_->IsValid())
+      return;
+    chooser_ = std::make_unique<permissions::BluetoothChooserAndroid>(
+        frame,
+        base::BindRepeating(&ActiveTabBluetoothChooser::OnEvent,
+                            weak_factory_.GetWeakPtr()),
+        std::make_unique<ChromeBluetoothChooserAndroidDelegate>(
+            Profile::FromBrowserContext(frame->GetBrowserContext())));
+  }
+
+  bool CanAskForScanningPermission() override {
+    return request_->IsValid() && chooser_ &&
+           chooser_->CanAskForScanningPermission();
+  }
+  void SetAdapterPresence(AdapterPresence presence) override {
+    if (chooser_)
+      chooser_->SetAdapterPresence(presence);
+  }
+  void ShowDiscoveryState(DiscoveryState state) override {
+    if (chooser_)
+      chooser_->ShowDiscoveryState(state);
+  }
+  void AddOrUpdateDevice(const std::string& id,
+                         bool update_name,
+                         const std::u16string& name,
+                         bool connected,
+                         bool paired,
+                         int signal) override {
+    if (chooser_)
+      chooser_->AddOrUpdateDevice(id, update_name, name, connected, paired,
+                                  signal);
+  }
+  base::OnceCallback<bool()> TakeSelectionValidator() override {
+    request_->ClearCancellationCallback();
+    return base::BindOnce(
+        [](std::unique_ptr<ActiveDeviceChooserRequest> request) {
+          return request->IsValid();
+        },
+        std::move(request_));
+  }
+
+ private:
+  void Cancel() { OnEvent(content::BluetoothChooserEvent::CANCELLED, ""); }
+  void OnEvent(content::BluetoothChooserEvent event, const std::string& id) {
+    if (finished_)
+      return;
+    if (!request_->IsValid())
+      event = content::BluetoothChooserEvent::CANCELLED;
+    if (event != content::BluetoothChooserEvent::RESCAN)
+      finished_ = true;
+    // The delegate may synchronously destroy this wrapper and the Java chooser.
+    auto handler = event_handler_;
+    handler.Run(event,
+                event == content::BluetoothChooserEvent::SELECTED ? id : "");
+  }
+  const EventHandler event_handler_;
+  bool finished_ = false;
+  std::unique_ptr<ActiveDeviceChooserRequest> request_;
+  std::unique_ptr<permissions::BluetoothChooserAndroid> chooser_;
+  base::WeakPtrFactory<ActiveTabBluetoothChooser> weak_factory_{this};
+};
+}  // namespace
+#endif
 
