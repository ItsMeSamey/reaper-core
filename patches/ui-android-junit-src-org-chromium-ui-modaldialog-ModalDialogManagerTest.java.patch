+    /** A dismissal observer can run after the presenter has already cleared its model. */
+    @Test
+    @Feature({"ModalDialogManagerObserver"})
+    public void testSuspendCurrentDialog_NullModelDuringDismissalIsNotQueued() {
+        PropertyModel model = mDialogModels.get(0);
+        int[] dismissalCallbacks = {0};
+        mModalDialogManager.addObserver(
+                new ModalDialogManagerObserver() {
+                    @Override
+                    public void onDialogDismissed(PropertyModel dismissedModel) {
+                        assertEquals(model, dismissedModel);
+                        dismissalCallbacks[0]++;
+                        // Exercise the genuine teardown window, without introducing a second
+                        // dialog into the still-running outer dismissDialog call.
+                        assertTrue(mModalDialogManager.isShowing());
+                        assertNull(mModalDialogManager.getCurrentDialogForTest());
+                        ReflectionHelpers.callInstanceMethod(
+                                mModalDialogManager, "suspendCurrentDialog");
+                        assertFalse(mModalDialogManager.isShowing());
+                        assertNull(
+                                mModalDialogManager.getPendingDialogsForTest(ModalDialogType.APP));
+                        assertNull(
+                                mModalDialogManager.getPendingDialogsForTest(ModalDialogType.TAB));
+                        verify(mObserver, times(0)).onDialogQueued(any(), anyInt());
+                    }
+                });
+
+        mModalDialogManager.showDialog(model, ModalDialogType.APP);
+        mModalDialogManager.dismissDialog(model, DialogDismissalCause.UNKNOWN);
+
+        assertEquals(1, dismissalCallbacks[0]);
+        assertFalse(mModalDialogManager.isShowing());
+        assertNull(mModalDialogManager.getCurrentPresenterForTest());
+        assertNull(mModalDialogManager.getCurrentDialogForTest());
+        assertNull(mModalDialogManager.getPendingDialogsForTest(ModalDialogType.APP));
+        assertNull(mModalDialogManager.getPendingDialogsForTest(ModalDialogType.TAB));
+        verify(mObserver, times(0)).onDialogQueued(any(), anyInt());
+        verify(mObserver, times(1)).onDialogDismissed(model);
+        verify(mObserver, times(1)).onLastDialogDismissed();
+        verify(mAppModalPresenter, times(1)).removeDialogView(model);
+        verify(mAppModalPresenter, times(0)).removeDialogView(null);
+        assertOnDismissCalled(model, 1);
+    }
