+    /** Reentrant observers cannot change the type reported for an already queued dialog. */
+    @Test
+    @Feature({"ModalDialogManagerObserver"})
+    public void testSuspendCurrentDialog_ReentrantObserverPreservesQueuedType() {
+        PropertyModel appModel = mDialogModels.get(0);
+        PropertyModel tabModel = mDialogModels.get(1);
+        int[] queuedCallbacks = {0};
+        mModalDialogManager.addObserver(
+                new ModalDialogManagerObserver() {
+                    @Override
+                    public void onDialogQueued(PropertyModel queuedModel, int dialogType) {
+                        assertEquals(appModel, queuedModel);
+                        assertEquals(ModalDialogType.APP, dialogType);
+                        queuedCallbacks[0]++;
+                        assertTrue(mModalDialogManager.isSuspended(ModalDialogType.APP));
+
+                        // Change the manager's current type, then finish the nested dialog so
+                        // suspendType can safely continue with no active presenter.
+                        mModalDialogManager.showDialog(tabModel, ModalDialogType.TAB);
+                        assertEquals(tabModel, mModalDialogManager.getCurrentDialogForTest());
+                        mModalDialogManager.dismissDialog(tabModel, DialogDismissalCause.UNKNOWN);
+                        assertEquals(ModalDialogType.TAB, mModalDialogManager.getCurrentType());
+                        assertFalse(mModalDialogManager.isShowing());
+                    }
+                });
+        ModalDialogManagerObserver laterObserver = Mockito.mock(ModalDialogManagerObserver.class);
+        mModalDialogManager.addObserver(laterObserver);
+
+        mModalDialogManager.showDialog(appModel, ModalDialogType.APP);
+        int token = mModalDialogManager.suspendType(ModalDialogType.APP);
+
+        assertEquals(1, queuedCallbacks[0]);
+        verify(laterObserver, times(1)).onDialogQueued(appModel, ModalDialogType.APP);
+        verify(laterObserver, times(1)).onDialogQueued(any(), anyInt());
+        assertFalse(mModalDialogManager.isShowing());
+        assertEquals(ModalDialogType.TAB, mModalDialogManager.getCurrentType());
+        assertEquals(1, mModalDialogManager.getPendingDialogsForTest(ModalDialogType.APP).size());
+        assertEquals(
+                appModel, mModalDialogManager.getPendingDialogsForTest(ModalDialogType.APP).get(0));
+        assertNull(mModalDialogManager.getPendingDialogsForTest(ModalDialogType.TAB));
+        assertOnDismissCalled(tabModel, 1);
+        assertOnDismissCalled(appModel, 0);
+
+        mModalDialogManager.resumeType(ModalDialogType.APP, token);
+
+        assertEquals(appModel, mModalDialogManager.getCurrentDialogForTest());
+        assertEquals(ModalDialogType.APP, mModalDialogManager.getCurrentType());
+        assertNull(mModalDialogManager.getPendingDialogsForTest(ModalDialogType.APP));
+        assertEquals(1, queuedCallbacks[0]);
+        verify(laterObserver, times(1)).onDialogQueued(any(), anyInt());
     }
 
