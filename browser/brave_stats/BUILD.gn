import("//brave/browser/brave_stats/buildflags.gni")
import("//brave/components/brave_wallet/common/buildflags/buildflags.gni")
import("//build/buildflag_header.gni")

buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [
    "BRAVE_USAGE_SERVER=\"$brave_stats_updater_url\"",
    "ENABLE_BRAVE_STATS_UPDATER=$enable_brave_stats_updater",
  ]
}

source_set("first_run_util") {
  sources = [
    "//brave/browser/brave_stats/first_run_util.cc",
    "//brave/browser/brave_stats/first_run_util.h",
  ]

  deps = [
    "//base",
    "//brave/components/constants",
    "//chrome/browser/first_run",
    "//components/prefs",
  ]
}

source_set("brave_stats") {
  sources = [
    "//brave/browser/brave_stats/features.h",
    "//brave/browser/brave_stats/switches.h",
  ]

  if (!is_android || enable_brave_stats_updater) {
    sources += [ "//brave/browser/brave_stats/features.cc" ]
  }

  if (enable_brave_stats_updater) {
    sources += [
      "//brave/browser/brave_stats/brave_stats_updater_params.cc",
      "//brave/browser/brave_stats/brave_stats_updater_params.h",
      "//brave/browser/brave_stats/brave_stats_updater.cc",
      "//brave/browser/brave_stats/brave_stats_updater.h",
    ]
  }

  public_deps = [ "//brave/browser/brave_stats:buildflags" ]
  if (!is_android) {
    public_deps += [
      "//brave/browser/brave_stats:first_run_util",
      "//brave/components/brave_stats/browser",
    ]
  }

  deps = [
    "//base",
    "//brave/browser:browser_process",
    "//brave/browser/misc_metrics",
    "//brave/browser/serp_metrics",
    "//brave/common",
    "//brave/components/brave_policy:brave_policy_observer",
    "//brave/components/brave_referrals/common",
    "//brave/components/brave_wallet/common/buildflags",
    "//brave/components/constants",
    "//brave/components/misc_metrics",
    "//brave/components/serp_metrics",
    "//brave/components/serp_metrics:features",
    "//brave/components/serp_metrics:prefs",
    "//brave/components/version_info",
    "//chrome/browser:browser_process",
    "//chrome/browser/first_run",
    "//chrome/browser/headless",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/profiles:profile_util",
    "//chrome/browser/ui",
    "//chrome/common",
    "//components/prefs",
    "//net",
    "//services/network/public/cpp",
  ]

  # Excluded product implementations are absent from Reaper Android.
  if (is_android) {
    deps -= [
      "//brave/components/brave_referrals/common",
    ]
  }

  # Collection implementations are absent from Reaper Android.
  if (is_android) {
    deps -= [
      "//brave/browser/misc_metrics",
      "//brave/browser/serp_metrics",
      "//brave/components/misc_metrics",
      "//brave/components/serp_metrics",
      "//brave/components/serp_metrics:features",
      "//brave/components/serp_metrics:prefs",
    ]
  }

  if (!is_android) {
    deps += [ "//brave/components/brave_origin" ]
  }

  if (enable_brave_wallet) {
    deps += [
      "//brave/components/brave_wallet/browser",
      "//brave/components/brave_wallet/browser:pref_names",
    ]
  }
}

source_set("browser_tests") {
  testonly = true

  sources = []

  if (enable_brave_stats_updater) {
    sources +=
        [ "//brave/browser/brave_stats/brave_stats_updater_browsertest.cc" ]
  }

  deps = [
    "//brave/browser/brave_stats",
    "//brave/components/brave_referrals/browser",
    "//chrome/browser",
    "//chrome/test:test_support",
  ]

  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "//brave/browser/brave_stats/brave_stats_updater_util_unittest.cc",
    "//brave/browser/brave_stats/first_run_util_unittest.cc",
  ]

  if (enable_brave_stats_updater) {
    sources += [ "//brave/browser/brave_stats/brave_stats_updater_unittest.cc" ]
  }

  deps = [
    "//brave/browser/brave_stats",
    "//brave/browser/serp_metrics",
    "//brave/browser/serp_metrics:test_support",
    "//brave/components/brave_referrals/browser",
    "//brave/components/brave_stats/browser",
    "//brave/components/brave_wallet/common/buildflags",
    "//brave/components/misc_metrics",
    "//brave/components/serp_metrics:prefs",
    "//chrome/browser",
    "//chrome/browser/prefs",
    "//chrome/browser/profiles:profile_util",
    "//chrome/test:test_support",
    "//components/prefs",
  ]

  # Keep ordinary first-run/date utility coverage in the test binary only.
  if (is_android) {
    deps += [ "//brave/browser/brave_stats:first_run_util" ]
  }

  # Collection implementations are absent from Reaper Android.
  if (is_android) {
    deps -= [
      "//brave/browser/serp_metrics",
      "//brave/browser/serp_metrics:test_support",
      "//brave/components/misc_metrics",
      "//brave/components/serp_metrics:prefs",
    ]
  }

  if (enable_brave_wallet) {
    deps += [
      "//brave/components/brave_wallet/browser",
      "//brave/components/brave_wallet/browser:pref_names",
    ]
  }
}
