import("//brave/components/containers/buildflags/buildflags.gni")

assert(enable_containers)

source_set("containers") {
  sources = [
    "containers_service_delegate.cc",
    "containers_service_delegate.h",
    "containers_service_factory.cc",
    "containers_service_factory.h",
    "used_container_storage_partitions.cc",
    "used_container_storage_partitions.h",
  ]

  deps = [
    "//brave/components/containers/content/browser",
    "//brave/components/containers/core/browser",
    "//brave/components/containers/core/common",
    "//chrome/browser/profiles:profile",
    "//chrome/common",
    "//chrome/common:buildflags",
    "//components/sessions",
    "//content/public/browser",
    "//crypto",
  ]
  if (is_android) {
    sources += [
      "android/containers_bridge.cc",
      "android/containers_bridge.h",
      "android/containers_persistent_tab_references.cc",
      "android/containers_tab_lifecycle.cc",
      "android/containers_tab_lifecycle.h",
      "container_specifier_utils.cc",
      "container_specifier_utils.h",
    ]
    deps += [
      "//base",
      "//brave/browser/containers/android:jni_headers",
      "//brave/components/containers/content/browser:tab_restore",
      "//chrome/android:chrome_jni_headers",
      "//chrome/browser/android:tab_state_storage_service_factory_headers",
      "//chrome/browser/android:tabs_public",
      "//chrome/browser/tab",
      "//chrome/browser/tab:impl",
      "//chrome/browser/ui/android/tab_model",
      "//chrome/browser/ui/navigator",
    ]
  } else {
    sources += [
      "container_specifier_utils.cc",
      "container_specifier_utils.h",
      "container_tab_tracker.cc",
      "container_tab_tracker.h",
    ]
    deps += [
      "//chrome/browser/ui/tab_contents",
      "//chrome/browser/ui/tabs",
    ]
  }
}

source_set("browser_tests") {
  testonly = true

  if (is_android) {
    sources = [ "android/containers_cookies_browsertest.cc" ]
    deps = [
      ":containers",
      "//brave/components/containers/core/browser",
      "//brave/components/containers/core/browser:test_support",
      "//brave/components/containers/core/common:features",
      "//brave/components/containers/core/mojom",
      "//chrome/browser",
      "//chrome/browser/extensions",
      "//chrome/browser/extensions:test_support",
      "//chrome/browser/extensions/api/cookies",
      "//chrome/browser/extensions/api/cookies:helpers",
      "//chrome/browser/ui/android/tab_model:test_support",
      "//chrome/test:test_support",
      "//components/blocked_content",
      "//components/content_settings/core/browser",
      "//content/test:test_support",
      "//extensions:test_support",
      "//net:test_support",
    ]
  } else {
    sources = [ "containers_browsertest.cc" ]

    deps = [
      ":containers",
      "//brave/app:brave_generated_resources_grit_grit",
      "//brave/components/containers/content/browser",
      "//brave/components/containers/core/browser",
      "//brave/components/containers/core/browser:test_support",
      "//brave/components/containers/core/common:features",
      "//brave/components/containers/core/common:switches",
      "//brave/components/containers/core/mojom",
      "//chrome/browser",
      "//chrome/browser/browsing_data:constants",
      "//chrome/browser/prefs:util",
      "//chrome/browser/renderer_context_menu:test_support",
      "//chrome/browser/ui/views/page_action:page_action_test_support",
      "//chrome/browser/ui/views/tabs/hovercard",
      "//chrome/browser/ui/views/tabs/hovercard:test_support",
      "//chrome/browser/ui/zoom",
      "//chrome/browser/web_applications",
      "//chrome/browser/web_applications:web_applications_test_support",
      "//chrome/test:test_support",
      "//components/permissions",
      "//components/permissions:test_support",
      "//components/services/app_service/public/cpp:app_types",
      "//components/webapps/common",
      "//content/public/browser",
      "//content/test:test_support",
      "//third_party/blink/public:blink_headers",
    ]
  }
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
}

source_set("unit_tests") {
  testonly = true

  if (is_android) {
    sources = [
      "android/containers_bridge_unittest.cc",
      "android/containers_cookies_unittest.cc",
      "android/containers_tab_lifecycle_unittest.cc",
    ]
  } else {
    sources = [
      "containers_service_delegate_unittest.cc",
      "permission_util_containers_unittest.cc",
    ]
  }

  deps = [
    ":containers",
    "//base/test:test_support",
    "//brave/components/containers/content/browser",
    "//brave/components/containers/core/browser",
    "//brave/components/containers/core/browser:test_support",
    "//brave/components/containers/core/common:features",
    "//brave/components/containers/core/mojom",
    "//chrome/browser",
    "//chrome/test:test_support",
    "//components/permissions",
    "//components/sessions:test_support",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
  if (is_android) {
    deps += [
      "//chrome/browser/extensions:test_support",
      "//chrome/browser/extensions/api/cookies",
      "//chrome/browser/extensions/api/cookies:helpers",
      "//chrome/browser/net",
      "//net",
      "//services/network:test_support",
    ]
  }
}
