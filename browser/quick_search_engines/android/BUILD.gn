_quick_search_resource_spec = {
  sources = [
    "java/res/drawable/ic_microsoft_color.xml",
    "java/res/drawable/ic_social_youtube.xml",
    "java/res/drawable/ic_startpage_color.xml",
    "java/res/layout/fragment_quick_search.xml",
    "java/res/layout/quick_search_engines_view.xml",
    "java/res/layout/quick_search_engines_view_item.xml",
    "java/res/layout/quick_search_settings_item.xml",
    "java/res/values/dimens.xml",
  ]
}

# Stage only selected resources; keep excluded or retired files out of the
# strict resource directory scan without changing validation.
_quick_search_resource_directories = []
_quick_search_resource_sources = []
_quick_search_resource_copy_deps = []
foreach(_source, _quick_search_resource_spec.sources) {
  _directory = get_path_info(_source, "dir")
  if (filter_include(_quick_search_resource_directories, [ _directory ]) == []) {
    _quick_search_resource_directories += [ _directory ]
  }
  _root = "$target_gen_dir/quick_search_resources_selected/" +
          string_replace(_directory, "/", "_")
  _qualifier = get_path_info(_directory, "file")
  _file = get_path_info(_source, "file")
  _quick_search_resource_sources += [ "$_root/$_qualifier/$_file" ]
}
foreach(_directory, _quick_search_resource_directories) {
  _qualifier = get_path_info(_directory, "file")
  _copy_target = "copy_selected_quick_search_$_qualifier"
  copy_ex(_copy_target) {
    sources = filter_include(_quick_search_resource_spec.sources, [ "$_directory/*" ])
    _root = "$target_gen_dir/quick_search_resources_selected/" +
            string_replace(_directory, "/", "_")
    dest = "$_root/$_qualifier"
    outputs = process_file_template(sources, [ "$dest/{{source_file_part}}" ])
    args = [ "--clear" ]
  }
  _quick_search_resource_copy_deps += [ ":$_copy_target" ]
}

android_resources("java_resources") {
  sources = _quick_search_resource_sources

  deps = [
    ":java_strings_grd",
    "//brave/android/nala:java_resources",
  ]
  deps += _quick_search_resource_copy_deps
}

java_strings_grd("java_strings_grd") {
  defines = chrome_grit_defines
  grd_file = "java/strings/android_quick_search_engines_strings.grd"
  outputs = [ "values/android_quick_search_engines_strings.xml" ] + process_file_template(
                android_bundle_locales_as_resources,
                [ "values-{{source_name_part}}/android_quick_search_engines_strings.xml" ])
}
