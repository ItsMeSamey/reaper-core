import("//build/config/android/copy_ex.gni")
import("//build/config/android/rules.gni")

android_library("java") {
  sources = [
    "java/src/org/chromium/chrome/browser/firstrun/OnboardingStepAdapter.java",
    "java/src/org/chromium/chrome/browser/firstrun/PageBounceAnimator.java",
  ]

  deps = [
    ":java_resources",
    "//base:base_java",
    "//brave/build/android:android_brave_strings_grd",
    "//third_party/android_deps:com_airbnb_android_lottie_java",
    "//third_party/android_deps:material_design_java",
    "//third_party/androidx:androidx_recyclerview_recyclerview_java",
    "//third_party/androidx:androidx_viewpager2_viewpager2_java",
  ]

  resources_package = "org.chromium.brave.browser.firstrun"
}

_first_run_resource_spec = {
  sources = [
    "java/res/animator/ic_brave_splash_scale.xml",
    "java/res/drawable/ic_brave_brand.xml",
    "java/res/drawable/ic_brave_splash.xml",
    "java/res/drawable/ic_brave_splash_animated.xml",
    "java/res/drawable/onboarding_card_background.xml",
    "java/res/drawable/onboarding_rounded_corners.xml",
    "java/res/layout-land/block_interruptions.xml",
    "java/res/layout-land/make_brave_better.xml",
    "java/res/layout-sw600dp-land/block_interruptions.xml",
    "java/res/layout-sw600dp-land/make_brave_better.xml",
    "java/res/layout-sw600dp-port/block_interruptions.xml",
    "java/res/layout-sw600dp-port/make_brave_better.xml",
    "java/res/layout/block_interruptions.xml",
    "java/res/layout/block_interruptions_landscape_content.xml",
    "java/res/layout/make_brave_better.xml",
    "java/res/raw-night/no_video_ads.json",
    "java/res/raw/no_video_ads.json",
    "java/res/values-night/colors.xml",
    "java/res/values-sw600dp-h1000dp-port/dimens.xml",
    "java/res/values-sw600dp-h700dp-port/dimens.xml",
    "java/res/values-sw600dp-h800dp-port/dimens.xml",
    "java/res/values-sw600dp-h900dp-port/dimens.xml",
    "java/res/values/colors.xml",
    "java/res/values/dimens.xml",
  ]
}

# Stage only selected resources; clear each owned qualifier root so excluded
# or retired files cannot remain in android_resources' directory scan.
_first_run_resource_directories = []
_first_run_resource_sources = []
_first_run_resource_copy_deps = []
foreach(_source, _first_run_resource_spec.sources) {
  _directory = get_path_info(_source, "dir")
  if (filter_include(_first_run_resource_directories, [ _directory ]) == []) {
    _first_run_resource_directories += [ _directory ]
  }
  _root = "$target_gen_dir/first_run_resources_selected/" +
          string_replace(_directory, "/", "_")
  _qualifier = get_path_info(_directory, "file")
  _file = get_path_info(_source, "file")
  _first_run_resource_sources += [ "$_root/$_qualifier/$_file" ]
}
foreach(_directory, _first_run_resource_directories) {
  _qualifier = get_path_info(_directory, "file")
  _copy_target = "copy_selected_first_run_$_qualifier"
  copy_ex(_copy_target) {
    sources = filter_include(_first_run_resource_spec.sources, [ "$_directory/*" ])
    _root = "$target_gen_dir/first_run_resources_selected/" +
            string_replace(_directory, "/", "_")
    dest = "$_root/$_qualifier"
    outputs = process_file_template(sources, [ "$dest/{{source_file_part}}" ])
    args = [ "--clear" ]
  }
  _first_run_resource_copy_deps += [ ":$_copy_target" ]
}

android_resources("java_resources") {
  sources = _first_run_resource_sources
  deps = _first_run_resource_copy_deps
}

robolectric_library("junit") {
  resources_package = "org.chromium.brave.browser.firstrun"
  sources = [ "javatests/src/org/chromium/chrome/browser/firstrun/OnboardingStepAdapterTest.java" ]

  deps = [
    ":java",
    "//chrome/android/junit:chrome_junit_tests_helper",
    "//third_party/androidx:androidx_viewpager2_viewpager2_java",
  ]
}
