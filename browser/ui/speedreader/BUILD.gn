import("//brave/components/speedreader/common/buildflags/buildflags.gni")

assert(enable_speedreader)

source_set("speedreader") {
  sources = [
    "speedreader_bubble_view.h",
    "speedreader_tab_helper.cc",
    "speedreader_tab_helper.h",
  ]

  public_deps = [
    "//brave/browser/speedreader",
    "//components/dom_distiller/content/browser",
  ]

  deps = [
    "//brave/browser:browser_process",
    "//brave/components/resources:static_resources_grit",
    "//chrome/common",
  ]

  if (is_android) {
    sources += [ "android/speedreader_utils.cc" ]

    deps += [
      "//chrome/android:chrome_jni_headers",
      "//chrome/browser/profiles",
      "//components/prefs",
      "//components/user_prefs",
      "//content/public/browser",
    ]
  }
}

if (is_android) {
  source_set("android_unit_tests") {
    testonly = true
    sources = [ "android/speedreader_tab_helper_unittest.cc" ]
    deps = [
      ":speedreader",
      "//base/test:test_support",
      "//brave/components/speedreader",
      "//components/content_settings/core/browser",
      "//components/prefs:test_support",
      "//components/sync_preferences:test_support",
      "//components/user_prefs",
      "//content/test:test_support",
      "//testing/gtest",
    ]
  }
}
