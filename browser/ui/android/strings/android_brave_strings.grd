    <message name="IDS_REAPER_CLOSING_ALL_TABS_CLOSES_BROWSER" desc="Android setting title: close the Reaper app when its last tab is closed.">
      Closing all tabs closes Reaper
    </message>
    </messages>
  </release>
</grit>
