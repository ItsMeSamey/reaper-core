  <release seq="1" allow_pseudo="false">
    <messages fallback_to_english="true">
      <message name="IDS_CONTEXTMENU_COPY_CLEAN_LINK"  desc="Text for Copy clean link">
        Copy clean link
      </message>
      <message name="IDS_PASSWORD_SETTINGS_IMPORT_ACTION_TITLE" desc="Title for the password import action in Android settings">
        Import passwords
      </message>
      <message name="IDS_PASSWORD_SETTINGS_IMPORT_ACTION_DESCRIPTION" desc="Description for the password import action in Android settings">
        Select a .csv file that contains your passwords to import them to Brave's password manager.
      </message>
      <message name="IDS_BLOCK_SWITCH_TO_APP_NOTICES"  desc="Text for Block 'Switch to App' Notices">
        Block 'Switch to App' Notices
      </message>
      <message name="IDS_ACCESSIBILITY_TOOLBAR_BTN_BRAVE_SHIELDS" desc="Content description for the button that is enable, disable Brave Shields.">
        Enable/Disable Brave Shields
      </message>
    <message name="IDS_ACCESSIBILITY_TOOLBAR_BTN_BRAVE_PIP" desc="Content description for the button that triggers picture-in-picture mode for YouTube videos.">
      Enter picture-in-picture mode
    </message>
      <message name="IDS_DE_AMP_SWITCH" desc="Switch to activate De-AMP feature">
        Auto-redirect AMP pages
      </message>
      <message name="IDS_DE_AMP_SUMMARY" desc="Summary for De-AMP feature">
        Always visit original (non-AMP) page URLs, instead of Google's Accelerated Mobile Page versions
      </message>
      <message name="IDS_DEBOUNCE_SWITCH" desc="Switch to activate Debounce feature">
        Auto-redirect tracking URLs
      </message>
      <message name="IDS_DEBOUNCE_SUMMARY" desc="Summary for Debounce feature">
        Enable support for bypassing top-level redirect tracking URLs.
      </message>
      <message name="IDS_BRAVE_SHIELDS_BLOCKS_SCRIPTS_SWITCH" desc="Switch for Block Scripts.">
        Block scripts
      </message>
      <message name="IDS_BRAVE_SHIELDS_BLOCKS_SCRIPTS_SUMMARY" desc="Switch for Block Scripts summary.">
        Blocks JavaScript (may break sites)
      </message>
      <message name="IDS_BLOCK_YOUTUBE_RECOMMENDED_CONTENT" desc="Hide YouTube Recommended Content">
        Block YouTube recommended content
      </message>
      <message name="IDS_BLOCK_YOUTUBE_RECOMMENDED_CONTENT_DESCRIPTION" desc="Hides the up next, home feed and end card elements on YouTube.">
        Blocks the up next and end card elements on youtube.com.
      </message>
      <message name="IDS_BLOCK_YOUTUBE_DISTRACTING_ELEMENTS" desc="Hide YouTube Distracting Elements">
        Block YouTube distracting elements
      </message>
      <message name="IDS_BLOCK_YOUTUBE_DISTRACTING_ELEMENTS_DESCRIPTION" desc="Hides the sign in, menu, comments and video info elements on YouTube.">
        Blocks the sign in, menu, comments, and video info elements on youtube.com.
      </message>
      <message name="IDS_BLOCK_YOUTUBE_SHORTS" desc="Hide YouTube shorts">
        Block YouTube Shorts
      </message>
      <message name="IDS_BLOCK_YOUTUBE_SHORTS_DESCRIPTION" desc="Hides shorts on YouTube.">
        Blocks Shorts from the home page, trending page and search results on youtube.com.
      </message>
      <message name="IDS_BLOCK_YOUTUBE_AUTODUBBED_VIDEOS" desc="Block YouTube auto-dubbed videos">
        Block YouTube auto-dubbed videos
      </message>
      <message name="IDS_BLOCK_YOUTUBE_AUTODUBBED_VIDEOS_DESCRIPTION" desc="Blocks auto-dubbed videos from appearing on youtube.com.">
        Blocks auto-dubbed videos from appearing on the youtube.com home page &amp; search results.
      </message>
      <message name="IDS_BLOCK_YOUTUBE_THUMBNAILS" desc="Block YouTube thumbnails">
        Block YouTube thumbnails
      </message>
      <message name="IDS_BLOCK_YOUTUBE_THUMBNAILS_DESCRIPTION" desc="Blocks thumbnails from appearing on youtube.com.">
        Blocks thumbnails from appearing on the youtube.com home page &amp; search results.
      </message>
      <message name="IDS_BLOCK_YOUTUBE_PLAYABLES" desc="Block YouTube Playables">
        Block YouTube Playables
      </message>
      <message name="IDS_BLOCK_YOUTUBE_PLAYABLES_DESCRIPTION" desc="Blocks Playables from appearing on youtube.com.">
        Blocks Playables from appearing on the youtube.com home page &amp; search results.
      </message>
      <message name="IDS_BLOCK_YOUTUBE_MEMBERS_ONLY_VIDEOS" desc="Block YouTube members-only videos">
        Block YouTube members-only videos
      </message>
      <message name="IDS_BLOCK_YOUTUBE_MEMBERS_ONLY_VIDEOS_DESCRIPTION" desc="Blocks members-only videos from appearing on youtube.com.">
        Blocks members-only videos from appearing on the youtube.com home page &amp; search results.
      </message>
      <message name="IDS_BRAVE_SHIELDS_SOCIAL_BLOCKING_TITLE" desc="Title for social media blocking.">
        Social Media Blocking
      </message>
      <message name="IDS_BRAVE_SHIELDS_SOCIAL_BLOCKING_GOOGLE" desc="Label for a switch control which allows Google social buttons to be enabled/disabled">
        Allow Google login buttons on third party sites
      </message>
      <message name="IDS_BRAVE_SHIELDS_SOCIAL_BLOCKING_FACEBOOK" desc="Label for a switch control which allows Facebook embedded posts">
        Allow Facebook logins and embedded posts
      </message>
      <message name="IDS_BRAVE_SHIELDS_SOCIAL_BLOCKING_TWITTER" desc="Label for a switch control which allows Twitter embedded tweets">
        Allow Twitter embedded tweets
      </message>
      <message name="IDS_BRAVE_SHIELDS_SOCIAL_BLOCKING_LINKEDIN" desc="Label for a switch control which allows LinkedIn embedded posts">
        Allow LinkedIn embedded posts
      </message>
      <message name="IDS_PREFS_AUTOFILL_PRIVATE_WINDOW_TITLE" desc="Title for Autofill in private window option in settings">
        Autofill in private tabs
      </message>
      <message name="IDS_PREFS_AUTOFILL_PRIVATE_WINDOW_SUMMARY" desc="Summary for Autofill in private window option in settings">
        Saved information can be auto-filled in private tabs
      </message>
      <message name="IDS_PREFS_SUPPORT_SECTION" desc="Title for the support section ">
        Support
      </message>
      <message name="IDS_EXTENSION_PUSH_MESSAGING_TITLE" desc="Settings switch for optional extension push messaging through Google">
        Extension push messaging
      </message>
      <message name="IDS_EXTENSION_PUSH_MESSAGING_SUMMARY" desc="Scope and browser lifetime limit of optional extension push messaging">
        Allow extensions with messaging permission to connect to Google to receive messages while Reaper is running. Messages cannot wake Reaper after its browser process stops.
      </message>
      <message name="IDS_EXTENSION_GLOBAL_SHORTCUTS_SERVICE_LABEL" desc="Android accessibility service name for optional global extension shortcuts">
        Reaper extension shortcuts
      </message>
      <message name="IDS_EXTENSION_GLOBAL_SHORTCUTS_SERVICE_DESCRIPTION" desc="Disclosure shown by Android before enabling the optional extension shortcut accessibility service">
        This optional service filters hardware keyboard keys across apps and handles only registered extension shortcuts. It does not read screen content or record key history.
      </message>
      <message name="IDS_EXTENSION_GLOBAL_SHORTCUTS_SETTINGS_TITLE" desc="Settings row linking to Android accessibility controls for extension shortcuts">
        Global extension shortcuts
      </message>
      <message name="IDS_EXTENSION_GLOBAL_SHORTCUTS_SETTINGS_SUMMARY" desc="Current service status and disclosure for optional global extension shortcuts">
        <ph name="STATUS">%1$s<ex>Off</ex></ph>. Manage “Reaper extension shortcuts” in Android accessibility settings. This optional service filters hardware keyboard keys across apps, handles only registered extension shortcuts, and does not record key history.
      </message>
      <message name="IDS_EXTENSION_GLOBAL_SHORTCUTS_STATUS_DISABLED" desc="The extension shortcut accessibility service is not enabled in Android">
        Off
      </message>
      <message name="IDS_EXTENSION_GLOBAL_SHORTCUTS_STATUS_WAITING" desc="Android enabled the extension shortcut service but its broker is not yet connected">
        Enabled in Android; waiting to connect
      </message>
      <message name="IDS_EXTENSION_GLOBAL_SHORTCUTS_STATUS_CONNECTED" desc="The extension shortcut accessibility service and native broker are connected">
        Connected
      </message>
      <message name="IDS_EXTENSION_GLOBAL_SHORTCUTS_STATUS_CONFLICT" desc="Another enabled accessibility service also requests key filtering, preventing this service from handling shortcuts">
        Unavailable while another enabled service requests keyboard filtering
      </message>
      <message name="IDS_EXTENSION_GLOBAL_SHORTCUTS_STATUS_UNAVAILABLE" desc="The extension shortcut accessibility service or native broker is unavailable">
        Unavailable
      </message>
      <message name="IDS_EXTENSION_GLOBAL_SHORTCUTS_SETTINGS_UNAVAILABLE" desc="Android could not open accessibility settings when the user tapped the shortcut service row">
        Android accessibility settings are unavailable.
      </message>
      <message name="IDS_PREFS_SECTION_FEATURES" desc="Title for Brave-specific features section">
        Features
      </message>
      <message name="IDS_BRAVE_SHIELDS_AND_PRIVACY" desc="Label for the settings related to shields and privacy">
        Brave Shields &amp; privacy
      </message>
      <message name="IDS_BRAVE_SEARCH_ENGINES" desc="Label for the settings related to the search engines">
        Search engines
      </message>
      <message name="IDS_PREFS_STANDARD_SEARCH_ENGINE" desc="Title for standard tab search engine option">
        Standard Tab
      </message>
      <message name="IDS_PREFS_PRIVATE_SEARCH_ENGINE" desc="Title for private tab search engine option">
        Private Tab
      </message>
      <message name="IDS_SHOW_AUTOCOMPLETE_IN_ADDRESS_BAR" desc="Title for a checkbox in Settings that controls whether to show autocompletion in the address bar.">
        Show browser suggestions
      </message>
      <message name="IDS_SHOW_AUTOCOMPLETE_IN_ADDRESS_BAR_SUMMARY" desc="Summary for a checkbox in Settings that controls whether to show autocompletion in the address bar.">
              Displays website suggestions based on your bookmarks and browsing history.
      </message>
      <message name="IDS_SHOW_SEARCH_SUGGESTIONS_TITLE" desc="Title for a switch in Settings that controls URL and search autocompletion and informs the user about the data shared by this feature.">
        Show search suggestions
      </message>
      <message name="IDS_MENU_EXIT" desc="Menu item for exit browser. [CHAR-LIMIT=27]">
        Exit
      </message>
      <message name="IDS_CONTENT_FILTERING_TITLE" desc="Title for Content Filtering settings.">
        Content Filtering
      </message>
      <message name="IDS_CONTENT_FILTERING_SUMMARY" desc="Summary for Content Filtering settings.">
        Enable custom filters that block regional and language-specific trackers and Annoyances
      </message>
      <message name="IDS_CONTENT_FILTERS_TITLE" desc="Title for Content Filters settings.">
        Content Filters
      </message>
      <message name="IDS_FILTER_LISTS" desc="Title for filter lists.">
        Filter lists
      </message>
      <message name="IDS_FILTER_LISTS_SUMMARY" desc="Summary text for Filter lists.">
        Additional popular community lists. Note that enabling too many filters will degrade browsing speeds.
      </message>
      <message name="IDS_CUSTOM_FILTER_LISTS" desc="Title for Custom filter lists.">
        Custom filter lists
      </message>
      <message name="IDS_CUSTOM_FILTER_LIST_TITLE" desc="Title for Add Custom filter lists.">
        Custom filter list
      </message>
      <message name="IDS_ADD_CUSTOM_FILTER_LIST" desc="Add custom filter list text.">
        Add custom filter list
      </message>
      <message name="IDS_CUSTOM_FILTER_LIST_URL" desc="Custom filter list url edittext title.">
        Custom Filter List URL
      </message>
      <message name="IDS_ENTER_FILTER_LIST_URL_HERE" desc="Enter filter list url here edittext hint.">
        Enter filter list URL here
      </message>
      <message name="IDS_CUSTOM_FILTER_INVALID_URL" desc="Invalid url error text for custom filter.">
        Invalid URL
      </message>
      <message name="IDS_EDIT_CUSTOM_FILTER_LIST" desc="Edit custom filter list text for menu item.">
        Edit Custom filter list
      </message>
      <message name="IDS_ADD_CUSTOM_FILTER_SUMMARY" desc="Add custom filter summary.">
        Add additional lists created and maintained by your trusted community.\n\nOnly subscribe to lists from entities you trust. Your browser will periodically check for list updates from the URL you enter, revealing your IP address to their server.
      </message>
      <message name="IDS_LAST_UPDATED_CUSTOM_FILTER" desc="Last updated time for custom filter.">
        Last updated <ph name="TIME">%1$s<ex>1 hours ago</ex></ph>
      </message>
      <message name="IDS_DASHED" desc="Dashed when custom filter item last update time is zero." translateable="false">
        -
      </message>
      <message name="IDS_DOWNLOAD_FAILED_CUSTOM_FILTER" desc="Custom filter Download failed.">
        Download failed
      </message>
      <message name="IDS_UPDATE_FAILED_CUSTOM_FILTER" desc="Custom filter Update failed.">
        <ph name="TIME">%1$s<ex>1 hours ago</ex></ph> Update failed
