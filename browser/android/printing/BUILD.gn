import("//extensions/buildflags/buildflags.gni")
assert(is_android && enable_extensions_core)

source_set("printing") {
  sources = [
    "reaper_extension_printer_bridge.cc",
    "//chrome/browser/printing/printing_service.cc",
    "//chrome/browser/printing/printing_service.h",
    "//chrome/browser/printing/pwg_raster_converter.cc",
    "//chrome/browser/printing/pwg_raster_converter.h",
  ]
  deps = [
    "//base",
    "//brave/browser/extensions/android/printing:jni_headers",
    "//chrome/app:generated_resources",
    "//chrome/browser/profiles:profile",
    "//chrome/services/printing/public/mojom",
    "//components/cloud_devices/common",
    "//content/public/browser",
    "//extensions/browser/api/printer_provider",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/system",
    "//printing",
    "//printing/mojom",
    "//ui/gfx/geometry",
  ]
}
