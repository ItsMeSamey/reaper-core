import("//extensions/buildflags/buildflags.gni")

assert(is_android)

source_set("request_guard") {
  sources = [
    "chrome_webauthn_request_guard.cc",
    "chrome_webauthn_request_guard.h",
  ]
  public_deps = [
    "//base",
    "//components/webauthn/android",
  ]
  deps = [
    "//chrome/browser/profiles:profile",
    "//chrome/browser/tab_list",
    "//chrome/browser/ui/android/tab_model",
    "//chrome/browser/ui/browser_window",
    "//components/tabs:public",
    "//content/public/browser",
    "//extensions/buildflags",
    "//ui/android",
    "//ui/base",
  ]
  if (enable_extensions_core) {
    deps += [
      "//chrome/browser/extensions",
      "//extensions/browser",
      "//extensions/common",
    ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [ "chrome_webauthn_request_guard_unittest.cc" ]
  deps = [
    ":request_guard",
    "//base/test:test_support",
    "//chrome/browser/ui/android/tab_model:test_support",
    "//chrome/test:test_support",
    "//components/tabs:test_support",
    "//content/public/browser",
    "//content/test:test_support",
    "//net",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/android",
    "//url",
  ]
}
