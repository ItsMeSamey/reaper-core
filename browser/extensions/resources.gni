    "//brave/browser/extensions/android/power/reaper_power_delegate_android.cc",
    "//brave/browser/extensions/android/power/reaper_power_delegate_android.h",
    "//brave/browser/extensions/api/identity/android_oauth_response_parser.cc",
    "//brave/browser/extensions/api/identity/android_oauth_response_parser.h",
    "//brave/browser/extensions/api/identity/brave_web_auth_flow.cc",
    "//brave/browser/extensions/api/identity/brave_web_auth_flow.h",
