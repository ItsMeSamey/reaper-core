import("//build/config/android/rules.gni")
import("//extensions/buildflags/buildflags.gni")
import("//third_party/jni_zero/jni_zero.gni")

assert(is_android && enable_extensions_core)

# Java belongs to chrome_java to reuse its selection dropdown without a dependency cycle.
generate_jni("jni_headers") {
  sources = [ "//brave/android/java/org/chromium/chrome/browser/selection/ReaperSelectionMenu.java" ]
}

android_resources("resources") {
  sources = [ "java/res/values/strings.xml" ]
}

source_set("native") {
  sources = [
    "//brave/browser/extensions/reaper_selection_menu_android.cc",
    "//brave/browser/extensions/reaper_selection_menu_android.h",
  ]
  deps = [
    ":context_menu_params",
    ":jni_headers",
    "//base",
    "//chrome/browser/extensions:extensions",
    "//content/public/browser",
    "//extensions/browser",
    "//ui/menus",
  ]
}

robolectric_library("junit") {
  testonly = true
  sources = [ "//brave/android/junit/src/org/chromium/chrome/browser/selection/ReaperSelectionMenuTest.java" ]
  deps = [
    ":jni_headers_java",
    "//chrome/android:chrome_java",
    "//chrome/android/junit:chrome_junit_tests_helper",
    "//chrome/browser/tab:java",
    "//content/public/android:content_full_java",
    "//third_party/jni_zero:jni_zero_java",
    "//ui/android:ui_java",
    "//ui/android:ui_no_recycler_view_java",
  ]
}

# Shared by the real selection menu and native policy regressions, without JNI.
source_set("context_menu_params") {
  sources = [
    "selection_context_menu_params.cc",
    "selection_context_menu_params.h",
  ]
  deps = [ "//content/public/browser" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "selection_context_menu_params_unittest.cc" ]
  deps = [
    ":context_menu_params",
    "//base",
    "//base/test:test_support",
    "//chrome/test/base:chrome_render_view_host_test_harness",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
    "//url",
  ]
}
