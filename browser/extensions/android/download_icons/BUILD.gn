import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")

assert(is_android)

android_library("java") {
  sources = [ "//brave/android/java/org/chromium/chrome/browser/download/ReaperDownloadFileIcon.java" ]
  deps = [
    "//base:base_java",
    "//build/android:build_java",
    "//third_party/androidx:androidx_annotation_annotation_java",
    "//third_party/jni_zero:jni_zero_java",
  ]
  srcjar_deps = [ ":jni_headers" ]
}

generate_jni("jni_headers") {
  sources = [ "//brave/android/java/org/chromium/chrome/browser/download/ReaperDownloadFileIcon.java" ]
}

robolectric_library("junit") {
  testonly = true
  sources = [ "//brave/android/junit/src/org/chromium/chrome/browser/download/ReaperDownloadFileIconTest.java" ]
  deps = [
    ":java",
    "//base:base_junit_test_support",
    "//third_party/junit",
  ]
}

robolectric_binary("download_icons_junit_tests") {
  enable_android_resources = false
  deps = [ ":junit" ]
}
