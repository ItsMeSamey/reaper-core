import("//build/config/android/rules.gni")
import("//extensions/buildflags/buildflags.gni")
import("//third_party/jni_zero/jni_zero.gni")

assert(is_android && enable_extensions_core)

generate_jni("jni_headers") {
  sources = [ "//brave/android/java/org/chromium/components/webapps/ReaperReplacementWebAppBridge.java" ]
}

robolectric_library("junit") {
  testonly = true
  sources = [ "//brave/android/junit/src/org/chromium/components/webapps/ReaperReplacementWebAppBridgeTest.java" ]
  deps = [
    ":jni_headers_java",
    "//chrome/android:chrome_java",
    "//chrome/android/junit:chrome_junit_tests_helper",
    "//chrome/browser/profiles/android:java",
    "//components/webapps/browser/android:java",
    "//content/public/android:content_full_java",
    "//third_party/jni_zero:jni_zero_java",
  ]
}
