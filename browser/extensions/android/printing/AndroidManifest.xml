<!-- Only Android's print framework can bind this service. The user enables it in system settings. -->
<service
    android:name="org.chromium.chrome.browser.printing.ReaperExtensionPrintService"
    android:label="@string/reaper_extension_print_service_name"
    android:permission="android.permission.BIND_PRINT_SERVICE"
    android:exported="true">
    <intent-filter>
        <action android:name="android.printservice.PrintService" />
    </intent-filter>
    <meta-data
        android:name="android.printservice"
        android:resource="@xml/reaper_extension_print_service" />
</service>
