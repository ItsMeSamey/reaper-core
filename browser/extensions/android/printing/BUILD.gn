import("//build/config/android/rules.gni")
import("//extensions/buildflags/buildflags.gni")
import("//third_party/jni_zero/jni_zero.gni")

assert(is_android && enable_desktop_android_extensions)

android_library("java") {
  sources = [
    "//brave/android/java/org/chromium/chrome/browser/printing/ReaperExtensionPrinterBridge.java",
    "//brave/android/java/org/chromium/chrome/browser/printing/ReaperExtensionPrinterCapabilities.java",
  ]
  deps = [
    ":resources",
    "//base:base_java",
    "//build/android:build_java",
    "//chrome/browser/profiles/android:java",
    "//third_party/jni_zero:jni_zero_java",
  ]
  srcjar_deps = [ ":jni_headers" ]
}

generate_jni("jni_headers") {
  sources = [ "//brave/android/java/org/chromium/chrome/browser/printing/ReaperExtensionPrinterBridge.java" ]
}

android_resources("resources") {
  sources = [
    "java/res/values/strings.xml",
    "java/res/xml/reaper_extension_print_service.xml",
  ]
}

robolectric_library("junit") {
  testonly = true
  sources = [ "//brave/android/junit/src/org/chromium/chrome/browser/printing/ReaperExtensionPrinterCapabilitiesTest.java" ]
  deps = [
    ":java",
    "//chrome/android/junit:chrome_junit_tests_helper",
  ]
}
