import("//build/config/android/rules.gni")
import("//extensions/buildflags/buildflags.gni")
import("//third_party/jni_zero/jni_zero.gni")

assert(is_android && enable_extensions_core)

source_set("global_shortcuts") {
  sources = [ "extension_global_shortcuts_bridge.cc" ]
  deps = [
    ":global_shortcuts_jni",
    "//base",
    "//chrome/browser/profiles:profile",
    "//content/public/browser",
    "//ui/base",
    "//ui/base/accelerators/global_accelerator_listener",
    "//ui/events",
    "//ui/events:events_base",
  ]
}

# Only the service needs Chrome's headless startup classes. It is included in
# chrome_java by brave/build/android/config.gni, avoiding a reverse dependency.
android_library("java") {
  sources = [
    "//brave/android/java/org/chromium/chrome/browser/extensions/shortcuts/ConsumedShortcutKeys.java",
    "//brave/android/java/org/chromium/chrome/browser/extensions/shortcuts/ExtensionGlobalShortcutsBridge.java",
  ]
  deps = [
    "//base:base_java",
    "//build/android:build_java",
    "//chrome/browser/profiles/android:java",
    "//third_party/jni_zero:jni_zero_java",
  ]
  srcjar_deps = [ ":global_shortcuts_jni" ]
}

generate_jni("global_shortcuts_jni") {
  sources = [ "//brave/android/java/org/chromium/chrome/browser/extensions/shortcuts/ExtensionGlobalShortcutsBridge.java" ]
}

android_resources("resources") {
  sources = [ "res/xml/extension_global_shortcuts_service.xml" ]
  deps = [ "//brave/build/android:android_brave_strings_grd" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "global_accelerator_android_unittest.cc" ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/base",
    "//ui/base/accelerators/global_accelerator_listener",
  ]
}

robolectric_library("junit") {
  testonly = true
  sources = [
    "//brave/android/junit/src/org/chromium/chrome/browser/extensions/shortcuts/ConsumedShortcutKeysTest.java",
    "//brave/android/junit/src/org/chromium/chrome/browser/extensions/shortcuts/ExtensionGlobalShortcutsBridgeTest.java",
    "//brave/android/junit/src/org/chromium/chrome/browser/extensions/shortcuts/ExtensionGlobalShortcutsServiceTest.java",
  ]
  deps = [
    ":java",
    "//chrome/android:chrome_java",
    "//chrome/android/junit:chrome_junit_tests_helper",
  ]
}
