import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")
import("//testing/test.gni")

android_library("java") {
  sources = [ "java/src/org/chromium/components/storage_monitor/StorageMonitorAndroid.java" ]
  deps = [
    "//base:base_java",
    "//build/android:build_java",
    "//third_party/androidx:androidx_annotation_annotation_java",
    "//third_party/jni_zero:jni_zero_java",
  ]
  srcjar_deps = [ ":jni_headers" ]
}

generate_jni("jni_headers") {
  sources = [ "java/src/org/chromium/components/storage_monitor/StorageMonitorAndroid.java" ]
}

robolectric_library("junit") {
  sources = [ "junit/src/org/chromium/components/storage_monitor/StorageMonitorAndroidTest.java" ]
  deps = [
    ":java",
    "//base:base_java",
    "//base:base_junit_test_support",
    "//third_party/junit",
    "//third_party/mockito:mockito_jvm_java",
  ]
}

robolectric_binary("storage_monitor_android_junit_tests") {
  enable_android_resources = false
  deps = [ ":junit" ]
}
