declare_args() {
  # Android omits the component updater, sponsored assets and ad view counter.
  enable_brave_ntp_background_images = !is_android
  enable_custom_background = is_win || is_mac || is_linux
}

assert(!is_android || !enable_brave_ntp_background_images,
       "Reaper Android excludes sponsored NTP components")
