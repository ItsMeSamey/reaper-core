if (enable_brave_wallet) {
  brave_jni_headers_sources += []
}

if (enable_desktop_android_extensions) {
  brave_chrome_java_deps +=
      [ "//brave/components/storage_monitor/android:java" ]
}

# Candidate Android printerProvider destination. The service itself belongs to
# chrome_java because its headless startup implementation lives in that target.
if (enable_desktop_android_extensions) {
  brave_android_manifest_includes +=
      [ "//brave/browser/extensions/android/printing/AndroidManifest.xml" ]
  brave_java_sources += [ "//brave/android/java/org/chromium/chrome/browser/printing/ReaperExtensionPrintService.java" ]
  brave_chrome_java_deps +=
      [ "//brave/browser/extensions/android/printing:java" ]
  brave_chrome_app_java_resources_deps +=
      [ "//brave/browser/extensions/android/printing:resources" ]
}

# Touch selected-text extension menu; reuse the Chrome selection dropdown
# implementation.
if (enable_extensions_core) {
  brave_java_sources += [ "//brave/android/java/org/chromium/chrome/browser/selection/ReaperSelectionMenu.java" ]
  brave_chrome_java_deps +=
      [ "//brave/browser/extensions/android/selection:jni_headers_java" ]
  brave_chrome_app_java_resources_deps +=
      [ "//brave/browser/extensions/android/selection:resources" ]
}

# Android IconLoader uses framework MIME artwork without accessing downloaded
# files.
brave_chrome_java_deps +=
    [ "//brave/browser/extensions/android/download_icons:java" ]

# Android extension power leases use Chrome activity/profile lifecycle state.
if (enable_desktop_android_extensions) {
  brave_java_sources += [ "//brave/android/java/org/chromium/chrome/browser/extensions/ReaperExtensionPowerManager.java" ]
  brave_jni_headers_sources += [ "//brave/android/java/org/chromium/chrome/browser/extensions/ReaperExtensionPowerManager.java" ]
}

# Confirmed standalone replacement PWA installer reuses chrome_java webapp
# helpers.
if (enable_extensions_core) {
  brave_java_sources += [ "//brave/android/java/org/chromium/components/webapps/ReaperReplacementWebAppBridge.java" ]
  brave_chrome_java_deps += [
    "//brave/browser/extensions/android/replacement_webapp:jni_headers_java",
  ]
}

# Optional public Android global-shortcut service. OS enablement remains
# explicit.
if (enable_desktop_android_extensions) {
  brave_android_manifest_includes += [
    "//brave/browser/extensions/android/global_shortcuts/AndroidManifest.xml",
  ]
  brave_java_sources += [ "//brave/android/java/org/chromium/chrome/browser/extensions/shortcuts/ExtensionGlobalShortcutsService.java" ]
  brave_chrome_java_deps +=
      [ "//brave/browser/extensions/android/global_shortcuts:java" ]
  brave_chrome_app_java_resources_deps +=
      [ "//brave/browser/extensions/android/global_shortcuts:resources" ]
}

# Reuse the common Speedreader extraction pipeline with a small Android bridge.
brave_java_sources += [ "//brave/android/java/org/chromium/chrome/browser/speedreader/SpeedreaderBridge.java" ]
brave_jni_headers_sources += [ "//brave/android/java/org/chromium/chrome/browser/speedreader/SpeedreaderBridge.java" ]

# Android reuses the native profile Containers service.
if (enable_containers) {
  brave_chrome_java_deps += [ "//brave/browser/containers/android:java" ]
  brave_java_sources += [ "//brave/android/java/org/chromium/chrome/browser/containers/ContainersPersistentTabReferences.java" ]
  brave_jni_headers_sources += [ "//brave/android/java/org/chromium/chrome/browser/containers/ContainersPersistentTabReferences.java" ]
}
