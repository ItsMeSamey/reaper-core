import("//build/config/android/rules.gni")

assert(is_android)

_spec = read_file("brand_assets.json", "json")
_brand_dir = "$target_gen_dir/brand"
_resource_files = [
  "$_brand_dir/res/drawable/ic_launcher.xml",
  "$_brand_dir/res/drawable/ic_launcher_round.xml",
  "$_brand_dir/res/values/reaper_brand_colors.xml",
]
foreach(icon, _spec.rasters) {
  foreach(density,
          [
            "mdpi",
            "hdpi",
            "xhdpi",
            "xxhdpi",
            "xxxhdpi",
          ]) {
    _resource_files +=
        [ "$_brand_dir/res/${icon.type}-$density/${icon.name}.png" ]
  }
}
foreach(icon, _spec.vectors) {
  _resource_files += [ "$_brand_dir/res/${icon.path}" ]
}
_symbol_files = []
foreach(icon, _spec.symbols) {
  _symbol_files += [ "$_brand_dir/symbols/${icon.path}" ]
}
foreach(icon, _spec.shields) {
  _symbol_files += [ "$_brand_dir/symbols/${icon.path}" ]
}
_theme_files = []
foreach(scale,
        [
          "100",
          "200",
          "300",
        ]) {
  _theme_files += [
    "$_brand_dir/theme/default_${scale}_percent/reaper/product_logo_32.png",
  ]
}

_rasterizer = "$root_build_dir/bin/helper/nala_vd_rasterizer"
_nala_dir = "//brave/node_modules/@brave/leo/tokens/android/drawable"

# This is a generator, not an android_assets target with .params.json metadata.
# Keep its label outside Chromium's reserved Android resource-name patterns.
action("brand_files") {
  script = "generate_brand_resources.py"
  inputs = [
    "brand_assets.json",
    "reaper_mark.xml",
    "$_nala_dir/ic_shield_done.xml",
    "$_nala_dir/ic_shield_disable.xml",
    _rasterizer,
  ]
  outputs = _resource_files + _symbol_files + _theme_files
  args = [
    "--spec",
    rebase_path("brand_assets.json", root_build_dir),
    "--mark",
    rebase_path("reaper_mark.xml", root_build_dir),
    "--nala-dir",
    rebase_path(_nala_dir, root_build_dir),
    "--rasterizer",
    rebase_path(_rasterizer, root_build_dir),
    "--output-dir",
    rebase_path(_brand_dir, root_build_dir),
  ]
  deps = [ "//brave/build/android/nala_vd_rasterizer" ]
}

android_resources("brand_symbols_resources") {
  sources = _symbol_files
  deps = [
    ":brand_files",
    "//brave/android/nala:java_resources",
  ]
}

# Depend on every original owner so this overlay wins resource merging.
# PNG overrides cover all five densities; night monochrome is also explicit.
android_resources("brand_resources") {
  sources = _resource_files
  resource_overlay = true
  deps = [
    ":brand_files",
    ":brand_symbols_resources",
    "//brave/android:java_resources",
    "//brave/android/nala:chrome_app_overlay_resources",
    "//brave/android/nala:java_resources",
    "//brave/browser/first_run/android:java_resources",
    "//chrome/android:chrome_app_java_resources",
    "//chrome/android:chrome_base_module_resources",
    "//chrome/android:chrome_public_apk_base_module_resources",
  ]
}
