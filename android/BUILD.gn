# Stage only selected resources; clear each owned qualifier root so excluded
# or retired files cannot remain in android_resources' directory scan.
_brave_android_resource_directories = []
_brave_android_resource_sources = []
_brave_android_resource_copy_deps = []
foreach(_source, _brave_android_resource_spec.sources) {
  _directory = get_path_info(_source, "dir")
  if (filter_include(_brave_android_resource_directories, [ _directory ]) == []) {
    _brave_android_resource_directories += [ _directory ]
  }
  _root = "$target_gen_dir/brave_android_resources_selected/" +
          string_replace(_directory, "/", "_")
  _qualifier = get_path_info(_directory, "file")
  _file = get_path_info(_source, "file")
  _brave_android_resource_sources += [ "$_root/$_qualifier/$_file" ]
}
foreach(_directory, _brave_android_resource_directories) {
  _qualifier = get_path_info(_directory, "file")
  _copy_target = "copy_selected_brave_android_$_qualifier"
  copy_ex(_copy_target) {
    sources = filter_include(_brave_android_resource_spec.sources, [ "$_directory/*" ])
    _root = "$target_gen_dir/brave_android_resources_selected/" +
            string_replace(_directory, "/", "_")
    dest = "$_root/$_qualifier"
    outputs = process_file_template(sources, [ "$dest/{{source_file_part}}" ])
    args = [ "--clear" ]
  }
  _brave_android_resource_copy_deps += [ ":$_copy_target" ]
}

android_resources("java_resources") {
  sources = _brave_android_resource_sources
  deps = _brave_android_resource_copy_deps
}
