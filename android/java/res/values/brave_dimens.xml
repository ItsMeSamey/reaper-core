    <dimen name="heading_h2">22sp</dimen>
    <dimen name="heading_h3">20sp</dimen>
    <dimen name="heading_h4">16sp</dimen>
    <dimen name="small_semibold">12sp</dimen>
    <dimen name="monospace_small">12sp</dimen>
    <dimen name="brave_toolbar_edge_padding_ntp">8dp</dimen>
    <dimen name="new_tab_page_incognito_logo_size">42dp</dimen>
    <dimen name="new_tab_page_incognito_icon_size">32dp</dimen>
    <dimen name="new_tab_page_incognito_icon_inner_size">20dp</dimen>

    <!-- Brave News cards-->

    <!-- Quick Action Search Widget -->
    <dimen name="quick_action_search_widget_small_margin_vertical">12dp</dimen>

    <!-- Override of chromium's toolbar hairline height -->
    <dimen name="toolbar_hairline_height">0dp</dimen>

    <!-- Override of chromium's Search engine logo. The half-size is the icon
         outline corner radius and must match composed_size / 2 to render as a
         perfect circle (upstream uses 24dp/12dp on phones). -->
    <dimen name="omnibox_search_engine_logo_composed_size">20dp</dimen>
    <dimen name="omnibox_search_engine_logo_composed_half_size">10dp</dimen>

    <!-- Disable the upstream 56dp wide StatusView. Upstream centers the search engine
         icon in this wider container on regular NTP and when the URL bar is focused,
         which leaves a ~14dp gap before the leading lion icon in Brave's omnibox. -->
    <dimen name="status_view_width_wide">0dp</dimen>

    <!-- Material's bottom sheet width cap, above which the sheet is centred rather than stretched.
         Brave's AppModalStyle inherits from Widget.Design.BottomSheet.Modal, which predates the
         cap that Widget.MaterialComponents.BottomSheet adds, so sheets that want it set it
         explicitly on their BottomSheetBehavior. -->

    <!-- Upstream sizes menus to their items instead of the fixed menu_width they used to have,
         which leaves the app menu too narrow for the five buttons of Brave's icon row footer.
         Keep the previous width as the minimum. -->
    <dimen name="menu_width_min">@dimen/menu_width</dimen>
</resources>
