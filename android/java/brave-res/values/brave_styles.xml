    <style name="BraveSyncRedWarningTextSmallSemibold" parent="SmallSemibold">
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:translationY">-0.97sp</item>
        <item name="android:gravity">top</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/systemfeedback_error_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BraveSyncTitleTextHeadingH4" parent="HeadingH4">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">5sp</item>
        <item name="android:translationY">-2.62sp</item>
    </style>

    <style name="BraveSyncDescriptionTextDefaultRegular" parent="DefaultRegular">
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:translationY">-1.8sp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="BookmarkTabPopupMenu" parent="Theme.AppCompat.DayNight">
